namespace elim
open ground

/-- A matrix: the rows' coefficient lists over the stated column
keys. -/
abbrev Mat := List (List BPair)

/-- A splitting's co-list: the column list with the key struck. -/
def strike (j : Nat) (l : List BPair) : List BPair := l.eraseIdx j

/-- The first-row fold's walk at a stated entry bundle: entry
against sub-minor per splitting, the side alternating with the
count of columns before, the entry and the collected sum each at
a stated representative map. -/
def minorRowO {γ : Type} (ops : DOps γ) (nrm snrm : γ → γ)
    (f : List (List γ) → γ) :
    Bool → Nat → List γ → List (List γ) → γ
  | _, _, [], _ => ops.unit
  | odd, j, a :: r', rest =>
    let t := nrm (ops.mul a (f (rest.map (fun l => l.eraseIdx j))))
    snrm (ops.add (if odd then ops.swap t else t)
      (minorRowO ops nrm snrm f (!odd) (j + 1) r' rest))

/-- The minor at a fuel: at one row the entry, and at more rows the
first-row fold over the splittings. -/
def minorFO {γ : Type} (ops : DOps γ) (nrm snrm : γ → γ) :
    Nat → List (List γ) → γ
  | 0, _ => ops.one
  | _ + 1, [] => ops.one
  | _ + 1, r :: [] => r.headD ops.unit
  | fuel + 1, r :: r2 :: rest =>
    minorRowO ops nrm snrm (minorFO ops nrm snrm fuel) false 0 r
      (r2 :: rest)

/-- The minor at matched lists, the fuel the row count, at a
stated entry bundle with its two representative maps. -/
def minorO {γ : Type} (ops : DOps γ) (nrm snrm : γ → γ)
    (m : List (List γ)) : γ :=
  minorFO ops nrm snrm m.length m

/-- The minor at matched lists at the balance-pair entries, the
representative kept per step. -/
def minor (m : Mat) : BPair := minorO bpairOps BPair.norm BPair.norm m

/-- The pivot-bordered minor at the lists `(1..k, i ; 1..k, j)`,
zero-based: the leading `k` rows with row `i`, the leading `k`
columns with column `j`. -/
def bordered (m : Mat) (k i j : Nat) : BPair :=
  minor ((m.take k ++ [ground.getAt [] m i]).map
    (fun r => r.take k ++ [ground.getAt BPair.unit r j]))

/-- The leading minor `P_k` at the lists `(1..k)`. -/
def leading (m : Mat) (k : Nat) : BPair :=
  minor ((m.take k).map (List.take k))

/-- Sylvester's identity naming step `k+1` from the two before,
`P_k b^{(k+1)}_{ij} + b^{(k)}_{i,k} b^{(k)}_{k,j}
  = b^{(k)}_{k,k} b^{(k)}_{ij}` at zero-based keys, one identity of
minor formulas per step, the new entry the identity's cofactor. -/
def sylvesterRead (m : Mat) (k i j : Nat) : Prop :=
  BPair.oneValue
    (leading m k * bordered m (k + 1) i j
      + bordered m k i k * bordered m k k j)
    (bordered m k k k * bordered m k i j)

instance (m : Mat) (k i j : Nat) : Decidable (sylvesterRead m k i j) :=
  inferInstanceAs (Decidable (BPair.oneValue _ _))

/-! The resultant, the shift matrix's site-datum determinant. -/

/-- A shift row at any entry carrier: the polynomial's coefficients
at the stated offset, the further keys at the sum's unit. -/
private def shiftRowO {γ : Type} (ops : DOps γ) (width a : Nat)
    (f : List γ) : List γ :=
  List.replicate a ops.unit ++ f
    ++ List.replicate (width - a - f.length) ops.unit

/-- The shift matrix at any entry carrier: rows the monomial shifts
`x^a q` at `a` below `p`'s degree and `x^b p` at `b` below `q`'s,
columns the monomial keys below the degrees' sum. -/
def shiftMatO {γ : Type} (ops : DOps γ) (p q : List γ) :
    List (List γ) :=
  ((List.range (p.length - 1)).map
    (fun a => shiftRowO ops (p.length - 1 + (q.length - 1)) a q))
  ++ ((List.range (q.length - 1)).map
    (fun b => shiftRowO ops (p.length - 1 + (q.length - 1)) b p))

/-- The shift matrix: rows the monomial shifts `x^a q` at `a` below
`p`'s degree and `x^b p` at `b` below `q`'s, columns the monomial
keys below the degrees' sum. -/
def shiftMat (p q : poly.Poly) : Mat := shiftMatO bpairOps p q

/-- The resultant's stated site: two polynomials at tops of unequal
members, each top off the unit class.  The naming reads at this
site alone — a trailing equal-membered coefficient moves the shift
matrix with the length gauge — and the congruence across
representatives at the site is its consumer's theorem. -/
def topsUnequal (p q : poly.Poly) : Prop :=
  ¬ (poly.top p).oneValue BPair.unit ∧ ¬ (poly.top q).oneValue BPair.unit

instance (p q : poly.Poly) : Decidable (topsUnequal p q) :=
  inferInstanceAs (Decidable (¬ _ ∧ ¬ _))

/-- The rows' leading column, each row's head entry at the
carrier's unit. -/
def colHead {γ : Type} (u : γ) (m : List (List γ)) : List γ :=
  m.map (fun r => ground.getAt u r 0)

/-- The rows with their leading entries withdrawn. -/
def dropCol {γ : Type} (m : List (List γ)) : List (List γ) :=
  m.map (fun r => r.drop 1)

/-- The leading column's width, the rows' count. -/
theorem length_colHead {γ : Type} (u : γ)
    (m : List (List γ)) : (colHead u m).length = m.length :=
  ground.length_map _ m

/-- The withdrawn rows' count. -/
theorem length_dropCol {γ : Type} (m : List (List γ)) :
    (dropCol m).length = m.length := ground.length_map _ m

/-- The leading column's entry, the row's own head read. -/
theorem getAt_colHead {γ : Type} (u : γ)
    (m : List (List γ)) (j : Nat) (hj : j < m.length) :
    ground.getAt u (colHead u m) j
      = ground.getAt u (ground.getAt [] m j) 0 :=
  ground.getAt_map ([] : List γ) u _ m j hj

/-- The withdrawn rows' entry, the row's own drop read. -/
theorem getAt_dropCol {γ : Type} (m : List (List γ)) (j : Nat)
    (hj : j < m.length) :
    ground.getAt ([] : List γ) (dropCol m) j
      = (ground.getAt [] m j).drop 1 :=
  ground.getAt_map ([] : List γ) ([] : List γ) _ m j hj

/-! The one-value arithmetic the tiers below share: a factor at the
sum's unit swallows its product on either side, and two data at the
sum's unit join there. -/

/-- A unit clearing swallows the product on its left. -/
theorem oneValue_unit_mul {c x : BPair}
    (hc : c.oneValue BPair.unit) :
    (c * x).oneValue BPair.unit :=
  BPair.oneValue_trans
    (BPair.mul_congr hc (BPair.oneValue_refl x))
    (BPair.unit_mul x)

/-- A unit factor swallows the product on its right. -/
theorem oneValue_mul_unit (a x : BPair)
    (hx : x.oneValue BPair.unit) : (a * x).oneValue BPair.unit :=
  BPair.oneValue_trans
    (BPair.mul_congr (BPair.oneValue_refl a) hx)
    (BPair.mul_unit a)

/-! The descent's rank and kernel reads, the deferred consumer's
arrival: a step pivots at an entry with unequal members, a row and
column exchange bringing it to the head, the later entries the
Sylvester identity's cofactors (the fraction-free step, the exact
cofactor read off the division with remainder at the sides), and
the descent names the rank, the pivot count, with the pivot-free
columns the kernel list, its length the kernel dimension. -/

private def cofactorMag (e p : Pos) : Option Pos := (divMod e p).1

/-- The exact cofactor at a stated balance factorization: `C` at
`P C = E`, read off the two sides and the division with remainder;
the descent reads it at Sylvester-divisible data alone, the
batteries its pins. -/
def cofactorAt (E P : BPair) : BPair :=
  match E.side, P.side with
  | Trich.eq _, Trich.eq _ => BPair.unit
  | Trich.eq _, Trich.lt _ _ => BPair.unit
  | Trich.eq _, Trich.gt _ _ => BPair.unit
  | Trich.lt _ _, Trich.eq _ => BPair.unit
  | Trich.gt _ _, Trich.eq _ => BPair.unit
  | Trich.lt e _, Trich.lt p _ =>
    match cofactorMag e p with
    | some c => BPair.ofPos c
    | none => BPair.unit
  | Trich.lt e _, Trich.gt p _ =>
    match cofactorMag e p with
    | some c => (BPair.ofPos c).swap
    | none => BPair.unit
  | Trich.gt e _, Trich.lt p _ =>
    match cofactorMag e p with
    | some c => (BPair.ofPos c).swap
    | none => BPair.unit
  | Trich.gt e _, Trich.gt p _ =>
    match cofactorMag e p with
    | some c => BPair.ofPos c
    | none => BPair.unit

/-- Two data at the sum's unit join at it. -/
private theorem unitAdd {x y : BPair} (hx : x.oneValue BPair.unit)
    (hy : y.oneValue BPair.unit) : (x + y).oneValue BPair.unit :=
  BPair.oneValue_trans (BPair.add_congr hx hy)
    (BPair.unit_add BPair.unit)

/-- A stated pair at equal members reads the cofactor at the sum's
unit: the pair's side is the equality, and every divisor branch
answers there. -/
private theorem cofactorAt_eqMem (E P : BPair) (h : E.fst = E.snd) :
    cofactorAt E P = BPair.unit := by
  unfold cofactorAt
  cases hE : E.side with
  | eq _ => cases P.side <;> rfl
  | lt g hg =>
    exact absurd (show E.fst + g = E.fst by rw [hg, h])
      (ground.add_ne_left E.fst g)
  | gt g hg =>
    exact absurd (show E.snd + g = E.snd by rw [hg]; exact h)
      (ground.add_ne_left E.snd g)

/-- The Sylvester step at a row entry at equal members whose
pivot-column partner or pivot-row partner is there too reads the
sum's unit: an equal-membered factor sends its product to the sum's
unit (the bridge `BPair.oneValue_of_eqMem` at either side), the
swap and the join keep it there, and the cofactor answers the sum's
unit at every divisor.  The guard's own general form: the descent
below reads it at the canonical unit, where the members are equal
outright. -/
theorem step_unit_gen (prev pivot t r0 e : BPair)
    (he : e.fst = e.snd)
    (hs : r0.fst = r0.snd ∨ t.fst = t.snd) :
    cofactorAt (pivot * e + (r0 * t).swap) prev = BPair.unit := by
  have hp : (pivot * e).oneValue BPair.unit :=
    oneValue_mul_unit pivot e (BPair.oneValue_of_eqMem he)
  have hq : (r0 * t).oneValue BPair.unit := by
    cases hs with
    | inl hr => exact oneValue_unit_mul (BPair.oneValue_of_eqMem hr)
    | inr ht => exact oneValue_mul_unit r0 t (BPair.oneValue_of_eqMem ht)
  refine cofactorAt_eqMem _ prev (BPair.eqMem_of_oneValue ?_)
  exact unitAdd hp (ground.swap_congr hq)

/-- The Sylvester step at a row entry at the sum's unit whose
pivot-column partner or pivot-row partner is there too reads the
sum's unit, the general guard at the canonical unit's own equal
members.  This read is what the sparse rows below store: better
than nineteen keys in twenty of a stacked raising's descent answer
here, and a row at the sum's unit in the pivot column answers here
at every key of the pivot row, so its update is a scaling of its
own keys alone. -/
theorem step_unit (prev pivot t r0 e : BPair)
    (he : e.isUnitRep = true)
    (hs : r0.isUnitRep = true ∨ t.isUnitRep = true) :
    cofactorAt (pivot * e + (r0 * t).swap) prev = BPair.unit := by
  have hu : (BPair.unit).fst = (BPair.unit).snd := rfl
  refine step_unit_gen prev pivot t r0 e ?_ ?_
  · rw [BPair.unit_of_isUnitRep he]; exact hu
  · cases hs with
    | inl hr => exact Or.inl (by rw [BPair.unit_of_isUnitRep hr]; exact hu)
    | inr ht => exact Or.inr (by rw [BPair.unit_of_isUnitRep ht]; exact hu)

/-! The descent's working state, sparse by rows.  A row is its
column-key count beside the column-keyed list of its off-unit
entries, the keys strictly ascending and below the count, every
stored entry the canonical representative.  A key absent from the
list reads the sum's unit there, and `BPair.norm` sends every
equal-membered pair to `BPair.unit`, so the absent keys are exactly
the keys the dense row holds `BPair.unit` at.

The step's three keys, each read off `step_unit`'s guarded
arithmetic `cofactorAt (pivot * e + (r0 * t).swap) prev` at the
pivot-row entry `t`, the pivot-column entry `r0` and the row's own
entry `e`, with `cofactorAt` reading its stated pair through
`BPair.side`, the pair's value:

* a key of both rows has `e` and `t` occupied, the guard's first
  conjunct failing, so the arithmetic is read whole (`jointEntry`);
* a key of the row alone has `t` at the sum's unit, so `(r0 * t)`
  reads the sum's unit and the value is `pivot * e`, the entry
  scaled by the pivot against `prev`'s cofactor (`scaleEntry`);
* a key of the pivot row alone has `e` at the sum's unit, so
  `pivot * e` reads the sum's unit and the value is the swapped
  product, fill-in at the product's cofactor (`fillEntry`) at an
  occupied `r0`, and the guard's own discharge at `r0` reading the
  sum's unit, where the key is dropped outright.

That last discharge splits the update: a row at the sum's unit in
the pivot column scales its own keys alone, its walk over the pivot
row withdrawn outright, which is better than nineteen row updates
in twenty at a stacked raising's descent. -/

private abbrev SRow := Nat × List (Nat × BPair)

/-- A dense row's off-unit entries from the stated key up, at their
canonical representatives. -/
private def ofRowFrom (k : Nat) : List BPair → List (Nat × BPair)
  | [] => []
  | e :: es =>
    let v := e.norm
    match v.isUnitRep with
    | true => ofRowFrom (k + 1) es
    | false => (k, v) :: ofRowFrom (k + 1) es

/-- A dense row as a sparse row: its key count beside its off-unit
entries. -/
private def ofRow (r : List BPair) : SRow := (r.length, ofRowFrom 0 r)

/-- The pivot search: the first row holding an entry, and the head
key there, which is the least column key that row is occupied at. -/
private def sFind : List SRow → Option (Nat × Nat)
  | [] => none
  | (_, []) :: rest =>
    match sFind rest with
    | none => none
    | some (i, j) => some (i + 1, j)
  | (_, (k, _) :: _) :: _ => some (0, k)

/-- The keys above the peeled column, each read one lower. -/
private def shiftKeys : List (Nat × BPair) → List (Nat × BPair)
  | [] => []
  | (k, v) :: es => (k - 1, v) :: shiftKeys es

/-- The pivot column peeled off an entry list: the entry there
beside the other entries at their shifted keys.  The keys ascend,
so the walk answers at the first key at the pivot's or above it. -/
private def peel (j : Nat) :
    List (Nat × BPair) → BPair × List (Nat × BPair)
  | [] => (BPair.unit, [])
  | (k, v) :: es =>
    match Nat.beq k j with
    | true => (v, shiftKeys es)
    | false =>
      match Nat.blt k j with
      | true =>
        let r := peel j es
        (r.1, (k, v) :: r.2)
      | false => (BPair.unit, shiftKeys ((k, v) :: es))

/-- The row peeled at the pivot column: its entry there beside the
row at one key fewer, the count dropping exactly where the column
sits inside it. -/
private def sPeel (j : Nat) (r : SRow) : BPair × SRow :=
  let p := peel j r.2
  let w := match Nat.blt j r.1 with
    | true => r.1 - 1
    | false => r.1
  (p.1, (w, p.2))

/-- A key of the row alone: the pivot row reads the sum's unit
there, so the step's swapped product does too and the entry scales
by the pivot against `prev`'s cofactor. -/
private def scaleEntry (prev pivot e : BPair) : BPair :=
  cofactorAt (pivot * e) prev

/-- A key of the pivot row alone at an occupied pivot column: the
row reads the sum's unit there, so the step's pivot product does
too and the fill-in enters at the product's cofactor. -/
private def fillEntry (prev r0 t : BPair) : BPair :=
  cofactorAt (r0 * t).swap prev

/-- A key of both rows: the step's arithmetic read whole. -/
private def jointEntry (prev pivot t r0 e : BPair) : BPair :=
  cofactorAt (pivot * e + (r0 * t).swap) prev

/-- The entries kept under a stated per-entry read: the sum's unit
and the keys at the count or above it dropped.  The two tails below
are its instances at their own entry reads, the collapse folded on
its measurement: back to back in one session at the committed
124-by-90 pin the collapsed spelling reads 6.94--7.11 s whole
against 6.95--7.02 s at the two spelled recursions, three runs each
and inside the run-to-run spread, a loaded machine the caveat on
both.  `fillBelow` keeps its own recursion — it splits the pivot
row at a key as it reads it, one pass where the split-then-keep
route is two. -/
private def keepTail (f : BPair → BPair) (lim : Nat) :
    List (Nat × BPair) → List (Nat × BPair)
  | [] => []
  | (k, e) :: es =>
    let v := f e
    match !v.isUnitRep && Nat.blt k lim with
    | true => (k, v) :: keepTail f lim es
    | false => keepTail f lim es

/-- The row's own entries scaled. -/
private def scaleTail (prev pivot : BPair) (lim : Nat)
    (es : List (Nat × BPair)) : List (Nat × BPair) :=
  keepTail (scaleEntry prev pivot) lim es

/-- The pivot row's entries as fill-in, each at the product's
cofactor. -/
private def fillTail (prev r0 : BPair) (lim : Nat)
    (ps : List (Nat × BPair)) : List (Nat × BPair) :=
  keepTail (fillEntry prev r0) lim ps

/-- The pivot row's fill-in entries below the stated key, beside the
pivot row's rest at that key and above. -/
private def fillBelow (prev r0 : BPair) (lim k : Nat) :
    List (Nat × BPair) → List (Nat × BPair) × List (Nat × BPair)
  | [] => ([], [])
  | (kt, t) :: ps =>
    match Nat.blt kt k with
    | false => ([], (kt, t) :: ps)
    | true =>
      let r := fillBelow prev r0 lim k ps
      let v := fillEntry prev r0 t
      match !v.isUnitRep && Nat.blt kt lim with
      | true => ((kt, v) :: r.1, r.2)
      | false => r

/-- The Sylvester update of one row against the pivot row at an
occupied pivot column: a sorted merge over the two key lists, the
joint keys reading the arithmetic whole, the row's own keys
scaling, and the pivot row's own keys entering as fill-in. -/
private def mergeRow (prev pivot r0 : BPair) (lim : Nat) :
    List (Nat × BPair) → List (Nat × BPair) → List (Nat × BPair)
  | ps, [] => fillTail prev r0 lim ps
  | ps, (ke, e) :: es =>
    let b := fillBelow prev r0 lim ke ps
    match b.2 with
    | [] => b.1 ++ scaleTail prev pivot lim ((ke, e) :: es)
    | (kt, t) :: pr =>
      match Nat.beq kt ke with
      | true =>
        let v := jointEntry prev pivot t r0 e
        let tl := mergeRow prev pivot r0 lim pr es
        match !v.isUnitRep && Nat.blt ke lim with
        | true => b.1 ++ (ke, v) :: tl
        | false => b.1 ++ tl
      | false =>
        let v := scaleEntry prev pivot e
        let tl := mergeRow prev pivot r0 lim ((kt, t) :: pr) es
        match !v.isUnitRep && Nat.blt ke lim with
        | true => b.1 ++ (ke, v) :: tl
        | false => b.1 ++ tl

/-- One row's update: at a pivot column reading the sum's unit the
row's own entries scale outright, `step_unit`'s discharge at every
key of the pivot row; at an occupied pivot column the merge runs. -/
private def stepSRow (prev pivot r0 : BPair) (lim : Nat)
    (ps es : List (Nat × BPair)) : List (Nat × BPair) :=
  match r0.isUnitRep with
  | true => scaleTail prev pivot lim es
  | false => mergeRow prev pivot r0 lim ps es

/-- One round's stepped rows: every row off the pivot's place peeled
at the pivot column and updated against the peeled pivot row, the
kept width the two peeled counts' lesser. -/
private def stepRows (prev : BPair) (p : BPair × SRow) (j : Nat)
    (rows : List SRow) : List SRow :=
  rows.map (fun r =>
    let q := sPeel j r
    let lim := ground.natMin p.2.1 q.2.1
    (lim, stepSRow prev p.1 q.1 lim p.2.2 q.2.2))

/-- The descent's one walk at a stated carrier: the terminal read
at spent fuel or an answered-nothing search, and per round the step
against the round below, the pivot peeled at the found place with
every other row updated — `def:elim`'s pivot descent, its reads the
instances' own seeds and steps at one recursion. -/
private def descGo {γ : Type} (seed : Nat → γ)
    (step : Nat → Nat → BPair × SRow → γ → γ) :
    Nat → Nat → BPair → List SRow → γ
  | 0, w, _, _ => seed w
  | fuel + 1, w, prev, rows =>
    match sFind rows with
    | none => seed w
    | some (i, j) =>
      let p := sPeel j (ground.getAt ((0, []) : SRow) rows i)
      step w j p (descGo seed step fuel (w - 1) p.1
        (stepRows prev p j (rows.eraseIdx i)))

/-- The walk's terminal read at spent fuel. -/
private theorem descGo_zero {γ : Type} (seed : Nat → γ)
    (step : Nat → Nat → BPair × SRow → γ → γ) (w : Nat)
    (prev : BPair) (rows : List SRow) :
    descGo seed step 0 w prev rows = seed w := rfl

/-- The walk's terminal read at an answered-nothing search. -/
private theorem descGo_none {γ : Type} (seed : Nat → γ)
    (step : Nat → Nat → BPair × SRow → γ → γ) (fuel w : Nat)
    (prev : BPair) (rows : List SRow) (hf : sFind rows = none) :
    descGo seed step (fuel + 1) w prev rows = seed w := by
  show (match sFind rows with
      | none => seed w
      | some (i, j) =>
        let p := sPeel j (ground.getAt ((0, []) : SRow) rows i)
        step w j p (descGo seed step fuel (w - 1) p.1
          (stepRows prev p j (rows.eraseIdx i))))
    = seed w
  rw [hf]

/-- The walk's round at a found pivot. -/
private theorem descGo_some {γ : Type} (seed : Nat → γ)
    (step : Nat → Nat → BPair × SRow → γ → γ) (fuel w : Nat)
    (prev : BPair) (rows : List SRow) (i j : Nat)
    (hf : sFind rows = some (i, j)) :
    descGo seed step (fuel + 1) w prev rows
      = step w j (sPeel j (ground.getAt ((0, []) : SRow) rows i))
        (descGo seed step fuel (w - 1)
          (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
          (stepRows prev
            (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
            (rows.eraseIdx i))) := by
  show (match sFind rows with
      | none => seed w
      | some (i, j) =>
        let p := sPeel j (ground.getAt ((0, []) : SRow) rows i)
        step w j p (descGo seed step fuel (w - 1) p.1
          (stepRows prev p j (rows.eraseIdx i))))
    = _
  rw [hf]

/-- One round: the pivot row peeled off its own place, every other
row peeled and updated in one pass over the row list — the walk at
the counting read. -/
private def sdescend (fuel : Nat) (prev : BPair)
    (rows : List SRow) : Nat :=
  descGo (fun _ => 0) (fun _ _ _ n => 1 + n) fuel 0 prev rows

/-- The rank: the descent's pivot count, the entries read at their
canonical representatives. -/
def rank (m : Mat) : Nat :=
  sdescend m.length (BPair.ofPos .one) (m.map ofRow)

/-- The kernel dimension at the stated column-key count: the
pivot-free columns' count. -/
def kernelDim (cols : Nat) (m : Mat) : Nat := cols - rank m

/-- The kernel dimension display at a stated rank: `def:elim`'s
pivot-free count read off the descent's one pivot count, the gap's
value the display's own. -/
theorem kernelDim_at (cols r k : Nat) (m : Mat) (h : rank m = r)
    (hk : cols - r = k) : kernelDim cols m = k := by
  show cols - rank m = k
  rw [h]
  exact hk

/-- The row-against-column fold at canonical representatives: a
factor at the canonical unit enters the fold as the sum's unit and
is read off, the result the canonical representative. -/
def dotN : List BPair → List BPair → BPair
  | [], _ => BPair.unit
  | _ :: _, [] => BPair.unit
  | a :: s, b :: t =>
    if a.isUnitRep || b.isUnitRep then dotN s t
    else (a * b + dotN s t).norm

/-! The determinant tier at a general entry carrier: the laws the
ported proofs consume at the entry bundle (`ground.DOps`), and the
parametrized folds.  The carrier's equality is the law bundles' own
datum, not an operation: every carrier-valued law and every
conclusion is read at that equality, so a carrier whose members
carry a value rather than a spelling (the polynomial lists)
satisfies the bundle as stated.  The balance-pair theorems below
are this tier's instances at `ground.bpairOps` — at `oneValue`
through `bpairLaws`, and the three reads stating a literal equation
at `Eq` through `bpairEqCore`, whose unit reads the literal
equality does not carry.  The pair-carrier spellings below are this
tier's own arms at that instance, each the definitional read of the
fold it names, with the concrete folds that hold no parametrized
counterpart (`rank` at its descent, `cofactorAt`, `dotN`) untouched
beside it. -/

set_option genInjectivity false in
/-- The carrier's own laws at a carrier equality `ov`: the
equality's equivalence and congruences, the sum's and the
product's commutation and association, the distribution, and the
balance partner's three reads.  Every carrier-valued law is read
at `ov`, since literal equality on a carrier denotes nothing: the
polynomial carrier reads `poly.mul [] q` at the vacant list and
`poly.mul q []` at a unit-entry list, one value at two spellings,
so a commutation stated at `Eq` there is unsatisfiable.  A carrier
whose literal equality does satisfy the laws instantiates this
bundle at `Eq`. -/
private structure DCore (γ : Type) (ops : DOps γ)
    (ov : γ → γ → Prop) : Prop where
  ovRefl : ∀ x, ov x x
  ovSymm : ∀ {x y}, ov x y → ov y x
  ovTrans : ∀ {x y z}, ov x y → ov y z → ov x z
  addCongr : ∀ {x x' y y'}, ov x x' → ov y y' →
    ov (ops.add x y) (ops.add x' y')
  mulCongr : ∀ {x x' y y'}, ov x x' → ov y y' →
    ov (ops.mul x y) (ops.mul x' y')
  swapCongr : ∀ {x y}, ov x y → ov (ops.swap x) (ops.swap y)
  addComm : ∀ x y, ov (ops.add x y) (ops.add y x)
  addAssoc : ∀ x y z,
    ov (ops.add (ops.add x y) z) (ops.add x (ops.add y z))
  mulComm : ∀ x y, ov (ops.mul x y) (ops.mul y x)
  mulAssoc : ∀ x y z,
    ov (ops.mul (ops.mul x y) z) (ops.mul x (ops.mul y z))
  leftDistrib : ∀ x y z,
    ov (ops.mul x (ops.add y z))
      (ops.add (ops.mul x y) (ops.mul x z))
  swapAdd : ∀ x y,
    ov (ops.swap (ops.add x y))
      (ops.add (ops.swap x) (ops.swap y))
  swapSwap : ∀ x, ov (ops.swap (ops.swap x)) x
  swapUnit : ov (ops.swap ops.unit) ops.unit
  mulSwapRight : ∀ x y,
    ov (ops.mul x (ops.swap y)) (ops.swap (ops.mul x y))

set_option genInjectivity false in
/-- The laws the tier's proofs consume: the carrier's own laws with
the unit reads, the one's left-unit read, and the sum's pairwise
cancellation (`def:ground`'s summand-on-both-members clause), every
one at the carrier equality.  The unit reads are the fields the
balance pair satisfies at `oneValue` and at no literal equality
(`⟨1:1⟩ + x` is not `x`), so the literal-equality instance of a
carrier is a `DCore` and never a `DLaws`. -/
private structure DLaws (γ : Type) (ops : DOps γ)
    (ov : γ → γ → Prop) : Prop extends DCore γ ops ov where
  unitAdd : ∀ x, ov (ops.add ops.unit x) x
  addUnit : ∀ x, ov (ops.add x ops.unit) x
  mulUnit : ∀ x, ov (ops.mul x ops.unit) ops.unit
  swapFix : ∀ x, ov x (ops.swap x) → ov x ops.unit
  oneMul : ∀ x, ov (ops.mul ops.one x) x
  addCancel : ∀ {a b a' b'}, ov (ops.add a b) (ops.add a' b') →
    ov a a' → ov b b'

/-! The laws' own consequences and the carrier's fold reads, the
ground balance-pair kit's parametrized twins. -/

private theorem ovOfEq {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel)
    {x y : γ} : x = y → R.rel x y
  | rfl => C.ovRefl x

/-- The displayed sum's laws at the tier's carrier, the entry the
ground fold reads take. -/
private theorem foldLawsOf {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ground.FoldLaws γ ops.add ops.unit R.rel where
  ovRefl := L.ovRefl
  ovSymm := L.ovSymm
  ovTrans := L.ovTrans
  opCongr := L.addCongr
  opComm := L.addComm
  opAssoc := L.addAssoc
  unitOp := L.unitAdd
  opUnit := L.addUnit

/-- The reordering fragment at the tier's carrier sum, the entry
the ground reordering reads take at a core-law carrier. -/
private theorem commLawsOf {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) :
    ground.CommLaws γ ops.add R.rel where
  ovRefl := C.ovRefl
  ovSymm := C.ovSymm
  ovTrans := C.ovTrans
  opCongr := C.addCongr
  opComm := C.addComm
  opAssoc := C.addAssoc

/-- The reordering fragment at the tier's carrier product. -/
private theorem commLawsMulOf {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) :
    ground.CommLaws γ ops.mul R.rel where
  ovRefl := C.ovRefl
  ovSymm := C.ovSymm
  ovTrans := C.ovTrans
  opCongr := C.mulCongr
  opComm := C.mulComm
  opAssoc := C.mulAssoc

/-- The swap's annihilation, the laws' own consequence: the joined
pair reads its own swap, and the fixed read closes at the unit. -/
private theorem annihDerived {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) (x : γ) :
    R.rel (ops.add x (ops.swap x)) ops.unit := by
  refine L.swapFix _ ?_
  refine L.toDCore.ovSymm ?_
  refine L.toDCore.ovTrans (L.toDCore.swapAdd x (ops.swap x)) ?_
  refine L.toDCore.ovTrans
    (L.toDCore.addCongr (L.toDCore.ovRefl (ops.swap x))
      (L.toDCore.swapSwap x)) ?_
  exact L.toDCore.addComm (ops.swap x) x

/-- A factor passes across the product's second operand. -/
private theorem mulSwapLeftO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) (a b z : γ) :
    R.rel (ops.mul a (ops.mul b z)) (ops.mul b (ops.mul a z)) :=
  C.ovTrans (C.ovSymm (C.mulAssoc a b z))
    (C.ovTrans (C.mulCongr (C.mulComm a b) (C.ovRefl z))
      (C.mulAssoc b a z))

/-- Two products exchange their inner factors. -/
private theorem mulShuffleO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) (a b x y : γ) :
    R.rel (ops.mul (ops.mul a b) (ops.mul x y))
      (ops.mul (ops.mul a x) (ops.mul b y)) :=
  C.ovTrans (C.mulAssoc a b (ops.mul x y))
    (C.ovTrans (C.mulCongr (C.ovRefl a) (mulSwapLeftO C b x y))
      (C.ovSymm (C.mulAssoc a x (ops.mul b y))))

/-- The product at the sum's unit on the left sits at that unit. -/
private theorem mulUnitLeftO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) (x : γ) :
    R.rel (ops.mul ops.unit x) ops.unit :=
  L.ovTrans (L.mulComm ops.unit x) (L.mulUnit x)
private theorem foldO_congr_members {γ α : Type} [DecidableEq α]
    {ops : DOps γ} {R : ground.DRead γ} (C : DCore γ ops R.rel)
    (f g : α → γ) :
    ∀ l : List α,
      (∀ x, 0 < ground.countOf x l → R.rel (f x) (g x)) →
      R.rel (ground.famFold ops.add ops.unit f l)
        (ground.famFold ops.add ops.unit g l) :=
  ground.famFold_congr_members_ov R.rel ops.add ops.unit C.ovRefl
    C.addCongr f g

private theorem foldO_mul_left {γ α : Type} {ops : DOps γ}
    {R : ground.DRead γ}
    (L : DLaws γ ops R.rel) (c : γ) (f : α → γ) : ∀ l : List α,
      R.rel (ground.famFold ops.add ops.unit
        (fun x => ops.mul c (f x)) l)
        (ops.mul c (ground.famFold ops.add ops.unit f l))
  | [] => L.ovSymm (L.mulUnit c)
  | a :: t => by
    show R.rel (ops.add (ops.mul c (f a))
        (ground.famFold ops.add ops.unit
          (fun x => ops.mul c (f x)) t))
      (ops.mul c (ops.add (f a)
        (ground.famFold ops.add ops.unit f t)))
    exact L.ovTrans
      (L.addCongr (L.ovRefl _) (foldO_mul_left L c f t))
      (L.ovSymm (L.leftDistrib c (f a)
        (ground.famFold ops.add ops.unit f t)))

private theorem foldO_swap {γ α : Type} {ops : DOps γ}
    {R : ground.DRead γ}
    (C : DCore γ ops R.rel) (f : α → γ) : ∀ l : List α,
      R.rel (ground.famFold ops.add ops.unit
        (fun x => ops.swap (f x)) l)
        (ops.swap (ground.famFold ops.add ops.unit f l))
  | [] => C.ovSymm C.swapUnit
  | a :: t => by
    show R.rel (ops.add (ops.swap (f a))
        (ground.famFold ops.add ops.unit
          (fun x => ops.swap (f x)) t))
      (ops.swap (ops.add (f a)
        (ground.famFold ops.add ops.unit f t)))
    exact C.ovTrans
      (C.addCongr (C.ovRefl _) (foldO_swap C f t))
      (C.ovSymm (C.swapAdd (f a)
        (ground.famFold ops.add ops.unit f t)))

private theorem foldO_pick {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ}
    (L : DLaws γ ops R.rel) (g : Nat → γ)
    (l : List Nat) (i : Nat) (h : ground.countOf i l = 1) :
    R.rel (ground.famFold ops.add ops.unit
      (fun j => if i = j then g j else ops.unit) l) (g i) :=
  ground.famFold_pick_ov (foldLawsOf L)
    (fun j => if i = j then g j else ops.unit) i (g i) l h
    (ovOfEq L.toDCore (if_pos rfl))
    (fun _ _ hxi => ovOfEq L.toDCore
      (if_neg (fun he => hxi he.symm)))

/-! The determinant's parametrized spellings, each arm the landed
definition's own at the bundle's operations. -/

/-- The permutation term at a carrier. -/
private def termO {γ : Type} (ops : DOps γ) :
    List (List γ) → List Nat → γ
  | [], _ => ops.one
  | _ :: _, [] => ops.one
  | r :: rs, j :: js =>
    ops.mul (ground.getAt ops.unit r j) (termO ops rs js)

/-- The swap grading's read at a carrier. -/
private def sgnO {γ : Type} (ops : DOps γ) (p : List Nat)
    (x : γ) : γ :=
  if places.parity p then ops.swap x else x

/-- The signed permutation fold at a carrier. -/
private def detO {γ : Type} (ops : DOps γ)
    (m : List (List γ)) : γ :=
  ground.famFold ops.add ops.unit
    (fun p => sgnO ops p (termO ops m p))
    (places.monomialsAt (List.replicate m.length 1))

/-- The balance pair's carrier laws, each read at `oneValue`. -/
private theorem bpairCore : DCore BPair bpairOps BPair.oneValue :=
  { ovRefl := BPair.oneValue_refl
    ovSymm := BPair.oneValue_symm
    ovTrans := BPair.oneValue_trans
    addCongr := BPair.add_congr
    mulCongr := BPair.mul_congr
    swapCongr := swap_congr
    addComm := fun x y => BPair.oneValue_of_eq (BPair.add_comm x y)
    addAssoc := fun x y z => BPair.oneValue_of_eq (BPair.add_assoc x y z)
    mulComm := fun x y => BPair.oneValue_of_eq (BPair.mul_comm x y)
    mulAssoc := fun x y z => BPair.oneValue_of_eq (BPair.mul_assoc x y z)
    leftDistrib := fun x y z =>
      BPair.oneValue_of_eq (BPair.left_distrib x y z)
    swapAdd := fun x y => BPair.oneValue_of_eq (BPair.swap_add x y)
    swapSwap := fun _ => BPair.oneValue_refl _
    swapUnit := BPair.oneValue_refl _
    mulSwapRight := fun _ _ => BPair.oneValue_refl _ }

/-- The balance pair satisfies the tier's laws, the one's
left-unit and the summand-on-both-members cancellation
`def:ground`'s own reads. -/
private theorem bpairLaws : DLaws BPair bpairOps BPair.oneValue :=
  { toDCore := bpairCore
    unitAdd := BPair.unit_add
    addUnit := BPair.add_unit
    mulUnit := BPair.mul_unit
    swapFix := fun _ h => BPair.unitOfSwap h
    oneMul := fun x =>
      BPair.oneValue_trans
        (BPair.oneValue_of_eq (BPair.mul_comm (BPair.ofPos .one) x))
        (BPair.mul_one_read x)
    addCancel := fun {a b a' b'} h ha =>
      ground.BPair.add_cancel (c := a)
        (BPair.oneValue_trans
          (BPair.oneValue_of_eq (BPair.add_comm b a))
          (BPair.oneValue_trans h
            (BPair.oneValue_trans
              (BPair.oneValue_of_eq (BPair.add_comm a' b'))
              (BPair.add_congr (BPair.oneValue_refl b')
                (BPair.oneValue_symm ha))))) }

/-- The iterated product reads the balance pair's own power. -/
private theorem powO_bpow (x : BPair) : ∀ n : Nat,
    (poly.powO bpairOps x n).oneValue (ground.bpow x n)
  | 0 => BPair.oneValue_refl _
  | n + 1 =>
    BPair.oneValue_trans
      (BPair.mul_congr (BPair.oneValue_refl x) (powO_bpow x n))
      (BPair.oneValue_symm (BPair.norm_oneValue _))
/-- The literal-equality read at the balance pairs, the Eq-tier's
own bundle. -/
private def bpairEqRead : ground.DRead BPair :=
  ⟨Eq, fun _ _ => inferInstance⟩

/-- The balance pair's carrier laws at the literal equality: the
same operations at `Eq`, which the carrier's nine laws satisfy
outright while the unit reads (`⟨1:1⟩ + x` against `x`) do not.
The three determinant reads stating a literal equation — the
adjacent exchange, the front move, and the transpose — are this
instance's, the one-value reads beside them `bpairLaws`'s. -/
private theorem bpairEqCore : DCore BPair bpairOps Eq :=
  { ovRefl := fun _ => rfl
    ovSymm := fun h => h.symm
    ovTrans := fun h1 h2 => h1.trans h2
    addCongr := fun h1 h2 => by
      show BPair.add _ _ = BPair.add _ _
      rw [show _ = _ from h1, show _ = _ from h2]
    mulCongr := fun h1 h2 => by
      show BPair.mul _ _ = BPair.mul _ _
      rw [show _ = _ from h1, show _ = _ from h2]
    swapCongr := fun h => by
      show BPair.swap _ = BPair.swap _
      rw [show _ = _ from h]
    addComm := BPair.add_comm
    addAssoc := BPair.add_assoc
    mulComm := BPair.mul_comm
    mulAssoc := BPair.mul_assoc
    leftDistrib := BPair.left_distrib
    swapAdd := BPair.swap_add
    swapSwap := fun _ => rfl
    swapUnit := rfl
    mulSwapRight := fun _ _ => rfl }

private def transposeGoO {γ : Type} (ops : DOps γ) :
    Nat → List (List γ) → List (List γ)
  | 0, _ => []
  | n + 1, m => colHead ops.unit m :: transposeGoO ops n (dropCol m)

/-- The exchange of the row and column key lists at a carrier. -/
private def transposeO {γ : Type} (ops : DOps γ)
    (m : List (List γ)) : List (List γ) :=
  transposeGoO ops
    (match m with
     | [] => 0
     | r :: _ => r.length) m

private def transposeGo : Nat → Mat → Mat := transposeGoO bpairOps

/-- The exchange of the row and column key lists. -/
def transposeM (m : Mat) : Mat := transposeO bpairOps m

/-- The entries' row-against-column folds, the matrix product. -/
def matMul (a b : Mat) : Mat :=
  let bt := transposeM b
  a.map (fun r => bt.map (fun c => dotN r c))

/-- The matrix against a vector, the rows' folds. -/
def matVec (m : Mat) (v : List BPair) : List BPair :=
  m.map (fun r => dotN r v)

/-! The entry-bundle matrix calculus: the row-against-column fold,
the stated diagonal, and the adjugate's cofactor family at a
stated determinant read, each carrier's concrete spelling the
bundle's instance; the matched congruences move the fold and the
diagonal across an entrywise read. -/

/-- The entry fold's product at two matrices, the second factor's
head row naming the column count — the row-against-column fold at
any entry bundle. -/
def matMulO {γ : Type} (ops : ground.DOps γ)
    (a b : List (List γ)) : List (List γ) :=
  a.map (fun r => (List.range (b.headD []).length).map (fun j =>
    (List.range r.length).foldl (fun acc k =>
      ops.add acc (ops.mul (ground.getAt ops.unit r k)
        (ground.getAt ops.unit (ground.getAt [] b k) j))) ops.unit))

/-- The entries' componentwise sum over shared key lists, at any
entry bundle. -/
def matAddO {γ : Type} (ops : ground.DOps γ)
    (a b : List (List γ)) : List (List γ) :=
  List.zipWith (List.zipWith ops.add) a b

/-- The memberwise swap entrywise at any entry bundle, the negation
read. -/
def matSwapO {γ : Type} (ops : ground.DOps γ)
    (a : List (List γ)) : List (List γ) :=
  a.map (fun r => r.map ops.swap)

/-- The selected block at stated row and column key lists, one entry
read per key pair, at any entry type with its stated default. -/
def selMO {γ : Type} (u : γ) (I J : List Nat)
    (S : List (List γ)) : List (List γ) :=
  I.map (fun i => J.map (fun j =>
    ground.getAt u (ground.getAt [] S i) j))

/-- The selected block's row count is the row key list's, at any
entry type. -/
theorem length_selMO {γ : Type} (u : γ) (I J : List Nat)
    (S : List (List γ)) : (selMO u I J S).length = I.length :=
  ground.length_map _ I

/-- The selected block's entry at two keys is the datum's at the
selected keys, at any entry type. -/
theorem getAt_selMO {γ : Type} (u : γ) (I J : List Nat)
    (S : List (List γ)) (p q : Nat)
    (hp : p < I.length) (hq : q < J.length) :
    ground.getAt u (ground.getAt [] (selMO u I J S) p) q
      = ground.getAt u (ground.getAt [] S (ground.getAt 0 I p))
          (ground.getAt 0 J q) := by
  rw [show selMO u I J S = I.map (fun i => J.map (fun j =>
      ground.getAt u (ground.getAt [] S i) j)) from rfl,
    ground.getAt_map 0 ([] : List γ) _ I p hp,
    ground.getAt_map 0 u _ J q hq]

/-- The stated entries on the diagonal, the off keys at the sum's
unit. -/
def diagO {γ : Type} (ops : ground.DOps γ) (ds : List γ) :
    List (List γ) :=
  ground.matOf ds.length ds.length
    (fun i j => if j = i then ground.getAt ops.unit ds i else ops.unit)

/-- The cofactor at a struck row and column against a stated
determinant read, the side the key sum's. -/
def cofO {δ γ : Type} (det : List (List δ) → γ) (sw : γ → γ)
    (m : List (List δ)) (i j : Nat) : γ :=
  let t := det ((m.eraseIdx i).map (fun r => r.eraseIdx j))
  if places.parityOf (i + j) then sw t else t

/-- The adjugate at a stated determinant read, the transposed
cofactor family. -/
def adjO {δ γ : Type} (det : List (List δ) → γ) (sw : γ → γ)
    (m : List (List δ)) : List (List γ) :=
  ground.matOf m.length m.length (fun i j => cofO det sw m j i)

/-- The first column's cofactor at a row, the side the count of
rows before: the cofactor at the fold determinant. -/
private def cofacCol0 (m : Mat) (r : Nat) : BPair :=
  cofO minor BPair.swap m r 0

/-- The adjugate row's coefficients against `p`: the first column's
cofactors at the `x^b p` rows, degree below `q`'s. -/
def bezoutA (p q : poly.Poly) : poly.Poly :=
  (List.range (q.length - 1)).map
    (fun b => cofacCol0 (shiftMat p q) (p.length - 1 + b))

/-- The adjugate row's coefficients against `q`: the first column's
cofactors at the `x^a q` rows, degree below `p`'s. -/
def bezoutB (p q : poly.Poly) : poly.Poly :=
  (List.range (p.length - 1)).map (fun a => cofacCol0 (shiftMat p q) a)

private theorem matched_headD_len {γ : Type} {R : ground.DRead γ} :
    ∀ {A B : List (List γ)},
    ground.matchedOV (ground.matchedRead R) A B →
    (A.headD []).length = (B.headD []).length
  | [], [], _ => rfl
  | [], _ :: _, h => h.elim
  | _ :: _, [], h => h.elim
  | _ :: _, _ :: _, h => ground.matched_length h.1

private theorem foldMulAddO_congr {γ : Type} (ops : ground.DOps γ)
    {R : ground.DRead γ}
    (hunit : R.rel ops.unit ops.unit)
    (hadd : ∀ {x x' y y' : γ}, R.rel x x' → R.rel y y' →
      R.rel (ops.add x y) (ops.add x' y'))
    (hmulr : ∀ (x : γ) {y y' : γ}, R.rel y y' →
      R.rel (ops.mul x y) (ops.mul x y'))
    (r : List γ) {X Y : List (List γ)}
    (hXY : ground.matchedOV (ground.matchedRead R) X Y) (j : Nat) :
    ∀ (ks : List Nat) {acc acc' : γ}, R.rel acc acc' →
    R.rel
      (ks.foldl (fun acc k => ops.add acc
        (ops.mul (ground.getAt ops.unit r k)
          (ground.getAt ops.unit (ground.getAt [] X k) j))) acc)
      (ks.foldl (fun acc k => ops.add acc
        (ops.mul (ground.getAt ops.unit r k)
          (ground.getAt ops.unit (ground.getAt [] Y k) j))) acc')
  | [], _, _, h => h
  | k :: ks, _, _, h =>
    foldMulAddO_congr ops hunit hadd hmulr r hXY j ks
      (hadd h (hmulr _
        (ground.matched_entryAll hunit
          (ground.matched_entryAll
            (show ground.matchedOV R [] [] from trivial) hXY k) j)))

/-- The entry fold's product moves across its second factor's
matched read, entry by entry through the folds. -/
theorem matMulO_congr_right {γ : Type} (ops : ground.DOps γ)
    (R : ground.DRead γ)
    (hunit : R.rel ops.unit ops.unit)
    (hadd : ∀ {x x' y y' : γ}, R.rel x x' → R.rel y y' →
      R.rel (ops.add x y) (ops.add x' y'))
    (hmulr : ∀ (x : γ) {y y' : γ}, R.rel y y' →
      R.rel (ops.mul x y) (ops.mul x y'))
    {X Y : List (List γ)}
    (hXY : ground.matchedOV (ground.matchedRead R) X Y) :
    ∀ a : List (List γ),
    ground.matchedOV (ground.matchedRead R)
      (matMulO ops a X) (matMulO ops a Y)
  | [] => trivial
  | r :: t => by
    refine ⟨?_, matMulO_congr_right ops R hunit hadd hmulr hXY t⟩
    show ground.matchedOV R
      ((List.range (X.headD []).length).map (fun j =>
        (List.range r.length).foldl (fun acc k =>
          ops.add acc (ops.mul (ground.getAt ops.unit r k)
            (ground.getAt ops.unit (ground.getAt [] X k) j)))
          ops.unit))
      ((List.range (Y.headD []).length).map (fun j =>
        (List.range r.length).foldl (fun acc k =>
          ops.add acc (ops.mul (ground.getAt ops.unit r k)
            (ground.getAt ops.unit (ground.getAt [] Y k) j)))
          ops.unit))
    rw [show (Y.headD []).length = (X.headD []).length from
      (matched_headD_len hXY).symm]
    exact ground.matched_map _ _
      (fun j => foldMulAddO_congr ops hunit hadd hmulr r hXY j
        (List.range r.length) hunit) _

/-- The replicated diagonal moves across its entry's read. -/
theorem diagO_repl_congr {γ : Type} (ops : ground.DOps γ)
    (R : ground.DRead γ) (hunit : R.rel ops.unit ops.unit)
    {p q : γ} (h : R.rel p q) (n : Nat) :
    ground.matchedOV (ground.matchedRead R)
      (diagO ops (List.replicate n p))
      (diagO ops (List.replicate n q)) := by
  show ground.matchedOV (ground.matchedRead R)
    (ground.matOf (List.replicate n p).length (List.replicate n p).length
      (fun i j => if j = i
        then ground.getAt ops.unit (List.replicate n p) i
        else ops.unit))
    (ground.matOf (List.replicate n q).length (List.replicate n q).length
      (fun i j => if j = i
        then ground.getAt ops.unit (List.replicate n q) i
        else ops.unit))
  rw [ground.length_replicate p n, ground.length_replicate q n]
  refine ground.matched_map _ _
    (fun i => ground.matched_map _ _ (fun j => ?_) _) _
  show R.rel (if j = i then ground.getAt ops.unit (List.replicate n p) i
      else ops.unit)
    (if j = i then ground.getAt ops.unit (List.replicate n q) i
      else ops.unit)
  by_cases hij : j = i
  · rw [if_pos hij, if_pos hij]
    cases Nat.lt_or_ge i n with
    | inl hi =>
      rw [ground.getAt_replicate ops.unit p n i hi,
        ground.getAt_replicate ops.unit q n i hi]
      exact h
    | inr hi =>
      rw [ground.getAt_over ops.unit _ i
          (by rw [ground.length_replicate]; exact hi),
        ground.getAt_over ops.unit _ i
          (by rw [ground.length_replicate]; exact hi)]
      exact hunit
  · rw [if_neg hij, if_neg hij]
    exact hunit

/-! The carrier at stated key lists: the tex's matrix is total over
its stated finite key lists, so the carrier holds the order — a
vector or square matrix at a stated order with the shape's read a
constructor field, an off-order datum unrepresentable.  The kit
below is hand-rolled: the core length lemmas read through
propext. -/

/-- The order read at a stated key count: the row count with every
row's column count at the order. -/
def sqAt (m : Mat) (n : Nat) : Prop :=
  (Nat.beq m.length n
    && m.all (fun r => Nat.beq r.length n)) = true

instance (m : Mat) (n : Nat) : Decidable (sqAt m n) :=
  inferInstanceAs (Decidable (_ = _))

/-- The rectangular order read at stated key counts: the row count
with every row's column count at the stated pair, the off-diagonal
slab blocks' shape. -/
def rectAt (m : Mat) (r c : Nat) : Prop :=
  (Nat.beq m.length r && m.all (fun row => Nat.beq row.length c)) = true

instance (m : Mat) (r c : Nat) : Decidable (rectAt m r c) :=
  inferInstanceAs (Decidable (_ = _))

set_option genInjectivity false in
/-- A vector at a stated order, the length the constructor's
read. -/
structure Vec (n : Nat) where
  val : List BPair
  len : Nat.beq val.length n = true

set_option genInjectivity false in
/-- A square matrix at a stated order, the key lists the
constructor's read. -/
structure SqMat (n : Nat) where
  val : Mat
  shape : sqAt val n

/-- The order off the shape's read. -/
theorem SqMat.rows {n : Nat} (A : SqMat n) : A.val.length = n :=
  ground.beqEq _ _ ((ground.andSplitB A.shape).1)

/-- The matrix against a vector at the carrier, the order kept;
the computed-window square constructor lands with the member
families' tier, its consumer. -/
def appSq {n : Nat} (A : SqMat n) (v : Vec n) : Vec n :=
  ⟨matVec A.val v.val, by
    rw [show (matVec A.val v.val).length = n from
      (ground.length_map _ A.val).trans A.rows]
    exact beqRefl n⟩

/-- The entries' componentwise sum over shared key lists. -/
def matAdd (a b : Mat) : Mat := matAddO ground.bpairOps a b

/-- The memberwise swap entrywise, the negation read. -/
def matSwap (a : Mat) : Mat := matSwapO ground.bpairOps a

/-- The swap keeps the row count. -/
theorem length_matSwap (M : Mat) : (matSwap M).length = M.length :=
  ground.length_map _ M

/-- Two matrices read one value entrywise over shared key lists. -/
def matOneValue : Mat → Mat → Prop := ground.matchedOV poly.polyRead

/-- Two matrices at one value share their row count. -/
theorem matOne_length {A B : Mat} : matOneValue A B → A.length = B.length :=
  ground.matched_length

def decMatOneValue : ∀ a b : Mat, Decidable (matOneValue a b) :=
  ground.decMatchedOV poly.polyRead

instance (a b : Mat) : Decidable (matOneValue a b) := decMatOneValue a b

/-! The matrix one-value read is a class read, with its entry reads
both ways and the pointwise map. -/

/-- The matrix one-value read is symmetric. -/
theorem matOne_symm {A B : Mat} : matOneValue A B → matOneValue B A :=
  ground.matched_symm (fun h => poly.oneValue_symm h)

/-- Two matched joins are matched. -/
theorem matOne_append : ∀ A A' B B' : Mat,
    matOneValue A A' → matOneValue B B' →
    matOneValue (A ++ B) (A' ++ B')
  | [], [], _, _, _, hB => hB
  | [], _ :: _, _, _, hA, _ => hA.elim
  | _ :: _, [], _, _, hA, _ => hA.elim
  | _ :: A, _ :: A', B, B', hA, hB =>
    ⟨hA.1, matOne_append A A' B B' hA.2 hB⟩

/-- The matrix one-value read is transitive. -/
theorem matOne_trans {A B C : Mat} : matOneValue A B → matOneValue B C →
    matOneValue A C :=
  ground.matched_trans (fun h1 h2 => poly.oneValue_trans h1 h2)

/-- A matrix one-value read is one value at every row. -/
theorem matOne_entries (A B : Mat) (h : matOneValue A B) :
    ∀ i, i < A.length →
      poly.oneValue (ground.getAt [] A i) (ground.getAt [] B i) :=
  ground.matched_entry [] h

/-- The converse read: the row count with every row's one value is
the matrix read. -/
theorem matOne_getAt (A B : Mat) (hl : A.length = B.length)
    (h : ∀ i, i < A.length →
      poly.oneValue (ground.getAt [] A i) (ground.getAt [] B i)) :
    matOneValue A B := ground.matched_ofGetAt [] hl h

/-- Two pointwise one-value row maps read one value over any index
family. -/
theorem matOne_map {α : Type} (f g : α → List BPair)
    (h : ∀ a, poly.oneValue (f a) (g a)) : ∀ l : List α,
    matOneValue (l.map f) (l.map g) := ground.matched_map f g h

/-! The memberwise swap's matrix reads: the swap commutes with the
row-against-column fold, the key-list exchange and the product, and
a swapped datum against its one-value partner sums to the unit
read entrywise — `lem:greenprod`'s transfer factors the arriving
consumer. -/

theorem dotN_swap : ∀ r c : List BPair,
    dotN r (c.map BPair.swap) = (dotN r c).swap
  | [], _ => rfl
  | _ :: _, [] => rfl
  | a :: s, b :: t => by
    show (if a.isUnitRep || b.swap.isUnitRep then
        dotN s (t.map BPair.swap)
      else (a * b.swap + dotN s (t.map BPair.swap)).norm)
      = (if a.isUnitRep || b.isUnitRep then dotN s t
        else (a * b + dotN s t).norm).swap
    rw [BPair.isUnitRep_swap]
    cases a.isUnitRep || b.isUnitRep with
    | true => exact dotN_swap s t
    | false =>
      show (a * b.swap + dotN s (t.map BPair.swap)).norm
        = ((a * b + dotN s t).norm).swap
      rw [dotN_swap s t, BPair.mul_swap, BPair.swap_add,
        BPair.norm_swap]

private theorem colHead_swap : ∀ m : Mat,
    colHead BPair.unit (matSwap m) = (colHead BPair.unit m).map BPair.swap
  | [] => rfl
  | [] :: t => congrArg (List.cons BPair.unit) (colHead_swap t)
  | (a :: _) :: t => congrArg (List.cons a.swap) (colHead_swap t)

private theorem dropCol_swap : ∀ m : Mat,
    dropCol (matSwap m) = matSwap (dropCol m)
  | [] => rfl
  | [] :: t => congrArg (List.cons []) (dropCol_swap t)
  | (_ :: u) :: t =>
    congrArg (List.cons (u.map BPair.swap)) (dropCol_swap t)

private theorem transGoSwap : ∀ (n : Nat) (m : Mat),
    transposeGo n (matSwap m) = matSwap (transposeGo n m)
  | 0, _ => rfl
  | n + 1, m => by
    show colHead BPair.unit (matSwap m)
        :: transposeGo n (dropCol (matSwap m))
      = (colHead BPair.unit m).map BPair.swap
        :: matSwap (transposeGo n (dropCol m))
    rw [colHead_swap m, dropCol_swap m, transGoSwap n (dropCol m)]

/-- The key-list exchange commutes with the memberwise swap. -/
theorem transposeM_swap (m : Mat) :
    transposeM (matSwap m) = matSwap (transposeM m) := by
  cases m with
  | nil => rfl
  | cons r t =>
    show transposeGo (r.map BPair.swap).length (matSwap (r :: t))
      = matSwap (transposeGo r.length (r :: t))
    rw [ground.length_map BPair.swap r]
    exact transGoSwap _ _

/-- The product against a swapped factor is the product's swap, the
transfer factors' read. -/
theorem matMul_swap (a b : Mat) :
    matMul a (matSwap b) = matSwap (matMul a b) := by
  show a.map (fun r => (transposeM (matSwap b)).map
      (fun c => dotN r c))
    = (a.map (fun r => (transposeM b).map (fun c => dotN r c))).map
      (fun r => r.map BPair.swap)
  rw [transposeM_swap, ground.map_map]
  apply ground.map_congr_all
  intro r
  show ((transposeM b).map (fun c => c.map BPair.swap)).map
      (fun c => dotN r c)
    = ((transposeM b).map (fun c => dotN r c)).map BPair.swap
  rw [ground.map_map, ground.map_map]
  apply ground.map_congr_all
  intro c
  exact dotN_swap r c

/-- Every entry reads the sum's unit, the matrix's unit-tail read
row by row. -/
def matNull : Mat → Prop
  | [] => True
  | r :: t => poly.unitTail r ∧ matNull t

def decMatNull : ∀ m : Mat, Decidable (matNull m)
  | [] => isTrue trivial
  | _ :: t => @instDecidableAnd _ _ (poly.decUnitTail _) (decMatNull t)

instance (m : Mat) : Decidable (matNull m) := decMatNull m

private theorem unitTail_colHead : ∀ m : Mat, matNull m →
    poly.unitTail (colHead BPair.unit m)
  | [], _ => trivial
  | [] :: t, h => ⟨BPair.oneValue_refl BPair.unit,
      unitTail_colHead t h.2⟩
  | (_ :: _) :: t, h => ⟨h.1.1, unitTail_colHead t h.2⟩

private theorem matNull_dropCol : ∀ m : Mat, matNull m →
    matNull (dropCol m)
  | [], _ => trivial
  | [] :: t, h => ⟨trivial, matNull_dropCol t h.2⟩
  | (_ :: _) :: t, h => ⟨h.1.2, matNull_dropCol t h.2⟩

private theorem matNull_transposeGo : ∀ (n : Nat) (m : Mat),
    matNull m → matNull (transposeGo n m)
  | 0, _, _ => trivial
  | n + 1, m, h => ⟨unitTail_colHead m h,
      matNull_transposeGo n (dropCol m) (matNull_dropCol m h)⟩

/-- The key exchange keeps the null read: a matrix whose every
entry reads the sum's unit transposes to one whose every entry
does. -/
theorem matNull_transposeM : ∀ m : Mat, matNull m →
    matNull (transposeM m)
  | [], _ => trivial
  | r :: t, h => matNull_transposeGo r.length (r :: t) h

private theorem rowNull : ∀ {r s : List BPair}, poly.oneValue r s →
    poly.unitTail (List.zipWith (fun x y => x + y)
      (r.map BPair.swap) s)
  | [], [], _ => trivial
  | [], _ :: _, _ => trivial
  | _ :: _, [], _ => trivial
  | _ :: _, _ :: _, h => ⟨BPair.swap_add_null h.1, rowNull h.2⟩

/-- A swapped datum against its one-value partner sums to the unit
read: the site identity `A = B + S` read at `S` the sum's unit. -/
theorem matNull_swap_add : ∀ {M B : Mat}, matOneValue M B →
    matNull (matAdd (matSwap M) B)
  | [], [], _ => trivial
  | [], _ :: _, h => h.elim
  | _ :: _, [], h => h.elim
  | _ :: _, _ :: _, h => ⟨rowNull h.1, matNull_swap_add h.2⟩

/-! The determinant's row tier, the signed permutation fold: the
minor's value at a second spelling, the fold over the place
permutations of the term products at the swap grading, whose row
theory the span arithmetic below consumes — the alternation at the
transposition pairing (`detL_rows_equal`), the adjacent row move's
sign (`detL_swapAdj`), and the expansion tier beneath the adjugate
row solve.  The two spellings' coherence at instances is the check
module's pin. -/

/-- The permutation term: one factor per row at the assignment's
column. -/
def termAt : Mat → List Nat → BPair := termO bpairOps

/-- The swap grading's read on a datum: the odd class swaps the
members. -/
def sgnAt (p : List Nat) (x : BPair) : BPair := sgnO bpairOps p x

/-- The determinant as the signed permutation fold, the assignment
fold's spelling (`def:elim`'s collected minor). -/
def detL (m : Mat) : BPair := detO bpairOps m

/-- The minor collects to the assignment fold, `def:elim`'s stated
identity at a matrix: the first-row fold against the signed
permutation fold, the batteries its instances. -/
def assignRead (m : Mat) : Prop := (minor m).oneValue (detL m)

instance (m : Mat) : Decidable (assignRead m) :=
  inferInstanceAs (Decidable (_ = _))


/-- The term as the index fold, the reordering carrier. -/
private theorem termO_fold {γ : Type} (ops : DOps γ) :
    ∀ (m : List (List γ)) (p : List Nat),
    m.length = p.length →
    termO ops m p = ground.famFold ops.mul ops.one
      (fun t => ground.getAt ops.unit (ground.getAt [] m t)
        (ground.getAt 0 p t)) (List.range m.length)
  | [], [], _ => rfl
  | [], _ :: _, h => nomatch h
  | _ :: _, [], h => nomatch h
  | r :: rs, j :: js, h => by
    show ops.mul (ground.getAt ops.unit r j) (termO ops rs js)
      = ground.famFold ops.mul ops.one
        (fun t => ground.getAt ops.unit
          (ground.getAt [] (r :: rs) t)
          (ground.getAt 0 (j :: js) t))
        (List.range (rs.length + 1))
    rw [range_cons rs.length]
    show ops.mul (ground.getAt ops.unit r j) (termO ops rs js)
      = ops.mul (ground.getAt ops.unit r j)
        (ground.famFold ops.mul ops.one
          (fun t => ground.getAt ops.unit
            (ground.getAt [] (r :: rs) t)
            (ground.getAt 0 (j :: js) t))
          ((List.range rs.length).map (fun x => x + 1)))
    rw [ground.famFold_map, termO_fold ops rs js (Nat.succ.inj h)]
    rfl

private theorem sgnO_congr {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ}
    (C : DCore γ ops R.rel) (p : List Nat) {x y : γ} (h : R.rel x y) :
    R.rel (sgnO ops p x) (sgnO ops p y) := by
  show R.rel (if places.parity p then ops.swap x else x)
    (if places.parity p then ops.swap y else y)
  cases places.parity p with
  | true => exact C.swapCongr h
  | false => exact h

private theorem termO_adjSwap {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ}
    (C : DCore γ ops R.rel) : ∀ (k : Nat) (m : List (List γ))
    (p : List Nat), m.length = p.length →
    R.rel (termO ops (ground.adjSwap k m) p)
      (termO ops m (ground.adjSwap k p))
  | 0, [], [], _ => C.ovRefl _
  | _ + 1, [], [], _ => C.ovRefl _
  | 0, [], _ :: _, h => nomatch h
  | _ + 1, [], _ :: _, h => nomatch h
  | 0, [_], [_], _ => C.ovRefl _
  | 0, [_], [], h => nomatch h
  | 0, [_], _ :: _ :: _, h => nomatch (Nat.succ.inj h)
  | 0, _ :: _ :: _, [], h => nomatch h
  | 0, _ :: _ :: _, [_], h => nomatch (Nat.succ.inj h)
  | 0, r1 :: r2 :: rt, j1 :: j2 :: jt, _ => by
    show R.rel (ops.mul (ground.getAt ops.unit r2 j1)
        (ops.mul (ground.getAt ops.unit r1 j2) (termO ops rt jt)))
      (ops.mul (ground.getAt ops.unit r1 j2)
        (ops.mul (ground.getAt ops.unit r2 j1) (termO ops rt jt)))
    exact ground.opLeftCommO (commLawsMulOf C) _ _ _
  | k + 1, r :: rt, [], h => nomatch h
  | k + 1, r :: rt, j :: jt, h => by
    show R.rel (ops.mul (ground.getAt ops.unit r j)
        (termO ops (ground.adjSwap k rt) jt))
      (ops.mul (ground.getAt ops.unit r j)
        (termO ops rt (ground.adjSwap k jt)))
    exact C.mulCongr (C.ovRefl _)
      (termO_adjSwap C k rt jt (Nat.succ.inj h))

/-- The place permutations at a count, the enumeration. -/
private def permsE (d : Nat) : List (List Nat) :=
  places.monomialsAt (List.replicate d 1)

private theorem perm_len {d : Nat} {p : List Nat}
    (hp : 0 < ground.countOf p (permsE d)) : p.length = d :=
  (places.perm_member_reads hp).1

private theorem perm_distinct {d : Nat} {p : List Nat}
    (hp : 0 < ground.countOf p (permsE d)) :
    ∀ x, ground.countOf x p ≤ 1 :=
  (places.perm_member_reads hp).2.1

private theorem detO_swapAdj {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ}
    (C : DCore γ ops R.rel) (k : Nat) (m : List (List γ))
    (hk : k + 1 < m.length) :
    R.rel (detO ops (ground.adjSwap k m)) (ops.swap (detO ops m)) := by
  show R.rel (ground.famFold ops.add ops.unit
      (fun p => sgnO ops p (termO ops (ground.adjSwap k m) p))
      (places.monomialsAt
        (List.replicate (ground.adjSwap k m).length 1)))
    (ops.swap (detO ops m))
  rw [ground.length_adjSwap k m]
  refine C.ovTrans (ground.famFold_bij_ov (commLawsOf C) ops.unit _
    (fun p => ops.swap (sgnO ops p (termO ops m p)))
    (places.monomialsAt_distinct (List.replicate m.length 1))
    (g := ground.adjSwap k) (h := ground.adjSwap k)
    (fun p _ => ground.adjSwap_adjSwap k p)
    (fun p _ => ground.adjSwap_adjSwap k p)
    (fun p hp => places.perm_member_of_counts hp
      (ground.length_adjSwap k p)
      (fun x => ground.countOf_adjSwap x k p))
    (fun p hp => places.perm_member_of_counts hp
      (ground.length_adjSwap k p)
      (fun x => ground.countOf_adjSwap x k p))
    (fun p hp => ?_))
    (foldO_swap C (fun p => sgnO ops p (termO ops m p))
      (places.monomialsAt (List.replicate m.length 1)))
  refine C.ovTrans (sgnO_congr C p
    (termO_adjSwap C k m p ((perm_len hp).symm))) ?_
  show R.rel (if places.parity p then
      ops.swap (termO ops m (ground.adjSwap k p))
      else termO ops m (ground.adjSwap k p))
    (ops.swap (if places.parity (ground.adjSwap k p) then
      ops.swap (termO ops m (ground.adjSwap k p))
      else termO ops m (ground.adjSwap k p)))
  rw [places.parity_adjSwap k p
    (by rw [perm_len hp]; exact hk)
    (ground.getAt_ne_of_distinct (perm_distinct hp)
      (Nat.lt_succ_self k)
      (by rw [perm_len hp]; exact hk))]
  cases places.parity p with
  | true => exact C.ovRefl _
  | false => exact C.ovSymm (C.swapSwap _)

/-- The adjacent assignment exchange's fold read: the exchanged
rows' determinant is the memberwise swap, the sign of the move. -/
theorem detL_swapAdj (k : Nat) (m : Mat) (hk : k + 1 < m.length) :
    detL (ground.adjSwap k m) = (detL m).swap :=
  detO_swapAdj (R := bpairEqRead) bpairEqCore k m hk

private theorem detO_rows_equal {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ}
    (L : DLaws γ ops R.rel) {m : List (List γ)} {i j : Nat} (hij : i < j)
    (hjm : j < m.length)
    (heq : ground.getAt [] m i = ground.getAt [] m j) :
    R.rel (detO ops m) ops.unit := by
  have him : i < m.length := Nat.lt_trans hij hjm
  have hne : i ≠ j := fun he => Nat.lt_irrefl i (he ▸ hij)
  have hterm : ∀ p : List Nat,
      0 < ground.countOf p (permsE m.length) →
      R.rel (termO ops m (places.swapPair i j p)) (termO ops m p) := by
    intro p hp
    have hplen : p.length = m.length := perm_len hp
    have hswlen : (places.swapPair i j p).length = m.length := by
      rw [places.length_swapPair i j p]
      exact hplen
    rw [termO_fold ops m (places.swapPair i j p) hswlen.symm,
      termO_fold ops m p hplen.symm]
    refine ground.famFold_bij_ov (commLawsMulOf L.toDCore) ops.one _
      (fun t => ground.getAt ops.unit (ground.getAt [] m t)
        (ground.getAt 0 p t))
      (ground.distinctList_range m.length)
      (g := swapIx i j) (h := swapIx i j)
      (fun t _ => swapIx_invol i j t)
      (fun t _ => swapIx_invol i j t)
      (fun t ht => ground.countOf_range_pos
        (swapIx_lt him hjm t (ground.ltOfMem ht)))
      (fun t ht => ground.countOf_range_pos
        (swapIx_lt him hjm t (ground.ltOfMem ht)))
      (fun t ht => ?_)
    show R.rel (ground.getAt ops.unit (ground.getAt [] m t)
        (ground.getAt 0 (places.swapPair i j p) t))
      (ground.getAt ops.unit
        (ground.getAt [] m (swapIx i j t))
        (ground.getAt 0 p (swapIx i j t)))
    by_cases hti : t = i
    · rw [show swapIx i j t = j from by
          show (if t = i then j else _) = j
          rw [if_pos hti],
        hti,
        places.getAt_swapPair_fst p hne
          (by rw [hplen]; exact him)
          (by rw [hplen]; exact hjm),
        heq]
      exact L.ovRefl _
    · by_cases htj : t = j
      · rw [show swapIx i j t = i from by
            show (if t = i then j else if t = j then i else t)
              = i
            rw [if_neg hti, if_pos htj],
          htj,
          places.getAt_swapPair_snd p hne
            (by rw [hplen]; exact him)
            (by rw [hplen]; exact hjm),
          heq]
        exact L.ovRefl _
      · rw [show swapIx i j t = t from by
            show (if t = i then j else if t = j then i else t)
              = t
            rw [if_neg hti, if_neg htj],
          places.getAt_swapPair_ne p
            (by rw [hplen]; exact him)
            (by rw [hplen]; exact hjm) hti htj]
        exact L.ovRefl _
  have hself : R.rel (detO ops m) (ops.swap (detO ops m)) := by
    show R.rel (ground.famFold ops.add ops.unit
        (fun p => sgnO ops p (termO ops m p))
        (places.monomialsAt (List.replicate m.length 1)))
      (ops.swap (detO ops m))
    refine L.ovTrans (ground.famFold_bij_ov (commLawsOf L.toDCore) ops.unit _
      (fun p => ops.swap (sgnO ops p (termO ops m p)))
      (places.monomialsAt_distinct (List.replicate m.length 1))
      (g := places.swapPair i j) (h := places.swapPair i j)
      (fun p _ => places.swapPair_swapPair i j p)
      (fun p _ => places.swapPair_swapPair i j p)
      (fun p hp => places.perm_member_of_counts hp
        (places.length_swapPair i j p)
        (fun x => places.countOf_swapPair x i j p))
      (fun p hp => places.perm_member_of_counts hp
        (places.length_swapPair i j p)
        (fun x => places.countOf_swapPair x i j p))
      (fun p hp => ?_))
      (foldO_swap L.toDCore
        (fun p => sgnO ops p (termO ops m p)) (permsE m.length))
    refine L.ovTrans
      (sgnO_congr L.toDCore p (L.ovSymm (hterm p hp))) ?_
    show R.rel (if places.parity p then
        ops.swap (termO ops m (places.swapPair i j p))
        else termO ops m (places.swapPair i j p))
      (ops.swap (if places.parity (places.swapPair i j p) then
        ops.swap (termO ops m (places.swapPair i j p))
        else termO ops m (places.swapPair i j p)))
    rw [places.parity_swapPair p hne
      (by rw [perm_len hp]; exact him)
      (by rw [perm_len hp]; exact hjm)
      (perm_distinct hp)]
    cases places.parity p with
    | true => exact L.ovRefl _
    | false => exact L.ovSymm (L.swapSwap _)
  exact L.swapFix _ hself

/-- Two equal rows read the determinant at the sum's unit: the
transposition pairing, each permutation against its exchange at
the flipped grading and the one term. -/
theorem detL_rows_equal {m : Mat} {i j : Nat} (hij : i < j)
    (hjm : j < m.length)
    (heq : ground.getAt [] m i = ground.getAt [] m j) :
    (detL m).oneValue BPair.unit :=
  detO_rows_equal (R := ground.bpairRead) bpairLaws hij hjm heq

/-! The expansion at the head row: the enumeration regrouped by its
first letter (`places.monomialsAt_ones_expand`), the head's sign
splitting off the tail's grading, and the head cofactors' fold —
the adjugate row solve's carrier. -/

/-- The dropped key's content: the letters below the key once, the
key unoccupied, the letters beyond once. -/
def subContent (j e : Nat) : List Nat :=
  List.replicate j 1 ++ 0 :: List.replicate (e - j) 1

/-- The head cofactor at a key, at a carrier. -/
private def cof0O {γ : Type} (ops : DOps γ) (rest : List (List γ))
    (j : Nat) : γ :=
  ground.famFold ops.add ops.unit
    (fun t => sgnO ops t (termO ops rest t))
    (places.monomialsAt (subContent j rest.length))

/-- The head cofactor at a key: the signed fold over the dropped
key's arrangements, the expansion's own object. -/
def cof0 (rest : Mat) (j : Nat) : BPair := cof0O bpairOps rest j

/-- The key parity's read at a carrier. -/
private def sgnPO {γ : Type} (ops : DOps γ) (k : Nat) (x : γ) : γ :=
  if places.parityOf k then ops.swap x else x

/-- A graded read at the sum's unit puts the datum there. -/
private theorem sgnPO_unit {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) {s : Nat} {x : γ}
    (h : R.rel (sgnPO ops s x) ops.unit) : R.rel x ops.unit := by
  have h' : R.rel (if places.parityOf s then ops.swap x else x)
      ops.unit := h
  by_cases hp : places.parityOf s = true
  · rw [if_pos hp] at h'
    exact C.ovTrans (C.ovSymm (C.swapSwap x))
      (C.ovTrans (C.swapCongr h') C.swapUnit)
  · rw [if_neg hp] at h'
    exact h'

/-- The key parity's read on a datum, the expansion's sign. -/
def sgnP (k : Nat) (x : BPair) : BPair := sgnPO bpairOps k x

private theorem sgnPO_congr {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ}
    (C : DCore γ ops R.rel) {k : Nat} {x y : γ} (h : R.rel x y) :
    R.rel (sgnPO ops k x) (sgnPO ops k y) := by
  show R.rel (if places.parityOf k then ops.swap x else x)
    (if places.parityOf k then ops.swap y else y)
  cases places.parityOf k with
  | true => exact C.swapCongr h
  | false => exact h

private theorem fold_sgnPO {γ α : Type} {ops : DOps γ}
    {R : ground.DRead γ}
    (C : DCore γ ops R.rel) (k : Nat) (h : α → γ) (l : List α) :
    R.rel (ground.famFold ops.add ops.unit
      (fun x => sgnPO ops k (h x)) l)
      (sgnPO ops k (ground.famFold ops.add ops.unit h l)) := by
  show R.rel (ground.famFold ops.add ops.unit
      (fun x => if places.parityOf k then ops.swap (h x) else h x) l)
    (if places.parityOf k
      then ops.swap (ground.famFold ops.add ops.unit h l)
      else ground.famFold ops.add ops.unit h l)
  cases places.parityOf k with
  | true => exact foldO_swap C h l
  | false => exact C.ovRefl _

private theorem sub_member_counts {e j : Nat} {t : List Nat}
    (ht : 0 < ground.countOf t
      (places.monomialsAt (subContent j e))) :
    ∀ x, x < j → ground.countOf x t = 1 := by
  intro x hxj
  rw [places.countOf_monomialsAt] at ht
  by_cases hc : t.length = ground.sumNat (subContent j e)
      ∧ places.content (subContent j e).length t = subContent j e
  · have hd : x < (subContent j e).length := by
      show x < (List.replicate j 1
        ++ 0 :: List.replicate (e - j) 1).length
      rw [ground.length_append, ground.length_replicate 1 j]
      exact Nat.lt_of_lt_of_le hxj (Nat.le_add_right _ _)
    have hread : ground.getAt 0
        (places.content (subContent j e).length t) x
        = ground.countOf x t := by
      show ground.getAt 0
          ((List.range (subContent j e).length).map
            (fun i => ground.countOf i t)) x = _
      rw [ground.getAt_map 0 0 _
          (List.range (subContent j e).length) x
          (by rw [ground.length_range]; exact hd),
        ground.getAt_range _ x hd]
    rw [← hread, hc.2]
    show ground.getAt 0
        (List.replicate j 1 ++ 0 :: List.replicate (e - j) 1) x = 1
    rw [ground.getAt_append 0 _ _ x,
      if_pos (by rw [ground.length_replicate 1 j]; exact hxj)]
    exact ground.getAt_replicate 0 1 j x hxj
  · rw [if_neg hc] at ht
    exact absurd ht (Nat.lt_irrefl 0)

private theorem parity_cons_sub {e j : Nat} {t : List Nat}
    (ht : 0 < ground.countOf t
      (places.monomialsAt (subContent j e))) :
    places.parity (j :: t)
      = xor (places.parityOf j) (places.parity t) := by
  show places.parityOf (places.inversions (j :: t)) = _
  rw [places.inversions_cons_of_counts j t
      (fun x hx => by
        rw [sub_member_counts ht x hx]
        exact Nat.succ_pos 0)
      (fun x hx => by
        rw [sub_member_counts ht x hx]
        exact Nat.le_refl 1),
    places.parityOf_add j (places.inversions t)]
  rfl

private theorem detO_cons {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ}
    (L : DLaws γ ops R.rel) (r : List γ) (rest : List (List γ)) :
    R.rel (detO ops (r :: rest))
      (ground.famFold ops.add ops.unit
        (fun j => sgnPO ops j
          (ops.mul (ground.getAt ops.unit r j) (cof0O ops rest j)))
        (List.range (rest.length + 1))) := by
  show R.rel (ground.famFold ops.add ops.unit
      (fun p => sgnO ops p (termO ops (r :: rest) p))
      (places.monomialsAt
        (List.replicate (rest.length + 1) 1))) _
  rw [places.monomialsAt_ones_expand rest.length]
  refine L.ovTrans
    (ground.famFold_flatMap_ov (foldLawsOf L)
      (fun p => sgnO ops p (termO ops (r :: rest) p))
      (fun j => (places.monomialsAt (List.replicate j 1
          ++ 0 :: List.replicate (rest.length - j) 1)).map
        (fun t => j :: t))
      (List.range (rest.length + 1))) ?_
  refine foldO_congr_members L.toDCore _ _
    (List.range (rest.length + 1)) (fun j _ => ?_)
  rw [ground.famFold_map ops.add ops.unit _ (fun t => j :: t)]
  refine L.ovTrans (foldO_congr_members L.toDCore
    (fun t => sgnO ops (j :: t) (termO ops (r :: rest) (j :: t)))
    (fun t => sgnPO ops j (ops.mul (ground.getAt ops.unit r j)
      (sgnO ops t (termO ops rest t))))
    (places.monomialsAt (List.replicate j 1
      ++ 0 :: List.replicate (rest.length - j) 1))
    (fun t htm => by
      have hpar : places.parity (j :: t)
          = xor (places.parityOf j) (places.parity t) :=
        parity_cons_sub (e := rest.length) (j := j) htm
      show R.rel (if places.parity (j :: t) then
          ops.swap (ops.mul (ground.getAt ops.unit r j)
            (termO ops rest t))
        else ops.mul (ground.getAt ops.unit r j) (termO ops rest t))
        (sgnPO ops j (ops.mul (ground.getAt ops.unit r j)
          (sgnO ops t (termO ops rest t))))
      rw [hpar]
      show R.rel (if xor (places.parityOf j) (places.parity t) then
          ops.swap (ops.mul (ground.getAt ops.unit r j)
            (termO ops rest t))
        else ops.mul (ground.getAt ops.unit r j) (termO ops rest t))
        (if places.parityOf j then
            ops.swap (ops.mul (ground.getAt ops.unit r j)
              (if places.parity t then ops.swap (termO ops rest t)
                else termO ops rest t))
          else ops.mul (ground.getAt ops.unit r j)
            (if places.parity t then ops.swap (termO ops rest t)
              else termO ops rest t))
      cases places.parityOf j with
      | true =>
        cases places.parity t with
        | true =>
          show R.rel (ops.mul (ground.getAt ops.unit r j)
              (termO ops rest t))
            (ops.swap (ops.mul (ground.getAt ops.unit r j)
              (ops.swap (termO ops rest t))))
          exact L.ovTrans
            (L.mulCongr (L.ovRefl _)
              (L.ovSymm (L.swapSwap (termO ops rest t))))
            (L.mulSwapRight (ground.getAt ops.unit r j)
              (ops.swap (termO ops rest t)))
        | false => exact L.ovRefl _
      | false =>
        cases places.parity t with
        | true =>
          show R.rel (ops.swap (ops.mul (ground.getAt ops.unit r j)
              (termO ops rest t)))
            (ops.mul (ground.getAt ops.unit r j)
              (ops.swap (termO ops rest t)))
          exact L.ovSymm (L.mulSwapRight
            (ground.getAt ops.unit r j) (termO ops rest t))
        | false => exact L.ovRefl _)) ?_
  refine L.ovTrans (fold_sgnPO L.toDCore j _ _) ?_
  exact sgnPO_congr L.toDCore
    (foldO_mul_left L (ground.getAt ops.unit r j)
      (fun t => sgnO ops t (termO ops rest t))
      (places.monomialsAt (List.replicate j 1
        ++ 0 :: List.replicate (rest.length - j) 1)))

/-! The expansion at every row: the row brought to the front by
the adjacent exchanges, the sign the crossing count's parity, and
the replaced row's expansion — the adjugate row solve's two
reads. -/

/-- The row brought to the front, one adjacent exchange per
crossing. -/
def frontRec {α : Type} : Nat → List α → List α
  | 0, m => m
  | k + 1, m => frontRec k (ground.adjSwap k m)

private theorem frontRec_shape {α : Type} (d : α) :
    ∀ (k : Nat) (m : List α), k < m.length →
      frontRec k m = ground.getAt d m k :: m.eraseIdx k
  | 0, m, h =>
    match m, h with
    | _ :: _, _ => rfl
  | k + 1, m, h => by
    show frontRec k (ground.adjSwap k m) = _
    rw [frontRec_shape d k (ground.adjSwap k m)
        (by rw [ground.length_adjSwap]; exact Nat.lt_of_succ_lt h),
      ground.getAt_adjSwap_fst d k m h, ground.eraseIdx_adjSwap k m h]

private theorem sgnPO_succ {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ}
    (C : DCore γ ops R.rel) (k : Nat) (x : γ) :
    R.rel (ops.swap (sgnPO ops k x)) (sgnPO ops (k + 1) x) := by
  show R.rel (ops.swap (if places.parityOf k then ops.swap x else x))
    (if !(places.parityOf k) then ops.swap x else x)
  cases places.parityOf k with
  | true => exact C.swapSwap x
  | false => exact C.ovRefl _

private theorem sgnPO_add {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ}
    (C : DCore γ ops R.rel) (a b : Nat) (x : γ) :
    R.rel (sgnPO ops a (sgnPO ops b x)) (sgnPO ops (a + b) x) := by
  show R.rel (if places.parityOf a then
      ops.swap (if places.parityOf b then ops.swap x else x)
    else (if places.parityOf b then ops.swap x else x))
    (if places.parityOf (a + b) then ops.swap x else x)
  rw [places.parityOf_add a b]
  cases places.parityOf a with
  | true =>
    cases places.parityOf b with
    | true => exact C.swapSwap x
    | false => exact C.ovRefl _
  | false =>
    cases places.parityOf b with
    | true => exact C.ovRefl _
    | false => exact C.ovRefl _

private theorem sgnPO_mul {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ}
    (C : DCore γ ops R.rel) (s : Nat) (x y : γ) :
    R.rel (sgnPO ops s (ops.mul x y)) (ops.mul x (sgnPO ops s y)) := by
  show R.rel (if places.parityOf s then ops.swap (ops.mul x y)
      else ops.mul x y)
    (ops.mul x (if places.parityOf s then ops.swap y else y))
  cases places.parityOf s with
  | true => exact C.ovSymm (C.mulSwapRight x y)
  | false => exact C.ovRefl _

private theorem detO_frontRec {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ}
    (C : DCore γ ops R.rel) : ∀ (k : Nat) (m : List (List γ)),
    k < m.length →
    R.rel (detO ops m) (sgnPO ops k (detO ops (frontRec k m)))
  | 0, _, _ => C.ovRefl _
  | k + 1, m, h => by
    have h1 : R.rel (detO ops (ground.adjSwap k m)) (ops.swap (detO ops m)) :=
      detO_swapAdj C k m h
    have h2 : R.rel (detO ops (ground.adjSwap k m))
        (sgnPO ops k (detO ops (frontRec k (ground.adjSwap k m)))) :=
      detO_frontRec C k (ground.adjSwap k m)
        (by rw [ground.length_adjSwap]; exact Nat.lt_of_succ_lt h)
    show R.rel (detO ops m)
      (sgnPO ops (k + 1)
        (detO ops (frontRec k (ground.adjSwap k m))))
    exact C.ovTrans
      (C.ovTrans (C.ovSymm (C.swapSwap (detO ops m)))
        (C.swapCongr (C.ovTrans (C.ovSymm h1) h2)))
      (sgnPO_succ C k (detO ops (frontRec k (ground.adjSwap k m))))

private theorem detO_replace {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ}
    (L : DLaws γ ops R.rel) (m : List (List γ)) (k : Nat)
    (hk : k < m.length) (b : List γ) :
    R.rel (detO ops (List.set m k b))
      (ground.famFold ops.add ops.unit
        (fun j => sgnPO ops (k + j)
          (ops.mul (ground.getAt ops.unit b j)
            (cof0O ops (m.eraseIdx k) j)))
        (List.range ((m.eraseIdx k).length + 1))) := by
  have hks : k < (List.set m k b).length := by
    rw [ground.length_set]
    exact hk
  have hshape : frontRec k (List.set m k b) = b :: m.eraseIdx k := by
    rw [frontRec_shape [] k (List.set m k b) hks,
      ground.getAt_set_self [] b m k hk, ground.eraseIdx_set b m k]
  have hfront : R.rel (detO ops (List.set m k b))
      (sgnPO ops k (detO ops (b :: m.eraseIdx k))) := by
    have hf := detO_frontRec L.toDCore k (List.set m k b) hks
    rw [hshape] at hf
    exact hf
  refine L.ovTrans hfront ?_
  refine L.ovTrans
    (sgnPO_congr L.toDCore (detO_cons L b (m.eraseIdx k))) ?_
  refine L.ovTrans (L.ovSymm (fold_sgnPO L.toDCore k
    (fun j => sgnPO ops j
      (ops.mul (ground.getAt ops.unit b j)
        (cof0O ops (m.eraseIdx k) j)))
    (List.range ((m.eraseIdx k).length + 1)))) ?_
  exact foldO_congr_members L.toDCore
    (fun j => sgnPO ops k (sgnPO ops j
      (ops.mul (ground.getAt ops.unit b j)
        (cof0O ops (m.eraseIdx k) j))))
    (fun j => sgnPO ops (k + j)
      (ops.mul (ground.getAt ops.unit b j)
        (cof0O ops (m.eraseIdx k) j)))
    (List.range ((m.eraseIdx k).length + 1))
    (fun j _ => sgnPO_add L.toDCore k j _)

/-! The adjugate row solve: the cofactor vector at a row, the
diagonal read the determinant with the off-diagonal reads at the
sum's unit — the row-replacement expansion against the equal-rows
alternation. -/

/-- The plain row-against-column fold at the bundle's own core. -/
private def dotO {γ : Type} (ops : DOps γ) :
    List γ → List γ → γ :=
  ground.dotO ops.toPOps

/-- The plain row-against-column fold, the proof carrier beside
`dotN`'s skipping spelling. -/
def dotP : List BPair → List BPair → BPair := dotO bpairOps

/-- The cofactor vector at a row, at a carrier. -/
private def cofVecO {γ : Type} (ops : DOps γ) (m : List (List γ))
    (k : Nat) : List γ :=
  (List.range m.length).map (fun j =>
    sgnPO ops (k + j) (cof0O ops (m.eraseIdx k) j))

/-- The cofactor vector at a row: one signed head cofactor per
column key. -/
def cofVec (m : Mat) (k : Nat) : List BPair := cofVecO bpairOps m k

private theorem dotO_map_range {γ : Type} (ops : DOps γ)
    (g : Nat → γ) :
    ∀ (n : Nat) (x : List γ), x.length = n →
      dotO ops x ((List.range n).map g)
        = ground.famFold ops.add ops.unit
          (fun j => ops.mul (ground.getAt ops.unit x j) (g j))
          (List.range n)
  | 0, [], _ => rfl
  | 0, _ :: _, h => nomatch h
  | _ + 1, [], h => nomatch h
  | n + 1, a :: s, h => by
    rw [range_cons n]
    show ops.add (ops.mul a (g 0))
        (dotO ops s (((List.range n).map (fun x => x + 1)).map g))
      = ops.add (ops.mul (ground.getAt ops.unit (a :: s) 0) (g 0))
        (ground.famFold ops.add ops.unit
          (fun j => ops.mul (ground.getAt ops.unit (a :: s) j) (g j))
          ((List.range n).map (fun x => x + 1)))
    rw [ground.map_map (fun x => x + 1) g (List.range n),
      ground.famFold_map ops.add ops.unit _ (fun x => x + 1),
      dotO_map_range ops (fun x => g (x + 1)) n s (Nat.succ.inj h)]
    rfl

private theorem cofVecO_diag {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ}
    (L : DLaws γ ops R.rel) (m : List (List γ)) (k : Nat)
    (hk : k < m.length)
    (hrow : (ground.getAt [] m k).length = m.length) :
    R.rel (dotO ops (ground.getAt [] m k) (cofVecO ops m k))
      (detO ops m) := by
  rw [show cofVecO ops m k = (List.range m.length).map (fun j =>
      sgnPO ops (k + j) (cof0O ops (m.eraseIdx k) j)) from rfl,
    dotO_map_range ops _ m.length (ground.getAt [] m k) hrow]
  refine L.ovTrans (foldO_congr_members L.toDCore _
    (fun j => sgnPO ops (k + j)
      (ops.mul (ground.getAt ops.unit (ground.getAt [] m k) j)
        (cof0O ops (m.eraseIdx k) j)))
    (List.range m.length)
    (fun j _ => L.ovSymm (sgnPO_mul L.toDCore (k + j) _ _))) ?_
  have hlen : (m.eraseIdx k).length + 1 = m.length :=
    length_eraseIdx m k hk
  rw [← hlen]
  refine L.ovSymm ?_
  have hrepl := detO_replace L m k hk (ground.getAt [] m k)
  rw [ground.set_self [] m k hk] at hrepl
  exact hrepl

/-- The diagonal read: a row against its own cofactor vector is
the determinant. -/
theorem cofVec_diag (m : Mat) (k : Nat) (hk : k < m.length)
    (hrow : (ground.getAt [] m k).length = m.length) :
    (dotP (ground.getAt [] m k) (cofVec m k)).oneValue (detL m) :=
  cofVecO_diag (R := ground.bpairRead) bpairLaws m k hk hrow

private theorem cofVecO_off {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ}
    (L : DLaws γ ops R.rel) (m : List (List γ)) (i k : Nat)
    (hi : i < m.length) (hk : k < m.length) (hik : i ≠ k)
    (hrow : (ground.getAt [] m i).length = m.length) :
    R.rel (dotO ops (ground.getAt [] m i) (cofVecO ops m k))
      ops.unit := by
  rw [show cofVecO ops m k = (List.range m.length).map (fun j =>
      sgnPO ops (k + j) (cof0O ops (m.eraseIdx k) j)) from rfl,
    dotO_map_range ops _ m.length (ground.getAt [] m i) hrow]
  refine L.ovTrans (foldO_congr_members L.toDCore _
    (fun j => sgnPO ops (k + j)
      (ops.mul (ground.getAt ops.unit (ground.getAt [] m i) j)
        (cof0O ops (m.eraseIdx k) j)))
    (List.range m.length)
    (fun j _ => L.ovSymm (sgnPO_mul L.toDCore (k + j) _ _))) ?_
  have hlen : (m.eraseIdx k).length + 1 = m.length :=
    length_eraseIdx m k hk
  rw [← hlen]
  refine L.ovTrans
    (L.ovSymm (detO_replace L m k hk (ground.getAt [] m i))) ?_
  have hgi : ground.getAt [] (List.set m k (ground.getAt [] m i)) i
      = ground.getAt [] m i := by
    have : ∀ (mm : List (List γ)) (kk ii : Nat)
        (bb : List γ), ii ≠ kk →
        ground.getAt [] (List.set mm kk bb) ii
          = ground.getAt [] mm ii := by
      intro mm
      induction mm with
      | nil => intro kk ii bb _; cases kk <;> rfl
      | cons a t ihm =>
        intro kk ii bb hne
        match kk, ii with
        | 0, 0 => exact absurd rfl hne
        | 0, _ + 1 => rfl
        | _ + 1, 0 => rfl
        | kk + 1, ii + 1 =>
          exact ihm kk ii bb (fun he => hne (congrArg Nat.succ he))
    exact this m k i (ground.getAt [] m i) hik
  have hgk : ground.getAt [] (List.set m k (ground.getAt [] m i)) k
      = ground.getAt [] m i := ground.getAt_set_self [] _ m k hk
  have hlset : (List.set m k (ground.getAt [] m i)).length
      = m.length := ground.length_set _ m k
  match Nat.lt_or_ge i k with
  | .inl hlt =>
    exact detO_rows_equal L hlt (by rw [hlset]; exact hk)
      (hgi.trans hgk.symm)
  | .inr hge =>
    have hklt : k < i := Nat.lt_of_le_of_ne hge
      (fun he => hik he.symm)
    exact detO_rows_equal L hklt (by rw [hlset]; exact hi)
      (hgk.trans hgi.symm)

/-- The off-diagonal read: a further row against the cofactor
vector reads the sum's unit, the replaced matrix's equal rows. -/
theorem cofVec_off (m : Mat) (i k : Nat) (hi : i < m.length)
    (hk : k < m.length) (hik : i ≠ k)
    (hrow : (ground.getAt [] m i).length = m.length) :
    (dotP (ground.getAt [] m i) (cofVec m k)).oneValue
      BPair.unit :=
  cofVecO_off (R := ground.bpairRead) bpairLaws m i k hi hk hik hrow

/-! The span arithmetic: the scaled combination, the span relation
at a cleared multiple, independence, the Gram, and the adjugate
solve `G·(adj·p) ~ det·p` off the cofactor vector's two reads —
the membership residual's certificates. -/

/-- The scaled vector, the componentwise sum and the combination at
a carrier. -/
private def vecScaleO {γ : Type} (ops : DOps γ) (c : γ)
    (v : List γ) : List γ :=
  v.map (fun x => ops.mul c x)

private def vecAddO {γ : Type} (ops : DOps γ)
    (u v : List γ) : List γ :=
  List.zipWith ops.add u v

private def comboO {γ : Type} (ops : DOps γ) (n : Nat) :
    List γ → List (List γ) → List γ
  | [], _ => List.replicate n ops.unit
  | _ :: _, [] => List.replicate n ops.unit
  | c :: cs, r :: L =>
    vecAddO ops (vecScaleO ops c r) (comboO ops n cs L)

/-- The scaled vector, one product per entry. -/
def vecScale (c : BPair) (v : List BPair) : List BPair :=
  vecScaleO bpairOps c v

/-- The componentwise sum at matched keys. -/
def vecAdd (u v : List BPair) : List BPair := vecAddO bpairOps u v

/-- The entrywise vector sum at one count is the componentwise sum:
the truncating fold and the padding fold agree at matched
lengths. -/
theorem vecAdd_eq_polyAdd : ∀ (u v : List BPair),
    u.length = v.length → elim.vecAdd u v = poly.add u v
  | [], [], _ => rfl
  | [], _ :: _, h => Nat.noConfusion h
  | _ :: _, [], h => Nat.noConfusion h
  | _ :: u, _ :: v, h => by
    show (_ + _) :: elim.vecAdd u v = (_ + _) :: poly.add u v
    rw [vecAdd_eq_polyAdd u v (Nat.succ.inj h)]

/-- The combination at a stated width: the coefficients against
the rows, seeded at the width's unit family. -/
def combo (n : Nat) : List BPair → Mat → List BPair :=
  comboO bpairOps n

private theorem length_vecScaleO {γ : Type} (ops : DOps γ)
    (c : γ) (u : List γ) :
    (vecScaleO ops c u).length = u.length := ground.length_map _ u

private theorem getAt_vecScaleO {γ : Type} (ops : DOps γ) (c : γ)
    (u : List γ) (i : Nat) (hi : i < u.length) :
    ground.getAt ops.unit (vecScaleO ops c u) i
      = ops.mul c (ground.getAt ops.unit u i) :=
  ground.getAt_map ops.unit ops.unit (fun y => ops.mul c y) u i hi

private theorem length_vecAddO {γ : Type} (ops : DOps γ) :
    ∀ (u w : List γ) (n : Nat), u.length = n → w.length = n →
    (vecAddO ops u w).length = n
  | [], [], _, hu, _ => hu
  | [], _ :: _, _, hu, hw => by rw [← hu] at hw; nomatch hw
  | _ :: _, [], _, hu, hw => by rw [← hu] at hw; nomatch hw
  | _ :: u, _ :: w, n, hu, hw => by
    match n, hu, hw with
    | n + 1, hu, hw =>
      show (vecAddO ops u w).length + 1 = n + 1
      rw [length_vecAddO ops u w n (Nat.succ.inj hu)
        (Nat.succ.inj hw)]

private theorem getAt_vecAddO {γ : Type} (ops : DOps γ) :
    ∀ (u w : List γ) (i : Nat), i < u.length → i < w.length →
    ground.getAt ops.unit (vecAddO ops u w) i
      = ops.add (ground.getAt ops.unit u i)
          (ground.getAt ops.unit w i)
  | [], _, i, hu, _ => absurd hu (Nat.not_lt_zero i)
  | _ :: _, [], i, _, hw => absurd hw (Nat.not_lt_zero i)
  | _ :: _, _ :: _, 0, _, _ => rfl
  | _ :: u, _ :: w, i + 1, hu, hw =>
    getAt_vecAddO ops u w i (Nat.lt_of_succ_lt_succ hu)
      (Nat.lt_of_succ_lt_succ hw)


/-- The span characterization: a cleared multiple of the vector is
a combination of the rows, the clearing scalar off the sum's unit
— the carrier the decidable read is certified against
(`lem:lowerspan`). -/
private def spanRelE (n : Nat) (L : Mat) (v : List BPair) : Prop :=
  ∃ c₀ cs, (¬ c₀.oneValue BPair.unit) ∧ cs.length = L.length
    ∧ poly.oneValue (vecScale c₀ v) (combo n cs L)

/-- The rows' width read, the theory's shape carrier, at every
entry carrier. -/
def rowsLen {γ : Type} (n : Nat) : List (List γ) → Prop
  | [] => True
  | r :: t => r.length = n ∧ rowsLen n t

def decRowsLen {γ : Type} (n : Nat) :
    ∀ M : List (List γ), Decidable (rowsLen n M)
  | [] => isTrue trivial
  | _ :: t => @instDecidableAnd _ _ inferInstance (decRowsLen n t)

/-- The selected block's rows read the column key list's count, at
any entry type. -/
theorem rowsLen_selMO {γ : Type} (u : γ) (J : List Nat)
    (S : List (List γ)) : ∀ I : List Nat,
      rowsLen J.length (selMO u I J S)
  | [] => trivial
  | _ :: t => ⟨ground.length_map _ J, rowsLen_selMO u J S t⟩

instance {γ : Type} (n : Nat) (M : List (List γ)) :
    Decidable (rowsLen n M) := decRowsLen n M

/-- The Gram: the rows' pairwise folds. -/
def gramM (L : Mat) : Mat :=
  L.map (fun r => L.map (fun c => dotP r c))

/-- The Gram's row at an occupied key: the stated row's pairings
against every row, key by key. -/
theorem gramM_row (L : Mat) (i : Nat) (hi : i < L.length) :
    ground.getAt [] (gramM L) i
      = L.map (fun c => dotP (ground.getAt [] L i) c) :=
  ground.getAt_map ([] : List BPair) ([] : List BPair)
    (fun r => L.map (fun c => dotP r c)) L i hi

/-- The Gram's entry at two occupied keys: the two rows' own
pairing. -/
theorem gramM_entry (L : Mat) (i j : Nat) (hi : i < L.length)
    (hj : j < L.length) :
    ground.getAt BPair.unit (ground.getAt [] (gramM L) i) j
      = dotP (ground.getAt [] L i) (ground.getAt [] L j) := by
  rw [gramM_row L i hi,
    ground.getAt_map ([] : List BPair) BPair.unit
      (fun c => dotP (ground.getAt [] L i) c) L j hj]

/-- Independence: the shape read with the Gram determinant off the
sum's unit, the membership test's clearing scalar. -/
def indepRows (n : Nat) (L : Mat) : Prop :=
  rowsLen n L ∧ ¬ (detL (gramM L)).oneValue BPair.unit

private theorem dotO_repl_unit {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ}
    (L : DLaws γ ops R.rel) : ∀ (r : List γ) (n : Nat),
    R.rel (dotO ops r (List.replicate n ops.unit)) ops.unit
  | [], 0 => L.ovRefl _
  | [], _ + 1 => L.ovRefl _
  | _ :: _, 0 => L.ovRefl _
  | a :: r, n + 1 => by
    show R.rel (ops.add (ops.mul a ops.unit)
        (dotO ops r (List.replicate n ops.unit))) ops.unit
    refine L.ovTrans
      (L.addCongr (L.mulUnit a) (dotO_repl_unit L r n)) ?_
    exact L.unitAdd ops.unit

/-- The pairing against the unit family sits at the sum's unit. -/
theorem dotP_repl_unit : ∀ (r : List BPair) (n : Nat),
    (dotP r (List.replicate n BPair.unit)).oneValue BPair.unit :=
  fun r n => dotO_repl_unit (R := ground.bpairRead) bpairLaws r n

private theorem dotO_vecAdd_right {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ}
    (L : DLaws γ ops R.rel) : ∀ (r u w : List γ),
    u.length = w.length →
    R.rel (dotO ops r (vecAddO ops u w))
      (ops.add (dotO ops r u) (dotO ops r w))
  | [], _, _, _ => L.ovSymm (L.unitAdd ops.unit)
  | _ :: _, [], [], _ => L.ovSymm (L.unitAdd ops.unit)
  | _ :: _, [], _ :: _, h => nomatch h
  | _ :: _, _ :: _, [], h => nomatch h
  | a :: r, b :: u, c :: w, h => by
    show R.rel (ops.add (ops.mul a (ops.add b c))
        (dotO ops r (vecAddO ops u w)))
      (ops.add (ops.add (ops.mul a b) (dotO ops r u))
        (ops.add (ops.mul a c) (dotO ops r w)))
    exact L.ovTrans
      (L.addCongr (L.leftDistrib a b c)
        (dotO_vecAdd_right L r u w (Nat.succ.inj h)))
      (ground.opExchO (commLawsOf L.toDCore) (ops.mul a b) (ops.mul a c)
        (dotO ops r u) (dotO ops r w))

private theorem dotO_vecAdd {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ}
    (L : DLaws γ ops R.rel) (r u w : List γ)
    (hu : u.length = r.length) (hw : w.length = r.length) :
    R.rel (dotO ops r (vecAddO ops u w))
      (ops.add (dotO ops r u) (dotO ops r w)) :=
  dotO_vecAdd_right L r u w (hu.trans hw.symm)

/-- The pairing against a memberwise sum splits. -/
theorem dotP_vecAdd : ∀ (r u w : List BPair),
    u.length = r.length → w.length = r.length →
    (dotP r (vecAdd u w)).oneValue (dotP r u + dotP r w) :=
  fun r u w hu hw => dotO_vecAdd (R := ground.bpairRead) bpairLaws r u w hu hw

/-- The pairing against a memberwise sum on its right splits at
the members' shared order, the row entering at every width: the
three folds truncate together at the row against that order. -/
theorem dotP_vecAdd_right : ∀ (r u w : List BPair),
    u.length = w.length →
    (dotP r (vecAdd u w)).oneValue (dotP r u + dotP r w) :=
  fun r u w h =>
    dotO_vecAdd_right (R := ground.bpairRead) bpairLaws r u w h

private theorem dotO_vecScale_right {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ}
    (L : DLaws γ ops R.rel) : ∀ (r u : List γ) (c : γ),
    R.rel (dotO ops r (vecScaleO ops c u)) (ops.mul c (dotO ops r u))
  | [], _, c => L.ovSymm (L.mulUnit c)
  | _ :: _, [], c => L.ovSymm (L.mulUnit c)
  | a :: r, b :: u, c => by
    show R.rel (ops.add (ops.mul a (ops.mul c b))
        (dotO ops r (vecScaleO ops c u)))
      (ops.mul c (ops.add (ops.mul a b) (dotO ops r u)))
    exact L.ovTrans
      (L.addCongr (ground.opLeftCommO (commLawsMulOf L.toDCore) a c b)
        (dotO_vecScale_right L r u c))
      (L.ovSymm (L.leftDistrib c (ops.mul a b) (dotO ops r u)))

/-- The pairing against a scaled vector is the scale of the
pairing, at every pair of widths. -/
theorem dotP_vecScale_right : ∀ (r u : List BPair) (c : BPair),
    (dotP r (vecScale c u)).oneValue (c * dotP r u) :=
  fun r u c => dotO_vecScale_right (R := ground.bpairRead) bpairLaws r u c

private theorem dotP_vecScale (c : BPair) (r u : List BPair)
    (_ : u.length = r.length) :
    (dotP r (vecScale c u)).oneValue (c * dotP r u) :=
  dotP_vecScale_right r u c

private theorem dotO_congr_right {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ}
    (L : DLaws γ ops R.rel) : ∀ (p u u' : List γ),
    u.length = u'.length →
    (∀ i, i < u.length →
      R.rel (ground.getAt ops.unit u i)
        (ground.getAt ops.unit u' i)) →
    R.rel (dotO ops p u) (dotO ops p u')
  | [], _, _, _, _ => L.ovRefl _
  | _ :: _, [], [], _, _ => L.ovRefl _
  | _ :: _, [], _ :: _, hl, _ => nomatch hl
  | _ :: _, _ :: _, [], hl, _ => nomatch hl
  | a :: p, b :: u, b' :: u', hl, h => by
    show R.rel (ops.add (ops.mul a b) (dotO ops p u))
      (ops.add (ops.mul a b') (dotO ops p u'))
    exact L.addCongr
      (L.mulCongr (L.ovRefl a) (h 0 (Nat.succ_pos _)))
      (dotO_congr_right L p u u' (Nat.succ.inj hl)
        (fun i hi => h (i + 1) (Nat.succ_lt_succ hi)))

private theorem dotP_congr_right : ∀ (p u u' : List BPair),
    u.length = u'.length →
    (∀ i, i < u.length →
      (ground.getAt BPair.unit u i).oneValue
        (ground.getAt BPair.unit u' i)) →
    (dotP p u).oneValue (dotP p u') :=
  fun p u u' hl h => dotO_congr_right (R := ground.bpairRead) bpairLaws p u u' hl h

private theorem length_comboO {γ : Type} (ops : DOps γ) (n : Nat) :
    ∀ (cs : List γ) (M : List (List γ)), rowsLen n M →
      (comboO ops n cs M).length = n
  | [], _, _ => ground.length_replicate ops.unit n
  | _ :: _, [], _ => ground.length_replicate ops.unit n
  | c :: cs, r :: M, hM => by
    show (List.zipWith ops.add (r.map (fun x => ops.mul c x))
      (comboO ops n cs M)).length = n
    exact length_zipWith ops.add _ _ n
      (by rw [ground.length_map]; exact hM.1)
      (length_comboO ops n cs M hM.2)

/-- A combination over a list of rows of one width reads that
width. -/
theorem length_combo (n : Nat) : ∀ (cs : List BPair)
    (M : Mat), rowsLen n M → (combo n cs M).length = n :=
  fun cs M hM => length_comboO bpairOps n cs M hM

/-- The combination's entry: the coefficients against the rows'
column reads. -/
theorem comboO_getAt {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) (n : Nat) :
    ∀ (cs : List γ) (M : List (List γ)) (i : Nat),
    rowsLen n M → i < n →
    R.rel (ground.getAt ops.unit (comboO ops n cs M) i)
      (dotO ops cs (M.map (fun r => ground.getAt ops.unit r i)))
  | [], _, i, _, _ => by
    show R.rel (ground.getAt ops.unit
      (List.replicate n ops.unit) i) ops.unit
    rw [ground.getAt_replicate_self ops.unit n i]
    exact L.ovRefl _
  | _ :: _, [], i, _, _ => by
    show R.rel (ground.getAt ops.unit
      (List.replicate n ops.unit) i) ops.unit
    rw [ground.getAt_replicate_self ops.unit n i]
    exact L.ovRefl _
  | c :: cs, r :: M', i, hM, hi => by
    have h3 : i < r.length := by rw [hM.1]; exact hi
    have h1 : i < (vecScaleO ops c r).length := by
      rw [length_vecScaleO]; exact h3
    have h2 : i < (comboO ops n cs M').length := by
      rw [length_comboO ops n cs M' hM.2]; exact hi
    show R.rel (ground.getAt ops.unit
        (vecAddO ops (vecScaleO ops c r) (comboO ops n cs M')) i)
      (ops.add (ops.mul c (ground.getAt ops.unit r i))
        (dotO ops cs
          (M'.map (fun x => ground.getAt ops.unit x i))))
    rw [getAt_vecAddO ops _ _ i h1 h2, getAt_vecScaleO ops c r i h3]
    exact L.addCongr (L.ovRefl _) (comboO_getAt L n cs M' i hM.2 hi)

private theorem dotO_combo {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ}
    (L : DLaws γ ops R.rel) : ∀ (cs : List γ) (M : List (List γ))
    (r : List γ) (n : Nat), rowsLen n M →
    R.rel (dotO ops r (comboO ops n cs M))
      (dotO ops cs (M.map (fun row => dotO ops r row)))
  | [], _, r, n, _ => dotO_repl_unit L r n
  | _ :: _, [], r, n, _ => dotO_repl_unit L r n
  | c :: cs, r' :: M', r, n, hM => by
    show R.rel (dotO ops r
        (vecAddO ops (vecScaleO ops c r') (comboO ops n cs M')))
      (ops.add (ops.mul c (dotO ops r r'))
        (dotO ops cs (M'.map (fun row => dotO ops r row))))
    refine L.ovTrans
      (dotO_vecAdd_right L r (vecScaleO ops c r')
        (comboO ops n cs M') (by
          show (r'.map (fun x => ops.mul c x)).length = _
          rw [ground.length_map, hM.1,
            length_comboO ops n cs M' hM.2])) ?_
    exact L.addCongr (dotO_vecScale_right L r r' c)
      (dotO_combo L cs M' r n hM.2)

/-- The pairing against a combination is the coefficients' pairing
against the rows' own pairings, the bilinear expansion's read. -/
theorem dotP_combo : ∀ (cs : List BPair) (M : Mat)
    (r : List BPair) (n : Nat), rowsLen n M →
    (dotP r (combo n cs M)).oneValue
      (dotP cs (M.map (fun row => dotP r row))) :=
  fun cs M r n hM =>
    dotO_combo (R := ground.bpairRead) bpairLaws cs M r n hM

private theorem sqAt_row_len {m : Mat} {n : Nat} (h : sqAt m n) :
    ∀ i, i < m.length → (ground.getAt [] m i).length = n :=
  fun i hi => ground.beqEq _ _
    (ground.all_getAt [] m ((ground.andSplitB h).2) i hi)

/-- The width read off any predicate fold pricing the rows' order:
one shape carrier at every spelling of the row test. -/
theorem rowsLen_of_allP {γ : Type} {n : Nat} {P : List γ → Bool}
    (hP : ∀ r, P r = true → r.length = n) :
    ∀ m : List (List γ), m.all P = true → rowsLen n m
  | [], _ => trivial
  | r :: t, h =>
    ⟨hP r ((ground.andSplitB h).1),
     rowsLen_of_allP hP t ((ground.andSplitB h).2)⟩

/-- The square order's width read: a datum at a stated order carries
that width row by row, the shape carrier off the chokepoint's
read. -/
theorem rowsLen_of_sqAt {m : Mat} {n : Nat} (h : sqAt m n) :
    rowsLen n m :=
  rowsLen_of_allP (fun _ hr => ground.beqEq _ _ hr) m
    ((ground.andSplitB h).2)

/-- The square order's row count read, the shape carrier's other
half beside `rowsLen_of_sqAt`. -/
theorem sqAt_len {m : Mat} {n : Nat} (h : sqAt m n) :
    m.length = n := ground.beqEq _ _ ((ground.andSplitB h).1)

/-- A row width survives an erased row key. -/
theorem rowsLen_eraseIdx {γ : Type} (n : Nat) :
    ∀ (l : List (List γ)) (j : Nat),
    rowsLen n l → rowsLen n (l.eraseIdx j)
  | [], _, _ => trivial
  | _ :: _, 0, h => h.2
  | _ :: t, j + 1, h => ⟨h.1, rowsLen_eraseIdx n t j h.2⟩

/-- The row width steps down with one column key erased. -/
theorem rowsLen_eraseCol {γ : Type} (n j : Nat) (hj : j < n + 1) :
    ∀ l : List (List γ), rowsLen (n + 1) l →
    rowsLen n (l.map (fun r => r.eraseIdx j))
  | [], _ => trivial
  | r :: t, h =>
    ⟨by
      have hje : (r.eraseIdx j).length + 1 = r.length :=
        ground.length_eraseIdx r j (by rw [h.1]; exact hj)
      rw [h.1] at hje
      exact Nat.succ.inj hje,
     rowsLen_eraseCol n j hj t h.2⟩

/-- The width steps down with the leading column dropped. -/
theorem rowsLen_dropCol {γ : Type} :
    ∀ (n : Nat) (l : List (List γ)),
    rowsLen (n + 1) l → rowsLen n (dropCol l)
  | _, [], _ => trivial
  | _, [] :: _, h => Nat.noConfusion h.1
  | n, (_ :: _) :: t, h =>
    ⟨Nat.succ.inj h.1, rowsLen_dropCol n t h.2⟩

/-- A mapped family at one row width reads that width, the width
read per member. -/
theorem rowsLen_map {γ α : Type} (g : α → List γ) (n : Nat) :
    ∀ l : List α, (∀ x ∈ l, (g x).length = n) →
      rowsLen n (l.map g)
  | [], _ => trivial
  | a :: t, h =>
    ⟨h a (List.Mem.head t),
     rowsLen_map g n t (fun x hx => h x (List.Mem.tail a hx))⟩

/-- The entry-formula matrix's rows read the stated width
(`ground.matOf` at the row predicate). -/
theorem rowsLen_matOf {γ : Type} (m n : Nat) (f : Nat → Nat → γ) :
    rowsLen n (ground.matOf m n f) :=
  rowsLen_map _ n (List.range m) (fun _ _ => ground.length_mapRange _ n)

private theorem length_cofVecO {γ : Type} (ops : DOps γ)
    (m : List (List γ)) (k : Nat) :
    (cofVecO ops m k).length = m.length :=
  ground.length_mapRange _ m.length

/-- The cofactor vector's width is the list's own count, read at
every list. -/
theorem length_cofVec (m : Mat) (k : Nat) :
    (cofVec m k).length = m.length :=
  length_cofVecO bpairOps m k

/-- The cofactor family's row count is the list's own. -/
theorem cofRows_len (G : Mat) :
    ((List.range G.length).map (fun k => cofVec G k)).length
      = G.length :=
  ground.length_mapRange _ G.length

/-- The cofactor family's rows read the list's count. -/
theorem cofRows_rowsLen (G : Mat) :
    rowsLen G.length
      ((List.range G.length).map (fun k => cofVec G k)) :=
  rowsLen_map _ G.length (List.range G.length)
    (fun x _ => length_cofVec G x)

/-- The adjugate solve's vector at a carrier. -/
private def adjPO {γ : Type} (ops : DOps γ) (G : List (List γ))
    (p : List γ) : List γ :=
  comboO ops G.length p
    ((List.range G.length).map (fun k => cofVecO ops G k))

/-- The adjugate solve's vector: the pairing data against the
cofactor vectors, `adj(G)·p` as one combination. -/
def adjP (G : Mat) (p : List BPair) : List BPair :=
  adjPO bpairOps G p

private theorem adjPO_read {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ}
    (L : DLaws γ ops R.rel) (G : List (List γ)) {n : Nat}
    (hGl : G.length = n)
    (hrows : ∀ i, i < G.length →
      (ground.getAt [] G i).length = G.length)
    (p : List γ) (hp : p.length = n) (i : Nat) (hi : i < n) :
    R.rel (dotO ops (ground.getAt [] G i) (adjPO ops G p))
      (ops.mul (ground.getAt ops.unit p i) (detO ops G)) := by
  have hrow : (ground.getAt [] G i).length = G.length :=
    hrows i (by rw [hGl]; exact hi)
  refine L.ovTrans
    (dotO_combo L p
      ((List.range G.length).map (fun k => cofVecO ops G k))
      (ground.getAt [] G i) G.length
      (rowsLen_map _ G.length (List.range G.length) (fun x _ => (fun k => length_cofVecO ops G k) x))) ?_
  rw [ground.map_map]
  refine L.ovTrans
    (dotO_congr_right L p _
      ((List.range G.length).map
        (fun k => if k = i then detO ops G else ops.unit))
      (by rw [ground.length_map, ground.length_map]) ?_) ?_
  · intro t ht
    rw [ground.length_mapRange] at ht
    rw [ground.getAt_map 0 ops.unit _
        (List.range G.length) t
        (by rw [ground.length_range]; exact ht),
      ground.getAt_map 0 ops.unit _
        (List.range G.length) t
        (by rw [ground.length_range]; exact ht),
      ground.getAt_range G.length t ht]
    by_cases hti : t = i
    · rw [if_pos hti, hti]
      exact cofVecO_diag L G i (by rw [hGl]; exact hi) hrow
    · rw [if_neg hti]
      exact cofVecO_off L G i t (by rw [hGl]; exact hi) ht
        (fun he => hti he.symm) hrow
  · rw [dotO_map_range ops _ G.length p (hp.trans hGl.symm)]
    refine L.ovTrans
      (foldO_congr_members L.toDCore _
        (fun k => if i = k then
            ops.mul (ground.getAt ops.unit p k) (detO ops G)
          else ops.unit)
        (List.range G.length) (fun k _ => ?_))
      (foldO_pick L
        (fun k => ops.mul (ground.getAt ops.unit p k) (detO ops G))
        (List.range G.length) i
        (by rw [ground.countOf_range_one
          (show i < G.length by rw [hGl]; exact hi)]))
    by_cases hki : i = k
    · rw [if_pos hki, if_pos hki.symm]
      exact L.ovRefl _
    · rw [if_neg hki, if_neg (fun he => hki he.symm)]
      exact L.mulUnit _

/-- The adjugate row solve: the Gram against the solve vector
reads the determinant against the data, `G·(adj(G)·p) ~ det(G)·p`
entrywise — the identity the membership residual's certificates
consume. -/
theorem adjP_read (G : Mat) {n : Nat} (hsq : sqAt G n)
    (p : List BPair) (hp : p.length = n) (i : Nat) (hi : i < n) :
    (dotP (ground.getAt [] G i) (adjP G p)).oneValue
      (ground.getAt BPair.unit p i * detL G) := by
  have hGl : G.length = n := ground.beqEq _ _ ((ground.andSplitB hsq).1)
  exact adjPO_read (R := ground.bpairRead) bpairLaws G hGl
    (fun t ht => by
      rw [sqAt_row_len hsq t ht, hGl])
    p hp i hi

/-! The pairing's positivity, and the membership residual: the
pairing's unit-tail null reads on either slot, the self-fold's
one-sided read with the balanced sum forcing every entry, the
residual `det·v` against the solve's combination, and the two-way
certificates — the test's pass a span witness at an off-unit
determinant, a span member passing outright. -/

/-- The upper-side read adds: two pairs each at the second member
at or below the first keep that side under the sum. -/
theorem side_add {x y : BPair} (hx : x.snd ≤ x.fst)
    (hy : y.snd ≤ y.fst) : (x + y).snd ≤ (x + y).fst := by
  match hx, hy with
  | Or.inl ex, Or.inl ey =>
    exact Or.inl (by show x.snd + y.snd = x.fst + y.fst
                     rw [ex, ey])
  | Or.inl ex, Or.inr ⟨g, hg⟩ =>
    refine Or.inr ⟨g, ?_⟩
    show (x.snd + y.snd) + g = x.fst + y.fst
    rw [ground.add_assoc, hg, ex]
  | Or.inr ⟨g, hg⟩, Or.inl ey =>
    refine Or.inr ⟨g, ?_⟩
    show (x.snd + y.snd) + g = x.fst + y.fst
    rw [ground.add_right_comm, hg, ey]
  | Or.inr ⟨g, hg⟩, Or.inr ⟨g', hg'⟩ =>
    refine Or.inr ⟨g + g', ?_⟩
    show (x.snd + y.snd) + (g + g') = x.fst + y.fst
    rw [ground.add_add_comm x.snd y.snd g g', hg, hg']

/-- Two upper-side data summing to the sum's unit each sit at the
unit, the order's one-sided split. -/
theorem side_split {x y : BPair} (hx : x.snd ≤ x.fst)
    (hy : y.snd ≤ y.fst)
    (h : (x + y).oneValue BPair.unit) :
    x.oneValue BPair.unit ∧ y.oneValue BPair.unit := by
  have h' : x.fst + y.fst = x.snd + y.snd := add_cancel_ones h
  have hxe : x.snd = x.fst := by
    match hx with
    | Or.inl ex => exact ex
    | Or.inr ⟨g, hg⟩ =>
      exfalso
      match hy with
      | Or.inl ey =>
        have h2 : (x.snd + y.fst) + g = x.snd + y.fst := by
          rw [ground.add_right_comm x.snd y.fst g, hg, h', ey]
        exact ground.add_ne_left _ g h2
      | Or.inr ⟨g', hg'⟩ =>
        have h2 : (x.snd + y.snd) + (g + g') = x.snd + y.snd := by
          rw [ground.add_add_comm x.snd y.snd g g', hg, hg']
          exact h'
        exact ground.add_ne_left _ (g + g') h2
  have hye : y.snd = y.fst := by
    have h2 : x.snd + y.fst = x.snd + y.snd := by
      rw [← hxe] at h'
      exact h'
    exact (ground.add_left_cancel h2).symm
  refine ⟨?_, ?_⟩
  · show x.fst + Pos.one = Pos.one + x.snd
    rw [hxe, ground.add_comm]
  · show y.fst + Pos.one = Pos.one + y.snd
    rw [hye, ground.add_comm]

/-- A self-pairing sits at its upper side or equal members, the
fold of squares. -/
theorem dotP_self_side : ∀ v : List BPair,
    (dotP v v).snd ≤ (dotP v v).fst
  | [] => Or.inl rfl
  | a :: t => side_add (sq_side a) (dotP_self_side t)

/-- The balanced self-fold forces every entry balanced, the
pairing's definiteness. -/
theorem dotP_self_null : ∀ v : List BPair,
    (dotP v v).oneValue BPair.unit → poly.unitTail v
  | [], _ => trivial
  | a :: t, h => by
    have hsplit := side_split (sq_side a) (dotP_self_side t) h
    exact ⟨entry_of_sq_null hsplit.1, dotP_self_null t hsplit.2⟩

/-- The pairing against a memberwise swap is the pairing's own
swap. -/
theorem dotP_swapMap : ∀ r u : List BPair,
    dotP r (u.map BPair.swap) = (dotP r u).swap
  | [], _ => rfl
  | _ :: _, [] => rfl
  | a :: r, b :: u => by
    show a * b.swap + dotP r (u.map BPair.swap)
      = (a * b + dotP r u).swap
    rw [BPair.mul_swap, dotP_swapMap r u, BPair.swap_add]

/-- Two maps join to the pointwise sum's map. -/
theorem mapAdd {α : Type} (A B : α → BPair) : ∀ l : List α,
    vecAdd (l.map A) (l.map B) = l.map (fun j => A j + B j)
  | [] => rfl
  | a :: l => by
    show (A a + B a) :: vecAdd (l.map A) (l.map B) = _
    rw [mapAdd A B l]
    rfl

/-- The skipping fold against a memberwise-swapped left argument is
the fold's own swap, `dotN_swap`'s twin at the other side. -/
theorem dotN_swapLeft : ∀ r c : List BPair,
    dotN (r.map BPair.swap) c = (dotN r c).swap
  | [], _ => rfl
  | _ :: _, [] => rfl
  | a :: s, b :: t => by
    show (if a.swap.isUnitRep || b.isUnitRep then
        dotN (s.map BPair.swap) t
      else (a.swap * b + dotN (s.map BPair.swap) t).norm)
      = (if a.isUnitRep || b.isUnitRep then dotN s t
        else (a * b + dotN s t).norm).swap
    rw [BPair.isUnitRep_swap]
    cases a.isUnitRep || b.isUnitRep with
    | true => exact dotN_swapLeft s t
    | false =>
      show (a.swap * b + dotN (s.map BPair.swap) t).norm
        = ((a * b + dotN s t).norm).swap
      rw [dotN_swapLeft s t, BPair.swap_mul, BPair.swap_add, BPair.norm_swap]

/-- A swapped matrix's action is the action's own swap. -/
theorem matVec_swapM : ∀ (M : Mat) (v : List BPair),
    matVec (matSwap M) v = (matVec M v).map BPair.swap
  | [], _ => rfl
  | r :: t, v => by
    show dotN (r.map BPair.swap) v :: matVec (matSwap t) v
      = (dotN r v).swap :: (matVec t v).map BPair.swap
    rw [dotN_swapLeft r v, matVec_swapM t v]

/-- Both arguments swapped, the fold is unchanged. -/
private theorem dotN_swapBoth (a b : List BPair) :
    dotN (a.map BPair.swap) (b.map BPair.swap) = dotN a b := by
  rw [dotN_swap, dotN_swapLeft]
  rfl

/-- The matrix action against a memberwise-swapped vector is the
action's own memberwise swap. -/
theorem matVec_swapArg (u : List BPair) : ∀ S : Mat,
    matVec S (u.map BPair.swap) = (matVec S u).map BPair.swap
  | [] => rfl
  | r :: t => by
    show dotN r (u.map BPair.swap) :: matVec t (u.map BPair.swap)
      = (dotN r u).swap :: (matVec t u).map BPair.swap
    rw [dotN_swap, matVec_swapArg u t]

/-- The action of a vector's balance partner is the action's own
partner: `matVec_swapArg` at the negation's name. -/
theorem matVec_neg (M : Mat) (u : List BPair) :
    matVec M (poly.neg u) = poly.neg (matVec M u) :=
  matVec_swapArg u M

/-- The quadratic fold walks the memberwise swap of its vector
unchanged: the swap's square is the identity at the pairing. -/
theorem dotN_matVec_swapMap (S : Mat) (u : List BPair) :
    dotN (u.map BPair.swap) (matVec S (u.map BPair.swap))
      = dotN u (matVec S u) := by
  rw [matVec_swapArg u S, dotN_swapBoth]

/-- A memberwise row map keeps the order read. -/
theorem rowsLen_mapRowsO {α β : Type} (f : α → β) :
    ∀ (M : List (List α)) (n : Nat), rowsLen n M →
      rowsLen n (M.map (fun r => r.map f))
  | [], _, _ => trivial
  | r :: t, n, h =>
    ⟨(ground.length_map f r).trans h.1, rowsLen_mapRowsO f t n h.2⟩

theorem rowsLen_mapRows (f : BPair → BPair) (M : Mat) (n : Nat)
    (h : rowsLen n M) : rowsLen n (M.map (fun r => r.map f)) :=
  rowsLen_mapRowsO f M n h

/-- The pairing commutes, at every pair of widths. -/
private theorem dotO_comm {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) :
    ∀ u v : List γ, R.rel (dotO ops u v) (dotO ops v u)
  | [], [] => C.ovRefl _
  | [], _ :: _ => C.ovRefl _
  | _ :: _, [] => C.ovRefl _
  | a :: u, b :: v => C.addCongr (C.mulComm a b) (dotO_comm C u v)

/-- A left factor reading the sum's unit at every key pairs at that
unit. -/
private theorem dotO_null_left {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ∀ (v w : List γ),
      (∀ b, R.rel (ground.getAt ops.unit v b) ops.unit) →
      R.rel (dotO ops v w) ops.unit
  | [], _, _ => L.ovRefl _
  | _ :: _, [], _ => L.ovRefl _
  | a :: v, b :: w, h => by
    show R.rel (ops.add (ops.mul a b) (dotO ops v w)) ops.unit
    exact L.ovTrans
      (L.addCongr
        (L.ovTrans (L.mulCongr (h 0) (L.ovRefl b)) (mulUnitLeftO L b))
        (dotO_null_left L v w (fun t => h (t + 1))))
      (L.unitAdd ops.unit)

/-- A right slot reading the sum's unit at every key inside its
width pairs at that unit. -/
private theorem dotO_null_right {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) (p u : List γ)
    (h : ∀ i, i < u.length →
      R.rel (ground.getAt ops.unit u i) ops.unit) :
    R.rel (dotO ops p u) ops.unit :=
  L.ovTrans (dotO_comm L.toDCore p u)
    (dotO_null_left L u p (fun b =>
      match Nat.lt_or_ge b u.length with
      | .inl hb => h b hb
      | .inr hb => by
        show R.rel (ground.getAt ops.unit u b) ops.unit
        rw [ground.getAt_over ops.unit u b hb]
        exact L.ovRefl _))

/-- The pairing is symmetric. -/
theorem dotP_comm : ∀ u v : List BPair,
    dotP u v = dotP v u := dotO_comm (R := bpairEqRead) bpairEqCore


/-- The pairing's balance partner at the first slot: a negated
member reads the pairing's own swap, the entrywise negation
carried across the fold (`con:sertables`' form displays at the
balance partners). -/
theorem dotP_swap_left (u w : List BPair) :
    dotP (poly.neg u) w = (dotP u w).swap :=
  (dotP_comm (poly.neg u) w).trans
    ((dotP_swapMap w u).trans
      (congrArg BPair.swap (dotP_comm w u)))

/-- The pairing against the vacant list is the sum's unit: the fold
truncates at its right argument's order. -/
theorem dotP_nil_right : ∀ u : List BPair,
    dotP u ([] : List BPair) = BPair.unit
  | [] => rfl
  | _ :: _ => rfl

/-- The pairing against a memberwise sum on its left splits at the
right argument's order alone, the summands read within it. -/
theorem dotP_vecAdd_left : ∀ (u w x : List BPair),
    x.length ≤ u.length → x.length ≤ w.length →
    (dotP (vecAdd u w) x).oneValue (dotP u x + dotP w x)
  | u, w, [], _, _ => by
    rw [dotP_nil_right (vecAdd u w), dotP_nil_right u,
      dotP_nil_right w]
    exact BPair.oneValue_symm (BPair.add_unit BPair.unit)
  | [], _, _ :: _, hu, _ => absurd hu (Nat.not_succ_le_zero _)
  | _ :: _, [], _ :: _, _, hw => absurd hw (Nat.not_succ_le_zero _)
  | a :: u, b :: w, c :: x, hu, hw => by
    show ((a + b) * c + dotP (vecAdd u w) x).oneValue
      (a * c + dotP u x + (b * c + dotP w x))
    rw [BPair.right_distrib,
      ← BPair.add_add_comm (a * c) (b * c) (dotP u x) (dotP w x)]
    exact BPair.add_congr (BPair.oneValue_refl _)
      (dotP_vecAdd_left u w x (Nat.le_of_succ_le_succ hu)
        (Nat.le_of_succ_le_succ hw))

/-- The pairing's congruence on its left operand: two lists reading
one value at every place below the right operand's order pair
against it at one value, the fold truncating at that order. -/
theorem dotP_congr_left : ∀ (u u' x : List BPair),
    (∀ j, j < x.length →
      (ground.getAt BPair.unit u j).oneValue
        (ground.getAt BPair.unit u' j)) →
    (dotP u x).oneValue (dotP u' x)
  | u, u', [], _ => by
    rw [dotP_nil_right u, dotP_nil_right u']
    exact BPair.oneValue_refl _
  | [], [], _ :: _, _ => BPair.oneValue_refl _
  | [], a' :: u', c :: x, h => by
    show BPair.unit.oneValue (a' * c + dotP u' x)
    refine BPair.oneValue_symm (BPair.oneValue_trans
      (BPair.add_congr ?_ ?_) (BPair.add_unit BPair.unit))
    · exact BPair.oneValue_trans
        (BPair.mul_congr_left
          (BPair.oneValue_symm (h 0 (Nat.succ_pos _))))
        (BPair.unit_mul c)
    · exact BPair.oneValue_symm
        (dotP_congr_left [] u' x
          (fun j hj => h (j + 1) (Nat.succ_lt_succ hj)))
  | a :: u, [], c :: x, h => by
    show (a * c + dotP u x).oneValue BPair.unit
    refine BPair.oneValue_trans (BPair.add_congr ?_ ?_)
      (BPair.add_unit BPair.unit)
    · exact BPair.oneValue_trans
        (BPair.mul_congr_left (h 0 (Nat.succ_pos _)))
        (BPair.unit_mul c)
    · exact dotP_congr_left u [] x
        (fun j hj => h (j + 1) (Nat.succ_lt_succ hj))
  | a :: u, a' :: u', c :: x, h => by
    show (a * c + dotP u x).oneValue (a' * c + dotP u' x)
    exact BPair.add_congr
      (BPair.mul_congr_left (h 0 (Nat.succ_pos _)))
      (dotP_congr_left u u' x (fun j hj => h (j + 1) (Nat.succ_lt_succ hj)))

/-- The pairing at a per-place disjunctive unit: where every place
reads one operand's entry at the sum's unit, the fold reads that
unit whole (`lem:lowerspan`'s pairing reads at the split
supports). -/
theorem dotP_null_or : ∀ (x y : List BPair),
    x.length = y.length →
    (∀ i, i < x.length →
      (ground.getAt BPair.unit x i).oneValue BPair.unit
        ∨ (ground.getAt BPair.unit y i).oneValue BPair.unit) →
    (dotP x y).oneValue BPair.unit
  | [], [], _, _ => BPair.oneValue_refl _
  | [], _ :: _, hl, _ => nomatch hl
  | _ :: _, [], hl, _ => nomatch hl
  | a :: x, b :: y, hl, h => by
    show (a * b + dotP x y).oneValue BPair.unit
    refine BPair.oneValue_trans (BPair.add_congr ?_
      (dotP_null_or x y (Nat.succ.inj hl)
        (fun i hi => h (i + 1) (Nat.succ_lt_succ hi))))
      (BPair.unit_add BPair.unit)
    match h 0 (Nat.succ_pos _) with
    | Or.inl ha => exact oneValue_unit_mul ha
    | Or.inr hb => exact oneValue_mul_unit a b hb

private theorem dotP_null_right (p u : List BPair)
    (h : ∀ i, i < u.length →
      (ground.getAt BPair.unit u i).oneValue BPair.unit) :
    (dotP p u).oneValue BPair.unit :=
  dotO_null_right (R := ground.bpairRead) bpairLaws p u h

/-- The pairing against a unit tail sits at the sum's unit. -/
theorem dotP_null_tail_right (p u : List BPair)
    (hu : poly.unitTail u) : (dotP p u).oneValue BPair.unit :=
  dotP_null_right p u (fun i _ => poly.getAt_unitTail hu i)

/-- The pairing of a unit tail sits at the sum's unit. -/
theorem dotP_null_tail_left (r x : List BPair)
    (hr : poly.unitTail r) : (dotP r x).oneValue BPair.unit := by
  rw [dotP_comm r x]
  exact dotP_null_tail_right x r hr

/-- A clearing distributes over the memberwise sum. -/
theorem vecScale_vecAdd (c : BPair) : ∀ u w : List BPair,
    vecScale c (vecAdd u w) = vecAdd (vecScale c u) (vecScale c w)
  | [], _ => rfl
  | _ :: _, [] => rfl
  | a :: u, b :: w => by
    show (c * (a + b)) :: vecScale c (vecAdd u w)
      = (c * a + c * b) :: vecAdd (vecScale c u) (vecScale c w)
    rw [BPair.left_distrib, vecScale_vecAdd c u w]

/-- The composed clearings read the product's. -/
theorem vecScale_vecScale (c d : BPair) (u : List BPair) :
    vecScale c (vecScale d u) = vecScale (c * d) u := by
  show (u.map (fun x => d * x)).map (fun x => c * x)
    = u.map (fun x => (c * d) * x)
  rw [ground.map_map]
  exact ground.map_congr_all _ _
    (fun x => (BPair.mul_assoc c d x).symm) u

theorem vecScale_swapMap (c : BPair) (u : List BPair) :
    vecScale c (u.map BPair.swap) = (vecScale c u).map BPair.swap := by
  show (u.map BPair.swap).map (fun x => c * x)
    = (u.map (fun x => c * x)).map BPair.swap
  rw [ground.map_map, ground.map_map]
  exact ground.map_congr_all _ _ (fun x => BPair.mul_swap c x) u

/-- The combination at the coefficients' memberwise swap is the
combination's own swap. -/
theorem combo_swapMap (n : Nat) : ∀ (cs : List BPair)
    (L : Mat), combo n (cs.map BPair.swap) L
      = (combo n cs L).map BPair.swap
  | [], _ => by
    show List.replicate n BPair.unit
      = (List.replicate n BPair.unit).map BPair.swap
    exact (ground.map_replicate BPair.swap BPair.unit n).symm
  | _ :: _, [] => by
    show List.replicate n BPair.unit
      = (List.replicate n BPair.unit).map BPair.swap
    exact (ground.map_replicate BPair.swap BPair.unit n).symm
  | c :: cs, r :: L => by
    show vecAdd (vecScale c.swap r) (combo n (cs.map BPair.swap) L)
      = (vecAdd (vecScale c r) (combo n cs L)).map BPair.swap
    rw [combo_swapMap n cs L]
    show List.zipWith BPair.add (r.map (fun x => c.swap * x))
        ((combo n cs L).map BPair.swap)
      = (List.zipWith BPair.add (r.map (fun x => c * x))
        (combo n cs L)).map BPair.swap
    rw [ground.map_congr_all (fun x => c.swap * x)
      (fun x => BPair.swap (c * x)) (fun x => BPair.swap_mul c x) r,
      ← ground.map_map (fun x => c * x) BPair.swap r]
    exact zipWith_swap _ _
  where
    zipWith_swap : ∀ u w : List BPair,
        List.zipWith BPair.add (u.map BPair.swap)
          (w.map BPair.swap)
        = (List.zipWith BPair.add u w).map BPair.swap
      | [], _ => rfl
      | _ :: _, [] => rfl
      | a :: u, b :: w => by
        show (a.swap + b.swap)
            :: List.zipWith BPair.add (u.map BPair.swap)
              (w.map BPair.swap)
          = (a + b).swap :: (List.zipWith BPair.add u w).map
            BPair.swap
        rw [BPair.swap_add, zipWith_swap u w]

/-- The Gram's order: the pairings' family carries the source's
row count as both its row and its column count. -/
theorem gram_sqAt (L : Mat) : sqAt (gramM L) L.length := by
  refine ground.andIntroB ?_ ?_
  · rw [show (gramM L).length = L.length from ground.length_map _ L]
    exact beqRefl L.length
  · show ((L.map (fun r => L.map (fun c => dotP r c))).all
      (fun r => Nat.beq r.length L.length)) = true
    rw [ground.all_map]
    refine ground.all_of_pointwise _ L (fun r => ?_)
    rw [show (L.map (fun c => dotP r c)).length = L.length from
      ground.length_map _ L]
    exact beqRefl L.length

/-- A listed row of a matrix at one width reads that width. -/
theorem rowsLen_getAt {γ : Type} {n : Nat} :
    ∀ (L : List (List γ)) (i : Nat),
    rowsLen n L → i < L.length →
    (ground.getAt [] L i).length = n
  | [], _, _, hi => absurd hi (Nat.not_lt_zero _)
  | _ :: _, 0, h, _ => h.1
  | _ :: t, i + 1, h, hi =>
    rowsLen_getAt t i h.2 (Nat.lt_of_succ_lt_succ hi)

/-- The memberwise sum's congruence in both members, each side's
length matched. -/
theorem polyOne_vecAdd : ∀ (u u' w w' : List BPair),
    poly.oneValue u u' → poly.oneValue w w' →
    u.length = u'.length → w.length = w'.length →
    poly.oneValue (vecAdd u w) (vecAdd u' w')
  | [], [], _, _, _, _, _, _ => trivial
  | [], _ :: _, _, _, _, _, hu, _ => nomatch hu
  | _ :: _, [], _, _, _, _, hu, _ => nomatch hu
  | _ :: _, _ :: _, [], [], _, _, _, _ => trivial
  | _ :: _, _ :: _, [], _ :: _, _, _, _, hw => nomatch hw
  | _ :: _, _ :: _, _ :: _, [], _, _, _, hw => nomatch hw
  | _ :: u, _ :: u', _ :: w, _ :: w', hu, hw, hul, hwl =>
    ⟨BPair.add_congr hu.1 hw.1,
     polyOne_vecAdd u u' w w' hu.2 hw.2 (Nat.succ.inj hul)
       (Nat.succ.inj hwl)⟩

private theorem polyOne_refl : ∀ u : List BPair, poly.oneValue u u
  | [] => trivial
  | _ :: u => ⟨BPair.oneValue_refl _, polyOne_refl u⟩

/-- The combination's width at one row list depends on the
coefficients' count alone. -/
private theorem length_combo_congr (n : Nat) :
    ∀ (cs ds : List BPair) (L : Mat), cs.length = ds.length →
      (combo n cs L).length = (combo n ds L).length
  | [], [], _, _ => rfl
  | [], _ :: _, _, h => nomatch h
  | _ :: _, [], _, h => nomatch h
  | _ :: _, _ :: _, [], _ => rfl
  | c :: cs, d :: ds, r :: L, h =>
    ground.length_zipWith_congr BPair.add _ _ _ _
      ((length_vecScaleO bpairOps c r).trans
        (length_vecScaleO bpairOps d r).symm)
      (length_combo_congr n cs ds L (Nat.succ.inj h))

/-- The combination at a scaled coefficient family reads the
combination's own scale, the clearing crossing every term. -/
theorem vecScale_combo (c : BPair) (n : Nat) :
    ∀ (cs : List BPair) (L : Mat),
      poly.oneValue (vecScale c (combo n cs L))
        (combo n (vecScale c cs) L)
  | [], _ => by
    show poly.oneValue
      (vecScale c (List.replicate n BPair.unit))
      (List.replicate n BPair.unit)
    exact repl_scale_null c n
  | _ :: _, [] => repl_scale_null c n
  | k :: cs, r :: L => by
    show poly.oneValue
      (vecScale c (vecAdd (vecScale k r) (combo n cs L)))
      (vecAdd (vecScale (c * k) r) (combo n (vecScale c cs) L))
    rw [vecScale_vecAdd c (vecScale k r) (combo n cs L),
      vecScale_vecScale c k r]
    refine polyOne_vecAdd _ _ _ _ (polyOne_refl _)
      (vecScale_combo c n cs L) ?_ ?_
    · rfl
    · show (vecScale c (combo n cs L)).length
        = (combo n (vecScale c cs) L).length
      rw [show (vecScale c (combo n cs L)).length
          = (combo n cs L).length from ground.length_map _ _]
      exact length_combo_congr n cs (vecScale c cs) L
        (length_vecScaleO bpairOps c cs).symm
  where
    repl_scale_null (c : BPair) (n : Nat) : poly.oneValue
        (vecScale c (List.replicate n BPair.unit))
        (List.replicate n BPair.unit) := by
      rw [show vecScale c (List.replicate n BPair.unit)
          = List.replicate n (c * BPair.unit) from
        ground.map_replicate _ BPair.unit n]
      exact repl_go c n
    repl_go (c : BPair) : ∀ n : Nat, poly.oneValue
        (List.replicate n (c * BPair.unit))
        (List.replicate n BPair.unit)
      | 0 => trivial
      | n + 1 => ⟨BPair.mul_unit c, repl_go c n⟩

instance (p : poly.Poly) : Decidable (poly.unitTail p) :=
  poly.decUnitTail p

/-- The membership residual: the determinant-scaled vector against
the adjugate solve's combination, the swap the subtraction — the
test's pass the unit-tail read, decidable entry by entry. -/
def residV (n : Nat) (L : Mat) (v : List BPair) : List BPair :=
  vecAdd (vecScale (detL (gramM L)) v)
    ((combo n (adjP (gramM L) (L.map (fun r => dotP r v))) L).map
      BPair.swap)

/-- The collected list: one member joined per refusal, the
residual the test (`lem:lowerspan`'s joined-collection read). -/
def collectOf (n : Nat) (L : Mat) : Mat :=
  L.foldl (fun B r => if poly.unitTail (residV n B r) then B else B ++ [r]) []

/-- The span membership read: the shape reads with the residual's
unit tail at the collected list (`lem:lowerspan`'s decidable
read). -/
def spanRel (n : Nat) (L : Mat) (v : List BPair) : Prop :=
  rowsLen n L ∧ v.length = n
    ∧ poly.unitTail (residV n (collectOf n L) v)

instance (n : Nat) (L : Mat) (v : List BPair) : Decidable (spanRel n L v) :=
  inferInstanceAs (Decidable (_ ∧ _ ∧ _))

/-- The self-pairings' product over a family, one factor per row —
the pairwise-perpendicular family's Gram determinant (`detL_perp`),
one product where `detL` prices an assignment fold. -/
def selfProd : Mat → BPair
  | [] => BPair.ofPos .one
  | r :: t => (dotP r r * selfProd t).norm

/-- The residual's one pass over the family, the projection fold's
own recursion: a row reads its pairing against the vector at the
product of the rows below it (the pass's own second component),
and the rows below enter through that row's self-pairing scaling
their running sum, so the row's withheld factor is the product the
recursion already holds.  The pass returns that sum beside the
self-pairings' product (`residGo_snd`), the seed's unit family
carrying the vector's width.  Both components are read off one
binding of the recursion, so the family is walked once and the
count is `2L` pairings — each row's self-pairing and its pairing
against the vector. -/
def residGo : Mat → List BPair → List BPair × BPair
  | [], v => (vecScale BPair.unit v, BPair.ofPos .one)
  | r :: t, v =>
    let sp := residGo t v
    let q := dotP r r
    (vecAdd (vecScale ((dotP r v * sp.2).norm) r) (vecScale q sp.1),
      (q * sp.2).norm)

/-- The diagonal-Gram residual: the self-pairings' product against
the vector, joined to the pass's running sum at the memberwise
swap, the swap the subtraction.  At a pairwise-perpendicular
family this is the membership residual entry for entry
(`residD_residV`), two pairings per row where `residV` prices an
L-by-L determinant. -/
def residD (L : Mat) (v : List BPair) : List BPair :=
  let sp := residGo L v
  vecAdd (vecScale sp.2 v) (sp.1.map BPair.swap)

/-- Scaling keeps a vector's width. -/
theorem length_vecScale (c : BPair) (u : List BPair) :
    (vecScale c u).length = u.length := length_vecScaleO bpairOps c u

/-- The scalar's partner walks to the vector's memberwise swap:
scaling by a balance partner is the scaled vector's own partner,
entry by entry. -/
theorem vecScale_swap (c : BPair) : ∀ u : List BPair,
    vecScale (BPair.swap c) u = (vecScale c u).map BPair.swap
  | [] => rfl
  | a :: u => by
    show BPair.swap c * a :: vecScale (BPair.swap c) u
      = (c * a).swap :: (vecScale c u).map BPair.swap
    rw [vecScale_swap c u, BPair.mul_comm (BPair.swap c) a,
      BPair.mul_swap a c, BPair.mul_comm a c]

/-- A scaling keeps the unit tail. -/
theorem unitTail_vecScale (c : BPair) : ∀ b : List BPair,
    poly.unitTail b → poly.unitTail (vecScale c b)
  | [], _ => trivial
  | _ :: t, h =>
    ⟨BPair.oneValue_trans
       (BPair.mul_congr (BPair.oneValue_refl c) h.1) (BPair.mul_unit c),
     unitTail_vecScale c t h.2⟩

/-- A scaling carries a one-value read. -/
theorem vecScale_oneValue (c : BPair) : ∀ a b : List BPair,
    poly.oneValue a b → poly.oneValue (vecScale c a) (vecScale c b)
  | [], b, h => unitTail_vecScale c b h
  | _ :: t, [], h =>
    ⟨BPair.oneValue_trans
       (BPair.mul_congr (BPair.oneValue_refl c) h.1) (BPair.mul_unit c),
     unitTail_vecScale c t h.2⟩
  | _ :: a, _ :: b, h =>
    ⟨BPair.mul_congr (BPair.oneValue_refl c) h.1, vecScale_oneValue c a b h.2⟩

/-- An off-unit clearing's unit tail descends to the vector, the
cancellation entry by entry. -/
theorem unitTail_unscale (c : BPair)
    (hc : ¬ c.oneValue BPair.unit) : ∀ u : List BPair,
    poly.unitTail (vecScale c u) → poly.unitTail u
  | [], _ => trivial
  | _ :: t, h =>
    ⟨ground.mul_cancel_unit hc h.1, unitTail_unscale c hc t h.2⟩

/-- An off-unit clearing cancels from a scaled one-value read, the
members' cancellation entry by entry with the tails' units
descending. -/
theorem oneValue_unscale (c : BPair)
    (hc : ¬ c.oneValue BPair.unit) : ∀ x y : List BPair,
    poly.oneValue (vecScale c x) (vecScale c y) → poly.oneValue x y
  | [], y, h => unitTail_unscale c hc y h
  | _ :: x, [], h =>
    ⟨ground.mul_cancel_unit hc h.1, unitTail_unscale c hc x h.2⟩
  | _ :: x, _ :: y, h =>
    ⟨ground.mulCancel hc h.1, oneValue_unscale c hc x y h.2⟩

/-- The natural one scales a vector to its own value. -/
theorem vecScale_one : ∀ a : List BPair,
    poly.oneValue (vecScale (BPair.ofNat 1) a) a
  | [] => trivial
  | x :: a => ⟨BPair.ofNat_one_mul x, vecScale_one a⟩

/-- The scaled row's pairing carries the scale out of the fold. -/
theorem dotP_scaleRow (w : BPair) : ∀ r u : List BPair,
    (dotP (poly.scaleP w r) u).oneValue (w * dotP r u)
  | [], _ => BPair.oneValue_symm (BPair.mul_unit w)
  | _ :: _, [] => BPair.oneValue_symm (BPair.mul_unit w)
  | a :: r, b :: u => by
    show ((w * a).norm * b
        + dotP (poly.scaleP w r) u).oneValue
      (w * (a * b + dotP r u))
    rw [BPair.left_distrib]
    refine BPair.add_congr ?_ (dotP_scaleRow w r u)
    exact BPair.oneValue_trans
      (BPair.mul_congr (BPair.norm_oneValue _) (BPair.oneValue_refl b))
      (BPair.oneValue_of_eq (BPair.mul_assoc w a b))

private theorem length_gramM (L : Mat) :
    (gramM L).length = L.length := ground.length_map _ L

/-- The adjugate solve's width is the list's own count, read at
every list. -/
theorem length_adjP (G : Mat) (p : List BPair) :
    (adjP G p).length = G.length := by
  show (combo G.length p
      ((List.range G.length).map (fun k => cofVec G k))).length
    = G.length
  exact length_combo G.length p _ (cofRows_rowsLen G)

/-- The residual reads the family's own width. -/
theorem length_residV (n : Nat) (L : Mat) (v : List BPair)
    (hLn : rowsLen n L) (hv : v.length = n) :
    (residV n L v).length = n := by
  refine length_zipWith BPair.add _ _ n ?_ ?_
  · rw [show (vecScale (detL (gramM L)) v).length = v.length from
      ground.length_map _ v, hv]
  · rw [ground.length_map, length_combo n _ L hLn]

/-- The residual sits against every row at the sum's unit: the
solve's identity read through the Gram. -/
theorem resid_perp (n : Nat) (L : Mat) (v : List BPair)
    (hLn : rowsLen n L) (hv : v.length = n) (i : Nat)
    (hi : i < L.length) :
    (dotP (ground.getAt [] L i) (residV n L v)).oneValue
      BPair.unit := by
  have hrl : (ground.getAt [] L i).length = n :=
    rowsLen_getAt L i hLn hi
  have hp : (L.map (fun r => dotP r v)).length = L.length :=
    ground.length_map _ L
  refine BPair.oneValue_trans
    (dotP_vecAdd (ground.getAt [] L i) _ _
      (by rw [show (vecScale (detL (gramM L)) v).length = v.length
            from ground.length_map _ v, hv, hrl])
      (by rw [ground.length_map,
            length_combo n _ L hLn, hrl])) ?_
  rw [dotP_swapMap]
  refine BPair.oneValue_trans
    (BPair.add_congr
      (dotP_vecScale (detL (gramM L)) (ground.getAt [] L i) v
        (by rw [hv, hrl]))
      (swap_congr
        (BPair.oneValue_trans
          (dotP_combo (adjP (gramM L) (L.map (fun r => dotP r v)))
            L (ground.getAt [] L i) n hLn)
          (by
            rw [show L.map (fun row =>
                dotP (ground.getAt [] L i) row)
              = ground.getAt [] (gramM L) i from
              (gramM_row L i hi).symm,
              dotP_comm]
            exact adjP_read (gramM L) (gram_sqAt L)
              (L.map (fun r => dotP r v)) hp i hi)))) ?_
  rw [show ground.getAt BPair.unit (L.map (fun r => dotP r v)) i
      = dotP (ground.getAt [] L i) v from
    ground.getAt_map [] BPair.unit _ L i hi,
    BPair.mul_comm (dotP (ground.getAt [] L i) v) (detL (gramM L))]
  exact ground.unitOfOne (BPair.oneValue_refl _)

/-- Two lists at one width whose memberwise gap, the join against
the second's swap, reads the unit tail are one value, the entries'
one-value reads off their balanced joins. -/
theorem oneValue_of_null_swap : ∀ (a b : List BPair),
    a.length = b.length →
    poly.unitTail (vecAdd a (b.map BPair.swap)) →
    poly.oneValue a b
  | [], [], _, _ => trivial
  | [], _ :: _, hl, _ => nomatch hl
  | _ :: _, [], hl, _ => nomatch hl
  | _ :: a, _ :: b, hl, h =>
    ⟨ground.oneOfUnit h.1,
     oneValue_of_null_swap a b (Nat.succ.inj hl) h.2⟩

/-- The test's soundness at the characterization: a passing
residual at an off-unit determinant is a span witness, the
determinant the clearing scalar. -/
private theorem resid_soundE (n : Nat) (L : Mat) (v : List BPair)
    (hLn : rowsLen n L) (hv : v.length = n)
    (hdet : ¬ (detL (gramM L)).oneValue BPair.unit)
    (h : poly.unitTail (residV n L v)) : spanRelE n L v := by
  refine ⟨detL (gramM L),
    adjP (gramM L) (L.map (fun r => dotP r v)),
    hdet, (length_adjP (gramM L) _).trans (length_gramM L), ?_⟩
  refine oneValue_of_null_swap _ _ ?_ h
  rw [show (vecScale (detL (gramM L)) v).length = v.length from
      ground.length_map _ v, hv,
    length_combo n _ L hLn]

/-- The test's completeness at the characterization: a span
member's residual passes, the perpendicular residual inside the
span reading the sum's unit at the pairing's definiteness. -/
private theorem resid_completeE (n : Nat) (L : Mat) (v : List BPair)
    (hLn : rowsLen n L) (hv : v.length = n)
    (hsp : spanRelE n L v) : poly.unitTail (residV n L v) := by
  obtain ⟨c₀, cs, hc₀, hcsl, hone⟩ := hsp
  have hw : ∀ k, k < L.length →
      (dotP (residV n L v) (ground.getAt [] L k)).oneValue
        BPair.unit := by
    intro k hk
    rw [dotP_comm]
    exact resid_perp n L v hLn hv k hk
  have hcombo_null : ∀ ds : List BPair,
      (dotP (residV n L v) (combo n ds L)).oneValue BPair.unit := by
    intro ds
    refine BPair.oneValue_trans
      (dotP_combo ds L (residV n L v) n hLn) ?_
    refine dotP_null_right ds _ (fun i hi => ?_)
    rw [ground.length_map] at hi
    rw [ground.getAt_map [] BPair.unit _ L i hi]
    exact hw i hi
  -- c₀ · w reads as a combination against a swapped combination
  have hscale : poly.oneValue
      (vecScale c₀ (residV n L v))
      (vecAdd
        (vecScale (detL (gramM L)) (combo n cs L))
        ((combo n (vecScale c₀
          (adjP (gramM L) (L.map (fun r => dotP r v)))) L).map
          BPair.swap)) := by
    rw [show vecScale c₀ (residV n L v)
        = vecAdd
          (vecScale c₀ (vecScale (detL (gramM L)) v))
          (vecScale c₀ ((combo n (adjP (gramM L)
            (L.map (fun r => dotP r v))) L).map BPair.swap)) from
      vecScale_vecAdd c₀ _ _,
      vecScale_swapMap c₀ _,
      vecScale_vecScale c₀ (detL (gramM L)) v,
      show c₀ * detL (gramM L) = detL (gramM L) * c₀ from
        BPair.mul_comm _ _,
      ← vecScale_vecScale (detL (gramM L)) c₀ v]
    refine polyOne_vecAdd _ _ _ _ ?_ ?_ ?_ ?_
    · exact vecScale_oneValue (detL (gramM L)) _ _ hone
    · exact poly.swapMap_oneValue (vecScale_combo c₀ n _ L)
    · rw [length_vecScale, length_vecScale, length_vecScale,
        length_combo n cs L hLn, hv]
    · rw [ground.length_map, ground.length_map, length_vecScale,
        length_combo n _ L hLn, length_combo n _ L hLn]
  -- the self-fold clears through the scalar
  have hWlen : (vecScale c₀ (residV n L v)).length
      = (vecAdd (vecScale (detL (gramM L)) (combo n cs L))
        ((combo n (vecScale c₀ (adjP (gramM L)
          (L.map (fun r => dotP r v)))) L).map
          BPair.swap)).length := by
    rw [length_vecScale, length_residV n L v hLn hv]
    refine (length_zipWith BPair.add _ _ n ?_ ?_).symm
    · rw [length_vecScale, length_combo n cs L hLn]
    · rw [ground.length_map, length_combo n _ L hLn]
  have hself : (c₀ * dotP (residV n L v) (residV n L v)).oneValue
      BPair.unit := by
    refine BPair.oneValue_trans
      (BPair.oneValue_symm
        (dotP_vecScale c₀ (residV n L v) (residV n L v)
          (by rfl))) ?_
    refine BPair.oneValue_trans
      (dotP_congr_right (residV n L v)
        (vecScale c₀ (residV n L v))
        (vecAdd (vecScale (detL (gramM L)) (combo n cs L))
          ((combo n (vecScale c₀ (adjP (gramM L)
            (L.map (fun r => dotP r v)))) L).map BPair.swap))
        hWlen
        (fun i _ =>
          poly.oneValue_getAt i hscale)) ?_
    refine BPair.oneValue_trans
      (dotP_vecAdd (residV n L v)
        (vecScale (detL (gramM L)) (combo n cs L))
        ((combo n (vecScale c₀ (adjP (gramM L)
          (L.map (fun r => dotP r v)))) L).map BPair.swap)
        (by rw [length_vecScale, length_combo n cs L hLn,
              length_residV n L v hLn hv])
        (by rw [ground.length_map, length_combo n _ L hLn,
              length_residV n L v hLn hv])) ?_
    rw [dotP_swapMap]
    refine BPair.oneValue_trans
      (BPair.add_congr
        (BPair.oneValue_trans
          (dotP_vecScale (detL (gramM L)) (residV n L v)
            (combo n cs L)
            (by rw [length_combo n cs L hLn,
                  length_residV n L v hLn hv]))
          (BPair.oneValue_trans
            (BPair.mul_congr
              (BPair.oneValue_refl (detL (gramM L)))
              (hcombo_null cs))
            (BPair.mul_unit _)))
        (swap_congr (hcombo_null _))) ?_
    exact BPair.unit_add BPair.unit
  exact dotP_self_null (residV n L v)
    (mul_cancel_unit hc₀ hself)

/-! The independence tier: a rejected vector joins the span, an
accepted one extends the independent family, and an independent
family's Gram determinant sits off the sum's unit — the descent at
the last row's cofactor against the dropped family's own
determinant. -/

/-- A unit clearing scales every vector to a unit tail. -/
theorem unitTail_vecScale_unit {c : BPair}
    (hc : c.oneValue BPair.unit) : ∀ v : List BPair,
    poly.unitTail (vecScale c v)
  | [] => trivial
  | _ :: v => ⟨oneValue_unit_mul hc, unitTail_vecScale_unit hc v⟩

private theorem unitTail_split_left : ∀ {u w : List BPair},
    u.length = w.length → poly.unitTail (vecAdd u w) →
    poly.unitTail w → poly.unitTail u
  | [], [], _, _, _ => trivial
  | [], _ :: _, hl, _, _ => nomatch hl
  | _ :: _, [], hl, _, _ => nomatch hl
  | a :: u, b :: w, hl, h, hw => by
    refine ⟨?_, unitTail_split_left (Nat.succ.inj hl) h.2 hw.2⟩
    -- a + b ~ unit, b ~ unit → a ~ unit
    have h1 : (a + b).oneValue BPair.unit := h.1
    have h2 : (a + b).oneValue a := by
      show (a.fst + b.fst) + a.snd = a.fst + (a.snd + b.snd)
      have h3 : b.fst = b.snd := add_cancel_ones hw.1
      rw [h3, ground.add_right_comm a.fst b.snd a.snd,
        ground.add_assoc]
    exact BPair.oneValue_trans (BPair.oneValue_symm h2) h1

private theorem splitLast {α : Type} : ∀ (l : List α), l = [] ∨
    ∃ (t : List α) (a : α), l = t ++ [a]
  | [] => Or.inl rfl
  | a :: l =>
    match splitLast l with
    | Or.inl he => Or.inr ⟨[], a, by rw [he]; rfl⟩
    | Or.inr ⟨t, b, he⟩ => Or.inr ⟨a :: t, b, by rw [he]; rfl⟩

/-- Two unit tails join to a unit tail. -/
theorem unitTail_append : ∀ {a b : List BPair},
    poly.unitTail a → poly.unitTail b → poly.unitTail (a ++ b)
  | [], _, _, hb => hb
  | _ :: t, _, ha, hb => ⟨ha.1, unitTail_append (a := t) ha.2 hb⟩

/-- A vanishing memberwise sum reads its second family as the
first's memberwise swap, at matched counts. -/
theorem swap_of_null_add : ∀ (a b : List BPair),
    a.length = b.length → poly.unitTail (vecAdd a b) →
    poly.oneValue b (a.map BPair.swap)
  | [], [], _, _ => trivial
  | [], _ :: _, hl, _ => nomatch hl
  | _ :: _, [], hl, _ => nomatch hl
  | x :: a, y :: b, hl, h => by
    refine ⟨?_, swap_of_null_add a b (Nat.succ.inj hl) h.2⟩
    have h1 : x.fst + y.fst = x.snd + y.snd := add_cancel_ones h.1
    show y.fst + x.fst = x.snd + y.snd
    rw [ground.add_comm y.fst x.fst]
    exact h1

/-- The matrix read assembled at the entries: two families at a
stated shape reading one value at every key pair read one value. -/
theorem matOne_of_entries (A B : Mat) (n : Nat)
    (hAl : A.length = n) (hAr : rowsLen n A)
    (hBl : B.length = n) (hBr : rowsLen n B)
    (h : ∀ i j, i < n → j < n →
      (ground.getAt BPair.unit
          (ground.getAt ([] : List BPair) A i) j).oneValue
        (ground.getAt BPair.unit
          (ground.getAt ([] : List BPair) B i) j)) :
    matOneValue A B := by
  refine matOne_getAt A B (by rw [hAl, hBl]) ?_
  intro i hi
  rw [hAl] at hi
  refine poly.oneValue_of_entries _ _ ?_ ?_
  · rw [rowsLen_getAt A i hAr (by rw [hAl]; exact hi),
      rowsLen_getAt B i hBr (by rw [hBl]; exact hi)]
  · intro j hj
    rw [rowsLen_getAt A i hAr (by rw [hAl]; exact hi)] at hj
    exact h i j hi hj

/-- The memberwise sum of two vectors at one order keeps it. -/
theorem length_vecAdd (u w : List BPair) (n : Nat)
    (hu : u.length = n) (hw : w.length = n) :
    (vecAdd u w).length = n := length_vecAddO bpairOps u w n hu hw

/-- Inside both orders the sum's entry is the entries' sum. -/
theorem getAt_vecAdd (u w : List BPair) (i : Nat)
    (hu : i < u.length) (hw : i < w.length) :
    ground.getAt BPair.unit (vecAdd u w) i
      = ground.getAt BPair.unit u i + ground.getAt BPair.unit w i :=
  getAt_vecAddO bpairOps u w i hu hw

/-- The memberwise sum against a representative list: norming the
left summand first changes nothing the representative reads. -/
theorem pnorm_vecAdd_left (u v : List BPair)
    (h : u.length = v.length) :
    poly.pnorm (vecAdd (poly.pnorm u) v)
      = poly.pnorm (vecAdd u v) := by
  refine poly.pnorm_congr _ _ ?_ ?_
  · rw [length_vecAdd (poly.pnorm u) v (poly.pnorm u).length rfl
      (((poly.pnorm_length u).trans h).symm),
      length_vecAdd u v u.length rfl h.symm]
    exact poly.pnorm_length u
  · exact polyOne_vecAdd _ _ _ _ (poly.pnorm_oneValue u)
      (poly.oneValue_refl v) (poly.pnorm_length u) rfl

/-- A rescaled family's entry is the scalar against the entry. -/
theorem getAt_vecScale (c : BPair) (u : List BPair) (i : Nat)
    (hi : i < u.length) :
    ground.getAt BPair.unit (vecScale c u) i
      = c * ground.getAt BPair.unit u i :=
  getAt_vecScaleO bpairOps c u i hi


private theorem combo_append_one (n : Nat) :
    ∀ (cs : List BPair) (c : BPair) (L : Mat) (v : List BPair),
    cs.length = L.length → rowsLen n L → v.length = n →
    poly.oneValue (combo n (cs ++ [c]) (L ++ [v]))
      (vecAdd (combo n cs L) (vecScale c v))
  | [], c, [], v, _, _, hv => by
    show poly.oneValue
      (vecAdd (vecScale c v) (List.replicate n BPair.unit))
      (vecAdd (List.replicate n BPair.unit) (vecScale c v))
    refine poly.oneValue_of_entries _ _ ?_ ?_
    · rw [length_vecAdd _ _ n (by rw [length_vecScale, hv])
          (ground.length_replicate BPair.unit n),
        length_vecAdd _ _ n (ground.length_replicate BPair.unit n)
          (by rw [length_vecScale, hv])]
    · intro i hi
      rw [length_vecAdd _ _ n (by rw [length_vecScale, hv])
          (ground.length_replicate BPair.unit n)] at hi
      rw [getAt_vecAdd _ _ i
          (by rw [length_vecScale, hv]; exact hi)
          (by rw [ground.length_replicate BPair.unit n]; exact hi),
        getAt_vecAdd _ _ i
          (by rw [ground.length_replicate BPair.unit n]; exact hi)
          (by rw [length_vecScale, hv]; exact hi)]
      show (ground.getAt BPair.unit (vecScale c v) i
          + ground.getAt BPair.unit
            (List.replicate n BPair.unit) i).oneValue
        (ground.getAt BPair.unit (List.replicate n BPair.unit) i
          + ground.getAt BPair.unit (vecScale c v) i)
      rw [BPair.add_comm]
      exact BPair.oneValue_refl _
  | [], _, _ :: _, _, hcl, _, _ => nomatch hcl
  | _ :: _, _, [], _, hcl, _, _ => nomatch hcl
  | c' :: cs, c, r :: L, v, hcl, hL, hv => by
    show poly.oneValue
      (vecAdd (vecScale c' r) (combo n (cs ++ [c]) (L ++ [v])))
      (vecAdd (vecAdd (vecScale c' r) (combo n cs L))
        (vecScale c v))
    refine poly.oneValue_trans (q := vecAdd (vecScale c' r)
        (vecAdd (combo n cs L) (vecScale c v))) ?_ ?_
    · refine polyOne_vecAdd _ _ _ _ (polyOne_refl _)
        (combo_append_one n cs c L v (Nat.succ.inj hcl) hL.2 hv)
        rfl
        (by rw [length_combo_app n cs c L v (Nat.succ.inj hcl)
              hL.2 hv,
            length_vecAdd _ _ n (length_combo n cs L hL.2)
              (by rw [length_vecScale, hv])])
    · refine poly.oneValue_of_entries _ _ ?_ ?_
      · rw [length_vecAdd _ _ n
            (by rw [length_vecScale]; exact hL.1)
            (length_vecAdd _ _ n (length_combo n cs L hL.2)
              (by rw [length_vecScale, hv])),
          length_vecAdd _ _ n
            (length_vecAdd _ _ n
              (by rw [length_vecScale]; exact hL.1)
              (length_combo n cs L hL.2))
            (by rw [length_vecScale, hv])]
      · intro i hi
        rw [length_vecAdd _ _ n
            (by rw [length_vecScale]; exact hL.1)
            (length_vecAdd _ _ n (length_combo n cs L hL.2)
              (by rw [length_vecScale, hv]))] at hi
        have h1 : i < (vecScale c' r).length := by
          rw [length_vecScale]
          rw [hL.1]
          exact hi
        have h2 : i < (combo n cs L).length := by
          rw [length_combo n cs L hL.2]
          exact hi
        have h3 : i < (vecScale c v).length := by
          rw [length_vecScale, hv]
          exact hi
        rw [getAt_vecAdd _ _ i h1
            (by
              rw [length_vecAdd _ _ n (length_combo n cs L hL.2)
                (by rw [length_vecScale, hv])]
              exact hi),
          getAt_vecAdd _ _ i h2 h3,
          getAt_vecAdd _ _ i
            (by
              rw [length_vecAdd _ _ n
                (by rw [length_vecScale]; exact hL.1)
                (length_combo n cs L hL.2)]
              exact hi)
            h3,
          getAt_vecAdd _ _ i h1 h2,
          ← BPair.add_assoc]
        exact BPair.oneValue_refl _
  where
    length_combo_app (n : Nat) (cs : List BPair) (c : BPair)
        (L : Mat) (v : List BPair) (hcl : cs.length = L.length)
        (hL : rowsLen n L) (hv : v.length = n) :
        (combo n (cs ++ [c]) (L ++ [v])).length = n :=
      length_combo n (cs ++ [c]) (L ++ [v])
        (rowsLen_append n L v hL hv)
    rowsLen_append (n : Nat) : ∀ (L : Mat) (v : List BPair),
        rowsLen n L → v.length = n → rowsLen n (L ++ [v])
      | [], v, _, hv => ⟨hv, trivial⟩
      | r :: L, v, hL, hv =>
        ⟨hL.1, rowsLen_append n L v hL.2 hv⟩

/-! The independent family's Gram determinant sits off the sum's
unit: the descent at the last cofactor — a balanced determinant
reads the cofactor vector as a dependency, and the last cofactor
is the dropped family's own determinant through the trailing key's
enumeration. -/

/-- The term's congruence at the letters an assignment reads: two
families agreeing below a stated letter count read one value at
every assignment inside it. -/
private theorem termO_congr_letters {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) (m : Nat) :
    ∀ (M N : List (List γ)) (t : List Nat), M.length = N.length →
    (∀ a, a < M.length → ∀ b, b < m →
      R.rel (ground.getAt ops.unit (ground.getAt [] M a) b)
        (ground.getAt ops.unit (ground.getAt [] N a) b)) →
    (∀ x, 0 < ground.countOf x t → x < m) →
    R.rel (termO ops M t) (termO ops N t)
  | [], [], _, _, _, _ => C.ovRefl _
  | [], _ :: _, _, hl, _, _ => nomatch hl
  | _ :: _, [], _, hl, _, _ => nomatch hl
  | _ :: _, _ :: _, [], _, _, _ => C.ovRefl _
  | r :: M, s :: N, j :: t, hl, h, ht =>
    C.mulCongr
      (h 0 (Nat.succ_pos _) j
        (ht j (by rw [ground.countOf_head]; exact Nat.succ_pos _)))
      (termO_congr_letters C m M N t (Nat.succ.inj hl)
        (fun a ha b hb => h (a + 1) (Nat.succ_lt_succ ha) b hb)
        (fun x hx => ht x
          (Nat.lt_of_lt_of_le hx (Nat.le_add_left _ _))))

/-- The memberwise sum of two unit tails is a unit tail. -/
theorem unitTail_vecAdd_of : ∀ {a b : List BPair},
    poly.unitTail a → poly.unitTail b →
    poly.unitTail (vecAdd a b)
  | [], _, _, _ => trivial
  | _ :: _, [], _, _ => trivial
  | _ :: a, _ :: _, ha, hb =>
    ⟨BPair.oneValue_trans (BPair.add_congr ha.1 hb.1)
      (BPair.unit_add BPair.unit),
     unitTail_vecAdd_of (a := a) ha.2 hb.2⟩

/-- A joined unit tail reads each part at it. -/
theorem unitTail_append_split : ∀ (u w : List BPair),
    poly.unitTail (u ++ w) → poly.unitTail u ∧ poly.unitTail w
  | [], _, h => ⟨trivial, h⟩
  | _ :: t, w, h =>
    ⟨⟨h.1, (unitTail_append_split t w h.2).1⟩,
     (unitTail_append_split t w h.2).2⟩

private theorem rowsLen_split (n : Nat) : ∀ (L : Mat)
    (v : List BPair), rowsLen n (L ++ [v]) →
    rowsLen n L ∧ v.length = n
  | [], _, h => ⟨trivial, h.1⟩
  | _ :: L, v, h =>
    ⟨⟨h.1, (rowsLen_split n L v h.2).1⟩,
     (rowsLen_split n L v h.2).2⟩

private theorem indep_dropLast (n : Nat) (L : Mat)
    (v : List BPair) (hLn : rowsLen n L) (hv : v.length = n)
    (hind : ∀ cs, cs.length = (L ++ [v]).length →
      poly.unitTail (combo n cs (L ++ [v])) → poly.unitTail cs) :
    ∀ cs, cs.length = L.length → poly.unitTail (combo n cs L) →
      poly.unitTail cs := by
  intro cs hcl hnull
  have h1 : poly.unitTail
      (combo n (cs ++ [BPair.unit]) (L ++ [v])) := by
    refine poly.oneValue_unitTail
      (combo_append_one n cs BPair.unit L v hcl hLn hv) ?_
    exact unitTail_vecAdd_of hnull
      (unitTail_vecScale_unit (BPair.oneValue_refl BPair.unit) v)
  have h2 := hind (cs ++ [BPair.unit])
    (by rw [ground.length_append, ground.length_append, hcl]; rfl) h1
  exact (unitTail_append_split _ _ h2).1

private theorem eraseIdx_map {α β : Type} (f : α → β) :
    ∀ (l : List α) (k : Nat),
      (l.map f).eraseIdx k = (l.eraseIdx k).map f
  | [], 0 => rfl
  | [], _ + 1 => rfl
  | _ :: _, 0 => rfl
  | a :: l, k + 1 => by
    show f a :: (l.map f).eraseIdx k = f a :: (l.eraseIdx k).map f
    rw [eraseIdx_map f l k]

private theorem eraseIdx_append_last {α : Type} :
    ∀ (l : List α) (a : α), (l ++ [a]).eraseIdx l.length = l
  | [], _ => rfl
  | x :: l, a => by
    show x :: (l ++ [a]).eraseIdx l.length = x :: l
    rw [eraseIdx_append_last l a]

private theorem termAt_congr_letters (m : Nat) :
    ∀ (M M' : Mat) (t : List Nat), M.length = M'.length →
    (∀ i, i < M.length → ∀ j, j < m →
      ground.getAt BPair.unit (ground.getAt [] M i) j
        = ground.getAt BPair.unit (ground.getAt [] M' i) j) →
    (∀ x, 0 < ground.countOf x t → x < m) →
    termAt M t = termAt M' t :=
  termO_congr_letters (R := bpairEqRead) bpairEqCore m

private theorem cof_last_bridge (L : Mat) (v : List BPair) :
    cof0 ((gramM (L ++ [v])).eraseIdx L.length) L.length
      = detL (gramM L) := by
  have herase : (gramM (L ++ [v])).eraseIdx L.length
      = L.map (fun r => (L ++ [v]).map (fun c => dotP r c)) := by
    show ((L ++ [v]).map (fun r => (L ++ [v]).map
        (fun c => dotP r c))).eraseIdx L.length = _
    rw [eraseIdx_map _ (L ++ [v]) L.length,
      eraseIdx_append_last L v]
  rw [herase]
  show ground.famFold BPair.add BPair.unit
      (fun t => sgnAt t (termAt (L.map (fun r =>
        (L ++ [v]).map (fun c => dotP r c))) t))
      (places.monomialsAt (subContent L.length
        (L.map (fun r => (L ++ [v]).map
          (fun c => dotP r c))).length))
    = _
  rw [show (L.map (fun r => (L ++ [v]).map
      (fun c => dotP r c))).length = L.length from
    ground.length_map _ L]
  rw [show subContent L.length L.length
      = List.replicate L.length 1 ++ [0] from by
    show List.replicate L.length 1
        ++ 0 :: List.replicate (L.length - L.length) 1
      = List.replicate L.length 1 ++ [0]
    rw [Nat.sub_self]
    rfl,
    places.monomialsAt_zero_tail (List.replicate L.length 1)]
  show _ = ground.famFold BPair.add BPair.unit
    (fun t => sgnAt t (termAt (gramM L) t))
    (places.monomialsAt (List.replicate (gramM L).length 1))
  rw [length_gramM L]
  refine ground.famFold_congr_members BPair.add BPair.unit _ _
    (places.monomialsAt (List.replicate L.length 1))
    (fun t ht => ?_)
  rw [termAt_congr_letters L.length
    (L.map (fun r => (L ++ [v]).map (fun c => dotP r c)))
    (gramM L) t
    (by rw [ground.length_map, length_gramM])
    (fun i hi j hj => by
      rw [ground.length_map] at hi
      rw [ground.getAt_map ([] : List BPair) ([] : List BPair)
          (fun r => (L ++ [v]).map (fun c => dotP r c)) L i hi,
        gramM_row L i hi,
        ground.map_append (fun c => dotP (ground.getAt [] L i) c)
          L [v],
        ground.getAt_append BPair.unit _ _ j,
        if_pos (by rw [ground.length_map]; exact hj)])
    (fun x hx => (places.perm_member_reads ht).2.2.1 x hx)]

private theorem sgnP_unit {s : Nat} {x : BPair}
    (h : (sgnP s x).oneValue BPair.unit) :
    x.oneValue BPair.unit := sgnPO_unit (R := ground.bpairRead) bpairCore h

private theorem combo_self_null (n : Nat) (L : Mat)
    (hLn : rowsLen n L) (e : List BPair)
    (hperp : ∀ i, i < L.length →
      (dotP (ground.getAt [] L i) (combo n e L)).oneValue
        BPair.unit) : poly.unitTail (combo n e L) := by
  refine dotP_self_null (combo n e L) ?_
  refine BPair.oneValue_trans
    (dotP_combo e L (combo n e L) n hLn) ?_
  refine dotP_null_right e _ (fun i hi => ?_)
  rw [ground.length_map] at hi
  rw [ground.getAt_map ([] : List BPair) BPair.unit _ L i hi,
    dotP_comm]
  exact hperp i hi

/-- The erasure at the joined key reads the leading family back. -/
private theorem eraseIdx_append_len {α : Type} (l : List α) (a : α)
    (k : Nat) (hk : l.length = k) : (l ++ [a]).eraseIdx k = l := by
  rw [← hk]
  exact eraseIdx_append_last l a

/-- The vacant family's Gram determinant sits off the sum's unit,
the empty assignment fold's own read. -/
private theorem det_nil : ¬ (detL (gramM [])).oneValue
    BPair.unit := by decide +kernel

private theorem indep_det_go : ∀ (fuel n : Nat) (L : Mat),
    L.length ≤ fuel → rowsLen n L →
    (∀ cs, cs.length = L.length → poly.unitTail (combo n cs L) →
      poly.unitTail cs) →
    ¬ (detL (gramM L)).oneValue BPair.unit
  | _, _, [], _, _, _ => det_nil
  | 0, _, _ :: _, hf, _, _ => nomatch hf
  | fuel + 1, n, r :: L, hf, hLn, hind => by
    match splitLast (r :: L) with
    | Or.inl he => exact nomatch he
    | Or.inr ⟨L', v, he⟩ =>
      rw [he] at hLn hind ⊢
      obtain ⟨hLn', hv⟩ := rowsLen_split n L' v hLn
      have hf' : L'.length ≤ fuel := by
        have h1 : (L' ++ [v]).length ≤ fuel + 1 := by
          rw [← he]
          exact hf
        rw [ground.length_append] at h1
        exact Nat.le_of_succ_le_succ h1
      have ihdet := indep_det_go fuel n L' hf' hLn'
        (indep_dropLast n L' v hLn' hv hind)
      intro hdet
      have hGl : (gramM (L' ++ [v])).length = L'.length + 1 := by
        rw [length_gramM, ground.length_append]
        rfl
      have hm : L'.length < (gramM (L' ++ [v])).length := by
        rw [hGl]
        exact Nat.lt_succ_self _
      have hperp : ∀ i, i < (L' ++ [v]).length →
          (dotP (ground.getAt [] (L' ++ [v]) i)
            (combo n (cofVec (gramM (L' ++ [v])) L'.length)
              (L' ++ [v]))).oneValue BPair.unit := by
        intro i hi
        have hiG : i < (gramM (L' ++ [v])).length := by
          rw [length_gramM]
          exact hi
        have hrow : (ground.getAt []
            (gramM (L' ++ [v])) i).length
            = (gramM (L' ++ [v])).length := by
          rw [sqAt_row_len (gram_sqAt (L' ++ [v])) i hiG,
            length_gramM]
        refine BPair.oneValue_trans
          (dotP_combo (cofVec (gramM (L' ++ [v])) L'.length)
            (L' ++ [v]) (ground.getAt [] (L' ++ [v]) i) n
            hLn) ?_
        rw [show (L' ++ [v]).map (fun row =>
            dotP (ground.getAt [] (L' ++ [v]) i) row)
          = ground.getAt [] (gramM (L' ++ [v])) i from
          (gramM_row (L' ++ [v]) i hi).symm,
          dotP_comm]
        by_cases him : i = L'.length
        · rw [him]
          refine BPair.oneValue_trans
            (cofVec_diag (gramM (L' ++ [v])) L'.length hm
              (by rw [← him]; exact hrow)) ?_
          exact hdet
        · exact cofVec_off (gramM (L' ++ [v])) i L'.length hiG
            hm him hrow
      have hnul := combo_self_null n (L' ++ [v]) hLn
        (cofVec (gramM (L' ++ [v])) L'.length) hperp
      have hcof := hind (cofVec (gramM (L' ++ [v])) L'.length)
        (by rw [length_cofVec, length_gramM]) hnul
      have hentry := poly.getAt_unitTail hcof L'.length
      rw [show ground.getAt BPair.unit
          (cofVec (gramM (L' ++ [v])) L'.length) L'.length
        = sgnP (L'.length + L'.length)
          (cof0 ((gramM (L' ++ [v])).eraseIdx L'.length)
            L'.length) from by
        show ground.getAt BPair.unit
            ((List.range (gramM (L' ++ [v])).length).map (fun j =>
              sgnP (L'.length + j)
                (cof0 ((gramM (L' ++ [v])).eraseIdx L'.length)
                  j))) L'.length = _
        rw [ground.getAt_map 0 BPair.unit _
            (List.range (gramM (L' ++ [v])).length) L'.length
            (by rw [ground.length_range]; exact hm),
          ground.getAt_range _ L'.length hm]] at hentry
      exact ihdet (by
        rw [← cof_last_bridge L' v]
        exact sgnP_unit hentry)

/-- Independence's introduction: the shape read beside the
∀-form's own descent, the determinant off the sum's unit at the
last cofactor. -/
theorem indep_intro (n : Nat) (L : Mat) (hLn : rowsLen n L)
    (h : ∀ cs, cs.length = L.length → poly.unitTail (combo n cs L) →
      poly.unitTail cs) :
    indepRows n L :=
  ⟨hLn, indep_det_go L.length n L (Nat.le_refl _) hLn h⟩

/-- The independent family's Gram determinant sits off the sum's
unit, the membership test's clearing scalar. -/
theorem indep_det (n : Nat) (L : Mat) (hind : indepRows n L) :
    ¬ (detL (gramM L)).oneValue BPair.unit := hind.2

/-! The span kit's monotone reads (`lem:lowerspan`'s membership
tier): a listed row sits in the span, and a span member is kept
under a grown list — the combination padded by the sum's unit at
the joined rows. -/

private theorem combo_unitsT (n : Nat) : ∀ (M : Mat) (k : Nat),
    poly.unitTail (combo n (List.replicate k BPair.unit) M)
  | [], 0 => poly.unitTail_replicate n
  | [], _ + 1 => poly.unitTail_replicate n
  | _ :: _, 0 => poly.unitTail_replicate n
  | r :: M, k + 1 =>
    unitTail_vecAdd_of
      (unitTail_vecScale_unit (BPair.oneValue_refl BPair.unit) r)
      (combo_unitsT n M k)

/-- A unit tail drops from a memberwise sum on the left. -/
theorem vecAdd_null_left_le : ∀ (u w : List BPair),
    w.length ≤ u.length → poly.unitTail u →
    poly.oneValue (vecAdd u w) w
  | [], [], _, _ => trivial
  | [], _ :: _, hl, _ => absurd hl (Nat.not_succ_le_zero _)
  | _ :: _, [], _, _ => trivial
  | _ :: u, c :: w, hl, hu =>
    ⟨BPair.oneValue_trans
        (BPair.add_congr hu.1 (BPair.oneValue_refl c))
        (BPair.unit_add c),
     vecAdd_null_left_le u w (Nat.le_of_succ_le_succ hl) hu.2⟩

/-- The matched-width instance of the dropping read. -/
theorem vecAdd_null_left (u w : List BPair)
    (hl : u.length = w.length) (hu : poly.unitTail u) :
    poly.oneValue (vecAdd u w) w :=
  vecAdd_null_left_le u w (Nat.le_of_eq hl.symm) hu

/-- A unit tail drops from a memberwise sum on the right. -/
theorem vecAdd_null_right_le : ∀ (u w : List BPair),
    u.length ≤ w.length → poly.unitTail w →
    poly.oneValue (vecAdd u w) u
  | [], [], _, _ => trivial
  | _ :: _, [], hl, _ => absurd hl (Nat.not_succ_le_zero _)
  | [], _ :: _, _, _ => trivial
  | a :: u, _ :: w, hl, hw =>
    ⟨BPair.oneValue_trans
        (BPair.add_congr (BPair.oneValue_refl a) hw.1)
        (BPair.add_unit a),
     vecAdd_null_right_le u w (Nat.le_of_succ_le_succ hl) hw.2⟩

/-- A memberwise sum against its own swap reads the unit tail,
the balance pairs' own withdrawal per entry. -/
theorem vecAdd_swap_unitTail : ∀ t : List BPair,
    poly.unitTail (vecAdd t (t.map BPair.swap))
  | [] => trivial
  | x :: t =>
    ⟨BPair.oneValue_trans
        (BPair.oneValue_of_eq (BPair.add_comm x x.swap))
        (BPair.swap_add_null (BPair.oneValue_refl x)),
     vecAdd_swap_unitTail t⟩

/-- The matched-width instance of the dropping read. -/
theorem vecAdd_null_right (u w : List BPair)
    (hl : u.length = w.length) (hw : poly.unitTail w) :
    poly.oneValue (vecAdd u w) u :=
  vecAdd_null_right_le u w (Nat.le_of_eq hl) hw

/-- Two families at one width join at that width, at every entry
carrier. -/
private theorem rowsLen_appendO {γ : Type} (n : Nat) :
    ∀ {L M : List (List γ)},
      rowsLen n L → rowsLen n M → rowsLen n (L ++ M)
  | [], _, _, hM => hM
  | _ :: _, _, hL, hM =>
    ⟨hL.1, rowsLen_appendO n hL.2 hM⟩

/-- Two families at one width join at that width. -/
theorem rowsLen_append (n : Nat) : ∀ {L M : Mat},
    rowsLen n L → rowsLen n M → rowsLen n (L ++ M) := by
  intro L M hL hM
  exact rowsLen_appendO n hL hM

/-- The joined family's combination splits at the joined
coefficients: at a coefficient count matching the first family's,
the join's combination is the two combinations' memberwise sum. -/
theorem combo_append (n : Nat) : ∀ (cs : List BPair) (L : Mat)
    (ds : List BPair) (M : Mat), cs.length = L.length →
    rowsLen n L → rowsLen n M →
    poly.oneValue (combo n (cs ++ ds) (L ++ M))
      (vecAdd (combo n cs L) (combo n ds M))
  | [], [], ds, M, _, _, hM => by
    show poly.oneValue (combo n ds M)
      (vecAdd (List.replicate n BPair.unit) (combo n ds M))
    exact poly.oneValue_symm
      (vecAdd_null_left _ _
        (by rw [ground.length_replicate, length_combo n ds M hM])
        (poly.unitTail_replicate n))
  | [], _ :: _, _, _, hl, _, _ => nomatch hl
  | _ :: _, [], _, _, hl, _, _ => nomatch hl
  | c :: cs, r :: L, ds, M, hl, hL, hM => by
    have hA : (vecScale c r).length = n := by
      rw [length_vecScale]; exact hL.1
    have hB : (combo n cs L).length = n := length_combo n cs L hL.2
    have hC : (combo n ds M).length = n := length_combo n ds M hM
    have hBC : (vecAdd (combo n cs L) (combo n ds M)).length = n :=
      length_vecAdd _ _ n hB hC
    have hAB : (vecAdd (vecScale c r) (combo n cs L)).length = n :=
      length_vecAdd _ _ n hA hB
    show poly.oneValue
      (vecAdd (vecScale c r) (combo n (cs ++ ds) (L ++ M)))
      (vecAdd (vecAdd (vecScale c r) (combo n cs L)) (combo n ds M))
    refine poly.oneValue_trans
      (q := vecAdd (vecScale c r)
        (vecAdd (combo n cs L) (combo n ds M))) ?_ ?_
    · exact polyOne_vecAdd _ _ _ _ (polyOne_refl _)
        (combo_append n cs L ds M (Nat.succ.inj hl) hL.2 hM) rfl
        (by rw [length_combo n (cs ++ ds) (L ++ M)
              (rowsLen_append n hL.2 hM), hBC])
    · refine poly.oneValue_of_entries _ _
        (by rw [length_vecAdd _ _ n hA hBC,
          length_vecAdd _ _ n hAB hC]) ?_
      intro i hi
      rw [length_vecAdd _ _ n hA hBC] at hi
      rw [getAt_vecAdd _ _ i (by rw [hA]; exact hi)
          (by rw [hBC]; exact hi),
        getAt_vecAdd _ _ i (by rw [hB]; exact hi)
          (by rw [hC]; exact hi),
        getAt_vecAdd _ _ i (by rw [hAB]; exact hi)
          (by rw [hC]; exact hi),
        getAt_vecAdd _ _ i (by rw [hA]; exact hi)
          (by rw [hB]; exact hi),
        ← BPair.add_assoc]
      exact BPair.oneValue_refl _

private theorem combo_append_units (n : Nat) :
    ∀ (L : Mat) (cs : List BPair), cs.length = L.length →
      rowsLen n L → ∀ M : Mat, rowsLen n M →
      poly.oneValue
        (combo n (cs ++ List.replicate M.length BPair.unit)
          (L ++ M))
        (combo n cs L) :=
  fun L cs hcl hL M hM =>
    poly.oneValue_trans
      (combo_append n cs L (List.replicate M.length BPair.unit) M
        hcl hL hM)
      (vecAdd_null_right _ _
        (by rw [length_combo n cs L hL, length_combo n _ M hM])
        (combo_unitsT n M M.length))

/-- A span member is kept under the grown list, the combination
padded by the sum's unit at the joined rows. -/
private theorem spanE_mono (n : Nat) (L M : Mat) (v : List BPair)
    (hL : rowsLen n L) (hM : rowsLen n M)
    (h : spanRelE n L v) : spanRelE n (L ++ M) v := by
  obtain ⟨c₀, cs, hc₀, hcl, hone⟩ := h
  refine ⟨c₀, cs ++ List.replicate M.length BPair.unit, hc₀, ?_, ?_⟩
  · rw [ground.length_append, ground.length_append, hcl,
      ground.length_replicate]
  · exact poly.oneValue_trans hone
      (poly.oneValue_symm
        (combo_append_units n L cs hcl hL M hM))

/-- A listed row sits in its list's span, the one-member
combination at the natural one's clearing. -/
private theorem spanE_getAt (n : Nat) :
    ∀ (L : Mat) (k : Nat), k < L.length → rowsLen n L →
      spanRelE n L (ground.getAt [] L k)
  | [], k, hk, _ => absurd hk (Nat.not_lt_zero k)
  | r :: L, 0, _, hL => by
    refine ⟨BPair.ofNat 1,
      BPair.ofNat 1 :: List.replicate L.length BPair.unit,
      BPair.ofNat_one_off, ?_, ?_⟩
    · show (List.replicate L.length BPair.unit).length + 1
        = L.length + 1
      rw [ground.length_replicate]
    · show poly.oneValue (vecScale (BPair.ofNat 1) r)
        (vecAdd (vecScale (BPair.ofNat 1) r)
          (combo n (List.replicate L.length BPair.unit) L))
      exact poly.oneValue_symm
        (vecAdd_null_right _ _
          (by
            rw [show (vecScale (BPair.ofNat 1) r).length
                = r.length from ground.length_map _ r, hL.1,
              length_combo n _ L hL.2])
          (combo_unitsT n L L.length))
  | r :: L, k + 1, hk, hL => by
    match spanE_getAt n L k (Nat.lt_of_succ_lt_succ hk) hL.2 with
    | ⟨c₀, cs, hc₀, hcl, hone⟩ =>
      refine ⟨c₀, BPair.unit :: cs, hc₀,
        congrArg Nat.succ hcl, ?_⟩
      show poly.oneValue (vecScale c₀ (ground.getAt [] L k))
        (vecAdd (vecScale BPair.unit r) (combo n cs L))
      exact poly.oneValue_trans hone
        (poly.oneValue_symm (vecAdd_null_left _ _
          (by rw [show (vecScale BPair.unit r).length = r.length from
              ground.length_map _ r, hL.1,
            length_combo n cs L hL.2])
          (unitTail_vecScale_unit
            (BPair.oneValue_refl BPair.unit) r)))

/-! The span's linearity reads: a vector at the unit tail sits in
every span, and two members' join sits in the span at the
clearings multiplied — the combination read through the
coefficients' own scaling and sum. -/

/-- A vector at the unit tail sits in every span, the unit
combination's read. -/
private theorem spanE_null (n : Nat) (L : Mat) (v : List BPair)
    (hu : poly.unitTail v) : spanRelE n L v :=
  ⟨BPair.ofNat 1, List.replicate L.length BPair.unit,
    BPair.ofNat_one_off,
    ground.length_replicate BPair.unit L.length,
    poly.unitTail_oneValue
      (unitTail_vecScale (BPair.ofNat 1) v hu)
      (combo_unitsT n L L.length)⟩

private theorem vecAdd_nil_right : ∀ u : List BPair,
    vecAdd u [] = []
  | [] => rfl
  | _ :: _ => rfl

/-- Scaling by a sum splits into the memberwise sum of the
scalings. -/
theorem vecScale_add (c d : BPair) :
    ∀ r : List BPair,
      vecScale (c + d) r = vecAdd (vecScale c r) (vecScale d r)
  | [] => rfl
  | x :: r => by
    show (c + d) * x :: vecScale (c + d) r
      = (c * x + d * x) :: vecAdd (vecScale c r) (vecScale d r)
    rw [BPair.right_distrib, vecScale_add c d r]

/-- The four summands exchange their middle pair. -/
theorem vecAdd_add_comm : ∀ a b x y : List BPair,
    vecAdd (vecAdd a b) (vecAdd x y)
      = vecAdd (vecAdd a x) (vecAdd b y)
  | [], _, _, _ => rfl
  | a1 :: a, [], x, _ => by
    show ([] : List BPair) = vecAdd (vecAdd (a1 :: a) x) []
    exact (vecAdd_nil_right _).symm
  | a1 :: a, b1 :: b, [], _ => by
    show vecAdd (vecAdd (a1 :: a) (b1 :: b)) [] = []
    exact vecAdd_nil_right _
  | a1 :: a, b1 :: b, x1 :: x, [] => by
    show vecAdd (vecAdd (a1 :: a) (b1 :: b)) []
      = vecAdd (vecAdd (a1 :: a) (x1 :: x)) []
    rw [vecAdd_nil_right (vecAdd (a1 :: a) (b1 :: b)),
      vecAdd_nil_right (vecAdd (a1 :: a) (x1 :: x))]
  | a1 :: a, b1 :: b, x1 :: x, y1 :: y => by
    show (a1 + b1 + (x1 + y1)) :: vecAdd (vecAdd a b) (vecAdd x y)
      = (a1 + x1 + (b1 + y1)) :: vecAdd (vecAdd a x) (vecAdd b y)
    rw [BPair.add_add_comm a1 b1 x1 y1, vecAdd_add_comm a b x y]

/-- The combination is additive in its coefficients: the joined
weights' combination is the two combinations' memberwise sum, at
one coefficient count. -/
theorem combo_vecAdd (n : Nat) :
    ∀ (cs ds : List BPair) (L : Mat), cs.length = ds.length →
      poly.oneValue (combo n (vecAdd cs ds) L)
        (vecAdd (combo n cs L) (combo n ds L))
  | [], [], _, _ =>
    poly.unitTail_oneValue (poly.unitTail_replicate n)
      (unitTail_vecAdd_of (poly.unitTail_replicate n)
        (poly.unitTail_replicate n))
  | [], _ :: _, _, h => nomatch h
  | _ :: _, [], _, h => nomatch h
  | _ :: _, _ :: _, [], _ =>
    poly.unitTail_oneValue (poly.unitTail_replicate n)
      (unitTail_vecAdd_of (poly.unitTail_replicate n)
        (poly.unitTail_replicate n))
  | c :: cs, d :: ds, r :: L, h => by
    show poly.oneValue
      (vecAdd (vecScale (c + d) r) (combo n (vecAdd cs ds) L))
      (vecAdd (vecAdd (vecScale c r) (combo n cs L))
        (vecAdd (vecScale d r) (combo n ds L)))
    rw [vecScale_add c d r,
      ← vecAdd_add_comm (vecScale c r) (vecScale d r)
        (combo n cs L) (combo n ds L)]
    refine polyOne_vecAdd _ _ _ _ (polyOne_refl _)
      (combo_vecAdd n cs ds L (Nat.succ.inj h)) rfl ?_
    rw [length_combo_congr n (vecAdd cs ds) cs L
      (ground.length_zipWith BPair.add cs ds cs.length rfl
        (Nat.succ.inj h).symm)]
    exact (ground.length_zipWith BPair.add (combo n cs L)
      (combo n ds L) (combo n cs L).length rfl
      (length_combo_congr n ds cs L (Nat.succ.inj h).symm)).symm

/-- The span keeps combinations: two members' join sits in the
span, the clearings multiplied. -/
private theorem spanE_add (n : Nat) (L : Mat) (u w : List BPair)
    (hLn : rowsLen n L) (hu : u.length = n) (hw : w.length = n)
    (h1 : spanRelE n L u) (h2 : spanRelE n L w) :
    spanRelE n L (vecAdd u w) := by
  obtain ⟨c₀, cs, hc₀, hcl, hone⟩ := h1
  obtain ⟨c₁, ds, hc₁, hdl, htwo⟩ := h2
  have hcn : (combo n cs L).length = n := length_combo n cs L hLn
  have hdn : (combo n ds L).length = n := length_combo n ds L hLn
  have f1 : (vecScale c₀ u).length = n :=
    (length_vecScale c₀ u).trans hu
  have f2 : (vecScale c₁ w).length = n :=
    (length_vecScale c₁ w).trans hw
  have e1 : (vecScale c₁ (vecScale c₀ u)).length = n :=
    (length_vecScale c₁ _).trans f1
  have e2 : (vecScale c₁ (combo n cs L)).length = n :=
    (length_vecScale c₁ _).trans hcn
  have e3 : (vecScale c₀ (vecScale c₁ w)).length = n :=
    (length_vecScale c₀ _).trans f2
  have e4 : (vecScale c₀ (combo n ds L)).length = n :=
    (length_vecScale c₀ _).trans hdn
  refine ⟨c₀ * c₁, vecAdd (vecScale c₁ cs) (vecScale c₀ ds),
    fun hh => hc₁ (mul_cancel_unit hc₀ hh), ?_, ?_⟩
  · exact length_vecAdd _ _ L.length
      ((length_vecScale c₁ cs).trans hcl)
      ((length_vecScale c₀ ds).trans hdl)
  · have hA : poly.oneValue (vecScale (c₀ * c₁) (vecAdd u w))
        (vecAdd (vecScale c₁ (combo n cs L))
          (vecScale c₀ (combo n ds L))) := by
      rw [vecScale_vecAdd (c₀ * c₁) u w,
        show vecScale (c₀ * c₁) u = vecScale c₁ (vecScale c₀ u)
          from by rw [vecScale_vecScale c₁ c₀ u,
            BPair.mul_comm c₁ c₀],
        show vecScale (c₀ * c₁) w = vecScale c₀ (vecScale c₁ w)
          from by rw [vecScale_vecScale c₀ c₁ w]]
      exact polyOne_vecAdd _ _ _ _
        (vecScale_oneValue c₁ (vecScale c₀ u) (combo n cs L)
          hone)
        (vecScale_oneValue c₀ (vecScale c₁ w) (combo n ds L)
          htwo)
        (e1.trans e2.symm) (e3.trans e4.symm)
    have hB : poly.oneValue
        (vecAdd (vecScale c₁ (combo n cs L))
          (vecScale c₀ (combo n ds L)))
        (vecAdd (combo n (vecScale c₁ cs) L)
          (combo n (vecScale c₀ ds) L)) :=
      polyOne_vecAdd _ _ _ _
        (vecScale_combo c₁ n cs L)
        (vecScale_combo c₀ n ds L)
        (e2.trans
          (length_combo n (vecScale c₁ cs) L hLn).symm)
        (e4.trans
          (length_combo n (vecScale c₀ ds) L hLn).symm)
    exact poly.oneValue_trans hA (poly.oneValue_trans hB
      (poly.oneValue_symm
        (combo_vecAdd n (vecScale c₁ cs) (vecScale c₀ ds) L
          (((length_vecScale c₁ cs).trans hcl).trans
            ((length_vecScale c₀ ds).trans hdl).symm))))

/-- The span keeps a scaled member, the clearing kept. -/
private theorem spanE_scale (n : Nat) (L : Mat) (v : List BPair)
    (c : BPair)
    (h : spanRelE n L v) : spanRelE n L (vecScale c v) := by
  obtain ⟨c₀, cs, hc₀, hcl, hone⟩ := h
  refine ⟨c₀, vecScale c cs, hc₀, ?_, ?_⟩
  · rw [length_vecScale, hcl]
  · refine poly.oneValue_trans ?_ (vecScale_combo c n cs L)
    rw [show vecScale c₀ (vecScale c v)
        = vecScale c (vecScale c₀ v) from by
      rw [vecScale_vecScale c₀ c v, BPair.mul_comm c₀ c,
        ← vecScale_vecScale c c₀ v]]
    exact vecScale_oneValue c _ _ hone

/-- The span reads one value: a member's span read passes to every
vector reading it, the clearing scaled through. -/
private theorem spanE_congr (n : Nat) (L : Mat) (u u' : List BPair)
    (h : poly.oneValue u u') (hs : spanRelE n L u) :
    spanRelE n L u' := by
  obtain ⟨c₀, cs, hc₀, hcl, hone⟩ := hs
  exact ⟨c₀, cs, hc₀, hcl,
    poly.oneValue_trans
      (vecScale_oneValue c₀ u' u (poly.oneValue_symm h)) hone⟩

/-- A combination of rows each inside a span sits in the span, the
fold of the linearity reads. -/
private theorem spanE_combo (n : Nat) (M : Mat) (hM : rowsLen n M) :
    ∀ (K : Mat) (cs : List BPair), rowsLen n K →
      (∀ k, k < K.length → spanRelE n M (ground.getAt [] K k)) →
      spanRelE n M (combo n cs K)
  | [], [], _, _ =>
    spanE_null n M (List.replicate n BPair.unit)
      (poly.unitTail_replicate n)
  | [], _ :: _, _, _ =>
    spanE_null n M (List.replicate n BPair.unit)
      (poly.unitTail_replicate n)
  | _ :: _, [], _, _ =>
    spanE_null n M (List.replicate n BPair.unit)
      (poly.unitTail_replicate n)
  | r :: K', c :: cs, hK, h => by
    show spanRelE n M (vecAdd (vecScale c r) (combo n cs K'))
    exact spanE_add n M _ _ hM
      ((length_vecScale c r).trans hK.1)
      (length_combo n cs K' hK.2)
      (spanE_scale n M r c
        (show spanRelE n M r from h 0 (Nat.succ_pos _)))
      (spanE_combo n M hM K' cs hK.2
        (fun k hk => h (k + 1) (Nat.succ_lt_succ hk)))

/-- A scaled member's span read descends to the member, the
clearings multiplied. -/
private theorem spanE_unscale (n : Nat) (M : Mat) (c : BPair)
    (v : List BPair) (hc : ¬ c.oneValue BPair.unit)
    (h : spanRelE n M (vecScale c v)) : spanRelE n M v := by
  obtain ⟨c₀, ds, hc₀, hdl, hone⟩ := h
  refine ⟨c₀ * c, ds, ?_, hdl, ?_⟩
  · intro hh
    exact hc₀ (mul_cancel_unit hc
      (show (c * c₀).oneValue BPair.unit from by
        rw [BPair.mul_comm c c₀]; exact hh))
  · rw [← vecScale_vecScale c₀ c v]
    exact hone

/-- The span's transitivity: a member of a family's span whose
every row sits in a second family's span sits in that span. -/
private theorem spanE_trans (n : Nat) (G M : Mat)
    (x : List BPair) (hG : rowsLen n G) (hM : rowsLen n M)
    (hrows : ∀ k, k < G.length →
      spanRelE n M (ground.getAt [] G k))
    (h : spanRelE n G x) : spanRelE n M x := by
  obtain ⟨c0, cs, hc0, _, hone⟩ := h
  refine spanE_unscale n M c0 x hc0 ?_
  exact spanE_congr n M _ _ (poly.oneValue_symm hone)
    (spanE_combo n M hM G cs hG hrows)

/-! The entry reads the matrix tiers consume: the skipping fold
against the plain one, and the transpose's positional read. -/

/-- The skipping fold reads the plain one, the unit representatives
entering at the sum's unit. -/
theorem dotN_read : ∀ r c : List BPair,
    (dotN r c).oneValue (dotP r c)
  | [], _ => BPair.oneValue_refl _
  | _ :: _, [] => BPair.oneValue_refl _
  | a :: s, b :: t => by
    show (if a.isUnitRep || b.isUnitRep then dotN s t
        else (a * b + dotN s t).norm).oneValue (a * b + dotP s t)
    cases hab : a.isUnitRep || b.isUnitRep with
    | true =>
      rw [if_pos rfl]
      have habU : (a * b).oneValue BPair.unit := by
        match ground.orSplitB hab with
        | Or.inl ha =>
          rw [BPair.unit_of_isUnitRep ha]
          exact BPair.unit_mul b
        | Or.inr hb =>
          rw [BPair.unit_of_isUnitRep hb]
          exact BPair.mul_unit a
      exact BPair.oneValue_trans (dotN_read s t)
        (BPair.oneValue_symm (BPair.oneValue_trans
          (BPair.add_congr habU (BPair.oneValue_refl (dotP s t)))
          (BPair.unit_add (dotP s t))))
    | false =>
      rw [if_neg (fun hc : (false : Bool) = true =>
        Bool.noConfusion hc)]
      exact BPair.oneValue_trans (BPair.norm_oneValue _)
        (BPair.add_congr (BPair.oneValue_refl (a * b))
          (dotN_read s t))

/-! The entrywise row sum's reads at the two folds: the pairing and
the skipping fold are each additive over the sum of two rows, and
the sum matrix's action is the two actions' own. -/

/-- The pairing is additive over the entrywise row sum. -/
private theorem dotP_addRow (ra rb u : List BPair)
    (ha : ra.length = u.length) (hb : rb.length = u.length) :
    (dotP (vecAdd ra rb) u).oneValue (dotP ra u + dotP rb u) := by
  rw [dotP_comm (vecAdd ra rb) u, dotP_comm ra u, dotP_comm rb u]
  exact dotP_vecAdd u ra rb ha hb

/-- The sum matrix's rowwise pairing map is the two maps' own. -/
theorem matAdd_dotPmap : ∀ (A B : Mat) (u : List BPair),
    rowsLen u.length A → rowsLen u.length B →
    poly.oneValue ((matAdd A B).map (fun r => dotP r u))
      (vecAdd (A.map (fun r => dotP r u)) (B.map (fun r => dotP r u)))
  | [], _, _, _, _ => trivial
  | _ :: _, [], _, _, _ => trivial
  | ra :: ta, rb :: tb, u, hA, hB =>
    ⟨dotP_addRow ra rb u hA.1 hB.1, matAdd_dotPmap ta tb u hA.2 hB.2⟩

/-- The skipping fold is additive over the entrywise row sum. -/
theorem dotN_addRow_free (ra rb u : List BPair)
    (h : ra.length = rb.length) :
    (dotN (vecAdd ra rb) u).oneValue (dotN ra u + dotN rb u) := by
  refine BPair.oneValue_trans (dotN_read (vecAdd ra rb) u) ?_
  rw [dotP_comm (vecAdd ra rb) u]
  refine BPair.oneValue_trans (dotP_vecAdd_right u ra rb h) ?_
  rw [dotP_comm u ra, dotP_comm u rb]
  exact BPair.add_congr (BPair.oneValue_symm (dotN_read ra u))
    (BPair.oneValue_symm (dotN_read rb u))

/-- The summed rows' fold at the argument's width, the general's
shape wrapper. -/
theorem dotN_addRow (ra rb u : List BPair)
    (ha : ra.length = u.length) (hb : rb.length = u.length) :
    (dotN (vecAdd ra rb) u).oneValue (dotN ra u + dotN rb u) :=
  dotN_addRow_free ra rb u (ha.trans hb.symm)

/-- The sum matrix's action is the two actions' own, at matched
row widths and every argument. -/
theorem matVec_add_free (w : Nat) : ∀ (A B : Mat) (u : List BPair),
    rowsLen w A → rowsLen w B →
    poly.oneValue (matVec (matAdd A B) u)
      (vecAdd (matVec A u) (matVec B u))
  | [], _, _, _, _ => trivial
  | _ :: _, [], _, _, _ => trivial
  | ra :: ta, rb :: tb, u, hA, hB =>
    ⟨dotN_addRow_free ra rb u (hA.1.trans hB.1.symm),
     matVec_add_free w ta tb u hA.2 hB.2⟩

/-- The sum matrix's action at the argument's width, the general's
shape wrapper. -/
theorem matVec_add (A B : Mat) (u : List BPair)
    (hA : rowsLen u.length A) (hB : rowsLen u.length B) :
    poly.oneValue (matVec (matAdd A B) u)
      (vecAdd (matVec A u) (matVec B u)) :=
  matVec_add_free u.length A B u hA hB

/-- The scaled row's fold carries the scale out, at every
argument. -/
theorem dotN_scaleRow_free (c : BPair) (a x : List BPair) :
    (dotN (vecScale c a) x).oneValue (c * dotN a x) := by
  refine BPair.oneValue_trans (dotN_read (vecScale c a) x) ?_
  rw [dotP_comm (vecScale c a) x]
  refine BPair.oneValue_trans (dotP_vecScale_right x a c) ?_
  rw [dotP_comm x a]
  exact BPair.mul_congr (BPair.oneValue_refl c)
    (BPair.oneValue_symm (dotN_read a x))

/-- The scaled vector's fold carries the scale out, at every
row. -/
theorem dotN_scaleV (c : BPair) (r u : List BPair) :
    (dotN r (vecScale c u)).oneValue (c * dotN r u) :=
  BPair.oneValue_trans (dotN_read r (vecScale c u))
    (BPair.oneValue_trans (dotP_vecScale_right r u c)
      (BPair.mul_congr (BPair.oneValue_refl c)
        (BPair.oneValue_symm (dotN_read r u))))

/-- A cleared vector's self-pairing is the clearing's square against
the vector's own. -/
theorem dotN_vecScale_self (k : BPair) (v : List BPair) :
    (dotN (vecScale k v) (vecScale k v)).oneValue (k * k * dotN v v) := by
  rw [BPair.mul_assoc k k (dotN v v)]
  exact BPair.oneValue_trans (dotN_scaleRow_free k v (vecScale k v))
    (BPair.mul_congr (BPair.oneValue_refl k) (dotN_scaleV k v v))

/-! The transpose at the parametrized tier (`def:elim`'s
determinant against the exchanged key lists): the landed family's
arms at the bundle's unit with their balance-pair bridges, the
flipped assignment's own reads, and the determinant's transpose
theorem, the enumeration reindexed along the flip. -/

private theorem length_transposeGoO {γ : Type} (ops : DOps γ) :
    ∀ (n : Nat) (m : List (List γ)),
      (transposeGoO ops n m).length = n
  | 0, _ => rfl
  | n + 1, m =>
    congrArg Nat.succ (length_transposeGoO ops n (dropCol m))

private theorem length_transposeO {γ : Type} (ops : DOps γ)
    {n : Nat} : ∀ m : List (List γ), rowsLen n m →
      0 < m.length → (transposeO ops m).length = n
  | [], _, h => absurd h (Nat.lt_irrefl 0)
  | r :: t, hrows, _ => by
    show (transposeGoO ops r.length (r :: t)).length = n
    rw [length_transposeGoO ops r.length (r :: t), hrows.1]

private theorem getAt_transposeGoO {γ : Type} (ops : DOps γ)
    (u : γ) :
    ∀ (n : Nat) (m : List (List γ)) (p q : Nat), p < n →
      q < m.length →
      (∀ i, i < m.length → n ≤ (ground.getAt [] m i).length) →
      ground.getAt u
          (ground.getAt [] (transposeGoO ops n m) p) q
        = ground.getAt u (ground.getAt [] m q) p
  | n + 1, m, 0, q, _, hq, hlen => by
    show ground.getAt u (colHead ops.unit m) q = _
    rw [show colHead ops.unit m
        = m.map (fun r => ground.getAt ops.unit r 0) from rfl,
      ground.getAt_map [] u _ m q hq]
    match hrow : ground.getAt [] m q with
    | [] =>
      have := hlen q hq
      rw [hrow] at this
      exact absurd this (Nat.not_succ_le_zero n)
    | a :: t => rfl
  | n + 1, m, p + 1, q, hp, hq, hlen => by
    show ground.getAt u
        (ground.getAt [] (transposeGoO ops n (dropCol m)) p) q = _
    have hqt : q < (dropCol m).length := by
      rw [length_dropCol m]
      exact hq
    have hlent : ∀ i, i < (dropCol m).length →
        n ≤ (ground.getAt [] (dropCol m) i).length := by
      intro i hi
      rw [length_dropCol m] at hi
      rw [getAt_dropCol m i hi]
      match hrow : ground.getAt [] m i with
      | [] =>
        have := hlen i hi
        rw [hrow] at this
        exact absurd this (Nat.not_succ_le_zero n)
      | a :: t =>
        have := hlen i hi
        rw [hrow] at this
        exact Nat.le_of_succ_le_succ this
    rw [getAt_transposeGoO ops u n (dropCol m) p q
        (Nat.lt_of_succ_lt_succ hp) hqt hlent,
      getAt_dropCol m q hq]
    match hrow : ground.getAt [] m q with
    | [] =>
      have := hlen q hq
      rw [hrow] at this
      exact absurd this (Nat.not_succ_le_zero n)
    | a :: t => rfl

private theorem getAt_transposeO {γ : Type} (ops : DOps γ)
    (u : γ) {n : Nat} :
    ∀ (m : List (List γ)), rowsLen n m → ∀ p q, p < n →
      q < m.length →
      ground.getAt u (ground.getAt [] (transposeO ops m) p) q
        = ground.getAt u (ground.getAt [] m q) p
  | [], _, _, q, _, hq => absurd hq (Nat.not_lt_zero q)
  | r :: t, hrows, p, q, hp, hq => by
    show ground.getAt u
        (ground.getAt [] (transposeGoO ops r.length (r :: t)) p) q
      = _
    rw [hrows.1]
    exact getAt_transposeGoO ops u n (r :: t) p q hp hq
      (fun i hi => by
        rw [rowsLen_getAt (r :: t) i hrows hi]
        exact Nat.le_refl n)

/-- The transpose's rows carry the source's own row count. -/
private theorem rowsLen_transposeGoO {γ : Type} (ops : DOps γ) :
    ∀ (k : Nat) (m : List (List γ)),
    rowsLen m.length (transposeGoO ops k m)
  | 0, _ => trivial
  | k + 1, m => by
    show (colHead ops.unit m).length = m.length
      ∧ rowsLen m.length (transposeGoO ops k (dropCol m))
    refine ⟨length_colHead ops.unit m, ?_⟩
    have hgo := rowsLen_transposeGoO ops k (dropCol m)
    rw [length_dropCol m] at hgo
    exact hgo

/-- The transpose's rows, at every source. -/
private theorem rowsLen_transposeO {γ : Type} (ops : DOps γ) :
    ∀ m : List (List γ), rowsLen m.length (transposeO ops m)
  | [] => trivial
  | r :: t => by
    show rowsLen (r :: t).length (transposeGoO ops r.length (r :: t))
    exact rowsLen_transposeGoO ops r.length (r :: t)

/-- The transpose's row count is the stated width, at an occupied
matrix. -/
theorem length_transposeM {n : Nat} (m : Mat) (hrows : rowsLen n m)
    (h : 0 < m.length) : (transposeM m).length = n :=
  length_transposeO bpairOps m hrows h

/-- The transpose's entry read: the row and column keys exchange,
at stated rectangular shape. -/
theorem getAt_transposeM (u : BPair) {n : Nat} (m : Mat)
    (hrows : rowsLen n m) (p q : Nat) (hp : p < n)
    (hq : q < m.length) :
    ground.getAt u (ground.getAt [] (transposeM m) p) q
      = ground.getAt u (ground.getAt [] m q) p :=
  getAt_transposeO bpairOps u m hrows p q hp hq

private theorem detO_transpose {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ}
    (C : DCore γ ops R.rel) (m : List (List γ))
    (hsq : rowsLen m.length m) :
    R.rel (detO ops (transposeO ops m)) (detO ops m) := by
  cases m with
  | nil => exact C.ovRefl _
  | cons r t =>
    have htl : (transposeO ops (r :: t)).length = (r :: t).length :=
      length_transposeO ops (r :: t) hsq (Nat.succ_pos _)
    have hterm : ∀ p : List Nat,
        0 < ground.countOf p (places.monomialsAt
          (List.replicate (r :: t).length 1)) →
        R.rel (termO ops (transposeO ops (r :: t)) p)
          (termO ops (r :: t)
            (places.invPerm (r :: t).length p)) := by
      intro p hp
      obtain ⟨hplen, hpdist, hpval, hpocc⟩ :=
        places.perm_member_reads hp
      rw [termO_fold ops (transposeO ops (r :: t)) p
          (by rw [htl, hplen]),
        termO_fold ops (r :: t) (places.invPerm (r :: t).length p)
          (by rw [places.length_invPerm]),
        htl]
      refine ground.famFold_bij_ov (commLawsMulOf C) ops.one _
        (fun s => ground.getAt ops.unit
          (ground.getAt [] (r :: t) s)
          (ground.getAt 0 (places.invPerm (r :: t).length p) s))
        (ground.distinctList_range (r :: t).length)
        (g := ground.getAt 0 p) (h := fun x => places.posOf x p)
        (fun x hx => places.posOf_getAt hpdist x
          (by rw [hplen]; exact ground.ltOfMem hx))
        (fun x hx => places.getAt_posOf x p
          (hpocc x (ground.ltOfMem hx)))
        (fun x hx => ground.countOf_range_pos (hpval _
          (ground.countOf_getAt_pos 0 p x
            (by rw [hplen]; exact ground.ltOfMem hx))))
        (fun x hx => ground.countOf_range_pos (by
          have hlt := places.posOf_lt x p
            (hpocc x (ground.ltOfMem hx))
          rw [hplen] at hlt
          exact hlt))
        (fun s hs => ?_)
      have hsn : s < (r :: t).length := ground.ltOfMem hs
      have hps : ground.getAt 0 p s < (r :: t).length :=
        hpval _ (ground.countOf_getAt_pos 0 p s
          (by rw [hplen]; exact hsn))
      rw [show ground.getAt 0
            (places.invPerm (r :: t).length p)
            (ground.getAt 0 p s) = s from by
          rw [places.getAt_invPerm (r :: t).length p hps,
            places.posOf_getAt hpdist s
              (by rw [hplen]; exact hsn)],
        getAt_transposeO ops ops.unit (r :: t) hsq s
          (ground.getAt 0 p s) hsn hps]
      exact C.ovRefl _
    show R.rel (ground.famFold ops.add ops.unit
        (fun p => sgnO ops p
          (termO ops (transposeO ops (r :: t)) p))
        (places.monomialsAt (List.replicate
          (transposeO ops (r :: t)).length 1)))
      (ground.famFold ops.add ops.unit
        (fun p => sgnO ops p (termO ops (r :: t) p))
        (places.monomialsAt (List.replicate (r :: t).length 1)))
    rw [htl]
    refine ground.famFold_bij_ov (commLawsOf C) ops.unit _
      (fun p => sgnO ops p (termO ops (r :: t) p))
      (places.monomialsAt_distinct
        (List.replicate (r :: t).length 1))
      (g := places.invPerm (r :: t).length)
      (h := places.invPerm (r :: t).length)
      (fun p hp => places.invPerm_invPerm (r :: t).length hp)
      (fun p hp => places.invPerm_invPerm (r :: t).length hp)
      (fun p hp => places.invPerm_member (r :: t).length hp)
      (fun p hp => places.invPerm_member (r :: t).length hp)
      (fun p hp => ?_)
    refine C.ovTrans (sgnO_congr C p (hterm p hp)) ?_
    show R.rel (if places.parity p
        then ops.swap (termO ops (r :: t)
          (places.invPerm (r :: t).length p))
        else termO ops (r :: t)
          (places.invPerm (r :: t).length p))
      (sgnO ops (places.invPerm (r :: t).length p)
        (termO ops (r :: t) (places.invPerm (r :: t).length p)))
    rw [← places.parity_invPerm (r :: t).length hp]
    exact C.ovRefl _

/-- The exchanged key lists read one determinant: at a square
matrix the permutation fold pairs each assignment against its
flip, the exchanged entries the term's own factors at the flipped
places and the two gradings equal. -/
theorem detL_transpose (m : Mat) (hsq : rowsLen m.length m) :
    detL (transposeM m) = detL m :=
  detO_transpose (R := bpairEqRead) bpairEqCore m hsq

/-! `def:elim`'s shifted determinant tier: the polynomial carrier
enters the parametrized determinant bundle as its own operations,
the variable joining the diagonal over the balance-pair entries,
and the bordered list's determinant is monic of degree the row
count — the identity assignment's product reading the top at the
unit, every further assignment two degrees below. -/

/-! The polynomial carrier's relation and laws over the bundle:
the componentwise one-value relation with its unit tails at
`poly.polyO`'s lists (`def:poly`'s displayed reads at any entry
bundle, `def:elim`'s Sylvester sentence's own object "over the
balance-pair polynomials, a carrier with the displayed reads"),
and the law lift handing every instance its `DLaws` at once — the
lift iterating, one `DLaws` per level of the carrier tower. -/

/-! The list read's equivalence kit at the bundle's laws, the
generic read (`poly.listOV`) at an entry read `R`. -/

private theorem lovRefl {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) :
    ∀ p : List γ, poly.listOV ops R p p
  | [] => trivial
  | c :: p => ⟨C.ovRefl c, lovRefl C p⟩

private theorem lovSymm {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) :
    ∀ {p q : List γ}, poly.listOV ops R p q → poly.listOV ops R q p
  | [], [], h => h
  | [], _ :: _, h => h
  | _ :: _, [], h => h
  | _ :: _, _ :: _, h => ⟨C.ovSymm h.1, lovSymm C h.2⟩

private theorem utOv {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) :
    ∀ {p q : List γ}, poly.unitTailO ops R p → poly.unitTailO ops R q →
      poly.listOV ops R p q
  | [], _, _, hq => hq
  | _ :: _, [], hp, _ => hp
  | _ :: _, _ :: _, hp, hq =>
    ⟨C.ovTrans hp.1 (C.ovSymm hq.1), utOv C hp.2 hq.2⟩

private theorem ovUt {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) :
    ∀ {p q : List γ}, poly.listOV ops R p q → poly.unitTailO ops R q →
      poly.unitTailO ops R p
  | [], _, _, _ => trivial
  | _ :: _, [], h, _ => h
  | _ :: _, _ :: _, h, hq =>
    ⟨C.ovTrans h.1 hq.1, ovUt C h.2 hq.2⟩

private theorem utOvR {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) :
    ∀ {q r : List γ}, poly.unitTailO ops R q → poly.listOV ops R q r →
      poly.unitTailO ops R r
  | [], _, _, h => h
  | _ :: _, [], _, _ => trivial
  | _ :: _, _ :: _, hq, h =>
    ⟨C.ovTrans (C.ovSymm h.1) hq.1, utOvR C hq.2 h.2⟩

private theorem lovTrans {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) :
    ∀ {p q r : List γ}, poly.listOV ops R p q → poly.listOV ops R q r →
      poly.listOV ops R p r
  | [], _, _, h1, h2 => utOvR C h1 h2
  | _ :: _, [], _, h1, h2 => utOv C h1 h2
  | _ :: _, _ :: _, [], h1, h2 => ovUt C h1 h2
  | _ :: _, _ :: _, _ :: _, h1, h2 =>
    ⟨C.ovTrans h1.1 h2.1, lovTrans C h1.2 h2.2⟩

/-! The key reads at the lifted carrier: the entries at their
keys, the sum and the scale reading through them. -/

private theorem utGetAt {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) :
    ∀ {p : List γ}, poly.unitTailO ops R p → ∀ k : Nat,
      R.rel (ground.getAt ops.unit p k) ops.unit
  | [], _, _ => C.ovRefl ops.unit
  | _ :: _, h, 0 => h.1
  | _ :: p, h, k + 1 => utGetAt C (p := p) h.2 k

private theorem utOfGetAt {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} :
    ∀ {p : List γ},
      (∀ k : Nat, R.rel (ground.getAt ops.unit p k) ops.unit) →
      poly.unitTailO ops R p
  | [], _ => trivial
  | _ :: _, h => ⟨h 0, utOfGetAt (fun k => h (k + 1))⟩

private theorem lovGetAt {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) :
    ∀ {p q : List γ}, poly.listOV ops R p q → ∀ k : Nat,
      R.rel (ground.getAt ops.unit p k) (ground.getAt ops.unit q k)
  | [], _, h, k => C.ovSymm (utGetAt C h k)
  | c :: p, [], h, k => utGetAt C (p := c :: p) ⟨h.1, h.2⟩ k
  | _ :: _, _ :: _, h, 0 => h.1
  | _ :: p, _ :: q, h, k + 1 => lovGetAt C (p := p) (q := q) h.2 k

private theorem lovOfGetAt {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) :
    ∀ {p q : List γ},
      (∀ k : Nat,
        R.rel (ground.getAt ops.unit p k) (ground.getAt ops.unit q k)) →
      poly.listOV ops R p q
  | [], _, h => utOfGetAt (fun k => C.ovSymm (h k))
  | _ :: _, [], h => utOfGetAt h
  | _ :: _, _ :: _, h => ⟨h 0, lovOfGetAt C (fun k => h (k + 1))⟩

private theorem getAtAddO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ∀ (p q : List γ) (k : Nat),
      R.rel (ground.getAt ops.unit (poly.addLO ops p q) k)
        (ops.add (ground.getAt ops.unit p k)
          (ground.getAt ops.unit q k)) :=
  poly.getAt_addLO ops R L.toDCore.ovRefl L.toDCore.ovSymm L.unitAdd L.addUnit

private theorem getAtScaleO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) (c : γ) :
    ∀ (l : List γ) (k : Nat),
      R.rel (ground.getAt ops.unit (l.map (ops.mul c)) k)
        (ops.mul c (ground.getAt ops.unit l k)) :=
  poly.getAt_mapMul ops R L.toDCore.ovRefl L.toDCore.ovSymm L.mulUnit c

/-! The componentwise sum's algebra at the lifted carrier. -/

private theorem addCongrO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    {p q p' q' : List γ} (h1 : poly.listOV ops R p p')
    (h2 : poly.listOV ops R q q') :
    poly.listOV ops R (poly.addLO ops p q) (poly.addLO ops p' q') :=
  lovOfGetAt L.toDCore (fun k =>
    L.toDCore.ovTrans (getAtAddO L p q k)
      (L.toDCore.ovTrans
        (L.toDCore.addCongr (lovGetAt L.toDCore h1 k)
          (lovGetAt L.toDCore h2 k))
        (L.toDCore.ovSymm (getAtAddO L p' q' k))))

private theorem addCommO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (p q : List γ) :
    poly.listOV ops R (poly.addLO ops p q) (poly.addLO ops q p) :=
  lovOfGetAt L.toDCore (fun k =>
    L.toDCore.ovTrans (getAtAddO L p q k)
      (L.toDCore.ovTrans (L.toDCore.addComm _ _)
        (L.toDCore.ovSymm (getAtAddO L q p k))))

private theorem addAssocO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (p q r : List γ) :
    poly.listOV ops R (poly.addLO ops (poly.addLO ops p q) r)
      (poly.addLO ops p (poly.addLO ops q r)) :=
  lovOfGetAt L.toDCore (fun k =>
    L.toDCore.ovTrans (getAtAddO L (poly.addLO ops p q) r k)
      (L.toDCore.ovTrans
        (L.toDCore.addCongr (getAtAddO L p q k) (L.toDCore.ovRefl _))
        (L.toDCore.ovTrans (L.toDCore.addAssoc _ _ _)
          (L.toDCore.ovTrans
            (L.toDCore.addCongr (L.toDCore.ovRefl _)
              (L.toDCore.ovSymm (getAtAddO L q r k)))
            (L.toDCore.ovSymm (getAtAddO L p (poly.addLO ops q r) k))))))

private theorem addShuffleO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (a b c d : List γ) :
    poly.listOV ops R (poly.addLO ops (poly.addLO ops a b) (poly.addLO ops c d))
      (poly.addLO ops (poly.addLO ops a c) (poly.addLO ops b d)) :=
  lovOfGetAt L.toDCore (fun k =>
    L.toDCore.ovTrans (getAtAddO L (poly.addLO ops a b) (poly.addLO ops c d) k)
      (L.toDCore.ovTrans
        (L.toDCore.addCongr (getAtAddO L a b k) (getAtAddO L c d k))
        (L.toDCore.ovTrans (ground.opExchO (commLawsOf L.toDCore) _ _ _ _)
          (L.toDCore.ovTrans
            (L.toDCore.addCongr
              (L.toDCore.ovSymm (getAtAddO L a c k))
              (L.toDCore.ovSymm (getAtAddO L b d k)))
            (L.toDCore.ovSymm
              (getAtAddO L (poly.addLO ops a c) (poly.addLO ops b d) k))))))

private theorem utAddLovO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    {p : List γ} (h : poly.unitTailO ops R p) (q : List γ) :
    poly.listOV ops R (poly.addLO ops p q) q :=
  lovOfGetAt L.toDCore (fun k =>
    L.toDCore.ovTrans (getAtAddO L p q k)
      (L.toDCore.ovTrans
        (L.toDCore.addCongr (utGetAt L.toDCore h k)
          (L.toDCore.ovRefl _))
        (L.unitAdd _)))

/-! The scale and the convolution at the lifted carrier. -/

private theorem ovMapO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (f g : γ → γ) :
    ∀ l : List γ, (∀ a, R.rel (f a) (g a)) →
      poly.listOV ops R (l.map f) (l.map g)
  | [], _ => trivial
  | a :: t, h => ⟨h a, ovMapO f g t h⟩

/-- A map reading its argument back entrywise reads the list back
whole. -/
private theorem mapSelfLov {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (f : γ → γ)
    (hf : ∀ x, R.rel (f x) x) :
    ∀ p : List γ, poly.listOV ops R (p.map f) p
  | [] => trivial
  | c :: p => ⟨hf c, mapSelfLov f hf p⟩

private theorem utSwapO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) :
    ∀ {p : List γ}, poly.unitTailO ops R p →
      poly.unitTailO ops R (p.map ops.swap)
  | [], _ => trivial
  | _ :: _, h =>
    ⟨C.ovTrans (C.swapCongr h.1) C.swapUnit, utSwapO C h.2⟩

private theorem utScaleO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) {a : γ}
    (h : R.rel a ops.unit) :
    ∀ l : List γ, poly.unitTailO ops R (l.map (ops.mul a))
  | [] => trivial
  | c :: l =>
    ⟨L.toDCore.ovTrans
      (L.toDCore.mulCongr h (L.toDCore.ovRefl c))
      (mulUnitLeftO L c),
     utScaleO L h l⟩

private theorem scaleCongrO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) (c : γ)
    {q q' : List γ} (h : poly.listOV ops R q q') :
    poly.listOV ops R (q.map (ops.mul c)) (q'.map (ops.mul c)) :=
  lovOfGetAt L.toDCore (fun k =>
    L.toDCore.ovTrans (getAtScaleO L c q k)
      (L.toDCore.ovTrans
        (L.toDCore.mulCongr (L.toDCore.ovRefl c)
          (lovGetAt L.toDCore h k))
        (L.toDCore.ovSymm (getAtScaleO L c q' k))))

private theorem mulNilO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) :
    ∀ p : List γ, poly.unitTailO ops R (poly.mulLO ops p [])
  | [] => trivial
  | _ :: p => ⟨C.ovRefl _, mulNilO C p⟩

private theorem mulCongrO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ∀ (p : List γ) {q q' : List γ}, poly.listOV ops R q q' →
      poly.listOV ops R (poly.mulLO ops p q) (poly.mulLO ops p q')
  | [], _, _, _ => trivial
  | c :: p, _, _, h =>
    addCongrO L (scaleCongrO L c h)
      ⟨L.toDCore.ovRefl _, mulCongrO L p h⟩

private theorem consOvO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} {c d : γ} (h1 : R.rel c d)
    {p q : List γ} (h2 : poly.listOV ops R p q) :
    poly.listOV ops R (c :: p) (d :: q) := ⟨h1, h2⟩

private theorem consAddO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) (x y : List γ) :
    poly.listOV ops R (ops.unit :: poly.addLO ops x y)
      (poly.addLO ops (ops.unit :: x) (ops.unit :: y)) :=
  ⟨L.toDCore.ovSymm (L.addUnit ops.unit), lovRefl L.toDCore _⟩

private theorem mapSumO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) (c : γ) :
    ∀ q r : List γ,
      poly.listOV ops R ((poly.addLO ops q r).map (ops.mul c))
        (poly.addLO ops (q.map (ops.mul c)) (r.map (ops.mul c)))
  | [], _ => lovRefl L.toDCore _
  | _ :: _, [] => lovRefl L.toDCore _
  | a :: q, b :: r =>
    ⟨L.toDCore.leftDistrib c a b, mapSumO L c q r⟩

private theorem scaleAddO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) (c d : γ) :
    ∀ r : List γ,
      poly.listOV ops R (r.map (ops.mul (ops.add c d)))
        (poly.addLO ops (r.map (ops.mul c)) (r.map (ops.mul d)))
  | [] => trivial
  | x :: r =>
    ⟨L.toDCore.ovTrans (L.toDCore.mulComm (ops.add c d) x)
      (L.toDCore.ovTrans (L.toDCore.leftDistrib x c d)
        (L.toDCore.addCongr (L.toDCore.mulComm x c)
          (L.toDCore.mulComm x d))),
     scaleAddO L c d r⟩

private theorem mulSumO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ∀ p q r : List γ,
      poly.listOV ops R (poly.mulLO ops p (poly.addLO ops q r))
        (poly.addLO ops (poly.mulLO ops p q) (poly.mulLO ops p r))
  | [], _, _ => trivial
  | c :: p, q, r =>
    lovTrans L.toDCore
      (addCongrO L (mapSumO L c q r)
        (lovTrans L.toDCore
          (consOvO (L.toDCore.ovRefl ops.unit) (mulSumO L p q r))
          (consAddO L (poly.mulLO ops p q) (poly.mulLO ops p r))))
      (addShuffleO L _ _ _ _)

private theorem sumMulO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ∀ p q r : List γ,
      poly.listOV ops R (poly.mulLO ops (poly.addLO ops p q) r)
        (poly.addLO ops (poly.mulLO ops p r) (poly.mulLO ops q r))
  | [], _, _ => lovRefl L.toDCore _
  | c :: p, [], r => by
    show poly.listOV ops R (poly.mulLO ops (c :: p) r)
      (poly.addLO ops (poly.mulLO ops (c :: p) r) [])
    rw [poly.addNilO ops (poly.mulLO ops (c :: p) r)]
    exact lovRefl L.toDCore _
  | c :: p, d :: q, r =>
    lovTrans L.toDCore
      (addCongrO L (scaleAddO L c d r)
        (lovTrans L.toDCore
          (consOvO (L.toDCore.ovRefl ops.unit) (sumMulO L p q r))
          (consAddO L (poly.mulLO ops p r) (poly.mulLO ops q r))))
      (addShuffleO L _ _ _ _)

private theorem mulSingleO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ∀ (p : List γ) (a : γ),
      poly.listOV ops R (poly.mulLO ops p [a]) (p.map (fun d => ops.mul a d))
  | [], _ => trivial
  | c :: p, a =>
    ⟨L.toDCore.ovTrans (L.addUnit (ops.mul c a))
      (L.toDCore.mulComm c a), mulSingleO L p a⟩

private theorem mulShift1O {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ∀ (q p : List γ),
      poly.listOV ops R (poly.mulLO ops q (ops.unit :: p))
        (ops.unit :: poly.mulLO ops q p)
  | [], _ => ⟨L.toDCore.ovRefl ops.unit, trivial⟩
  | c :: q, p =>
    ⟨L.toDCore.ovTrans
      (L.toDCore.addCongr (L.mulUnit c) (L.toDCore.ovRefl ops.unit))
      (L.unitAdd ops.unit),
     addCongrO L (lovRefl L.toDCore (p.map (ops.mul c)))
       (mulShift1O L q p)⟩

private theorem mulConsO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (q : List γ) (c : γ) (p : List γ) :
    poly.listOV ops R (poly.mulLO ops q (c :: p))
      (poly.addLO ops (q.map (ops.mul c)) (ops.unit :: poly.mulLO ops q p)) :=
  lovTrans L.toDCore
    (mulCongrO L q
      (show poly.listOV ops R (c :: p) (poly.addLO ops [c] (ops.unit :: p)) from
        ⟨L.toDCore.ovSymm (L.addUnit c), lovRefl L.toDCore p⟩))
    (lovTrans L.toDCore (mulSumO L q [c] (ops.unit :: p))
      (addCongrO L (mulSingleO L q c) (mulShift1O L q p)))

private theorem mulCommO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ∀ p q : List γ, poly.listOV ops R (poly.mulLO ops p q) (poly.mulLO ops q p)
  | [], q => mulNilO L.toDCore q
  | c :: p, q =>
    lovSymm L.toDCore
      (lovTrans L.toDCore (mulConsO L q c p)
        (addCongrO L (lovRefl L.toDCore _)
          (consOvO (L.toDCore.ovRefl _)
            (lovSymm L.toDCore (mulCommO L p q)))))

private theorem mulCongrLeftO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    {p p' : List γ} (h : poly.listOV ops R p p') (q : List γ) :
    poly.listOV ops R (poly.mulLO ops p q) (poly.mulLO ops p' q) :=
  lovTrans L.toDCore (mulCommO L p q)
    (lovTrans L.toDCore (mulCongrO L q h) (mulCommO L q p'))

private theorem scaleMulO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) (c : γ) :
    ∀ q r : List γ,
      poly.listOV ops R (poly.mulLO ops (q.map (ops.mul c)) r)
        ((poly.mulLO ops q r).map (ops.mul c))
  | [], _ => trivial
  | a :: q, r =>
    lovTrans L.toDCore
      (addCongrO L
        (show poly.listOV ops R (r.map (ops.mul (ops.mul c a)))
            ((r.map (ops.mul a)).map (ops.mul c)) from by
          rw [ground.map_map (ops.mul a) (ops.mul c) r]
          exact ovMapO _ _ r (fun x => L.toDCore.mulAssoc c a x))
        (consOvO (L.toDCore.ovSymm (L.mulUnit c))
          (scaleMulO L c q r)))
      (lovSymm L.toDCore
        (mapSumO L c (r.map (ops.mul a)) (ops.unit :: poly.mulLO ops q r)))

private theorem mulAssocO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ∀ p q r : List γ,
      poly.listOV ops R (poly.mulLO ops (poly.mulLO ops p q) r)
        (poly.mulLO ops p (poly.mulLO ops q r))
  | [], _, _ => trivial
  | c :: p, q, r =>
    lovTrans L.toDCore
      (sumMulO L (q.map (ops.mul c)) (ops.unit :: poly.mulLO ops p q) r)
      (addCongrO L (scaleMulO L c q r)
        (lovTrans L.toDCore
          (utAddLovO L
            (utScaleO L (L.toDCore.ovRefl ops.unit) r)
            (ops.unit :: poly.mulLO ops (poly.mulLO ops p q) r))
          (consOvO (L.toDCore.ovRefl ops.unit) (mulAssocO L p q r))))

/-! The lift's negation and unit laws. -/

private theorem negSumO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) :
    ∀ p q : List γ,
      poly.listOV ops R ((poly.addLO ops p q).map ops.swap)
        (poly.addLO ops (p.map ops.swap) (q.map ops.swap))
  | [], _ => lovRefl C _
  | _ :: _, [] => lovRefl C _
  | c :: p, d :: q => ⟨C.swapAdd c d, negSumO C p q⟩

private theorem negNegO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) :
    ∀ p : List γ, poly.listOV ops R ((p.map ops.swap).map ops.swap) p
  | [] => trivial
  | c :: p => ⟨C.swapSwap c, negNegO C p⟩

private theorem negCongrO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) :
    ∀ {p q : List γ}, poly.listOV ops R p q →
      poly.listOV ops R (p.map ops.swap) (q.map ops.swap)
  | [], [], _ => trivial
  | [], _ :: _, h =>
    ⟨C.ovTrans (C.swapCongr h.1) C.swapUnit, utSwapO C h.2⟩
  | _ :: _, [], h =>
    ⟨C.ovTrans (C.swapCongr h.1) C.swapUnit, utSwapO C h.2⟩
  | _ :: _, _ :: _, h => ⟨C.swapCongr h.1, negCongrO C h.2⟩

private theorem mulSwapRightO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ∀ x y : List γ,
      poly.listOV ops R (poly.mulLO ops x (y.map ops.swap))
        ((poly.mulLO ops x y).map ops.swap)
  | [], _ => trivial
  | c :: x, y =>
    lovTrans L.toDCore
      (addCongrO L
        (show poly.listOV ops R ((y.map ops.swap).map (ops.mul c))
            ((y.map (ops.mul c)).map ops.swap) from by
          rw [ground.map_map ops.swap (ops.mul c) y,
            ground.map_map (ops.mul c) ops.swap y]
          exact ovMapO _ _ y (fun a => L.toDCore.mulSwapRight c a))
        (consOvO (L.toDCore.ovSymm L.toDCore.swapUnit)
          (mulSwapRightO L x y)))
      (lovSymm L.toDCore (negSumO L.toDCore (y.map (ops.mul c))
        (ops.unit :: poly.mulLO ops x y)))

private theorem utNegReadO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ∀ {p : List γ}, poly.listOV ops R p (p.map ops.swap) →
      poly.unitTailO ops R p
  | [], _ => trivial
  | _ :: _, h => ⟨L.swapFix _ h.1, utNegReadO L h.2⟩

/-! The lifted laws, `def:poly`'s displayed reads at the bundle. -/

private theorem polyCoreO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    DCore (List γ) (poly.polyO ops) (poly.listOV ops R) :=
  { ovRefl := lovRefl L.toDCore
    ovSymm := lovSymm L.toDCore
    ovTrans := lovTrans L.toDCore
    addCongr := addCongrO L
    mulCongr := fun h1 h2 =>
      lovTrans L.toDCore (mulCongrLeftO L h1 _)
        (mulCongrO L _ h2)
    swapCongr := negCongrO L.toDCore
    addComm := addCommO L
    addAssoc := addAssocO L
    mulComm := mulCommO L
    mulAssoc := mulAssocO L
    leftDistrib := mulSumO L
    swapAdd := negSumO L.toDCore
    swapSwap := negNegO L.toDCore
    swapUnit := trivial
    mulSwapRight := mulSwapRightO L }

private theorem mapOneO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ∀ x : List γ, poly.listOV ops R (x.map (ops.mul ops.one)) x
  | [] => trivial
  | c :: t => ⟨L.oneMul c, mapOneO L t⟩

private theorem oneMulLO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ∀ x : List γ, poly.listOV ops R (poly.mulLO ops [ops.one] x) x := by
  intro x
  show poly.listOV ops R (poly.addLO ops (x.map (ops.mul ops.one))
    (ops.unit :: poly.mulLO ops [] x)) x
  refine lovTrans L.toDCore (addCommO L _ _) ?_
  refine lovTrans L.toDCore
    (utAddLovO L
      (show poly.unitTailO ops R [ops.unit] from
        ⟨L.toDCore.ovRefl ops.unit, trivial⟩)
      (x.map (ops.mul ops.one))) ?_
  exact mapOneO L x

private theorem cancelLO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) {a b a' b' : List γ}
    (h : poly.listOV ops R (poly.addLO ops a b) (poly.addLO ops a' b'))
    (ha : poly.listOV ops R a a') : poly.listOV ops R b b' :=
  lovOfGetAt L.toDCore (fun k =>
    L.addCancel
      (L.toDCore.ovTrans (L.toDCore.ovSymm (getAtAddO L a b k))
        (L.toDCore.ovTrans (lovGetAt L.toDCore h k)
          (getAtAddO L a' b' k)))
      (lovGetAt L.toDCore ha k))

/-- The polynomial carrier's laws bundle at an entry bundle's own:
the lifted sum and convolution satisfy the tier's laws wherever the
entries do, one lift per level of the carrier tower. -/
theorem polyLawsO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    DLaws (List γ) (poly.polyO ops) (poly.listOV ops R) :=
  { toDCore := polyCoreO L
    unitAdd := fun x => lovRefl L.toDCore x
    addUnit := fun x => by
      show poly.listOV ops R (poly.addLO ops x []) x
      rw [poly.addNilO ops x]
      exact lovRefl L.toDCore x
    mulUnit := fun x => poly.lovNilO _ _ (mulNilO L.toDCore x)
    swapFix := fun _ h => poly.lovNilO _ _ (utNegReadO L h)
    oneMul := oneMulLO L
    addCancel := fun h ha => cancelLO L h ha }

/-! The lifted carrier's shift, length and top kit, the monic
cancellation their close, the sum's cancellation the law bundle's
own summand-on-both-members field. -/

private theorem addLenLeO {γ : Type} (ops : DOps γ) :
    ∀ (p q : List γ) (n : Nat), p.length ≤ n → q.length ≤ n →
      (poly.addLO ops p q).length ≤ n
  | [], q, _, _, hq => hq
  | _ :: _, [], _, hp, _ => hp
  | _ :: p, _ :: q, n, hp, hq => by
    match n, hp, hq with
    | n + 1, hp, hq =>
      show (poly.addLO ops p q).length + 1 ≤ n + 1
      exact Nat.succ_le_succ (addLenLeO ops p q n
        (Nat.le_of_succ_le_succ hp) (Nat.le_of_succ_le_succ hq))

private theorem mulLenO {γ : Type} (ops : DOps γ) :
    ∀ (p q : List γ), 1 ≤ q.length → ∀ n : Nat,
      p.length + q.length ≤ n + 1 → (poly.mulLO ops p q).length ≤ n
  | [], _, _, _, _ => Nat.zero_le _
  | c :: p, q, hq, n, h => by
    show (poly.addLO ops (q.map (ops.mul c))
      (ops.unit :: poly.mulLO ops p q)).length ≤ n
    have h1 : q.length + 1 ≤ p.length + 1 + q.length := by
      rw [Nat.add_comm (p.length + 1) q.length]
      exact Nat.add_le_add_left (Nat.succ_le_succ (Nat.zero_le _))
        q.length
    have hqn : q.length ≤ n :=
      Nat.le_of_succ_le_succ (Nat.le_trans h1 h)
    refine addLenLeO ops _ _ n
      (by rw [ground.length_map]; exact hqn) ?_
    show (poly.mulLO ops p q).length + 1 ≤ n
    cases n with
    | zero =>
      exact absurd (Nat.le_trans hq hqn) (Nat.not_succ_le_zero 0)
    | succ n' =>
      refine Nat.succ_le_succ (mulLenO ops p q hq n' ?_)
      have h' : p.length + 1 + q.length ≤ n' + 1 + 1 := h
      rw [Nat.add_right_comm p.length 1 q.length] at h'
      exact Nat.le_of_succ_le_succ h'

private def shiftUpO {γ : Type} (ops : DOps γ) :
    Nat → List γ → List γ
  | 0, p => p
  | n + 1, p => ops.unit :: shiftUpO ops n p

private theorem lenShiftO {γ : Type} (ops : DOps γ) :
    ∀ (n : Nat) (p : List γ),
      (shiftUpO ops n p).length = n + p.length
  | 0, _ => (Nat.zero_add _).symm
  | n + 1, p => by
    show (shiftUpO ops n p).length + 1 = n + 1 + p.length
    rw [lenShiftO ops n p, Nat.add_right_comm]

private theorem shiftAppendO {γ : Type} (ops : DOps γ) :
    ∀ (n : Nat) (p q : List γ),
      shiftUpO ops n (p ++ q) = shiftUpO ops n p ++ q
  | 0, _, _ => rfl
  | n + 1, p, q => by
    show ops.unit :: shiftUpO ops n (p ++ q)
      = ops.unit :: (shiftUpO ops n p ++ q)
    rw [shiftAppendO ops n p q]

private theorem getAtShiftLtO {γ : Type} (ops : DOps γ) :
    ∀ (n : Nat) (p : List γ) (k : Nat), k < n →
      ground.getAt ops.unit (shiftUpO ops n p) k = ops.unit
  | 0, _, _, h => absurd h (Nat.not_lt_zero _)
  | _ + 1, _, 0, _ => rfl
  | n + 1, p, k + 1, h =>
    getAtShiftLtO ops n p k (Nat.lt_of_succ_lt_succ h)

private theorem getAtShiftAddO {γ : Type} (ops : DOps γ) :
    ∀ (n : Nat) (p : List γ) (k : Nat),
      ground.getAt ops.unit (shiftUpO ops n p) (n + k)
        = ground.getAt ops.unit p k
  | 0, _, k => by rw [Nat.zero_add k]; rfl
  | n + 1, p, k => by
    rw [Nat.add_right_comm n 1 k]
    show ground.getAt ops.unit (shiftUpO ops n p) (n + k)
      = ground.getAt ops.unit p k
    exact getAtShiftAddO ops n p k

private theorem utShiftO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) :
    ∀ (n : Nat) {p : List γ}, poly.unitTailO ops R p →
      poly.unitTailO ops R (shiftUpO ops n p)
  | 0, _, h => h
  | n + 1, _, h => ⟨C.ovRefl _, utShiftO C n h⟩

private theorem shiftOvO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) :
    ∀ (n : Nat) {x y : List γ}, poly.listOV ops R x y →
      poly.listOV ops R (shiftUpO ops n x) (shiftUpO ops n y)
  | 0, _, _, h => h
  | n + 1, _, _, h => ⟨C.ovRefl _, shiftOvO C n h⟩

private theorem shiftSumO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ∀ (n : Nat) (p q : List γ),
      poly.listOV ops R (poly.addLO ops (shiftUpO ops n p) (shiftUpO ops n q))
        (shiftUpO ops n (poly.addLO ops p q))
  | 0, _, _ => lovRefl L.toDCore _
  | n + 1, p, q => ⟨L.addUnit ops.unit, shiftSumO L n p q⟩

private theorem appendAddO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ∀ (p q : List γ),
      poly.listOV ops R (p ++ q) (poly.addLO ops p (shiftUpO ops p.length q))
  | [], _ => lovRefl L.toDCore _
  | c :: p, q =>
    ⟨L.toDCore.ovSymm (L.addUnit c), appendAddO L p q⟩

private theorem utJoinO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} :
    ∀ {u : List γ}, poly.unitTailO ops R u → ∀ {v : List γ},
      poly.unitTailO ops R v → poly.unitTailO ops R (u ++ v)
  | [], _, _, hv => hv
  | _ :: _, hu, _, hv => ⟨hu.1, utJoinO hu.2 hv⟩

private theorem mapShiftO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) (c : γ) :
    ∀ (n : Nat) (q : List γ),
      poly.listOV ops R ((shiftUpO ops n q).map (ops.mul c))
        (shiftUpO ops n (q.map (ops.mul c)))
  | 0, _ => lovRefl L.toDCore _
  | n + 1, q => ⟨L.mulUnit c, mapShiftO L c n q⟩

private theorem mulShiftO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ∀ (p : List γ) (n : Nat) (q : List γ),
      poly.listOV ops R (poly.mulLO ops p (shiftUpO ops n q))
        (shiftUpO ops n (poly.mulLO ops p q))
  | [], n, _ => utShiftO L.toDCore n trivial
  | c :: p, n, q => by
    show poly.listOV ops R
      (poly.addLO ops ((shiftUpO ops n q).map (ops.mul c))
        (ops.unit :: poly.mulLO ops p (shiftUpO ops n q)))
      (shiftUpO ops n (poly.addLO ops (q.map (ops.mul c))
        (ops.unit :: poly.mulLO ops p q)))
    refine lovTrans L.toDCore (addCongrO L (mapShiftO L c n q)
      (show poly.listOV ops R (ops.unit :: poly.mulLO ops p (shiftUpO ops n q))
        (shiftUpO ops n (ops.unit :: poly.mulLO ops p q)) from ?_))
      (shiftSumO L n _ _)
    have hsc : shiftUpO ops n (ops.unit :: poly.mulLO ops p q)
        = ops.unit :: shiftUpO ops n (poly.mulLO ops p q) := by
      induction n with
      | zero => rfl
      | succ n ih =>
        show ops.unit :: shiftUpO ops n (ops.unit :: poly.mulLO ops p q)
          = ops.unit :: (ops.unit :: shiftUpO ops n (poly.mulLO ops p q))
        rw [ih]
    rw [hsc]
    exact ⟨L.toDCore.ovRefl _, mulShiftO L p n q⟩

private theorem mulSnocO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (p q : List γ) (a : γ) :
    poly.listOV ops R (poly.mulLO ops p (q ++ [a]))
      (poly.addLO ops (poly.mulLO ops p q)
        (shiftUpO ops q.length (p.map (fun d => ops.mul a d)))) :=
  lovTrans L.toDCore (mulCongrO L p (appendAddO L q [a]))
    (lovTrans L.toDCore
      (mulSumO L p q (shiftUpO ops q.length [a]))
      (addCongrO L (lovRefl L.toDCore _)
        (lovTrans L.toDCore (mulShiftO L p q.length [a])
          (shiftOvO L.toDCore q.length (mulSingleO L p a)))))

private theorem mulTopO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) :
    ∀ (p q : List γ) (n : Nat),
      p.length + q.length ≤ n + 1 → ∀ k : Nat, n ≤ k →
      R.rel (ground.getAt ops.unit (poly.mulLO ops p q) k) ops.unit
  | p, [], _, _, k, _ => utGetAt C (mulNilO C p) k
  | p, b :: q, n, h, k, hk => by
    rw [ground.getAt_over ops.unit (poly.mulLO ops p (b :: q)) k
      (Nat.le_trans (mulLenO ops p (b :: q)
        (Nat.succ_le_succ (Nat.zero_le _)) n h) hk)]
    exact C.ovRefl _

private theorem shiftTopO {γ : Type} {ops : DOps γ}
    {Rd : ground.DRead γ} (L : DLaws γ ops Rd.rel)
        (N : Nat) (X Z R : List γ)
    (hX : ∀ k : Nat, N ≤ k →
      Rd.rel (ground.getAt ops.unit X k) ops.unit)
    (hR : ∀ k : Nat, N ≤ k →
      Rd.rel (ground.getAt ops.unit R k) ops.unit)
    (h : poly.listOV ops Rd (poly.addLO ops X (shiftUpO ops N Z)) R) :
    poly.unitTailO ops Rd Z ∧ poly.listOV ops Rd X R := by
  constructor
  · refine utOfGetAt (fun j => ?_)
    have e1 := getAtAddO L X (shiftUpO ops N Z) (N + j)
    rw [getAtShiftAddO ops N Z j] at e1
    have e3 : Rd.rel (ops.add (ground.getAt ops.unit X (N + j))
        (ground.getAt ops.unit Z j)) ops.unit :=
      L.toDCore.ovTrans (L.toDCore.ovSymm e1)
        (L.toDCore.ovTrans (lovGetAt L.toDCore h (N + j))
          (hR (N + j) (Nat.le_add_right N j)))
    exact L.addCancel
      (L.toDCore.ovTrans e3
        (L.toDCore.ovSymm (L.addUnit ops.unit)))
      (hX (N + j) (Nat.le_add_right N j))
  · refine lovOfGetAt L.toDCore (fun k => ?_)
    cases Nat.lt_or_ge k N with
    | inl hlt =>
      have e1 := getAtAddO L X (shiftUpO ops N Z) k
      rw [getAtShiftLtO ops N Z k hlt] at e1
      exact L.toDCore.ovTrans
        (L.toDCore.ovSymm (L.addUnit (ground.getAt ops.unit X k)))
        (L.toDCore.ovTrans (L.toDCore.ovSymm e1)
          (lovGetAt L.toDCore h k))
    | inr hge =>
      exact L.toDCore.ovTrans (hX k hge)
        (L.toDCore.ovSymm (hR k hge))

private theorem nilOfLenO {γ : Type} :
    ∀ p : List γ, p.length ≤ 0 → p = [] :=
  fun _ h => List.length_eq_zero_iff.mp (Nat.eq_zero_of_le_zero h)

private theorem snocCasesO {γ : Type} :
    ∀ p : List γ, p = [] ∨
      ∃ (q : List γ) (a : γ), p = q ++ [a] ∧ q.length + 1 = p.length
  | [] => Or.inl rfl
  | a :: t => by
    cases snocCasesO t with
    | inl h => exact Or.inr ⟨[], a, by rw [h]; rfl, by rw [h]; rfl⟩
    | inr h =>
      obtain ⟨q, b, hq, hl⟩ := h
      exact Or.inr ⟨a :: q, b, by rw [hq]; rfl, by
        show q.length + 1 + 1 = t.length + 1
        rw [hl]⟩

private def monicLO {γ : Type} (ops : DOps γ) (s : List γ) :
    List γ := s ++ [ops.one]

private theorem monicLenO {γ : Type} (ops : DOps γ) :
    ∀ s : List γ, (monicLO ops s).length = s.length + 1
  | [] => rfl
  | _ :: s => by
    show (monicLO ops s).length + 1 = s.length + 1 + 1
    rw [monicLenO ops s]

private theorem monicCancelO {γ : Type} {ops : DOps γ}
    {Rd : ground.DRead γ} (L : DLaws γ ops Rd.rel) :
    ∀ (n : Nat) (s Q R : List γ), Q.length ≤ n →
      R.length ≤ s.length →
      poly.listOV ops Rd (poly.mulLO ops (monicLO ops s) Q) R →
      poly.unitTailO ops Rd Q
  | 0, _, Q, _, hn, _, _ => by rw [nilOfLenO Q hn]; exact trivial
  | n + 1, s, Q, R, hn, hR, h => by
    obtain hnil | ⟨Q', a, hQa, hQl⟩ := snocCasesO Q
    · rw [hnil]; exact trivial
    · subst hQa
      have hfuel : Q'.length ≤ n := by
        have hn' : (Q' ++ [a]).length ≤ n + 1 := hn
        rw [← hQl] at hn'
        exact Nat.le_of_succ_le_succ hn'
      have hYlen : (shiftUpO ops Q'.length
          (s.map (fun d => ops.mul a d))).length
          = Q'.length + s.length := by
        rw [lenShiftO, ground.length_map]
      have h1 : poly.listOV ops Rd (poly.mulLO ops (monicLO ops s) (Q' ++ [a]))
          (poly.addLO ops (poly.addLO ops (poly.mulLO ops (monicLO ops s) Q')
            (shiftUpO ops Q'.length (s.map (fun d => ops.mul a d))))
            (shiftUpO ops (Q'.length + s.length)
              [ops.mul a ops.one])) := by
        refine lovTrans L.toDCore
          (mulSnocO L (monicLO ops s) Q' a) ?_
        show poly.listOV ops Rd (poly.addLO ops (poly.mulLO ops (monicLO ops s) Q')
          (shiftUpO ops Q'.length ((s ++ [ops.one]).map
            (fun d => ops.mul a d)))) _
        have hm : (([ops.one] : List γ)).map (fun d => ops.mul a d)
            = [ops.mul a ops.one] := rfl
        rw [ground.map_append (fun d => ops.mul a d) s [ops.one], hm,
          shiftAppendO ops Q'.length (s.map (fun d => ops.mul a d))
            [ops.mul a ops.one]]
        refine lovTrans L.toDCore (addCongrO L (lovRefl L.toDCore _)
          (appendAddO L (shiftUpO ops Q'.length
              (s.map (fun d => ops.mul a d)))
            [ops.mul a ops.one])) ?_
        rw [hYlen]
        exact lovSymm L.toDCore (addAssocO L _ _ _)
      obtain ⟨hz, hXR⟩ := shiftTopO L
        (Q'.length + s.length)
        (poly.addLO ops (poly.mulLO ops (monicLO ops s) Q')
          (shiftUpO ops Q'.length (s.map (fun d => ops.mul a d))))
        [ops.mul a ops.one] R
        (fun k hk => L.toDCore.ovTrans (getAtAddO L _ _ k)
          (L.toDCore.ovTrans
            (L.toDCore.addCongr
              (mulTopO L.toDCore (monicLO ops s) Q'
                (Q'.length + s.length)
                (by
                  rw [monicLenO ops s, Nat.add_right_comm s.length 1
                    Q'.length, Nat.add_comm s.length Q'.length]
                  exact Nat.le_refl _) k hk)
              (ovOfEq L.toDCore
                (ground.getAt_over ops.unit _ k
                  (by rw [hYlen]; exact hk))))
            (L.addUnit ops.unit)))
        (fun k hk => ovOfEq L.toDCore
          (ground.getAt_over ops.unit R k
            (Nat.le_trans hR (Nat.le_trans
              (Nat.le_add_left s.length Q'.length) hk))))
        (lovTrans L.toDCore (lovSymm L.toDCore h1) h)
      have t1 : Rd.rel (ops.mul a ops.one) a :=
        L.toDCore.ovTrans (L.toDCore.mulComm a ops.one) (L.oneMul a)
      have ha : Rd.rel a ops.unit :=
        L.toDCore.ovTrans (L.toDCore.ovSymm t1) hz.1
      exact utJoinO
        (monicCancelO L n s Q' R hfuel hR
          (lovTrans L.toDCore (lovSymm L.toDCore
            (addUtLovO' L (poly.mulLO ops (monicLO ops s) Q')
              (utShiftO L.toDCore Q'.length (utScaleO L ha s)))) hXR))
        ⟨ha, trivial⟩
where
  addUtLovO' {γ : Type} {ops : DOps γ} {Rd : ground.DRead γ}
      (L : DLaws γ ops Rd.rel) (p : List γ) {q : List γ}
      (h : poly.unitTailO ops Rd q) :
      poly.listOV ops Rd (poly.addLO ops p q) p :=
    lovOfGetAt L.toDCore (fun k =>
      L.toDCore.ovTrans (getAtAddO L p q k)
        (L.toDCore.ovTrans
          (L.toDCore.addCongr (L.toDCore.ovRefl _)
            (utGetAt L.toDCore h k))
          (L.addUnit _)))

/-! The difference plumbing and the cancellation's one-value
close: two lists at one value exactly where their gap sits at the
unit family, the swap's annihilation and the sum's cancellation
the stated carrier laws. -/

private theorem getAtNegO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) :
    ∀ (q : List γ) (k : Nat),
      R.rel (ground.getAt ops.unit (q.map ops.swap) k)
        (ops.swap (ground.getAt ops.unit q k)) :=
  poly.getAt_mapSwap ops R C.ovRefl C.ovSymm C.swapUnit

private theorem diffUtO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    {p q : List γ} (h : poly.listOV ops R p q) :
    poly.unitTailO ops R (poly.addLO ops p (q.map ops.swap)) :=
  utOfGetAt (fun k =>
    L.toDCore.ovTrans (getAtAddO L p (q.map ops.swap) k)
      (L.toDCore.ovTrans
        (L.toDCore.addCongr (lovGetAt L.toDCore h k)
          (getAtNegO L.toDCore q k))
        (annihDerived L _)))

private theorem ovOfDiffO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
        {p q : List γ}
    (h : poly.unitTailO ops R (poly.addLO ops p (q.map ops.swap))) :
    poly.listOV ops R p q :=
  lovOfGetAt L.toDCore (fun k => by
    have e1 : R.rel (ops.add (ground.getAt ops.unit p k)
        (ops.swap (ground.getAt ops.unit q k))) ops.unit :=
      L.toDCore.ovTrans
        (L.toDCore.addCongr (L.toDCore.ovRefl _)
          (L.toDCore.ovSymm (getAtNegO L.toDCore q k)))
        (L.toDCore.ovTrans
          (L.toDCore.ovSymm (getAtAddO L p (q.map ops.swap) k))
          (utGetAt L.toDCore h k))
    have e2 : R.rel (ops.add (ops.swap (ground.getAt ops.unit q k))
        (ground.getAt ops.unit p k))
        (ops.add (ops.swap (ground.getAt ops.unit q k))
          (ground.getAt ops.unit q k)) :=
      L.toDCore.ovTrans (L.toDCore.addComm _ _)
        (L.toDCore.ovTrans e1
          (L.toDCore.ovSymm (L.toDCore.ovTrans
            (L.toDCore.addComm _ _) (annihDerived L _))))
    exact L.addCancel e2 (L.toDCore.ovRefl _))

private theorem cancelMonicOV {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
            (D X Y : List γ)
    (hmon : poly.listOV ops R (monicLO ops D.dropLast) D)
    (h : poly.listOV ops R (poly.mulLO ops D X) (poly.mulLO ops D Y)) :
    poly.listOV ops R X Y := by
  have hu : poly.unitTailO ops R
      (poly.addLO ops (poly.mulLO ops D X) ((poly.mulLO ops D Y).map ops.swap)) :=
    diffUtO L h
  have hB : poly.listOV ops R
      (poly.mulLO ops (monicLO ops D.dropLast)
        (poly.addLO ops X (Y.map ops.swap)))
      (poly.addLO ops (poly.mulLO ops D X) ((poly.mulLO ops D Y).map ops.swap)) :=
    lovTrans L.toDCore
      (mulCongrLeftO L hmon (poly.addLO ops X (Y.map ops.swap)))
      (lovTrans L.toDCore (mulSumO L D X (Y.map ops.swap))
        (addCongrO L (lovRefl L.toDCore _)
          (mulSwapRightO L D Y)))
  have huZ : poly.unitTailO ops R (poly.addLO ops X (Y.map ops.swap)) :=
    monicCancelO L
      (poly.addLO ops X (Y.map ops.swap)).length D.dropLast
      (poly.addLO ops X (Y.map ops.swap)) [] (Nat.le_refl _)
      (Nat.zero_le _)
      (poly.lovNilO _ _ (ovUt L.toDCore hB hu))
  exact ovOfDiffO L huZ

/-! The lifted carrier's product-top and fold-shape kit: the
lengths and top coefficients the shifted determinant's shape
consumes. -/

private theorem addLenLO {γ : Type} (ops : DOps γ) :
    ∀ p q : List γ, q.length ≤ p.length →
      (poly.addLO ops p q).length = p.length
  | [], [], _ => rfl
  | [], _ :: _, h => absurd h (Nat.not_succ_le_zero _)
  | _ :: _, [], _ => rfl
  | _ :: p, _ :: q, h => by
    show (poly.addLO ops p q).length + 1 = p.length + 1
    rw [addLenLO ops p q (Nat.le_of_succ_le_succ h)]

private theorem addLenRO {γ : Type} (ops : DOps γ) :
    ∀ p q : List γ, p.length ≤ q.length →
      (poly.addLO ops p q).length = q.length
  | [], _, _ => rfl
  | _ :: _, [], h => absurd h (Nat.not_succ_le_zero _)
  | _ :: p, _ :: q, h => by
    show (poly.addLO ops p q).length + 1 = q.length + 1
    rw [addLenRO ops p q (Nat.le_of_succ_le_succ h)]

private theorem getAtAddLO {γ : Type} (ops : DOps γ) :
    ∀ (p q : List γ) (k : Nat), q.length ≤ k →
      ground.getAt ops.unit (poly.addLO ops p q) k
        = ground.getAt ops.unit p k
  | [], q, k, h => by
    show ground.getAt ops.unit q k = ground.getAt ops.unit [] k
    rw [ground.getAt_over ops.unit q k h,
      ground.getAt_over ops.unit [] k (Nat.zero_le k)]
  | _ :: _, [], _, _ => rfl
  | _ :: _, _ :: _, 0, h => absurd h (Nat.not_succ_le_zero _)
  | _ :: p, _ :: q, k + 1, h =>
    getAtAddLO ops p q k (Nat.le_of_succ_le_succ h)

private theorem getAtAddRO {γ : Type} (ops : DOps γ) :
    ∀ (p q : List γ) (k : Nat), p.length ≤ k →
      ground.getAt ops.unit (poly.addLO ops p q) k
        = ground.getAt ops.unit q k
  | [], _, _, _ => rfl
  | _ :: _, [], k, h => by
    show ground.getAt ops.unit (_ :: _) k = ground.getAt ops.unit [] k
    rw [ground.getAt_over ops.unit _ k h,
      ground.getAt_over ops.unit [] k (Nat.zero_le k)]
  | _ :: _, _ :: _, 0, h => absurd h (Nat.not_succ_le_zero _)
  | _ :: p, _ :: q, k + 1, h =>
    getAtAddRO ops p q k (Nat.le_of_succ_le_succ h)

private theorem mulLenTopO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ∀ (p q : List γ) (a b : Nat),
      p.length = a + 1 → q.length = b + 1 →
      (poly.mulLO ops p q).length = a + b + 1
        ∧ R.rel (ground.getAt ops.unit (poly.mulLO ops p q) (a + b))
          (ops.mul (ground.getAt ops.unit p a)
            (ground.getAt ops.unit q b))
  | [], _, _, _, hp, _ => Nat.noConfusion hp
  | c :: p, q, 0, b, hp, hq => by
    have hp0 : p = [] := by
      cases p with
      | nil => rfl
      | cons x s => exact Nat.noConfusion (Nat.succ.inj hp)
    rw [hp0]
    have hmap : (q.map (ops.mul c)).length = b + 1 := by
      rw [ground.length_map]
      exact hq
    refine ⟨?_, ?_⟩
    · show (poly.addLO ops (q.map (ops.mul c))
        (ops.unit :: poly.mulLO ops [] q)).length = 0 + b + 1
      rw [Nat.zero_add,
        addLenLO ops _ _ (by
          rw [hmap]
          exact Nat.succ_le_succ (Nat.zero_le b))]
      exact hmap
    · show R.rel (ground.getAt ops.unit (poly.addLO ops (q.map (ops.mul c))
          (ops.unit :: poly.mulLO ops [] q)) (0 + b))
        (ops.mul (ground.getAt ops.unit [c] 0)
          (ground.getAt ops.unit q b))
      rw [Nat.zero_add]
      cases b with
      | zero =>
        cases q with
        | nil => exact Nat.noConfusion hq
        | cons d s =>
          have hs : s = [] := by
            cases s with
            | nil => rfl
            | cons y u => exact Nat.noConfusion (Nat.succ.inj hq)
          rw [hs]
          show R.rel (ops.add (ops.mul c d) ops.unit) (ops.mul c d)
          exact L.addUnit _
      | succ b' =>
        rw [getAtAddLO ops (q.map (ops.mul c))
            (ops.unit :: poly.mulLO ops [] q) (b' + 1)
            (Nat.succ_le_succ (Nat.zero_le _)),
          ground.getAt_map ops.unit ops.unit (ops.mul c) q (b' + 1)
            (by rw [hq]; exact Nat.lt_succ_self _)]
        exact L.toDCore.ovRefl _
  | c :: p, q, a + 1, b, hp, hq => by
    have hIH := mulLenTopO L p q a b (Nat.succ.inj hp) hq
    have hmap : (q.map (ops.mul c)).length = b + 1 := by
      rw [ground.length_map]
      exact hq
    have hcons : (ops.unit :: poly.mulLO ops p q).length = a + b + 1 + 1 := by
      show (poly.mulLO ops p q).length + 1 = a + b + 1 + 1
      rw [hIH.1]
    have hswap : a + 1 + b = a + b + 1 := Nat.add_right_comm a 1 b
    have hle : (q.map (ops.mul c)).length
        ≤ (ops.unit :: poly.mulLO ops p q).length := by
      rw [hmap, hcons]
      exact Nat.succ_le_succ (Nat.le_trans (Nat.le_succ b)
        (Nat.le_add_left (b + 1) a))
    have hle2 : (q.map (ops.mul c)).length ≤ a + 1 + b := by
      rw [hmap, hswap]
      exact Nat.succ_le_succ (Nat.le_add_left b a)
    refine ⟨?_, ?_⟩
    · show (poly.addLO ops (q.map (ops.mul c))
        (ops.unit :: poly.mulLO ops p q)).length = a + 1 + b + 1
      rw [addLenRO ops _ _ hle, hcons, hswap]
    · show R.rel (ground.getAt ops.unit (poly.addLO ops (q.map (ops.mul c))
          (ops.unit :: poly.mulLO ops p q)) (a + 1 + b))
        (ops.mul (ground.getAt ops.unit (c :: p) (a + 1))
          (ground.getAt ops.unit q b))
      rw [getAtAddRO ops (q.map (ops.mul c))
          (ops.unit :: poly.mulLO ops p q) (a + 1 + b) hle2, hswap]
      show R.rel (ground.getAt ops.unit (poly.mulLO ops p q) (a + b))
        (ops.mul (ground.getAt ops.unit p a)
          (ground.getAt ops.unit q b))
      exact hIH.2

private theorem mulLenLeO {γ : Type} (ops : DOps γ) :
    ∀ (p q : List γ) (a b : Nat),
      p.length ≤ a + 1 → q.length ≤ b + 1 →
      (poly.mulLO ops p q).length ≤ a + b + 1
  | [], _, _, _, _, _ => Nat.zero_le _
  | c :: p, q, a, b, hp, hq => by
    show (poly.addLO ops (q.map (ops.mul c))
      (ops.unit :: poly.mulLO ops p q)).length ≤ a + b + 1
    refine addLenLeO ops _ _ _ ?_ ?_
    · rw [ground.length_map]
      exact Nat.le_trans hq (Nat.le_add_left (b + 1) a)
    · show (poly.mulLO ops p q).length + 1 ≤ a + b + 1
      cases a with
      | zero =>
        cases p with
        | nil =>
          show 0 + 1 ≤ 0 + b + 1
          exact Nat.succ_le_succ (Nat.zero_le _)
        | cons x s =>
          exact absurd (Nat.le_of_succ_le_succ hp)
            (Nat.not_succ_le_zero s.length)
      | succ a' =>
        have hIH := mulLenLeO ops p q a' b
          (Nat.le_of_succ_le_succ hp) hq
        have he : a' + 1 + b + 1 = a' + b + 1 + 1 := by
          rw [Nat.add_right_comm a' 1 b]
        rw [he]
        exact Nat.succ_le_succ hIH

/-- A unit-tail list's top reads the sum's unit at any entry
carrier. -/
private theorem topUnitTailO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) :
    ∀ {p : List γ}, poly.unitTailO ops R p → R.rel (poly.topO ops p) ops.unit
  | [], _ => C.ovRefl _
  | [_], h => h.1
  | _ :: c :: t, h => topUnitTailO C (p := c :: t) h.2

/-- The product's top coefficient is the tops' product at any entry
carrier, `def:poly`'s displayed read at the summed key, the vacant
factors at the unit's own product. -/
private theorem topMulLO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ∀ p q : List γ,
      R.rel (poly.topO ops (poly.mulLO ops p q))
        (ops.mul (poly.topO ops p) (poly.topO ops q))
  | [], q =>
    L.toDCore.ovSymm (L.toDCore.ovTrans (L.toDCore.mulComm _ _)
      (L.mulUnit (poly.topO ops q)))
  | _ :: p, [] =>
    L.toDCore.ovTrans (topUnitTailO L.toDCore (mulNilO L.toDCore _))
      (L.toDCore.ovSymm (L.mulUnit _))
  | c :: p, d :: q => by
    have h := mulLenTopO L (c :: p) (d :: q) p.length q.length rfl rfl
    rw [poly.topO_getAt ops _ (p.length + q.length) h.1,
      poly.topO_getAt ops (c :: p) p.length rfl,
      poly.topO_getAt ops (d :: q) q.length rfl]
    exact h.2

/-- The outer product's top is the outer tops' product at the
polynomial entries. -/
theorem ptop_pmul (P Q : poly.PPoly) :
    poly.oneValue (poly.ptop (poly.pmul P Q))
      (poly.mul (poly.ptop P) (poly.ptop Q)) :=
  topMulLO (R := poly.polyRead) (polyLawsO (R := ground.bpairRead) bpairLaws)
    P Q

private theorem foldMulLeO {γ : Type} (ops : DOps γ)
    (E : Nat → List γ) (hE : ∀ t, (E t).length ≤ 2) :
    ∀ l : List Nat,
      (ground.famFold (poly.mulLO ops) [ops.one] E l).length ≤ l.length + 1
  | [] => Nat.le_refl 1
  | a :: t => by
    show (poly.mulLO ops (E a)
      (ground.famFold (poly.mulLO ops) [ops.one] E t)).length
        ≤ t.length + 1 + 1
    have h := mulLenLeO ops (E a)
      (ground.famFold (poly.mulLO ops) [ops.one] E t)
      1 t.length (hE a) (foldMulLeO ops E hE t)
    rw [Nat.add_comm 1 t.length] at h
    exact h

private theorem foldMulDropO {γ : Type} (ops : DOps γ)
    (E : Nat → List γ) (hE : ∀ t, (E t).length ≤ 2) (t₀ : Nat)
    (h0 : (E t₀).length ≤ 1) : ∀ l : List Nat,
    0 < ground.countOf t₀ l →
    (ground.famFold (poly.mulLO ops) [ops.one] E l).length ≤ l.length
  | [], h => absurd h (Nat.lt_irrefl 0)
  | a :: t, h => by
    by_cases hat : t₀ = a
    · show (poly.mulLO ops (E a)
        (ground.famFold (poly.mulLO ops) [ops.one] E t)).length ≤ t.length + 1
      have hEa : (E a).length ≤ 0 + 1 := by
        rw [← hat]
        exact h0
      have hb := mulLenLeO ops (E a)
        (ground.famFold (poly.mulLO ops) [ops.one] E t)
        0 t.length hEa (foldMulLeO ops E hE t)
      rw [Nat.zero_add] at hb
      exact hb
    · have ht : 0 < ground.countOf t₀ t := by
        rw [ground.countOf_head_ne hat] at h
        exact h
      have hIH := foldMulDropO ops E hE t₀ h0 t ht
      cases t with
      | nil => exact absurd ht (Nat.lt_irrefl 0)
      | cons x s =>
        show (poly.mulLO ops (E a)
          (ground.famFold (poly.mulLO ops) [ops.one] E (x :: s))).length
          ≤ (x :: s).length + 1
        have hb := mulLenLeO ops (E a)
          (ground.famFold (poly.mulLO ops) [ops.one] E (x :: s)) 1 s.length
          (hE a) hIH
        rw [Nat.add_comm 1 s.length] at hb
        exact hb

private theorem foldMulMonicO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
        (E : Nat → List γ) : ∀ l : List Nat,
    (∀ t, 0 < ground.countOf t l →
      (E t).length = 2
        ∧ R.rel (ground.getAt ops.unit (E t) 1) ops.one) →
    (ground.famFold (poly.mulLO ops) [ops.one] E l).length = l.length + 1
      ∧ R.rel (ground.getAt ops.unit
          (ground.famFold (poly.mulLO ops) [ops.one] E l) l.length)
        ops.one
  | [], _ => ⟨rfl, L.toDCore.ovRefl _⟩
  | a :: t, h => by
    have hIH := foldMulMonicO L E t
      (fun x hx => h x (ground.countOf_cons_pos hx))
    have ha := h a (by rw [ground.countOf_head]; exact Nat.succ_pos _)
    have hm := mulLenTopO L (E a)
      (ground.famFold (poly.mulLO ops) [ops.one] E t)
      1 t.length ha.1 hIH.1
    have hswap : 1 + t.length = t.length + 1 := Nat.add_comm 1 t.length
    refine ⟨?_, ?_⟩
    · show (poly.mulLO ops (E a)
        (ground.famFold (poly.mulLO ops) [ops.one] E t)).length
        = t.length + 1 + 1
      rw [hm.1, hswap]
    · show R.rel (ground.getAt ops.unit (poly.mulLO ops (E a)
          (ground.famFold (poly.mulLO ops) [ops.one] E t))
        (t.length + 1)) ops.one
      rw [← hswap]
      refine L.toDCore.ovTrans hm.2 ?_
      exact L.toDCore.ovTrans
        (L.toDCore.mulCongr ha.2 hIH.2)
        (L.oneMul ops.one)

private theorem foldAddLeO {γ : Type} (ops : DOps γ)
    (g : List Nat → List γ) (n : Nat) :
    ∀ l : List (List Nat),
    (∀ q, 0 < ground.countOf q l → (g q).length ≤ n) →
    (ground.famFold (poly.addLO ops) [] g l).length ≤ n
  | [], _ => Nat.zero_le n
  | a :: t, h => by
    show (poly.addLO ops (g a) (ground.famFold (poly.addLO ops) [] g t)).length ≤ n
    exact addLenLeO ops _ _ n
      (h a (by rw [ground.countOf_head]; exact Nat.succ_pos _))
      (foldAddLeO ops g n t (fun q hq => h q (ground.countOf_cons_pos hq)))

private theorem foldAddPickO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (g : List Nat → List γ)
    (key : List Nat) (n : Nat) (hkey : (g key).length = n + 1)
    (htop : R.rel (ground.getAt ops.unit (g key) n) ops.one) :
    ∀ l : List (List Nat), ground.countOf key l = 1 →
    (∀ q, 0 < ground.countOf q l → ¬ q = key → (g q).length ≤ n) →
    (ground.famFold (poly.addLO ops) [] g l).length = n + 1
      ∧ R.rel (ground.getAt ops.unit
          (ground.famFold (poly.addLO ops) [] g l) n) ops.one
  | [], hc, _ => Nat.noConfusion hc
  | a :: t, hc, h => by
    have hh : (if key = a then 1 else 0) + ground.countOf key t = 1 :=
      (ground.countOf_cons key a t).symm.trans hc
    by_cases hak : key = a
    · rw [if_pos hak] at hh
      have hc0 : ground.countOf key t = 0 :=
        ground.addCancelL 1 (by rw [Nat.add_zero]; exact hh)
      have hrest : (ground.famFold (poly.addLO ops) [] g t).length ≤ n :=
        foldAddLeO ops g n t (fun q hq => h q (ground.countOf_cons_pos hq)
          (fun he => absurd (show 0 < ground.countOf key t by
              rw [← he]; exact hq)
            (by rw [hc0]; exact Nat.lt_irrefl 0)))
      show (poly.addLO ops (g a) (ground.famFold (poly.addLO ops) [] g t)).length
          = n + 1
        ∧ R.rel (ground.getAt ops.unit
            (poly.addLO ops (g a) (ground.famFold (poly.addLO ops) [] g t)) n)
          ops.one
      rw [← hak]
      refine ⟨?_, ?_⟩
      · rw [addLenLO ops (g key) (ground.famFold (poly.addLO ops) [] g t)
          (by rw [hkey]; exact Nat.le_trans hrest (Nat.le_succ n))]
        exact hkey
      · rw [getAtAddLO ops (g key) (ground.famFold (poly.addLO ops) [] g t)
          n hrest]
        exact htop
    · rw [if_neg hak, Nat.zero_add] at hh
      have hIH := foldAddPickO L g key n hkey htop t hh
        (fun q hq hqk => h q (ground.countOf_cons_pos hq) hqk)
      have hga : (g a).length ≤ n :=
        h a (by rw [ground.countOf_head]; exact Nat.succ_pos _)
          (fun he => hak he.symm)
      show (poly.addLO ops (g a) (ground.famFold (poly.addLO ops) [] g t)).length
          = n + 1
        ∧ R.rel (ground.getAt ops.unit
            (poly.addLO ops (g a) (ground.famFold (poly.addLO ops) [] g t)) n)
          ops.one
      refine ⟨?_, ?_⟩
      · rw [addLenRO ops (g a) (ground.famFold (poly.addLO ops) [] g t)
          (by rw [hIH.1]; exact Nat.le_trans hga (Nat.le_succ n))]
        exact hIH.1
      · rw [getAtAddRO ops (g a) (ground.famFold (poly.addLO ops) [] g t)
          n hga]
        exact hIH.2

private theorem foldMulDrop2O {γ : Type} (ops : DOps γ)
    (E : Nat → List γ) (hE : ∀ t, (E t).length ≤ 2) (t₀ t₁ : Nat)
    (hne : ¬ t₀ = t₁)
    (h0 : (E t₀).length ≤ 1) (h1 : (E t₁).length ≤ 1) :
    ∀ l : List Nat, 0 < ground.countOf t₀ l →
      0 < ground.countOf t₁ l →
      (ground.famFold (poly.mulLO ops) [ops.one] E l).length + 1 ≤ l.length
  | [], h, _ => absurd h (Nat.lt_irrefl 0)
  | a :: t, h₀, h₁ => by
    show (poly.mulLO ops (E a)
      (ground.famFold (poly.mulLO ops) [ops.one] E t)).length + 1
        ≤ t.length + 1
    by_cases ha0 : t₀ = a
    · have ht1 : 0 < ground.countOf t₁ t := by
        rw [ground.countOf_head_ne
          (fun he : t₁ = a => hne (ha0.trans he.symm))] at h₁
        exact h₁
      match t, ht1 with
      | b :: t', ht1 =>
        have htail := foldMulDropO ops E hE t₁ h1 (b :: t') ht1
        refine Nat.succ_le_succ ?_
        refine Nat.le_trans (mulLenLeO ops (E a)
          (ground.famFold (poly.mulLO ops) [ops.one] E (b :: t')) 0
          t'.length (by rw [← ha0]; exact h0) htail) ?_
        rw [Nat.zero_add]
        exact Nat.le_refl _
    · by_cases ha1 : t₁ = a
      · have ht0 : 0 < ground.countOf t₀ t := by
          rw [ground.countOf_head_ne ha0] at h₀
          exact h₀
        match t, ht0 with
        | b :: t', ht0 =>
          have htail := foldMulDropO ops E hE t₀ h0 (b :: t') ht0
          refine Nat.succ_le_succ ?_
          refine Nat.le_trans (mulLenLeO ops (E a)
            (ground.famFold (poly.mulLO ops) [ops.one] E (b :: t')) 0
            t'.length (by rw [← ha1]; exact h1) htail) ?_
          rw [Nat.zero_add]
          exact Nat.le_refl _
      · have ht0 : 0 < ground.countOf t₀ t := by
          rw [ground.countOf_head_ne ha0] at h₀
          exact h₀
        have ht1 : 0 < ground.countOf t₁ t := by
          rw [ground.countOf_head_ne ha1] at h₁
          exact h₁
        have htail := foldMulDrop2O ops E hE t₀ t₁ hne h0 h1 t ht0 ht1
        refine Nat.succ_le_succ ?_
        match hfl : (ground.famFold (poly.mulLO ops) [ops.one] E t).length,
            htail with
        | 0, htail =>
          refine Nat.le_trans (mulLenLeO ops (E a)
            (ground.famFold (poly.mulLO ops) [ops.one] E t) 1 0
            (hE a) (by rw [hfl]; exact Nat.zero_le 1)) ?_
          match t, ht0, ht1 with
          | [c], ht0, ht1 =>
            have he0 : t₀ = c := by
              by_cases h : t₀ = c
              · exact h
              · rw [ground.countOf_cons t₀ c ([] : List Nat),
                  if_neg h] at ht0
                exact absurd ht0 (Nat.lt_irrefl 0)
            have he1 : t₁ = c := by
              by_cases h : t₁ = c
              · exact h
              · rw [ground.countOf_cons t₁ c ([] : List Nat),
                  if_neg h] at ht1
                exact absurd ht1 (Nat.lt_irrefl 0)
            exact absurd (he0.trans he1.symm) hne
          | c :: d :: t'', _, _ =>
            exact Nat.succ_le_succ (Nat.succ_le_succ (Nat.zero_le _))
        | e + 1, htail =>
          refine Nat.le_trans (mulLenLeO ops (E a)
            (ground.famFold (poly.mulLO ops) [ops.one] E t) 1 e
            (hE a) (by rw [hfl]; exact Nat.le_refl _)) ?_
          rw [show 1 + e + 1 = e + 1 + 1 from by
            rw [Nat.add_comm 1 e]]
          exact htail

/-- Two families of one length differing exhibit a differing
place. -/
private theorem getAt_ne_witness : ∀ (u v : List Nat),
    u.length = v.length → ¬ u = v →
    ∃ k, k < u.length ∧ ¬ ground.getAt 0 u k = ground.getAt 0 v k
  | [], [], _, h => absurd rfl h
  | [], _ :: _, hl, _ => Nat.noConfusion hl
  | _ :: _, [], hl, _ => Nat.noConfusion hl
  | a :: u, b :: v, hl, h => by
    by_cases hab : a = b
    · have huv : ¬ u = v := by
        intro he
        exact h (by rw [hab, he])
      match getAt_ne_witness u v (Nat.succ.inj hl) huv with
      | ⟨k, hk, hne⟩ => exact ⟨k + 1, Nat.succ_lt_succ hk, hne⟩
    · exact ⟨0, Nat.succ_pos _, hab⟩

/-- The unit assignment is listed once in the enumeration. -/
private theorem countOf_range_mon (d : Nat) :
    ground.countOf (List.range d)
      (places.monomialsAt (List.replicate d 1)) = 1 := by
  have h1 : (List.range d).length
      = ground.sumNat (List.replicate d 1) := by
    rw [ground.length_range, ground.sumNat_replicate_one d]
  have h2 : places.content (List.replicate d 1).length (List.range d)
      = List.replicate d 1 := by
    rw [ground.length_replicate]
    refine ground.getAt_ext 0 _ _ ?_ ?_
    · rw [places.content_length, ground.length_replicate]
    · intro i hi
      have hid : i < d := by
        rw [places.content_length] at hi
        exact hi
      rw [places.getAt_contentAt d (List.range d) i hid,
        ground.countOf_range_one hid,
        ground.getAt_replicate 0 1 d i hid]
  rw [places.countOf_monomialsAt, if_pos ⟨h1, h2⟩]

/-- An assignment off the identity moves a second place: the moved
value's own place reads it back, the flip's witness pair. -/
private theorem offDiag_pair (n : Nat) (p : List Nat)
    (hp : 0 < ground.countOf p
      (places.monomialsAt (List.replicate n 1)))
    (k1 : Nat) (hk1 : k1 < n)
    (hkv : ¬ ground.getAt 0 p k1 = k1) :
    ∃ k2, k2 < n ∧ ¬ k2 = k1 ∧ ¬ ground.getAt 0 p k2 = k2 := by
  have hreads := places.perm_member_reads hp
  refine ⟨ground.getAt 0 p k1, ?_, ?_, ?_⟩
  · exact hreads.2.2.1 (ground.getAt 0 p k1)
      (ground.countOf_getAt_pos 0 p k1 (by
        rw [hreads.1]; exact hk1))
  · exact fun he => hkv he
  · intro hfix
    have h1 := places.posOf_getAt hreads.2.1 k1 (by
      rw [hreads.1]; exact hk1)
    have h2 := places.posOf_getAt hreads.2.1 (ground.getAt 0 p k1)
      (by
        rw [hreads.1]
        exact hreads.2.2.1 (ground.getAt 0 p k1)
          (ground.countOf_getAt_pos 0 p k1 (by
            rw [hreads.1]; exact hk1)))
    rw [hfix] at h2
    exact hkv (h1.symm.trans h2).symm

/-! The shifted list at the lifted carrier: the variable joins the
diagonal over the polynomial carrier of the bundle, and the
determinant's shape closes at the identity assignment. -/

private def shiftedRowO {γ : Type} (ops : DOps γ) (r : List γ)
    (i : Nat) : List (List γ) :=
  (List.range r.length).map (fun j =>
    match Nat.beq i j with
    | true => [ground.getAt ops.unit r j, ops.one]
    | false => [ground.getAt ops.unit r j])

private def shiftedMO {γ : Type} (ops : DOps γ)
    (m : List (List γ)) : List (List (List γ)) :=
  (List.range m.length).map
    (fun i => shiftedRowO ops (ground.getAt [] m i) i)

private theorem shiftedRowO_len {γ : Type} (ops : DOps γ)
    (r : List γ) (i : Nat) :
    (shiftedRowO ops r i).length = r.length :=
  ground.length_mapRange _ r.length

private theorem shiftedRowO_entry {γ : Type} (ops : DOps γ)
    (r : List γ) (i j : Nat) (hj : j < r.length) :
    ground.getAt [] (shiftedRowO ops r i) j
      = match Nat.beq i j with
        | true => [ground.getAt ops.unit r j, ops.one]
        | false => [ground.getAt ops.unit r j] := by
  show ground.getAt [] ((List.range r.length).map (fun j =>
      match Nat.beq i j with
      | true => [ground.getAt ops.unit r j, ops.one]
      | false => [ground.getAt ops.unit r j])) j = _
  rw [ground.getAt_map 0 [] _ (List.range r.length) j
      (by rw [ground.length_range]; exact hj),
    ground.getAt_range r.length j hj]

private theorem shiftedRowO_diag {γ : Type} (ops : DOps γ)
    (r : List γ) (i : Nat) (hi : i < r.length) :
    ground.getAt [] (shiftedRowO ops r i) i
      = [ground.getAt ops.unit r i, ops.one] := by
  rw [shiftedRowO_entry ops r i i hi, ground.beqRefl i]

private theorem shiftedRowO_off {γ : Type} (ops : DOps γ)
    (r : List γ) (i j : Nat) (hj : j < r.length) (hne : ¬ i = j) :
    ground.getAt [] (shiftedRowO ops r i) j
      = [ground.getAt ops.unit r j] := by
  have hb : Nat.beq i j = false := by
    cases hbe : Nat.beq i j with
    | true => exact absurd (Nat.eq_of_beq_eq_true hbe) hne
    | false => rfl
  rw [shiftedRowO_entry ops r i j hj, hb]

private theorem shiftedRowO_entry_len {γ : Type} (ops : DOps γ)
    (r : List γ) (i j : Nat) :
    (ground.getAt [] (shiftedRowO ops r i) j).length ≤ 2 := by
  match Nat.lt_or_ge j r.length with
  | .inl hj =>
    rw [shiftedRowO_entry ops r i j hj]
    cases Nat.beq i j with
    | true => exact Nat.le_refl 2
    | false => exact Nat.le_succ 1
  | .inr hj =>
    rw [ground.getAt_over [] (shiftedRowO ops r i) j
      (by rw [shiftedRowO_len]; exact hj)]
    exact Nat.zero_le 2

private theorem shiftedMO_len {γ : Type} (ops : DOps γ)
    (B : List (List γ)) :
    (shiftedMO ops B).length = B.length :=
  ground.length_mapRange _ B.length

private theorem shiftedMO_row {γ : Type} (ops : DOps γ)
    (B : List (List γ)) (i : Nat) (hi : i < B.length) :
    ground.getAt [] (shiftedMO ops B) i
      = shiftedRowO ops (ground.getAt [] B i) i := by
  show ground.getAt [] ((List.range B.length).map
    (fun i => shiftedRowO ops (ground.getAt [] B i) i)) i = _
  rw [ground.getAt_map 0 [] _ (List.range B.length) i
      (by rw [ground.length_range]; exact hi),
    ground.getAt_range B.length i hi]

private theorem shiftedMO_entry_len {γ : Type} (ops : DOps γ)
    (B : List (List γ)) (i j : Nat) :
    (ground.getAt [] (ground.getAt [] (shiftedMO ops B) i) j).length
      ≤ 2 := by
  match Nat.lt_or_ge i B.length with
  | .inl hi =>
    rw [shiftedMO_row ops B i hi]
    exact shiftedRowO_entry_len ops _ i j
  | .inr hi =>
    rw [ground.getAt_over [] (shiftedMO ops B) i
      (by rw [shiftedMO_len]; exact hi)]
    show (ground.getAt ([] : List γ) [] j).length ≤ 2
    rw [ground.getAt_over [] ([] : List (List γ))]
    · exact Nat.zero_le 2
    · exact Nat.zero_le j

private theorem shiftTermIdO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
        (B : List (List γ)) (hsq : rowsLen B.length B) :
    (termO (poly.polyO ops) (shiftedMO ops B) (List.range B.length)).length
        = B.length + 1
      ∧ R.rel (ground.getAt ops.unit
          (termO (poly.polyO ops) (shiftedMO ops B) (List.range B.length))
          B.length) ops.one := by
  have hlen : (shiftedMO ops B).length
      = (List.range B.length).length := by
    rw [shiftedMO_len, ground.length_range]
  have key := foldMulMonicO L
    (fun t => ground.getAt [] (ground.getAt [] (shiftedMO ops B) t)
      (ground.getAt 0 (List.range B.length) t))
    (List.range B.length)
    (fun t ht => by
      have htB : t < B.length := by
        rw [ground.countOf_range t B.length] at ht
        by_cases hb : t < B.length
        · exact hb
        · rw [if_neg hb] at ht
          exact absurd ht (Nat.lt_irrefl 0)
      have hrl : (ground.getAt [] B t).length = B.length :=
        rowsLen_getAt B t hsq htB
      show (ground.getAt [] (ground.getAt [] (shiftedMO ops B) t)
            (ground.getAt 0 (List.range B.length) t)).length = 2
          ∧ R.rel (ground.getAt ops.unit
            (ground.getAt [] (ground.getAt [] (shiftedMO ops B) t)
              (ground.getAt 0 (List.range B.length) t)) 1) ops.one
      rw [ground.getAt_range B.length t htB, shiftedMO_row ops B t htB,
        shiftedRowO_diag ops (ground.getAt [] B t) t
          (by rw [hrl]; exact htB)]
      exact ⟨rfl, L.toDCore.ovRefl _⟩)
  rw [ground.length_range] at key
  rw [termO_fold (poly.polyO ops) (shiftedMO ops B) (List.range B.length)
    hlen, shiftedMO_len]
  exact key

private theorem shiftTermOffO {γ : Type} (ops : DOps γ)
    (B : List (List γ)) (hsq : rowsLen B.length B)
    (p : List Nat)
    (hp : 0 < ground.countOf p
      (places.monomialsAt (List.replicate B.length 1)))
    (hne : ¬ p = List.range B.length) :
    (termO (poly.polyO ops) (shiftedMO ops B) p).length + 1 ≤ B.length := by
  have hreads := places.perm_member_reads hp
  have hlen : (shiftedMO ops B).length = p.length := by
    rw [shiftedMO_len, hreads.1]
  have hlen2 : p.length = (List.range B.length).length := by
    rw [hreads.1, ground.length_range]
  match getAt_ne_witness p (List.range B.length) hlen2 hne with
  | ⟨k, hk, hkne⟩ =>
    have hkB : k < B.length := by
      rw [← hreads.1]
      exact hk
    have hkval : ¬ k = ground.getAt 0 p k := by
      rw [ground.getAt_range B.length k hkB] at hkne
      exact fun he => hkne he.symm
    have hpk : ground.getAt 0 p k < B.length :=
      hreads.2.2.1 (ground.getAt 0 p k)
        (ground.countOf_getAt_pos 0 p k hk)
    have hrl : (ground.getAt [] B k).length = B.length :=
      rowsLen_getAt B k hsq hkB
    have h0 : (ground.getAt [] (ground.getAt [] (shiftedMO ops B) k)
        (ground.getAt 0 p k)).length ≤ 1 := by
      rw [shiftedMO_row ops B k hkB]
      rw [shiftedRowO_off ops (ground.getAt [] B k) k
        (ground.getAt 0 p k) (by rw [hrl]; exact hpk) hkval]
      exact Nat.le_refl 1
    match offDiag_pair B.length p hp k hkB
        (fun he => hkval he.symm) with
    | ⟨k2, hk2B, hk2ne, hk2v⟩ =>
      have hpk2 : ground.getAt 0 p k2 < B.length :=
        hreads.2.2.1 (ground.getAt 0 p k2)
          (ground.countOf_getAt_pos 0 p k2 (by
            rw [hreads.1]; exact hk2B))
      have hrl2 : (ground.getAt [] B k2).length = B.length :=
        rowsLen_getAt B k2 hsq hk2B
      have h02 : (ground.getAt []
          (ground.getAt [] (shiftedMO ops B) k2)
          (ground.getAt 0 p k2)).length ≤ 1 := by
        rw [shiftedMO_row ops B k2 hk2B]
        rw [shiftedRowO_off ops (ground.getAt [] B k2) k2
          (ground.getAt 0 p k2) (by rw [hrl2]; exact hpk2)
          (fun he => hk2v he.symm)]
        exact Nat.le_refl 1
      have hcount : 0 < ground.countOf k (List.range B.length) := by
        rw [ground.countOf_range_one hkB]
        exact Nat.succ_pos 0
      have hcount2 : 0 < ground.countOf k2 (List.range B.length) := by
        rw [ground.countOf_range_one hk2B]
        exact Nat.succ_pos 0
      have hbound := foldMulDrop2O ops
        (fun t => ground.getAt [] (ground.getAt [] (shiftedMO ops B) t)
          (ground.getAt 0 p t))
        (fun t => shiftedMO_entry_len ops B t (ground.getAt 0 p t))
        k k2 (fun he => hk2ne he.symm) h0 h02
        (List.range B.length) hcount hcount2
      rw [ground.length_range] at hbound
      rw [termO_fold (poly.polyO ops) (shiftedMO ops B) p hlen,
        shiftedMO_len]
      exact hbound

private theorem shiftDetShapeO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
        (B : List (List γ)) (hsq : rowsLen B.length B) :
    (detO (poly.polyO ops) (shiftedMO ops B)).length = B.length + 1
    ∧ R.rel (ground.getAt ops.unit (detO (poly.polyO ops) (shiftedMO ops B))
        B.length) ops.one := by
  have hid := shiftTermIdO L B hsq
  have hsgn : ∀ X : List γ,
      sgnO (poly.polyO ops) (List.range B.length) X = X := fun X => by
    show (if places.parity (List.range B.length)
      then (poly.polyO ops).swap X else X) = X
    exact if_neg (fun hp => Bool.noConfusion
      ((places.parity_range B.length).symm.trans hp))
  have h1 : (sgnO (poly.polyO ops) (List.range B.length)
      (termO (poly.polyO ops) (shiftedMO ops B)
        (List.range B.length))).length = B.length + 1 := by
    rw [hsgn]
    exact hid.1
  have h2 : R.rel (ground.getAt ops.unit
      (sgnO (poly.polyO ops) (List.range B.length)
        (termO (poly.polyO ops) (shiftedMO ops B) (List.range B.length)))
      B.length) ops.one := by
    rw [hsgn]
    exact hid.2
  have h4 : ∀ q, 0 < ground.countOf q
        (places.monomialsAt (List.replicate B.length 1)) →
      ¬ q = List.range B.length →
      (sgnO (poly.polyO ops) q
        (termO (poly.polyO ops) (shiftedMO ops B) q)).length
        ≤ B.length := by
    intro q hq hne
    have hoff := shiftTermOffO ops B hsq q hq hne
    show (if places.parity q then (poly.polyO ops).swap
        (termO (poly.polyO ops) (shiftedMO ops B) q)
      else termO (poly.polyO ops) (shiftedMO ops B) q).length ≤ B.length
    cases places.parity q with
    | false => exact Nat.le_of_succ_le hoff
    | true =>
      show ((termO (poly.polyO ops) (shiftedMO ops B) q).map
        ops.swap).length ≤ B.length
      rw [show ((termO (poly.polyO ops) (shiftedMO ops B) q).map
          ops.swap).length
          = (termO (poly.polyO ops) (shiftedMO ops B) q).length from
        ground.length_map ops.swap _]
      exact Nat.le_of_succ_le hoff
  show (ground.famFold (poly.polyO ops).add []
        (fun p => sgnO (poly.polyO ops) p
          (termO (poly.polyO ops) (shiftedMO ops B) p))
        (places.monomialsAt
          (List.replicate (shiftedMO ops B).length 1))).length
      = B.length + 1
    ∧ R.rel (ground.getAt ops.unit (ground.famFold (poly.polyO ops).add []
        (fun p => sgnO (poly.polyO ops) p
          (termO (poly.polyO ops) (shiftedMO ops B) p))
        (places.monomialsAt
          (List.replicate (shiftedMO ops B).length 1)))
      B.length) ops.one
  rw [shiftedMO_len]
  exact foldAddPickO L
    (fun p => sgnO (poly.polyO ops) p
      (termO (poly.polyO ops) (shiftedMO ops B) p))
    (List.range B.length) B.length h1 h2
    (places.monomialsAt (List.replicate B.length 1))
    (countOf_range_mon B.length) h4

private theorem monicDropLastOvO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) :
    ∀ (p : List γ) (n : Nat), p.length = n + 1 →
      R.rel (ground.getAt ops.unit p n) ops.one →
      poly.listOV ops R (monicLO ops p.dropLast) p
  | [], _, hl, _ => Nat.noConfusion hl
  | [_], 0, _, ht => ⟨C.ovSymm ht, trivial⟩
  | [_], _ + 1, hl, _ => Nat.noConfusion (Nat.succ.inj hl)
  | _ :: _ :: _, 0, hl, _ => Nat.noConfusion (Nat.succ.inj hl)
  | c :: d :: t, n + 1, hl, ht =>
    ⟨C.ovRefl c,
      monicDropLastOvO C (d :: t) n (Nat.succ.inj hl) ht⟩

private theorem shiftDetMonicO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
        (B : List (List γ)) (hsq : rowsLen B.length B) :
    poly.listOV ops R
      (monicLO ops ((detO (poly.polyO ops) (shiftedMO ops B)).dropLast))
      (detO (poly.polyO ops) (shiftedMO ops B)) :=
  monicDropLastOvO L.toDCore (detO (poly.polyO ops) (shiftedMO ops B))
    B.length (shiftDetShapeO L B hsq).1
    (shiftDetShapeO L B hsq).2


/-! The exact cofactor's soundness (`def:elim`'s fraction-free
step): at a divisor off the sum's unit and a stated product read,
`cofactorAt` returns the further factor's own class.  The route is
the margin — a pair's two members differ by a gap, the gap of a
product is the gaps' product with the side composed by the sign
rule (`ground.crossGap` read at the product's two members), the gap
transports along the one-value class, and the division with
remainder at an exact product answers at the quotient alone
(`ground.divModRead_all`, the three inexact branches refuted by the
ground order). -/

/-- The two gaps never both stand: a pair above and below itself
would move its own member. -/
private theorem gapClash {z : BPair} {g h : Pos}
    (hg : z.snd + g = z.fst) (hh : z.fst + h = z.snd) : False :=
  ground.add_ne_left z.snd (g + h)
    (by rw [← ground.add_assoc, hg, hh])

/-- A gap above and equal members never both stand. -/
private theorem gapEqClash {z : BPair} {g : Pos}
    (hg : z.snd + g = z.fst) (he : z.fst = z.snd) : False :=
  ground.add_ne_left z.snd g (by rw [hg, he])

/-- A gap below and equal members never both stand. -/
private theorem gapEqClashL {z : BPair} {g : Pos}
    (hg : z.fst + g = z.snd) (he : z.fst = z.snd) : False :=
  ground.add_ne_left z.fst g (by rw [hg, he])

/-- Two pairs at one gap above are one value. -/
private theorem ovOfGap {u v : BPair} {g : Pos}
    (hu : u.snd + g = u.fst) (hv : v.snd + g = v.fst) :
    u.oneValue v := by
  show u.fst + v.snd = v.fst + u.snd
  rw [← hu, ← hv, ground.add_right_comm u.snd g v.snd,
    ground.add_right_comm v.snd g u.snd,
    ground.add_comm u.snd v.snd]

/-- Two pairs at one gap below are one value, the swap's own
reading of `ovOfGap`. -/
private theorem ovOfGapL {u v : BPair} {g : Pos}
    (hu : u.fst + g = u.snd) (hv : v.fst + g = v.snd) :
    u.oneValue v :=
  ground.swap_congr (ovOfGap (u := u.swap) (v := v.swap) hu hv)

/-- The ground datum's balance read stands at its own gap above. -/
private theorem ofPos_gap (a : Pos) :
    (BPair.ofPos a).snd + a = (BPair.ofPos a).fst :=
  ground.add_comm Pos.one a

/-- The swapped ground datum's balance read stands at its own gap
below. -/
private theorem ofPos_swap_gap (a : Pos) :
    (BPair.ofPos a).swap.fst + a = (BPair.ofPos a).swap.snd :=
  ground.add_comm Pos.one a

/-- The product's gap above at two factors above: the gaps' own
product, `ground.crossGap` read at the product's two members. -/
private theorem gapMulGG {P X : BPair} {p x : Pos}
    (hp : P.snd + p = P.fst) (hx : X.snd + x = X.fst) :
    (BPair.mul P X).snd + p * x = (BPair.mul P X).fst := by
  show P.fst * X.snd + P.snd * X.fst + p * x
    = P.fst * X.fst + P.snd * X.snd
  exact ground.crossGap hp hx

/-- The product's gap below at a factor above and a factor
below. -/
private theorem gapMulGL {P X : BPair} {p x : Pos}
    (hp : P.snd + p = P.fst) (hx : X.fst + x = X.snd) :
    (BPair.mul P X).fst + p * x = (BPair.mul P X).snd := by
  show P.fst * X.fst + P.snd * X.snd + p * x
    = P.fst * X.snd + P.snd * X.fst
  exact ground.crossGap hp hx

/-- The product's gap below at a factor below and a factor
above. -/
private theorem gapMulLG {P X : BPair} {p x : Pos}
    (hp : P.fst + p = P.snd) (hx : X.snd + x = X.fst) :
    (BPair.mul P X).fst + p * x = (BPair.mul P X).snd := by
  show P.fst * X.fst + P.snd * X.snd + p * x
    = P.fst * X.snd + P.snd * X.fst
  rw [ground.add_comm (P.fst * X.fst) (P.snd * X.snd),
    ground.add_comm (P.fst * X.snd) (P.snd * X.fst)]
  exact ground.crossGap hp hx

/-- The product's gap above at two factors below. -/
private theorem gapMulLL {P X : BPair} {p x : Pos}
    (hp : P.fst + p = P.snd) (hx : X.fst + x = X.snd) :
    (BPair.mul P X).snd + p * x = (BPair.mul P X).fst := by
  show P.fst * X.snd + P.snd * X.fst + p * x
    = P.fst * X.fst + P.snd * X.snd
  rw [ground.add_comm (P.fst * X.snd) (P.snd * X.fst),
    ground.add_comm (P.fst * X.fst) (P.snd * X.snd)]
  exact ground.crossGap hp hx

/-- A stated gap above names the side outright, the gap's
uniqueness and the proof's irrelevance. -/
private theorem side_gt {z : BPair} {g : Pos}
    (hg : z.snd + g = z.fst) : z.side = Trich.gt g hg := by
  cases z.side with
  | eq he => exact (gapEqClash hg he).elim
  | lt g' hg' => exact (gapClash hg hg').elim
  | gt g' hg' =>
    have hgg : g' = g := ground.gap_unique hg' hg
    subst hgg
    rfl

/-- A stated gap below names the side outright. -/
private theorem side_lt {z : BPair} {g : Pos}
    (hg : z.fst + g = z.snd) : z.side = Trich.lt g hg := by
  cases z.side with
  | eq he => exact (gapEqClashL hg he).elim
  | lt g' hg' =>
    have hgg : g' = g := ground.gap_unique hg' hg
    subst hgg
    rfl
  | gt g' hg' => exact (gapClash hg' hg).elim

/-- A product against an occupied count never sits below its own
factor: the ground order's floor at the divisor. -/
private theorem mulGe {p s g : Pos} (h : p * s + g = p) : False := by
  cases ground.trich Pos.one s with
  | eq he =>
    rw [← he, ground.mul_one] at h
    exact ground.add_ne_left p g h
  | lt t ht =>
    rw [← ht, ground.left_distrib, ground.mul_one] at h
    exact ground.add_ne_left p (p * t + g)
      (by rw [← ground.add_assoc]; exact h)
  | gt t ht => exact ground.not_lt_one s ⟨t, ht⟩

/-- The magnitude read at an exact product: the division with
remainder answers at the quotient alone, the two occupied-remainder
branches refuted at the ground order and the vacant read outright
(`ground.divModRead_all`). -/
private theorem cofactorMag_exact {e p x : Pos} (h : p * x = e) :
    cofactorMag e p = some x := by
  have hread := ground.divModRead_all e p
  unfold ground.divModRead at hread
  show (ground.divMod e p).1 = some x
  cases hd : ground.divMod e p with
  | mk o1 o2 =>
    rw [hd] at hread
    cases o1 with
    | none =>
      cases o2 with
      | none => exact (hread : False).elim
      | some r =>
        have h1 : r = e ∧ r < p := hread
        obtain ⟨hre, g, hg⟩ := h1
        exact (mulGe (show p * x + g = p by
          rw [h, ← hre]; exact hg)).elim
    | some q =>
      cases o2 with
      | none =>
        have h1 : p * q = e := hread
        show some q = some x
        rw [ground.cofactor_unique h1 h]
      | some r =>
        have h1 : p * q + r = e ∧ r < p := hread
        obtain ⟨heq, g, hg⟩ := h1
        rw [← h] at heq
        cases ground.trich q x with
        | eq hqx =>
          rw [hqx] at heq
          exact absurd heq (ground.add_ne_left (p * x) r)
        | lt s hs =>
          have h2 : p * q + r = p * q + p * s := by
            rw [heq, ← hs, ground.left_distrib]
          have h3 : r = p * s := ground.add_left_cancel h2
          rw [h3] at hg
          exact (mulGe hg).elim
        | gt s hs =>
          have h2 : p * x + p * s + r = p * x := by
            rw [← ground.left_distrib, hs]
            exact heq
          exact (ground.add_ne_left (p * x) (p * s + r)
            (by rw [← ground.add_assoc]; exact h2)).elim

/-- The cofactor's value at a stated pair above and a divisor
above: the quotient's own one-member site. -/
private theorem cofactorAt_gg {E P : BPair} {e p x : Pos}
    (hEg : E.snd + e = E.fst) (hPg : P.snd + p = P.fst)
    (hpx : p * x = e) : cofactorAt E P = BPair.ofPos x := by
  have hm : cofactorMag e p = some x := cofactorMag_exact hpx
  unfold cofactorAt
  rw [side_gt hEg, side_gt hPg]
  show (match cofactorMag e p with
      | some c => BPair.ofPos c
      | none => BPair.unit) = BPair.ofPos x
  rw [hm]

/-- The cofactor's value at a stated pair above and a divisor
below: the quotient's swapped site. -/
private theorem cofactorAt_gl {E P : BPair} {e p x : Pos}
    (hEg : E.snd + e = E.fst) (hPg : P.fst + p = P.snd)
    (hpx : p * x = e) :
    cofactorAt E P = (BPair.ofPos x).swap := by
  have hm : cofactorMag e p = some x := cofactorMag_exact hpx
  unfold cofactorAt
  rw [side_gt hEg, side_lt hPg]
  show (match cofactorMag e p with
      | some c => (BPair.ofPos c).swap
      | none => BPair.unit) = (BPair.ofPos x).swap
  rw [hm]

/-- The cofactor's value at a stated pair below and a divisor
above: the quotient's swapped site. -/
private theorem cofactorAt_lg {E P : BPair} {e p x : Pos}
    (hEg : E.fst + e = E.snd) (hPg : P.snd + p = P.fst)
    (hpx : p * x = e) :
    cofactorAt E P = (BPair.ofPos x).swap := by
  have hm : cofactorMag e p = some x := cofactorMag_exact hpx
  unfold cofactorAt
  rw [side_lt hEg, side_gt hPg]
  show (match cofactorMag e p with
      | some c => (BPair.ofPos c).swap
      | none => BPair.unit) = (BPair.ofPos x).swap
  rw [hm]

/-- The cofactor's value at a stated pair below and a divisor
below: the quotient's own one-member site. -/
private theorem cofactorAt_ll {E P : BPair} {e p x : Pos}
    (hEg : E.fst + e = E.snd) (hPg : P.fst + p = P.snd)
    (hpx : p * x = e) : cofactorAt E P = BPair.ofPos x := by
  have hm : cofactorMag e p = some x := cofactorMag_exact hpx
  unfold cofactorAt
  rw [side_lt hEg, side_lt hPg]
  show (match cofactorMag e p with
      | some c => BPair.ofPos c
      | none => BPair.unit) = BPair.ofPos x
  rw [hm]

/-- An equal-membered further factor sends the product to the sum's
unit, so the stated product read carries its own value there. -/
private theorem eqMem_of_mul {P X E : BPair} (hxe : X.fst = X.snd)
    (hE : (BPair.mul P X).oneValue E) : E.fst = E.snd :=
  BPair.eqMem_of_oneValue
    (BPair.oneValue_trans (BPair.oneValue_symm hE)
      (BPair.oneValue_trans
        (BPair.mul_congr (BPair.oneValue_refl P)
          (BPair.oneValue_of_eqMem hxe))
        (BPair.mul_unit P)))

/-- `def:elim`'s exact cofactor is sound: at a divisor off the sum's
unit and a stated product read, the divisor against `cofactorAt`
reads the stated pair back.  The further factor's side is forced by
the two stated sides, its gap the stated pair's gap divided by the
divisor's, and the division answers exactly there. -/
private theorem cofactorAt_sound {P X E : BPair}
    (hP : ¬ P.oneValue BPair.unit)
    (hE : (BPair.mul P X).oneValue E) :
    (BPair.mul P (cofactorAt E P)).oneValue E := by
  cases P.side with
  | eq hpe => exact absurd (BPair.oneValue_of_eqMem hpe) hP
  | gt p hp =>
    cases E.side with
    | eq hee =>
      rw [cofactorAt_eqMem E P hee]
      exact BPair.oneValue_trans (BPair.mul_unit P)
        (BPair.oneValue_symm (BPair.oneValue_of_eqMem hee))
    | gt e he =>
      cases X.side with
      | eq hxe => exact (gapEqClash he (eqMem_of_mul hxe hE)).elim
      | gt x hx =>
        have hpx : p * x = e :=
          ground.gap_unique (ground.gapCongr hE (gapMulGG hp hx)) he
        rw [cofactorAt_gg he hp hpx]
        exact BPair.oneValue_trans
          (BPair.mul_congr (BPair.oneValue_refl P)
            (ovOfGap (ofPos_gap x) hx)) hE
      | lt x hx =>
        exact (gapClash he (ground.gapCongrL hE (gapMulGL hp hx))).elim
    | lt e he =>
      cases X.side with
      | eq hxe => exact (gapEqClashL he (eqMem_of_mul hxe hE)).elim
      | gt x hx =>
        exact (gapClash (ground.gapCongr hE (gapMulGG hp hx)) he).elim
      | lt x hx =>
        have hpx : p * x = e :=
          ground.gap_unique (ground.gapCongrL hE (gapMulGL hp hx)) he
        rw [cofactorAt_lg he hp hpx]
        exact BPair.oneValue_trans
          (BPair.mul_congr (BPair.oneValue_refl P)
            (ovOfGapL (ofPos_swap_gap x) hx)) hE
  | lt p hp =>
    cases E.side with
    | eq hee =>
      rw [cofactorAt_eqMem E P hee]
      exact BPair.oneValue_trans (BPair.mul_unit P)
        (BPair.oneValue_symm (BPair.oneValue_of_eqMem hee))
    | gt e he =>
      cases X.side with
      | eq hxe => exact (gapEqClash he (eqMem_of_mul hxe hE)).elim
      | lt x hx =>
        have hpx : p * x = e :=
          ground.gap_unique (ground.gapCongr hE (gapMulLL hp hx)) he
        rw [cofactorAt_gl he hp hpx]
        exact BPair.oneValue_trans
          (BPair.mul_congr (BPair.oneValue_refl P)
            (ovOfGapL (ofPos_swap_gap x) hx)) hE
      | gt x hx =>
        exact (gapClash he (ground.gapCongrL hE (gapMulLG hp hx))).elim
    | lt e he =>
      cases X.side with
      | eq hxe => exact (gapEqClashL he (eqMem_of_mul hxe hE)).elim
      | lt x hx =>
        exact (gapClash (ground.gapCongr hE (gapMulLL hp hx)) he).elim
      | gt x hx =>
        have hpx : p * x = e :=
          ground.gap_unique (ground.gapCongrL hE (gapMulLG hp hx)) he
        rw [cofactorAt_ll he hp hpx]
        exact BPair.oneValue_trans
          (BPair.mul_congr (BPair.oneValue_refl P)
            (ovOfGap (ofPos_gap x) hx)) hE

/-! `def:elim`'s bordered sublists: the pivot descent's minors as
explicit key-list selections, the leading keys carrying the border
key at the end of each list. -/

/-- The columns kept at a stated key list. -/
private def keepCols (ks : List Nat) (r : List BPair) : List BPair :=
  ks.map (fun j => ground.getAt BPair.unit r j)

/-- The pivot-bordered sublist: rows the leading keys with the
border row, columns the leading keys with the border column. -/
def borderAt (k i j : Nat) (m : Mat) : Mat :=
  ((List.range k) ++ [i]).map (fun a =>
    keepCols ((List.range k) ++ [j]) (ground.getAt [] m a))

/-- The leading sublist at the stated key count. -/
def leadAt (k : Nat) (m : Mat) : Mat :=
  (List.range k).map (fun a =>
    keepCols (List.range k) (ground.getAt [] m a))

/-- The kept columns read the key list's own width. -/
private theorem keepCols_len (ks : List Nat) (r : List BPair) :
    (keepCols ks r).length = ks.length := by
  show ((ks.map (fun j => ground.getAt BPair.unit r j))).length
    = ks.length
  rw [ground.length_map]

/-- The kept columns' entry read: the source entry at the key. -/
private theorem keepCols_entry (ks : List Nat) (r : List BPair)
    (b : Nat) (hb : b < ks.length) :
    ground.getAt BPair.unit (keepCols ks r) b
      = ground.getAt BPair.unit r (ground.getAt 0 ks b) := by
  show ground.getAt BPair.unit
    (ks.map (fun j => ground.getAt BPair.unit r j)) b = _
  rw [ground.getAt_map 0 BPair.unit _ ks b hb]

/-- The bordered key list's read: the leading keys their own, the
last key the border. -/
private theorem borderKeys (K x a : Nat) (ha : a < K + 1) :
    ground.getAt 0 (List.range K ++ [x]) a
      = if a < K then a else x := by
  rw [ground.getAt_append 0 (List.range K) [x] a, ground.length_range]
  by_cases h : a < K
  · rw [if_pos h, if_pos h, ground.getAt_range K a h]
  · rw [if_neg h, if_neg h,
      show a - K = 0 from by
        rw [show a = K from
          Nat.le_antisymm (Nat.le_of_succ_le_succ ha)
            (Nat.le_of_not_lt h),
          Nat.sub_self]]
    rfl

/-- The bordered key list's width. -/
private theorem borderKeys_len (K x : Nat) :
    (List.range K ++ [x]).length = K + 1 := by
  rw [ground.length_append, ground.length_range]
  rfl

/-- The bordered sublist's row count. -/
private theorem borderAt_len (k i j : Nat) (m : Mat) :
    (borderAt k i j m).length = k + 1 := by
  show (((List.range k) ++ [i]).map (fun a =>
    keepCols ((List.range k) ++ [j]) (ground.getAt [] m a))).length
    = k + 1
  rw [ground.length_map, borderKeys_len]

/-- Every row of the bordered sublist reads the key count. -/
private theorem borderAt_rows (k i j : Nat) (m : Mat) :
    rowsLen (k + 1) (borderAt k i j m) :=
  rowsLen_map _ (k + 1) (List.range k ++ [i]) (fun x _ => (fun _ => by rw [keepCols_len, borderKeys_len]) x)

/-- The bordered sublist's row at a key. -/
private theorem borderAt_row (k i j : Nat) (m : Mat) (a : Nat)
    (ha : a < k + 1) :
    ground.getAt [] (borderAt k i j m) a
      = keepCols ((List.range k) ++ [j])
        (ground.getAt [] m (if a < k then a else i)) := by
  show ground.getAt [] (((List.range k) ++ [i]).map (fun a =>
    keepCols ((List.range k) ++ [j]) (ground.getAt [] m a))) a = _
  rw [ground.getAt_map 0 [] _ (List.range k ++ [i]) a
      (by rw [borderKeys_len]; exact ha),
    borderKeys k i a ha]

/-- The bordered sublist's entry read: the source entry at the row
and column keys, each the leading key below the count and the
border key at it. -/
private theorem borderAt_entry (k i j : Nat) (m : Mat) (a b : Nat)
    (ha : a < k + 1) (hb : b < k + 1) :
    ground.getAt BPair.unit
        (ground.getAt [] (borderAt k i j m) a) b
      = ground.getAt BPair.unit
        (ground.getAt [] m (if a < k then a else i))
        (if b < k then b else j) := by
  rw [borderAt_row k i j m a ha,
    keepCols_entry _ _ b (by rw [borderKeys_len]; exact hb),
    borderKeys k j b hb]

/-- The leading sublist's row count. -/
private theorem leadAt_len (k : Nat) (m : Mat) :
    (leadAt k m).length = k :=
  ground.matOf_length k k _

/-! The bordered tier's own carrier kit: the entry read through an
erasure, the pairing's commutation and its unit-family reads, the
determinant's entrywise congruence, and the row-replacement's
pairing spelling — every one at the parametrized bundle, the
polynomial carrier the consumer. -/

/-- The entry read through an erasure: below the struck key its
own, at or above it the successor's. -/
private theorem getAt_eraseIdx {α : Type} (d : α) :
    ∀ (l : List α) (j c : Nat),
      ground.getAt d (l.eraseIdx j) c
        = if c < j then ground.getAt d l c
          else ground.getAt d l (c + 1)
  | [], j, c => by
    show ground.getAt d ([] : List α) c
      = if c < j then ground.getAt d ([] : List α) c
        else ground.getAt d ([] : List α) (c + 1)
    by_cases h : c < j
    · rw [if_pos h]
    · rw [if_neg h]
      rfl
  | a :: t, 0, c => by
    show ground.getAt d t c
      = if c < 0 then ground.getAt d (a :: t) c
        else ground.getAt d (a :: t) (c + 1)
    rw [if_neg (Nat.not_lt_zero c)]
    rfl
  | a :: t, j + 1, 0 => by
    show a = if 0 < j + 1 then a else ground.getAt d t 0
    rw [if_pos (Nat.succ_pos j)]
  | a :: t, j + 1, c + 1 => by
    show ground.getAt d (t.eraseIdx j) c
      = if c + 1 < j + 1 then ground.getAt d t c
        else ground.getAt d t (c + 1)
    rw [getAt_eraseIdx d t j c]
    by_cases h : c < j
    · rw [if_pos h, if_pos (Nat.succ_lt_succ h)]
    · rw [if_neg h, if_neg (fun hs => h (Nat.lt_of_succ_lt_succ hs))]

/-- The pairing against a unit-family read: one key at the
product's unit and the further keys at the sum's, the pairing the
further factor's own entry there. -/
private theorem dotO_unitRead {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ∀ (v w : List γ) (c : Nat), v.length = w.length →
      R.rel (ground.getAt ops.unit v c) ops.one →
      (∀ b, ¬ b = c → R.rel (ground.getAt ops.unit v b) ops.unit) →
      R.rel (dotO ops v w) (ground.getAt ops.unit w c)
  | [], [], _, _, _, _ => L.ovRefl _
  | [], _ :: _, _, hl, _, _ => nomatch hl
  | _ :: _, [], _, hl, _, _ => nomatch hl
  | a :: v, b :: w, 0, _, hc, hr => by
    show R.rel (ops.add (ops.mul a b) (dotO ops v w)) b
    refine L.ovTrans (L.addCongr
      (L.ovTrans (L.mulCongr hc (L.ovRefl b)) (L.oneMul b))
      (dotO_null_left L v w
        (fun t => hr (t + 1) (fun he => Nat.noConfusion he)))) ?_
    exact L.addUnit b
  | a :: v, b :: w, c + 1, hl, hc, hr => by
    show R.rel (ops.add (ops.mul a b) (dotO ops v w))
      (ground.getAt ops.unit w c)
    refine L.ovTrans (L.addCongr
      (L.ovTrans (L.mulCongr (hr 0 (fun he => Nat.noConfusion he))
        (L.ovRefl b)) (mulUnitLeftO L b))
      (dotO_unitRead L v w c (Nat.succ.inj hl) hc
        (fun t ht => hr (t + 1)
          (fun he => ht (Nat.succ.inj he))))) ?_
    exact L.unitAdd _

/-- An even crossing count reads the datum back. -/
private theorem sgnPO_even {γ : Type} (ops : DOps γ) (e : Nat)
    (x : γ) : sgnPO ops (e + e) x = x := by
  show (if places.parityOf (e + e) then ops.swap x else x) = x
  rw [show places.parityOf (e + e) = false from by
    rw [places.parityOf_add e e]
    cases places.parityOf e with
    | true => rfl
    | false => rfl]
  exact if_neg (fun hb => Bool.noConfusion hb)

/-- The determinant's entrywise congruence: two families of one row
count agreeing at every key inside the square read one value. -/
private theorem detO_congr_letters {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel)
    (M N : List (List γ)) (hl : M.length = N.length)
    (h : ∀ a, a < M.length → ∀ b, b < M.length →
      R.rel (ground.getAt ops.unit (ground.getAt [] M a) b)
        (ground.getAt ops.unit (ground.getAt [] N a) b)) :
    R.rel (detO ops M) (detO ops N) := by
  show R.rel (ground.famFold ops.add ops.unit
      (fun p => sgnO ops p (termO ops M p))
      (places.monomialsAt (List.replicate M.length 1)))
    (ground.famFold ops.add ops.unit
      (fun p => sgnO ops p (termO ops N p))
      (places.monomialsAt (List.replicate N.length 1)))
  rw [← hl]
  refine foldO_congr_members C _ _ _ (fun p hp => ?_)
  exact sgnO_congr C p
    (termO_congr_letters C M.length M N p hl h
      (fun x hx => (places.perm_member_reads hp).2.2.1 x hx))

/-- The replaced row's determinant is the replacement against the
row's cofactor vector, the expansion read as one pairing. -/
private theorem detO_List.set_dot {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (m : List (List γ)) (k : Nat) (hk : k < m.length) (b : List γ)
    (hb : b.length = m.length) :
    R.rel (detO ops (List.set m k b)) (dotO ops b (cofVecO ops m k)) := by
  refine L.ovTrans (detO_replace L m k hk b) ?_
  rw [show ((m.eraseIdx k).length + 1) = m.length from
    length_eraseIdx m k hk]
  refine L.ovTrans (foldO_congr_members L.toDCore _
    (fun j => ops.mul (ground.getAt ops.unit b j)
      (sgnPO ops (k + j) (cof0O ops (m.eraseIdx k) j)))
    (List.range m.length)
    (fun j _ => sgnPO_mul L.toDCore (k + j) _ _)) ?_
  show R.rel _ (dotO ops b ((List.range m.length).map
    (fun j => sgnPO ops (k + j) (cof0O ops (m.eraseIdx k) j))))
  rw [dotO_map_range ops
    (fun j => sgnPO ops (k + j) (cof0O ops (m.eraseIdx k) j))
    m.length b hb]
  exact L.ovRefl _

/-- The head cofactor at the last column is the struck family's own
determinant: the avoided key's content carries a vacant tail, so
the two enumerations are one family and the terms read the kept
columns alone. -/
private theorem cof0O_last {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel)
    (rest : List (List γ)) :
    R.rel (cof0O ops rest rest.length)
      (detO ops (rest.map (fun r => r.eraseIdx rest.length))) := by
  show R.rel (ground.famFold ops.add ops.unit
      (fun t => sgnO ops t (termO ops rest t))
      (places.monomialsAt (subContent rest.length rest.length)))
    (ground.famFold ops.add ops.unit
      (fun t => sgnO ops t (termO ops
        (rest.map (fun r => r.eraseIdx rest.length)) t))
      (places.monomialsAt (List.replicate
        (rest.map (fun r => r.eraseIdx rest.length)).length 1)))
  rw [ground.length_map,
    show subContent rest.length rest.length
        = List.replicate rest.length 1 ++ [0] from by
      show List.replicate rest.length 1
          ++ 0 :: List.replicate (rest.length - rest.length) 1
        = List.replicate rest.length 1 ++ [0]
      rw [Nat.sub_self]
      rfl,
    places.monomialsAt_zero_tail (List.replicate rest.length 1)]
  refine foldO_congr_members C _ _ _ (fun t ht => ?_)
  refine sgnO_congr C t ?_
  refine termO_congr_letters C rest.length rest _ t
    (by rw [ground.length_map]) (fun a ha b hb => ?_)
    (fun x hx => (places.perm_member_reads ht).2.2.1 x hx)
  rw [ground.getAt_map ([] : List γ) ([] : List γ)
      (fun r => r.eraseIdx rest.length) rest a ha,
    getAt_eraseIdx ops.unit (ground.getAt [] rest a) rest.length b,
    if_pos hb]
  exact C.ovRefl _

/-- The letter collapse at a struck key: the earlier letters kept,
the later ones stepped down. -/
private def dropIx (j x : Nat) : Nat := if x < j then x else x - 1

/-- The letter lift at a struck key, the collapse's witness. -/
private def liftIx (j x : Nat) : Nat := if x < j then x else x + 1

private theorem liftIx_ne (j y : Nat) : ¬ liftIx j y = j := by
  show ¬ (if y < j then y else y + 1) = j
  by_cases hy : y < j
  · rw [if_pos hy]
    exact fun he => Nat.lt_irrefl j (he ▸ hy)
  · rw [if_neg hy]
    exact fun he => hy (he ▸ Nat.lt_succ_of_le (Nat.le_refl y))

private theorem liftIx_gt (j y : Nat) (hy : ¬ y < j) :
    liftIx j y = y + 1 := by
  show (if y < j then y else y + 1) = y + 1
  rw [if_neg hy]

private theorem dropIx_liftIx (j y : Nat) :
    dropIx j (liftIx j y) = y := by
  show dropIx j (if y < j then y else y + 1) = y
  by_cases hy : y < j
  · rw [if_pos hy]
    show (if y < j then y else y - 1) = y
    rw [if_pos hy]
  · rw [if_neg hy]
    show (if y + 1 < j then y + 1 else y + 1 - 1) = y
    rw [if_neg (fun h => hy
      (Nat.lt_of_le_of_lt (Nat.le_succ y) h))]
    rfl

private theorem gt_of_ne_nlt {x j : Nat} (hx : ¬ x = j)
    (hlt : ¬ x < j) : j < x :=
  match Nat.lt_or_ge j x with
  | .inl h => h
  | .inr h => absurd (Nat.lt_of_le_of_ne h (fun he => hx he)) hlt

private theorem dropIx_gt {j x : Nat} (hj : j < x) {g : Nat}
    (hg : j + 1 + g = x) : dropIx j x = j + g := by
  show (if x < j then x else x - 1) = j + g
  rw [if_neg (fun h => Nat.lt_irrefl j (Nat.lt_trans hj h)),
    ← hg, Nat.succ_add j g]
  rfl

private theorem liftIx_dropIx (j x : Nat) (hx : ¬ x = j) :
    liftIx j (dropIx j x) = x := by
  by_cases hlt : x < j
  · show liftIx j (if x < j then x else x - 1) = x
    rw [if_pos hlt]
    show (if x < j then x else x + 1) = x
    rw [if_pos hlt]
  · have hj : j < x := gt_of_ne_nlt hx hlt
    match Nat.le.dest hj with
    | ⟨g, hg⟩ =>
      rw [dropIx_gt hj hg]
      show (if j + g < j then j + g else j + g + 1) = x
      rw [if_neg (fun h => Nat.lt_irrefl j
          (Nat.lt_of_le_of_lt (Nat.le_add_right j g) h)),
        ← hg, Nat.succ_add j g]

private theorem dropIx_lt_up (j a b : Nat) (ha : ¬ a = j)
    (hb : ¬ b = j) (hab : a < b) : dropIx j a < dropIx j b := by
  by_cases haj : a < j
  · show (if a < j then a else a - 1) < dropIx j b
    rw [if_pos haj]
    by_cases hbj : b < j
    · show a < (if b < j then b else b - 1)
      rw [if_pos hbj]
      exact hab
    · have hjb : j < b := gt_of_ne_nlt hb hbj
      match Nat.le.dest hjb with
      | ⟨g, hg⟩ =>
        rw [dropIx_gt hjb hg]
        exact Nat.lt_of_lt_of_le haj (Nat.le_add_right j g)
  · have hja : j < a := gt_of_ne_nlt ha haj
    have hjb : j < b := Nat.lt_trans hja hab
    match Nat.le.dest hja, Nat.le.dest hjb with
    | ⟨g, hg⟩, ⟨g2, hg2⟩ =>
      rw [dropIx_gt hja hg, dropIx_gt hjb hg2]
      have hlt : j + 1 + g < j + 1 + g2 := by
        rw [hg, hg2]
        exact hab
      have h2 : g < g2 := Nat.lt_of_add_lt_add_left hlt
      exact Nat.add_lt_add_left h2 j

private theorem dropIx_lt_down (j a b : Nat) (ha : ¬ a = j)
    (hb : ¬ b = j) (hf : dropIx j a < dropIx j b) : a < b :=
  match Nat.lt_or_ge a b with
  | .inl h => h
  | .inr h =>
    match Nat.lt_or_ge b a with
    | .inl h2 => absurd (dropIx_lt_up j b a hb ha h2)
        (fun hc => Nat.lt_irrefl _ (Nat.lt_trans hc hf))
    | .inr h2 =>
      absurd (Nat.le_antisymm h2 h ▸ hf) (Nat.lt_irrefl _)

private theorem subContent_at_j (j g : Nat) :
    ground.getAt 0 (subContent j (j + g)) j = 0 := by
  show ground.getAt 0 (List.replicate j 1
    ++ 0 :: List.replicate (j + g - j) 1) j = 0
  rw [ground.getAt_append 0 _ _ j,
    if_neg (by
      rw [ground.length_replicate]
      exact Nat.lt_irrefl j),
    ground.length_replicate, Nat.sub_self]
  rfl

private theorem subContent_at_ne (j g z : Nat) (hz : ¬ z = j)
    (hzn : z < j + g + 1) :
    ground.getAt 0 (subContent j (j + g)) z = 1 := by
  show ground.getAt 0 (List.replicate j 1
    ++ 0 :: List.replicate (j + g - j) 1) z = 1
  rw [ground.getAt_append 0 _ _ z, ground.length_replicate,
    ground.addSubSelfL j g]
  by_cases hlt : z < j
  · rw [if_pos hlt]
    exact ground.getAt_replicate 0 1 j z hlt
  · rw [if_neg hlt]
    have hjz : j < z := gt_of_ne_nlt hz hlt
    match Nat.le.dest hjz with
    | ⟨c, hc⟩ =>
      have hzj : z - j = c + 1 := by
        rw [← hc, Nat.succ_add j c, ← Nat.add_succ j c,
          ground.addSubSelfL j (c + 1)]
      rw [hzj]
      show ground.getAt 0 (List.replicate g 1) c = 1
      refine ground.getAt_replicate 0 1 g c ?_
      have h1 : j + 1 + c < j + 1 + g := by
        rw [hc, Nat.add_right_comm j 1 g]
        exact hzn
      exact Nat.lt_of_add_lt_add_left h1

/-- The letter lift at the successor keys, one step up. -/
private theorem liftIx_succ (i c : Nat) :
    liftIx (i + 1) (c + 1) = liftIx i c + 1 := by
  show (if c + 1 < i + 1 then c + 1 else c + 1 + 1)
    = (if c < i then c else c + 1) + 1
  by_cases h : c < i
  · rw [if_pos h, if_pos (Nat.succ_lt_succ h)]
  · rw [if_neg h, if_neg (fun hc => h (Nat.lt_of_succ_lt_succ hc))]

/-- The lifted key's entry read through an erasure. -/
private theorem getAt_eraseIdx_lift {α : Type} (d : α)
    (l : List α) (j c : Nat) :
    ground.getAt d (l.eraseIdx j) c
      = ground.getAt d l (liftIx j c) := by
  rw [getAt_eraseIdx d l j c]
  show _ = ground.getAt d l (if c < j then c else c + 1)
  by_cases hc : c < j
  · rw [if_pos hc, if_pos hc]
  · rw [if_neg hc, if_neg hc]

/-- The lifted key stays inside the wider count. -/
private theorem liftIx_lt {j c n : Nat} (h : c < n) :
    liftIx j c < n + 1 := by
  by_cases hc : c < j
  · rw [show liftIx j c = c from if_pos hc]
    exact Nat.lt_trans h (Nat.lt_succ_self n)
  · rw [liftIx_gt j c hc]
    exact Nat.succ_lt_succ h

/-- The collapse then the lift reads the list back. -/
private theorem mapDropLift (j : Nat) :
    ∀ x : List Nat, (x.map (liftIx j)).map (dropIx j) = x
  | [] => rfl
  | a :: x => by
    show dropIx j (liftIx j a) :: (x.map (liftIx j)).map (dropIx j)
      = a :: x
    rw [dropIx_liftIx, mapDropLift j x]

/-- The lift then the collapse reads a struck-key-free list
back. -/
private theorem mapLiftDrop (j : Nat) :
    ∀ x : List Nat, (∀ a, 0 < ground.countOf a x → ¬ a = j) →
      (x.map (dropIx j)).map (liftIx j) = x
  | [], _ => rfl
  | a :: x, h => by
    show liftIx j (dropIx j a) :: (x.map (dropIx j)).map (liftIx j)
      = a :: x
    rw [liftIx_dropIx j a (h a (by
        rw [ground.countOf_head]; exact Nat.succ_pos _)),
      mapLiftDrop j x (fun c hc => h c
        (Nat.lt_of_lt_of_le hc (Nat.le_add_left _ _)))]

/-- The struck content's degree is the row count. -/
private theorem sumNat_subContent (j g : Nat) :
    ground.sumNat (subContent j (j + g)) = j + g := by
  show ground.sumNat (List.replicate j 1
    ++ 0 :: List.replicate (j + g - j) 1) = j + g
  exact ground.sumNat_replicate_strike j (j + g) (Nat.le_add_right j g)

/-- The grading reads across the collapse: the map is strictly
monotone at the struck-key-free letters, every place pair's
comparison kept. -/
private theorem parity_mapDrop (j : Nat) (t : List Nat)
    (h : ∀ a, 0 < ground.countOf a t → ¬ a = j) :
    places.parity (t.map (dropIx j)) = places.parity t := by
  show places.parityOf (places.inversions (t.map (dropIx j))) = _
  rw [places.inversions_map (dropIx j) t (fun a ha b hb =>
    ⟨fun hab => dropIx_lt_up j a b (h a ha) (h b hb) hab,
     fun hf => dropIx_lt_down j a b (h a ha) (h b hb) hf⟩)]
  rfl

/-- The term at the struck family and the collapsed letters is the
term at the source, entry for entry. -/
private theorem termO_strike {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) (j : Nat) :
    ∀ (M : List (List γ)) (t : List Nat),
      (∀ x, 0 < ground.countOf x t → ¬ x = j) →
      R.rel (termO ops (M.map (fun r => r.eraseIdx j))
          (t.map (dropIx j)))
        (termO ops M t)
  | [], [], _ => C.ovRefl _
  | [], _ :: _, _ => C.ovRefl _
  | _ :: _, [], _ => C.ovRefl _
  | r :: M, x :: t, h => by
    show R.rel (ops.mul
        (ground.getAt ops.unit (r.eraseIdx j) (dropIx j x))
        (termO ops (M.map (fun r => r.eraseIdx j))
          (t.map (dropIx j))))
      (ops.mul (ground.getAt ops.unit r x) (termO ops M t))
    have hx : ¬ x = j := h x (by
      rw [ground.countOf_head]; exact Nat.succ_pos _)
    have hentry : ground.getAt ops.unit (r.eraseIdx j) (dropIx j x)
        = ground.getAt ops.unit r x := by
      rw [getAt_eraseIdx ops.unit r j (dropIx j x)]
      by_cases hlt : x < j
      · rw [show dropIx j x = x from if_pos hlt, if_pos hlt]
      · have hj : j < x := gt_of_ne_nlt hx hlt
        match Nat.le.dest hj with
        | ⟨g, hg⟩ =>
          rw [dropIx_gt hj hg,
            if_neg (fun hc => Nat.lt_irrefl j
              (Nat.lt_of_le_of_lt (Nat.le_add_right j g) hc)),
            ← hg, Nat.succ_add j g]
    rw [hentry]
    exact C.mulCongr (C.ovRefl _)
      (termO_strike C j M t (fun c hc => h c
        (Nat.lt_of_lt_of_le hc (Nat.le_add_left _ _))))

/-- A member of the struck enumeration reads no letter at the
struck key. -/
private theorem strikeMem_ne (j g : Nat) {t : List Nat}
    (ht : 0 < ground.countOf t
      (places.monomialsAt (subContent j (j + g)))) :
    ∀ a, 0 < ground.countOf a t → ¬ a = j := by
  intro a ha he
  have h0 := places.letter_zero (subContent j (j + g)) j
    (subContent_at_j j g) t ht
  rw [he] at ha
  rw [h0] at ha
  exact absurd ha (Nat.lt_irrefl 0)

/-- The lifted list of a straight member sits in the struck
enumeration: the length keeps and the content reads the struck
occupancy, the struck key vacant and every further key once. -/
private theorem liftMem (j g : Nat) {x : List Nat}
    (hx : x.length = ground.sumNat (List.replicate (j + g) 1)
      ∧ places.content (j + g) x = List.replicate (j + g) 1) :
    (x.map (liftIx j)).length
        = ground.sumNat (subContent j (j + g))
      ∧ places.content (subContent j (j + g)).length
          (x.map (liftIx j)) = subContent j (j + g) := by
  have hn : ground.sumNat (List.replicate (j + g) 1) = j + g :=
    ground.sumNat_replicate_one (j + g)
  have hlen : (subContent j (j + g)).length = j + g + 1 := by
    show (List.replicate j 1
      ++ 0 :: List.replicate (j + g - j) 1).length = j + g + 1
    rw [ground.length_append, ground.length_replicate,
      ground.addSubSelfL j g]
    show j + ((List.replicate g 1).length + 1) = j + g + 1
    rw [ground.length_replicate]
    exact (Nat.add_assoc j g 1).symm
  refine ⟨?_, ?_⟩
  · rw [ground.length_map, hx.1, hn, sumNat_subContent j g]
  · rw [hlen]
    refine ground.getAt_ext 0 _ _ ?_ ?_
    · rw [places.content_length]
      show j + g + 1 = (List.replicate j 1
        ++ 0 :: List.replicate (j + g - j) 1).length
      rw [ground.length_append, ground.length_replicate,
        ground.addSubSelfL j g]
      show j + g + 1 = j + ((List.replicate g 1).length + 1)
      rw [ground.length_replicate]
      exact Nat.add_assoc j g 1
    · intro z hz
      rw [places.content_length] at hz
      rw [places.getAt_contentAt (j + g + 1) (x.map (liftIx j)) z hz]
      by_cases hzj : z = j
      · rw [hzj, ground.countOf_map_none (liftIx j) j x
          (fun c _ => liftIx_ne j c), subContent_at_j j g]
      · have hdz : liftIx j (dropIx j z) = z := liftIx_dropIx j z hzj
        rw [← hdz, ground.countOf_map_inj (liftIx j) (dropIx j z) x
            (fun c _ he => by
              rw [← dropIx_liftIx j c, he, dropIx_liftIx]),
          hdz, subContent_at_ne j g z hzj hz]
        have hdlt : dropIx j z < j + g := by
          by_cases hlt : z < j
          · rw [show dropIx j z = z from if_pos hlt]
            exact Nat.lt_of_lt_of_le hlt (Nat.le_add_right j g)
          · have hjz : j < z := gt_of_ne_nlt hzj hlt
            match Nat.le.dest hjz with
            | ⟨c, hc⟩ =>
              rw [dropIx_gt hjz hc]
              have h1 : j + 1 + c < j + g + 1 := by rw [hc]; exact hz
              rw [Nat.add_right_comm j 1 c] at h1
              exact Nat.lt_of_succ_lt_succ h1
        rw [← places.getAt_contentAt (j + g) x (dropIx j z) hdlt,
          hx.2, ground.getAt_replicate 0 1 (j + g) (dropIx j z)
            hdlt]

/-- The collapsed list of a struck-enumeration member is a
straight member: the length keeps and every letter reads once. -/
private theorem dropMem (j g : Nat) {t : List Nat}
    (ht : 0 < ground.countOf t
      (places.monomialsAt (subContent j (j + g)))) :
    (t.map (dropIx j)).length
        = ground.sumNat (List.replicate (j + g) 1)
      ∧ places.content (j + g) (t.map (dropIx j))
          = List.replicate (j + g) 1 := by
  have hne := strikeMem_ne j g ht
  match places.member_conditions ht with
  | ⟨hl, hc⟩ =>
    have hlen : (subContent j (j + g)).length = j + g + 1 := by
      show (List.replicate j 1
        ++ 0 :: List.replicate (j + g - j) 1).length = j + g + 1
      rw [ground.length_append, ground.length_replicate,
        ground.addSubSelfL j g]
      show j + ((List.replicate g 1).length + 1) = j + g + 1
      rw [ground.length_replicate]
      exact (Nat.add_assoc j g 1).symm
    refine ⟨?_, ?_⟩
    · rw [ground.length_map, hl, sumNat_subContent j g,
        ground.sumNat_replicate_one]
    · refine ground.getAt_ext 0 _ _ ?_ ?_
      · rw [places.content_length, ground.length_replicate]
      · intro y hy
        rw [places.content_length] at hy
        rw [places.getAt_contentAt (j + g) (t.map (dropIx j)) y hy,
          ground.getAt_replicate 0 1 (j + g) y hy]
        have hld : dropIx j (liftIx j y) = y := dropIx_liftIx j y
        rw [← hld, ground.countOf_map_inj (dropIx j) (liftIx j y) t
            (fun c hcm he => by
              rw [← liftIx_dropIx j c (hne c hcm), he,
                dropIx_liftIx])]
        have hlift_lt : liftIx j y < j + g + 1 := liftIx_lt hy
        rw [← places.getAt_contentAt (j + g + 1) t (liftIx j y)
            hlift_lt]
        rw [show places.content (j + g + 1) t
            = subContent j (j + g) from by
          rw [← hlen]; exact hc]
        exact subContent_at_ne j g (liftIx j y) (liftIx_ne j y)
          hlift_lt

/-- The struck enumeration's collapse lists the straight
enumeration member for member: the counts agree at every list. -/
private theorem countOf_mapDrop (j g : Nat) (x : List Nat) :
    ground.countOf x
        ((places.monomialsAt (subContent j (j + g))).map
          (List.map (dropIx j)))
      = ground.countOf x
          (places.monomialsAt (List.replicate (j + g) 1)) := by
  rw [places.countOf_monomialsAt (List.replicate (j + g) 1) x,
    ground.length_replicate]
  by_cases hxB : x.length
      = ground.sumNat (List.replicate (j + g) 1)
    ∧ places.content (j + g) x = List.replicate (j + g) 1
  · rw [if_pos hxB]
    have htA := liftMem j g hxB
    have hx : (x.map (liftIx j)).map (dropIx j) = x :=
      mapDropLift j x
    rw [← hx,
      ground.countOf_map_inj (List.map (dropIx j))
        (x.map (liftIx j))
        (places.monomialsAt (subContent j (j + g)))
        (fun t htm he => by
          have hnet := strikeMem_ne j g htm
          rw [← mapLiftDrop j t hnet, he, mapDropLift j x]),
      places.countOf_monomialsAt, if_pos htA]
  · rw [if_neg hxB]
    refine ground.countOf_map_none (List.map (dropIx j)) x
      (places.monomialsAt (subContent j (j + g)))
      (fun t htm he => hxB ?_)
    rw [← he]
    exact dropMem j g htm

/-- The head cofactor at every key inside the width is the
struck family's determinant: the tex's collection at the dropped
key, the enumeration reindexed along the letter collapse with the
grading kept. -/
private theorem cof0O_strike {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel)
    (rest : List (List γ)) (j : Nat) (hj : j ≤ rest.length) :
    R.rel (cof0O ops rest j)
      (detO ops (rest.map (fun r => r.eraseIdx j))) := by
  match Nat.le.dest hj with
  | ⟨g, hg⟩ =>
    show R.rel (ground.famFold ops.add ops.unit
        (fun t => sgnO ops t (termO ops rest t))
        (places.monomialsAt (subContent j rest.length)))
      (ground.famFold ops.add ops.unit
        (fun t => sgnO ops t (termO ops
          (rest.map (fun r => r.eraseIdx j)) t))
        (places.monomialsAt (List.replicate
          (rest.map (fun r => r.eraseIdx j)).length 1)))
    rw [ground.length_map, ← hg]
    refine C.ovTrans (foldO_congr_members C _
      (fun t => sgnO ops (t.map (dropIx j)) (termO ops
        (rest.map (fun r => r.eraseIdx j)) (t.map (dropIx j))))
      (places.monomialsAt (subContent j (j + g)))
      (fun t htm => ?_)) ?_
    · have hnet := strikeMem_ne j g htm
      have h1 := termO_strike C j rest t hnet
      show R.rel (if places.parity t then
          ops.swap (termO ops rest t) else termO ops rest t)
        (if places.parity (t.map (dropIx j)) then
          ops.swap (termO ops (rest.map (fun r => r.eraseIdx j))
            (t.map (dropIx j)))
          else termO ops (rest.map (fun r => r.eraseIdx j))
            (t.map (dropIx j)))
      rw [parity_mapDrop j t hnet]
      cases places.parity t with
      | true => exact C.swapCongr (C.ovSymm h1)
      | false => exact C.ovSymm h1
    · rw [← ground.famFold_map ops.add ops.unit
        (fun t => sgnO ops t (termO ops
          (rest.map (fun r => r.eraseIdx j)) t))
        (List.map (dropIx j))
        (places.monomialsAt (subContent j (j + g)))]
      exact ground.famFold_relist_ov (commLawsOf C) ops.unit
        (fun t => sgnO ops t (termO ops
          (rest.map (fun r => r.eraseIdx j)) t))
        _ _ (fun x => countOf_mapDrop j g x)

/-- The empty list's determinant is the product's one. -/
private theorem detO_nil {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    R.rel (detO ops []) ops.one :=
  L.addUnit ops.one
/-- The one-entry list's determinant reads the entry. -/
private theorem detO_single {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) (x : γ) :
    R.rel (detO ops [[x]]) x := by
  show R.rel (ops.add (ops.mul x ops.one) ops.unit) x
  exact L.ovTrans (L.addUnit _)
    (L.ovTrans (L.toDCore.mulComm x ops.one) (L.oneMul x))

/-- The first-row walk collects to the signed key fold: each
entry against its struck sub-read at the alternating side, the
walk's flag the key's own parity. -/
private theorem minorRowO_read {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (nrm snrm : γ → γ) (hnrm : ∀ x, R.rel (nrm x) x)
    (hsnrm : ∀ x, R.rel (snrm x) x)
    (f : List (List γ) → γ) (rest : List (List γ))
    (hf : ∀ i, i ≤ rest.length →
      R.rel (f (rest.map (fun l => l.eraseIdx i)))
        (detO ops (rest.map (fun row => row.eraseIdx i)))) :
    ∀ (r' : List γ) (j : Nat),
      j + r'.length ≤ rest.length + 1 →
      R.rel (minorRowO ops nrm snrm f (places.parityOf j) j r' rest)
        (ground.famFold ops.add ops.unit
          (fun k => sgnPO ops (j + k)
            (ops.mul (ground.getAt ops.unit r' k)
              (cof0O ops rest (j + k))))
          (List.range r'.length))
  | [], _, _ => L.ovRefl _
  | a :: r', j, hjb => by
    show R.rel (snrm (ops.add
        (if places.parityOf j
          then ops.swap (nrm (ops.mul a
            (f (rest.map (fun l => l.eraseIdx j)))))
          else nrm (ops.mul a
            (f (rest.map (fun l => l.eraseIdx j)))))
        (minorRowO ops nrm snrm f
          (!places.parityOf j) (j + 1) r' rest))) _
    have hLc : (a :: r').length = r'.length + 1 := rfl
    rw [hLc, range_cons r'.length]
    show R.rel (snrm (ops.add
        (if places.parityOf j
          then ops.swap (nrm (ops.mul a
            (f (rest.map (fun l => l.eraseIdx j)))))
          else nrm (ops.mul a
            (f (rest.map (fun l => l.eraseIdx j)))))
        (minorRowO ops nrm snrm f
          (!places.parityOf j) (j + 1) r' rest)))
      (ops.add
        (sgnPO ops (j + 0)
          (ops.mul (ground.getAt ops.unit (a :: r') 0)
            (cof0O ops rest (j + 0))))
        (ground.famFold ops.add ops.unit
          (fun k => sgnPO ops (j + k)
            (ops.mul (ground.getAt ops.unit (a :: r') k)
              (cof0O ops rest (j + k))))
          (List.map (fun x => x + 1) (List.range r'.length))))
    rw [ground.famFold_map ops.add ops.unit _ (fun x => x + 1)
        (List.range r'.length)]
    have hjr : j ≤ rest.length := by
      refine Nat.le_of_succ_le_succ ?_
      refine Nat.le_trans ?_ hjb
      show j + 1 ≤ j + (r'.length + 1)
      refine Nat.add_le_add_left ?_ j
      exact Nat.succ_le_succ (Nat.zero_le _)
    have hhead : R.rel (if places.parityOf j
        then ops.swap (nrm (ops.mul a
          (f (rest.map (fun l => l.eraseIdx j)))))
        else nrm (ops.mul a
          (f (rest.map (fun l => l.eraseIdx j)))))
        (sgnPO ops (j + 0)
          (ops.mul (ground.getAt ops.unit (a :: r') 0)
            (cof0O ops rest (j + 0)))) := by
      show R.rel _ (sgnPO ops j (ops.mul a (cof0O ops rest j)))
      have hcore : R.rel (nrm (ops.mul a
          (f (rest.map (fun l => l.eraseIdx j)))))
          (ops.mul a (cof0O ops rest j)) := by
        refine L.ovTrans (hnrm _) ?_
        refine L.mulCongr (L.ovRefl a) ?_
        exact L.ovTrans (hf j hjr)
          (L.ovSymm (cof0O_strike L.toDCore rest j hjr))
      show R.rel (if places.parityOf j
          then ops.swap (nrm (ops.mul a
            (f (rest.map (fun l => l.eraseIdx j)))))
          else nrm (ops.mul a
            (f (rest.map (fun l => l.eraseIdx j)))))
        (if places.parityOf j
          then ops.swap (ops.mul a (cof0O ops rest j))
          else ops.mul a (cof0O ops rest j))
      cases places.parityOf j with
      | true => exact L.toDCore.swapCongr hcore
      | false => exact hcore
    have htail := minorRowO_read L nrm snrm hnrm hsnrm f rest hf r'
      (j + 1) (by
        rw [Nat.add_right_comm j 1 r'.length]
        exact hjb)
    refine L.ovTrans (hsnrm _) ?_
    refine L.addCongr hhead ?_
    refine L.ovTrans htail ?_
    refine ovOfEq L.toDCore
      (ground.famFold_congr_members ops.add ops.unit _ _
        (List.range r'.length) (fun k hk => by
          rw [Nat.add_right_comm j 1 k, Nat.add_assoc]
          rfl))

/-- The minor collects to the assignment fold at every fuel
reading its row count, at the matched lists' own square frame. -/
private theorem minorFO_detO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (nrm snrm : γ → γ) (hnrm : ∀ x, R.rel (nrm x) x)
    (hsnrm : ∀ x, R.rel (snrm x) x) :
    ∀ (fuel : Nat) (l : List (List γ)), l.length = fuel →
      rowsLen fuel l →
      R.rel (minorFO ops nrm snrm fuel l) (detO ops l)
  | 0, [], _, _ => by
    show R.rel ops.one (ops.add ops.one ops.unit)
    exact L.ovSymm (L.addUnit ops.one)
  | 0, _ :: _, h, _ => Nat.noConfusion h
  | _ + 1, [], h, _ => Nat.noConfusion h
  | f + 1, [r], hl, hw => by
    have hf0 : f = 0 := (Nat.succ.inj hl).symm
    have hr1 : r.length = 1 := by
      rw [hw.1, hf0]
    match r with
    | [] => exact absurd hr1 (fun h => Nat.noConfusion h)
    | [x] =>
      show R.rel x (detO ops [[x]])
      exact L.ovSymm (detO_single L x)
    | _ :: _ :: t =>
      have h2 : t.length + 1 + 1 = 1 := hr1
      nomatch (Nat.succ.inj h2)
  | f + 1, r :: r2 :: rest, hl, hw => by
    show R.rel (minorRowO ops nrm snrm
        (minorFO ops nrm snrm f) false 0 r (r2 :: rest))
      (detO ops (r :: r2 :: rest))
    have hlen : (r2 :: rest).length = f := Nat.succ.inj hl
    have hwr : r.length = (r2 :: rest).length + 1 := by
      rw [hlen]
      exact hw.1
    have hstr : ∀ (i : Nat), i < f + 1 → ∀ M : List (List γ),
        rowsLen (f + 1) M →
        rowsLen f (M.map (fun l => l.eraseIdx i)) := by
      intro i hif
      intro M
      induction M with
      | nil => intro _; exact trivial
      | cons row M ih =>
        intro h
        refine ⟨?_, ih h.2⟩
        have hl2 := ground.length_eraseIdx row i
          (by rw [h.1]; exact hif)
        rw [h.1] at hl2
        exact Nat.succ.inj hl2
    have hf : ∀ i, i ≤ (r2 :: rest).length →
        R.rel ((minorFO ops nrm snrm f)
            ((r2 :: rest).map (fun l => l.eraseIdx i)))
          (detO ops ((r2 :: rest).map
            (fun row => row.eraseIdx i))) :=
      fun i hi => minorFO_detO L nrm snrm hnrm hsnrm f
        ((r2 :: rest).map (fun l => l.eraseIdx i))
        (by rw [ground.length_map]; exact hlen)
        (hstr i (by
            rw [hlen] at hi
            exact Nat.lt_succ_of_le hi)
          (r2 :: rest) hw.2)
    have h1 := minorRowO_read L nrm snrm hnrm hsnrm
      (minorFO ops nrm snrm f) (r2 :: rest) hf r 0
      (by rw [Nat.zero_add, hwr]; exact Nat.le_refl _)
    rw [show places.parityOf 0 = false from rfl] at h1
    refine L.ovTrans h1 ?_
    refine L.ovTrans (ovOfEq L.toDCore
      (ground.famFold_congr_members ops.add ops.unit _
        (fun j => sgnPO ops j
          (ops.mul (ground.getAt ops.unit r j)
            (cof0O ops (r2 :: rest) j)))
        (List.range r.length) (fun k hk => by
          rw [Nat.zero_add]))) ?_
    rw [hwr]
    exact L.ovSymm (detO_cons L r (r2 :: rest))

/-- The minor at the fold: the first-row walk against the signed
permutation sum at a stated bundle with its representative
maps. -/
private theorem minorO_detO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (nrm snrm : γ → γ) (hnrm : ∀ x, R.rel (nrm x) x)
    (hsnrm : ∀ x, R.rel (snrm x) x)
    (m : List (List γ)) (hsq : rowsLen m.length m) :
    R.rel (minorO ops nrm snrm m) (detO ops m) :=
  minorFO_detO L nrm snrm hnrm hsnrm m.length m rfl hsq

/-- The taken prefix as the key range's own map. -/
private theorem take_as_range {α : Type} (d : α) :
    ∀ (k : Nat) (l : List α), k ≤ l.length →
      l.take k = (List.range k).map (fun a => ground.getAt d l a)
  | 0, _, _ => rfl
  | k + 1, [], h => absurd h (Nat.not_succ_le_zero _)
  | k + 1, a :: l, h => by
    show a :: l.take k
      = (List.range (k + 1)).map (fun t => ground.getAt d (a :: l) t)
    rw [range_cons k, take_as_range d k l (Nat.le_of_succ_le_succ h)]
    show a :: (List.range k).map (fun t => ground.getAt d l t)
      = a :: ((List.range k).map (fun x => x + 1)).map
          (fun t => ground.getAt d (a :: l) t)
    rw [ground.map_map]
    rfl

/-- A member of the leading keys with the border key sits at one
of the two reads. -/
private theorem borderKey_mem {k i a : Nat}
    (ha : 0 < ground.countOf a ((List.range k) ++ [i])) :
    a < k ∨ a = i := by
  rw [ground.countOf_append, ground.countOf_range] at ha
  by_cases hak : a < k
  · exact Or.inl hak
  · rw [if_neg hak, Nat.zero_add] at ha
    refine Or.inr ?_
    show a = i
    by_cases hai : a = i
    · exact hai
    · exact absurd ha (by
        show ¬ 0 < ground.countOf a [i]
        rw [ground.countOf_cons a i ([] : List Nat), if_neg hai]
        exact Nat.lt_irrefl 0)

/-- One row's kept columns read the taken prefix with the border
entry. -/
private theorem keepCols_take (k j : Nat) (r : List BPair)
    (hk : k ≤ r.length) :
    r.take k ++ [ground.getAt BPair.unit r j]
      = keepCols ((List.range k) ++ [j]) r := by
  show r.take k ++ [ground.getAt BPair.unit r j]
    = ((List.range k) ++ [j]).map
        (fun c => ground.getAt BPair.unit r c)
  rw [ground.map_append, take_as_range BPair.unit k r hk]
  rfl

/-- The pivot-bordered sublist is the minor's stated list. -/
private theorem bordered_borderAt (m : Mat) (k i j : Nat)
    (hk : k ≤ m.length) (hi : i < m.length)
    (hw : ∀ a, a < m.length →
      (ground.getAt [] m a).length = m.length) :
    bordered m k i j = minor (borderAt k i j m) := by
  refine congrArg minor ?_
  show (m.take k ++ [ground.getAt [] m i]).map
      (fun r => r.take k ++ [ground.getAt BPair.unit r j])
    = ((List.range k) ++ [i]).map (fun a =>
        keepCols ((List.range k) ++ [j]) (ground.getAt [] m a))
  rw [take_as_range ([] : List BPair) k m hk,
    show ((List.range k).map (fun a => ground.getAt [] m a)
        ++ [ground.getAt [] m i])
      = ((List.range k) ++ [i]).map (fun a => ground.getAt [] m a)
      from by rw [ground.map_append]; rfl,
    ground.map_map]
  refine ground.map_congr_members _ _ ((List.range k) ++ [i])
    (fun a ha => ?_)
  have haM : a < m.length := match borderKey_mem ha with
    | .inl h => Nat.lt_of_lt_of_le h hk
    | .inr h => h ▸ hi
  exact keepCols_take k j (ground.getAt [] m a)
    (by rw [hw a haM]; exact hk)

/-- The leading sublist is the minor's stated list. -/
private theorem leading_leadAt (m : Mat) (k : Nat)
    (hk : k ≤ m.length)
    (hw : ∀ a, a < m.length →
      (ground.getAt [] m a).length = m.length) :
    leading m k = minor (leadAt k m) := by
  refine congrArg minor ?_
  show (m.take k).map (fun r => r.take k)
    = (List.range k).map (fun a =>
        keepCols (List.range k) (ground.getAt [] m a))
  rw [take_as_range ([] : List BPair) k m hk, ground.map_map]
  refine ground.map_congr_members _ _ (List.range k)
    (fun a ha => ?_)
  have haM : a < m.length := by
    rw [ground.countOf_range] at ha
    by_cases hak : a < k
    · exact Nat.lt_of_lt_of_le hak hk
    · rw [if_neg hak] at ha
      exact absurd ha (Nat.lt_irrefl 0)
  show (ground.getAt [] m a).take k
    = (List.range k).map
        (fun c => ground.getAt BPair.unit (ground.getAt [] m a) c)
  exact take_as_range BPair.unit k (ground.getAt [] m a)
    (by rw [hw a haM]; exact hk)

/-- The leading sublist's rows read the key count. -/
private theorem leadAt_rowsW (k : Nat) (m : Mat) :
    rowsLen k (leadAt k m) :=
  rowsLen_matOf k k _

/-- The minor collects to the assignment fold at the square
frame, the stated identity's own read. -/
theorem minor_detL (M : Mat) (hsq : rowsLen M.length M) :
    (minor M).oneValue (detL M) :=
  minorO_detO (R := ground.bpairRead) bpairLaws BPair.norm BPair.norm
    (fun x => BPair.norm_oneValue x) (fun x => BPair.norm_oneValue x)
    M hsq

/-! `def:elim`'s exchanged reads at a joint relabeling of the row
and the column keys (`thm:restoration`'s derivation clause): the
assignment fold reindexed along the relabeling, each assignment
paired with its conjugate — the assignment read at the flipped
relabeling and carried back — at the entries' product kept, the
row and the column exchanges composing at an even join. -/

/-- The conjugate assignment at a relabeling: the assignment read
at the flipped relabeling and carried back, the permuted display's
composite (`places.expo`). -/
private def conjP (n : Nat) (q p : List Nat) : List Nat :=
  places.expo (places.expo q p) (places.invPerm n q)

private theorem length_conjP (n : Nat) (q p : List Nat) :
    (conjP n q p).length = n := by
  show ((places.invPerm n q).map _).length = n
  rw [ground.length_map]
  exact ground.length_mapRange _ n

private theorem getAt_conjP (n : Nat) {q : List Nat} (p : List Nat)
    (hq : 0 < ground.countOf q (permsE n)) (hplen : p.length = n)
    (i : Nat) (hi : i < n) :
    ground.getAt 0 (conjP n q p) i
      = ground.getAt 0 q (ground.getAt 0 p (places.posOf i q)) := by
  obtain ⟨hqlen, _, _, hqocc⟩ := places.perm_member_reads hq
  have hpos : places.posOf i q < n := by
    have hlt := places.posOf_lt i q (hqocc i hi)
    rw [hqlen] at hlt
    exact hlt
  show ground.getAt 0
      (places.expo (places.expo q p) (places.invPerm n q)) i = _
  rw [places.getAt_expo (places.expo q p) (places.invPerm n q) i
      (by rw [places.length_invPerm n q]; exact hi),
    places.getAt_invPerm n q hi,
    places.getAt_expo q p (places.posOf i q)
      (by rw [hplen]; exact hpos)]


/-- The conjugate is a member of the enumeration. -/
private theorem conjP_member (n : Nat) {q p : List Nat}
    (hq : 0 < ground.countOf q (permsE n))
    (hp : 0 < ground.countOf p (permsE n)) :
    0 < ground.countOf (conjP n q p) (permsE n) :=
  places.expo_member n (places.expo_member n hq hp)
    (places.invPerm_member n hq)

/-- The conjugation at the flipped relabeling reads the
assignment back. -/
private theorem conjP_conjP (n : Nat) {q p : List Nat}
    (hq : 0 < ground.countOf q (permsE n))
    (hp : 0 < ground.countOf p (permsE n)) :
    conjP n (places.invPerm n q) (conjP n q p) = p := by
  obtain ⟨hqlen, hqdist, hqval, _⟩ := places.perm_member_reads hq
  obtain ⟨hplen, _, hpval, _⟩ := places.perm_member_reads hp
  have hq' := places.invPerm_member n hq
  obtain ⟨hq'len, _, _, hq'occ⟩ := places.perm_member_reads hq'
  refine ground.getAt_ext 0 _ _ (by rw [length_conjP, hplen]) ?_
  intro i hi
  rw [length_conjP] at hi
  have hk : places.posOf i (places.invPerm n q) < n := by
    have hlt := places.posOf_lt i (places.invPerm n q) (hq'occ i hi)
    rw [hq'len] at hlt
    exact hlt
  have hkey : places.posOf (places.posOf i (places.invPerm n q)) q
      = i := by
    have h1 : ground.getAt 0 (places.invPerm n q)
        (places.posOf i (places.invPerm n q)) = i :=
      places.getAt_posOf i (places.invPerm n q) (hq'occ i hi)
    rw [places.getAt_invPerm n q hk] at h1
    exact h1
  have hpi : ground.getAt 0 p i < n :=
    hpval _ (ground.countOf_getAt_pos 0 p i (by rw [hplen]; exact hi))
  have hqpi : ground.getAt 0 q (ground.getAt 0 p i) < n :=
    hqval _ (ground.countOf_getAt_pos 0 q _
      (by rw [hqlen]; exact hpi))
  rw [getAt_conjP n (conjP n q p) hq' (length_conjP n q p) i hi,
    getAt_conjP n p hq hplen _ hk,
    hkey, places.getAt_invPerm n q hqpi,
    places.posOf_getAt hqdist (ground.getAt 0 p i)
      (by rw [hqlen]; exact hpi)]

/-- The conjugation keeps the swap grading: the two relabelings'
gradings compose at an even join. -/
private theorem parity_conjP (n : Nat) {q p : List Nat}
    (hq : 0 < ground.countOf q (permsE n))
    (hp : 0 < ground.countOf p (permsE n)) :
    places.parity (conjP n q p) = places.parity p := by
  have h1 : places.parity (places.expo q p)
      = xor (places.parity p) (places.parity q) :=
    places.parity_comp n p q hp hq
  have h2 : places.parity (conjP n q p)
      = xor (places.parity (places.invPerm n q))
          (places.parity (places.expo q p)) :=
    places.parity_comp n (places.invPerm n q)
      (places.expo q p) (places.invPerm_member n hq)
      (places.expo_member n hq hp)
  rw [h2, h1, places.parity_invPerm n hq]
  cases places.parity p <;> cases places.parity q <;> rfl

/-- The grading at the conjugate is the assignment's own. -/
private theorem sgnO_conjP {γ : Type} (ops : DOps γ) (n : Nat)
    {q p : List Nat} (hq : 0 < ground.countOf q (permsE n))
    (hp : 0 < ground.countOf p (permsE n)) (x : γ) :
    sgnO ops (conjP n q p) x = sgnO ops p x := by
  show (if places.parity (conjP n q p) then ops.swap x else x)
    = (if places.parity p then ops.swap x else x)
  rw [parity_conjP n hq hp]

private theorem detO_reindex {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) (n : Nat)
    (M M' : List (List γ)) (q : List Nat)
    (hq : 0 < ground.countOf q
      (places.monomialsAt (List.replicate n 1)))
    (hM : M.length = n) (hM' : M'.length = n)
    (hent : ∀ i j, i < n → j < n →
      R.rel (ground.getAt ops.unit (ground.getAt [] M' i) j)
        (ground.getAt ops.unit
          (ground.getAt [] M (ground.getAt 0 q i))
          (ground.getAt 0 q j))) :
    R.rel (detO ops M') (detO ops M) := by
  obtain ⟨hqlen, hqdist, hqval, hqocc⟩ := places.perm_member_reads hq
  have hterm : ∀ p : List Nat,
      0 < ground.countOf p (permsE n) →
      R.rel (termO ops M' p) (termO ops M (conjP n q p)) := by
    intro p hp
    obtain ⟨hplen, _, hpval, _⟩ := places.perm_member_reads hp
    rw [termO_fold ops M' p (by rw [hM', hplen]),
      termO_fold ops M (conjP n q p) (by rw [hM, length_conjP]),
      hM, hM']
    refine ground.famFold_bij_ov (commLawsMulOf C) ops.one _
      (fun s => ground.getAt ops.unit (ground.getAt [] M s)
        (ground.getAt 0 (conjP n q p) s))
      (ground.distinctList_range n)
      (g := ground.getAt 0 q) (h := fun x => places.posOf x q)
      (fun x hx => places.posOf_getAt hqdist x
        (by rw [hqlen]; exact ground.ltOfMem hx))
      (fun x hx => places.getAt_posOf x q
        (hqocc x (ground.ltOfMem hx)))
      (fun x hx => ground.countOf_range_pos (hqval _
        (ground.countOf_getAt_pos 0 q x
          (by rw [hqlen]; exact ground.ltOfMem hx))))
      (fun x hx => ground.countOf_range_pos (by
        have hlt := places.posOf_lt x q (hqocc x (ground.ltOfMem hx))
        rw [hqlen] at hlt
        exact hlt))
      (fun t ht => ?_)
    have htn : t < n := ground.ltOfMem ht
    have hqt : ground.getAt 0 q t < n :=
      hqval _ (ground.countOf_getAt_pos 0 q t
        (by rw [hqlen]; exact htn))
    have hpt : ground.getAt 0 p t < n :=
      hpval _ (ground.countOf_getAt_pos 0 p t
        (by rw [hplen]; exact htn))
    rw [getAt_conjP n p hq hplen _ hqt,
      places.posOf_getAt hqdist t (by rw [hqlen]; exact htn)]
    exact hent t (ground.getAt 0 p t) htn hpt
  show R.rel (ground.famFold ops.add ops.unit
      (fun p => sgnO ops p (termO ops M' p))
      (places.monomialsAt (List.replicate M'.length 1)))
    (ground.famFold ops.add ops.unit
      (fun p => sgnO ops p (termO ops M p))
      (places.monomialsAt (List.replicate M.length 1)))
  rw [hM, hM']
  exact ground.famFold_bij_ov (commLawsOf C) ops.unit _
    (fun r => sgnO ops r (termO ops M r))
    (places.monomialsAt_distinct (List.replicate n 1))
    (g := conjP n q) (h := conjP n (places.invPerm n q))
    (fun p hp => conjP_conjP n hq hp)
    (fun p hp => by
      have hback := conjP_conjP n (places.invPerm_member n hq) hp
      rw [places.invPerm_invPerm n hq] at hback
      exact hback)
    (fun p hp => conjP_member n hq hp)
    (fun p hp => conjP_member n (places.invPerm_member n hq) hp)
    (fun p hp => C.ovTrans (sgnO_congr C p (hterm p hp))
      (ovOfEq C (sgnO_conjP ops n hq hp
        (termO ops M (conjP n q p))).symm))

/-- The determinant at a joint relabeling of rows and columns: the
assignment fold reindexed along the relabeling, each assignment
paired with its relabeled own at the entries' product kept, the
exchanges composing at an even join (`thm:restoration`'s
derivation clause at `def:elim`'s exchanged reads). -/
theorem detL_reindex (n : Nat) (M M' : Mat) (q : List Nat)
    (hq : 0 < ground.countOf q
      (places.monomialsAt (List.replicate n 1)))
    (hM : M.length = n) (hM' : M'.length = n)
    (hent : ∀ i j, i < n → j < n →
      (ground.getAt BPair.unit (ground.getAt [] M' i) j).oneValue
        (ground.getAt BPair.unit
          (ground.getAt [] M (ground.getAt 0 q i))
          (ground.getAt 0 q j))) :
    (detL M').oneValue (detL M) :=
  detO_reindex (R := ground.bpairRead) bpairCore n M M' q hq hM hM'
    hent

/-- The polynomial minor at a joint relabeling of rows and
columns: the first-row fold collected to the assignment fold at
each square, the relabeling read there (`thm:restoration`'s
derivation clause at the polynomial carrier). -/
theorem minorP_reindex (n : Nat) (M M' : List (List poly.Poly))
    (q : List Nat)
    (hq : 0 < ground.countOf q
      (places.monomialsAt (List.replicate n 1)))
    (hM : M.length = n) (hM' : M'.length = n)
    (hrows : rowsLen n M) (hrows' : rowsLen n M')
    (hent : ∀ i j, i < n → j < n →
      poly.oneValue (ground.getAt [] (ground.getAt [] M' i) j)
        (ground.getAt []
          (ground.getAt [] M (ground.getAt 0 q i))
          (ground.getAt 0 q j))) :
    poly.oneValue (minorO poly.polyOps poly.pnorm id M')
      (minorO poly.polyOps poly.pnorm id M) := by
  have hsq : rowsLen M.length M := by rw [hM]; exact hrows
  have hsq' : rowsLen M'.length M' := by rw [hM']; exact hrows'
  have hbridge : ∀ (X : List (List poly.Poly)), rowsLen X.length X →
      poly.oneValue (minorO poly.polyOps poly.pnorm id X)
        (detO poly.polyOps X) := fun X hX =>
    minorO_detO (R := poly.polyRead)
      (polyLawsO (R := ground.bpairRead) bpairLaws) poly.pnorm id
      (fun x => poly.pnorm_oneValue x)
      (fun x => lovRefl (R := ground.bpairRead) bpairCore x) X hX
  have C : DCore poly.Poly poly.polyOps poly.polyRead.rel :=
    polyCoreO (R := ground.bpairRead) bpairLaws
  exact C.ovTrans (hbridge M' hsq')
    (C.ovTrans (detO_reindex C n M M' q hq hM hM' hent)
      (C.ovSymm (hbridge M hsq)))

/-! The bordered square: a leading entry alone at its row and its
column key, the inner square beneath it, the minor factoring at
the head row's own expansion. -/

/-- The last row read at the last column's unit family: the
determinant collapses to the leading square's own, the row and the
column both withdrawn. -/
private theorem detO_List.set_last {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
        (m : List (List γ)) (e : Nat) (hlen : m.length = e + 1)
    (v : List γ) (hv : v.length = e + 1)
    (hve : R.rel (ground.getAt ops.unit v e) ops.one)
    (hvo : ∀ b, ¬ b = e → R.rel (ground.getAt ops.unit v b) ops.unit) :
    R.rel (detO ops (List.set m e v))
      (detO ops ((m.eraseIdx e).map (fun r => r.eraseIdx e))) := by
  have hem : e < m.length := by
    rw [hlen]
    exact Nat.lt_succ_self e
  have hrest : (m.eraseIdx e).length = e := by
    have h := length_eraseIdx m e hem
    rw [hlen] at h
    exact Nat.succ.inj h
  refine L.ovTrans (detO_List.set_dot L m e hem v (by rw [hv, hlen])) ?_
  refine L.ovTrans (dotO_unitRead L v (cofVecO ops m e) e
    (by rw [hv, length_cofVecO, hlen]) hve hvo) ?_
  rw [show ground.getAt ops.unit (cofVecO ops m e) e
      = sgnPO ops (e + e) (cof0O ops (m.eraseIdx e) e) from by
    show ground.getAt ops.unit ((List.range m.length).map
      (fun j => sgnPO ops (e + j)
        (cof0O ops (m.eraseIdx e) j))) e = _
    rw [ground.getAt_map 0 ops.unit _ (List.range m.length) e
        (by rw [ground.length_range]; exact hem),
      ground.getAt_range m.length e hem],
    sgnPO_even ops e]
  have hb := cof0O_last L.toDCore (m.eraseIdx e)
  rw [hrest] at hb
  exact hb

/-- The mapped family as the key range's own map. -/
private theorem map_as_range {α β : Type} (d : α) (f : α → β)
    (l : List α) :
    l.map f = (List.range l.length).map
      (fun t => f (ground.getAt d l t)) := by
  refine ground.getAt_ext (f d) _ _ ?_ ?_
  · rw [ground.length_map, ground.length_mapRange]
  · intro i hi
    rw [ground.length_map] at hi
    rw [ground.getAt_map d (f d) f l i hi,
      ground.getAt_map 0 (f d) _ (List.range l.length) i
        (by rw [ground.length_range]; exact hi),
      ground.getAt_range l.length i hi]

/-- The pairing against a mapped family is the key fold at the
mapped entries. -/
private theorem dotO_map_index {γ α : Type} (ops : DOps γ) (d : α)
    (f : α → γ) (y : List γ) (l : List α) (hy : y.length = l.length) :
    dotO ops y (l.map f)
      = ground.famFold ops.add ops.unit
        (fun t => ops.mul (ground.getAt ops.unit y t)
          (f (ground.getAt d l t))) (List.range l.length) := by
  rw [map_as_range d f l]
  exact dotO_map_range ops (fun t => f (ground.getAt d l t))
    l.length y hy

/-- Two replacements at differing places commute. -/
private theorem List.set_comm {α : Type} :
    ∀ (l : List α) (p q : Nat) (u v : α), ¬ p = q →
      List.set (List.set l p u) q v = List.set (List.set l q v) p u
  | [], _, _, _, _, _ => rfl
  | _ :: _, 0, 0, _, _, h => absurd rfl h
  | _ :: _, 0, _ + 1, _, _, _ => rfl
  | _ :: _, _ + 1, 0, _, _, _ => rfl
  | a :: t, p + 1, q + 1, u, v, h => by
    show a :: List.set (List.set t p u) q v
      = a :: List.set (List.set t q v) p u
    rw [List.set_comm t p q u v (fun he => h (congrArg Nat.succ he))]

/-- The fold at two singly listed keys with every further member at
the sum's unit reads those two keys' join. -/
private theorem foldO_pick2 {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) (g : Nat → γ)
    (l : List Nat) (a b : Nat) (hab : ¬ a = b)
    (hca : ground.countOf a l = 1) (hcb : ground.countOf b l = 1)
    (hrest : ∀ x, 0 < ground.countOf x l → ¬ x = a → ¬ x = b →
      R.rel (g x) ops.unit) :
    R.rel (ground.famFold ops.add ops.unit g l)
      (ops.add (g a) (g b)) := by
  have hpa : 0 < ground.countOf a l := by
    rw [hca]
    exact Nat.succ_pos 0
  have hea : ground.countOf a (ground.eraseFirst a l) = 0 := by
    have h := ground.countOf_eraseFirst_self l a hpa
    rw [hca] at h
    exact (Nat.succ.inj h).symm
  have hpb1 : 0 < ground.countOf b (ground.eraseFirst a l) := by
    rw [ground.countOf_eraseFirst_ne l a b (fun he => hab he.symm),
      hcb]
    exact Nat.succ_pos 0
  have hstep1 : R.rel (ground.famFold ops.add ops.unit g l)
      (ops.add (g a) (ground.famFold ops.add ops.unit g
        (ground.eraseFirst a l))) :=
    L.ovSymm (ground.famFold_eraseFirst_ov (commLawsOf L.toDCore) ops.unit g l a hpa)
  have hstep2 : R.rel (ground.famFold ops.add ops.unit g
        (ground.eraseFirst a l))
      (ops.add (g b) (ground.famFold ops.add ops.unit g
        (ground.eraseFirst b (ground.eraseFirst a l)))) :=
    L.ovSymm (ground.famFold_eraseFirst_ov (commLawsOf L.toDCore) ops.unit g
      (ground.eraseFirst a l) b hpb1)
  have hnull : R.rel (ground.famFold ops.add ops.unit g
      (ground.eraseFirst b (ground.eraseFirst a l))) ops.unit := by
    refine ground.famFold_null_ov (foldLawsOf L) g _ (fun x hx => ?_)
    have hxb : ¬ x = b := by
      intro he
      have h0 : ground.countOf b (ground.eraseFirst b
          (ground.eraseFirst a l)) = 0 := by
        have h := ground.countOf_eraseFirst_self
          (ground.eraseFirst a l) b hpb1
        rw [ground.countOf_eraseFirst_ne l a b
          (fun hz => hab hz.symm), hcb] at h
        exact (Nat.succ.inj h).symm
      rw [he, h0] at hx
      exact absurd hx (Nat.lt_irrefl 0)
    have hxa : ¬ x = a := by
      intro he
      have h0 : ground.countOf a (ground.eraseFirst b
          (ground.eraseFirst a l)) = 0 := by
        rw [ground.countOf_eraseFirst_ne (ground.eraseFirst a l) b a
          (fun hz => hab hz), hea]
      rw [he, h0] at hx
      exact absurd hx (Nat.lt_irrefl 0)
    have hxl : 0 < ground.countOf x l := by
      rw [ground.countOf_eraseFirst_ne (ground.eraseFirst a l) b x hxb,
        ground.countOf_eraseFirst_ne l a x hxa] at hx
      exact hx
    exact hrest x hxl hxa hxb
  exact L.ovTrans hstep1 (L.addCongr (L.ovRefl (g a))
    (L.ovTrans hstep2 (L.ovTrans
      (L.addCongr (L.ovRefl (g b)) hnull) (L.addUnit (g b)))))

/-- The replaced row read as a combination of a further family's
rows: the determinant expands over the coefficients, one summand
per member at the member's own replaced determinant. -/
private theorem detO_List.set_combo {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (m : List (List γ)) (k : Nat) (hk : k < m.length)
    (y : List γ) (M' : List (List γ)) (hM : rowsLen m.length M') :
    R.rel (detO ops (List.set m k (comboO ops m.length y M')))
      (dotO ops y
        (M'.map (fun row => detO ops (List.set m k row)))) := by
  have hcl : (comboO ops m.length y M').length = m.length :=
    length_comboO ops m.length y M' hM
  have hcof : (cofVecO ops m k).length = m.length :=
    length_cofVecO ops m k
  refine L.ovTrans (detO_List.set_dot L m k hk _ hcl) ?_
  refine L.ovTrans (dotO_comm L.toDCore _ _) ?_
  refine L.ovTrans
    (dotO_combo L y M' (cofVecO ops m k) m.length hM) ?_
  refine dotO_congr_right L y _ _
    (by rw [ground.length_map, ground.length_map]) ?_
  intro i hi
  rw [ground.length_map] at hi
  rw [ground.getAt_map ([] : List γ) ops.unit
      (fun row => dotO ops (cofVecO ops m k) row) M' i hi,
    ground.getAt_map ([] : List γ) ops.unit
      (fun row => detO ops (List.set m k row)) M' i hi]
  refine L.ovTrans (dotO_comm L.toDCore _ _) ?_
  exact L.ovSymm (detO_List.set_dot L m k hk (ground.getAt [] M' i)
    (rowsLen_getAt M' i hM hi))

/-! The key-list spellings the bordered tier reads at: the
transpose and the adjacent column exchange as explicit key maps,
with the unit family at a stated key. -/

theorem rowsLen_adjSwap {γ : Type} {n : Nat} :
    ∀ (k : Nat) (m : List (List γ)), rowsLen n m →
      rowsLen n (ground.adjSwap k m)
  | 0, [], h => h
  | _ + 1, [], h => h
  | 0, [_], h => h
  | 0, _ :: _ :: _, h => ⟨h.2.1, h.1, h.2.2⟩
  | k + 1, _ :: t, h => ⟨h.1, rowsLen_adjSwap k t h.2⟩

/-- The transpose at a stated width, as the key range's own double
map — the explicit spelling the bordered tier reads at. -/
private def transM {γ : Type} (ops : DOps γ) (n : Nat)
    (S : List (List γ)) : List (List γ) :=
  ground.matOf n n (fun a b =>
    ground.getAt ops.unit (ground.getAt [] S b) a)

private theorem transM_len {γ : Type} (ops : DOps γ) (n : Nat)
    (S : List (List γ)) : (transM ops n S).length = n :=
  ground.matOf_length n n _

private theorem transM_rows {γ : Type} (ops : DOps γ) (n : Nat)
    (S : List (List γ)) : rowsLen n (transM ops n S) :=
  rowsLen_matOf n n _

private theorem transM_entry {γ : Type} (ops : DOps γ) (n : Nat)
    (S : List (List γ)) (a b : Nat) (ha : a < n) (hb : b < n) :
    ground.getAt ops.unit (ground.getAt [] (transM ops n S) a) b
      = ground.getAt ops.unit (ground.getAt [] S b) a :=
  ground.matOf_entry [] ops.unit n n _ a b ha hb

/-- The explicit transpose reads the determinant back. -/
private theorem transM_det {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) (n : Nat)
    (S : List (List γ)) (hl : S.length = n) (hrows : rowsLen n S) :
    R.rel (detO ops (transM ops n S)) (detO ops S) := by
  match n, hl, hrows with
  | 0, hl, _ =>
    match S, hl with
    | [], _ => exact C.ovRefl _
  | n' + 1, hl, hrows =>
  have h0 : 0 < n' + 1 := Nat.succ_pos n'
  have hlt : (transposeO ops S).length = n' + 1 :=
    length_transposeO ops S hrows (by rw [hl]; exact h0)
  refine C.ovTrans (detO_congr_letters C (transM ops (n' + 1) S)
    (transposeO ops S) (by rw [transM_len, hlt]) (fun a ha b hb => ?_))
    ?_
  · rw [transM_len] at ha hb
    rw [transM_entry ops (n' + 1) S a b ha hb,
      getAt_transposeO ops ops.unit S hrows a b ha (by rw [hl]; exact hb)]
    exact C.ovRefl _
  · have h := detO_transpose C S (by rw [hl]; exact hrows)
    exact h

/-- The adjacent column exchange at a stated width, the key map's
own spelling. -/
private def colSwapM {γ : Type} (ops : DOps γ) (n k : Nat)
    (X : List (List γ)) : List (List γ) :=
  ground.matOf n n (fun a b =>
    ground.getAt ops.unit (ground.getAt [] X a)
      (swapIx k (k + 1) b))

private theorem colSwapM_len {γ : Type} (ops : DOps γ) (n k : Nat)
    (X : List (List γ)) : (colSwapM ops n k X).length = n :=
  ground.matOf_length n n _

private theorem colSwapM_entry {γ : Type} (ops : DOps γ) (n k : Nat)
    (X : List (List γ)) (a b : Nat) (ha : a < n) (hb : b < n) :
    ground.getAt ops.unit
        (ground.getAt [] (colSwapM ops n k X) a) b
      = ground.getAt ops.unit (ground.getAt [] X a)
        (swapIx k (k + 1) b) :=
  ground.matOf_entry [] ops.unit n n _ a b ha hb

/-- The adjacent column exchange swaps the determinant's members,
the row exchange read through the transpose sandwich. -/
private theorem colSwapM_det {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) (n k : Nat)
    (X : List (List γ)) (hl : X.length = n) (hrows : rowsLen n X)
    (hk : k + 1 < n) :
    R.rel (detO ops (colSwapM ops n k X)) (ops.swap (detO ops X)) := by
  have h0 : 0 < n := Nat.lt_trans (Nat.succ_pos k) hk
  have hXt : (transM ops n X).length = n := transM_len ops n X
  have hYl : (ground.adjSwap k (transM ops n X)).length = n := by
    rw [ground.length_adjSwap, hXt]
  have hYr : rowsLen n (ground.adjSwap k (transM ops n X)) :=
    rowsLen_adjSwap k (transM ops n X) (transM_rows ops n X)
  refine C.ovTrans (detO_congr_letters C (colSwapM ops n k X)
    (transM ops n (ground.adjSwap k (transM ops n X)))
    (by rw [colSwapM_len, transM_len]) (fun a ha b hb => ?_)) ?_
  · rw [colSwapM_len] at ha hb
    rw [colSwapM_entry ops n k X a b ha hb,
      transM_entry ops n (ground.adjSwap k (transM ops n X)) a b ha hb,
      getAt_adjSwap ([] : List γ) k (transM ops n X)
        (by rw [hXt]; exact hk) b,
      transM_entry ops n X (swapIx k (k + 1) b) a
        (swapIx_lt (Nat.lt_trans (Nat.lt_succ_self k) hk) hk b hb) ha]
    exact C.ovRefl _
  · refine C.ovTrans (transM_det C n
      (ground.adjSwap k (transM ops n X)) hYl hYr) ?_
    refine C.ovTrans (detO_swapAdj C k (transM ops n X)
      (by rw [hXt]; exact hk)) ?_
    exact C.swapCongr (transM_det C n X hl hrows)

/-- The unit family at a stated key. -/
private def unitFam {γ : Type} (ops : DOps γ) (n c : Nat) :
    List γ :=
  (List.range n).map (fun b => if b = c then ops.one else ops.unit)

private theorem unitFam_len {γ : Type} (ops : DOps γ) (n c : Nat) :
    (unitFam ops n c).length = n :=
  ground.length_mapRange _ n

private theorem unitFam_hit {γ : Type} (ops : DOps γ) (n c : Nat)
    (hc : c < n) :
    ground.getAt ops.unit (unitFam ops n c) c = ops.one := by
  show ground.getAt ops.unit ((List.range n).map
    (fun b => if b = c then ops.one else ops.unit)) c = _
  rw [ground.getAt_map 0 ops.unit _ (List.range n) c
      (by rw [ground.length_range]; exact hc),
    ground.getAt_range n c hc, if_pos rfl]

private theorem unitFam_miss {γ : Type} (ops : DOps γ) (n c b : Nat)
    (hb : ¬ b = c) :
    ground.getAt ops.unit (unitFam ops n c) b = ops.unit := by
  match Nat.lt_or_ge b n with
  | .inl hbn =>
    show ground.getAt ops.unit ((List.range n).map
      (fun b => if b = c then ops.one else ops.unit)) b = _
    rw [ground.getAt_map 0 ops.unit _ (List.range n) b
        (by rw [ground.length_range]; exact hbn),
      ground.getAt_range n b hbn, if_neg hb]
  | .inr hbn =>
    exact ground.getAt_over ops.unit (unitFam ops n c) b
      (by rw [unitFam_len]; exact hbn)

/-- The key map withdrawing one leading key: the keys below it
their own, the key itself the successor. -/
private def bumpIx (k x : Nat) : Nat := if x = k then k + 1 else x

private theorem bumpIx_lt {k x n : Nat} (hx : x < k + 1)
    (hk : k + 1 < n) : bumpIx k x < n := by
  show (if x = k then k + 1 else x) < n
  by_cases h : x = k
  · rw [if_pos h]
    exact hk
  · rw [if_neg h]
    exact Nat.lt_trans hx hk

/-- Inside the leading keys the bump is the adjacent exchange. -/
private theorem bumpIx_swapIx (k x : Nat) (hx : x < k + 1) :
    bumpIx k x = swapIx k (k + 1) x := by
  show (if x = k then k + 1 else x)
    = if x = k then k + 1 else if x = k + 1 then k else x
  by_cases h : x = k
  · rw [if_pos h, if_pos h]
  · rw [if_neg h, if_neg h,
      if_neg (fun he => Nat.lt_irrefl (k + 1)
        (by rw [he] at hx; exact hx))]

/-- The submatrix at a stated key count and two key maps. -/
private def subM {γ : Type} (ops : DOps γ) (p : Nat)
    (f g : Nat → Nat) (S : List (List γ)) : List (List γ) :=
  ground.matOf p p (fun a b =>
    ground.getAt ops.unit (ground.getAt [] S (f a)) (g b))

private theorem subM_len {γ : Type} (ops : DOps γ) (p : Nat)
    (f g : Nat → Nat) (S : List (List γ)) :
    (subM ops p f g S).length = p :=
  ground.matOf_length p p _

private theorem subM_rows {γ : Type} (ops : DOps γ) (p : Nat)
    (f g : Nat → Nat) (S : List (List γ)) :
    rowsLen p (subM ops p f g S) :=
  rowsLen_matOf p p _

private theorem subM_entry {γ : Type} (ops : DOps γ) (p : Nat)
    (f g : Nat → Nat) (S : List (List γ)) (a b : Nat)
    (ha : a < p) (hb : b < p) :
    ground.getAt ops.unit (ground.getAt [] (subM ops p f g S) a) b
      = ground.getAt ops.unit (ground.getAt [] S (f a)) (g b) :=
  ground.matOf_entry [] ops.unit p p _ a b ha hb

/-- The adjacent exchange as two replacements at the exchanged
places. -/
private theorem List.set_swapAdj {α : Type} (d : α) :
    ∀ (k : Nat) (m : List α), k + 1 < m.length →
      List.set (List.set m (k + 1) (ground.getAt d m k)) k
        (ground.getAt d m (k + 1)) = ground.adjSwap k m
  | 0, [], h => absurd h (Nat.not_lt_zero _)
  | 0, [_], h => absurd h (Nat.lt_irrefl 1)
  | _ + 1, [], h => absurd h (Nat.not_lt_zero _)
  | 0, _ :: _ :: _, _ => rfl
  | k + 1, a :: t, h => by
    show a :: List.set (List.set t (k + 1) (ground.getAt d t k)) k
      (ground.getAt d t (k + 1)) = a :: ground.adjSwap k t
    rw [List.set_swapAdj d k t (Nat.lt_of_succ_lt_succ h)]

/-- A replacement at the first exchanged place reads through the
exchange at the second. -/
private theorem adjSwap_List.set {α : Type} :
    ∀ (k : Nat) (m : List α) (b : α), k + 1 < m.length →
      ground.adjSwap k (List.set m k b)
        = List.set (ground.adjSwap k m) (k + 1) b
  | 0, [], _, h => absurd h (Nat.not_lt_zero _)
  | 0, [_], _, h => absurd h (Nat.lt_irrefl 1)
  | _ + 1, [], _, h => absurd h (Nat.not_lt_zero _)
  | 0, _ :: _ :: _, _, _ => rfl
  | k + 1, a :: t, b, h => by
    show a :: ground.adjSwap k (List.set t k b)
      = a :: List.set (ground.adjSwap k t) (k + 1) b
    rw [adjSwap_List.set k t b (Nat.lt_of_succ_lt_succ h)]

/-- The pairing against a scaled left factor is the scale of the
pairing. -/
private theorem dotO_vecScale_left {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) (c : γ)
    (u w : List γ) :
    R.rel (dotO ops (vecScaleO ops c u) w) (ops.mul c (dotO ops u w)) :=
  L.ovTrans (dotO_comm L.toDCore _ _)
    (L.ovTrans (dotO_vecScale_right L w u c)
      (L.mulCongr (L.ovRefl c) (dotO_comm L.toDCore w u)))

/-- A replacement at a matched width keeps the stated row width. -/
theorem rowsLen_set {γ : Type} {n : Nat} :
    ∀ (M : List (List γ)) (k : Nat) (v : List γ),
      rowsLen n M → v.length = n → rowsLen n (List.set M k v)
  | [], _, _, h, _ => h
  | _ :: _, 0, _, h, hv => ⟨hv, h.2⟩
  | _ :: t, k + 1, v, h, hv => ⟨h.1, rowsLen_set t k v h.2 hv⟩

/-- The last row read at the last key's unit family: the leading
submatrix's determinant, in the explicit key-map spelling. -/
private theorem detO_lastUnit_subM {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (e : Nat)
    (X : List (List γ)) (hl : X.length = e + 1) :
    R.rel (detO ops (List.set X e (unitFam ops (e + 1) e)))
      (detO ops (subM ops e (fun a => a) (fun b => b) X)) := by
  have hk1 : e < X.length := by
    rw [hl]
    exact Nat.lt_succ_self e
  have hrest : (X.eraseIdx e).length = e := by
    have h := length_eraseIdx X e hk1
    rw [hl] at h
    exact Nat.succ.inj h
  refine L.ovTrans (detO_List.set_last L X e hl
    (unitFam ops (e + 1) e) (unitFam_len ops (e + 1) e)
    (ovOfEq L.toDCore
      (unitFam_hit ops (e + 1) e (Nat.lt_succ_self e)))
    (fun b hb => ovOfEq L.toDCore
      (unitFam_miss ops (e + 1) e b hb))) ?_
  refine detO_congr_letters L.toDCore _ _ ?_ (fun a ha b hb => ?_)
  · rw [ground.length_map, hrest, subM_len]
  · rw [ground.length_map, hrest] at ha hb
    rw [ground.getAt_map ([] : List γ) ([] : List γ)
        (fun r => r.eraseIdx e) (X.eraseIdx e) a
        (by rw [hrest]; exact ha),
      getAt_eraseIdx ([] : List γ) X e a, if_pos ha,
      getAt_eraseIdx ops.unit (ground.getAt [] X a) e b,
      if_pos hb, subM_entry ops e _ _ X a b ha hb]
    exact L.ovRefl _

/-- The submatrix of a transpose is the exchanged key maps' own
submatrix, determinant for determinant. -/
private theorem subM_trans_det {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) (n p : Nat)
    (f g : Nat → Nat) (S : List (List γ))
    (hf : ∀ a, a < p → f a < n) (hg : ∀ b, b < p → g b < n) :
    R.rel (detO ops (subM ops p f g (transM ops n S)))
      (detO ops (subM ops p g f S)) := by
  refine C.ovTrans (detO_congr_letters C _
    (transM ops p (subM ops p g f S))
    (by rw [subM_len, transM_len]) (fun a ha b hb => ?_)) ?_
  · rw [subM_len] at ha hb
    rw [subM_entry ops p f g (transM ops n S) a b ha hb,
      transM_entry ops n S (f a) (g b) (hf a ha) (hg b hb),
      transM_entry ops p (subM ops p g f S) a b ha hb,
      subM_entry ops p g f S b a hb ha]
    exact C.ovRefl _
  · exact transM_det C p (subM ops p g f S) (subM_len ops p g f S)
      (subM_rows ops p g f S)

/-- The adjacent column exchange lands on the leading key only at
the last key. -/
private theorem swapIx_hit {k b : Nat} (hb : ¬ b = k + 1) :
    ¬ swapIx k (k + 1) b = k := by
  show ¬ (if b = k then k + 1 else if b = k + 1 then k else b) = k
  by_cases h1 : b = k
  · rw [if_pos h1]
    exact Nat.succ_ne_self k
  · rw [if_neg h1, if_neg hb]
    exact h1

/-- The exchanged columns read the last key's unit family at the
replaced row: the two spellings' determinants read one value. -/
private theorem colSwap_List.set_unit {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) (n k : Nat)
    (X : List (List γ)) (hl : X.length = n) (hk : k + 1 < n) :
    R.rel (detO ops
        (colSwapM ops n k (List.set X (k + 1) (unitFam ops n k))))
      (detO ops (List.set (colSwapM ops n k X) (k + 1)
        (unitFam ops n (k + 1)))) := by
  have hk0 : k < n := Nat.lt_trans (Nat.lt_succ_self k) hk
  refine detO_congr_letters C _ _ ?_ (fun a ha b hb => ?_)
  · rw [colSwapM_len, ground.length_set, colSwapM_len]
  · rw [colSwapM_len] at ha hb
    rw [colSwapM_entry ops n k _ a b ha hb]
    by_cases hak : a = k + 1
    · rw [hak, ground.getAt_set_self ([] : List γ) _ X (k + 1) (by rw [hl]; exact hk),
        ground.getAt_set_self ([] : List γ) _ (colSwapM ops n k X) (k + 1)
          (by rw [colSwapM_len]; exact hk)]
      by_cases hbk : b = k + 1
      · rw [hbk,
          show swapIx k (k + 1) (k + 1) = k from by
            show (if k + 1 = k then k + 1
              else if k + 1 = k + 1 then k else k + 1) = k
            rw [if_neg (Nat.succ_ne_self k), if_pos rfl],
          unitFam_hit ops n k hk0,
          unitFam_hit ops n (k + 1) hk]
        exact C.ovRefl _
      · rw [unitFam_miss ops n k _ (swapIx_hit hbk),
          unitFam_miss ops n (k + 1) b hbk]
        exact C.ovRefl _
    · rw [ground.getAt_set_ne ([] : List γ) X (k + 1) a _ hak,
        ground.getAt_set_ne ([] : List γ) (colSwapM ops n k X) (k + 1) a
          _ hak,
        colSwapM_entry ops n k X a b ha hb]
      exact C.ovRefl _

/-- The cofactor vector's entry as a unit-family replacement's
determinant. -/
private theorem cofRead {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (n : Nat)
    (G : List (List γ)) (hl : G.length = n) (c t : Nat)
    (hc : c < n) (ht : t < n) :
    R.rel (detO ops (List.set G c (unitFam ops n t)))
      (ground.getAt ops.unit (cofVecO ops G c) t) := by
  refine L.ovTrans (detO_List.set_dot L G c (by rw [hl]; exact hc)
    (unitFam ops n t) (by rw [unitFam_len, hl])) ?_
  exact dotO_unitRead L (unitFam ops n t) (cofVecO ops G c) t
    (by rw [unitFam_len, length_cofVecO, hl])
    (ovOfEq L.toDCore (unitFam_hit ops n t ht))
    (fun b hb => ovOfEq L.toDCore (unitFam_miss ops n t b hb))

/-- The border pair's cofactor at the last row and the last
column: the leading submatrix's determinant. -/
private theorem cofBorder11 {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (k : Nat)
    (S : List (List γ)) :
    R.rel (ground.getAt ops.unit
        (cofVecO ops (transM ops (k + 2) S) (k + 1)) (k + 1))
      (detO ops (subM ops (k + 1)
        (fun a => a) (fun b => b) S)) := by
  have hk : k + 1 < k + 2 := Nat.lt_succ_self (k + 1)
  have hG : (transM ops (k + 2) S).length = k + 2 :=
    transM_len ops (k + 2) S
  refine L.ovTrans (L.ovSymm (cofRead L (k + 2)
    (transM ops (k + 2) S) hG (k + 1) (k + 1) hk hk)) ?_
  refine L.ovTrans (detO_lastUnit_subM L (k + 1)
    (transM ops (k + 2) S) hG) ?_
  exact subM_trans_det L.toDCore (k + 2) (k + 1)
    (fun a => a) (fun b => b) S
    (fun a ha => Nat.lt_trans ha hk) (fun b hb => Nat.lt_trans hb hk)

/-- The border pair's cofactor at the last row and the leading
column, the column exchange's side carried. -/
private theorem cofBorder10 {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (k : Nat)
    (S : List (List γ)) :
    R.rel (ground.getAt ops.unit
        (cofVecO ops (transM ops (k + 2) S) (k + 1)) k)
      (ops.swap (detO ops (subM ops (k + 1)
        (bumpIx k) (fun b => b) S))) := by
  have hk : k + 1 < k + 2 := Nat.lt_succ_self (k + 1)
  have hk0 : k < k + 2 := Nat.lt_trans (Nat.lt_succ_self k) hk
  have hG : (transM ops (k + 2) S).length = k + 2 :=
    transM_len ops (k + 2) S
  have hGr : rowsLen (k + 2) (transM ops (k + 2) S) :=
    transM_rows ops (k + 2) S
  have hcs : (colSwapM ops (k + 2) k (transM ops (k + 2) S)).length
      = k + 2 := colSwapM_len ops (k + 2) k _
  have h1 := colSwapM_det L.toDCore (k + 2) k
    (List.set (transM ops (k + 2) S) (k + 1) (unitFam ops (k + 2) k))
    (by rw [ground.length_set, hG])
    (rowsLen_set _ (k + 1) _ hGr (unitFam_len ops (k + 2) k)) hk
  have h2 := colSwap_List.set_unit L.toDCore (k + 2) k
    (transM ops (k + 2) S) hG hk
  have h3 := detO_lastUnit_subM L (k + 1)
    (colSwapM ops (k + 2) k (transM ops (k + 2) S)) hcs
  have h4 : R.rel (detO ops (subM ops (k + 1) (fun a => a) (fun b => b)
      (colSwapM ops (k + 2) k (transM ops (k + 2) S))))
      (detO ops (subM ops (k + 1) (fun a => a) (bumpIx k)
        (transM ops (k + 2) S))) := by
    refine detO_congr_letters L.toDCore _ _
      (by rw [subM_len, subM_len]) (fun a ha b hb => ?_)
    rw [subM_len] at ha hb
    rw [subM_entry ops (k + 1) _ _ _ a b ha hb,
      colSwapM_entry ops (k + 2) k (transM ops (k + 2) S) a b
        (Nat.lt_trans ha hk) (Nat.lt_trans hb hk),
      subM_entry ops (k + 1) _ _ (transM ops (k + 2) S) a b ha hb,
      bumpIx_swapIx k b hb]
    exact L.ovRefl _
  have h5 := subM_trans_det L.toDCore (k + 2) (k + 1)
    (fun a => a) (bumpIx k) S
    (fun a ha => Nat.lt_trans ha hk)
    (fun b hb => bumpIx_lt hb hk)
  have hmain : R.rel (ops.swap (detO ops (List.set (transM ops (k + 2) S)
      (k + 1) (unitFam ops (k + 2) k))))
      (detO ops (subM ops (k + 1) (bumpIx k) (fun b => b) S)) :=
    L.ovTrans (L.ovSymm h1)
      (L.ovTrans h2 (L.ovTrans h3 (L.ovTrans h4 h5)))
  refine L.ovTrans (L.ovSymm (cofRead L (k + 2)
    (transM ops (k + 2) S) hG (k + 1) k hk hk0)) ?_
  exact L.ovTrans (L.ovSymm (L.swapSwap _)) (L.swapCongr hmain)

/-- The border pair's cofactor at the leading row and the last
column, the row exchange's side carried. -/
private theorem cofBorder01 {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (k : Nat)
    (S : List (List γ)) :
    R.rel (ground.getAt ops.unit
        (cofVecO ops (transM ops (k + 2) S) k) (k + 1))
      (ops.swap (detO ops (subM ops (k + 1)
        (fun a => a) (bumpIx k) S))) := by
  have hk : k + 1 < k + 2 := Nat.lt_succ_self (k + 1)
  have hk0 : k < k + 2 := Nat.lt_trans (Nat.lt_succ_self k) hk
  have hG : (transM ops (k + 2) S).length = k + 2 :=
    transM_len ops (k + 2) S
  have hZ : (ground.adjSwap k (transM ops (k + 2) S)).length = k + 2 := by
    rw [ground.length_adjSwap, hG]
  have h1 : ground.adjSwap k (List.set (transM ops (k + 2) S) k
      (unitFam ops (k + 2) (k + 1)))
      = List.set (ground.adjSwap k (transM ops (k + 2) S)) (k + 1)
        (unitFam ops (k + 2) (k + 1)) :=
    adjSwap_List.set k (transM ops (k + 2) S) _
      (by rw [hG]; exact hk)
  have h2 := detO_swapAdj L.toDCore k
    (List.set (transM ops (k + 2) S) k (unitFam ops (k + 2) (k + 1)))
    (by rw [ground.length_set, hG]; exact hk)
  rw [h1] at h2
  have h3 := detO_lastUnit_subM L (k + 1)
    (ground.adjSwap k (transM ops (k + 2) S)) hZ
  have h4 : R.rel (detO ops (subM ops (k + 1) (fun a => a) (fun b => b)
      (ground.adjSwap k (transM ops (k + 2) S))))
      (detO ops (subM ops (k + 1) (bumpIx k) (fun b => b)
        (transM ops (k + 2) S))) := by
    refine detO_congr_letters L.toDCore _ _
      (by rw [subM_len, subM_len]) (fun a ha b hb => ?_)
    rw [subM_len] at ha hb
    rw [subM_entry ops (k + 1) _ _ _ a b ha hb,
      getAt_adjSwap ([] : List γ) k (transM ops (k + 2) S)
        (by rw [hG]; exact hk) a,
      subM_entry ops (k + 1) _ _ (transM ops (k + 2) S) a b ha hb,
      bumpIx_swapIx k a ha]
    exact L.ovRefl _
  have h5 := subM_trans_det L.toDCore (k + 2) (k + 1)
    (bumpIx k) (fun b => b) S
    (fun a ha => bumpIx_lt ha hk)
    (fun b hb => Nat.lt_trans hb hk)
  have hmain : R.rel (ops.swap (detO ops (List.set (transM ops (k + 2) S)
      k (unitFam ops (k + 2) (k + 1)))))
      (detO ops (subM ops (k + 1) (fun a => a) (bumpIx k) S)) :=
    L.ovTrans (L.ovSymm h2) (L.ovTrans h3 (L.ovTrans h4 h5))
  refine L.ovTrans (L.ovSymm (cofRead L (k + 2)
    (transM ops (k + 2) S) hG k (k + 1) hk0 hk)) ?_
  exact L.ovTrans (L.ovSymm (L.swapSwap _)) (L.swapCongr hmain)

/-- The border pair's cofactor at the leading row and the leading
column: the two exchanges' sides join even. -/
private theorem cofBorder00 {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (k : Nat)
    (S : List (List γ)) :
    R.rel (ground.getAt ops.unit
        (cofVecO ops (transM ops (k + 2) S) k) k)
      (detO ops (subM ops (k + 1)
        (bumpIx k) (bumpIx k) S)) := by
  have hk : k + 1 < k + 2 := Nat.lt_succ_self (k + 1)
  have hk0 : k < k + 2 := Nat.lt_trans (Nat.lt_succ_self k) hk
  have hG : (transM ops (k + 2) S).length = k + 2 :=
    transM_len ops (k + 2) S
  have hGr : rowsLen (k + 2) (transM ops (k + 2) S) :=
    transM_rows ops (k + 2) S
  have hZ : (ground.adjSwap k (transM ops (k + 2) S)).length = k + 2 := by
    rw [ground.length_adjSwap, hG]
  have hZr : rowsLen (k + 2) (ground.adjSwap k (transM ops (k + 2) S)) :=
    rowsLen_adjSwap k (transM ops (k + 2) S) hGr
  have h1 : ground.adjSwap k (List.set (transM ops (k + 2) S) k
      (unitFam ops (k + 2) k))
      = List.set (ground.adjSwap k (transM ops (k + 2) S)) (k + 1)
        (unitFam ops (k + 2) k) :=
    adjSwap_List.set k (transM ops (k + 2) S) _
      (by rw [hG]; exact hk)
  have h2 := detO_swapAdj L.toDCore k
    (List.set (transM ops (k + 2) S) k (unitFam ops (k + 2) k))
    (by rw [ground.length_set, hG]; exact hk)
  rw [h1] at h2
  have h3 := colSwapM_det L.toDCore (k + 2) k
    (List.set (ground.adjSwap k (transM ops (k + 2) S)) (k + 1)
      (unitFam ops (k + 2) k))
    (by rw [ground.length_set, hZ])
    (rowsLen_set _ (k + 1) _ hZr (unitFam_len ops (k + 2) k)) hk
  have h4 := colSwap_List.set_unit L.toDCore (k + 2) k
    (ground.adjSwap k (transM ops (k + 2) S)) hZ hk
  have h5 := detO_lastUnit_subM L (k + 1)
    (colSwapM ops (k + 2) k (ground.adjSwap k (transM ops (k + 2) S)))
    (colSwapM_len ops (k + 2) k _)
  have h6 : R.rel (detO ops (subM ops (k + 1) (fun a => a) (fun b => b)
      (colSwapM ops (k + 2) k
        (ground.adjSwap k (transM ops (k + 2) S)))))
      (detO ops (subM ops (k + 1) (bumpIx k) (bumpIx k)
        (transM ops (k + 2) S))) := by
    refine detO_congr_letters L.toDCore _ _
      (by rw [subM_len, subM_len]) (fun a ha b hb => ?_)
    rw [subM_len] at ha hb
    rw [subM_entry ops (k + 1) _ _ _ a b ha hb,
      colSwapM_entry ops (k + 2) k
        (ground.adjSwap k (transM ops (k + 2) S)) a b
        (Nat.lt_trans ha hk) (Nat.lt_trans hb hk),
      getAt_adjSwap ([] : List γ) k (transM ops (k + 2) S)
        (by rw [hG]; exact hk) a,
      subM_entry ops (k + 1) _ _ (transM ops (k + 2) S) a b ha hb,
      bumpIx_swapIx k a ha, bumpIx_swapIx k b hb]
    exact L.ovRefl _
  have h7 := subM_trans_det L.toDCore (k + 2) (k + 1)
    (bumpIx k) (bumpIx k) S
    (fun a ha => bumpIx_lt ha hk)
    (fun b hb => bumpIx_lt hb hk)
  refine L.ovTrans (L.ovSymm (cofRead L (k + 2)
    (transM ops (k + 2) S) hG k k hk0 hk0)) ?_
  refine L.ovTrans (L.ovSymm (L.swapSwap _)) ?_
  refine L.ovTrans (L.swapCongr (L.ovSymm h2)) ?_
  refine L.ovTrans (L.ovSymm h3) ?_
  exact L.ovTrans h4 (L.ovTrans h5 (L.ovTrans h6 h7))

/-- The solved row: the cofactor coefficients against the rows read
the determinant at the row's own key alone, the adjugate identity's
own display. -/
private theorem comboCof_entry {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (n : Nat)
    (S : List (List γ)) (hl : S.length = n) (hrows : rowsLen n S)
    (c q : Nat) (hc : c < n) (hq : q < n) :
    R.rel (ground.getAt ops.unit
        (comboO ops n (cofVecO ops (transM ops n S) c) S) q)
      (ground.getAt ops.unit
        (vecScaleO ops (detO ops S) (unitFam ops n c)) q) := by
  have hG : (transM ops n S).length = n := transM_len ops n S
  have hGr : rowsLen n (transM ops n S) := transM_rows ops n S
  have hrow : ∀ t, t < n →
      (ground.getAt [] (transM ops n S) t).length = n :=
    fun t ht => rowsLen_getAt _ t hGr (by rw [hG]; exact ht)
  have hcl : (comboO ops n (cofVecO ops (transM ops n S) c) S).length
      = n := length_comboO ops n _ S hrows
  refine L.ovTrans (L.ovSymm (dotO_unitRead L
    (unitFam ops n q) _ q (by rw [unitFam_len, hcl])
    (ovOfEq L.toDCore (unitFam_hit ops n q hq))
    (fun b hb => ovOfEq L.toDCore (unitFam_miss ops n q b hb)))) ?_
  refine L.ovTrans (dotO_combo L (cofVecO ops (transM ops n S) c) S
    (unitFam ops n q) n hrows) ?_
  refine L.ovTrans (dotO_congr_right L _ _
    (ground.getAt [] (transM ops n S) q)
    (by rw [ground.length_map, hl, hrow q hq]) (fun t ht => ?_)) ?_
  · rw [ground.length_map, hl] at ht
    rw [ground.getAt_map ([] : List γ) ops.unit
        (fun row => dotO ops (unitFam ops n q) row) S t
        (by rw [hl]; exact ht),
      transM_entry ops n S q t hq ht]
    exact dotO_unitRead L (unitFam ops n q)
      (ground.getAt [] S t) q
      (by rw [unitFam_len, rowsLen_getAt S t hrows (by rw [hl]; exact ht)])
      (ovOfEq L.toDCore (unitFam_hit ops n q hq))
      (fun b hb => ovOfEq L.toDCore (unitFam_miss ops n q b hb))
  · refine L.ovTrans (dotO_comm L.toDCore _ _) ?_
    rw [show vecScaleO ops (detO ops S) (unitFam ops n c)
        = (unitFam ops n c).map
          (fun x => ops.mul (detO ops S) x) from rfl,
      ground.getAt_map ops.unit ops.unit
        (fun x => ops.mul (detO ops S) x) (unitFam ops n c) q
        (by rw [unitFam_len]; exact hq)]
    by_cases hqc : q = c
    · rw [hqc, unitFam_hit ops n c hc]
      refine L.ovTrans (cofVecO_diag L (transM ops n S) c
        (by rw [hG]; exact hc) (by rw [hG]; exact hrow c hc)) ?_
      refine L.ovTrans (transM_det L.toDCore n S hl hrows) ?_
      exact L.ovSymm (L.ovTrans (L.mulComm (detO ops S) ops.one)
        (L.oneMul (detO ops S)))
    · rw [unitFam_miss ops n c q hqc]
      refine L.ovTrans (cofVecO_off L (transM ops n S) q c
        (by rw [hG]; exact hq) (by rw [hG]; exact hc) hqc
        (by rw [hG]; exact hrow q hq)) ?_
      exact L.ovSymm (L.mulUnit (detO ops S))

/-- The replaced row read as a combination whose members all read
the sum's unit but one: the determinant is that member's
coefficient against its own replaced determinant. -/
private theorem detO_comboRow_pick {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (n : Nat) (M S : List (List γ)) (hM : M.length = n)
    (hS : S.length = n) (hrows : rowsLen n S)
    (p : Nat) (hp : p < n) (y : List γ) (hy : y.length = n)
    (s0 : Nat) (hs0 : s0 < n) (V : γ)
    (hhit : R.rel (detO ops (List.set M p (ground.getAt [] S s0))) V)
    (hmiss : ∀ s, s < n → ¬ s = s0 →
      R.rel (detO ops (List.set M p (ground.getAt [] S s))) ops.unit) :
    R.rel (detO ops (List.set M p (comboO ops n y S)))
      (ops.mul (ground.getAt ops.unit y s0) V) := by
  have h := detO_List.set_combo L M p (by rw [hM]; exact hp) y S
    (by rw [hM]; exact hrows)
  rw [hM] at h
  refine L.ovTrans h ?_
  rw [dotO_map_index ops ([] : List γ)
    (fun row => detO ops (List.set M p row)) y S (by rw [hy, hS]), hS]
  refine L.ovTrans (foldO_congr_members L.toDCore _
    (fun s => if s0 = s then
        ops.mul (ground.getAt ops.unit y s0) V else ops.unit)
    (List.range n) (fun s hs => ?_))
    (foldO_pick L (fun _ => ops.mul (ground.getAt ops.unit y s0) V)
      (List.range n) s0
      (by rw [ground.countOf_range_one hs0]))
  have hsn : s < n := by
    rw [ground.countOf_range s n] at hs
    by_cases hc : s < n
    · exact hc
    · rw [if_neg hc] at hs
      exact absurd hs (Nat.lt_irrefl 0)
  by_cases hss : s0 = s
  · rw [if_pos hss, ← hss]
    exact L.mulCongr (L.ovRefl _) hhit
  · rw [if_neg hss]
    exact L.ovTrans
      (L.mulCongr (L.ovRefl _) (hmiss s hsn (fun he => hss he.symm)))
      (L.mulUnit _)

/-- The two determinant-scaled unit rows: the direct fold reads the
determinant's square against the leading submatrix. -/
private theorem detN_direct {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (k : Nat)
    (S : List (List γ)) (hl : S.length = k + 2) :
    R.rel (detO ops (List.set (List.set S k
          (vecScaleO ops (detO ops S) (unitFam ops (k + 2) k)))
        (k + 1)
        (vecScaleO ops (detO ops S) (unitFam ops (k + 2) (k + 1)))))
      (ops.mul (detO ops S) (ops.mul (detO ops S)
        (detO ops (subM ops k (fun a => a) (fun b => b) S)))) := by
  have hk : k + 1 < k + 2 := Nat.lt_succ_self (k + 1)
  have hk0 : k < k + 2 := Nat.lt_trans (Nat.lt_succ_self k) hk
  have hne : ¬ k = k + 1 := fun he => Nat.succ_ne_self k he.symm
  have hm1 : (List.set S k
      (vecScaleO ops (detO ops S) (unitFam ops (k + 2) k))).length
      = k + 2 := by rw [ground.length_set, hl]
  have hm2 : (List.set S (k + 1) (unitFam ops (k + 2) (k + 1))).length
      = k + 2 := by rw [ground.length_set, hl]
  have hvs : ∀ c, (vecScaleO ops (detO ops S)
      (unitFam ops (k + 2) c)).length = k + 2 := fun c => by
    show ((unitFam ops (k + 2) c).map _).length = k + 2
    rw [ground.length_map, unitFam_len]
  refine L.ovTrans (detO_List.set_dot L _ (k + 1)
    (by rw [hm1]; exact hk) _ (by rw [hvs, hm1])) ?_
  refine L.ovTrans (dotO_vecScale_left L (detO ops S) _ _) ?_
  refine L.mulCongr (L.ovRefl _) ?_
  refine L.ovTrans (L.ovSymm (detO_List.set_dot L _ (k + 1)
    (by rw [hm1]; exact hk) _ (by rw [unitFam_len, hm1]))) ?_
  rw [List.set_comm S k (k + 1)
    (vecScaleO ops (detO ops S) (unitFam ops (k + 2) k))
    (unitFam ops (k + 2) (k + 1)) hne]
  refine L.ovTrans (detO_List.set_dot L _ k
    (by rw [hm2]; exact hk0) _ (by rw [hvs, hm2])) ?_
  refine L.ovTrans (dotO_vecScale_left L (detO ops S) _ _) ?_
  refine L.mulCongr (L.ovRefl _) ?_
  refine L.ovTrans (L.ovSymm (detO_List.set_dot L _ k
    (by rw [hm2]; exact hk0) _ (by rw [unitFam_len, hm2]))) ?_
  rw [← List.set_comm S k (k + 1) (unitFam ops (k + 2) k)
    (unitFam ops (k + 2) (k + 1)) hne]
  refine L.ovTrans (detO_lastUnit_subM L (k + 1)
    (List.set S k (unitFam ops (k + 2) k))
    (by rw [ground.length_set, hl])) ?_
  refine L.ovTrans (detO_congr_letters L.toDCore _
    (List.set (subM ops (k + 1) (fun a => a) (fun b => b) S) k
      (unitFam ops (k + 1) k))
    (by rw [subM_len, ground.length_set, subM_len]) (fun a ha b hb => ?_))
    ?_
  · rw [subM_len] at ha hb
    rw [subM_entry ops (k + 1) _ _ _ a b ha hb]
    by_cases hak : a = k
    · rw [hak,
        ground.getAt_set_self ([] : List γ) _ S k (by rw [hl]; exact hk0),
        ground.getAt_set_self ([] : List γ) _
          (subM ops (k + 1) (fun a => a) (fun b => b) S) k
          (by rw [subM_len]; exact Nat.lt_succ_self k)]
      by_cases hbk : b = k
      · rw [hbk, unitFam_hit ops (k + 2) k hk0,
          unitFam_hit ops (k + 1) k (Nat.lt_succ_self k)]
        exact L.ovRefl _
      · rw [unitFam_miss ops (k + 2) k b hbk,
          unitFam_miss ops (k + 1) k b hbk]
        exact L.ovRefl _
    · rw [ground.getAt_set_ne ([] : List γ) S k a _ hak,
        ground.getAt_set_ne ([] : List γ)
          (subM ops (k + 1) (fun a => a) (fun b => b) S) k a _ hak,
        subM_entry ops (k + 1) _ _ S a b ha hb]
      exact L.ovRefl _
  · refine L.ovTrans (detO_lastUnit_subM L k
      (subM ops (k + 1) (fun a => a) (fun b => b) S)
      (subM_len ops (k + 1) _ _ S)) ?_
    refine detO_congr_letters L.toDCore _ _
      (by rw [subM_len, subM_len]) (fun a ha b hb => ?_)
    rw [subM_len] at ha hb
    rw [subM_entry ops k _ _ _ a b ha hb,
      subM_entry ops (k + 1) _ _ S a b
        (Nat.lt_trans ha (Nat.lt_succ_self k))
        (Nat.lt_trans hb (Nat.lt_succ_self k)),
      subM_entry ops k _ _ S a b ha hb]
    exact L.ovRefl _

/-- The two solved rows: the multilinear fold keeps the border
pair's selections alone, the further selections a row repeated at
equal members. 
The tex's solved columns enter at the row spelling through the
transpose (`transM`), the one object at the exchanged keys. -/
private theorem detN_expand {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) (k : Nat)
    (S : List (List γ)) (hl : S.length = k + 2)
    (hrows : rowsLen (k + 2) S) :
    R.rel (detO ops (List.set (List.set S k
          (comboO ops (k + 2)
            (cofVecO ops (transM ops (k + 2) S) k) S))
        (k + 1)
        (comboO ops (k + 2)
          (cofVecO ops (transM ops (k + 2) S) (k + 1)) S)))
      (ops.add
        (ops.mul (ground.getAt ops.unit
            (cofVecO ops (transM ops (k + 2) S) (k + 1)) k)
          (ops.mul (ground.getAt ops.unit
              (cofVecO ops (transM ops (k + 2) S) k) (k + 1))
            (ops.swap (detO ops S))))
        (ops.mul (ground.getAt ops.unit
            (cofVecO ops (transM ops (k + 2) S) (k + 1)) (k + 1))
          (ops.mul (ground.getAt ops.unit
              (cofVecO ops (transM ops (k + 2) S) k) k)
            (detO ops S)))) := by
  have hk : k + 1 < k + 2 := Nat.lt_succ_self (k + 1)
  have hk0 : k < k + 2 := Nat.lt_trans (Nat.lt_succ_self k) hk
  have hne : ¬ k = k + 1 := fun he => Nat.succ_ne_self k he.symm
  have hy : ∀ c, (cofVecO ops (transM ops (k + 2) S) c).length
      = k + 2 := fun c => by
    rw [length_cofVecO, transM_len]
  have hm1 : (List.set S k (comboO ops (k + 2)
      (cofVecO ops (transM ops (k + 2) S) k) S)).length = k + 2 := by
    rw [ground.length_set, hl]
  have hstep : ∀ (M : List (List γ)) (p s : Nat), M.length = k + 2 →
      p < k + 2 → s < k + 2 →
      ground.getAt [] (List.set M p (ground.getAt [] S s)) p
        = ground.getAt [] S s := fun M p s hM hp _ =>
    ground.getAt_set_self ([] : List γ) _ M p (by rw [hM]; exact hp)
  have houter := detO_List.set_combo L
    (List.set S k (comboO ops (k + 2)
      (cofVecO ops (transM ops (k + 2) S) k) S)) (k + 1)
    (by rw [hm1]; exact hk)
    (cofVecO ops (transM ops (k + 2) S) (k + 1)) S
    (by rw [hm1]; exact hrows)
  rw [hm1] at houter
  refine L.ovTrans houter ?_
  rw [dotO_map_index ops ([] : List γ)
    (fun row => detO ops (List.set (List.set S k (comboO ops (k + 2)
      (cofVecO ops (transM ops (k + 2) S) k) S)) (k + 1) row))
    (cofVecO ops (transM ops (k + 2) S) (k + 1)) S
    (by rw [hy, hl]), hl]
  refine L.ovTrans (foldO_pick2 L _ (List.range (k + 2)) k (k + 1)
    hne (by rw [ground.countOf_range_one hk0])
    (by rw [ground.countOf_range_one hk])
    (fun x hx hxk hxk1 => ?_)) ?_
  · have hxn : x < k + 2 := by
      rw [ground.countOf_range x (k + 2)] at hx
      by_cases hc : x < k + 2
      · exact hc
      · rw [if_neg hc] at hx
        exact absurd hx (Nat.lt_irrefl 0)
    refine L.ovTrans (L.mulCongr (L.ovRefl _) ?_) (L.mulUnit _)
    refine detO_rows_equal L
      (show x < k + 1 from Nat.lt_of_le_of_ne
        (Nat.le_of_succ_le_succ hxn) hxk1)
      (show k + 1 < (List.set (List.set S k (comboO ops (k + 2)
          (cofVecO ops (transM ops (k + 2) S) k) S)) (k + 1)
          (ground.getAt [] S x)).length from by
        rw [ground.length_set, hm1]
        exact hk)
      ?_
    rw [ground.getAt_set_ne ([] : List γ) _ (k + 1) x _ hxk1,
      ground.getAt_set_ne ([] : List γ) S k x _ hxk,
      hstep _ (k + 1) x hm1 hk hxn]
  · refine L.addCongr ?_ ?_
    · refine L.mulCongr (L.ovRefl _) ?_
      rw [List.set_comm S k (k + 1) _ (ground.getAt [] S k) hne]
      refine detO_comboRow_pick L (k + 2)
        (List.set S (k + 1) (ground.getAt [] S k)) S
        (by rw [ground.length_set, hl]) hl hrows k hk0 _ (hy k)
        (k + 1) hk (ops.swap (detO ops S)) ?_ (fun s hs hsk => ?_)
      · rw [List.set_swapAdj ([] : List γ) k S (by rw [hl]; exact hk)]
        exact detO_swapAdj L.toDCore k S (by rw [hl]; exact hk)
      · have hml : (List.set S (k + 1) (ground.getAt [] S k)).length
            = k + 2 := by rw [ground.length_set, hl]
        have hXl : (List.set (List.set S (k + 1) (ground.getAt [] S k)) k
            (ground.getAt [] S s)).length = k + 2 := by
          rw [ground.length_set, hml]
        by_cases hsk0 : s = k
        · refine detO_rows_equal L (Nat.lt_succ_self k)
            (by rw [hXl]; exact hk) ?_
          rw [hsk0,
            ground.getAt_set_self ([] : List γ) _
              (List.set S (k + 1) (ground.getAt [] S k)) k
              (by rw [hml]; exact hk0),
            ground.getAt_set_ne ([] : List γ) _ k (k + 1) _
              (fun he => Nat.succ_ne_self k he),
            ground.getAt_set_self ([] : List γ) _ S (k + 1)
              (by rw [hl]; exact hk)]
        · refine detO_rows_equal L
            (show s < k from Nat.lt_of_le_of_ne
              (Nat.le_of_succ_le_succ (Nat.lt_of_le_of_ne
                (Nat.le_of_succ_le_succ hs) hsk)) hsk0)
            (by rw [hXl]; exact hk0) ?_
          rw [ground.getAt_set_ne ([] : List γ) _ k s _ hsk0,
            ground.getAt_set_ne ([] : List γ) S (k + 1) s _ hsk,
            ground.getAt_set_self ([] : List γ) _
              (List.set S (k + 1) (ground.getAt [] S k)) k
              (by rw [hml]; exact hk0)]
    · refine L.mulCongr (L.ovRefl _) ?_
      rw [← ground.getAt_set_ne ([] : List γ) S k (k + 1)
          (comboO ops (k + 2)
            (cofVecO ops (transM ops (k + 2) S) k) S)
          (fun he => Nat.succ_ne_self k he),
        ground.set_self ([] : List γ) _ (k + 1) (by rw [hm1]; exact hk)]
      refine detO_comboRow_pick L (k + 2) S S hl hl hrows k hk0 _
        (hy k) k hk0 (detO ops S) ?_ (fun s hs hsk => ?_)
      · rw [ground.set_self ([] : List γ) S k (by rw [hl]; exact hk0)]
        exact L.ovRefl _
      · have hXl : (List.set S k (ground.getAt [] S s)).length = k + 2 := by
          rw [ground.length_set, hl]
        match Nat.lt_or_ge s k with
        | .inl hsk1 =>
          refine detO_rows_equal L hsk1 (by rw [hXl]; exact hk0) ?_
          rw [ground.getAt_set_ne ([] : List γ) S k s _ hsk,
            ground.getAt_set_self ([] : List γ) _ S k (by rw [hl]; exact hk0)]
        | .inr hsk1 =>
          refine detO_rows_equal L
            (show k < s from Nat.lt_of_le_of_ne hsk1
              (fun he => hsk he.symm))
            (by rw [hXl]; exact hs) ?_
          rw [ground.getAt_set_self ([] : List γ) _ S k (by rw [hl]; exact hk0),
            ground.getAt_set_ne ([] : List γ) S k s _ hsk]

/-- The balance partner passes the product's left factor. -/
private theorem mulSwapLeft {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) (x y : γ) :
    R.rel (ops.mul (ops.swap x) y) (ops.swap (ops.mul x y)) :=
  C.ovTrans (C.mulComm (ops.swap x) y)
    (C.ovTrans (C.mulSwapRight y x) (C.swapCongr (C.mulComm y x)))

/-- The sum distributes on the right. -/
private theorem rightDistribO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) (x y z : γ) :
    R.rel (ops.mul (ops.add x y) z)
      (ops.add (ops.mul x z) (ops.mul y z)) :=
  C.ovTrans (C.mulComm (ops.add x y) z)
    (C.ovTrans (C.leftDistrib z x y)
      (C.addCongr (C.mulComm z x) (C.mulComm z y)))

/-- Jacobi's corner read at the border pair: the adjugate corner's
two-by-two determinant against the determinant reads that
determinant's square against the leading submatrix — `def:elim`'s
two solved rows, the multilinear fold against the direct one. -/
private theorem jacobiCorner {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (k : Nat)
    (S : List (List γ)) (hl : S.length = k + 2)
    (hrows : rowsLen (k + 2) S) :
    R.rel (ops.mul
        (ops.add
          (ops.mul
            (detO ops (subM ops (k + 1) (bumpIx k) (bumpIx k) S))
            (detO ops (subM ops (k + 1)
              (fun a => a) (fun b => b) S)))
          (ops.swap (ops.mul
            (detO ops (subM ops (k + 1) (fun a => a) (bumpIx k) S))
            (detO ops (subM ops (k + 1) (bumpIx k) (fun b => b) S)))))
        (detO ops S))
      (ops.mul (detO ops S) (ops.mul (detO ops S)
        (detO ops (subM ops k (fun a => a) (fun b => b) S)))) := by
  have hk : k + 1 < k + 2 := Nat.lt_succ_self (k + 1)
  have hk0 : k < k + 2 := Nat.lt_trans (Nat.lt_succ_self k) hk
  have hne : ¬ k = k + 1 := fun he => Nat.succ_ne_self k he.symm
  have h00 := cofBorder00 L k S
  have h11 := cofBorder11 L k S
  have h01 := cofBorder01 L k S
  have h10 := cofBorder10 L k S
  have hA := detN_expand L k S hl hrows
  have hcong : R.rel (detO ops (List.set (List.set S k
        (comboO ops (k + 2)
          (cofVecO ops (transM ops (k + 2) S) k) S))
        (k + 1)
        (comboO ops (k + 2)
          (cofVecO ops (transM ops (k + 2) S) (k + 1)) S)))
      (detO ops (List.set (List.set S k
          (vecScaleO ops (detO ops S) (unitFam ops (k + 2) k)))
        (k + 1)
        (vecScaleO ops (detO ops S)
          (unitFam ops (k + 2) (k + 1))))) := by
    refine detO_congr_letters L.toDCore _ _
      (by rw [ground.length_set, ground.length_set, ground.length_set,
        ground.length_set]) (fun a ha b hb => ?_)
    rw [ground.length_set, ground.length_set, hl] at ha hb
    by_cases ha1 : a = k + 1
    · rw [ha1,
        ground.getAt_set_self ([] : List γ) _ _ (k + 1)
          (by rw [ground.length_set, hl]; exact hk),
        ground.getAt_set_self ([] : List γ) _ _ (k + 1)
          (by rw [ground.length_set, hl]; exact hk)]
      exact comboCof_entry L (k + 2) S hl hrows
        (k + 1) b hk hb
    · rw [ground.getAt_set_ne ([] : List γ) _ (k + 1) a _ ha1,
        ground.getAt_set_ne ([] : List γ) _ (k + 1) a _ ha1]
      by_cases ha0 : a = k
      · rw [ha0,
          ground.getAt_set_self ([] : List γ) _ S k (by rw [hl]; exact hk0),
          ground.getAt_set_self ([] : List γ) _ S k (by rw [hl]; exact hk0)]
        exact comboCof_entry L (k + 2) S hl hrows
          k b hk0 hb
      · rw [ground.getAt_set_ne ([] : List γ) S k a _ ha0,
          ground.getAt_set_ne ([] : List γ) S k a _ ha0]
        exact L.ovRefl _
  have hB := detN_direct L k S hl
  refine L.ovTrans ?_ (L.ovTrans (L.ovSymm hA)
    (L.ovTrans hcong hB))
  refine L.ovTrans (rightDistribO L.toDCore _ _ (detO ops S)) ?_
  refine L.ovTrans (L.addComm _ _) ?_
  refine L.addCongr ?_ ?_
  · refine L.ovTrans (mulSwapLeft L.toDCore _ (detO ops S)) ?_
    refine L.ovTrans (L.swapCongr (L.mulAssoc _ _ _)) ?_
    refine L.ovTrans (L.swapCongr (ground.opLeftCommO (commLawsMulOf L.toDCore) _ _ _)) ?_
    refine L.ovTrans (L.ovSymm (mulSwapLeft L.toDCore _ _)) ?_
    refine L.mulCongr (L.ovSymm h10) ?_
    refine L.ovTrans (L.ovSymm (L.swapSwap _)) ?_
    refine L.ovTrans (L.swapCongr (L.ovSymm (L.mulSwapRight _ _))) ?_
    refine L.ovTrans (L.ovSymm (mulSwapLeft L.toDCore _ _)) ?_
    exact L.mulCongr (L.ovSymm h01) (L.ovRefl _)
  · refine L.ovTrans (L.mulCongr
      (L.mulCongr (L.ovSymm h00) (L.ovSymm h11)) (L.ovRefl _)) ?_
    refine L.ovTrans (L.mulCongr (L.mulComm _ _) (L.ovRefl _)) ?_
    exact L.mulAssoc _ _ _

/-! The polynomial carrier's instance: the monic determinant
withdraws at the division's one value, and the evaluation at the
equal-membered pair reads the identity at the stated entries. -/

/-- The width's construction at the positional reads: every entry
at the stated count carries the width whole. -/
theorem rowsLen_intro {γ : Type} {n : Nat} :
    ∀ M : List (List γ),
      (∀ i, i < M.length →
        (ground.getAt ([] : List γ) M i).length = n) → rowsLen n M
  | [], _ => trivial
  | _ :: t, h =>
    ⟨h 0 (Nat.succ_pos _),
     rowsLen_intro t (fun i hi => h (i + 1) (Nat.succ_lt_succ hi))⟩

/-- The determinant's entrywise congruence at the balance
carrier. -/
theorem detL_congr_letters (M N : Mat)
    (hl : M.length = N.length)
    (h : ∀ a, a < M.length → ∀ b, b < M.length →
      (ground.getAt BPair.unit (ground.getAt [] M a) b).oneValue
        (ground.getAt BPair.unit (ground.getAt [] N a) b)) :
    (detL M).oneValue (detL N) :=
  detO_congr_letters (R := ground.bpairRead) bpairCore M N hl h

/-- The bumped key read against the bordered key list: below the
count the key itself, at it the border. -/
private theorem borderKey_bump (k x r : Nat) (hx : x < k + 1) :
    (if bumpIx k x < k + 1 then bumpIx k x else r)
      = (if x < k then x else r) := by
  by_cases h : x < k
  · rw [if_pos h,
      show bumpIx k x = x from by
        show (if x = k then k + 1 else x) = x
        rw [if_neg (fun he => Nat.lt_irrefl k
          (by rw [he] at h; exact h))],
      if_pos (Nat.lt_trans h (Nat.lt_succ_self k))]
  · rw [if_neg h,
      show bumpIx k x = k + 1 from by
        show (if x = k then k + 1 else x) = k + 1
        rw [if_pos (Nat.le_antisymm (Nat.le_of_succ_le_succ hx)
          (Nat.le_of_not_lt h))],
      if_neg (Nat.lt_irrefl (k + 1))]

/-- The leading key read against the bordered key list. -/
private theorem borderKey_id (k x r : Nat) (hx : x < k + 1) :
    (if x < k + 1 then x else r) = (if x < k then x else k) := by
  rw [if_pos hx]
  by_cases h : x < k
  · rw [if_pos h]
  · rw [if_neg h]
    exact Nat.le_antisymm (Nat.le_of_succ_le_succ hx)
      (Nat.le_of_not_lt h)

/-- The balance partner moves across the sum: at a join reading a
datum, the datum reads the join's further member back. -/
private theorem swapMove {X Y Z : BPair}
    (h : (BPair.add X Y.swap).oneValue Z) :
    (BPair.add Z Y).oneValue X :=
  BPair.oneValue_trans
    (BPair.add_congr (BPair.oneValue_symm h) (BPair.oneValue_refl Y))
    (BPair.oneValue_trans
      (BPair.oneValue_of_eq (BPair.add_assoc X Y.swap Y))
      (BPair.oneValue_trans
        (BPair.add_congr (BPair.oneValue_refl X)
          (BPair.swap_add_null (BPair.oneValue_refl Y)))
        (BPair.add_unit X)))

/-! The bordered sublists at the bundle carrier: the index surgery
the descent's walk reads, `keepCols` at the bundle's unit
default. -/

private def keepColsO {γ : Type} (ops : DOps γ) (ks : List Nat)
    (r : List γ) : List γ :=
  ks.map (fun j => ground.getAt ops.unit r j)

private def borderAtO {γ : Type} (ops : DOps γ) (k i j : Nat)
    (m : List (List γ)) : List (List γ) :=
  ((List.range k) ++ [i]).map (fun a =>
    keepColsO ops ((List.range k) ++ [j]) (ground.getAt [] m a))

private def leadAtO {γ : Type} (ops : DOps γ) (k : Nat)
    (m : List (List γ)) : List (List γ) :=
  (List.range k).map (fun a =>
    keepColsO ops (List.range k) (ground.getAt [] m a))

private theorem keepColsO_len {γ : Type} (ops : DOps γ)
    (ks : List Nat) (r : List γ) :
    (keepColsO ops ks r).length = ks.length := by
  show ((ks.map (fun j => ground.getAt ops.unit r j))).length
    = ks.length
  rw [ground.length_map]

private theorem keepColsO_entry {γ : Type} (ops : DOps γ)
    (ks : List Nat) (r : List γ) (b : Nat) (hb : b < ks.length) :
    ground.getAt ops.unit (keepColsO ops ks r) b
      = ground.getAt ops.unit r (ground.getAt 0 ks b) := by
  show ground.getAt ops.unit
    (ks.map (fun j => ground.getAt ops.unit r j)) b = _
  rw [ground.getAt_map 0 ops.unit _ ks b hb]

private theorem borderAtO_len {γ : Type} (ops : DOps γ)
    (k i j : Nat) (m : List (List γ)) :
    (borderAtO ops k i j m).length = k + 1 := by
  show (((List.range k) ++ [i]).map (fun a =>
    keepColsO ops ((List.range k) ++ [j])
      (ground.getAt [] m a))).length = k + 1
  rw [ground.length_map, borderKeys_len]

private theorem borderAtO_rows {γ : Type} (ops : DOps γ)
    (k i j : Nat) (m : List (List γ)) :
    rowsLen (k + 1) (borderAtO ops k i j m) :=
  rowsLen_map _ (k + 1) (List.range k ++ [i])
    (fun x _ => (fun _ => by
      rw [keepColsO_len, borderKeys_len]) x)

private theorem borderAtO_row {γ : Type} (ops : DOps γ)
    (k i j : Nat) (m : List (List γ)) (a : Nat) (ha : a < k + 1) :
    ground.getAt [] (borderAtO ops k i j m) a
      = keepColsO ops ((List.range k) ++ [j])
        (ground.getAt [] m (if a < k then a else i)) := by
  show ground.getAt [] (((List.range k) ++ [i]).map (fun a =>
    keepColsO ops ((List.range k) ++ [j])
      (ground.getAt [] m a))) a = _
  rw [ground.getAt_map 0 [] _ (List.range k ++ [i]) a
      (by rw [borderKeys_len]; exact ha),
    borderKeys k i a ha]

private theorem borderAtO_entry {γ : Type} (ops : DOps γ)
    (k i j : Nat) (m : List (List γ)) (a b : Nat)
    (ha : a < k + 1) (hb : b < k + 1) :
    ground.getAt ops.unit
        (ground.getAt [] (borderAtO ops k i j m) a) b
      = ground.getAt ops.unit
        (ground.getAt [] m (if a < k then a else i))
        (if b < k then b else j) := by
  rw [borderAtO_row ops k i j m a ha,
    keepColsO_entry ops _ _ b (by rw [borderKeys_len]; exact hb),
    borderKeys k j b hb]

private theorem leadAtO_len {γ : Type} (ops : DOps γ) (k : Nat)
    (m : List (List γ)) : (leadAtO ops k m).length = k :=
  ground.matOf_length k k _

private theorem leadAtO_entry {γ : Type} (ops : DOps γ) (k : Nat)
    (m : List (List γ)) (a b : Nat) (ha : a < k) (hb : b < k) :
    ground.getAt ops.unit (ground.getAt [] (leadAtO ops k m) a) b
      = ground.getAt ops.unit (ground.getAt [] m a) b :=
  ground.matOf_entry [] ops.unit k k _ a b ha hb

/-! The evaluation morphism at the lifted carrier: the Horner read
at the bundle carries the lifted determinant to the carrier's own,
and the shifted list at the sum's unit reads its source back —
`def:elim`'s evaluation sentence at the bundle, `sylvesterO` its
close. -/

def evalLO {γ : Type} (ops : DOps γ) : List γ → γ → γ
  | [], _ => ops.unit
  | c :: p, r => ops.add c (ops.mul r (evalLO ops p r))

private theorem evalAddLO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ∀ (p q : List γ) (r : γ),
      R.rel (evalLO ops (poly.addLO ops p q) r)
        (ops.add (evalLO ops p r) (evalLO ops q r))
  | [], q, r => L.toDCore.ovSymm (L.unitAdd (evalLO ops q r))
  | c :: p, [], r =>
    L.toDCore.ovSymm (L.addUnit (evalLO ops (c :: p) r))
  | c :: p, d :: q, r => by
    show R.rel (ops.add (ops.add c d)
        (ops.mul r (evalLO ops (poly.addLO ops p q) r)))
      (ops.add (ops.add c (ops.mul r (evalLO ops p r)))
        (ops.add d (ops.mul r (evalLO ops q r))))
    refine L.toDCore.ovTrans
      (L.toDCore.addCongr (L.toDCore.ovRefl _)
        (L.toDCore.ovTrans
          (L.toDCore.mulCongr (L.toDCore.ovRefl r)
            (evalAddLO L p q r))
          (L.toDCore.leftDistrib r _ _))) ?_
    exact ground.opExchO (commLawsOf L.toDCore) c d (ops.mul r (evalLO ops p r))
      (ops.mul r (evalLO ops q r))

private theorem evalScaleLO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ∀ (q : List γ) (c r : γ),
      R.rel (evalLO ops (q.map (ops.mul c)) r)
        (ops.mul c (evalLO ops q r))
  | [], c, _ => L.toDCore.ovSymm (L.mulUnit c)
  | d :: q, c, r => by
    show R.rel (ops.add (ops.mul c d)
        (ops.mul r (evalLO ops (q.map (ops.mul c)) r)))
      (ops.mul c (ops.add d (ops.mul r (evalLO ops q r))))
    refine L.toDCore.ovTrans
      (L.toDCore.addCongr (L.toDCore.ovRefl _)
        (L.toDCore.ovTrans
          (L.toDCore.mulCongr (L.toDCore.ovRefl r)
            (evalScaleLO L q c r))
          (ground.opLeftCommO (commLawsMulOf L.toDCore) r c (evalLO ops q r)))) ?_
    exact L.toDCore.ovSymm (L.toDCore.leftDistrib c d
      (ops.mul r (evalLO ops q r)))

private theorem evalMulLO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ∀ (p q : List γ) (r : γ),
      R.rel (evalLO ops (poly.mulLO ops p q) r)
        (ops.mul (evalLO ops p r) (evalLO ops q r))
  | [], q, r =>
    L.toDCore.ovSymm (L.toDCore.ovTrans
      (L.toDCore.mulComm ops.unit (evalLO ops q r))
      (L.mulUnit (evalLO ops q r)))
  | c :: p, q, r => by
    show R.rel (evalLO ops (poly.addLO ops (q.map (ops.mul c))
        (ops.unit :: poly.mulLO ops p q)) r)
      (ops.mul (ops.add c (ops.mul r (evalLO ops p r)))
        (evalLO ops q r))
    refine L.toDCore.ovTrans (evalAddLO L (q.map (ops.mul c))
      (ops.unit :: poly.mulLO ops p q) r) ?_
    refine L.toDCore.ovTrans
      (L.toDCore.addCongr (evalScaleLO L q c r)
        (show R.rel (evalLO ops (ops.unit :: poly.mulLO ops p q) r)
            (ops.mul r (ops.mul (evalLO ops p r) (evalLO ops q r)))
          from L.toDCore.ovTrans (L.unitAdd _)
            (L.toDCore.mulCongr (L.toDCore.ovRefl r)
              (evalMulLO L p q r)))) ?_
    refine L.toDCore.ovTrans
      (L.toDCore.addCongr (L.toDCore.ovRefl _)
        (L.toDCore.ovSymm (L.toDCore.mulAssoc r (evalLO ops p r)
          (evalLO ops q r)))) ?_
    refine L.toDCore.ovSymm ?_
    refine L.toDCore.ovTrans
      (L.toDCore.ovTrans
        (L.toDCore.mulComm _ (evalLO ops q r))
        (L.toDCore.leftDistrib (evalLO ops q r) c
          (ops.mul r (evalLO ops p r)))) ?_
    exact L.toDCore.addCongr
      (L.toDCore.mulComm (evalLO ops q r) c)
      (L.toDCore.mulComm (evalLO ops q r) _)

private theorem evalUtO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ∀ {p : List γ}, poly.unitTailO ops R p → ∀ r : γ,
      R.rel (evalLO ops p r) ops.unit
  | [], _, _ => L.toDCore.ovRefl _
  | _ :: p, h, r =>
    L.toDCore.ovTrans
      (L.toDCore.addCongr h.1
        (L.toDCore.ovTrans
          (L.toDCore.mulCongr (L.toDCore.ovRefl r)
            (evalUtO L (p := p) h.2 r))
          (L.mulUnit r)))
      (L.unitAdd ops.unit)

private theorem evalCongrO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ∀ {p q : List γ}, poly.listOV ops R p q → ∀ r : γ,
      R.rel (evalLO ops p r) (evalLO ops q r)
  | [], q, h, r => L.toDCore.ovSymm (evalUtO L (p := q) h r)
  | _ :: p, [], h, r =>
    evalUtO L (p := _ :: p) ⟨h.1, h.2⟩ r
  | _ :: p, _ :: q, h, r =>
    L.toDCore.addCongr h.1
      (L.toDCore.mulCongr (L.toDCore.ovRefl r)
        (evalCongrO L (p := p) (q := q) h.2 r))

private def evalMatLO {γ : Type} (ops : DOps γ)
    (M : List (List (List γ))) (r : γ) : List (List γ) :=
  M.map (fun row => row.map (fun p => evalLO ops p r))

private theorem evalMatLO_len {γ : Type} (ops : DOps γ)
    (M : List (List (List γ))) (r : γ) :
    (evalMatLO ops M r).length = M.length :=
  ground.length_map _ M

private theorem evalRowGetAtO {γ : Type} (ops : DOps γ) (r : γ) :
    ∀ (row : List (List γ)) (j : Nat),
    evalLO ops (ground.getAt [] row j) r
      = ground.getAt ops.unit
        (row.map (fun p => evalLO ops p r)) j
  | [], _ => rfl
  | _ :: _, 0 => rfl
  | _ :: row, j + 1 => evalRowGetAtO ops r row j

private theorem evalNegO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) :
    ∀ (X : List γ) (r : γ),
      R.rel (evalLO ops (X.map ops.swap) r) (ops.swap (evalLO ops X r))
  | [], _ => C.ovSymm C.swapUnit
  | c :: p, r => by
    show R.rel (ops.add (ops.swap c)
        (ops.mul r (evalLO ops (p.map ops.swap) r)))
      (ops.swap (ops.add c (ops.mul r (evalLO ops p r))))
    refine C.ovTrans
      (C.addCongr (C.ovRefl _)
        (C.ovTrans (C.mulCongr (C.ovRefl r) (evalNegO C p r))
          (C.mulSwapRight r _))) ?_
    exact C.ovSymm (C.swapAdd c (ops.mul r (evalLO ops p r)))

/-- A carrier map's entry read: inside the row the mapped entry,
beyond it the two carriers' sums' units. -/
private theorem getAtHomO {γ δ : Type} (opsγ : DOps γ) (opsδ : DOps δ)
    {Rδ : ground.DRead δ} (Cδ : DCore δ opsδ Rδ.rel) (φ : γ → δ)
    (hunit : Rδ.rel (φ opsγ.unit) opsδ.unit) :
    ∀ (r : List γ) (j : Nat),
      Rδ.rel (φ (ground.getAt opsγ.unit r j))
        (ground.getAt opsδ.unit (r.map φ) j)
  | [], _ => hunit
  | _ :: _, 0 => Cδ.ovRefl _
  | _ :: t, j + 1 => getAtHomO opsγ opsδ Cδ φ hunit t j

/-- A carrier map carrying the sum with its unit carries the
family fold. -/
private theorem foldHomO {γ δ α : Type} (opsγ : DOps γ) (opsδ : DOps δ)
    {Rδ : ground.DRead δ} (Cδ : DCore δ opsδ Rδ.rel) (φ : γ → δ)
    (hadd : ∀ x y, Rδ.rel (φ (opsγ.add x y)) (opsδ.add (φ x) (φ y)))
    (hunit : Rδ.rel (φ opsγ.unit) opsδ.unit)
    (f : α → γ) (g : α → δ) (h : ∀ a, Rδ.rel (φ (f a)) (g a)) :
    ∀ l : List α,
      Rδ.rel (φ (ground.famFold opsγ.add opsγ.unit f l))
        (ground.famFold opsδ.add opsδ.unit g l)
  | [] => hunit
  | a :: t =>
    Cδ.ovTrans (hadd (f a) (ground.famFold opsγ.add opsγ.unit f t))
      (Cδ.addCongr (h a) (foldHomO opsγ opsδ Cδ φ hadd hunit f g h t))

/-- A carrier map carrying the product with the two units carries
the assignment's term. -/
private theorem termHomO {γ δ : Type} (opsγ : DOps γ) (opsδ : DOps δ)
    {Rδ : ground.DRead δ} (Cδ : DCore δ opsδ Rδ.rel) (φ : γ → δ)
    (hmul : ∀ x y, Rδ.rel (φ (opsγ.mul x y)) (opsδ.mul (φ x) (φ y)))
    (hunit : Rδ.rel (φ opsγ.unit) opsδ.unit)
    (hone : Rδ.rel (φ opsγ.one) opsδ.one) :
    ∀ (M : List (List γ)) (p : List Nat),
      Rδ.rel (φ (termO opsγ M p))
        (termO opsδ (M.map (fun r => r.map φ)) p)
  | [], _ => hone
  | _ :: _, [] => hone
  | row :: rows, j :: js =>
    Cδ.ovTrans
      (hmul (ground.getAt opsγ.unit row j) (termO opsγ rows js))
      (Cδ.mulCongr (getAtHomO opsγ opsδ Cδ φ hunit row j)
        (termHomO opsγ opsδ Cδ φ hmul hunit hone rows js))

/-- The determinant at a carrier map: a map carrying the sum, the
product, the balance partner and the two units carries the signed
assignment fold onto the mapped entries' own. -/
private theorem detO_hom {γ δ : Type} (opsγ : DOps γ) (opsδ : DOps δ)
    {Rδ : ground.DRead δ} (Cδ : DCore δ opsδ Rδ.rel) (φ : γ → δ)
    (hadd : ∀ x y, Rδ.rel (φ (opsγ.add x y)) (opsδ.add (φ x) (φ y)))
    (hmul : ∀ x y, Rδ.rel (φ (opsγ.mul x y)) (opsδ.mul (φ x) (φ y)))
    (hswap : ∀ x, Rδ.rel (φ (opsγ.swap x)) (opsδ.swap (φ x)))
    (hunit : Rδ.rel (φ opsγ.unit) opsδ.unit)
    (hone : Rδ.rel (φ opsγ.one) opsδ.one)
    (M : List (List γ)) :
    Rδ.rel (φ (detO opsγ M))
      (detO opsδ (M.map (fun r => r.map φ))) := by
  show Rδ.rel (φ (ground.famFold opsγ.add opsγ.unit
      (fun p => sgnO opsγ p (termO opsγ M p))
      (places.monomialsAt (List.replicate M.length 1))))
    (ground.famFold opsδ.add opsδ.unit
      (fun p => sgnO opsδ p
        (termO opsδ (M.map (fun r => r.map φ)) p))
      (places.monomialsAt (List.replicate
        (M.map (fun r => r.map φ)).length 1)))
  rw [ground.length_map]
  refine foldHomO opsγ opsδ Cδ φ hadd hunit _ _ (fun p => ?_) _
  show Rδ.rel (φ (if places.parity p then opsγ.swap (termO opsγ M p)
      else termO opsγ M p))
    (if places.parity p
      then opsδ.swap (termO opsδ (M.map (fun r => r.map φ)) p)
      else termO opsδ (M.map (fun r => r.map φ)) p)
  cases places.parity p with
  | false => exact termHomO opsγ opsδ Cδ φ hmul hunit hone M p
  | true =>
    exact Cδ.ovTrans (hswap (termO opsγ M p))
      (Cδ.swapCongr (termHomO opsγ opsδ Cδ φ hmul hunit hone M p))

private theorem evalDetLO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
        (M : List (List (List γ))) (r : γ) :
    R.rel (evalLO ops (detO (poly.polyO ops) M) r)
      (detO ops (evalMatLO ops M r)) :=
  detO_hom (poly.polyO ops) ops L.toDCore (fun f => evalLO ops f r)
    (fun x y => evalAddLO L x y r)
    (fun x y => evalMulLO L x y r)
    (fun x => evalNegO L.toDCore x r)
    (L.toDCore.ovRefl ops.unit)
    (L.toDCore.ovTrans
      (L.toDCore.addCongr (L.toDCore.ovRefl ops.one) (L.mulUnit r))
      (L.addUnit ops.one))
    M

private theorem shiftedRowEvalO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) (r : List γ) (i : Nat) :
    poly.listOV ops R ((shiftedRowO ops r i).map
      (fun p => evalLO ops p ops.unit)) r := by
  refine lovOfGetAt L.toDCore (fun k => ?_)
  match Nat.lt_or_ge k r.length with
  | .inl hk =>
    rw [show ground.getAt ops.unit ((shiftedRowO ops r i).map
        (fun p => evalLO ops p ops.unit)) k
        = evalLO ops (ground.getAt [] (shiftedRowO ops r i) k)
          ops.unit from
      (evalRowGetAtO ops ops.unit (shiftedRowO ops r i) k).symm,
      shiftedRowO_entry ops r i k hk]
    cases Nat.beq i k with
    | true =>
      show R.rel (ops.add (ground.getAt ops.unit r k)
          (ops.mul ops.unit (ops.add ops.one
            (ops.mul ops.unit ops.unit)))) (ground.getAt ops.unit r k)
      refine L.toDCore.ovTrans
        (L.toDCore.addCongr (L.toDCore.ovRefl _)
          (L.toDCore.ovTrans
            (L.toDCore.mulComm ops.unit _) (L.mulUnit _))) ?_
      exact L.addUnit _
    | false =>
      show R.rel (ops.add (ground.getAt ops.unit r k)
          (ops.mul ops.unit ops.unit)) (ground.getAt ops.unit r k)
      refine L.toDCore.ovTrans
        (L.toDCore.addCongr (L.toDCore.ovRefl _) (L.mulUnit _)) ?_
      exact L.addUnit _
  | .inr hk =>
    rw [ground.getAt_over ops.unit _ k
        (by rw [ground.length_map, shiftedRowO_len]; exact hk),
      ground.getAt_over ops.unit r k hk]
    exact L.toDCore.ovRefl _

private theorem evalSubMDetO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
        (A : List (List γ)) (p : Nat) (f g : Nat → Nat)
    (N : List (List γ)) (hN : N.length = p)
    (hf : ∀ a, a < p → f a < A.length)
    (hent : ∀ a, a < p → ∀ b, b < p →
      R.rel (ground.getAt ops.unit (ground.getAt [] A (f a)) (g b))
        (ground.getAt ops.unit (ground.getAt [] N a) b)) :
    R.rel (evalLO ops (detO (poly.polyO ops)
        (subM (poly.polyO ops) p f g (shiftedMO ops A))) ops.unit)
      (detO ops N) := by
  refine L.toDCore.ovTrans
    (evalDetLO L (subM (poly.polyO ops) p f g (shiftedMO ops A))
      ops.unit) ?_
  refine detO_congr_letters L.toDCore _ N
    (by rw [evalMatLO_len, subM_len, hN]) (fun a ha b hb => ?_)
  rw [evalMatLO_len, subM_len] at ha hb
  have hfa : f a < (shiftedMO ops A).length := by
    rw [shiftedMO_len]
    exact hf a ha
  show R.rel (ground.getAt ops.unit (ground.getAt []
    ((subM (poly.polyO ops) p f g (shiftedMO ops A)).map (fun row =>
      row.map (fun q => evalLO ops q ops.unit))) a) b) _
  rw [ground.getAt_map ([] : List (List γ)) ([] : List γ)
      (fun row => row.map (fun q => evalLO ops q ops.unit))
      (subM (poly.polyO ops) p f g (shiftedMO ops A)) a
      (by rw [subM_len]; exact ha),
    ← evalRowGetAtO ops ops.unit
      (ground.getAt [] (subM (poly.polyO ops) p f g (shiftedMO ops A)) a) b]
  show R.rel (evalLO ops (ground.getAt (poly.polyO ops).unit
    (ground.getAt [] (subM (poly.polyO ops) p f g (shiftedMO ops A)) a) b)
    ops.unit) _
  rw [subM_entry (poly.polyO ops) p f g (shiftedMO ops A) a b ha hb]
  show R.rel (evalLO ops (ground.getAt ([] : List γ)
    (ground.getAt [] (shiftedMO ops A) (f a)) (g b)) ops.unit) _
  rw [shiftedMO_row ops A (f a) (by
      rw [shiftedMO_len] at hfa; exact hfa),
    evalRowGetAtO ops ops.unit
      (shiftedRowO ops (ground.getAt [] A (f a)) (f a)) (g b)]
  refine L.toDCore.ovTrans
    (lovGetAt L.toDCore
      (shiftedRowEvalO L (ground.getAt [] A (f a)) (f a)) (g b)) ?_
  exact hent a ha b hb

private theorem evalShiftedMDetO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
        (A : List (List γ)) :
    R.rel (evalLO ops (detO (poly.polyO ops) (shiftedMO ops A)) ops.unit)
      (detO ops A) := by
  refine L.toDCore.ovTrans
    (evalDetLO L (shiftedMO ops A) ops.unit) ?_
  refine detO_congr_letters L.toDCore _ A
    (by rw [evalMatLO_len, shiftedMO_len]) (fun a ha b _ => ?_)
  rw [evalMatLO_len, shiftedMO_len] at ha
  show R.rel (ground.getAt ops.unit (ground.getAt []
    ((shiftedMO ops A).map (fun row =>
      row.map (fun q => evalLO ops q ops.unit))) a) b) _
  rw [ground.getAt_map ([] : List (List γ)) ([] : List γ)
      (fun row => row.map (fun q => evalLO ops q ops.unit))
      (shiftedMO ops A) a (by rw [shiftedMO_len]; exact ha),
    shiftedMO_row ops A a ha]
  exact lovGetAt L.toDCore
    (shiftedRowEvalO L (ground.getAt [] A a) a) b

private theorem shiftedMO_rows {γ : Type} (ops : DOps γ) {n : Nat}
    (B : List (List γ)) (hrows : rowsLen n B) :
    rowsLen n (shiftedMO ops B) :=
  rowsLen_intro _ (fun i hi => by
    rw [shiftedMO_len] at hi
    rw [shiftedMO_row ops B i hi, shiftedRowO_len]
    exact rowsLen_getAt B i hrows hi)

private theorem swapMoveO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    {X Y Z : γ} (h : R.rel (ops.add X (ops.swap Y)) Z) :
    R.rel (ops.add Z Y) X := by
  refine L.toDCore.ovTrans
    (L.toDCore.addCongr (L.toDCore.ovSymm h) (L.toDCore.ovRefl Y)) ?_
  refine L.toDCore.ovTrans
    (L.toDCore.addAssoc X (ops.swap Y) Y) ?_
  refine L.toDCore.ovTrans
    (L.toDCore.addCongr (L.toDCore.ovRefl X)
      (L.toDCore.ovTrans
        (L.toDCore.addComm (ops.swap Y) Y) (annihDerived L Y))) ?_
  exact L.addUnit X

/-- Sylvester's identity at the bundle: the identity's derivation
at the shifted diagonal over the lifted carrier, the monic
determinant withdrawn at the cancellation and the evaluation at
the sum's unit reading the source minors back — `def:elim`'s own
route at any carrier of the laws, at every key list. -/
private theorem sylvesterO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
            (m : List (List γ)) (k i j : Nat) :
    R.rel (ops.add
        (ops.mul (detO ops (leadAtO ops k m))
          (detO ops (borderAtO ops (k + 1) i j m)))
        (ops.mul (detO ops (borderAtO ops k i k m))
          (detO ops (borderAtO ops k k j m))))
      (ops.mul (detO ops (borderAtO ops k k k m))
        (detO ops (borderAtO ops k i j m))) := by
  have hk : k + 1 < k + 2 := Nat.lt_succ_self (k + 1)
  have hAl : (borderAtO ops (k + 1) i j m).length = k + 2 :=
    borderAtO_len ops (k + 1) i j m
  have hAr : rowsLen (k + 2) (borderAtO ops (k + 1) i j m) :=
    borderAtO_rows ops (k + 1) i j m
  have hSl : (shiftedMO ops (borderAtO ops (k + 1) i j m)).length
      = k + 2 := by
    rw [shiftedMO_len, hAl]
  have hSr : rowsLen (k + 2)
      (shiftedMO ops (borderAtO ops (k + 1) i j m)) :=
    shiftedMO_rows ops _ hAr
  have hmon := shiftDetMonicO L (borderAtO ops (k + 1) i j m)
    (by rw [hAl]; exact hAr)
  have hJ := jacobiCorner (R := poly.listRead ops R) (polyLawsO L) k
    (shiftedMO ops (borderAtO ops (k + 1) i j m)) hSl hSr
  have hcanc := cancelMonicOV L
    (detO (poly.polyO ops) (shiftedMO ops (borderAtO ops (k + 1) i j m))) _ _
    hmon ((polyCoreO L).ovTrans ((polyCoreO L).mulComm _ _) hJ)
  have hE := evalCongrO L hcanc ops.unit
  have e00 := evalSubMDetO L (borderAtO ops (k + 1) i j m) (k + 1)
    (bumpIx k) (bumpIx k) (borderAtO ops k i j m)
    (borderAtO_len ops k i j m)
    (fun a ha => by rw [hAl]; exact bumpIx_lt ha hk)
    (fun a ha b hb => by
      rw [borderAtO_entry ops (k + 1) i j m (bumpIx k a) (bumpIx k b)
          (bumpIx_lt ha hk) (bumpIx_lt hb hk),
        borderAtO_entry ops k i j m a b ha hb,
        borderKey_bump k a i ha, borderKey_bump k b j hb]
      exact L.toDCore.ovRefl _)
  have e11 := evalSubMDetO L (borderAtO ops (k + 1) i j m) (k + 1)
    (fun a => a) (fun b => b) (borderAtO ops k k k m)
    (borderAtO_len ops k k k m)
    (fun a ha => by rw [hAl]; exact Nat.lt_trans ha hk)
    (fun a ha b hb => by
      rw [borderAtO_entry ops (k + 1) i j m a b
          (Nat.lt_trans ha hk) (Nat.lt_trans hb hk),
        borderAtO_entry ops k k k m a b ha hb,
        borderKey_id k a i ha, borderKey_id k b j hb]
      exact L.toDCore.ovRefl _)
  have e10 := evalSubMDetO L (borderAtO ops (k + 1) i j m) (k + 1)
    (fun a => a) (bumpIx k) (borderAtO ops k k j m)
    (borderAtO_len ops k k j m)
    (fun a ha => by rw [hAl]; exact Nat.lt_trans ha hk)
    (fun a ha b hb => by
      rw [borderAtO_entry ops (k + 1) i j m a (bumpIx k b)
          (Nat.lt_trans ha hk) (bumpIx_lt hb hk),
        borderAtO_entry ops k k j m a b ha hb,
        borderKey_id k a i ha, borderKey_bump k b j hb]
      exact L.toDCore.ovRefl _)
  have e01 := evalSubMDetO L (borderAtO ops (k + 1) i j m) (k + 1)
    (bumpIx k) (fun b => b) (borderAtO ops k i k m)
    (borderAtO_len ops k i k m)
    (fun a ha => by rw [hAl]; exact bumpIx_lt ha hk)
    (fun a ha b hb => by
      rw [borderAtO_entry ops (k + 1) i j m (bumpIx k a) b
          (bumpIx_lt ha hk) (Nat.lt_trans hb hk),
        borderAtO_entry ops k i k m a b ha hb,
        borderKey_bump k a i ha, borderKey_id k b j hb]
      exact L.toDCore.ovRefl _)
  have eP := evalSubMDetO L (borderAtO ops (k + 1) i j m) k
    (fun a => a) (fun b => b) (leadAtO ops k m) (leadAtO_len ops k m)
    (fun a ha => by
      rw [hAl]
      exact Nat.lt_trans (Nat.lt_trans ha (Nat.lt_succ_self k)) hk)
    (fun a ha b hb => by
      rw [borderAtO_entry ops (k + 1) i j m a b
          (Nat.lt_trans (Nat.lt_trans ha (Nat.lt_succ_self k)) hk)
          (Nat.lt_trans (Nat.lt_trans hb (Nat.lt_succ_self k)) hk),
        if_pos (Nat.lt_trans ha (Nat.lt_succ_self k)),
        if_pos (Nat.lt_trans hb (Nat.lt_succ_self k)),
        leadAtO_entry ops k m a b ha hb]
      exact L.toDCore.ovRefl _)
  have eD := evalShiftedMDetO L (borderAtO ops (k + 1) i j m)
  have hL : R.rel (evalLO ops ((poly.polyO ops).add
        ((poly.polyO ops).mul
          (detO (poly.polyO ops) (subM (poly.polyO ops) (k + 1) (bumpIx k)
            (bumpIx k) (shiftedMO ops (borderAtO ops (k + 1) i j m))))
          (detO (poly.polyO ops) (subM (poly.polyO ops) (k + 1) (fun a => a)
            (fun b => b) (shiftedMO ops (borderAtO ops (k + 1) i j m)))))
        ((poly.polyO ops).swap ((poly.polyO ops).mul
          (detO (poly.polyO ops) (subM (poly.polyO ops) (k + 1) (fun a => a)
            (bumpIx k) (shiftedMO ops (borderAtO ops (k + 1) i j m))))
          (detO (poly.polyO ops) (subM (poly.polyO ops) (k + 1) (bumpIx k)
            (fun b => b)
            (shiftedMO ops (borderAtO ops (k + 1) i j m)))))))
      ops.unit)
      (ops.add
        (ops.mul (detO ops (borderAtO ops k i j m))
          (detO ops (borderAtO ops k k k m)))
        (ops.swap (ops.mul (detO ops (borderAtO ops k k j m))
          (detO ops (borderAtO ops k i k m))))) := by
    refine L.toDCore.ovTrans (evalAddLO L _ _ ops.unit) ?_
    refine L.toDCore.addCongr ?_ ?_
    · exact L.toDCore.ovTrans (evalMulLO L _ _ ops.unit)
        (L.toDCore.mulCongr e00 e11)
    · exact L.toDCore.ovTrans (evalNegO L.toDCore _ ops.unit)
        (L.toDCore.swapCongr (L.toDCore.ovTrans
          (evalMulLO L _ _ ops.unit)
          (L.toDCore.mulCongr e10 e01)))
  have hR : R.rel (evalLO ops ((poly.polyO ops).mul
        (detO (poly.polyO ops) (shiftedMO ops (borderAtO ops (k + 1) i j m)))
        (detO (poly.polyO ops) (subM (poly.polyO ops) k (fun a => a)
          (fun b => b)
          (shiftedMO ops (borderAtO ops (k + 1) i j m))))) ops.unit)
      (ops.mul (detO ops (borderAtO ops (k + 1) i j m))
        (detO ops (leadAtO ops k m))) :=
    L.toDCore.ovTrans (evalMulLO L _ _ ops.unit)
      (L.toDCore.mulCongr eD eP)
  have hfinal := swapMoveO L (L.toDCore.ovTrans
    (L.toDCore.ovSymm hL) (L.toDCore.ovTrans hE hR))
  refine L.toDCore.ovTrans ?_
    (L.toDCore.ovTrans hfinal (L.toDCore.mulComm _ _))
  exact L.toDCore.addCongr (L.toDCore.mulComm _ _)
    (L.toDCore.mulComm _ _)

set_option linter.unusedVariables false in
/-- Sylvester's identity at the pivot descent (`def:elim`): the
leading minor against the next step's bordered minor, joined to the
two crossing bordered minors, reads the pivot's own bordered minor
against the step's — the shifted bordered determinants' corner
read, evaluated at the equal-membered pair.  The shape and range
binders are the frame `def:elim` states the descent at; the proof
consumes none of them, the bordered sublists reading the sum's
unit beyond every stated key, so the identity holds at every key
list whatever. 
The keys are zero-based: the pivot sits at key `k`, the tex's
`k+1`. -/
theorem sylvester (m : Mat) (hsq : rowsLen m.length m) (k i j : Nat)
    (hki : k < i) (him : i < m.length) (hkj : k < j)
    (hjm : j < m.length) :
    (BPair.add
        (BPair.mul (detL (leadAt k m))
          (detL (borderAt (k + 1) i j m)))
        (BPair.mul (detL (borderAt k i k m))
          (detL (borderAt k k j m)))).oneValue
      (BPair.mul (detL (borderAt k k k m))
        (detL (borderAt k i j m))) :=
  sylvesterO (R := ground.bpairRead) bpairLaws m k i j

/-- `def:elim`'s fraction-free step divides exactly: the step's
bordered numerator — the pivot's own bordered minor against the
step's, joined to the swapped crossing product — is the previous
leading minor's own multiple, `cofactorAt` the quotient.  Sylvester's
identity states the numerator at the leading minor's product with
the next step's bordered minor, the crossing product moving across
the sum, and `cofactorAt_sound` closes at a leading minor off the
sum's unit.  The shape and range binders are the frame `def:elim`
states the descent at; the identity's own proof consumes none of
them. -/
theorem divExact (m : Mat) (hsq : rowsLen m.length m) (k i j : Nat)
    (hki : k < i) (him : i < m.length) (hkj : k < j)
    (hjm : j < m.length) :
    (BPair.mul (detL (leadAt k m))
      (cofactorAt
        (BPair.add
          (BPair.mul (detL (borderAt k k k m)) (detL (borderAt k i j m)))
          (BPair.swap (BPair.mul (detL (borderAt k i k m))
            (detL (borderAt k k j m)))))
        (detL (leadAt k m)))).oneValue
      (BPair.add
        (BPair.mul (detL (borderAt k k k m)) (detL (borderAt k i j m)))
        (BPair.swap (BPair.mul (detL (borderAt k i k m))
          (detL (borderAt k k j m))))) := by
  have hprod := BPair.oneValue_symm
    (swapMove
      (Y := (BPair.mul (detL (borderAt k i k m))
        (detL (borderAt k k j m))).swap)
      (sylvester m hsq k i j hki him hkj hjm))
  by_cases hP : (detL (leadAt k m)).oneValue BPair.unit
  · have hEu := BPair.oneValue_trans (BPair.oneValue_symm hprod)
      (BPair.oneValue_trans
        (BPair.mul_congr hP (BPair.oneValue_refl _))
        (BPair.unit_mul _))
    rw [cofactorAt_eqMem
      (BPair.add
        (BPair.mul (detL (borderAt k k k m)) (detL (borderAt k i j m)))
        (BPair.swap (BPair.mul (detL (borderAt k i k m))
          (detL (borderAt k k j m)))))
      (detL (leadAt k m)) (BPair.eqMem_of_oneValue hEu)]
    exact BPair.oneValue_trans (BPair.mul_unit _)
      (BPair.oneValue_symm hEu)
  · exact cofactorAt_sound hP hprod

/-! Independence's elimination (`lem:lowerspan`'s read-back of a
dependency's coefficients): a combination reading the unit family pairs against
every row at the sum's unit, so the cofactor vector's own
combination reads the coefficients through the Gram — the
diagonal cofactor the determinant, the further ones the unit, and
the one-index pairing picks the coefficient out at the
determinant's clearing. -/

/-- A vector whose every entry sits at the sum's unit is a unit
tail, the pointwise read assembled. -/
theorem unitTail_of_getAt : ∀ u : List BPair,
    (∀ p, p < u.length →
      (ground.getAt BPair.unit u p).oneValue BPair.unit) →
    poly.unitTail u
  | [], _ => trivial
  | _ :: u, h =>
    ⟨h 0 (Nat.succ_pos _),
     unitTail_of_getAt u
       (fun p hp => h (p + 1) (Nat.succ_lt_succ hp))⟩

/-- The one-index pairing: against a family whose every other place
sits at the sum's unit the pairing is the stated place's own
product. -/
theorem dotP_oneIndex : ∀ (cs M : List BPair) (p : Nat),
    cs.length = M.length → p < M.length →
    (∀ q, q < M.length → ¬ q = p →
      (ground.getAt BPair.unit M q).oneValue BPair.unit) →
    (dotP cs M).oneValue
      (ground.getAt BPair.unit cs p
        * ground.getAt BPair.unit M p)
  | [], [], p, _, hp, _ => absurd hp (Nat.not_lt_zero p)
  | [], _ :: _, _, hl, _, _ => Nat.noConfusion hl
  | _ :: _, [], _, hl, _, _ => Nat.noConfusion hl
  | c :: cs, m :: M, 0, _, _, h => by
    show (c * m + dotP cs M).oneValue (c * m)
    refine BPair.oneValue_trans
      (BPair.add_congr (BPair.oneValue_refl (c * m))
        (dotP_null_right cs M (fun i hi =>
          h (i + 1) (Nat.succ_lt_succ hi)
            (fun hb => Nat.noConfusion hb)))) ?_
    exact BPair.add_unit (c * m)
  | c :: cs, m :: M, p + 1, hl, hp, h => by
    show (c * m + dotP cs M).oneValue
      (ground.getAt BPair.unit cs p
        * ground.getAt BPair.unit M p)
    refine BPair.oneValue_trans
      (BPair.add_congr
        (BPair.oneValue_trans
          (BPair.mul_congr (BPair.oneValue_refl c)
            (h 0 (Nat.succ_pos _) (fun hb => Nat.noConfusion hb)))
          (BPair.mul_unit c))
        (dotP_oneIndex cs M p (Nat.succ.inj hl)
          (Nat.lt_of_succ_lt_succ hp)
          (fun q hq hne => h (q + 1) (Nat.succ_lt_succ hq)
            (fun hb => hne (Nat.succ.inj hb))))) ?_
    exact BPair.unit_add _

/-- The place indicator at a stated width: the natural one at the
key, the sum's unit elsewhere. -/
def idRow (n k : Nat) : List BPair :=
  (List.range n).map (fun i => if i = k then BPair.ofNat 1 else BPair.unit)

/-- The indicator's width. -/
theorem length_idRow (n k : Nat) : (idRow n k).length = n :=
  ground.length_mapRange _ n

/-- The indicator's entry: the key comparison's own read. -/
theorem getAt_idRow (n k j : Nat) (hj : j < n) :
    ground.getAt BPair.unit (idRow n k) j
      = if j = k then BPair.ofNat 1 else BPair.unit := by
  show ground.getAt BPair.unit ((List.range n).map
    (fun i => if i = k then BPair.ofNat 1 else BPair.unit)) j = _
  rw [ground.getAt_map 0 BPair.unit _ (List.range n) j
      (by rw [ground.length_range]; exact hj),
    ground.getAt_range n j hj]

/-- The dot against the indicator reads the key's own entry. -/
theorem dotP_idRow (u : List BPair) (n i : Nat)
    (hu : u.length = n) (hi : i < n) :
    (dotP u (idRow n i)).oneValue (ground.getAt BPair.unit u i) := by
  refine BPair.oneValue_trans
    (dotP_oneIndex u (idRow n i) i (by rw [hu, length_idRow])
      (by rw [length_idRow]; exact hi) ?_) ?_
  · intro q hq hne
    rw [length_idRow] at hq
    rw [getAt_idRow n i q hq, if_neg hne]
    exact BPair.oneValue_refl _
  · rw [getAt_idRow n i i hi, if_pos rfl]
    exact BPair.mul_ofNat_one _

/-- Independence's elimination: a combination reading the unit
family reads its coefficients there, the determinant's converse.
The cofactor vector at the coefficient's own key, combined against
the rows, pairs with each row at the Gram's cofactor read — the
sum's unit off the key and the determinant at it — while the same
pairing runs through the combination's unit tail, so the
coefficient against the determinant sits at the sum's unit and the
clearing reads it back. -/
theorem indep_elim {n : Nat} {L : Mat} (h : indepRows n L) :
    ∀ cs, cs.length = L.length → poly.unitTail (combo n cs L) →
      poly.unitTail cs := by
  intro cs hcl hnull
  obtain ⟨hLn, hdet⟩ := h
  refine unitTail_of_getAt cs (fun k hk => ?_)
  rw [hcl] at hk
  have hGl : (gramM L).length = L.length := length_gramM L
  have hkG : k < (gramM L).length := by rw [hGl]; exact hk
  have hMl : (L.map (fun row =>
      dotP (combo n (cofVec (gramM L) k) L) row)).length
      = L.length := ground.length_map _ L
  have hrowG : ∀ i, i < L.length →
      (ground.getAt [] (gramM L) i).length = (gramM L).length := by
    intro i hi
    rw [sqAt_row_len (gram_sqAt L) i (by rw [hGl]; exact hi), hGl]
  have hentry : ∀ i, i < L.length →
      (ground.getAt BPair.unit (L.map (fun row =>
        dotP (combo n (cofVec (gramM L) k) L) row)) i).oneValue
        (dotP (ground.getAt [] (gramM L) i)
          (cofVec (gramM L) k)) := by
    intro i hi
    rw [ground.getAt_map ([] : List BPair) BPair.unit
      (fun row => dotP (combo n (cofVec (gramM L) k) L) row)
      L i hi]
    refine BPair.oneValue_trans
      (BPair.oneValue_of_eq (dotP_comm _ _)) ?_
    refine BPair.oneValue_trans
      (dotP_combo (cofVec (gramM L) k) L (ground.getAt [] L i) n
        hLn) ?_
    rw [show L.map (fun row => dotP (ground.getAt [] L i) row)
        = ground.getAt [] (gramM L) i from
      (gramM_row L i hi).symm]
    exact BPair.oneValue_of_eq (dotP_comm (cofVec (gramM L) k)
      (ground.getAt [] (gramM L) i))
  have hpick := dotP_oneIndex cs
    (L.map (fun row =>
      dotP (combo n (cofVec (gramM L) k) L) row)) k
    (by rw [hMl, hcl]) (by rw [hMl]; exact hk)
    (fun q hq hqk => by
      rw [hMl] at hq
      exact BPair.oneValue_trans (hentry q hq)
        (cofVec_off (gramM L) q k (by rw [hGl]; exact hq) hkG hqk
          (hrowG q hq)))
  have hnullS : (dotP cs (L.map (fun row =>
      dotP (combo n (cofVec (gramM L) k) L) row))).oneValue
      BPair.unit :=
    BPair.oneValue_trans
      (BPair.oneValue_symm
        (dotP_combo cs L (combo n (cofVec (gramM L) k) L) n
          hLn))
      (dotP_null_right (combo n (cofVec (gramM L) k) L)
        (combo n cs L)
        (fun i _ => poly.getAt_unitTail hnull i))
  refine mul_cancel_unit hdet ?_
  rw [BPair.mul_comm (detL (gramM L))
    (ground.getAt BPair.unit cs k)]
  exact BPair.oneValue_trans
    (BPair.oneValue_symm
      (BPair.oneValue_trans hpick
        (BPair.mul_congr (BPair.oneValue_refl _)
          (BPair.oneValue_trans (hentry k hk)
            (cofVec_diag (gramM L) k hkG (hrowG k hk))))))
    hnullS

/-- A combination pairing every listed row at the sum's unit reads
its coefficients at the unit family: the combination's self-pairing
runs through the rows' own pairings, the positive pairing withdraws
it, and the family's independence reads the coefficients back
(`lem:lowerspan`). -/
theorem indep_perp_null (n : Nat) (L : Mat) (hind : indepRows n L)
    (f : List BPair) (hf : f.length = L.length)
    (hperp : ∀ l, l < L.length →
      (dotP (combo n f L) (ground.getAt [] L l)).oneValue
        BPair.unit) :
    poly.unitTail f :=
  indep_elim hind f hf
    (combo_self_null n L hind.1 f (fun i hi => by
      rw [dotP_comm]
      exact hperp i hi))

/-- An accepted vector extends the independent family: a
dependency with the new coefficient off the sum's unit is a span
witness, and one with it there falls back to the family's own. -/
private theorem indep_extendE (n : Nat) (L : Mat) (v : List BPair)
    (hLn : rowsLen n L) (hv : v.length = n)
    (hind : indepRows n L) (hns : ¬ spanRelE n L v) :
    indepRows n (L ++ [v]) := by
  refine indep_intro n (L ++ [v])
    (rowsLen_append n hLn ⟨hv, trivial⟩) ?_
  intro cs' hlen hnull
  match splitLast cs' with
  | Or.inl he =>
    rw [he, ground.length_append] at hlen
    exact nomatch hlen
  | Or.inr ⟨cs, c, he⟩ =>
    rw [he] at hlen hnull ⊢
    have hcl : cs.length = L.length := by
      rw [ground.length_append, ground.length_append] at hlen
      exact Nat.succ.inj hlen
    have hco := combo_append_one n cs c L v hcl hLn hv
    have h1 : poly.unitTail (vecAdd (combo n cs L)
        (vecScale c v)) :=
      poly.unitTail_oneValue_right hnull hco
    by_cases hcu : c.oneValue BPair.unit
    · have h2 : poly.unitTail (combo n cs L) :=
        unitTail_split_left
          (by rw [length_combo n cs L hLn, length_vecScale, hv])
          h1 (unitTail_vecScale_unit hcu v)
      exact unitTail_append (indep_elim hind cs hcl h2)
        ⟨hcu, trivial⟩
    · refine absurd ⟨c, cs.map BPair.swap, hcu,
        (by rw [ground.length_map]; exact hcl), ?_⟩ hns
      rw [combo_swapMap n cs L]
      exact swap_of_null_add (combo n cs L) (vecScale c v)
        (by rw [length_combo n cs L hLn, length_vecScale, hv]) h1

/-- The member-free list is independent outright at every width. -/
theorem indep_nil (n : Nat) : indepRows n ([] : Mat) :=
  ⟨trivial, det_nil⟩

/-- A one-member list off the unit tail is independent: the
combination's coefficient clears at the member's occupied entry,
the product's injectivity. -/
theorem indep_single (n : Nat) (r : List BPair)
    (hrn : r.length = n) (hr : ¬ poly.unitTail r) :
    indepRows n [r] := by
  refine indep_intro n [r] ⟨hrn, trivial⟩ ?_
  intro cs hlen hnull
  match cs, hlen with
  | [], hl => exact nomatch hl
  | _ :: _ :: _, hl => exact nomatch (Nat.succ.inj hl)
  | [c], _ =>
    have hnull' : poly.unitTail (vecAdd (vecScale c r)
        (List.replicate n BPair.unit)) := hnull
    match poly.offUnit_witness r hr with
    | ⟨k, hk, hrk⟩ =>
      have hkn : k < n := by
        rw [← hrn]
        exact hk
      have hkv : k < (vecAdd (vecScale c r)
          (List.replicate n BPair.unit)).length := by
        rw [length_vecAdd _ _ n
          (by
            rw [length_vecScale c r]
            exact hrn)
          (ground.length_replicate BPair.unit n)]
        exact hkn
      have hget := poly.getAt_unitTail hnull' k
      rw [getAt_vecAdd _ _ k
          (by
            rw [length_vecScale c r]
            exact hk)
          (by
            rw [ground.length_replicate]
            exact hkn),
        getAt_vecScale c r k hk] at hget
      have hrep := poly.getAt_unitTail (poly.unitTail_replicate n) k
      have h2 : (c * ground.getAt BPair.unit r k).oneValue
          BPair.unit :=
        BPair.oneValue_trans
          (BPair.oneValue_symm (BPair.oneValue_trans
            (BPair.add_congr
              (BPair.oneValue_refl (c * ground.getAt BPair.unit r k))
              hrep)
            (BPair.add_unit (c * ground.getAt BPair.unit r k))))
          hget
      have h3 : (ground.getAt BPair.unit r k * c).oneValue
          BPair.unit := by
        rw [BPair.mul_comm]
        exact h2
      exact ⟨mul_cancel_unit hrk h3, trivial⟩

/-! The independence tier's descent: the tail, the adjacent
exchange, the front move, and the width bound at the head pivot's
elimination. -/

/-- Independence descends to the tail: the head's coefficient
enters at the sum's unit. -/
theorem indep_tail (n : Nat) (r : List BPair) (t : Mat)
    (h : indepRows n (r :: t)) : indepRows n t := by
  refine indep_intro n t h.1.2 ?_
  intro cs hcl hnull
  have h1 : poly.unitTail (combo n (BPair.unit :: cs) (r :: t)) :=
    unitTail_vecAdd_of
      (unitTail_vecScale_unit (BPair.oneValue_refl BPair.unit) r)
      hnull
  exact (indep_elim h (BPair.unit :: cs)
    (congrArg Nat.succ hcl) h1).2

/-- The memberwise sum commutes. -/
theorem vecAdd_comm : ∀ u v : List BPair,
    vecAdd u v = vecAdd v u
  | [], [] => rfl
  | [], _ :: _ => rfl
  | _ :: _, [] => rfl
  | a :: u, b :: v => by
    show (a + b) :: vecAdd u v = (b + a) :: vecAdd v u
    rw [BPair.add_comm a b, vecAdd_comm u v]

/-- The memberwise sum associates. -/
theorem vecAdd_assoc : ∀ a b x : List BPair,
    vecAdd (vecAdd a b) x = vecAdd a (vecAdd b x)
  | [], _, _ => rfl
  | _ :: _, [], _ => rfl
  | _ :: _, _ :: _, [] => rfl
  | a1 :: a, b1 :: b, x1 :: x => by
    show (a1 + b1 + x1) :: vecAdd (vecAdd a b) x
      = (a1 + (b1 + x1)) :: vecAdd a (vecAdd b x)
    rw [BPair.add_assoc a1 b1 x1, vecAdd_assoc a b x]

private theorem vecAdd_left_comm (a b x : List BPair) :
    vecAdd a (vecAdd b x) = vecAdd b (vecAdd a x) := by
  rw [← vecAdd_assoc a b x, ← vecAdd_assoc b a x, vecAdd_comm a b]

private theorem combo_swapAdj (n : Nat) : ∀ (k : Nat)
    (cs : List BPair) (L : Mat), cs.length = L.length →
      combo n (ground.adjSwap k cs) (ground.adjSwap k L) = combo n cs L
  | 0, [], [], _ => rfl
  | 0, [], _ :: _, hl => nomatch hl
  | 0, _ :: _, [], hl => nomatch hl
  | 0, [_], [_], _ => rfl
  | 0, [_], _ :: _ :: _, hl => nomatch (Nat.succ.inj hl)
  | 0, _ :: _ :: _, [_], hl => nomatch (Nat.succ.inj hl)
  | 0, c :: c2 :: cs, r :: r2 :: L, _ => by
    show vecAdd (vecScale c2 r2)
        (vecAdd (vecScale c r) (combo n cs L))
      = vecAdd (vecScale c r)
        (vecAdd (vecScale c2 r2) (combo n cs L))
    exact vecAdd_left_comm _ _ _
  | _ + 1, [], [], _ => rfl
  | _ + 1, [], _ :: _, hl => nomatch hl
  | _ + 1, _ :: _, [], hl => nomatch hl
  | k + 1, c :: cs, r :: L, hl =>
    congrArg (fun z => vecAdd (vecScale c r) z)
      (combo_swapAdj n k cs L (Nat.succ.inj hl))

private theorem unitTail_adjSwap : ∀ (k : Nat) (l : List BPair),
    poly.unitTail l → poly.unitTail (ground.adjSwap k l)
  | 0, [], h => h
  | _ + 1, [], h => h
  | 0, [_], h => h
  | 0, _ :: _ :: _, h => ⟨h.2.1, h.1, h.2.2⟩
  | k + 1, _ :: t, h => ⟨h.1, unitTail_adjSwap k t h.2⟩

/-- Independence is kept under an adjacent exchange of the
rows. -/
theorem indep_swapAdj (n k : Nat) (L : Mat)
    (h : indepRows n L) : indepRows n (ground.adjSwap k L) := by
  refine indep_intro n (ground.adjSwap k L)
    (rowsLen_adjSwap k L h.1) ?_
  intro cs hcl hnull
  have hsw : (ground.adjSwap k cs).length = L.length := by
    rw [ground.length_adjSwap, hcl, ground.length_adjSwap]
  have hkey : combo n (ground.adjSwap k (ground.adjSwap k cs))
      (ground.adjSwap k L) = combo n (ground.adjSwap k cs) L :=
    combo_swapAdj n k (ground.adjSwap k cs) L hsw
  rw [ground.adjSwap_adjSwap k cs] at hkey
  have h2 : poly.unitTail (combo n (ground.adjSwap k cs) L) := by
    rw [← hkey]
    exact hnull
  have h4 := unitTail_adjSwap k (ground.adjSwap k cs)
    (indep_elim h (ground.adjSwap k cs) hsw h2)
  rw [ground.adjSwap_adjSwap k cs] at h4
  exact h4

private theorem indep_frontRec (n : Nat) : ∀ (k : Nat) (L : Mat),
    indepRows n L → indepRows n (frontRec k L)
  | 0, _, h => h
  | k + 1, L, h =>
    indep_frontRec n k (ground.adjSwap k L) (indep_swapAdj n k L h)

/-- Independence is kept when a stated member moves to the head,
the further members' order kept. -/
theorem indep_focus (n k : Nat) (L : Mat) (hk : k < L.length)
    (h : indepRows n L) :
    indepRows n (ground.getAt [] L k :: L.eraseIdx k) := by
  rw [← frontRec_shape ([] : List BPair) k L hk]
  exact indep_frontRec n k L h

/-- An independent list's rows sit off the unit tail: at a
unit-tail row the basis combination, the natural one at the row
with the unit family beside it, reads the unit tail, and the
independence reads the coefficients back at the unit — against
the natural one's own side. -/
theorem indep_row_off {n : Nat} {L : Mat} (h : indepRows n L) :
    ∀ k, k < L.length → ¬ poly.unitTail (ground.getAt [] L k) := by
  intro k hk ht
  have hf : indepRows n (ground.getAt [] L k :: L.eraseIdx k) :=
    indep_focus n k L hk h
  have hnull : poly.unitTail
      (combo n (BPair.ofNat 1
          :: List.replicate (L.eraseIdx k).length BPair.unit)
        (ground.getAt [] L k :: L.eraseIdx k)) := by
    show poly.unitTail (vecAdd
      (vecScale (BPair.ofNat 1) (ground.getAt [] L k))
      (combo n (List.replicate (L.eraseIdx k).length BPair.unit)
        (L.eraseIdx k)))
    exact unitTail_vecAdd_of
      (unitTail_vecScale (BPair.ofNat 1) _ ht)
      (combo_unitsT n (L.eraseIdx k) (L.eraseIdx k).length)
  have hcs := indep_elim hf
    (BPair.ofNat 1
      :: List.replicate (L.eraseIdx k).length BPair.unit)
    (by
      show (List.replicate (L.eraseIdx k).length BPair.unit).length
          + 1 = (L.eraseIdx k).length + 1
      rw [ground.length_replicate])
    hnull
  exact BPair.ofNat_one_off hcs.1

/-! The head column's split: the combination's first entry is the
coefficients' plain fold against the heads (`dotP`), the further
entries the tails' own combination. -/

private theorem combo_headSplit (n : Nat) : ∀ (cs : List BPair)
    (L : Mat), cs.length = L.length → rowsLen (n + 1) L →
      combo (n + 1) cs L
        = dotP cs (colHead BPair.unit L) :: combo n cs (dropCol L)
  | [], [], _, _ => rfl
  | [], _ :: _, hl, _ => nomatch hl
  | _ :: _, [], hl, _ => nomatch hl
  | _ :: _, [] :: _, _, hL => nomatch hL.1
  | c :: cs, (a :: r) :: L, hl, hL =>
    congrArg (fun z => vecAdd (c * a :: vecScale c r) z)
      (combo_headSplit n cs L (Nat.succ.inj hl) hL.2)

private theorem indep_tails (n : Nat) (L : Mat)
    (hL : rowsLen (n + 1) L)
    (hU : poly.unitTail (colHead BPair.unit L))
    (h : indepRows (n + 1) L) : indepRows n (dropCol L) := by
  refine indep_intro n (dropCol L) (rowsLen_dropCol n L hL) ?_
  intro cs hcl hnull
  have hcl' : cs.length = L.length := by
    rw [hcl, length_dropCol]
  refine indep_elim h cs hcl' ?_
  rw [combo_headSplit n cs L hcl' hL]
  exact ⟨dotP_null_tail_right cs (colHead BPair.unit L) hU, hnull⟩

/-! The head pivot's elimination: the further rows cleared at the
first column against the pivot row, the cleared family's tails an
independent family at the width below. -/

private def elimRows (P : List BPair) (P0 : BPair) (R : Mat) : Mat :=
  R.map (fun s => vecAdd (vecScale P0 s)
    (vecScale (BPair.swap (ground.getAt BPair.unit s 0)) P))

private def swapFold : List BPair → Mat → BPair
  | [], _ => BPair.unit
  | _ :: _, [] => BPair.unit
  | c :: cs, s :: R =>
    c * BPair.swap (ground.getAt BPair.unit s 0) + swapFold cs R

private theorem length_elimRows (P : List BPair) (P0 : BPair)
    (R : Mat) : (elimRows P P0 R).length = R.length :=
  ground.length_map _ R

private theorem rowsLen_elim (n : Nat) (P : List BPair) (P0 : BPair)
    (hP : P.length = n + 1) : ∀ R : Mat, rowsLen (n + 1) R →
      rowsLen (n + 1) (elimRows P P0 R)
  | [], _ => trivial
  | s :: R, hR =>
    ⟨length_vecAdd _ _ (n + 1)
      ((length_vecScale P0 s).trans hR.1)
      ((length_vecScale _ P).trans hP),
     rowsLen_elim n P P0 hP R hR.2⟩

private theorem colHead_elim_unit (P0 : BPair) (Pt : List BPair) :
    ∀ R : Mat,
      poly.unitTail (colHead BPair.unit (elimRows (P0 :: Pt) P0 R))
  | [] => trivial
  | [] :: R =>
    ⟨BPair.oneValue_refl BPair.unit, colHead_elim_unit P0 Pt R⟩
  | (a :: _) :: R => by
    refine ⟨?_, colHead_elim_unit P0 Pt R⟩
    show (P0 * a + BPair.swap a * P0).oneValue BPair.unit
    have h1 : (a + BPair.swap a).oneValue BPair.unit := by
      rw [BPair.add_comm]
      exact BPair.swap_add_null (BPair.oneValue_refl a)
    have h2 : P0 * a + BPair.swap a * P0 = P0 * (a + BPair.swap a) := by
      rw [BPair.mul_comm (BPair.swap a) P0, BPair.left_distrib]
    rw [h2]
    exact BPair.oneValue_trans
      (BPair.mul_congr (BPair.oneValue_refl P0) h1)
      (BPair.mul_unit P0)

private theorem combo_elim (n : Nat) (P : List BPair) (P0 : BPair)
    (hP : P.length = n + 1) : ∀ (cs : List BPair) (R : Mat),
      cs.length = R.length → rowsLen (n + 1) R →
      poly.oneValue (combo (n + 1) cs (elimRows P P0 R))
        (vecAdd (vecScale (swapFold cs R) P)
          (combo (n + 1) (vecScale P0 cs) R))
  | [], [], _, _ =>
    poly.unitTail_oneValue (poly.unitTail_replicate (n + 1))
      (unitTail_vecAdd_of
        (unitTail_vecScale_unit (BPair.oneValue_refl BPair.unit) P)
        (poly.unitTail_replicate (n + 1)))
  | [], _ :: _, hl, _ => nomatch hl
  | _ :: _, [], hl, _ => nomatch hl
  | c :: cs, s :: R, hl, hR => by
    have hYlen : (combo (n + 1) cs (elimRows P P0 R)).length = n + 1 :=
      length_combo (n + 1) cs (elimRows P P0 R)
        (rowsLen_elim n P P0 hP R hR.2)
    have hZlen : (vecAdd (vecScale (swapFold cs R) P)
        (combo (n + 1) (vecScale P0 cs) R)).length = n + 1 :=
      length_vecAdd _ _ (n + 1)
        ((length_vecScale (swapFold cs R) P).trans hP)
        (length_combo (n + 1) (vecScale P0 cs) R hR.2)
    show poly.oneValue
      (vecAdd (vecScale c (vecAdd (vecScale P0 s)
          (vecScale (BPair.swap (ground.getAt BPair.unit s 0)) P)))
        (combo (n + 1) cs (elimRows P P0 R)))
      (vecAdd (vecScale (c * BPair.swap
            (ground.getAt BPair.unit s 0) + swapFold cs R) P)
        (vecAdd (vecScale (P0 * c) s)
          (combo (n + 1) (vecScale P0 cs) R)))
    rw [vecScale_vecAdd c (vecScale P0 s)
        (vecScale (BPair.swap (ground.getAt BPair.unit s 0)) P),
      vecScale_vecScale c P0 s,
      vecScale_vecScale c (BPair.swap (ground.getAt BPair.unit s 0)) P,
      vecScale_add (c * BPair.swap (ground.getAt BPair.unit s 0))
        (swapFold cs R) P,
      BPair.mul_comm P0 c,
      vecAdd_add_comm
        (vecScale (c * BPair.swap (ground.getAt BPair.unit s 0)) P)
        (vecScale (swapFold cs R) P)
        (vecScale (c * P0) s)
        (combo (n + 1) (vecScale P0 cs) R),
      vecAdd_comm
        (vecScale (c * BPair.swap (ground.getAt BPair.unit s 0)) P)
        (vecScale (c * P0) s)]
    exact polyOne_vecAdd _ _ _ _ (polyOne_refl _)
      (combo_elim n P P0 hP cs R (Nat.succ.inj hl) hR.2) rfl
      (hYlen.trans hZlen.symm)

private theorem bound_step (n : Nat) (P0 : BPair) (Pt : List BPair)
    (R : Mat) (hPt : Pt.length = n) (hR : rowsLen (n + 1) R)
    (hP0 : ¬ P0.oneValue BPair.unit)
    (hfoc : indepRows (n + 1) ((P0 :: Pt) :: R))
    (ih : ∀ M : Mat, rowsLen n M → indepRows n M → M.length ≤ n) :
    R.length ≤ n := by
  have hP : (P0 :: Pt).length = n + 1 := congrArg Nat.succ hPt
  have hR' : rowsLen (n + 1) (elimRows (P0 :: Pt) P0 R) :=
    rowsLen_elim n (P0 :: Pt) P0 hP R hR
  have hind : indepRows (n + 1) (elimRows (P0 :: Pt) P0 R) := by
    refine indep_intro (n + 1) (elimRows (P0 :: Pt) P0 R) hR' ?_
    intro cs hcl hnull
    have hcl2 : cs.length = R.length :=
      hcl.trans (length_elimRows (P0 :: Pt) P0 R)
    have h1 : poly.unitTail
        (combo (n + 1) (swapFold cs R :: vecScale P0 cs)
          ((P0 :: Pt) :: R)) :=
      poly.unitTail_oneValue_right hnull
        (combo_elim n (P0 :: Pt) P0 hP cs R hcl2 hR)
    have h2 := indep_elim hfoc (swapFold cs R :: vecScale P0 cs)
      (congrArg Nat.succ ((length_vecScale P0 cs).trans hcl2)) h1
    exact unitTail_unscale P0 hP0 cs h2.2
  have h3 := ih (dropCol (elimRows (P0 :: Pt) P0 R))
    (rowsLen_dropCol n _ hR')
    (indep_tails n _ hR' (colHead_elim_unit P0 Pt R) hind)
  rw [length_dropCol, length_elimRows] at h3
  exact h3

private theorem unitTail_of_len_zero : ∀ u : List BPair,
    u.length = 0 → poly.unitTail u
  | [], _ => trivial
  | _ :: _, hl => nomatch hl

private theorem bound_zero : ∀ L : Mat, rowsLen 0 L →
    indepRows 0 L → L.length ≤ 0
  | [], _, _ => Nat.le_refl 0
  | r :: t, hL, h =>
    absurd
      (indep_elim h
        (BPair.ofNat 1 :: List.replicate t.length BPair.unit)
        (congrArg Nat.succ
          (ground.length_replicate BPair.unit t.length))
        (unitTail_of_len_zero _
          (length_combo 0 _ (r :: t) hL))).1
      BPair.ofNat_one_off

private theorem bound_succ (n : Nat)
    (ih : ∀ M : Mat, rowsLen n M → indepRows n M → M.length ≤ n) :
    ∀ L : Mat, rowsLen (n + 1) L → indepRows (n + 1) L →
      L.length ≤ n + 1 := by
  intro L hL h
  by_cases hU : poly.unitTail (colHead BPair.unit L)
  · have h3 := ih (dropCol L) (rowsLen_dropCol n L hL)
      (indep_tails n L hL hU h)
    rw [length_dropCol] at h3
    exact Nat.le_trans h3 (Nat.le_succ n)
  · match poly.offUnit_witness (colHead BPair.unit L) hU with
    | ⟨k, hk, hks⟩ =>
      have hk' : k < L.length := by
        rw [← length_colHead BPair.unit L]
        exact hk
      have hfin : ∀ P : List BPair, P.length = n + 1 →
          ¬ (ground.getAt BPair.unit P 0).oneValue BPair.unit →
          indepRows (n + 1) (P :: L.eraseIdx k) →
          (L.eraseIdx k).length ≤ n := by
        intro P hPl
        match P, hPl with
        | [], hp => exact nomatch hp
        | P0 :: Pt, hp =>
          intro hh hf
          exact bound_step n P0 Pt (L.eraseIdx k) (Nat.succ.inj hp)
            (rowsLen_eraseIdx (n + 1) L k hL) hh hf ih
      have hle := hfin (ground.getAt [] L k)
        (rowsLen_getAt L k hL hk')
        (by
          rw [show ground.getAt BPair.unit (ground.getAt [] L k) 0
              = ground.getAt BPair.unit (colHead BPair.unit L) k from
            (getAt_colHead BPair.unit L k hk').symm]
          exact hks)
        (indep_focus (n + 1) k L hk' h)
      rw [← length_eraseIdx L k hk']
      exact Nat.succ_le_succ hle

/-- An independent family's length sits at or below its width:
the first coordinate clears by the head pivot, the descent on the
width. -/
theorem indep_bound (n : Nat) : ∀ L : Mat, rowsLen n L →
    indepRows n L → L.length ≤ n := by
  induction n with
  | zero => exact bound_zero
  | succ n ih => exact bound_succ n ih

/-! The collection's certification (`lem:lowerspan`'s read: the
count at the read, one member joined per refusal): the collected
list is independent at every step, spans
every row of the source, and sits inside the source's own span —
the decidable read's bridge to the characterization, the residual
the only test anywhere. -/

/-- A family read at every index, joined by one further read,
reads at every index of the join. -/
private theorem rows_append_gen {P : List BPair → Prop} (A : Mat)
    (v : List BPair)
    (hA : ∀ p, p < A.length → P (ground.getAt [] A p))
    (hv : P v) :
    ∀ p, p < (A ++ [v]).length →
      P (ground.getAt [] (A ++ [v]) p) :=
  ground.getAt_append_all ([] : List BPair) P A [v] hA
    (fun k hk =>
      match k, hk with
      | 0, _ => hv
      | q' + 1, h2 =>
        absurd (Nat.le_of_succ_le_succ h2)
          (Nat.not_succ_le_zero q'))

/-- The collection's step: the refused row joins, the passing row
is dropped. -/
private def joinStep (n : Nat) (B : Mat) (r : List BPair) : Mat :=
  if poly.unitTail (residV n B r) then B else B ++ [r]

private theorem joinStep_pass (n : Nat) (B : Mat) (r : List BPair)
    (h : poly.unitTail (residV n B r)) : joinStep n B r = B := by
  show (if poly.unitTail (residV n B r) then B else B ++ [r]) = B
  rw [if_pos h]

private theorem joinStep_join (n : Nat) (B : Mat) (r : List BPair)
    (h : ¬ poly.unitTail (residV n B r)) :
    joinStep n B r = B ++ [r] := by
  show (if poly.unitTail (residV n B r) then B else B ++ [r])
    = B ++ [r]
  rw [if_neg h]

private theorem joinStep_rows (n : Nat) (B : Mat) (r : List BPair)
    (hB : rowsLen n B) (hr : r.length = n) :
    rowsLen n (joinStep n B r) := by
  by_cases ht : poly.unitTail (residV n B r)
  · rw [joinStep_pass n B r ht]; exact hB
  · rw [joinStep_join n B r ht]
    exact rowsLen_append n hB ⟨hr, trivial⟩

/-- The step keeps independence: a refusal is a non-membership at
the characterization, `resid_completeE`'s contrapositive, and the
refused row extends the family. -/
private theorem joinStep_indep (n : Nat) (B : Mat) (r : List BPair)
    (hB : indepRows n B) (hr : r.length = n) :
    indepRows n (joinStep n B r) := by
  by_cases ht : poly.unitTail (residV n B r)
  · rw [joinStep_pass n B r ht]; exact hB
  · rw [joinStep_join n B r ht]
    exact indep_extendE n B r hB.1 hr hB
      (fun hE => ht (resid_completeE n B r hB.1 hr hE))

private theorem collect_rowsLen_go (n : Nat) :
    ∀ (R B : Mat), rowsLen n R → rowsLen n B →
      rowsLen n (R.foldl (joinStep n) B)
  | [], _, _, hB => hB
  | r :: R, B, hR, hB =>
    collect_rowsLen_go n R (joinStep n B r) hR.2
      (joinStep_rows n B r hB hR.1)

/-- The collection only grows, so a member of the accumulator's
span stays a member of the collected list's. -/
private theorem collect_grow_go (n : Nat) :
    ∀ (R B : Mat) (x : List BPair), rowsLen n R → rowsLen n B →
      spanRelE n B x → spanRelE n (R.foldl (joinStep n) B) x
  | [], _, _, _, _, h => h
  | r :: R, B, x, hR, hB, h => by
    refine collect_grow_go n R (joinStep n B r) x hR.2
      (joinStep_rows n B r hB hR.1) ?_
    by_cases ht : poly.unitTail (residV n B r)
    · rw [joinStep_pass n B r ht]; exact h
    · rw [joinStep_join n B r ht]
      exact spanE_mono n B [r] x hB ⟨hR.1, trivial⟩ h

private theorem collect_indep_go (n : Nat) :
    ∀ (R B : Mat), rowsLen n R → indepRows n B →
      indepRows n (R.foldl (joinStep n) B)
  | [], _, _, hB => hB
  | r :: R, B, hR, hB =>
    collect_indep_go n R (joinStep n B r) hR.2
      (joinStep_indep n B r hB hR.1)

/-- Two lists at one value join at the unit family across the
memberwise swap, the swap the subtraction's read. -/
theorem null_swap_add : ∀ a b : List BPair,
    poly.oneValue a b →
    poly.unitTail (vecAdd (a.map BPair.swap) b)
  | [], _, _ => trivial
  | _ :: _, [], _ => trivial
  | _ :: a, _ :: b, h =>
    ⟨ground.BPair.swap_add_null h.1, null_swap_add a b h.2⟩

/-- Every leading part of an independent list is independent, the
withdrawn tail's coefficients read at the unit family one row at a
time. -/
private theorem indep_ofPrefix (n : Nat) : ∀ (R B : Mat),
    rowsLen n B → rowsLen n R → indepRows n (B ++ R) → indepRows n B
  | [], B, _, _, h => by
    rw [ground.append_nil B] at h
    exact h
  | r :: R, B, hB, hR, h => by
    have hBr : indepRows n (B ++ [r]) := by
      refine indep_ofPrefix n R (B ++ [r])
        (rowsLen_append n hB ⟨hR.1, trivial⟩) hR.2 ?_
      rw [ground.append_assoc B [r] R]
      exact h
    exact indep_intro n B hB
      (indep_dropLast n B r hB hR.1 (indep_elim hBr))

/-- The fold invariant: at an independent join every processed row
refuses its residual and the collection keeps the list whole. -/
private theorem collect_keep_go (n : Nat) : ∀ (R B : Mat),
    rowsLen n B → rowsLen n R → indepRows n (B ++ R) →
      R.foldl (joinStep n) B = B ++ R
  | [], B, _, _, _ => (ground.append_nil B).symm
  | r :: R, B, hB, hR, h => by
    have hBrR : indepRows n ((B ++ [r]) ++ R) := by
      rw [ground.append_assoc B [r] R]
      exact h
    have hBrows : rowsLen n (B ++ [r]) :=
      rowsLen_append n hB ⟨hR.1, trivial⟩
    have hBr : indepRows n (B ++ [r]) :=
      indep_ofPrefix n R (B ++ [r]) hBrows hR.2 hBrR
    have hBind : indepRows n B :=
      indep_ofPrefix n [r] B hB ⟨hR.1, trivial⟩ hBr
    have hstep : ¬ poly.unitTail (residV n B r) := by
      intro ht
      obtain ⟨c₀, cs, hc₀, hcsl, hone⟩ :=
        resid_soundE n B r hB hR.1 (indep_det n B hBind) ht
      have hnull : poly.unitTail
          (combo n (cs.map BPair.swap ++ [c₀]) (B ++ [r])) := by
        refine poly.oneValue_unitTail
          (combo_append_one n (cs.map BPair.swap) c₀ B r
            (by rw [ground.length_map]; exact hcsl) hB hR.1) ?_
        rw [combo_swapMap n cs B]
        exact null_swap_add (combo n cs B) (vecScale c₀ r)
          (poly.oneValue_symm hone)
      have hcs := indep_elim hBr (cs.map BPair.swap ++ [c₀])
        (by rw [ground.length_append, ground.length_append, ground.length_map,
          hcsl]; rfl) hnull
      exact hc₀ ((unitTail_append_split _ _ hcs).2).1
    show R.foldl (joinStep n) (joinStep n B r) = B ++ r :: R
    rw [joinStep_join n B r hstep,
      collect_keep_go n R (B ++ [r]) hBrows hR.2 hBrR,
      ground.append_assoc B [r] R]
    rfl

/-- An independent list is its own collection: at every processed
leading part the next row's residual refuses, a passing residual
putting that row inside the part's span against the extended part's
independence (`lem:lowerspan`'s joined-collection read). -/
theorem collect_keep (n : Nat) (L : Mat) (hind : indepRows n L) :
    collectOf n L = L :=
  collect_keep_go n L [] trivial hind.1 hind

/-- Every processed row sits in the collection's span: the passing
row by the residual's soundness at the accumulator's own
determinant, the refused row as a listed member of the join. -/
private theorem collect_spans_go (n : Nat) :
    ∀ (R B : Mat), rowsLen n R → indepRows n B →
      ∀ k, k < R.length →
        spanRelE n (R.foldl (joinStep n) B) (ground.getAt [] R k)
  | [], _, _, _, k, hk => absurd hk (Nat.not_lt_zero k)
  | r :: R, B, hR, hB, 0, _ => by
    show spanRelE n (R.foldl (joinStep n) (joinStep n B r)) r
    by_cases ht : poly.unitTail (residV n B r)
    · rw [joinStep_pass n B r ht]
      exact collect_grow_go n R B r hR.2 hB.1
        (resid_soundE n B r hB.1 hR.1 (indep_det n B hB) ht)
    · rw [joinStep_join n B r ht]
      have hBr : rowsLen n (B ++ [r]) :=
        rowsLen_append n hB.1 ⟨hR.1, trivial⟩
      refine collect_grow_go n R (B ++ [r]) r hR.2 hBr ?_
      have hlt : B.length < (B ++ [r]).length := by
        rw [ground.length_append]
        exact Nat.lt_succ_of_le (Nat.le_refl B.length)
      have hmem := spanE_getAt n (B ++ [r]) B.length hlt hBr
      rw [show ground.getAt ([] : List BPair) (B ++ [r]) B.length = r
        from ground.getAt_append_add ([] : List BPair) B [r] 0]
        at hmem
      exact hmem
  | r :: R, B, hR, hB, k + 1, hk =>
    collect_spans_go n R (joinStep n B r) hR.2
      (joinStep_indep n B r hB hR.1) k (Nat.lt_of_succ_lt_succ hk)

/-- The collected rows are the source's own rows, so each sits in
the source's span. -/
private theorem collect_sub_go (n : Nat) (L : Mat) :
    ∀ (R B : Mat),
      (∀ k, k < B.length → spanRelE n L (ground.getAt [] B k)) →
      (∀ j, j < R.length → spanRelE n L (ground.getAt [] R j)) →
      ∀ k, k < (R.foldl (joinStep n) B).length →
        spanRelE n L (ground.getAt [] (R.foldl (joinStep n) B) k)
  | [], _, hB, _ => hB
  | r :: R, B, hB, hR => by
    have hstep : ∀ k, k < (joinStep n B r).length →
        spanRelE n L (ground.getAt [] (joinStep n B r) k) := by
      by_cases ht : poly.unitTail (residV n B r)
      · rw [joinStep_pass n B r ht]; exact hB
      · rw [joinStep_join n B r ht]
        exact rows_append_gen B r hB (hR 0 (Nat.succ_pos _))
    exact collect_sub_go n L R (joinStep n B r) hstep
      (fun j hj => hR (j + 1) (Nat.succ_lt_succ hj))

/-- The collected list reads the family's own width. -/
theorem collect_rowsLen (n : Nat) (L : Mat)
    (hL : rowsLen n L) : rowsLen n (collectOf n L) :=
  collect_rowsLen_go n L [] hL trivial

/-- The collected list is independent, one member joined per
refusal. -/
theorem collect_indep (n : Nat) (L : Mat)
    (hL : rowsLen n L) : indepRows n (collectOf n L) :=
  collect_indep_go n L [] hL (indep_nil n)

/-- The collection spans every row of the source. -/
private theorem collect_spans (n : Nat) (L : Mat)
    (hL : rowsLen n L) :
    ∀ k, k < L.length →
      spanRelE n (collectOf n L) (ground.getAt [] L k) :=
  collect_spans_go n L [] hL (indep_nil n)

/-- The collection sits inside the source's span. -/
private theorem collect_sub (n : Nat) (L : Mat)
    (hL : rowsLen n L) :
    ∀ k, k < (collectOf n L).length →
      spanRelE n L (ground.getAt [] (collectOf n L) k) :=
  collect_sub_go n L L [] (fun k hk => absurd hk (Nat.not_lt_zero k))
    (fun j hj => spanE_getAt n L j hj hL)

/-- The read's introduction: a characterized member at the stated
shapes passes the collected list's residual test, the collection
spanning every row. -/
theorem span_intro (n : Nat) (L : Mat) (v : List BPair)
    (hLn : rowsLen n L) (hv : v.length = n)
    (h : ∃ c₀ cs, (¬ c₀.oneValue BPair.unit) ∧ cs.length = L.length
      ∧ poly.oneValue (vecScale c₀ v) (combo n cs L)) :
    spanRel n L v :=
  ⟨hLn, hv,
    resid_completeE n (collectOf n L) v (collect_rowsLen n L hLn) hv
      (spanE_trans n L (collectOf n L) v hLn
        (collect_rowsLen n L hLn) (collect_spans n L hLn) h)⟩

/-- Every listed member sits inside the collection's span, the
joined-collection read (`lem:lowerspan`). -/
theorem collect_span_row (n : Nat) (L : Mat)
    (hL : rowsLen n L) :
    ∀ k, k < L.length →
      spanRel n (collectOf n L) (ground.getAt [] L k) :=
  fun k hk =>
    span_intro n (collectOf n L) _ (collect_rowsLen n L hL)
      (rowsLen_getAt L k hL hk) (collect_spans n L hL k hk)

/-- The collection's members sit inside the listed span, the
joined-collection read's converse half (`lem:lowerspan`). -/
theorem collect_row_span (n : Nat) (L : Mat)
    (hL : rowsLen n L) :
    ∀ k, k < (collectOf n L).length →
      spanRel n L (ground.getAt [] (collectOf n L) k) :=
  fun k hk =>
    span_intro n L _ hL
      (rowsLen_getAt (collectOf n L) k (collect_rowsLen n L hL) hk)
      (collect_sub n L hL k hk)

/-- The read's elimination: the passing read at the collected list
is a span witness over the source, the collected rows inside the
source's own span. -/
theorem span_elim {n : Nat} {L : Mat} {v : List BPair}
    (h : spanRel n L v) :
    ∃ c₀ cs, (¬ c₀.oneValue BPair.unit) ∧ cs.length = L.length
      ∧ poly.oneValue (vecScale c₀ v) (combo n cs L) :=
  spanE_trans n (collectOf n L) L v (collect_rowsLen n L h.1) h.1
    (collect_sub n L h.1)
    (resid_soundE n (collectOf n L) v (collect_rowsLen n L h.1)
      h.2.1
      (indep_det n (collectOf n L) (collect_indep n L h.1))
      h.2.2)

/-! The public span tier at the read: every statement the
characterization carried, now stated at the decidable membership
and closed through the bridge. -/

/-- The test's soundness: a passing residual at an off-unit
determinant is a span witness, the determinant the clearing
scalar. -/
theorem resid_sound (n : Nat) (L : Mat) (v : List BPair)
    (hLn : rowsLen n L) (hv : v.length = n)
    (hdet : ¬ (detL (gramM L)).oneValue BPair.unit)
    (h : poly.unitTail (residV n L v)) : spanRel n L v :=
  span_intro n L v hLn hv (resid_soundE n L v hLn hv hdet h)

/-- The test's completeness: a span member's residual passes, the
perpendicular residual inside the span reading the sum's unit at
the pairing's definiteness. -/
theorem resid_complete (n : Nat) (L : Mat) (v : List BPair)
    (hLn : rowsLen n L) (hv : v.length = n)
    (hsp : spanRel n L v) : poly.unitTail (residV n L v) :=
  resid_completeE n L v hLn hv (span_elim hsp)

/-- A span member is kept under the grown list, the combination
padded by the sum's unit at the joined rows. -/
theorem spanRel_mono (n : Nat) (L M : Mat) (v : List BPair)
    (hL : rowsLen n L) (hM : rowsLen n M)
    (h : spanRel n L v) : spanRel n (L ++ M) v :=
  span_intro n (L ++ M) v (rowsLen_append n hL hM) h.2.1
    (spanE_mono n L M v hL hM (span_elim h))

/-- A listed row sits in its list's span, the one-member
combination at the natural one's clearing. -/
theorem spanRel_getAt (n : Nat) :
    ∀ (L : Mat) (k : Nat), k < L.length → rowsLen n L →
      spanRel n L (ground.getAt [] L k) :=
  fun L k hk hL =>
    span_intro n L _ hL (rowsLen_getAt L k hL hk)
      (spanE_getAt n L k hk hL)

/-- A vector at the unit tail sits in every span at the stated
shapes, the unit combination's read. -/
theorem spanRel_null (n : Nat) (L : Mat) (v : List BPair)
    (hu : poly.unitTail v) (hLn : rowsLen n L) (hv : v.length = n) :
    spanRel n L v :=
  span_intro n L v hLn hv (spanE_null n L v hu)

/-- The span keeps combinations: two members' join sits in the
span, the clearings multiplied. -/
theorem spanRel_add (n : Nat) (L : Mat) (u w : List BPair)
    (hLn : rowsLen n L) (hu : u.length = n) (hw : w.length = n)
    (h1 : spanRel n L u) (h2 : spanRel n L w) :
    spanRel n L (vecAdd u w) :=
  span_intro n L _ hLn (length_vecAdd u w n hu hw)
    (spanE_add n L u w hLn hu hw (span_elim h1) (span_elim h2))

/-- The span keeps a scaled member, the clearing kept. -/
theorem spanRel_scale (n : Nat) (L : Mat) (v : List BPair)
    (c : BPair) (hLn : rowsLen n L) (hv : v.length = n)
    (h : spanRel n L v) : spanRel n L (vecScale c v) :=
  span_intro n L _ hLn ((length_vecScale c v).trans hv)
    (spanE_scale n L v c (span_elim h))

/-- The span reads one value: a member's span read passes to every
vector reading it at the stated width, the clearing scaled
through. -/
theorem spanRel_congr (n : Nat) (L : Mat) (u u' : List BPair)
    (h : poly.oneValue u u') (hs : spanRel n L u)
    (hu' : u'.length = n) :
    spanRel n L u' :=
  span_intro n L u' hs.1 hu'
    (spanE_congr n L u u' h (span_elim hs))

/-- A combination of rows each inside a span sits in the span, the
fold of the linearity reads. -/
theorem spanRel_combo (n : Nat) (M : Mat) (hM : rowsLen n M) :
    ∀ (K : Mat) (cs : List BPair), rowsLen n K →
      (∀ k, k < K.length → spanRel n M (ground.getAt [] K k)) →
      spanRel n M (combo n cs K) :=
  fun K cs hK h =>
    span_intro n M _ hM (length_combo n cs K hK)
      (spanE_combo n M hM K cs hK (fun k hk => span_elim (h k hk)))

/-- A scaled member's span read descends to the member, the
clearings multiplied. -/
theorem spanRel_unscale (n : Nat) (M : Mat) (c : BPair)
    (v : List BPair) (hc : ¬ c.oneValue BPair.unit)
    (h : spanRel n M (vecScale c v)) : spanRel n M v :=
  span_intro n M v h.1 ((length_vecScale c v).symm.trans h.2.1)
    (spanE_unscale n M c v hc (span_elim h))

/-- An accepted vector extends the independent family: a
dependency with the new coefficient off the sum's unit is a span
witness, and one with it there falls back to the family's own. -/
theorem indep_extend (n : Nat) (L : Mat) (v : List BPair)
    (hLn : rowsLen n L) (hv : v.length = n)
    (hind : indepRows n L) (hns : ¬ spanRel n L v) :
    indepRows n (L ++ [v]) :=
  indep_extendE n L v hLn hv hind
    (fun hE => hns (span_intro n L v hLn hv hE))

/-- A full-length independent list spans (`lem:lowerspan`'s own
sentence): a vector off the list's span joins it at the
membership's refusal, the joined list independent one past the
count, against the width bound. -/
theorem span_of_full (n : Nat) (L : Mat) (v : List BPair)
    (hL : L.length = n) (hind : indepRows n L)
    (hv : v.length = n) : spanRel n L v :=
  match (inferInstance : Decidable (spanRel n L v)) with
  | isTrue h => h
  | isFalse hns =>
    absurd
      (indep_bound n (L ++ [v]) (rowsLen_append n hind.1 ⟨hv, trivial⟩)
        (indep_extend n L v hind.1 hv hind hns))
      (fun hb => Nat.lt_irrefl n
        (by rw [ground.length_append, hL] at hb; exact hb))

/-! The exchange read (`lem:lowerspan`'s two-list clause): each
member of an independent list solved in a second list's span reads
a coefficient row over the second list, the rows independent at
the second list's count, and the width bound closes the count
comparison. -/

/-- The coordinatization: per member of the first list a clearing
scalar off the sum's unit and a coefficient row over the second,
the scaled member reading the row's combination. -/
private def coordRel (n : Nat) (B : Mat) : Mat → List BPair → Mat → Prop
  | [], [], [] => True
  | [], [], _ :: _ => False
  | [], _ :: _, _ => False
  | _ :: _, [], _ => False
  | _ :: _, _ :: _, [] => False
  | a :: A, c :: cs, r :: C =>
    (¬ c.oneValue BPair.unit) ∧ r.length = B.length
      ∧ poly.oneValue (vecScale c a) (combo n r B)
      ∧ coordRel n B A cs C

private theorem coord_exists (n : Nat) (B : Mat) : ∀ A : Mat,
    (∀ k, k < A.length → spanRel n B (ground.getAt [] A k)) →
    ∃ cs C, coordRel n B A cs C
  | [], _ => ⟨[], [], trivial⟩
  | _ :: A, h => by
    match span_elim (h 0 (Nat.succ_pos _)) with
    | ⟨c₀, r, hc₀, hrl, hone⟩ =>
      match coord_exists n B A
          (fun k hk => h (k + 1) (Nat.succ_lt_succ hk)) with
      | ⟨cs, C, hco⟩ =>
        refine ⟨c₀ :: cs, r :: C, ?_⟩
        exact ⟨hc₀, hrl, hone, hco⟩

private theorem coordRel_lenC (n : Nat) (B : Mat) :
    ∀ (A : Mat) (cs : List BPair) (C : Mat),
      coordRel n B A cs C → C.length = A.length
  | [], [], [], _ => rfl
  | [], [], _ :: _, h => False.elim h
  | [], _ :: _, _, h => False.elim h
  | _ :: _, [], _, h => False.elim h
  | _ :: _, _ :: _, [], h => False.elim h
  | _ :: A, _ :: cs, _ :: C, h =>
    congrArg Nat.succ (coordRel_lenC n B A cs C h.2.2.2)

private theorem coordRel_lencs (n : Nat) (B : Mat) :
    ∀ (A : Mat) (cs : List BPair) (C : Mat),
      coordRel n B A cs C → cs.length = A.length
  | [], [], [], _ => rfl
  | [], [], _ :: _, h => False.elim h
  | [], _ :: _, _, h => False.elim h
  | _ :: _, [], _, h => False.elim h
  | _ :: _, _ :: _, [], h => False.elim h
  | _ :: A, _ :: cs, _ :: C, h =>
    congrArg Nat.succ (coordRel_lencs n B A cs C h.2.2.2)

private theorem coordRel_rows (n : Nat) (B : Mat) :
    ∀ (A : Mat) (cs : List BPair) (C : Mat),
      coordRel n B A cs C → rowsLen B.length C
  | [], [], [], _ => trivial
  | [], [], _ :: _, h => False.elim h
  | [], _ :: _, _, h => False.elim h
  | _ :: _, [], _, h => False.elim h
  | _ :: _, _ :: _, [], h => False.elim h
  | _ :: A, _ :: cs, _ :: C, h =>
    ⟨h.2.1, coordRel_rows n B A cs C h.2.2.2⟩

/-- A unit-tail coefficient family combines to a unit tail, at
every list of rows. -/
theorem unitTail_combo_of (n : Nat) :
    ∀ (cs : List BPair) (L : Mat), poly.unitTail cs →
      poly.unitTail (combo n cs L)
  | [], _, _ => poly.unitTail_replicate n
  | _ :: _, [], _ => poly.unitTail_replicate n
  | _ :: cs, r :: L, h =>
    unitTail_vecAdd_of (unitTail_vecScale_unit h.1 r)
      (unitTail_combo_of n cs L h.2)

/-- A unit-tailed list of rows combines to a unit tail, at every
coefficient family — the coefficient read's companion at the other
argument. -/
theorem unitTail_combo_rows (n : Nat) :
    ∀ (cs : List BPair) (L : Mat),
      (∀ k, k < L.length →
        poly.unitTail (ground.getAt ([] : List BPair) L k)) →
      poly.unitTail (combo n cs L)
  | [], _, _ => poly.unitTail_replicate n
  | _ :: _, [], _ => poly.unitTail_replicate n
  | c :: cs, r :: L, h =>
    unitTail_vecAdd_of
      (unitTail_vecScale c r (h 0 (Nat.succ_pos L.length)))
      (unitTail_combo_rows n cs L
        (fun k hk => h (k + 1) (Nat.succ_lt_succ hk)))

/-- The collection at unit-tailed rows is vacant: each residual at
the vacant accumulator is the unit-scaled row, refusing no one. -/
theorem collect_nil_of_units (n : Nat) :
    ∀ L : Mat, (∀ k, k < L.length →
        poly.unitTail (ground.getAt [] L k)) →
      collectOf n L = []
  | [], _ => rfl
  | r :: t, h => by
    have hres : poly.unitTail (residV n [] r) :=
      unitTail_vecAdd_of
        (unitTail_vecScale (detL (gramM ([] : Mat))) r
          (h 0 (Nat.succ_pos t.length)))
        (poly.unitTail_swapMap _ (poly.unitTail_replicate n))
    show (r :: t).foldl
        (fun B s =>
          if poly.unitTail (residV n B s) then B else B ++ [s]) [] = []
    rw [show (r :: t).foldl
          (fun B s =>
            if poly.unitTail (residV n B s) then B else B ++ [s]) []
        = t.foldl
            (fun B s =>
              if poly.unitTail (residV n B s) then B else B ++ [s])
            (if poly.unitTail (residV n [] r) then [] else [] ++ [r])
        from rfl,
      if_pos hres]
    exact collect_nil_of_units n t
      (fun k hk => h (k + 1) (Nat.succ_lt_succ hk))

/-- A member of a unit-rowed list's span reads the unit tail,
`spanRel_nil_unit` at the occupied carrier. -/
theorem spanRel_unit_of_units (n : Nat) (L : Mat) (v : List BPair)
    (hrows : ∀ k, k < L.length →
        poly.unitTail (ground.getAt [] L k))
    (h : spanRel n L v) : poly.unitTail v := by
  obtain ⟨c₀, cs, hc₀, _, hone⟩ := span_elim h
  exact unitTail_unscale c₀ hc₀ v
    (poly.oneValue_unitTail hone (unitTail_combo_rows n cs L hrows))

/-- The Fubini read: a combination of the coefficient rows against
the second list reads the memberwise-scaled combination of the
first, the clearings multiplied into the coefficients. -/
private theorem combo_coord (n : Nat) (B : Mat) (hB : rowsLen n B) :
    ∀ (A : Mat) (cs : List BPair) (C : Mat) (ds : List BPair),
      rowsLen n A → coordRel n B A cs C → ds.length = A.length →
      poly.oneValue (combo n (combo B.length ds C) B)
        (combo n (List.zipWith (fun c d => c * d) cs ds) A)
  | [], [], [], [], _, _, _ =>
    poly.unitTail_oneValue (combo_unitsT n B B.length)
      (poly.unitTail_replicate n)
  | [], [], [], _ :: _, _, _, hdl => nomatch hdl
  | [], [], _ :: _, _, _, hco, _ => False.elim hco
  | [], _ :: _, _, _, _, hco, _ => False.elim hco
  | _ :: _, [], _, _, _, hco, _ => False.elim hco
  | _ :: _, _ :: _, [], _, _, hco, _ => False.elim hco
  | _ :: _, _ :: _, _ :: _, [], _, _, hdl => nomatch hdl
  | a :: A, c :: cs, r :: C, d :: ds, hA, hco, hdl => by
    have hr : r.length = B.length := hco.2.1
    have hone : poly.oneValue (vecScale c a) (combo n r B) := hco.2.2.1
    have hrest : coordRel n B A cs C := hco.2.2.2
    have hAn : a.length = n := hA.1
    have hK : (combo B.length ds C).length = B.length :=
      length_combo B.length ds C (coordRel_rows n B A cs C hrest)
    have hSr : (vecScale d r).length = B.length :=
      (length_vecScale d r).trans hr
    have hcrB : (combo n r B).length = n := length_combo n r B hB
    have hleft1 : poly.oneValue (combo n (vecScale d r) B)
        (vecScale d (combo n r B)) :=
      poly.oneValue_symm (vecScale_combo d n r B)
    have hleft2 : poly.oneValue (vecScale d (combo n r B))
        (vecScale d (vecScale c a)) :=
      vecScale_oneValue d (combo n r B) (vecScale c a)
        (poly.oneValue_symm hone)
    have hsc : vecScale d (vecScale c a) = vecScale (c * d) a := by
      rw [vecScale_vecScale d c a, BPair.mul_comm d c]
    have hleft : poly.oneValue (combo n (vecScale d r) B)
        (vecScale (c * d) a) := by
      rw [← hsc]
      exact poly.oneValue_trans hleft1 hleft2
    have hright : poly.oneValue (combo n (combo B.length ds C) B)
        (combo n (List.zipWith (fun c d => c * d) cs ds) A) :=
      combo_coord n B hB A cs C ds hA.2 hrest (Nat.succ.inj hdl)
    show poly.oneValue
      (combo n (vecAdd (vecScale d r) (combo B.length ds C)) B)
      (vecAdd (vecScale (c * d) a)
        (combo n (List.zipWith (fun c d => c * d) cs ds) A))
    refine poly.oneValue_trans
      (combo_vecAdd n (vecScale d r) (combo B.length ds C) B
        (hSr.trans hK.symm)) ?_
    exact polyOne_vecAdd _ _ _ _ hleft hright
      ((length_combo n (vecScale d r) B hB).trans
        ((length_vecScale (c * d) a).trans hAn).symm)
      ((length_combo n (combo B.length ds C) B hB).trans
        (length_combo n (List.zipWith (fun c d => c * d) cs ds)
          A hA.2).symm)

private theorem coordRel_zip_cancel (n : Nat) (B : Mat) :
    ∀ (A : Mat) (cs : List BPair) (C : Mat) (ds : List BPair),
      coordRel n B A cs C → ds.length = A.length →
      poly.unitTail (List.zipWith (fun c d => c * d) cs ds) →
      poly.unitTail ds
  | [], [], [], [], _, _, _ => trivial
  | [], [], [], _ :: _, _, hdl, _ => nomatch hdl
  | [], [], _ :: _, _, hco, _, _ => False.elim hco
  | [], _ :: _, _, _, hco, _, _ => False.elim hco
  | _ :: _, [], _, _, hco, _, _ => False.elim hco
  | _ :: _, _ :: _, [], _, hco, _, _ => False.elim hco
  | _ :: _, _ :: _, _ :: _, [], _, hdl, _ => nomatch hdl
  | _ :: A, _ :: cs, _ :: C, _ :: ds, hco, hdl, h =>
    ⟨mul_cancel_unit hco.1 h.1,
      coordRel_zip_cancel n B A cs C ds hco.2.2.2
        (Nat.succ.inj hdl) h.2⟩

/-- An independent list with every member in a second list's span
counts at or below the second's: the members' span witnesses read
coefficient rows over the second list, independent at its count
(`lem:lowerspan`'s exchange clause), and the width bound closes
the comparison. -/
theorem span_count_le (n : Nat) (A B : Mat) (hA : rowsLen n A)
    (hB : rowsLen n B) (hiA : indepRows n A)
    (hmem : ∀ k, k < A.length → spanRel n B (ground.getAt [] A k)) :
    A.length ≤ B.length := by
  match coord_exists n B A hmem with
  | ⟨cs, C, hco⟩ =>
    have hCA : C.length = A.length := coordRel_lenC n B A cs C hco
    have hcsA : cs.length = A.length := coordRel_lencs n B A cs C hco
    have hCrows : rowsLen B.length C := coordRel_rows n B A cs C hco
    have hCind : indepRows B.length C := by
      refine indep_intro B.length C hCrows ?_
      intro ds hdl hnull
      have hdA : ds.length = A.length := hdl.trans hCA
      have h1 : poly.unitTail (combo n (combo B.length ds C) B) :=
        unitTail_combo_of n (combo B.length ds C) B hnull
      have h2 : poly.unitTail
          (combo n (List.zipWith (fun c d => c * d) cs ds) A) :=
        poly.unitTail_oneValue_right h1
          (combo_coord n B hB A cs C ds hA hco hdA)
      have h3 := indep_elim hiA (List.zipWith (fun c d => c * d) cs ds)
        (length_zipWith (fun c d => c * d) cs ds A.length hcsA hdA)
        h2
      exact coordRel_zip_cancel n B A cs C ds hco hdA h3
    have h4 := indep_bound B.length C hCrows hCind
    rw [← hCA]
    exact h4

/-- Two independent lists inside one span read one count, either
count at or below the other (`lem:lowerspan`'s exchange clause). -/
theorem span_count_eq (n : Nat) (A B : Mat) (hA : rowsLen n A)
    (hB : rowsLen n B) (hiA : indepRows n A) (hiB : indepRows n B)
    (hAB : ∀ k, k < A.length → spanRel n B (ground.getAt [] A k))
    (hBA : ∀ k, k < B.length → spanRel n A (ground.getAt [] B k)) :
    A.length = B.length :=
  Nat.le_antisymm (span_count_le n A B hA hB hiA hAB)
    (span_count_le n B A hB hA hiB hBA)

/-! The action kit: the matrix action's linearity and composition
reads, the span kept under a linear map whose row images sit in the
target span, and the combination fold inside a span — the closure
tier's consumption. -/

/-- The action's length: one entry per row. -/
theorem matVec_length (T : Mat) (v : List BPair) :
    (matVec T v).length = T.length :=
  ground.length_map _ T

/-- The action splits over a joined datum, the rows' map at the
join (`def:elim`'s action tier). -/
theorem matVec_append (A B : Mat) (x : List BPair) :
    matVec (A ++ B) x = matVec A x ++ matVec B x :=
  ground.map_append (fun r => dotN r x) A B

/-- The product's row count is the left factor's. -/
theorem length_matMul (a b : Mat) :
    (matMul a b).length = a.length :=
  ground.length_map _ a

/-- The action at a unit-tail vector reads the unit tail. -/
theorem matVec_null : ∀ (T : Mat) (v : List BPair),
    poly.unitTail v → poly.unitTail (matVec T v)
  | [], _, _ => trivial
  | r :: t, v, hv => by
    show (dotN r v).oneValue BPair.unit ∧ poly.unitTail (matVec t v)
    exact ⟨BPair.oneValue_trans (dotN_read r v)
        (dotP_null_right r v
          (fun i _ => poly.getAt_unitTail hv i)),
      matVec_null t v hv⟩

private theorem matVec_congr_go : ∀ (T : Mat) (u u' : List BPair),
    u.length = u'.length → poly.oneValue u u' →
    poly.oneValue (matVec T u) (matVec T u')
  | [], _, _, _, _ => trivial
  | r :: t, u, u', hl, h => by
    show (dotN r u).oneValue (dotN r u')
      ∧ poly.oneValue (matVec t u) (matVec t u')
    exact ⟨BPair.oneValue_trans (dotN_read r u)
        (BPair.oneValue_trans
          (dotP_congr_right r u u' hl
            (fun i _ => poly.oneValue_getAt i h))
          (BPair.oneValue_symm (dotN_read r u'))),
      matVec_congr_go t u u' hl h⟩

/-- The action splits over the memberwise sum with no row frame:
the rows enter the pairing one at a time and the three folds
truncate together at the members' shared order. -/
theorem matVec_vecAdd_free : ∀ (M : Mat) (u w : List BPair),
    u.length = w.length →
    poly.oneValue (matVec M (vecAdd u w))
      (vecAdd (matVec M u) (matVec M w))
  | [], _, _, _ => trivial
  | r :: t, u, w, h => by
    refine ⟨?_, matVec_vecAdd_free t u w h⟩
    exact BPair.oneValue_trans (dotN_read r (vecAdd u w))
      (BPair.oneValue_trans (dotP_vecAdd_right r u w h)
        (BPair.add_congr (BPair.oneValue_symm (dotN_read r u))
          (BPair.oneValue_symm (dotN_read r w))))

/-- The action splits over the componentwise sum: the shape
wrapper at the square frame's data, the members' shared order the
general's one read. -/
theorem matVec_vecAdd (T : Mat) (n : Nat) (_ : rowsLen n T)
    (u w : List BPair) (hu : u.length = n) (hw : w.length = n) :
    poly.oneValue (matVec T (vecAdd u w))
      (vecAdd (matVec T u) (matVec T w)) :=
  matVec_vecAdd_free T u w (hu.trans hw.symm)

/-- The action keeps a scaled vector's scaling with no row
frame. -/
theorem matVec_vecScale_free : ∀ (M : Mat) (c : BPair)
    (u : List BPair),
    poly.oneValue (matVec M (vecScale c u))
      (vecScale c (matVec M u))
  | [], _, _ => trivial
  | r :: t, c, u => by
    refine ⟨?_, matVec_vecScale_free t c u⟩
    exact BPair.oneValue_trans (dotN_read r (vecScale c u))
      (BPair.oneValue_trans (dotP_vecScale_right r u c)
        (BPair.mul_congr (BPair.oneValue_refl c)
          (BPair.oneValue_symm (dotN_read r u))))

private theorem unitReplRead (n : Nat) (v : List BPair) :
    BPair.unit.oneValue (dotP (List.replicate n BPair.unit) v) :=
  BPair.oneValue_symm (BPair.oneValue_trans
    (BPair.oneValue_of_eq
      (dotP_comm (List.replicate n BPair.unit) v))
    (dotP_repl_unit v n))

/-- The pairing Fubini at every coefficient length: a list shorter
or longer than the row count truncates on both sides alike, so the
coefficients enter unconstrained. -/
private theorem dotP_matVec_gen (n : Nat) (v : List BPair)
    (hv : v.length = n) : ∀ (s : List BPair) (T : Mat),
    rowsLen n T →
      (dotP s (matVec T v)).oneValue (dotP (combo n s T) v)
  | [], _, _ => unitReplRead n v
  | _ :: _, [], _ => unitReplRead n v
  | a :: s, r :: T', hT => by
    have hr : r.length = v.length := hT.1.trans hv.symm
    have hX : (vecScale a r).length = v.length :=
      (length_vecScale a r).trans hr
    have hY : (combo n s T').length = v.length :=
      (length_combo n s T' hT.2).trans hv.symm
    show (a * dotN r v + dotP s (matVec T' v)).oneValue
      (dotP (vecAdd (vecScale a r) (combo n s T')) v)
    refine BPair.oneValue_trans ?_
      (BPair.oneValue_of_eq
        (dotP_comm v (vecAdd (vecScale a r) (combo n s T'))))
    refine BPair.oneValue_symm (BPair.oneValue_trans
      (dotP_vecAdd v (vecScale a r) (combo n s T') hX hY) ?_)
    refine BPair.add_congr ?_ ?_
    · exact BPair.oneValue_trans (dotP_vecScale a v r hr)
        (BPair.mul_congr (BPair.oneValue_refl a)
          (BPair.oneValue_trans (BPair.oneValue_of_eq (dotP_comm v r))
            (BPair.oneValue_symm (dotN_read r v))))
    · exact BPair.oneValue_trans
        (BPair.oneValue_of_eq (dotP_comm v (combo n s T')))
        (BPair.oneValue_symm
          (dotP_matVec_gen n v hv s T' hT.2))

/-- The action's pairing Fubini: a coefficient list against the
mapped vector reads the coefficients' combination against the
vector. -/
theorem dotP_matVec (n : Nat) (s : List BPair) (T : Mat)
    (v : List BPair) (hT : rowsLen n T) (hv : v.length = n)
    (_hs : s.length = T.length) :
    (dotP s (matVec T v)).oneValue (dotP (combo n s T) v) :=
  dotP_matVec_gen n v hv s T hT

theorem combo_getAt (n : Nat) (cs : List BPair)
    (L : Mat) (i : Nat) (hL : rowsLen n L) (hi : i < n) :
    (ground.getAt BPair.unit (combo n cs L) i).oneValue
      (dotP cs (L.map (fun r => ground.getAt BPair.unit r i))) :=
  comboO_getAt (R := ground.bpairRead) bpairLaws n cs L i hL hi

/-- The transpose's rows: every column list carries the source
matrix's own row count, no width hypothesis on the source. -/
theorem rowsLen_transposeM (m : Mat) :
    rowsLen m.length (transposeM m) := rowsLen_transposeO bpairOps m

/-! `lem:dualread`(i)'s Gram reads: the struck columns' width, the
mapped pairing's index fold, the Gram's symmetry, and the cofactor
vector's column fold. -/

/-- The pairing of two families mapped over one index list is the
index fold of the members' products, the fold's own spelling at a
shared index. -/
theorem dotP_map_pair {α : Type} (f g : α → BPair) :
    ∀ l : List α, dotP (l.map f) (l.map g)
      = ground.famFold BPair.add BPair.unit (fun x => f x * g x) l
  | [] => rfl
  | x :: t => by
    show f x * g x + dotP (t.map f) (t.map g)
      = f x * g x + ground.famFold BPair.add BPair.unit
        (fun y => f y * g y) t
    rw [dotP_map_pair f g t]

/-- The Gram is symmetric: the exchanged key lists read the two
source rows' pairing at its two orders, one value entry by
entry. -/
theorem gramM_symm (L : Mat) (i j : Nat) (hi : i < L.length)
    (hj : j < L.length) :
    ground.getAt BPair.unit (ground.getAt [] (gramM L) i) j
      = ground.getAt BPair.unit (ground.getAt [] (gramM L) j) i := by
  rw [gramM_entry L i j hi hj, gramM_entry L j i hj hi, dotP_comm]

/-- The cofactor vector's column fold at a row of a square: a
family carrying a row's entries folds against a cofactor vector's
entries to the determinant at that vector's own key and the sum's
unit at every further key — the row solve's two reads at the
adjugate's exchanged order. -/
theorem cofVec_col_fold (G : Mat) {n : Nat} (hsq : sqAt G n)
    (a' k : Nat) (ha' : a' < n) (hk : k < n) (A : Nat → BPair)
    (hA : ∀ i, i < n →
      A i = ground.getAt BPair.unit (ground.getAt [] G a') i) :
    (ground.famFold BPair.add BPair.unit
      (fun i => A i * ground.getAt BPair.unit (cofVec G k) i)
      (List.range n)).oneValue
      (if k = a' then detL G else BPair.unit) := by
  have hlen : G.length = n := sqAt_len hsq
  have hrows : rowsLen n G := rowsLen_of_sqAt hsq
  have haG : a' < G.length := by rw [hlen]; exact ha'
  have hkG : k < G.length := by rw [hlen]; exact hk
  have hrow : (ground.getAt [] G a').length = G.length := by
    rw [rowsLen_getAt G a' hrows haG, hlen]
  have hfold : dotP (ground.getAt [] G a') (cofVec G k)
      = ground.famFold BPair.add BPair.unit
        (fun i => ground.getAt BPair.unit (ground.getAt [] G a') i
          * sgnP (k + i) (cof0 (G.eraseIdx k) i))
        (List.range G.length) :=
    dotO_map_range bpairOps
      (fun i => sgnP (k + i) (cof0 (G.eraseIdx k) i))
      G.length (ground.getAt [] G a') hrow
  rw [hlen] at hfold
  refine BPair.oneValue_trans
    (ground.foldB_congr_members
      (fun i => A i * ground.getAt BPair.unit (cofVec G k) i)
      (fun i => ground.getAt BPair.unit (ground.getAt [] G a') i
        * sgnP (k + i) (cof0 (G.eraseIdx k) i))
      (List.range n) ?_)
    (BPair.oneValue_trans (BPair.oneValue_of_eq hfold.symm) ?_)
  · intro t ht
    have htn : t < n := ground.ltOfMem ht
    have htG : t < G.length := by rw [hlen]; exact htn
    have hentry : ground.getAt BPair.unit (cofVec G k) t
        = sgnP (k + t) (cof0 (G.eraseIdx k) t) := by
      show ground.getAt BPair.unit
          ((List.range G.length).map
            (fun i => sgnP (k + i) (cof0 (G.eraseIdx k) i))) t
        = sgnP (k + t) (cof0 (G.eraseIdx k) t)
      rw [ground.getAt_map 0 BPair.unit _ (List.range G.length) t
          (by rw [ground.length_range]; exact htG),
        ground.getAt_range G.length t htG]
    show (A t * ground.getAt BPair.unit (cofVec G k) t).oneValue
      (ground.getAt BPair.unit (ground.getAt [] G a') t
        * sgnP (k + t) (cof0 (G.eraseIdx k) t))
    rw [hA t htn, hentry]
    exact BPair.oneValue_refl _
  · by_cases hka : k = a'
    · rw [if_pos hka, hka]
      exact cofVec_diag G a' haG hrow
    · rw [if_neg hka]
      exact cofVec_off G a' k haG hkG (fun he => hka he.symm) hrow

/-- Two column keys of one value read the determinant at equal
members: the exchanged key lists read one determinant, and the
exchange turns the repeated columns into repeated rows. -/
private theorem detL_cols_equal (m : Mat) (hsq : rowsLen m.length m)
    {i j : Nat} (hij : i < j) (hjm : j < m.length)
    (heq : ∀ a, a < m.length →
      ground.getAt BPair.unit (ground.getAt [] m a) i
        = ground.getAt BPair.unit (ground.getAt [] m a) j) :
    (detL m).oneValue BPair.unit := by
  match m, hsq, hjm with
  | [], _, hjm0 => exact absurd hjm0 (Nat.not_lt_zero j)
  | r :: t, hsq, hjm =>
    rw [← detL_transpose (r :: t) hsq]
    refine detL_rows_equal hij
      (by
        rw [length_transposeM (r :: t) hsq (Nat.succ_pos _)]
        exact hjm) ?_
    refine ground.getAt_ext BPair.unit _ _ ?_ ?_
    · rw [rowsLen_getAt (transposeM (r :: t)) i
          (rowsLen_transposeM (r :: t))
          (by
            rw [length_transposeM (r :: t) hsq (Nat.succ_pos _)]
            exact Nat.lt_trans hij hjm),
        rowsLen_getAt (transposeM (r :: t)) j
          (rowsLen_transposeM (r :: t))
          (by
            rw [length_transposeM (r :: t) hsq (Nat.succ_pos _)]
            exact hjm)]
    · intro a ha
      rw [rowsLen_getAt (transposeM (r :: t)) i
          (rowsLen_transposeM (r :: t))
          (by
            rw [length_transposeM (r :: t) hsq (Nat.succ_pos _)]
            exact Nat.lt_trans hij hjm)] at ha
      rw [getAt_transposeM BPair.unit (r :: t) hsq i a
          (Nat.lt_trans hij hjm) ha,
        getAt_transposeM BPair.unit (r :: t) hsq j a hjm ha]
      exact heq a ha

/-- A bordered selection at a border row already among its leading
keys reads equal members, the repeated row's own. -/
private theorem borderAt_row_repeat (k' i' j' : Nat) (m : Mat)
    (hik : i' < k') : (detL (borderAt k' i' j' m)).oneValue
      BPair.unit := by
  refine detL_rows_equal (i := i') (j := k') hik
    (by rw [borderAt_len]; exact Nat.lt_succ_self k') ?_
  rw [borderAt_row k' i' j' m i' (Nat.lt_succ_of_lt hik),
    borderAt_row k' i' j' m k' (Nat.lt_succ_self k'),
    if_pos hik, if_neg (Nat.lt_irrefl k')]

/-- A bordered selection at a border column already among its
leading keys reads equal members, the repeated column's own. -/
private theorem borderAt_col_repeat (k' i' j' : Nat) (m : Mat)
    (hjk : j' < k') : (detL (borderAt k' i' j' m)).oneValue
      BPair.unit := by
  have hlen : (borderAt k' i' j' m).length = k' + 1 :=
    borderAt_len k' i' j' m
  refine detL_cols_equal (borderAt k' i' j' m)
    (by rw [hlen]; exact borderAt_rows k' i' j' m)
    (i := j') (j := k') hjk
    (by rw [hlen]; exact Nat.lt_succ_self k') ?_
  intro a ha
  rw [hlen] at ha
  rw [borderAt_entry k' i' j' m a j' ha
      (Nat.lt_succ_of_lt hjk),
    borderAt_entry k' i' j' m a k' ha (Nat.lt_succ_self k'),
    if_pos hjk, if_neg (Nat.lt_irrefl k')]

/-- The Sylvester read at the first-row fold's spelling holds at
every square list: the minor collects to the assignment fold
(`minor_detL`) and the identity reads at the collected
determinants (`sylvester`), the two sublists' spellings one list
(`bordered_borderAt`, `leading_leadAt`). -/
theorem sylvesterRead_holds (m : Mat) (hsq : rowsLen m.length m)
    (k i j : Nat) (hk1 : k + 1 ≤ m.length) (him : i < m.length)
    (hjm : j < m.length) : sylvesterRead m k i j := by
  have hw : ∀ a, a < m.length →
      (ground.getAt [] m a).length = m.length :=
    fun a ha => rowsLen_getAt m a hsq ha
  have hkm : k ≤ m.length := Nat.le_of_lt hk1
  have hkml : k < m.length := hk1
  show BPair.oneValue
    (leading m k * bordered m (k + 1) i j
      + bordered m k i k * bordered m k k j)
    (bordered m k k k * bordered m k i j)
  rw [leading_leadAt m k hkm hw,
    bordered_borderAt m (k + 1) i j hk1 him hw,
    bordered_borderAt m k i k hkm him hw,
    bordered_borderAt m k k j hkm hkml hw,
    bordered_borderAt m k k k hkm hkml hw,
    bordered_borderAt m k i j hkm him hw]
  have hb : ∀ (k' i' j' : Nat),
      (minor (borderAt k' i' j' m)).oneValue
        (detL (borderAt k' i' j' m)) := fun k' i' j' => by
    refine minor_detL (borderAt k' i' j' m) ?_
    rw [borderAt_len]
    exact borderAt_rows k' i' j' m
  have hL : (minor (leadAt k m)).oneValue (detL (leadAt k m)) := by
    refine minor_detL (leadAt k m) ?_
    rw [leadAt_len]
    exact leadAt_rowsW k m
  refine BPair.oneValue_trans
    (BPair.add_congr (BPair.mul_congr hL (hb (k + 1) i j))
      (BPair.mul_congr (hb k i k) (hb k k j))) ?_
  refine BPair.oneValue_trans ?_ (BPair.oneValue_symm
    (BPair.mul_congr (hb k k k) (hb k i j)))
  cases Nat.lt_or_ge k i with
  | inl hki =>
    cases Nat.lt_or_ge k j with
    | inl hkj => exact sylvester m hsq k i j hki him hkj hjm
    | inr hjk =>
      cases Nat.lt_or_ge j k with
      | inl hjlt =>
        refine BPair.oneValue_trans
          (unitAdd
            (oneValue_mul_unit _ _
              (borderAt_col_repeat (k + 1) i j m
                (Nat.lt_succ_of_lt hjlt)))
            (oneValue_mul_unit _ _
              (borderAt_col_repeat k k j m hjlt))) ?_
        exact BPair.oneValue_symm (oneValue_mul_unit _ _
          (borderAt_col_repeat k i j m hjlt))
      | inr hkj2 =>
        have hejk : j = k := Nat.le_antisymm hjk hkj2
        subst hejk
        refine BPair.oneValue_trans
          (BPair.add_congr
            (oneValue_mul_unit _ _
              (borderAt_col_repeat (j + 1) i j m
                (Nat.lt_succ_self j)))
            (BPair.oneValue_refl _)) ?_
        refine BPair.oneValue_trans (BPair.unit_add _) ?_
        exact BPair.oneValue_of_eq
          (BPair.mul_comm (detL (borderAt j i j m))
            (detL (borderAt j j j m)))
  | inr hik =>
    cases Nat.lt_or_ge i k with
    | inl hilt =>
      refine BPair.oneValue_trans
        (unitAdd
          (oneValue_mul_unit _ _
            (borderAt_row_repeat (k + 1) i j m
              (Nat.lt_succ_of_lt hilt)))
          (oneValue_unit_mul
            (borderAt_row_repeat k i k m hilt))) ?_
      exact BPair.oneValue_symm (oneValue_mul_unit _ _
        (borderAt_row_repeat k i j m hilt))
    | inr hki2 =>
      have heik : i = k := Nat.le_antisymm hik hki2
      subst heik
      refine BPair.oneValue_trans
        (BPair.add_congr
          (oneValue_mul_unit _ _
            (borderAt_row_repeat (i + 1) i j m
              (Nat.lt_succ_self i)))
          (BPair.oneValue_refl _)) ?_
      exact BPair.unit_add _

/-- The seed matrix's rows: a stated member's family at the stated
width, one row per stated key, at every entry carrier. -/
private theorem rowsLen_replicateO {γ : Type} (a : γ) (n : Nat) :
    ∀ m : Nat, rowsLen n (List.replicate m (List.replicate n a))
  | 0 => trivial
  | m + 1 => ⟨ground.length_replicate a n, rowsLen_replicateO a n m⟩

/-- The seed matrix's rows: the unit family at the stated width,
one row per stated key. -/
theorem rowsLen_replicate (n : Nat) : ∀ m : Nat,
    rowsLen n (List.replicate m (List.replicate n BPair.unit)) :=
  rowsLen_replicateO BPair.unit n

private theorem matVec_transpose_entry (n : Nat) (T : Mat)
    (s : List BPair) (hT : rowsLen n T) (hne : 0 < T.length)
    (i : Nat) (hi : i < n) :
    (ground.getAt BPair.unit (matVec (transposeM T) s) i).oneValue
      (ground.getAt BPair.unit (combo n s T) i) := by
  have hlenT : (transposeM T).length = n := length_transposeM T hT hne
  have hiT : i < (transposeM T).length := by rw [hlenT]; exact hi
  have hcol : (ground.getAt [] (transposeM T) i).length = T.length :=
    rowsLen_getAt (transposeM T) i (rowsLen_transposeM T) hiT
  have hread : ground.getAt BPair.unit (matVec (transposeM T) s) i
      = dotN (ground.getAt [] (transposeM T) i) s :=
    ground.getAt_map [] BPair.unit (fun r => dotN r s)
      (transposeM T) i hiT
  have hlen : (ground.getAt [] (transposeM T) i).length
      = (T.map (fun r => ground.getAt BPair.unit r i)).length := by
    rw [hcol, ground.length_map]
  have hpt : ∀ q, q < (ground.getAt [] (transposeM T) i).length →
      (ground.getAt BPair.unit
        (ground.getAt [] (transposeM T) i) q).oneValue
      (ground.getAt BPair.unit
        (T.map (fun r => ground.getAt BPair.unit r i)) q) := by
    intro q hq
    rw [hcol] at hq
    have e1 : ground.getAt BPair.unit
        (ground.getAt [] (transposeM T) i) q
        = ground.getAt BPair.unit (ground.getAt [] T q) i :=
      getAt_transposeM BPair.unit T hT i q hi hq
    have e2 : ground.getAt BPair.unit
        (T.map (fun r => ground.getAt BPair.unit r i)) q
        = ground.getAt BPair.unit (ground.getAt [] T q) i :=
      ground.getAt_map [] BPair.unit
        (fun r => ground.getAt BPair.unit r i) T q hq
    exact BPair.oneValue_of_eq (e1.trans e2.symm)
  exact BPair.oneValue_trans (BPair.oneValue_of_eq hread)
    (BPair.oneValue_trans
      (dotN_read (ground.getAt [] (transposeM T) i) s)
      (BPair.oneValue_trans
        (BPair.oneValue_of_eq
          (dotP_comm (ground.getAt [] (transposeM T) i) s))
        (BPair.oneValue_trans
          (dotP_congr_right s (ground.getAt [] (transposeM T) i)
            (T.map (fun r => ground.getAt BPair.unit r i)) hlen hpt)
          (BPair.oneValue_symm (combo_getAt n s T i hT hi)))))

private theorem matVec_transpose_go (n : Nat) (T : Mat)
    (s : List BPair) (hT : rowsLen n T) (hne : 0 < T.length) :
    poly.oneValue (matVec (transposeM T) s) (combo n s T) := by
  have hL : (matVec (transposeM T) s).length = n := by
    rw [matVec_length, length_transposeM T hT hne]
  refine poly.oneValue_of_entries _ _ ?_ ?_
  · rw [hL, length_combo n s T hT]
  · intro i hi
    rw [hL] at hi
    exact matVec_transpose_entry n T s hT hne i hi

/-- The transpose's action is the combination: the exchanged reads
collect the coefficient fold. -/
theorem matVec_transpose_combo (n : Nat) (T : Mat)
    (s : List BPair) (hT : rowsLen n T) (hs : s.length = T.length) :
    poly.oneValue (matVec (transposeM T) s) (combo n s T) := by
  match T, hT, hs with
  | [], _, hs0 =>
    match s, hs0 with
    | [], _ =>
      show poly.unitTail (List.replicate n BPair.unit)
      exact poly.unitTail_replicate n
    | _ :: _, hbad => nomatch hbad
  | r :: t, hT0, _ =>
    exact matVec_transpose_go n (r :: t) s hT0 (Nat.succ_pos _)

private theorem dotN_map_comm : ∀ (M : Mat) (u : List BPair),
    poly.oneValue (M.map (fun c => dotN u c)) (matVec M u)
  | [], _ => trivial
  | r :: t, u => by
    show (dotN u r).oneValue (dotN r u)
      ∧ poly.oneValue (t.map (fun c => dotN u c)) (matVec t u)
    exact ⟨BPair.oneValue_trans (dotN_read u r)
        (BPair.oneValue_trans (BPair.oneValue_of_eq (dotP_comm u r))
          (BPair.oneValue_symm (dotN_read r u))),
      dotN_map_comm t u⟩

/-! The composition's row read at every row length: the row against
the second factor's column folds reads that row against the second
factor's own action, the exchange through the transpose with no
shape read on the row — a row shorter or longer than the factor's
row count truncates on both sides alike. -/

private theorem matVec_row_gen (n : Nat) : ∀ (T : Mat)
    (v s : List BPair), rowsLen n T → v.length = n →
      (dotN s (matVec T v)).oneValue
        (dotN ((transposeM T).map (fun c => dotN s c)) v)
  | [], v, s, _, _ => by
    show (dotN s ([] : List BPair)).oneValue
      (dotN ([] : List BPair) v)
    match s with
    | [] => exact BPair.oneValue_refl _
    | _ :: _ => exact BPair.oneValue_refl _
  | r :: t, v, s, hT, hv => by
    have hMt : (transposeM (r :: t)).length = n :=
      length_transposeM (r :: t) hT (Nat.succ_pos _)
    have hrow : ((transposeM (r :: t)).map
        (fun c => dotN s c)).length = n := by
      rw [ground.length_map, hMt]
    have hcb : (combo n s (r :: t)).length = n :=
      length_combo n s (r :: t) hT
    have hpo : poly.oneValue (combo n s (r :: t))
        ((transposeM (r :: t)).map (fun c => dotN s c)) :=
      poly.oneValue_symm
        (poly.oneValue_trans
          (dotN_map_comm (transposeM (r :: t)) s)
          (matVec_transpose_go n (r :: t) s hT (Nat.succ_pos _)))
    refine BPair.oneValue_trans (dotN_read s (matVec (r :: t) v)) ?_
    refine BPair.oneValue_trans
      (dotP_matVec_gen n v hv s (r :: t) hT) ?_
    refine BPair.oneValue_trans
      (BPair.oneValue_of_eq (dotP_comm (combo n s (r :: t)) v)) ?_
    refine BPair.oneValue_trans
      (dotP_congr_right v (combo n s (r :: t))
        ((transposeM (r :: t)).map (fun c => dotN s c))
        (hcb.trans hrow.symm)
        (fun i _ => poly.oneValue_getAt i hpo)) ?_
    exact BPair.oneValue_trans
      (BPair.oneValue_of_eq
        (dotP_comm v ((transposeM (r :: t)).map (fun c => dotN s c))))
      (BPair.oneValue_symm
        (dotN_read
          ((transposeM (r :: t)).map (fun c => dotN s c)) v))

private theorem matVec_comp_go (n : Nat) (T : Mat) (v : List BPair)
    (hT : rowsLen n T) (hv : v.length = n) :
    ∀ S : Mat, rowsLen T.length S →
      poly.oneValue (matVec S (matVec T v)) (matVec (matMul S T) v)
  | [], _ => trivial
  | s :: S', hS => by
    show (dotN s (matVec T v)).oneValue
        (dotN ((transposeM T).map (fun c => dotN s c)) v)
      ∧ poly.oneValue (matVec S' (matVec T v))
        (matVec (matMul S' T) v)
    exact ⟨matVec_row_gen n T v s hT hv,
      matVec_comp_go n T v hT hv S' hS.2⟩

/-- The composed actions read the matrix product's. -/
theorem matVec_comp (S T : Mat) (v : List BPair) (n : Nat)
    (hT : rowsLen n T) (hv : v.length = n)
    (hS : rowsLen T.length S) :
    poly.oneValue (matVec S (matVec T v)) (matVec (matMul S T) v) :=
  matVec_comp_go n T v hT hv S hS

/-- The product's action splits into the factors' own: the left
factor enters row by row at no shape read, the right factor's at
its stated width. -/
theorem matVec_matMul : ∀ (a b : Mat) (n : Nat), rowsLen n b →
    ∀ (v : List BPair), v.length = n →
      poly.oneValue (matVec (matMul a b) v) (matVec a (matVec b v))
  | [], _, _, _, _, _ => trivial
  | r :: t, b, n, hb, v, hv => by
    show (dotN ((transposeM b).map (fun c => dotN r c)) v).oneValue
        (dotN r (matVec b v))
      ∧ poly.oneValue (matVec (matMul t b) v)
        (matVec t (matVec b v))
    exact ⟨BPair.oneValue_symm (matVec_row_gen n b v r hb hv),
      matVec_matMul t b n hb v hv⟩

/-- The product's rows carry the second factor's transpose count:
one entry per column key of the right factor. -/
theorem rowsLen_matMul : ∀ (a b : Mat),
    rowsLen (transposeM b).length (matMul a b)
  | [], _ => trivial
  | _ :: t, b =>
    ⟨ground.length_map _ (transposeM b), rowsLen_matMul t b⟩

/-- The row shape transported across an order identity. -/
theorem rowsLen_cast {a b : Nat} (h : a = b) {M : Mat}
    (hm : rowsLen a M) : rowsLen b M := by rw [← h]; exact hm

/-- The transpose's row count at a square shape. -/
theorem transposeLen {n : Nat} : ∀ (T : Mat), rowsLen n T →
    T.length = n → (transposeM T).length = n
  | [], _, hz => hz
  | r :: t, hr, _ => length_transposeM (r :: t) hr (Nat.succ_pos _)

private theorem allBeq : ∀ (M : Mat) (n : Nat), rowsLen n M →
    M.all (fun r => Nat.beq r.length n) = true
  | [], _, _ => rfl
  | r :: t, n, h => by
    show (Nat.beq r.length n
      && t.all (fun s => Nat.beq s.length n)) = true
    rw [h.1, ground.beqRefl n, allBeq t n h.2]
    rfl

/-- The square shape off its two reads, `rowsLen_of_sqAt`'s
converse constructor. -/
theorem sqAt_of {M : Mat} {n : Nat} (hl : M.length = n)
    (hr : rowsLen n M) : sqAt M n := by
  show (Nat.beq M.length n
    && M.all (fun r => Nat.beq r.length n)) = true
  rw [hl, ground.beqRefl n, allBeq M n hr]
  rfl

/-- The square shape kept by the product at one order. -/
theorem sqSquare {A : Mat} {n : Nat} (h : sqAt A n) :
    sqAt (matMul A A) n := by
  have hl : A.length = n := ground.beqEq _ _ ((ground.andSplitB h).1)
  have hr : rowsLen n A := rowsLen_of_sqAt h
  refine sqAt_of ?_ (rowsLen_cast (transposeLen A hr hl)
    (rowsLen_matMul A A))
  show (A.map (fun r => (transposeM A).map (fun c => dotN r c))).length
    = n
  rw [ground.length_map]; exact hl


/-! The action's span transport: the matrix action's combination
read, and the span kept under an action whose row images sit in
the target span — the consumers' bedrock at the moved key
lists. -/

/-- The action's combination read: a matrix acting on a
combination of a family reads the combination, at the same
coefficients, of the family's own images (`lem:inertia`'s two
lists and `lem:lowerspan`'s transport the consumers). -/
theorem matVec_combo (T : Mat) (n : Nat) :
    ∀ (cs : List BPair) (L : Mat), rowsLen n L →
      poly.oneValue (matVec T (combo n cs L))
        (combo T.length cs (L.map (matVec T)))
  | [], _, _ =>
    poly.unitTail_oneValue
      (matVec_null T _ (poly.unitTail_replicate n))
      (poly.unitTail_replicate T.length)
  | _ :: _, [], _ =>
    poly.unitTail_oneValue
      (matVec_null T _ (poly.unitTail_replicate n))
      (poly.unitTail_replicate T.length)
  | c :: cs, r :: L, hL => by
    have hK : rowsLen T.length (L.map (matVec T)) :=
      rowsLen_map (matVec T) T.length L (fun x _ => (fun y => matVec_length T y) x)
    show poly.oneValue
      (matVec T (vecAdd (vecScale c r) (combo n cs L)))
      (vecAdd (vecScale c (matVec T r))
        (combo T.length cs (L.map (matVec T))))
    refine poly.oneValue_trans
      (matVec_vecAdd_free T _ _
        (((length_vecScale c r).trans hL.1).trans
          (length_combo n cs L hL.2).symm)) ?_
    refine polyOne_vecAdd _ _ _ _
      (matVec_vecScale_free T c r)
      (matVec_combo T n cs L hL.2)
      ((matVec_length T _).trans
        ((length_vecScale c (matVec T r)).trans
          (matVec_length T r)).symm)
      ((matVec_length T _).trans
        (length_combo T.length cs _ hK).symm)

/-- The span's transport under a matrix action: at a source list
whose row images all sit in the target list's span, every span
member of the source maps into the target's span
(`lem:lowerspan`'s transport read). -/
theorem span_map (T : Mat) (n : Nat)
    (L M : Mat) (hL : rowsLen n L) (hM : rowsLen T.length M)
    (himg : ∀ k, k < L.length →
      spanRel T.length M (matVec T (ground.getAt [] L k)))
    (x : List BPair) (hx : x.length = n) (h : spanRel n L x) :
    spanRel T.length M (matVec T x) := by
  obtain ⟨c₀, cs, hc₀, hcl, hone⟩ := span_elim h
  have hK : rowsLen T.length (L.map (matVec T)) :=
    rowsLen_map (matVec T) T.length L (fun x _ => (fun y => matVec_length T y) x)
  have hsp : spanRel T.length M
      (combo T.length cs (L.map (matVec T))) := by
    refine spanRel_combo T.length M hM _ cs hK ?_
    intro k hk
    rw [ground.length_map] at hk
    rw [ground.getAt_map ([] : List BPair) ([] : List BPair)
      (matVec T) L k hk]
    exact himg k hk
  have hchain : poly.oneValue (vecScale c₀ (matVec T x))
      (combo T.length cs (L.map (matVec T))) :=
    poly.oneValue_trans
      (poly.oneValue_symm (matVec_vecScale_free T c₀ x))
      (poly.oneValue_trans
        (matVec_congr_go T (vecScale c₀ x) (combo n cs L)
          (((length_vecScale c₀ x).trans hx).trans
            (length_combo n cs L hL).symm) hone)
        (matVec_combo T n cs L hL))
  exact spanRel_unscale T.length M c₀ (matVec T x) hc₀
    (spanRel_congr T.length M _ _ (poly.oneValue_symm hchain) hsp
      ((length_vecScale c₀ (matVec T x)).trans
        (matVec_length T x)))

/-- The span's transport under a stated linear map: a map given by
its width law, its one-value congruence, its scale law and its
combination law carries a span member into the mapped list's span,
the clearing scalar kept (`lem:lowerspan`'s transport read at the
map's own laws; the matrix action and the wedge tensored on are
its instances). -/
theorem spanRel_mapBy (n m : Nat) (f : List BPair → List BPair)
    (hflen : ∀ x : List BPair, (f x).length = m)
    (hfcongr : ∀ a b : List BPair, a.length = n → b.length = n →
      poly.oneValue a b → poly.oneValue (f a) (f b))
    (hfscale : ∀ (c : BPair) (x : List BPair), x.length = n →
      poly.oneValue (f (vecScale c x)) (vecScale c (f x)))
    (hfcombo : ∀ (cs : List BPair) (M : Mat), rowsLen n M →
      poly.oneValue (f (combo n cs M)) (combo m cs (M.map f)))
    (M : Mat) (hM : rowsLen n M) (v : List BPair)
    (hv : v.length = n) (h : spanRel n M v) :
    spanRel m (M.map f) (f v) := by
  match span_elim h with
  | ⟨c₀, cs, hc₀, hcsl, hone⟩ =>
    refine span_intro m (M.map f) (f v)
      (rowsLen_map f m M (fun x _ => hflen x)) (hflen v)
      ⟨c₀, cs, hc₀, hcsl.trans (ground.length_map f M).symm, ?_⟩
    refine poly.oneValue_trans
      (poly.oneValue_symm (hfscale c₀ v hv)) ?_
    refine poly.oneValue_trans
      (hfcongr (vecScale c₀ v) (combo n cs M)
        ((length_vecScale c₀ v).trans hv)
        (length_combo n cs M hM) hone) ?_
    exact hfcombo cs M hM

/-- The independence's transport under a stated linear map: a map
given by its width law, its unit reflection and its combination law
keeps a family's independence at the mapped list, a mapped null
combination's coefficients read back through the reflection
(`lem:lowerspan`'s two-list clause at the map's own laws). -/
theorem indep_mapBy (n m : Nat) (f : List BPair → List BPair)
    (hflen : ∀ x : List BPair, (f x).length = m)
    (hfunit : ∀ x : List BPair, x.length = n →
      poly.unitTail (f x) → poly.unitTail x)
    (hfcombo : ∀ (cs : List BPair) (M : Mat), rowsLen n M →
      poly.oneValue (f (combo n cs M)) (combo m cs (M.map f)))
    (M : Mat) (hM : rowsLen n M) (hi : indepRows n M) :
    indepRows m (M.map f) := by
  refine indep_intro m (M.map f)
    (rowsLen_map f m M (fun x _ => hflen x)) ?_
  intro cs hcs hnull
  refine indep_elim hi cs (hcs.trans (ground.length_map f M)) ?_
  refine hfunit (combo n cs M) (length_combo n cs M hM) ?_
  exact poly.unitTail_oneValue_right hnull
    (poly.oneValue_symm (hfcombo cs M hM))

/-- The span's matrix transport at the mapped family: a member of
a family's span maps into the image family's span, the
combination read under the action (`lem:lowerspan`'s transport
with the target list the source's own image). -/
theorem spanRel_matVec (n : Nat) (G : Mat) (x : List BPair)
    (T : Mat) (m : Nat) (hTl : T.length = m)
    (hG : rowsLen n G) (hx : x.length = n) (h : spanRel n G x) :
    spanRel m (G.map (matVec T)) (matVec T x) := by
  have hres := spanRel_mapBy n T.length (matVec T)
    (fun y => matVec_length T y)
    (fun a b ha hb hone =>
      matVec_congr_go T a b (ha.trans hb.symm) hone)
    (fun c y hy => matVec_vecScale_free T c y)
    (fun cs L hL => matVec_combo T n cs L hL)
    G hG x hx h
  rw [hTl] at hres
  exact hres

/-! The pairing folds as index folds over the key range and the
self pairing's one-sided read: the balance carrier's index fold
`bsum` and the key-range reads it rides are `def:ground`'s and
`con:places`' own; what stands here is the pairing.  The form tiers
above are the consumers (`lem:fpcap`'s two-sided cap,
`lem:loopcap`'s Gram route). -/

/-- A count pair against a product of scaled data. -/
theorem mulPairNat (c e : Nat) (x y : BPair) :
    ((BPair.ofNat c * x) * (BPair.ofNat e * y)).oneValue
      (BPair.ofNat (c * e) * (x * y)) := by
  rw [BPair.mul_assoc, BPair.mul_left_comm x (BPair.ofNat e) y,
    ← BPair.mul_assoc]
  exact BPair.mul_congr_left
    (BPair.oneValue_symm (BPair.ofNat_mul c e))

/-- The plain pairing fold as the index fold over the key range. -/
theorem dotP_fold : ∀ (n : Nat) (u v : List BPair),
    u.length = n → v.length = n →
    dotP u v = bsum (fun i => ground.getAt BPair.unit u i
      * ground.getAt BPair.unit v i) (List.range n)
  | 0, [], [], _, _ => rfl
  | 0, [], _ :: _, _, hv => nomatch hv
  | 0, _ :: _, _, hu, _ => nomatch hu
  | _ + 1, [], _, hu, _ => nomatch hu
  | _ + 1, _ :: _, [], _, hv => nomatch hv
  | n + 1, a :: s, b :: t, hu, hv => by
    rw [ground.range_cons n]
    show a * b + dotP s t
      = ground.getAt BPair.unit (a :: s) 0
          * ground.getAt BPair.unit (b :: t) 0
        + bsum (fun i => ground.getAt BPair.unit (a :: s) i
          * ground.getAt BPair.unit (b :: t) i)
          ((List.range n).map (fun x => x + 1))
    rw [bsum_map, dotP_fold n s t (Nat.succ.inj hu)
      (Nat.succ.inj hv)]
    rfl

/-- The self pairing as the index fold of the entries' squares. -/
theorem selfFold (u : List BPair) (n : Nat)
    (hu : u.length = n) :
    (dotN u u).oneValue
      (bsum (fun i => ground.getAt BPair.unit u i
        * ground.getAt BPair.unit u i) (List.range n)) := by
  refine BPair.oneValue_trans (dotN_read u u) ?_
  rw [dotP_fold n u u hu hu]
  exact BPair.oneValue_refl _

/-- The self pairing's own side: the skipping fold at a family
against itself sits at or above the sum's unit, the entries'
squares collected (`lem:loopcap`'s close). -/
theorem dotN_self_side : ∀ v : List ground.BPair,
    ¬ (elim.dotN v v < ground.BPair.unit) := by
  intro v hlt
  have h : (dotP v v).fst + Pos.one < Pos.one + (dotP v v).snd :=
    BPair.lt_congr (dotN_read v v) (BPair.oneValue_refl _) hlt
  match dotP_self_side v with
  | Or.inl he => exact ground.lt_ne h (by rw [he, ground.add_comm])
  | Or.inr ⟨g, hg⟩ =>
    exact ground.lt_asymm h
      ⟨g, by rw [ground.add_assoc, hg, ground.add_comm]⟩

/-- The self pairing at a memberwise sum expands at the two
self-pairings and the cross pairing twice, the cross reads
identified at the pairing's symmetry. -/
private theorem dotP_polar_expand (P Q : List BPair)
    (hPQ : P.length = Q.length) :
    (dotP (vecAdd P Q) (vecAdd P Q)).oneValue
      (dotP P P + dotP Q Q + (dotP P Q + dotP P Q)) := by
  have hW : (vecAdd P Q).length = P.length :=
    length_vecAdd P Q P.length rfl hPQ.symm
  have h1 : (dotP (vecAdd P Q) (vecAdd P Q)).oneValue
      (dotP P (vecAdd P Q) + dotP Q (vecAdd P Q)) :=
    dotP_vecAdd_left P Q (vecAdd P Q) (Nat.le_of_eq hW)
      (Nat.le_of_eq (hW.trans hPQ))
  have h2 : (dotP P (vecAdd P Q)).oneValue (dotP P P + dotP P Q) :=
    dotP_vecAdd_right P P Q hPQ
  have h3 : (dotP Q (vecAdd P Q)).oneValue (dotP Q P + dotP Q Q) :=
    dotP_vecAdd_right Q P Q hPQ
  refine BPair.oneValue_trans h1 ?_
  refine BPair.oneValue_trans (BPair.add_congr h2 h3) ?_
  rw [dotP_comm Q P, BPair.add_comm (dotP P Q) (dotP Q Q),
    BPair.add_add_comm]
  exact BPair.oneValue_refl _

/-- The self pairing at a scaled family is the weight's square
against the family's own self pairing. -/
private theorem dotP_scale_self (c : BPair) (l : List BPair) :
    (dotP (vecScale c l) (vecScale c l)).oneValue ((c * c) * dotP l l) := by
  have h2 : (dotP (vecScale c l) l).oneValue (c * dotP l l) := by
    rw [dotP_comm (vecScale c l) l]
    exact dotP_vecScale_right l l c
  refine BPair.oneValue_trans (dotP_vecScale_right (vecScale c l) l c) ?_
  refine BPair.oneValue_trans
    (BPair.mul_congr (BPair.oneValue_refl c) h2) ?_
  exact BPair.oneValue_of_eq (BPair.mul_assoc c c (dotP l l)).symm

/-- The pairing's polarization at two weights: the doubled weighted
pairing sits at or below the weighted self-pairings' sum, the
square's own expansion at the memberwise swap. -/
theorem dotN_polar (u v : List BPair) (h : u.length = v.length)
    (a b : BPair) :
    ((a * b) * dotN u v).scale 2
      ≤ (a * a) * dotN u u + (b * b) * dotN v v := by
  have hPQ : (vecScale a u).length
      = ((vecScale b v).map BPair.swap).length := by
    rw [length_vecScale, ground.length_map, length_vecScale]
    exact h
  have hQQe : dotP ((vecScale b v).map BPair.swap)
        ((vecScale b v).map BPair.swap)
      = dotP (vecScale b v) (vecScale b v) := by
    rw [dotP_swapMap, dotP_comm, dotP_swapMap, BPair.swap_swap]
  have hQQ : (dotP ((vecScale b v).map BPair.swap)
        ((vecScale b v).map BPair.swap)).oneValue ((b * b) * dotP v v) := by
    rw [hQQe]
    exact dotP_scale_self b v
  have hPv : (dotP (vecScale a u) v).oneValue (a * dotP u v) := by
    rw [dotP_comm (vecScale a u) v, dotP_comm u v]
    exact dotP_vecScale_right v u a
  have hcross : (dotP (vecScale a u) (vecScale b v)).oneValue
      ((a * b) * dotP u v) := by
    refine BPair.oneValue_trans
      (dotP_vecScale_right (vecScale a u) v b) ?_
    refine BPair.oneValue_trans
      (BPair.mul_congr (BPair.oneValue_refl b) hPv) ?_
    refine BPair.oneValue_of_eq ?_
    rw [← BPair.mul_assoc, BPair.mul_comm b a]
  have hPQv : (dotP (vecScale a u) ((vecScale b v).map BPair.swap)).oneValue
      (((a * b) * dotP u v).swap) :=
    BPair.oneValue_trans
      (BPair.oneValue_of_eq (dotP_swapMap (vecScale a u) (vecScale b v)))
      (ground.swap_congr hcross)
  have hV : (((a * b) * dotN u v).scale 2).swap
      = ((a * b) * dotN u v).swap + ((a * b) * dotN u v).swap := by
    rw [BPair.scale_two, BPair.swap_add]
  have hTarget : ((a * a) * dotN u u + (b * b) * dotN v v
        + (((a * b) * dotN u v).scale 2).swap).oneValue
      ((a * a) * dotP u u + (b * b) * dotP v v
        + (((a * b) * dotP u v).swap + ((a * b) * dotP u v).swap)) := by
    rw [hV]
    exact BPair.add_congr
      (BPair.add_congr
        (BPair.mul_congr (BPair.oneValue_refl _) (dotN_read u u))
        (BPair.mul_congr (BPair.oneValue_refl _) (dotN_read v v)))
      (BPair.add_congr
        (ground.swap_congr
          (BPair.mul_congr (BPair.oneValue_refl _) (dotN_read u v)))
        (ground.swap_congr
          (BPair.mul_congr (BPair.oneValue_refl _) (dotN_read u v))))
  have hunit : BPair.unit
      ≤ dotN (vecAdd (vecScale a u) ((vecScale b v).map BPair.swap))
          (vecAdd (vecScale a u) ((vecScale b v).map BPair.swap)) :=
    ground.leB_of_not_lt (dotN_self_side _)
  have hchain : (dotN (vecAdd (vecScale a u)
          ((vecScale b v).map BPair.swap))
        (vecAdd (vecScale a u) ((vecScale b v).map BPair.swap))).oneValue
      ((a * a) * dotN u u + (b * b) * dotN v v
        + (((a * b) * dotN u v).scale 2).swap) :=
    BPair.oneValue_trans
      (BPair.oneValue_trans (dotN_read _ _)
        (BPair.oneValue_trans
          (dotP_polar_expand (vecScale a u)
            ((vecScale b v).map BPair.swap) hPQ)
          (BPair.add_congr
            (BPair.add_congr (dotP_scale_self a u) hQQ)
            (BPair.add_congr hPQv hPQv))))
      (BPair.oneValue_symm hTarget)
  exact ground.leB_of_unit_add (ground.leB_congr_right hchain hunit)

/-! The orthogonal tier's reads: independence from pairwise
perpendicularity at off-unit members, the vacant span's unit read,
and the pairing's transpose adjoint — the string exhaustion's
consumption. -/

/-- A pairwise perpendicular list of off-unit members is
independent: a combination's pairing against each member collapses
to the member's own coefficient at its self-pairing, the positive
pairing clearing it. -/
theorem indep_of_orth (n : Nat) (L : Mat) (hLn : rowsLen n L)
    (horth : ∀ p q, p < L.length → q < L.length → ¬ p = q →
      (dotP (ground.getAt [] L p)
        (ground.getAt [] L q)).oneValue BPair.unit)
    (hoff : ∀ p, p < L.length →
      ¬ poly.unitTail (ground.getAt [] L p)) :
    indepRows n L := by
  refine indep_intro n L hLn ?_
  intro cs hcl hnull
  refine unitTail_of_getAt cs (fun p hp => ?_)
  rw [hcl] at hp
  have hrp : (ground.getAt [] L p).length = n :=
    rowsLen_getAt L p hLn hp
  have hM : (L.map (fun row =>
      dotP (ground.getAt [] L p) row)).length = L.length :=
    ground.length_map _ L
  have hpair : (dotP cs (L.map (fun row =>
      dotP (ground.getAt [] L p) row))).oneValue BPair.unit :=
    BPair.oneValue_trans
      (BPair.oneValue_symm
        (dotP_combo cs L (ground.getAt [] L p) n hLn))
      (dotP_null_right (ground.getAt [] L p) (combo n cs L)
        (fun i _ => poly.getAt_unitTail hnull i))
  have hentry : ∀ q, q < L.length →
      ground.getAt BPair.unit (L.map (fun row =>
        dotP (ground.getAt [] L p) row)) q
        = dotP (ground.getAt [] L p) (ground.getAt [] L q) :=
    fun q hq => ground.getAt_map ([] : List BPair) BPair.unit
      (fun row => dotP (ground.getAt [] L p) row) L q hq
  have hdel := dotP_oneIndex cs
    (L.map (fun row => dotP (ground.getAt [] L p) row)) p
    (by rw [hM, hcl]) (by rw [hM]; exact hp)
    (fun q hq hne => by
      rw [hM] at hq
      rw [hentry q hq]
      exact horth p q hp hq (fun hb => hne hb.symm))
  have hprod := BPair.oneValue_trans
    (BPair.oneValue_symm hdel) hpair
  rw [hentry p hp] at hprod
  have hself : ¬ (dotP (ground.getAt [] L p)
      (ground.getAt [] L p)).oneValue BPair.unit :=
    fun hbad => hoff p hp (dotP_self_null _ hbad)
  refine mul_cancel_unit hself ?_
  rw [BPair.mul_comm (dotP (ground.getAt [] L p)
    (ground.getAt [] L p)) (ground.getAt BPair.unit cs p)]
  exact hprod

/-- A member of the vacant list's span reads the unit tail,
`spanRel_unit_of_units` at the row-free carrier. -/
theorem spanRel_nil_unit (n : Nat) (v : List BPair)
    (h : spanRel n ([] : Mat) v) : poly.unitTail v :=
  spanRel_unit_of_units n ([] : Mat) v
    (fun k hk => absurd hk (Nat.not_lt_zero k)) h

/-- The pairing's transpose adjoint: the mapped vector against a
list reads the vector against the transpose's action. -/
theorem dotP_matVec_transpose (n : Nat) (T : Mat) (x y : List BPair)
    (hT : rowsLen n T) (hx : x.length = n) (hy : y.length = T.length) :
    (dotP (matVec T x) y).oneValue
      (dotP x (matVec (transposeM T) y)) := by
  match T, hT, hy with
  | [], _, hy0 =>
    match y, hy0 with
    | [], _ =>
      show (dotP ([] : List BPair) ([] : List BPair)).oneValue
        (dotP x (matVec (transposeM ([] : Mat)) []))
      rw [show matVec (transposeM ([] : Mat)) [] = [] from rfl,
        dotP_nil_right x]
      exact BPair.oneValue_refl _
    | _ :: _, hbad => nomatch hbad
  | r :: t, hT0, hy0 =>
    have hTt : (transposeM (r :: t)).length = n :=
      length_transposeM (r :: t) hT0 (Nat.succ_pos _)
    have hlen : (combo n y (r :: t)).length
        = (matVec (transposeM (r :: t)) y).length := by
      rw [length_combo n y (r :: t) hT0, matVec_length, hTt]
    have hpoly : poly.oneValue (combo n y (r :: t))
        (matVec (transposeM (r :: t)) y) :=
      poly.oneValue_symm
        (matVec_transpose_combo n (r :: t) y hT0 hy0)
    exact BPair.oneValue_trans
      (BPair.oneValue_of_eq (dotP_comm (matVec (r :: t) x) y))
      (BPair.oneValue_trans
        (dotP_matVec n y (r :: t) x hT0 hx hy0)
        (BPair.oneValue_trans
          (BPair.oneValue_of_eq
            (dotP_comm (combo n y (r :: t)) x))
          (dotP_congr_right x _ _ hlen
            (fun i _ => poly.oneValue_getAt i hpoly))))

/-! The action's one-value tier and the orthogonal family's join
(`lem:strings`' consumption): the pairing's two `poly.oneValue`
congruences off its unit-tail null reads, the action at unit rows
and at a one-value matrix, the combination's null pairing with the
perpendicular's span read, the memberwise swap read as a scale, the
residual and the span's transitivity at a listed second family, and
the pairwise-perpendicular predicate with its join and its
one-member read. -/

/-- The pairing reads one value in its right member. -/
theorem dotP_oneValue_right : ∀ (p u u' : List BPair),
    poly.oneValue u u' → (dotP p u).oneValue (dotP p u')
  | [], _, _, _ => BPair.oneValue_refl _
  | _ :: _, [], [], _ => BPair.oneValue_refl _
  | a :: s, [], d :: q, h =>
    BPair.oneValue_symm
      (unitAdd (oneValue_mul_unit a d h.1)
        (dotP_null_tail_right s q h.2))
  | a :: s, c :: p, [], h =>
    unitAdd (oneValue_mul_unit a c h.1)
      (dotP_null_tail_right s p h.2)
  | a :: s, _ :: p, _ :: q, h =>
    BPair.add_congr (BPair.mul_congr (BPair.oneValue_refl a) h.1)
      (dotP_oneValue_right s p q h.2)

/-- The pairing reads one value in its left member. -/
theorem dotP_oneValue_left : ∀ (r s x : List BPair),
    poly.oneValue r s → (dotP r x).oneValue (dotP s x)
  | [], [], _, _ => BPair.oneValue_refl _
  | [], _ :: _, [], _ => BPair.oneValue_refl _
  | [], _ :: q, _ :: t, h =>
    BPair.oneValue_symm
      (unitAdd (oneValue_unit_mul h.1)
        (dotP_null_tail_left q t h.2))
  | _ :: _, [], [], _ => BPair.oneValue_refl _
  | _ :: p, [], _ :: t, h =>
    unitAdd (oneValue_unit_mul h.1)
      (dotP_null_tail_left p t h.2)
  | _ :: _, _ :: _, [], _ => BPair.oneValue_refl _
  | _ :: p, _ :: q, e :: t, h =>
    BPair.add_congr (BPair.mul_congr h.1 (BPair.oneValue_refl e))
      (dotP_oneValue_left p q t h.2)

/-! The pairing's fold against its termwise reads at two clearings:
a termwise at-or-below read carries to the fold, an equal-membered
fold reads every term equal-membered inside both lists' order, and
a fold strictly above the sum's unit at termwise at-or-above
products carries such a product (`def:elim`'s pairing tier). -/

/-- The fold's at-or-below read at two clearings under a termwise
at-or-below read: every term inside the left orders compares at the
stated clearings, each side's fold at its own right carrier. -/
theorem dotP_le_of_leTerm (gn gd : Pos) : ∀ (a w b v : List BPair),
    a.length = b.length →
    (∀ j, j < a.length →
      ((ground.getAt BPair.unit a j * ground.getAt BPair.unit w j).scale gn)
        ≤ ((ground.getAt BPair.unit b j
            * ground.getAt BPair.unit v j).scale gd)) →
    ((dotP a w).scale gn) ≤ ((dotP b v).scale gd)
  | [], _, [], _, _, _ =>
    ground.leB_congr (ground.unitScale gn) (ground.unitScale gd)
      (ground.leB_refl BPair.unit)
  | [], _, _ :: _, _, hl, _ => Nat.noConfusion hl
  | _ :: _, _, [], _, hl, _ => Nat.noConfusion hl
  | _ :: _, [], _ :: _, [], _, _ =>
    ground.leB_congr (ground.unitScale gn) (ground.unitScale gd)
      (ground.leB_refl BPair.unit)
  | d :: a, [], e :: b, x :: v, hl, h => by
    show ((dotP (d :: a) []).scale gn) ≤ ((e * x + dotP b v).scale gd)
    rw [dotP_nil_right, BPair.scale_add]
    have h0 : (BPair.unit.scale gn) ≤ ((e * x).scale gd) :=
      ground.leB_congr_left
        (BPair.scale_congr gn (BPair.mul_unit d)) (h 0 (Nat.succ_pos _))
    have hrec := dotP_le_of_leTerm gn gd a [] b v (Nat.succ.inj hl)
      (fun j hj => h (j + 1) (Nat.succ_lt_succ hj))
    rw [dotP_nil_right] at hrec
    refine ground.leB_congr_left ?_ (ground.leB_add h0 hrec)
    exact BPair.oneValue_trans
      (BPair.oneValue_of_eq (BPair.scale_add BPair.unit BPair.unit gn).symm)
      (BPair.scale_congr gn (BPair.add_unit BPair.unit))
  | d :: a, y :: w, e :: b, [], hl, h => by
    show ((d * y + dotP a w).scale gn) ≤ ((dotP (e :: b) []).scale gd)
    rw [dotP_nil_right, BPair.scale_add]
    have h0 : ((d * y).scale gn) ≤ (BPair.unit.scale gd) :=
      ground.leB_congr_right
        (BPair.scale_congr gd (BPair.mul_unit e)) (h 0 (Nat.succ_pos _))
    have hrec := dotP_le_of_leTerm gn gd a w b [] (Nat.succ.inj hl)
      (fun j hj => h (j + 1) (Nat.succ_lt_succ hj))
    rw [dotP_nil_right] at hrec
    refine ground.leB_congr_right ?_ (ground.leB_add h0 hrec)
    exact BPair.oneValue_trans
      (BPair.oneValue_of_eq (BPair.scale_add BPair.unit BPair.unit gd).symm)
      (BPair.scale_congr gd (BPair.add_unit BPair.unit))
  | d :: a, y :: w, e :: b, x :: v, hl, h => by
    show ((d * y + dotP a w).scale gn) ≤ ((e * x + dotP b v).scale gd)
    rw [BPair.scale_add, BPair.scale_add]
    exact ground.leB_add (h 0 (Nat.succ_pos _))
      (dotP_le_of_leTerm gn gd a w b v (Nat.succ.inj hl)
        (fun j hj => h (j + 1) (Nat.succ_lt_succ hj)))

/-- The fold's equal-membered read at two clearings under a
termwise at-or-below read is termwise: every term inside both
lists' order reads equal members at the two clearings. -/
theorem dotP_eq_of_leTerm (gn gd : Pos) : ∀ (a b w : List BPair),
    a.length = b.length →
    (∀ j, j < a.length →
      ((ground.getAt BPair.unit a j * ground.getAt BPair.unit w j).scale gn)
        ≤ ((ground.getAt BPair.unit b j
            * ground.getAt BPair.unit w j).scale gd)) →
    ((dotP a w).scale gn).oneValue ((dotP b w).scale gd) →
    ∀ j, j < a.length → j < w.length →
      ((ground.getAt BPair.unit a j
          * ground.getAt BPair.unit w j).scale gn).oneValue
        ((ground.getAt BPair.unit b j
            * ground.getAt BPair.unit w j).scale gd)
  | [], [], _, _, _, _, j, hj, _ => absurd hj (Nat.not_lt_zero j)
  | [], _ :: _, _, hl, _, _, _, _, _ => Nat.noConfusion hl
  | _ :: _, [], _, hl, _, _, _, _, _ => Nat.noConfusion hl
  | _ :: _, _ :: _, [], _, _, _, j, _, hjw => absurd hjw (Nat.not_lt_zero j)
  | d :: a, e :: b, x :: w, hl, hle, he, j, hj, hjw => by
    have hs : ((d * x).scale gn + (dotP a w).scale gn).oneValue
        ((e * x).scale gd + (dotP b w).scale gd) := by
      rw [← BPair.scale_add, ← BPair.scale_add]
      exact he
    have h0 : ((d * x).scale gn) ≤ ((e * x).scale gd) :=
      hle 0 (Nat.succ_pos _)
    have htl : ((dotP a w).scale gn) ≤ ((dotP b w).scale gd) :=
      dotP_le_of_leTerm gn gd a w b w (Nat.succ.inj hl)
        (fun k hk => hle (k + 1) (Nat.succ_lt_succ hk))
    have hsplit := ground.addOneValue_of_le h0 htl hs
    match j, hj, hjw with
    | 0, _, _ => exact hsplit.1
    | i + 1, hji, hjwi =>
      exact dotP_eq_of_leTerm gn gd a b w (Nat.succ.inj hl)
        (fun k hk => hle (k + 1) (Nat.succ_lt_succ hk)) hsplit.2 i
        (Nat.lt_of_succ_lt_succ hji) (Nat.lt_of_succ_lt_succ hjwi)

/-- A termwise at-or-above-unit read at the pairing's products
carries to the fold. -/
private theorem dotP_unitLe : ∀ (a w : List BPair),
    (∀ j, j < a.length →
      BPair.unit ≤ ground.getAt BPair.unit a j * ground.getAt BPair.unit w j) →
    BPair.unit ≤ dotP a w
  | [], _, _ => ground.leB_refl BPair.unit
  | _ :: _, [], _ => ground.leB_refl BPair.unit
  | d :: a, x :: w, h => by
    show BPair.unit ≤ d * x + dotP a w
    exact ground.unitLeAdd (h 0 (Nat.succ_pos _))
      (dotP_unitLe a w (fun j hj => h (j + 1) (Nat.succ_lt_succ hj)))

/-- A fold strictly above the sum's unit at termwise at-or-above
products carries a product strictly above it inside both lists'
order. -/
theorem dotP_pos_mem : ∀ (a w : List BPair),
    (∀ j, j < a.length →
      BPair.unit ≤ ground.getAt BPair.unit a j * ground.getAt BPair.unit w j) →
    BPair.unit < dotP a w →
    ∃ j, j < a.length ∧ j < w.length
      ∧ BPair.unit < ground.getAt BPair.unit a j * ground.getAt BPair.unit w j
  | [], _, _, hp =>
    absurd hp (ground.leB_not_lt (ground.leB_refl BPair.unit))
  | _ :: _, [], _, hp =>
    absurd hp (ground.leB_not_lt (ground.leB_refl BPair.unit))
  | d :: a, x :: w, h, hp => by
    have hsplit := ground.posOfAddPos (h 0 (Nat.succ_pos _))
      (dotP_unitLe a w (fun j hj => h (j + 1) (Nat.succ_lt_succ hj)))
      (show BPair.unit < d * x + dotP a w from hp)
    match hsplit with
    | Or.inl h0 => exact ⟨0, Nat.succ_pos _, Nat.succ_pos _, h0⟩
    | Or.inr ht =>
      obtain ⟨j, hj, hjw, hpos⟩ := dotP_pos_mem a w
        (fun k hk => h (k + 1) (Nat.succ_lt_succ hk)) ht
      exact ⟨j + 1, Nat.succ_lt_succ hj, Nat.succ_lt_succ hjw, hpos⟩

/-- The matrix action rowwise, the plain fold's map. -/
theorem matVec_dotPmap : ∀ (M : Mat) (v : List BPair),
    poly.oneValue (matVec M v) (M.map (fun r => dotP r v))
  | [], _ => trivial
  | r :: t, v => ⟨dotN_read r v, matVec_dotPmap t v⟩

/-- The skipping quadratic form reads the plain one. -/
theorem quadP_read (M : Mat) (c : List BPair) :
    (dotN c (matVec M c)).oneValue (dotP c (M.map (fun r => dotP r c))) :=
  BPair.oneValue_trans (dotN_read c (matVec M c))
    (dotP_oneValue_right c _ _ (matVec_dotPmap M c))

/-- The action of a matrix whose every row is a unit tail is a unit
tail, at every vector. -/
theorem matVec_unitRows :
    ∀ (M : Mat) (x : List BPair),
      (∀ p, p < M.length →
        poly.unitTail (ground.getAt ([] : List BPair) M p)) →
      poly.unitTail (matVec M x)
  | [], _, _ => trivial
  | r :: t, x, hM =>
    ⟨BPair.oneValue_trans (dotN_read r x)
        (dotP_null_tail_left r x (hM 0 (Nat.succ_pos _))),
     matVec_unitRows t x
       (fun p hp => hM (p + 1) (Nat.succ_lt_succ hp))⟩

/-- The seed matrix is null at every vector: every row is the unit
family, so every fold sits at the sum's unit. -/
theorem matVec_replicate_null (n m : Nat) (x : List BPair) :
    poly.unitTail
      (matVec (List.replicate m (List.replicate n BPair.unit)) x) :=
  matVec_unitRows _ x (fun p hp => by
    rw [ground.length_replicate] at hp
    rw [ground.getAt_replicate ([] : List BPair) _ m p hp]
    exact poly.unitTail_replicate n)

/-- Two matrices reading one value act alike on every vector. -/
theorem matVec_matOne :
    ∀ (A B : Mat) (x : List BPair),
      matOneValue A B →
      poly.oneValue (matVec A x) (matVec B x)
  | [], [], _, _ => trivial
  | [], _ :: _, _, h => h.elim
  | _ :: _, [], _, h => h.elim
  | r :: a, s :: b, x, h =>
    ⟨BPair.oneValue_trans (dotN_read r x)
       (BPair.oneValue_trans (dotP_oneValue_left r s x h.1)
         (BPair.oneValue_symm (dotN_read s x))),
     matVec_matOne a b x h.2⟩

/-- A symmetric datum walks across the pairing. -/
theorem dotP_matVec_sym {n : Nat} (M : Mat) (hM : sqAt M n)
    (hsym : matOneValue (transposeM M) M)
    (x y : List BPair) (hx : x.length = n) (hy : y.length = n) :
    (dotP (matVec M x) y).oneValue (dotP x (matVec M y)) := by
  refine BPair.oneValue_trans
    (dotP_matVec_transpose n M x y (rowsLen_of_sqAt hM) hx
      (by rw [sqAt_len hM]; exact hy)) ?_
  exact dotP_oneValue_right x _ _ (matVec_matOne _ _ y hsym)

/-- A vector perpendicular to every row of a family is
perpendicular to every combination of them. -/
theorem dotP_comboNull (n : Nat) (y : List BPair)
    (hy : y.length = n) :
    ∀ (cs : List BPair) (M : Mat), rowsLen n M →
      (∀ k, k < M.length →
        (dotP y (ground.getAt [] M k)).oneValue BPair.unit) →
      (dotP y (combo n cs M)).oneValue BPair.unit
  | [], _, _, _ => dotP_repl_unit y n
  | _ :: _, [], _, _ => dotP_repl_unit y n
  | c :: cs, r :: M, hM, hp => by
    show (dotP y (vecAdd (vecScale c r) (combo n cs M))).oneValue
      BPair.unit
    refine BPair.oneValue_trans
      (dotP_vecAdd y (vecScale c r) (combo n cs M)
        (by rw [length_vecScale, hM.1, hy])
        (by rw [length_combo n cs M hM.2, hy])) ?_
    refine BPair.oneValue_trans (BPair.add_congr ?_
      (dotP_comboNull n y hy cs M hM.2
        (fun k hk => hp (k + 1) (Nat.succ_lt_succ hk))))
      (BPair.unit_add BPair.unit)
    refine BPair.oneValue_trans (dotP_vecScale_right y r c) ?_
    exact oneValue_mul_unit c (dotP y r) (hp 0 (Nat.succ_pos _))

/-- The residual keeps a stated perpendicular row: the residual's
join splits the pairing (`dotP_vecAdd`), the scaled vector
reads the stated pairing multiplied and the swapped combination
reads the collected rows' own pairings, each at the sum's unit
(`dotP_comboNull`), so the join sits there. -/
theorem resid_perp_ext (n : Nat) (C : Mat)
    (v r : List BPair) (hC : rowsLen n C)
    (hv : v.length = n) (hr : r.length = n)
    (hvr : (dotP v r).oneValue BPair.unit)
    (hCr : ∀ k, k < C.length →
      (dotP (ground.getAt [] C k) r).oneValue BPair.unit) :
    (dotP (residV n C v) r).oneValue BPair.unit := by
  have hrv : (dotP r v).oneValue BPair.unit := by
    rw [dotP_comm]
    exact hvr
  have hrC : ∀ k, k < C.length →
      (dotP r (ground.getAt [] C k)).oneValue BPair.unit := by
    intro k hk
    rw [dotP_comm]
    exact hCr k hk
  rw [dotP_comm]
  show (dotP r (vecAdd
      (vecScale (detL (gramM C)) v)
      ((combo n (adjP (gramM C)
        (C.map (fun s => dotP s v))) C).map
        BPair.swap))).oneValue BPair.unit
  refine BPair.oneValue_trans (dotP_vecAdd r _ _ ?_ ?_) ?_
  · rw [length_vecScale, hv, hr]
  · rw [ground.length_map, length_combo _ _ _ hC, hr]
  · refine BPair.oneValue_trans (BPair.add_congr ?_ ?_)
      (BPair.unit_add BPair.unit)
    · exact BPair.oneValue_trans
        (dotP_vecScale_right r v (detL (gramM C)))
        (oneValue_mul_unit _ _ hrv)
    · rw [dotP_swapMap]
      exact ground.swap_congr
        (dotP_comboNull n r hr _ C hC hrC)

/-- A vector perpendicular to every row of a family is
perpendicular to every member of its span. -/
theorem perp_span (n : Nat) (M : Mat) (y x : List BPair)
    (hM : rowsLen n M) (hy : y.length = n)
    (hperp : ∀ k, k < M.length →
      (dotP y (ground.getAt [] M k)).oneValue BPair.unit)
    (hsp : spanRel n M x) :
    (dotP y x).oneValue BPair.unit := by
  obtain ⟨c0, cs, hc0, _, hone⟩ := span_elim hsp
  refine mul_cancel_unit hc0 ?_
  refine BPair.oneValue_trans
    (BPair.oneValue_symm (dotP_vecScale_right y x c0)) ?_
  exact BPair.oneValue_trans
    (dotP_oneValue_right y (vecScale c0 x) (combo n cs M) hone)
    (dotP_comboNull n y hy cs M hM hperp)

private def swapCoef : BPair := ⟨Pos.one, Pos.one + Pos.one⟩

private theorem swap_scale_read (x : BPair) :
    (x.swap).oneValue (swapCoef * x) := by
  show x.snd + (Pos.one * x.snd + (Pos.one + Pos.one) * x.fst)
    = (Pos.one * x.fst + (Pos.one + Pos.one) * x.snd) + x.fst
  rw [ground.one_mul, ground.one_mul, ground.right_distrib,
    ground.right_distrib, ground.one_mul, ground.one_mul,
    ← ground.add_assoc x.snd x.snd (x.fst + x.fst),
    ground.add_comm x.fst (x.snd + x.snd),
    ground.add_assoc (x.snd + x.snd) x.fst x.fst]

/-- The memberwise swap of a vector is that vector scaled by a
fixed off-unit datum, the swap read inside the span arithmetic. -/
theorem swapMap_scale : ∀ u : List BPair,
    poly.oneValue (u.map BPair.swap) (vecScale swapCoef u)
  | [] => trivial
  | a :: t => ⟨swap_scale_read a, swapMap_scale t⟩

/-- The residual of a family inside a second family's span stays
in that span. -/
theorem spanRel_residV (n : Nat) (L M : Mat)
    (v : List BPair) (hLn : rowsLen n L) (hv : v.length = n)
    (hMn : rowsLen n M)
    (hLsp : ∀ k, k < L.length →
      spanRel n M (ground.getAt [] L k))
    (hvsp : spanRel n M v) :
    spanRel n M (residV n L v) := by
  have hco : spanRel n M
      (combo n (adjP (gramM L)
        (L.map (fun r => dotP r v))) L) :=
    spanRel_combo n M hMn L _ hLn hLsp
  refine spanRel_add n M _ _ hMn ?_ ?_
    (spanRel_scale n M v _ hMn hv hvsp) ?_
  · rw [length_vecScale]
    exact hv
  · rw [ground.length_map, length_combo n _ L hLn]
  · refine spanRel_congr n M _ _
      (poly.oneValue_symm (swapMap_scale _)) ?_
      (by rw [ground.length_map, length_combo n _ L hLn])
    exact spanRel_scale n M _ swapCoef hMn
      (length_combo n _ L hLn) hco

/-- The span's transitivity: a member of a family's span whose
every row sits in a second family's span sits in that span. -/
theorem spanRel_trans (n : Nat) (G M : Mat)
    (x : List BPair) (hG : rowsLen n G) (hM : rowsLen n M)
    (hrows : ∀ k, k < G.length →
      spanRel n M (ground.getAt [] G k))
    (h : spanRel n G x) : spanRel n M x :=
  span_intro n M x hM h.2.1
    (spanE_trans n G M x hG hM
      (fun k hk => span_elim (hrows k hk)) (span_elim h))

/-- A shared summand cancels on the right of a memberwise sum. -/
theorem vecAdd_cancel_right : ∀ (A B S : List BPair),
    A.length = B.length → A.length = S.length →
    poly.oneValue (vecAdd A S) (vecAdd B S) →
    poly.oneValue A B
  | [], [], _, _, _, _ => trivial
  | [], _ :: _, _, hl, _, _ => Nat.noConfusion hl
  | _ :: _, [], _, hl, _, _ => Nat.noConfusion hl
  | _ :: _, _ :: _, [], _, hs, _ => Nat.noConfusion hs
  | _ :: A, _ :: B, _ :: S, hl, hs, h =>
    ⟨ground.BPair.add_cancel h.1,
     vecAdd_cancel_right A B S (Nat.succ.inj hl)
       (Nat.succ.inj hs) h.2⟩

/-- A memberwise sum reads one value in its left summand. -/
theorem vecAdd_congr : ∀ (A B S : List BPair),
    A.length = B.length → poly.oneValue A B →
    poly.oneValue (vecAdd A S) (vecAdd B S)
  | [], [], _, _, _ => trivial
  | [], _ :: _, _, hl, _ => Nat.noConfusion hl
  | _ :: _, [], _, hl, _ => Nat.noConfusion hl
  | _ :: _, _ :: _, [], _, _ => trivial
  | _ :: A, _ :: B, s :: S, hl, hh =>
    ⟨BPair.add_congr hh.1 (BPair.oneValue_refl s),
     vecAdd_congr A B S (Nat.succ.inj hl) hh.2⟩

/-- The memberwise sum carries a one-value read in both summands. -/
theorem vecAdd_congr2 (A A' B B' : List BPair)
    (hA : A.length = A'.length) (hB : B.length = B'.length)
    (h1 : poly.oneValue A A') (h2 : poly.oneValue B B') :
    poly.oneValue (vecAdd A B) (vecAdd A' B') := by
  refine poly.oneValue_trans (vecAdd_congr A A' B hA h1) ?_
  rw [vecAdd_comm A' B, vecAdd_comm A' B']
  exact vecAdd_congr B B' A' hB h2

/-- The cleared member reads its residual joined to the projection
combination — `residV`'s defining join read back, `lem:lowerspan`'s
solve identity. -/
theorem residV_expand (n : Nat) (L : Mat) (v : List BPair)
    (hLn : rowsLen n L) (hv : v.length = n) :
    poly.oneValue (vecScale (detL (gramM L)) v)
      (vecAdd (residV n L v)
        (combo n (adjP (gramM L)
          (L.map (fun r => dotP r v))) L)) := by
  have hS : (vecScale (detL (gramM L)) v).length = n := by
    rw [length_vecScale, hv]
  have hC : (combo n (adjP (gramM L)
      (L.map (fun r => dotP r v))) L).length = n :=
    length_combo n (adjP (gramM L) (L.map (fun r => dotP r v))) L hLn
  have hCs : ((combo n (adjP (gramM L)
      (L.map (fun r => dotP r v))) L).map BPair.swap).length = n := by
    rw [ground.length_map]
    exact hC
  have hR : (residV n L v).length = n := length_residV n L v hLn hv
  refine poly.oneValue_of_entries _ _
    (by rw [hS, length_vecAdd _ _ n hR hC]) ?_
  intro i hi
  rw [hS] at hi
  rw [getAt_vecAdd (residV n L v)
      (combo n (adjP (gramM L) (L.map (fun r => dotP r v))) L) i
      (by rw [hR]; exact hi) (by rw [hC]; exact hi),
    show residV n L v
        = vecAdd (vecScale (detL (gramM L)) v)
          ((combo n (adjP (gramM L)
            (L.map (fun r => dotP r v))) L).map BPair.swap) from rfl,
    getAt_vecAdd (vecScale (detL (gramM L)) v)
      ((combo n (adjP (gramM L)
        (L.map (fun r => dotP r v))) L).map BPair.swap) i
      (by rw [hS]; exact hi) (by rw [hCs]; exact hi),
    ground.getAt_map BPair.unit BPair.unit BPair.swap
      (combo n (adjP (gramM L) (L.map (fun r => dotP r v))) L) i
      (by rw [hC]; exact hi),
    BPair.add_assoc]
  exact BPair.oneValue_symm
    (BPair.oneValue_trans
      (BPair.add_congr (BPair.oneValue_refl _)
        (BPair.swap_add_null (BPair.oneValue_refl _)))
      (BPair.add_unit _))

/-- A span member is kept under the grown list — here the rows join
in front, the combination padded by the sum's unit at the leading
rows. -/
theorem spanRel_mono_left (n : Nat) (L M : Mat) (v : List BPair)
    (hL : rowsLen n L) (hM : rowsLen n M)
    (h : spanRel n M v) : spanRel n (L ++ M) v := by
  obtain ⟨c₀, cs, hc₀, hcl, hone⟩ := span_elim h
  refine span_intro n (L ++ M) v (rowsLen_append n hL hM) h.2.1
    ⟨c₀, List.replicate L.length BPair.unit ++ cs, hc₀, ?_, ?_⟩
  · rw [ground.length_append, ground.length_append,
      ground.length_replicate, hcl]
  · refine poly.oneValue_trans hone (poly.oneValue_symm ?_)
    refine poly.oneValue_trans
      (combo_append n (List.replicate L.length BPair.unit) L cs M
        (ground.length_replicate BPair.unit L.length) hL hM) ?_
    exact vecAdd_null_left _ _
      (by rw [length_combo n (List.replicate L.length BPair.unit) L hL,
        length_combo n cs M hM])
      (combo_unitsT n L L.length)

/-! The kernel tier: the back solve mirroring the descent's own
recursion (`def:elim` — "the kernel list enters per pivot-free column
by the back solve: at the terminal step every entry reads equal
members and the unit family with one at the column's own key seeds
the member, each earlier step extending at the pivot's clearing").
The terminal seed is the unit family at the column's own key; a
round's extension scales the stepped member by the pivot and enters
the pivot coordinate as the stepped pivot row's read of the member,
that read's balance partner, placed at the pivot column — the column
exchanges' stated permutation of the coordinates. -/

/-- The list grown by one entry at a stated place: the entry in
front at place nought, and past the tail's end at the tail. -/
private def insertAt {α : Type} (x : α) : List α → Nat → List α
  | l, 0 => x :: l
  | [], _ + 1 => [x]
  | h :: t, n + 1 => h :: insertAt x t n

/-- A sparse row's dense reading at a stated width. -/
private def denseRow (w : Nat) (r : SRow) : List BPair :=
  (List.range w).map (fun c => ground.keyAt Nat.beq BPair.unit c r.2)

/-- The identity datum at a stated width: one row per column key,
the unit family with one at its own key — the back solve's terminal
seed and the identity family's matrix. -/
def idList (w : Nat) : List (List BPair) :=
  (List.range w).map (fun c =>
    List.set (List.replicate w BPair.unit) c (BPair.ofPos .one))

/-- The back solve, mirroring `sdescend`'s recursion round for
round: at the terminal step the unit families, and across a round
the stepped members extended at the pivot's clearing — scaled by the
pivot, the pivot coordinate the stepped pivot row's read's balance
partner at the pivot column. -/
private def kernelGo (fuel w : Nat) (prev : BPair)
    (rows : List SRow) : List (List BPair) :=
  descGo idList
    (fun w j p K =>
      let t := denseRow (w - 1) p.2
      K.map (fun v =>
        insertAt ((dotN t v).swap) (vecScale p.1 v) j))
    fuel w prev rows

/-- The kernel list at the stated column-key count: the back
solve's members, one per pivot-free column. -/
def kernelList (cols : Nat) (m : Mat) : List (List BPair) :=
  kernelGo m.length cols (BPair.ofPos .one) (m.map ofRow)

/-- The grown list's width: one place past the list's own. -/
private theorem length_insertAt {α : Type} (x : α) :
    ∀ (l : List α) (n : Nat), (insertAt x l n).length = l.length + 1
  | [], 0 => rfl
  | _ :: _, 0 => rfl
  | [], _ + 1 => rfl
  | _ :: t, n + 1 => congrArg Nat.succ (length_insertAt x t n)

/-- A width the rounds exhaust empties the back solve: the terminal
seed is the empty family and every round's map keeps it. -/
private theorem kernelGo_w0 : ∀ (fuel : Nat) (prev : BPair)
    (rows : List SRow), kernelGo fuel 0 prev rows = []
  | 0, _, _ => rfl
  | fuel + 1, prev, rows => by
    show (match sFind rows with
      | none => idList 0
      | some (i, j) =>
        let p := sPeel j (ground.getAt ((0, []) : SRow) rows i)
        let t := denseRow (0 - 1) p.2
        (kernelGo fuel (0 - 1) p.1
            (stepRows prev p j (rows.eraseIdx i))).map
          (fun v => insertAt ((dotN t v).swap) (vecScale p.1 v) j))
      = []
    cases hf : sFind rows with
    | none => rfl
    | some ij =>
      show ((kernelGo fuel 0
          (sPeel ij.2 (ground.getAt ((0, []) : SRow) rows ij.1)).1
          (stepRows prev
            (sPeel ij.2 (ground.getAt ((0, []) : SRow) rows ij.1))
            ij.2 (rows.eraseIdx ij.1))).map _) = []
      rw [kernelGo_w0 fuel _ _]
      rfl

/-- The extension keeps the width read: each member grows by exactly
one place, the scaling leaving the member's own width. -/
private theorem rowsLen_extend (w j : Nat) (c : BPair)
    (t : List BPair) : ∀ K : List (List BPair), rowsLen w K →
    rowsLen (w + 1) (K.map
      (fun v => insertAt ((dotN t v).swap) (vecScale c v) j))
  | [], _ => trivial
  | _ :: K, h =>
    ⟨by rw [length_insertAt, length_vecScale, h.1],
      rowsLen_extend w j c t K h.2⟩

/-- The back solve's members sit at the width it is called with:
the terminal seed reads it off the replaced unit family, and a
round's extension grows the round below's width by one place. -/
private theorem kernelGo_rowsLen : ∀ (fuel w : Nat) (prev : BPair)
    (rows : List SRow), rowsLen w (kernelGo fuel w prev rows)
  | 0, w, _, _ =>
    rowsLen_map (fun c => List.set (List.replicate w BPair.unit) c
        (BPair.ofPos .one)) w (List.range w) (fun x _ => (fun _ => by rw [ground.length_set, ground.length_replicate]) x)
  | fuel + 1, 0, prev, rows => by
    rw [kernelGo_w0 (fuel + 1) prev rows]
    exact trivial
  | fuel + 1, w + 1, prev, rows => by
    show rowsLen (w + 1) (match sFind rows with
      | none => idList (w + 1)
      | some (i, j) =>
        let p := sPeel j (ground.getAt ((0, []) : SRow) rows i)
        let t := denseRow (w + 1 - 1) p.2
        (kernelGo fuel (w + 1 - 1) p.1
            (stepRows prev p j (rows.eraseIdx i))).map
          (fun v => insertAt ((dotN t v).swap) (vecScale p.1 v) j))
    cases hf : sFind rows with
    | none =>
      exact rowsLen_map (fun c => List.set (List.replicate (w + 1) BPair.unit) c
          (BPair.ofPos .one)) (w + 1) (List.range (w + 1)) (fun x _ => (fun _ => by rw [ground.length_set, ground.length_replicate]) x)
    | some ij =>
      exact rowsLen_extend w ij.2
        (sPeel ij.2 (ground.getAt ((0, []) : SRow) rows ij.1)).1
        (denseRow w
          (sPeel ij.2 (ground.getAt ((0, []) : SRow) rows ij.1)).2)
        _ (kernelGo_rowsLen fuel w _ _)

/-- The kernel list's members sit at the stated width outright: the
terminal seed reads the width the rounds leave, an extension grows a
member by exactly one place, and a width the rounds exhaust empties
the terminal seed with every map keeping the emptiness. -/
theorem kernelList_rowsLen (cols : Nat) (m : Mat) :
    rowsLen cols (kernelList cols m) :=
  kernelGo_rowsLen m.length cols (BPair.ofPos .one) (m.map ofRow)

/-- The truncation at a unit step splits: a count withdrawn whole
reads the same as the unit withdrawn first and the rest after. -/
private theorem natSubOneJoin : ∀ (n k : Nat),
    n - (1 + k) = n - 1 - k
  | _, 0 => rfl
  | n, k + 1 => congrArg (· - 1) (natSubOneJoin n k)

/-- The back solve's member count is the stated width less the
descent's own pivot count: the terminal seed reads one member per
column key against a pivot count of nought, and a round trades one
stated column for one pivot, the two truncations joining. -/
private theorem kernelGo_length : ∀ (fuel w : Nat) (prev : BPair)
    (rows : List SRow),
    (kernelGo fuel w prev rows).length = w - sdescend fuel prev rows
  | 0, w, _, _ => by
    show ((List.range w).map (fun c =>
        List.set (List.replicate w BPair.unit) c
          (BPair.ofPos .one))).length = w - 0
    rw [ground.length_mapRange, Nat.sub_zero]
  | fuel + 1, w, prev, rows => by
    show (match sFind rows with
        | none => idList w
        | some (i, j) =>
          let p := sPeel j (ground.getAt ((0, []) : SRow) rows i)
          let t := denseRow (w - 1) p.2
          (kernelGo fuel (w - 1) p.1
              (stepRows prev p j (rows.eraseIdx i))).map
            (fun v =>
              insertAt ((dotN t v).swap) (vecScale p.1 v) j)).length
      = w - (match sFind rows with
        | none => 0
        | some (i, j) =>
          let p := sPeel j (ground.getAt ((0, []) : SRow) rows i)
          1 + sdescend fuel p.1
            (stepRows prev p j (rows.eraseIdx i)))
    cases hf : sFind rows with
    | none =>
      show ((List.range w).map (fun c =>
          List.set (List.replicate w BPair.unit) c
            (BPair.ofPos .one))).length = w - 0
      rw [ground.length_mapRange, Nat.sub_zero]
    | some ij =>
      show ((kernelGo fuel (w - 1)
            (sPeel ij.2 (ground.getAt ((0, []) : SRow) rows ij.1)).1
            (stepRows prev
              (sPeel ij.2 (ground.getAt ((0, []) : SRow) rows ij.1))
              ij.2 (rows.eraseIdx ij.1))).map _).length
        = w - (1 + sdescend fuel
            (sPeel ij.2 (ground.getAt ((0, []) : SRow) rows ij.1)).1
            (stepRows prev
              (sPeel ij.2 (ground.getAt ((0, []) : SRow) rows ij.1))
              ij.2 (rows.eraseIdx ij.1)))
      rw [ground.length_map, kernelGo_length fuel (w - 1)
        (sPeel ij.2 (ground.getAt ((0, []) : SRow) rows ij.1)).1
        (stepRows prev
          (sPeel ij.2 (ground.getAt ((0, []) : SRow) rows ij.1))
          ij.2 (rows.eraseIdx ij.1)), natSubOneJoin]

/-- The kernel list's length is the kernel dimension outright, at
every matrix: each round trades one stated column for one pivot,
and the truncated read absorbs a pivot count past the stated
width, the two truncations one arithmetic. -/
theorem kernelList_dim (cols : Nat) (m : Mat) :
    (kernelList cols m).length = kernelDim cols m :=
  kernelGo_length m.length cols (BPair.ofPos .one) (m.map ofRow)

/-- The stored keys sit below the stated bound. -/
private def keysBelow (w : Nat) : List (Nat × BPair) → Prop
  | [] => True
  | (k, _) :: es => k < w ∧ keysBelow w es

/-- The descent state at a stated width: every row's count is the
width with its stored keys below it. -/
private def SInv (w : Nat) : List SRow → Prop
  | [] => True
  | r :: t => (r.1 = w ∧ keysBelow w r.2) ∧ SInv w t

/-- The pivot search answers inside the row list: an unoccupied row
raises the answer's place by one against its own tail, and an
occupied row answers at its own place. -/
private theorem sFind_lt : ∀ (rows : List SRow) (i j : Nat),
    sFind rows = some (i, j) → i < rows.length
  | [], _, _, h => nomatch h
  | (_, []) :: rest, i, j, h => by
    revert h
    show (match sFind rest with
        | none => none
        | some (a, b) => some (a + 1, b)) = some (i, j) →
      i < rest.length + 1
    cases hf : sFind rest with
    | none =>
      intro h
      exact nomatch h
    | some ij =>
      intro h
      have hi : ij.1 + 1 = i :=
        congrArg Prod.fst (Option.some.inj h)
      rw [← hi]
      exact Nat.succ_lt_succ (sFind_lt rest ij.1 ij.2 hf)
  | (_, (k, _) :: _) :: rest, i, j, h => by
    have h' : ((0, k) : Nat × Nat) = (i, j) := Option.some.inj h
    have hi : (0 : Nat) = i := congrArg Prod.fst h'
    rw [← hi]
    exact Nat.zero_lt_succ rest.length

/-- The pivot search's key sits below the stated width: the answer
is the first occupied row's head key, and the invariant bounds that
key at the row's own conjunct. -/
private theorem sFind_key : ∀ (w : Nat) (rows : List SRow)
    (i j : Nat), SInv w rows → sFind rows = some (i, j) → j < w
  | _, [], _, _, _, h => nomatch h
  | w, (c, []) :: rest, i, j, hinv, h => by
    have hh : (c = w ∧ keysBelow w ([] : List (Nat × BPair)))
        ∧ SInv w rest := hinv
    revert h
    show (match sFind rest with
        | none => none
        | some (a, b) => some (a + 1, b)) = some (i, j) → j < w
    cases hf : sFind rest with
    | none =>
      intro h
      exact nomatch h
    | some ij =>
      intro h
      have hj : ij.2 = j := congrArg Prod.snd (Option.some.inj h)
      rw [← hj]
      exact sFind_key w rest ij.1 ij.2 hh.2 hf
  | w, (c, (k, v) :: es) :: rest, i, j, hinv, h => by
    have hh : (c = w ∧ keysBelow w ((k, v) :: es))
        ∧ SInv w rest := hinv
    have hk : k < w ∧ keysBelow w es := hh.1.2
    have h' : ((0, k) : Nat × Nat) = (i, j) := Option.some.inj h
    have hj : k = j := congrArg Prod.snd h'
    rw [← hj]
    exact hk.1

/-- The sparse walk's stored keys sit below its starting key joined
to the entries it walks: a kept key is its own place, below that
join, and each further entry raises the start by one. -/
private theorem keysBelow_ofRowFrom : ∀ (r : List BPair) (k : Nat),
    keysBelow (k + r.length) (ofRowFrom k r)
  | [], _ => trivial
  | e :: es, k => by
    have hib : keysBelow (k + (es.length + 1))
        (ofRowFrom (k + 1) es) := by
      have h := keysBelow_ofRowFrom es (k + 1)
      rw [Nat.succ_add k es.length] at h
      exact h
    show keysBelow (k + (es.length + 1))
      (match (e.norm).isUnitRep with
        | true => ofRowFrom (k + 1) es
        | false => (k, e.norm) :: ofRowFrom (k + 1) es)
    cases hu : (e.norm).isUnitRep with
    | true => exact hib
    | false =>
      exact ⟨Nat.lt_succ_of_le (Nat.le_add_right k es.length), hib⟩

/-- The key bound weakens upward: a stored key below the lesser
bound sits below the greater. -/
private theorem keysBelow_le {v w : Nat} (h : v ≤ w) :
    ∀ es : List (Nat × BPair), keysBelow v es → keysBelow w es
  | [], _ => trivial
  | (k, _) :: es, he => by
    have hh : k < v ∧ keysBelow v es := he
    exact ⟨Nat.lt_of_lt_of_le hh.1 h, keysBelow_le h es hh.2⟩

/-- A framed matrix's sparse reading sits at the invariant: each
row's count is its own length, the frame's stated width, and its
stored keys sit below the length its walk counted, weakened to the
frame. -/
private theorem sInv_ofRow (cols : Nat) : ∀ (m : Mat),
    rowsLen cols m → SInv cols (m.map ofRow)
  | [], _ => trivial
  | r :: t, h => by
    have hr : r.length = cols ∧ rowsLen cols t := h
    refine ⟨⟨hr.1, ?_⟩, sInv_ofRow cols t hr.2⟩
    refine keysBelow_le ?_ (ofRowFrom 0 r) (keysBelow_ofRowFrom r 0)
    show 0 + r.length ≤ cols
    rw [Nat.zero_add]
    exact Nat.le_of_eq hr.1

/-- The invariant survives a struck row: the surviving rows carry
their own reads unchanged. -/
private theorem sInv_eraseIdx (w : Nat) : ∀ (rows : List SRow)
    (i : Nat), SInv w rows → SInv w (rows.eraseIdx i)
  | [], _, _ => trivial
  | r :: t, 0, h => by
    have hh : (r.1 = w ∧ keysBelow w r.2) ∧ SInv w t := h
    exact hh.2
  | r :: t, i + 1, h => by
    have hh : (r.1 = w ∧ keysBelow w r.2) ∧ SInv w t := h
    exact ⟨hh.1, sInv_eraseIdx w t i hh.2⟩

/-- Every key the kept-entry walk stores passed its own bound
guard, so the kept list sits below the bound outright. -/
private theorem keysBelow_keepTail (f : BPair → BPair) (lim : Nat) :
    ∀ es : List (Nat × BPair), keysBelow lim (keepTail f lim es)
  | [] => trivial
  | (k, e) :: es => by
    show keysBelow lim
      (match !(f e).isUnitRep && Nat.blt k lim with
        | true => (k, f e) :: keepTail f lim es
        | false => keepTail f lim es)
    cases hg : !(f e).isUnitRep && Nat.blt k lim with
    | true =>
      exact ⟨bltLt (ground.andSplitB hg).2,
        keysBelow_keepTail f lim es⟩
    | false => exact keysBelow_keepTail f lim es

/-- A join of two bounded key lists is bounded. -/
private theorem keysBelow_append (w : Nat) :
    ∀ a b : List (Nat × BPair), keysBelow w a → keysBelow w b →
      keysBelow w (a ++ b)
  | [], _, _, hb => hb
  | (k, v) :: a, b, ha, hb => by
    have hh : k < w ∧ keysBelow w a := ha
    exact ⟨hh.1, keysBelow_append w a b hh.2 hb⟩

/-- The pivot row's split-off fill-in sits below the bound: every
entry it keeps passed the same bound guard the kept-entry walk
reads, the split's own second component carrying no bound. -/
private theorem keysBelow_fillBelow (prev r0 : BPair) (lim k : Nat) :
    ∀ ps : List (Nat × BPair),
      keysBelow lim (fillBelow prev r0 lim k ps).1
  | [] => trivial
  | (kt, t) :: ps => by
    show keysBelow lim
      (match Nat.blt kt k with
        | false => ([], (kt, t) :: ps)
        | true =>
          match !(fillEntry prev r0 t).isUnitRep
              && Nat.blt kt lim with
          | true => ((kt, fillEntry prev r0 t)
              :: (fillBelow prev r0 lim k ps).1,
            (fillBelow prev r0 lim k ps).2)
          | false => fillBelow prev r0 lim k ps).1
    cases hb : Nat.blt kt k with
    | false => exact trivial
    | true =>
      show keysBelow lim
        (match !(fillEntry prev r0 t).isUnitRep
            && Nat.blt kt lim with
          | true => ((kt, fillEntry prev r0 t)
              :: (fillBelow prev r0 lim k ps).1,
            (fillBelow prev r0 lim k ps).2)
          | false => fillBelow prev r0 lim k ps).1
      cases hg : !(fillEntry prev r0 t).isUnitRep
          && Nat.blt kt lim with
      | true =>
        exact ⟨bltLt (ground.andSplitB hg).2,
          keysBelow_fillBelow prev r0 lim k ps⟩
      | false => exact keysBelow_fillBelow prev r0 lim k ps

/-- The merged row sits below the bound: every entry the merge
keeps — the joint keys, the row's own scaled keys and the pivot
row's fill-in alike — passed the same bound guard, and the split
fill-in joins in front of the recursion's own read. -/
private theorem keysBelow_mergeRow (prev pivot r0 : BPair)
    (lim : Nat) : ∀ (ps es : List (Nat × BPair)),
      keysBelow lim (mergeRow prev pivot r0 lim ps es)
  | ps, [] => keysBelow_keepTail (fillEntry prev r0) lim ps
  | ps, (ke, e) :: es => by
    show keysBelow lim
      (match (fillBelow prev r0 lim ke ps).2 with
        | [] => (fillBelow prev r0 lim ke ps).1
            ++ scaleTail prev pivot lim ((ke, e) :: es)
        | (kt, t) :: pr =>
          match Nat.beq kt ke with
          | true =>
            match !(jointEntry prev pivot t r0 e).isUnitRep
                && Nat.blt ke lim with
            | true => (fillBelow prev r0 lim ke ps).1
                ++ (ke, jointEntry prev pivot t r0 e)
                  :: mergeRow prev pivot r0 lim pr es
            | false => (fillBelow prev r0 lim ke ps).1
                ++ mergeRow prev pivot r0 lim pr es
          | false =>
            match !(scaleEntry prev pivot e).isUnitRep
                && Nat.blt ke lim with
            | true => (fillBelow prev r0 lim ke ps).1
                ++ (ke, scaleEntry prev pivot e)
                  :: mergeRow prev pivot r0 lim ((kt, t) :: pr) es
            | false => (fillBelow prev r0 lim ke ps).1
                ++ mergeRow prev pivot r0 lim ((kt, t) :: pr) es)
    cases hb : (fillBelow prev r0 lim ke ps).2 with
    | nil =>
      exact keysBelow_append lim _ _
        (keysBelow_fillBelow prev r0 lim ke ps)
        (keysBelow_keepTail (scaleEntry prev pivot) lim
          ((ke, e) :: es))
    | cons hd pr =>
      show keysBelow lim
        (match Nat.beq hd.1 ke with
          | true =>
            match !(jointEntry prev pivot hd.2 r0 e).isUnitRep
                && Nat.blt ke lim with
            | true => (fillBelow prev r0 lim ke ps).1
                ++ (ke, jointEntry prev pivot hd.2 r0 e)
                  :: mergeRow prev pivot r0 lim pr es
            | false => (fillBelow prev r0 lim ke ps).1
                ++ mergeRow prev pivot r0 lim pr es
          | false =>
            match !(scaleEntry prev pivot e).isUnitRep
                && Nat.blt ke lim with
            | true => (fillBelow prev r0 lim ke ps).1
                ++ (ke, scaleEntry prev pivot e)
                  :: mergeRow prev pivot r0 lim (hd :: pr) es
            | false => (fillBelow prev r0 lim ke ps).1
                ++ mergeRow prev pivot r0 lim (hd :: pr) es)
      cases hbe : Nat.beq hd.1 ke with
      | true =>
        cases hg : !(jointEntry prev pivot hd.2 r0 e).isUnitRep
            && Nat.blt ke lim with
        | true =>
          exact keysBelow_append lim _ _
            (keysBelow_fillBelow prev r0 lim ke ps)
            ⟨bltLt (ground.andSplitB hg).2,
              keysBelow_mergeRow prev pivot r0 lim pr es⟩
        | false =>
          exact keysBelow_append lim _ _
            (keysBelow_fillBelow prev r0 lim ke ps)
            (keysBelow_mergeRow prev pivot r0 lim pr es)
      | false =>
        cases hg : !(scaleEntry prev pivot e).isUnitRep
            && Nat.blt ke lim with
        | true =>
          exact keysBelow_append lim _ _
            (keysBelow_fillBelow prev r0 lim ke ps)
            ⟨bltLt (ground.andSplitB hg).2,
              keysBelow_mergeRow prev pivot r0 lim (hd :: pr) es⟩
        | false =>
          exact keysBelow_append lim _ _
            (keysBelow_fillBelow prev r0 lim ke ps)
            (keysBelow_mergeRow prev pivot r0 lim (hd :: pr) es)

/-- One row's update sits below the stated bound at either arm: the
scaling walk and the merge both keep an entry only past the bound
guard. -/
private theorem keysBelow_stepSRow (prev pivot r0 : BPair)
    (lim : Nat) (ps es : List (Nat × BPair)) :
      keysBelow lim (stepSRow prev pivot r0 lim ps es) := by
  show keysBelow lim
    (match r0.isUnitRep with
      | true => scaleTail prev pivot lim es
      | false => mergeRow prev pivot r0 lim ps es)
  cases hu : r0.isUnitRep with
  | true => exact keysBelow_keepTail (scaleEntry prev pivot) lim es
  | false => exact keysBelow_mergeRow prev pivot r0 lim ps es

/-- A row peeled at a pivot column below its count drops exactly
one key: the peel's branch reads the strict comparison true. -/
private theorem sPeel_count {w j : Nat} (r : SRow) (hj : j < w)
    (hr : r.1 = w) : ((sPeel j r).2).1 = w - 1 := by
  show (match Nat.blt j r.1 with
      | true => r.1 - 1
      | false => r.1) = w - 1
  rw [hr, ltBlt hj]

/-- One round's stepped rows sit at the invariant one width lower:
the peeled pivot row and every peeled row carry the same count, so
their lesser is that count, and the update's kept keys sit below it
at the guards' own reads. -/
private theorem sInv_step (w : Nat) (prev : BPair)
    (p : BPair × SRow) (j : Nat) (hp : p.2.1 = w - 1)
    (rows : List SRow) (hrows : SInv w rows) (hj : j < w) :
    SInv (w - 1) (stepRows prev p j rows) := by
  revert hrows
  induction rows with
  | nil => exact fun _ => trivial
  | cons r t ih =>
    intro hrows
    have hh : (r.1 = w ∧ keysBelow w r.2) ∧ SInv w t := hrows
    have hq : ((sPeel j r).2).1 = w - 1 :=
      sPeel_count r hj hh.1.1
    have hlim : ground.natMin p.2.1 ((sPeel j r).2).1 = w - 1 := by
      rw [hp, hq]
      exact natMin_self (w - 1)
    show ((ground.natMin p.2.1 ((sPeel j r).2).1 = w - 1)
        ∧ keysBelow (w - 1)
          (stepSRow prev p.1 (sPeel j r).1
            (ground.natMin p.2.1 ((sPeel j r).2).1) p.2.2
            ((sPeel j r).2).2))
      ∧ SInv (w - 1) (t.map (fun s =>
        let q := sPeel j s
        let lim := ground.natMin p.2.1 q.2.1
        (lim, stepSRow prev p.1 q.1 lim p.2.2 q.2.2)))
    rw [hlim]
    exact ⟨⟨rfl, keysBelow_stepSRow prev p.1 (sPeel j r).1 (w - 1)
      p.2.2 ((sPeel j r).2).2⟩, ih hh.2⟩

/-- The invariant reads at every row inside the list: the row at a
stated place carries the width as its count with its keys below
it. -/
private theorem sInv_getAt (w : Nat) : ∀ (rows : List SRow)
    (i : Nat), SInv w rows → i < rows.length →
      (ground.getAt ((0, []) : SRow) rows i).1 = w
      ∧ keysBelow w (ground.getAt ((0, []) : SRow) rows i).2
  | [], _, _, hi => absurd hi (Nat.not_lt_zero _)
  | r :: t, 0, h, _ => by
    have hh : (r.1 = w ∧ keysBelow w r.2) ∧ SInv w t := h
    exact hh.1
  | r :: t, i + 1, h, hi => by
    have hh : (r.1 = w ∧ keysBelow w r.2) ∧ SInv w t := h
    exact sInv_getAt w t i hh.2 (Nat.lt_of_succ_lt_succ hi)

/-- The descent's pivot count is bounded by the stated width at the
invariant: every round's pivot sits at a key below the width, so
the width is occupied, the round's stepped rows re-establish the
invariant one width lower, and the round below's count is bounded
there. -/
private theorem sdescend_le : ∀ (fuel w : Nat) (prev : BPair)
    (rows : List SRow), SInv w rows →
      sdescend fuel prev rows ≤ w
  | 0, w, _, _, _ => Nat.zero_le w
  | fuel + 1, w, prev, rows, hinv => by
    show (match sFind rows with
        | none => 0
        | some (i, j) =>
          let p := sPeel j (ground.getAt ((0, []) : SRow) rows i)
          1 + sdescend fuel p.1
            (stepRows prev p j (rows.eraseIdx i))) ≤ w
    cases hf : sFind rows with
    | none => exact Nat.zero_le w
    | some ij =>
      show 1 + sdescend fuel
          (sPeel ij.2 (ground.getAt ((0, []) : SRow) rows ij.1)).1
          (stepRows prev
            (sPeel ij.2 (ground.getAt ((0, []) : SRow) rows ij.1))
            ij.2 (rows.eraseIdx ij.1)) ≤ w
      have hj : ij.2 < w := sFind_key w rows ij.1 ij.2 hinv hf
      have hi : ij.1 < rows.length := sFind_lt rows ij.1 ij.2 hf
      have hrow := sInv_getAt w rows ij.1 hinv hi
      have hp : ((sPeel ij.2
          (ground.getAt ((0, []) : SRow) rows ij.1)).2).1 = w - 1 :=
        sPeel_count _ hj hrow.1
      have hstep := sInv_step w prev
        (sPeel ij.2 (ground.getAt ((0, []) : SRow) rows ij.1)) ij.2
        hp (rows.eraseIdx ij.1) (sInv_eraseIdx w rows ij.1 hinv) hj
      have hrec := sdescend_le fuel (w - 1)
        (sPeel ij.2 (ground.getAt ((0, []) : SRow) rows ij.1)).1
        (stepRows prev
          (sPeel ij.2 (ground.getAt ((0, []) : SRow) rows ij.1))
          ij.2 (rows.eraseIdx ij.1)) hstep
      cases w with
      | zero => exact absurd hj (Nat.not_lt_zero _)
      | succ w' =>
        rw [Nat.add_comm 1]
        exact Nat.succ_le_succ hrec

/-- The kernel list's length joins the rank to the stated width at
the frame: the sum form of the kernel dimension, every pivot one
stated column. -/
theorem kernelList_length (cols : Nat) (m : Mat)
    (hm : rowsLen cols m) :
    (kernelList cols m).length + rank m = cols := by
  rw [kernelList_dim]
  show cols - rank m + rank m = cols
  rw [Nat.add_comm]
  exact ground.natAddSubCancel
    (sdescend_le m.length cols (BPair.ofPos .one) (m.map ofRow)
      (sInv_ofRow cols m hm))

/-! The sparse state's dense reads: the stored keys ascend with the
values off the unit class, the peel reads the struck column, and the
step's entry at every kept key is the Sylvester formula's own
cofactor — the equational floor the descent's minor naming rides. -/

/-- Strictly ascending stored keys from a stated floor. -/
private def keysAsc : Nat → List (Nat × BPair) → Prop
  | _, [] => True
  | lo, (k, _) :: es => lo ≤ k ∧ keysAsc (k + 1) es

/-- Stored values off the unit class throughout. -/
private def entsOk : List (Nat × BPair) → Prop
  | [] => True
  | (_, v) :: es => (¬ v.oneValue BPair.unit) ∧ entsOk es

/-- A kept-entry guard false at a passing bound names the value's
own unit representative. -/
private theorem repOfGuardFalse {b t : Bool} (ht : t = true)
    (h : (!b && t) = false) : b = true := by
  rw [ht] at h
  cases b with
  | true => rfl
  | false => exact Bool.noConfusion h

/-- The floor weakens downward: keys above the greater floor sit
above the lesser. -/
private theorem keysAsc_le {lo lo' : Nat} (h : lo' ≤ lo) :
    ∀ es : List (Nat × BPair), keysAsc lo es → keysAsc lo' es
  | [], _ => trivial
  | (k, _) :: es, he => by
    have hh : lo ≤ k ∧ keysAsc (k + 1) es := he
    exact ⟨Nat.le_trans h hh.1, hh.2⟩

/-- A key below the floor is absent: the head key sits at or beyond
the floor, so it never matches, and the tail's own floor carries the
read down the walk. -/
private theorem keyAt_lo {lo : Nat} : ∀ es : List (Nat × BPair),
    keysAsc lo es → ∀ a, a < lo → ground.keyAt Nat.beq BPair.unit a es = BPair.unit
  | [], _, _, _ => rfl
  | (k, v) :: es, he, a, ha => by
    have hh : lo ≤ k ∧ keysAsc (k + 1) es := he
    have hak : a < k := Nat.lt_of_lt_of_le ha hh.1
    show (cond (Nat.beq k a) (v) (ground.keyAt Nat.beq BPair.unit a es)) = BPair.unit
    rw [ground.beqFalse (Nat.ne_of_gt hak)]
    exact keyAt_lo es hh.2 a (Nat.lt_succ_of_lt hak)

/-- A join reads at its head block where the tail block is absent
at the key. -/
private theorem keyAt_append_unit (a : Nat) (v : List (Nat × BPair))
    (hv : ground.keyAt Nat.beq BPair.unit a v = BPair.unit) :
    ∀ u : List (Nat × BPair), ground.keyAt Nat.beq BPair.unit a (u ++ v) = ground.keyAt Nat.beq BPair.unit a u
  | [] => hv
  | (k, x) :: u => by
    show (cond (Nat.beq k a) (x) (ground.keyAt Nat.beq BPair.unit a (u ++ v)))
      = (cond (Nat.beq k a) (x) (ground.keyAt Nat.beq BPair.unit a u))
    cases Nat.beq k a with
    | true => rfl
    | false => exact keyAt_append_unit a v hv u

/-- A join reads at its tail block above the head block's bound. -/
private theorem keyAt_append_below (w : Nat) :
    ∀ u : List (Nat × BPair), keysBelow w u →
      ∀ (v : List (Nat × BPair)) (a : Nat), ¬ a < w →
        ground.keyAt Nat.beq BPair.unit a (u ++ v) = ground.keyAt Nat.beq BPair.unit a v
  | [], _, _, _, _ => rfl
  | (k, x) :: u, hu, v, a, ha => by
    have hh : k < w ∧ keysBelow w u := hu
    show (cond (Nat.beq k a) (x) (ground.keyAt Nat.beq BPair.unit a (u ++ v))) = ground.keyAt Nat.beq BPair.unit a v
    rw [beqFalse (fun he => ha (by rw [← he]; exact hh.1))]
    exact keyAt_append_below w u hh.2 v a ha

/-- A pair at a unit second member and equal members is the unit
outright. -/
private theorem eqUnit_of_snd_one {x : BPair} (hs : x.snd = Pos.one)
    (he : x.fst = x.snd) : x = BPair.unit := by
  show (⟨x.fst, x.snd⟩ : BPair) = BPair.unit
  rw [he, hs]
  rfl

/-- A pair at a unit first member and equal members is the unit
outright. -/
private theorem eqUnit_of_fst_one {x : BPair} (hs : x.fst = Pos.one)
    (he : x.fst = x.snd) : x = BPair.unit := by
  show (⟨x.fst, x.snd⟩ : BPair) = BPair.unit
  rw [← he, hs]
  rfl

/-- A pair at a unit second member off the unit representative sits
off the unit class: a one-value read against the unit forces equal
members, and there the pair is the literal unit. -/
private theorem offRepSnd {x : BPair} (h : x.isUnitRep = false)
    (hs : x.snd = Pos.one) : ¬ x.oneValue BPair.unit := by
  intro hov
  rw [eqUnit_of_snd_one hs (BPair.eqMem_of_oneValue hov)] at h
  exact Bool.noConfusion h

/-- A pair at a unit first member off the unit representative sits
off the unit class. -/
private theorem offRepFst {x : BPair} (h : x.isUnitRep = false)
    (hs : x.fst = Pos.one) : ¬ x.oneValue BPair.unit := by
  intro hov
  rw [eqUnit_of_fst_one hs (BPair.eqMem_of_oneValue hov)] at h
  exact Bool.noConfusion h

/-- The canonical representative carries a unit member on one
side, its side's own one-member display. -/
private theorem norm_one_mem (x : BPair) :
    (x.norm).snd = Pos.one ∨ (x.norm).fst = Pos.one := by
  unfold BPair.norm
  cases x.side with
  | lt _ _ => exact Or.inr rfl
  | eq _ => exact Or.inl rfl
  | gt _ _ => exact Or.inl rfl

/-- A canonical representative off the unit representative sits off
the unit class. -/
private theorem offRep_norm {x : BPair}
    (h : (x.norm).isUnitRep = false) :
    ¬ (x.norm).oneValue BPair.unit := by
  cases norm_one_mem x with
  | inl hs => exact offRepSnd h hs
  | inr hs => exact offRepFst h hs

/-- The quotient branch's own second member is the unit. -/
private theorem cofMag_one_snd : ∀ m : Option Pos,
    (match m with
      | some c => BPair.ofPos c
      | none => BPair.unit).snd = Pos.one
  | none => rfl
  | some _ => rfl

/-- The swapped quotient branch's own first member is the unit. -/
private theorem cofMag_one_fst : ∀ m : Option Pos,
    (match m with
      | some c => (BPair.ofPos c).swap
      | none => BPair.unit).fst = Pos.one
  | none => rfl
  | some _ => rfl

/-- The exact cofactor carries a unit member on one side: every
branch answers at the unit, a ground datum's balance read or its
swap. -/
private theorem cofactorAt_one_mem (E P : BPair) :
    (cofactorAt E P).snd = Pos.one
      ∨ (cofactorAt E P).fst = Pos.one := by
  unfold cofactorAt
  cases E.side with
  | eq _ => cases P.side <;> exact Or.inl rfl
  | lt e _ =>
    cases P.side with
    | eq _ => exact Or.inl rfl
    | lt p _ => exact Or.inl (cofMag_one_snd (cofactorMag e p))
    | gt p _ => exact Or.inr (cofMag_one_fst (cofactorMag e p))
  | gt e _ =>
    cases P.side with
    | eq _ => exact Or.inl rfl
    | lt p _ => exact Or.inr (cofMag_one_fst (cofactorMag e p))
    | gt p _ => exact Or.inl (cofMag_one_snd (cofactorMag e p))

/-- An exact cofactor off the unit representative sits off the unit
class. -/
private theorem offRep_cofactorAt {E P : BPair}
    (h : (cofactorAt E P).isUnitRep = false) :
    ¬ (cofactorAt E P).oneValue BPair.unit := by
  cases cofactorAt_one_mem E P with
  | inl hs => exact offRepSnd h hs
  | inr hs => exact offRepFst h hs

/-- The exact cofactor reads the stated pair's one-value class: the
side transports along the class at the one gap, so the matching
branches answer at the one magnitude and the mismatched branches
never stand. -/
private theorem cofactorAt_congr {E E' : BPair} (P : BPair)
    (h : E.oneValue E') : cofactorAt E P = cofactorAt E' P := by
  unfold cofactorAt
  cases hE : E.side with
  | eq he =>
    cases hE' : E'.side with
    | eq _ => cases P.side <;> rfl
    | lt g' hg' =>
      exact (gapEqClashL
        (ground.gapCongrL (BPair.oneValue_symm h) hg') he).elim
    | gt g' hg' =>
      exact (gapEqClash
        (ground.gapCongr (BPair.oneValue_symm h) hg') he).elim
  | lt g hg =>
    cases hE' : E'.side with
    | eq he' => exact (gapEqClashL (ground.gapCongrL h hg) he').elim
    | gt g' hg' => exact (gapClash hg' (ground.gapCongrL h hg)).elim
    | lt g' hg' =>
      have hgg : g = g' :=
        ground.gap_unique (ground.gapCongrL h hg) hg'
      cases P.side with
      | eq _ => rfl
      | lt p _ =>
        show (match cofactorMag g p with
            | some c => BPair.ofPos c
            | none => BPair.unit)
          = (match cofactorMag g' p with
            | some c => BPair.ofPos c
            | none => BPair.unit)
        rw [hgg]
      | gt p _ =>
        show (match cofactorMag g p with
            | some c => (BPair.ofPos c).swap
            | none => BPair.unit)
          = (match cofactorMag g' p with
            | some c => (BPair.ofPos c).swap
            | none => BPair.unit)
        rw [hgg]
  | gt g hg =>
    cases hE' : E'.side with
    | eq he' => exact (gapEqClash (ground.gapCongr h hg) he').elim
    | lt g' hg' => exact (gapClash (ground.gapCongr h hg) hg').elim
    | gt g' hg' =>
      have hgg : g = g' :=
        ground.gap_unique (ground.gapCongr h hg) hg'
      cases P.side with
      | eq _ => rfl
      | lt p _ =>
        show (match cofactorMag g p with
            | some c => (BPair.ofPos c).swap
            | none => BPair.unit)
          = (match cofactorMag g' p with
            | some c => (BPair.ofPos c).swap
            | none => BPair.unit)
        rw [hgg]
      | gt p _ =>
        show (match cofactorMag g p with
            | some c => BPair.ofPos c
            | none => BPair.unit)
          = (match cofactorMag g' p with
            | some c => BPair.ofPos c
            | none => BPair.unit)
        rw [hgg]

/-- An equal-membered summand on the right leaves the exact cofactor
where it stood. -/
private theorem cofactorAt_addEq (X P : BPair) {c : BPair}
    (hc : c.fst = c.snd) : cofactorAt (X + c) P = cofactorAt X P := by
  refine cofactorAt_congr P ?_
  show X.fst + c.fst + X.snd = X.fst + (X.snd + c.snd)
  rw [hc, ground.add_assoc, ground.add_comm c.snd X.snd]

/-- An equal-membered summand on the left leaves the exact cofactor
where it stood, the sum's own commutation. -/
private theorem cofactorAt_addEqL (X P : BPair) {c : BPair}
    (hc : c.fst = c.snd) : cofactorAt (c + X) P = cofactorAt X P := by
  rw [BPair.add_comm]
  exact cofactorAt_addEq X P hc

/-- A factor against the unit reads equal members. -/
private theorem eqMemMulUnit (a : BPair) :
    (a * BPair.unit).fst = (a * BPair.unit).snd :=
  BPair.eqMem_of_oneValue
    (oneValue_mul_unit a BPair.unit (BPair.oneValue_refl BPair.unit))

/-- The unit against a factor reads equal members. -/
private theorem eqMemUnitMul (a : BPair) :
    (BPair.unit * a).fst = (BPair.unit * a).snd :=
  BPair.eqMem_of_oneValue
    (oneValue_unit_mul (BPair.oneValue_refl BPair.unit))

/-- The row's own scaling answers the sum's unit at an absent
key. -/
private theorem scaleEntry_unit (prev pivot : BPair) :
    scaleEntry prev pivot BPair.unit = BPair.unit :=
  cofactorAt_eqMem (pivot * BPair.unit) prev (eqMemMulUnit pivot)

/-- The pivot row's fill-in answers the sum's unit at an absent
key. -/
private theorem fillEntry_unit (prev r0 : BPair) :
    fillEntry prev r0 BPair.unit = BPair.unit :=
  cofactorAt_eqMem ((r0 * BPair.unit).swap) prev
    (eqMemMulUnit r0).symm

/-- The step's fill summand withdraws at an absent pivot-row key. -/
private theorem stepRead_noFill (prev pivot r0 x : BPair) :
    cofactorAt (pivot * x + (r0 * BPair.unit).swap) prev
      = scaleEntry prev pivot x :=
  cofactorAt_addEq (pivot * x) prev (eqMemMulUnit r0).symm

/-- The step's scaling summand withdraws at an absent row key. -/
private theorem stepRead_noScale (prev pivot r0 t : BPair) :
    cofactorAt (pivot * BPair.unit + (r0 * t).swap) prev
      = fillEntry prev r0 t :=
  cofactorAt_addEqL ((r0 * t).swap) prev (eqMemMulUnit pivot)

/-- The step answers the sum's unit where both rows are absent. -/
private theorem stepRead_null (prev pivot r0 : BPair) :
    cofactorAt (pivot * BPair.unit + (r0 * BPair.unit).swap) prev
      = BPair.unit :=
  step_unit prev pivot BPair.unit r0 BPair.unit rfl (Or.inr rfl)

/-- A pivot column at the unit representative withdraws the step's
fill summand at every key. -/
private theorem stepRead_unitCol (prev pivot x y : BPair) :
    cofactorAt (pivot * x + (BPair.unit * y).swap) prev
      = scaleEntry prev pivot x :=
  cofactorAt_addEq (pivot * x) prev (eqMemUnitMul y).symm

/-- The read at a matching head key is the stored value. -/
private theorem keyAt_hit {k a : Nat} (hb : Nat.beq k a = true)
    (v : BPair) (es : List (Nat × BPair)) :
    ground.keyAt Nat.beq BPair.unit a ((k, v) :: es) = v := by
  show (cond (Nat.beq k a) (v) (ground.keyAt Nat.beq BPair.unit a es)) = v
  rw [hb]
  exact rfl

/-- The read past a distinct head key is the tail's. -/
private theorem keyAt_miss {k a : Nat} (hb : Nat.beq k a = false)
    (v : BPair) (es : List (Nat × BPair)) :
    ground.keyAt Nat.beq BPair.unit a ((k, v) :: es) = ground.keyAt Nat.beq BPair.unit a es := by
  show (cond (Nat.beq k a) (v) (ground.keyAt Nat.beq BPair.unit a es)) = ground.keyAt Nat.beq BPair.unit a es
  rw [hb]
  exact rfl

/-- The shifted keys ascend from one floor lower: the head key sits
above the raised floor, so its predecessor sits above the floor
itself. -/
private theorem keysAsc_shiftKeys : ∀ (es : List (Nat × BPair))
    (lo : Nat), keysAsc (lo + 1) es → keysAsc lo (shiftKeys es)
  | [], _, _ => trivial
  | (0, _) :: es, lo, h => by
    have hh : lo + 1 ≤ 0 ∧ keysAsc (0 + 1) es := h
    exact absurd hh.1 (Nat.not_succ_le_zero lo)
  | (k + 1, _) :: es, lo, h => by
    have hh : lo + 1 ≤ k + 1 ∧ keysAsc (k + 1 + 1) es := h
    exact ⟨Nat.le_of_succ_le_succ hh.1,
      keysAsc_shiftKeys es (k + 1) hh.2⟩

/-- The shifted list's read at a key is the list's own read one key
higher, the successor's accelerated test its own. -/
private theorem keyAt_shiftKeys : ∀ es : List (Nat × BPair),
    keysAsc 1 es → ∀ c, ground.keyAt Nat.beq BPair.unit c (shiftKeys es) = ground.keyAt Nat.beq BPair.unit (c + 1) es
  | [], _, _ => rfl
  | (0, _) :: es, h, _ => by
    have hh : 1 ≤ 0 ∧ keysAsc (0 + 1) es := h
    exact absurd hh.1 (Nat.not_succ_le_zero 0)
  | (k + 1, v) :: es, h, c => by
    have hh : 1 ≤ k + 1 ∧ keysAsc (k + 1 + 1) es := h
    show (cond (Nat.beq k c) (v) (ground.keyAt Nat.beq BPair.unit c (shiftKeys es)))
      = (cond (Nat.beq k c) (v) (ground.keyAt Nat.beq BPair.unit (c + 1) es))
    cases Nat.beq k c with
    | true => rfl
    | false =>
      exact keyAt_shiftKeys es
        (keysAsc_le (Nat.succ_le_succ (Nat.zero_le (k + 1))) es hh.2)
        c

/-- The peel's own entry is the list's read at the pivot column:
the walk answers at the first key at the pivot's or above it, and
past it the column is absent. -/
private theorem keyAt_peel_head (j : Nat) :
    ∀ es : List (Nat × BPair), keysAsc 0 es →
      (peel j es).1 = ground.keyAt Nat.beq BPair.unit j es
  | [], _ => rfl
  | (k, v) :: es, he => by
    have hh : 0 ≤ k ∧ keysAsc (k + 1) es := he
    show (match Nat.beq k j with
        | true => (v, shiftKeys es)
        | false =>
          match Nat.blt k j with
          | true => ((peel j es).1, (k, v) :: (peel j es).2)
          | false => (BPair.unit, shiftKeys ((k, v) :: es))).1
      = ground.keyAt Nat.beq BPair.unit j ((k, v) :: es)
    cases hbe : Nat.beq k j with
    | true =>
      show v = ground.keyAt Nat.beq BPair.unit j ((k, v) :: es)
      rw [keyAt_hit hbe v es]
    | false =>
      rw [keyAt_miss hbe v es]
      cases hb : Nat.blt k j with
      | true =>
        show (peel j es).1 = ground.keyAt Nat.beq BPair.unit j es
        exact keyAt_peel_head j es
          (keysAsc_le (Nat.zero_le (k + 1)) es hh.2)
      | false =>
        show BPair.unit = ground.keyAt Nat.beq BPair.unit j es
        exact (keyAt_lo es hh.2 j
          (Nat.lt_succ_of_le
            (Nat.le_of_not_lt (bltFalse hb)))).symm

/-- The peeled list's keys ascend from the same floor: the pivot's
own key drops out, the keys below it stand, and the keys above it
shift down onto the floor the walk left. -/
private theorem keysAsc_peel (j : Nat) :
    ∀ (es : List (Nat × BPair)) (lo : Nat), keysAsc lo es →
      lo ≤ j → keysAsc lo (peel j es).2
  | [], _, _, _ => trivial
  | (k, v) :: es, lo, he, hlo => by
    have hh : lo ≤ k ∧ keysAsc (k + 1) es := he
    show keysAsc lo (match Nat.beq k j with
        | true => (v, shiftKeys es)
        | false =>
          match Nat.blt k j with
          | true => ((peel j es).1, (k, v) :: (peel j es).2)
          | false => (BPair.unit, shiftKeys ((k, v) :: es))).2
    cases hbe : Nat.beq k j with
    | true =>
      show keysAsc lo (shiftKeys es)
      exact keysAsc_shiftKeys es lo
        (keysAsc_le (Nat.succ_le_succ hh.1) es hh.2)
    | false =>
      cases hb : Nat.blt k j with
      | true =>
        show keysAsc lo ((k, v) :: (peel j es).2)
        exact ⟨hh.1, keysAsc_peel j es (k + 1) hh.2 (bltLt hb)⟩
      | false =>
        show keysAsc lo (shiftKeys ((k, v) :: es))
        refine keysAsc_shiftKeys ((k, v) :: es) lo ?_
        exact ⟨Nat.lt_of_le_of_lt hlo
          (Nat.lt_of_le_of_ne (Nat.le_of_not_lt (bltFalse hb))
            (fun hjk => beqNe hbe hjk.symm)), hh.2⟩

/-- The peeled list's read at a key is the list's read at the
lifted key: below the pivot the key stands, at or above it the key
steps up over the struck column. -/
private theorem keyAt_peel (j : Nat) :
    ∀ es : List (Nat × BPair), keysAsc 0 es →
      ∀ c, ground.keyAt Nat.beq BPair.unit c (peel j es).2 = ground.keyAt Nat.beq BPair.unit (liftIx j c) es
  | [], _, _ => rfl
  | (k, v) :: es, he, c => by
    have hh : 0 ≤ k ∧ keysAsc (k + 1) es := he
    have hes : keysAsc 0 es := keysAsc_le (Nat.zero_le (k + 1)) es hh.2
    show ground.keyAt Nat.beq BPair.unit c (match Nat.beq k j with
        | true => (v, shiftKeys es)
        | false =>
          match Nat.blt k j with
          | true => ((peel j es).1, (k, v) :: (peel j es).2)
          | false => (BPair.unit, shiftKeys ((k, v) :: es))).2
      = ground.keyAt Nat.beq BPair.unit (liftIx j c) ((k, v) :: es)
    cases hbe : Nat.beq k j with
    | true =>
      have hkj : k = j := ground.beqEq k j hbe
      have hjes : keysAsc (j + 1) es := by
        rw [← hkj]; exact hh.2
      show ground.keyAt Nat.beq BPair.unit c (shiftKeys es) = ground.keyAt Nat.beq BPair.unit (liftIx j c) ((k, v) :: es)
      rw [keyAt_miss
          (beqFalse (fun hf => liftIx_ne j c (hf.symm.trans hkj)))
          v es,
        keyAt_shiftKeys es
          (keysAsc_le (Nat.succ_le_succ (Nat.zero_le j)) es hjes) c]
      by_cases hc : c < j
      · have hl : liftIx j c = c := by
          show (if c < j then c else c + 1) = c
          rw [if_pos hc]
        rw [hl, keyAt_lo es hjes (c + 1) (Nat.succ_lt_succ hc),
          keyAt_lo es hjes c (Nat.lt_succ_of_lt hc)]
      · rw [liftIx_gt j c hc]
    | false =>
      cases hb : Nat.blt k j with
      | true =>
        show ground.keyAt Nat.beq BPair.unit c ((k, v) :: (peel j es).2)
          = ground.keyAt Nat.beq BPair.unit (liftIx j c) ((k, v) :: es)
        have hih := keyAt_peel j es hes c
        by_cases hc : c < j
        · have hl : liftIx j c = c := by
            show (if c < j then c else c + 1) = c
            rw [if_pos hc]
          rw [hl] at hih ⊢
          cases hbc : Nat.beq k c with
          | true =>
            rw [keyAt_hit hbc v (peel j es).2, keyAt_hit hbc v es]
          | false =>
            rw [keyAt_miss hbc v (peel j es).2, keyAt_miss hbc v es]
            exact hih
        · have hkc : k < c :=
            Nat.lt_of_lt_of_le (bltLt hb) (Nat.le_of_not_lt hc)
          rw [liftIx_gt j c hc] at hih ⊢
          rw [keyAt_miss (beqFalse (Nat.ne_of_lt hkc)) v (peel j es).2,
            keyAt_miss (beqFalse (Nat.ne_of_lt (Nat.lt_succ_of_lt hkc)))
              v es]
          exact hih
      | false =>
        have hjk : j < k :=
          Nat.lt_of_le_of_ne (Nat.le_of_not_lt (bltFalse hb))
            (fun hjk => beqNe hbe hjk.symm)
        have hka : keysAsc k ((k, v) :: es) := ⟨Nat.le_refl k, hh.2⟩
        show ground.keyAt Nat.beq BPair.unit c (shiftKeys ((k, v) :: es))
          = ground.keyAt Nat.beq BPair.unit (liftIx j c) ((k, v) :: es)
        rw [keyAt_shiftKeys ((k, v) :: es)
          (keysAsc_le (Nat.lt_of_le_of_lt (Nat.zero_le j) hjk)
            ((k, v) :: es) hka) c]
        by_cases hc : c < j
        · have hl : liftIx j c = c := by
            show (if c < j then c else c + 1) = c
            rw [if_pos hc]
          rw [hl, keyAt_lo ((k, v) :: es) hka (c + 1)
              (Nat.lt_of_le_of_lt hc hjk),
            keyAt_lo ((k, v) :: es) hka c
              (Nat.lt_trans hc hjk)]
        · rw [liftIx_gt j c hc]

/-- A kept-entry guard true names the value off the unit
representative. -/
private theorem repFalseOfGuard {b t : Bool} (h : (!b && t) = true) :
    b = false := ground.boolFalseOfNot (ground.andSplitB h).1

/-- The row's own scaled entry off the unit representative sits off
the unit class. -/
private theorem offRep_scaleEntry {prev pivot e : BPair}
    (h : (scaleEntry prev pivot e).isUnitRep = false) :
    ¬ (scaleEntry prev pivot e).oneValue BPair.unit :=
  offRep_cofactorAt (E := pivot * e) (P := prev) h

/-- The pivot row's fill-in entry off the unit representative sits
off the unit class. -/
private theorem offRep_fillEntry {prev r0 t : BPair}
    (h : (fillEntry prev r0 t).isUnitRep = false) :
    ¬ (fillEntry prev r0 t).oneValue BPair.unit :=
  offRep_cofactorAt (E := (r0 * t).swap) (P := prev) h

/-- The joint entry off the unit representative sits off the unit
class. -/
private theorem offRep_jointEntry {prev pivot t r0 e : BPair}
    (h : (jointEntry prev pivot t r0 e).isUnitRep = false) :
    ¬ (jointEntry prev pivot t r0 e).oneValue BPair.unit :=
  offRep_cofactorAt (E := pivot * e + (r0 * t).swap) (P := prev) h

/-- The kept entries ascend from the same floor: a kept key is its
own, and a dropped key hands the floor to the tail. -/
private theorem keysAsc_keepTail (f : BPair → BPair) (lim : Nat) :
    ∀ (es : List (Nat × BPair)) (lo : Nat), keysAsc lo es →
      keysAsc lo (keepTail f lim es)
  | [], _, _ => trivial
  | (k, e) :: es, lo, he => by
    have hh : lo ≤ k ∧ keysAsc (k + 1) es := he
    show keysAsc lo (match !(f e).isUnitRep && Nat.blt k lim with
        | true => (k, f e) :: keepTail f lim es
        | false => keepTail f lim es)
    cases hg : !(f e).isUnitRep && Nat.blt k lim with
    | true =>
      exact ⟨hh.1, keysAsc_keepTail f lim es (k + 1) hh.2⟩
    | false =>
      exact keysAsc_le (Nat.le_trans hh.1 (Nat.le_succ k))
        (keepTail f lim es) (keysAsc_keepTail f lim es (k + 1) hh.2)

/-- Every kept value passed the guard, so at a per-entry read whose
off-representative values sit off the unit class the kept list
does. -/
private theorem entsOk_keepTail (f : BPair → BPair)
    (hf : ∀ x : BPair, (f x).isUnitRep = false →
      ¬ (f x).oneValue BPair.unit) (lim : Nat) :
    ∀ es : List (Nat × BPair), entsOk (keepTail f lim es)
  | [] => trivial
  | (k, e) :: es => by
    show entsOk (match !(f e).isUnitRep && Nat.blt k lim with
        | true => (k, f e) :: keepTail f lim es
        | false => keepTail f lim es)
    cases hg : !(f e).isUnitRep && Nat.blt k lim with
    | true =>
      exact ⟨hf e (repFalseOfGuard hg), entsOk_keepTail f hf lim es⟩
    | false => exact entsOk_keepTail f hf lim es

/-- The kept walk's read at a key below the bound is the per-entry
read of the list's own: a kept key answers at the head, a key
dropped at the read key carries the sum's unit both sides, and every
other drop falls through the walk. -/
private theorem keyAt_keepTail (f : BPair → BPair) (lim : Nat)
    (hf : f BPair.unit = BPair.unit) :
    ∀ (es : List (Nat × BPair)) (lo : Nat), keysAsc lo es →
      ∀ a, a < lim → ground.keyAt Nat.beq BPair.unit a (keepTail f lim es) = f (ground.keyAt Nat.beq BPair.unit a es)
  | [], _, _, _, _ => hf.symm
  | (k, e) :: es, lo, he, a, ha => by
    have hh : lo ≤ k ∧ keysAsc (k + 1) es := he
    show ground.keyAt Nat.beq BPair.unit a (match !(f e).isUnitRep && Nat.blt k lim with
        | true => (k, f e) :: keepTail f lim es
        | false => keepTail f lim es)
      = f (ground.keyAt Nat.beq BPair.unit a ((k, e) :: es))
    cases hbe : Nat.beq k a with
    | false =>
      rw [keyAt_miss hbe e es]
      cases hg : !(f e).isUnitRep && Nat.blt k lim with
      | true =>
        show ground.keyAt Nat.beq BPair.unit a ((k, f e) :: keepTail f lim es)
          = f (ground.keyAt Nat.beq BPair.unit a es)
        rw [keyAt_miss hbe (f e) (keepTail f lim es)]
        exact keyAt_keepTail f lim hf es (k + 1) hh.2 a ha
      | false =>
        show ground.keyAt Nat.beq BPair.unit a (keepTail f lim es) = f (ground.keyAt Nat.beq BPair.unit a es)
        exact keyAt_keepTail f lim hf es (k + 1) hh.2 a ha
    | true =>
      have hka : k = a := ground.beqEq k a hbe
      rw [keyAt_hit hbe e es]
      cases hg : !(f e).isUnitRep && Nat.blt k lim with
      | true =>
        show ground.keyAt Nat.beq BPair.unit a ((k, f e) :: keepTail f lim es) = f e
        exact keyAt_hit hbe (f e) (keepTail f lim es)
      | false =>
        show ground.keyAt Nat.beq BPair.unit a (keepTail f lim es) = f e
        have hkl : Nat.blt k lim = true := by
          rw [hka]; exact ltBlt ha
        have hfe : f e = BPair.unit :=
          BPair.unit_of_isUnitRep (repOfGuardFalse hkl hg)
        rw [hfe, keyAt_keepTail f lim hf es (k + 1) hh.2 a ha,
          keyAt_lo es hh.2 a
            (by rw [← hka]; exact Nat.lt_succ_of_le (Nat.le_refl k)),
          hf]

/-- The split-off fill-in's keys sit below the split key: every
entry it keeps passed the strict guard against that key. -/
private theorem keysBelow_fillBelow_lt (prev r0 : BPair)
    (lim k : Nat) : ∀ ps : List (Nat × BPair),
      keysBelow k (fillBelow prev r0 lim k ps).1
  | [] => trivial
  | (kt, t) :: ps => by
    show keysBelow k (match Nat.blt kt k with
        | false => ([], (kt, t) :: ps)
        | true =>
          match !(fillEntry prev r0 t).isUnitRep
              && Nat.blt kt lim with
          | true => ((kt, fillEntry prev r0 t)
              :: (fillBelow prev r0 lim k ps).1,
            (fillBelow prev r0 lim k ps).2)
          | false => fillBelow prev r0 lim k ps).1
    cases hb : Nat.blt kt k with
    | false => exact trivial
    | true =>
      cases hg : !(fillEntry prev r0 t).isUnitRep
          && Nat.blt kt lim with
      | true =>
        exact ⟨bltLt hb, keysBelow_fillBelow_lt prev r0 lim k ps⟩
      | false => exact keysBelow_fillBelow_lt prev r0 lim k ps

/-- The split's own suffix begins at or above the split key: the
walk stops exactly at the first key the strict guard refuses. -/
private theorem keysAsc_fillBelow_snd (prev r0 : BPair)
    (lim k : Nat) : ∀ (ps : List (Nat × BPair)) (lo : Nat),
      keysAsc lo ps → keysAsc k (fillBelow prev r0 lim k ps).2
  | [], _, _ => trivial
  | (kt, t) :: ps, lo, he => by
    have hh : lo ≤ kt ∧ keysAsc (kt + 1) ps := he
    show keysAsc k (match Nat.blt kt k with
        | false => ([], (kt, t) :: ps)
        | true =>
          match !(fillEntry prev r0 t).isUnitRep
              && Nat.blt kt lim with
          | true => ((kt, fillEntry prev r0 t)
              :: (fillBelow prev r0 lim k ps).1,
            (fillBelow prev r0 lim k ps).2)
          | false => fillBelow prev r0 lim k ps).2
    cases hb : Nat.blt kt k with
    | false =>
      exact ⟨Nat.le_of_not_lt (bltFalse hb), hh.2⟩
    | true =>
      cases hg : !(fillEntry prev r0 t).isUnitRep
          && Nat.blt kt lim with
      | true =>
        exact keysAsc_fillBelow_snd prev r0 lim k ps (kt + 1) hh.2
      | false =>
        exact keysAsc_fillBelow_snd prev r0 lim k ps (kt + 1) hh.2

/-- The split's fill-in joined to a block from the split key up
ascends from the list's own floor: the kept keys ascend below the
split key and the block begins at or above it. -/
private theorem keysAsc_fillBelow (prev r0 : BPair) (lim k : Nat) :
    ∀ (ps : List (Nat × BPair)) (lo : Nat), keysAsc lo ps → lo ≤ k →
      ∀ tl : List (Nat × BPair), keysAsc k tl →
        keysAsc lo ((fillBelow prev r0 lim k ps).1 ++ tl)
  | [], lo, _, hlo, tl, htl => keysAsc_le hlo tl htl
  | (kt, t) :: ps, lo, he, hlo, tl, htl => by
    have hh : lo ≤ kt ∧ keysAsc (kt + 1) ps := he
    show keysAsc lo ((match Nat.blt kt k with
        | false => ([], (kt, t) :: ps)
        | true =>
          match !(fillEntry prev r0 t).isUnitRep
              && Nat.blt kt lim with
          | true => ((kt, fillEntry prev r0 t)
              :: (fillBelow prev r0 lim k ps).1,
            (fillBelow prev r0 lim k ps).2)
          | false => fillBelow prev r0 lim k ps).1 ++ tl)
    cases hb : Nat.blt kt k with
    | false => exact keysAsc_le hlo tl htl
    | true =>
      cases hg : !(fillEntry prev r0 t).isUnitRep
          && Nat.blt kt lim with
      | true =>
        exact ⟨hh.1, keysAsc_fillBelow prev r0 lim k ps (kt + 1)
          hh.2 (bltLt hb) tl htl⟩
      | false =>
        exact keysAsc_le (Nat.le_trans hh.1 (Nat.le_succ kt)) _
          (keysAsc_fillBelow prev r0 lim k ps (kt + 1) hh.2
            (bltLt hb) tl htl)

/-- Every fill-in entry the split keeps passed the guard, so the
kept block sits off the unit class. -/
private theorem entsOk_fillBelow (prev r0 : BPair) (lim k : Nat) :
    ∀ ps : List (Nat × BPair),
      entsOk (fillBelow prev r0 lim k ps).1
  | [] => trivial
  | (kt, t) :: ps => by
    show entsOk (match Nat.blt kt k with
        | false => ([], (kt, t) :: ps)
        | true =>
          match !(fillEntry prev r0 t).isUnitRep
              && Nat.blt kt lim with
          | true => ((kt, fillEntry prev r0 t)
              :: (fillBelow prev r0 lim k ps).1,
            (fillBelow prev r0 lim k ps).2)
          | false => fillBelow prev r0 lim k ps).1
    cases hb : Nat.blt kt k with
    | false => exact trivial
    | true =>
      cases hg : !(fillEntry prev r0 t).isUnitRep
          && Nat.blt kt lim with
      | true =>
        exact ⟨offRep_fillEntry (repFalseOfGuard hg),
          entsOk_fillBelow prev r0 lim k ps⟩
      | false => exact entsOk_fillBelow prev r0 lim k ps

/-- The split's fill-in reads the fill formula below the split key:
the kept keys answer at their own entries, a key dropped at the read
key carries the sum's unit both sides, and the walk covers every
stored key below the split. -/
private theorem keyAt_fillBelow (prev r0 : BPair) (lim k : Nat) :
    ∀ (ps : List (Nat × BPair)) (lo : Nat), keysAsc lo ps →
      ∀ a, a < k → a < lim →
        ground.keyAt Nat.beq BPair.unit a (fillBelow prev r0 lim k ps).1
          = fillEntry prev r0 (ground.keyAt Nat.beq BPair.unit a ps)
  | [], _, _, _, _, _ => (fillEntry_unit prev r0).symm
  | (kt, t) :: ps, lo, he, a, hak, hal => by
    have hh : lo ≤ kt ∧ keysAsc (kt + 1) ps := he
    show ground.keyAt Nat.beq BPair.unit a (match Nat.blt kt k with
        | false => ([], (kt, t) :: ps)
        | true =>
          match !(fillEntry prev r0 t).isUnitRep
              && Nat.blt kt lim with
          | true => ((kt, fillEntry prev r0 t)
              :: (fillBelow prev r0 lim k ps).1,
            (fillBelow prev r0 lim k ps).2)
          | false => fillBelow prev r0 lim k ps).1
      = fillEntry prev r0 (ground.keyAt Nat.beq BPair.unit a ((kt, t) :: ps))
    cases hb : Nat.blt kt k with
    | false =>
      have hakt : a < kt :=
        Nat.lt_of_lt_of_le hak (Nat.le_of_not_lt (bltFalse hb))
      show BPair.unit = fillEntry prev r0 (ground.keyAt Nat.beq BPair.unit a ((kt, t) :: ps))
      rw [keyAt_miss (ground.beqFalse (Nat.ne_of_gt hakt)) t ps,
        keyAt_lo ps hh.2 a (Nat.lt_succ_of_lt hakt), fillEntry_unit]
    | true =>
      cases hbe : Nat.beq kt a with
      | true =>
        have hka : kt = a := ground.beqEq kt a hbe
        rw [keyAt_hit hbe t ps]
        cases hg : !(fillEntry prev r0 t).isUnitRep
            && Nat.blt kt lim with
        | true =>
          show ground.keyAt Nat.beq BPair.unit a ((kt, fillEntry prev r0 t)
              :: (fillBelow prev r0 lim k ps).1)
            = fillEntry prev r0 t
          exact keyAt_hit hbe (fillEntry prev r0 t)
            (fillBelow prev r0 lim k ps).1
        | false =>
          show ground.keyAt Nat.beq BPair.unit a (fillBelow prev r0 lim k ps).1
            = fillEntry prev r0 t
          have hkl : Nat.blt kt lim = true := by
            rw [hka]; exact ltBlt hal
          have hfe : fillEntry prev r0 t = BPair.unit :=
            BPair.unit_of_isUnitRep (repOfGuardFalse hkl hg)
          rw [hfe,
            keyAt_fillBelow prev r0 lim k ps (kt + 1) hh.2 a hak hal,
            keyAt_lo ps hh.2 a
              (by rw [← hka]; exact Nat.lt_succ_of_le (Nat.le_refl kt)),
            fillEntry_unit]
      | false =>
        rw [keyAt_miss hbe t ps]
        cases hg : !(fillEntry prev r0 t).isUnitRep
            && Nat.blt kt lim with
        | true =>
          show ground.keyAt Nat.beq BPair.unit a ((kt, fillEntry prev r0 t)
              :: (fillBelow prev r0 lim k ps).1)
            = fillEntry prev r0 (ground.keyAt Nat.beq BPair.unit a ps)
          rw [keyAt_miss hbe (fillEntry prev r0 t)
            (fillBelow prev r0 lim k ps).1]
          exact keyAt_fillBelow prev r0 lim k ps (kt + 1) hh.2 a hak hal
        | false =>
          show ground.keyAt Nat.beq BPair.unit a (fillBelow prev r0 lim k ps).1
            = fillEntry prev r0 (ground.keyAt Nat.beq BPair.unit a ps)
          exact keyAt_fillBelow prev r0 lim k ps (kt + 1) hh.2 a hak hal

/-- The split's suffix reads the list's own at or above the split
key: the dropped prefix's keys sit strictly below it. -/
private theorem keyAt_fillBelow_snd (prev r0 : BPair) (lim k : Nat) :
    ∀ (ps : List (Nat × BPair)) (a : Nat), ¬ a < k →
      ground.keyAt Nat.beq BPair.unit a (fillBelow prev r0 lim k ps).2 = ground.keyAt Nat.beq BPair.unit a ps
  | [], _, _ => rfl
  | (kt, t) :: ps, a, ha => by
    show ground.keyAt Nat.beq BPair.unit a (match Nat.blt kt k with
        | false => ([], (kt, t) :: ps)
        | true =>
          match !(fillEntry prev r0 t).isUnitRep
              && Nat.blt kt lim with
          | true => ((kt, fillEntry prev r0 t)
              :: (fillBelow prev r0 lim k ps).1,
            (fillBelow prev r0 lim k ps).2)
          | false => fillBelow prev r0 lim k ps).2
      = ground.keyAt Nat.beq BPair.unit a ((kt, t) :: ps)
    cases hb : Nat.blt kt k with
    | false => rfl
    | true =>
      have hkta : kt < a :=
        Nat.lt_of_lt_of_le (bltLt hb) (Nat.le_of_not_lt ha)
      rw [keyAt_miss (beqFalse (Nat.ne_of_lt hkta)) t ps]
      cases hg : !(fillEntry prev r0 t).isUnitRep
          && Nat.blt kt lim with
      | true =>
        show ground.keyAt Nat.beq BPair.unit a (fillBelow prev r0 lim k ps).2 = ground.keyAt Nat.beq BPair.unit a ps
        exact keyAt_fillBelow_snd prev r0 lim k ps a ha
      | false =>
        show ground.keyAt Nat.beq BPair.unit a (fillBelow prev r0 lim k ps).2 = ground.keyAt Nat.beq BPair.unit a ps
        exact keyAt_fillBelow_snd prev r0 lim k ps a ha

/-- A join of two off-unit-class blocks is off the class. -/
private theorem entsOk_append : ∀ a b : List (Nat × BPair),
    entsOk a → entsOk b → entsOk (a ++ b)
  | [], _, _, hb => hb
  | (_, v) :: a, b, ha, hb => by
    have hh : (¬ v.oneValue BPair.unit) ∧ entsOk a := ha
    exact ⟨hh.1, entsOk_append a b hh.2 hb⟩

/-- The merged row's keys ascend from the two lists' own floor: the
split fill-in ascends below the head key, the emitted head key
continues, and the recursion runs above it. -/
private theorem keysAsc_mergeRow (prev pivot r0 : BPair) (lim : Nat) :
    ∀ (es ps : List (Nat × BPair)) (lo : Nat), keysAsc lo ps →
      keysAsc lo es → keysAsc lo (mergeRow prev pivot r0 lim ps es)
  | [], ps, lo, hps, _ =>
    keysAsc_keepTail (fillEntry prev r0) lim ps lo hps
  | (ke, e) :: es, ps, lo, hps, hes => by
    have hh : lo ≤ ke ∧ keysAsc (ke + 1) es := hes
    have hsnd : keysAsc ke (fillBelow prev r0 lim ke ps).2 :=
      keysAsc_fillBelow_snd prev r0 lim ke ps lo hps
    show keysAsc lo (match (fillBelow prev r0 lim ke ps).2 with
        | [] => (fillBelow prev r0 lim ke ps).1
            ++ scaleTail prev pivot lim ((ke, e) :: es)
        | (kt, t) :: pr =>
          match Nat.beq kt ke with
          | true =>
            match !(jointEntry prev pivot t r0 e).isUnitRep
                && Nat.blt ke lim with
            | true => (fillBelow prev r0 lim ke ps).1
                ++ (ke, jointEntry prev pivot t r0 e)
                  :: mergeRow prev pivot r0 lim pr es
            | false => (fillBelow prev r0 lim ke ps).1
                ++ mergeRow prev pivot r0 lim pr es
          | false =>
            match !(scaleEntry prev pivot e).isUnitRep
                && Nat.blt ke lim with
            | true => (fillBelow prev r0 lim ke ps).1
                ++ (ke, scaleEntry prev pivot e)
                  :: mergeRow prev pivot r0 lim ((kt, t) :: pr) es
            | false => (fillBelow prev r0 lim ke ps).1
                ++ mergeRow prev pivot r0 lim ((kt, t) :: pr) es)
    cases hb : (fillBelow prev r0 lim ke ps).2 with
    | nil =>
      refine keysAsc_fillBelow prev r0 lim ke ps lo hps hh.1 _ ?_
      exact keysAsc_keepTail (scaleEntry prev pivot) lim
        ((ke, e) :: es) ke ⟨Nat.le_refl ke, hh.2⟩
    | cons hd pr =>
      cases hd with
      | mk kt t =>
        rw [hb] at hsnd
        have hhd : ke ≤ kt ∧ keysAsc (kt + 1) pr := hsnd
        show keysAsc lo (match Nat.beq kt ke with
            | true =>
              match !(jointEntry prev pivot t r0 e).isUnitRep
                  && Nat.blt ke lim with
              | true => (fillBelow prev r0 lim ke ps).1
                  ++ (ke, jointEntry prev pivot t r0 e)
                    :: mergeRow prev pivot r0 lim pr es
              | false => (fillBelow prev r0 lim ke ps).1
                  ++ mergeRow prev pivot r0 lim pr es
            | false =>
              match !(scaleEntry prev pivot e).isUnitRep
                  && Nat.blt ke lim with
              | true => (fillBelow prev r0 lim ke ps).1
                  ++ (ke, scaleEntry prev pivot e)
                    :: mergeRow prev pivot r0 lim ((kt, t) :: pr) es
              | false => (fillBelow prev r0 lim ke ps).1
                  ++ mergeRow prev pivot r0 lim ((kt, t) :: pr) es)
        cases hbe : Nat.beq kt ke with
        | true =>
          have hkt : kt = ke := ground.beqEq kt ke hbe
          have hpr : keysAsc (ke + 1) pr := by
            rw [← hkt]; exact hhd.2
          have hrec : keysAsc (ke + 1)
              (mergeRow prev pivot r0 lim pr es) :=
            keysAsc_mergeRow prev pivot r0 lim es pr (ke + 1) hpr hh.2
          cases hg : !(jointEntry prev pivot t r0 e).isUnitRep
              && Nat.blt ke lim with
          | true =>
            refine keysAsc_fillBelow prev r0 lim ke ps lo hps hh.1
              _ ?_
            exact ⟨Nat.le_refl ke, hrec⟩
          | false =>
            refine keysAsc_fillBelow prev r0 lim ke ps lo hps hh.1
              _ ?_
            exact keysAsc_le (Nat.le_succ ke) _ hrec
        | false =>
          have hkt : ke < kt :=
            Nat.lt_of_le_of_ne hhd.1 (fun he => beqNe hbe he.symm)
          have hrec : keysAsc (ke + 1)
              (mergeRow prev pivot r0 lim ((kt, t) :: pr) es) :=
            keysAsc_mergeRow prev pivot r0 lim es ((kt, t) :: pr)
              (ke + 1) ⟨hkt, hhd.2⟩ hh.2
          cases hg : !(scaleEntry prev pivot e).isUnitRep
              && Nat.blt ke lim with
          | true =>
            refine keysAsc_fillBelow prev r0 lim ke ps lo hps hh.1
              _ ?_
            exact ⟨Nat.le_refl ke, hrec⟩
          | false =>
            refine keysAsc_fillBelow prev r0 lim ke ps lo hps hh.1
              _ ?_
            exact keysAsc_le (Nat.le_succ ke) _ hrec

/-- Every value the merge keeps is a cofactor output past the
guard, so the merged row sits off the unit class. -/
private theorem entsOk_mergeRow (prev pivot r0 : BPair) (lim : Nat) :
    ∀ es ps : List (Nat × BPair),
      entsOk (mergeRow prev pivot r0 lim ps es)
  | [], ps =>
    entsOk_keepTail (fillEntry prev r0)
      (fun _ h => offRep_fillEntry h) lim ps
  | (ke, e) :: es, ps => by
    show entsOk (match (fillBelow prev r0 lim ke ps).2 with
        | [] => (fillBelow prev r0 lim ke ps).1
            ++ scaleTail prev pivot lim ((ke, e) :: es)
        | (kt, t) :: pr =>
          match Nat.beq kt ke with
          | true =>
            match !(jointEntry prev pivot t r0 e).isUnitRep
                && Nat.blt ke lim with
            | true => (fillBelow prev r0 lim ke ps).1
                ++ (ke, jointEntry prev pivot t r0 e)
                  :: mergeRow prev pivot r0 lim pr es
            | false => (fillBelow prev r0 lim ke ps).1
                ++ mergeRow prev pivot r0 lim pr es
          | false =>
            match !(scaleEntry prev pivot e).isUnitRep
                && Nat.blt ke lim with
            | true => (fillBelow prev r0 lim ke ps).1
                ++ (ke, scaleEntry prev pivot e)
                  :: mergeRow prev pivot r0 lim ((kt, t) :: pr) es
            | false => (fillBelow prev r0 lim ke ps).1
                ++ mergeRow prev pivot r0 lim ((kt, t) :: pr) es)
    cases hb : (fillBelow prev r0 lim ke ps).2 with
    | nil =>
      exact entsOk_append _ _ (entsOk_fillBelow prev r0 lim ke ps)
        (entsOk_keepTail (scaleEntry prev pivot)
          (fun _ h => offRep_scaleEntry h) lim ((ke, e) :: es))
    | cons hd pr =>
      cases hd with
      | mk kt t =>
        show entsOk (match Nat.beq kt ke with
            | true =>
              match !(jointEntry prev pivot t r0 e).isUnitRep
                  && Nat.blt ke lim with
              | true => (fillBelow prev r0 lim ke ps).1
                  ++ (ke, jointEntry prev pivot t r0 e)
                    :: mergeRow prev pivot r0 lim pr es
              | false => (fillBelow prev r0 lim ke ps).1
                  ++ mergeRow prev pivot r0 lim pr es
            | false =>
              match !(scaleEntry prev pivot e).isUnitRep
                  && Nat.blt ke lim with
              | true => (fillBelow prev r0 lim ke ps).1
                  ++ (ke, scaleEntry prev pivot e)
                    :: mergeRow prev pivot r0 lim ((kt, t) :: pr) es
              | false => (fillBelow prev r0 lim ke ps).1
                  ++ mergeRow prev pivot r0 lim ((kt, t) :: pr) es)
        cases hbe : Nat.beq kt ke with
        | true =>
          cases hg : !(jointEntry prev pivot t r0 e).isUnitRep
              && Nat.blt ke lim with
          | true =>
            exact entsOk_append _ _
              (entsOk_fillBelow prev r0 lim ke ps)
              ⟨offRep_jointEntry (repFalseOfGuard hg),
                entsOk_mergeRow prev pivot r0 lim es pr⟩
          | false =>
            exact entsOk_append _ _
              (entsOk_fillBelow prev r0 lim ke ps)
              (entsOk_mergeRow prev pivot r0 lim es pr)
        | false =>
          cases hg : !(scaleEntry prev pivot e).isUnitRep
              && Nat.blt ke lim with
          | true =>
            exact entsOk_append _ _
              (entsOk_fillBelow prev r0 lim ke ps)
              ⟨offRep_scaleEntry (repFalseOfGuard hg),
                entsOk_mergeRow prev pivot r0 lim es ((kt, t) :: pr)⟩
          | false =>
            exact entsOk_append _ _
              (entsOk_fillBelow prev r0 lim ke ps)
              (entsOk_mergeRow prev pivot r0 lim es ((kt, t) :: pr))

/-- Below the split key the merged output reads the fill formula:
the appended block begins at the split key, so the read falls inside
the split's own fill-in. -/
private theorem keyAt_merge_low (prev r0 : BPair) (lim ke : Nat)
    (ps : List (Nat × BPair)) (lo : Nat) (hps : keysAsc lo ps)
    (Z : List (Nat × BPair)) (hZ : keysAsc ke Z) (a : Nat)
    (hak : a < ke) (hal : a < lim) :
    ground.keyAt Nat.beq BPair.unit a ((fillBelow prev r0 lim ke ps).1 ++ Z)
      = fillEntry prev r0 (ground.keyAt Nat.beq BPair.unit a ps) := by
  rw [keyAt_append_unit a Z (keyAt_lo Z hZ a hak)
      (fillBelow prev r0 lim ke ps).1,
    keyAt_fillBelow prev r0 lim ke ps lo hps a hak hal]

/-- At or above the split key the merged output reads the appended
block: the split's fill-in sits strictly below that key. -/
private theorem keyAt_merge_high (prev r0 : BPair) (lim ke : Nat)
    (ps Z : List (Nat × BPair)) (a : Nat) (hak : ¬ a < ke) :
    ground.keyAt Nat.beq BPair.unit a ((fillBelow prev r0 lim ke ps).1 ++ Z) = ground.keyAt Nat.beq BPair.unit a Z :=
  keyAt_append_below ke (fillBelow prev r0 lim ke ps).1
    (keysBelow_fillBelow_lt prev r0 lim ke ps) Z a hak

/-- The merged row's entry at every kept key is the Sylvester
formula's own cofactor: below the head key the fill formula with the
row absent, at the head key the joint or scaled arm against the two
reads, and above it the recursion. -/
private theorem keyAt_mergeRow (prev pivot r0 : BPair) (lim : Nat) :
    ∀ (es ps : List (Nat × BPair)) (lo : Nat), keysAsc lo ps →
      keysAsc lo es → ∀ a, a < lim →
        ground.keyAt Nat.beq BPair.unit a (mergeRow prev pivot r0 lim ps es)
          = cofactorAt (pivot * ground.keyAt Nat.beq BPair.unit a es
              + (r0 * ground.keyAt Nat.beq BPair.unit a ps).swap) prev
  | [], ps, lo, hps, _, a, ha => by
    show ground.keyAt Nat.beq BPair.unit a (keepTail (fillEntry prev r0) lim ps)
      = cofactorAt (pivot * BPair.unit
          + (r0 * ground.keyAt Nat.beq BPair.unit a ps).swap) prev
    rw [keyAt_keepTail (fillEntry prev r0) lim
        (fillEntry_unit prev r0) ps lo hps a ha,
      stepRead_noScale prev pivot r0 (ground.keyAt Nat.beq BPair.unit a ps)]
  | (ke, e) :: es, ps, lo, hps, hes, a, ha => by
    have hh : lo ≤ ke ∧ keysAsc (ke + 1) es := hes
    have hsnd : keysAsc ke (fillBelow prev r0 lim ke ps).2 :=
      keysAsc_fillBelow_snd prev r0 lim ke ps lo hps
    by_cases hak : a < ke
    · have hesa : ground.keyAt Nat.beq BPair.unit a ((ke, e) :: es) = BPair.unit := by
        rw [keyAt_miss (ground.beqFalse (Nat.ne_of_gt hak)) e es]
        exact keyAt_lo es hh.2 a (Nat.lt_succ_of_lt hak)
      rw [hesa, stepRead_noScale prev pivot r0 (ground.keyAt Nat.beq BPair.unit a ps)]
      show ground.keyAt Nat.beq BPair.unit a (match (fillBelow prev r0 lim ke ps).2 with
          | [] => (fillBelow prev r0 lim ke ps).1
              ++ scaleTail prev pivot lim ((ke, e) :: es)
          | (kt, t) :: pr =>
            match Nat.beq kt ke with
            | true =>
              match !(jointEntry prev pivot t r0 e).isUnitRep
                  && Nat.blt ke lim with
              | true => (fillBelow prev r0 lim ke ps).1
                  ++ (ke, jointEntry prev pivot t r0 e)
                    :: mergeRow prev pivot r0 lim pr es
              | false => (fillBelow prev r0 lim ke ps).1
                  ++ mergeRow prev pivot r0 lim pr es
            | false =>
              match !(scaleEntry prev pivot e).isUnitRep
                  && Nat.blt ke lim with
              | true => (fillBelow prev r0 lim ke ps).1
                  ++ (ke, scaleEntry prev pivot e)
                    :: mergeRow prev pivot r0 lim ((kt, t) :: pr) es
              | false => (fillBelow prev r0 lim ke ps).1
                  ++ mergeRow prev pivot r0 lim ((kt, t) :: pr) es)
        = fillEntry prev r0 (ground.keyAt Nat.beq BPair.unit a ps)
      cases hb : (fillBelow prev r0 lim ke ps).2 with
      | nil =>
        exact keyAt_merge_low prev r0 lim ke ps lo hps _
          (keysAsc_keepTail (scaleEntry prev pivot) lim
            ((ke, e) :: es) ke ⟨Nat.le_refl ke, hh.2⟩) a hak ha
      | cons hd pr =>
        cases hd with
        | mk kt t =>
          rw [hb] at hsnd
          have hhd : ke ≤ kt ∧ keysAsc (kt + 1) pr := hsnd
          show ground.keyAt Nat.beq BPair.unit a (match Nat.beq kt ke with
              | true =>
                match !(jointEntry prev pivot t r0 e).isUnitRep
                    && Nat.blt ke lim with
                | true => (fillBelow prev r0 lim ke ps).1
                    ++ (ke, jointEntry prev pivot t r0 e)
                      :: mergeRow prev pivot r0 lim pr es
                | false => (fillBelow prev r0 lim ke ps).1
                    ++ mergeRow prev pivot r0 lim pr es
              | false =>
                match !(scaleEntry prev pivot e).isUnitRep
                    && Nat.blt ke lim with
                | true => (fillBelow prev r0 lim ke ps).1
                    ++ (ke, scaleEntry prev pivot e)
                      :: mergeRow prev pivot r0 lim ((kt, t) :: pr) es
                | false => (fillBelow prev r0 lim ke ps).1
                    ++ mergeRow prev pivot r0 lim ((kt, t) :: pr) es)
            = fillEntry prev r0 (ground.keyAt Nat.beq BPair.unit a ps)
          cases hbe : Nat.beq kt ke with
          | true =>
            have hkt : kt = ke := ground.beqEq kt ke hbe
            have hpr : keysAsc (ke + 1) pr := by
              rw [← hkt]; exact hhd.2
            have hrec : keysAsc (ke + 1)
                (mergeRow prev pivot r0 lim pr es) :=
              keysAsc_mergeRow prev pivot r0 lim es pr (ke + 1)
                hpr hh.2
            cases hg : !(jointEntry prev pivot t r0 e).isUnitRep
                && Nat.blt ke lim with
            | true =>
              exact keyAt_merge_low prev r0 lim ke ps lo hps
                ((ke, jointEntry prev pivot t r0 e)
                  :: mergeRow prev pivot r0 lim pr es)
                ⟨Nat.le_refl ke, hrec⟩ a hak ha
            | false =>
              exact keyAt_merge_low prev r0 lim ke ps lo hps _
                (keysAsc_le (Nat.le_succ ke) _ hrec) a hak ha
          | false =>
            have hkt : ke < kt :=
              Nat.lt_of_le_of_ne hhd.1 (fun he => beqNe hbe he.symm)
            have hrec : keysAsc (ke + 1)
                (mergeRow prev pivot r0 lim ((kt, t) :: pr) es) :=
              keysAsc_mergeRow prev pivot r0 lim es ((kt, t) :: pr)
                (ke + 1) ⟨hkt, hhd.2⟩ hh.2
            cases hg : !(scaleEntry prev pivot e).isUnitRep
                && Nat.blt ke lim with
            | true =>
              exact keyAt_merge_low prev r0 lim ke ps lo hps
                ((ke, scaleEntry prev pivot e)
                  :: mergeRow prev pivot r0 lim ((kt, t) :: pr) es)
                ⟨Nat.le_refl ke, hrec⟩ a hak ha
            | false =>
              exact keyAt_merge_low prev r0 lim ke ps lo hps _
                (keysAsc_le (Nat.le_succ ke) _ hrec) a hak ha
    · rw [(keyAt_fillBelow_snd prev r0 lim ke ps a hak).symm]
      show ground.keyAt Nat.beq BPair.unit a (match (fillBelow prev r0 lim ke ps).2 with
          | [] => (fillBelow prev r0 lim ke ps).1
              ++ scaleTail prev pivot lim ((ke, e) :: es)
          | (kt, t) :: pr =>
            match Nat.beq kt ke with
            | true =>
              match !(jointEntry prev pivot t r0 e).isUnitRep
                  && Nat.blt ke lim with
              | true => (fillBelow prev r0 lim ke ps).1
                  ++ (ke, jointEntry prev pivot t r0 e)
                    :: mergeRow prev pivot r0 lim pr es
              | false => (fillBelow prev r0 lim ke ps).1
                  ++ mergeRow prev pivot r0 lim pr es
            | false =>
              match !(scaleEntry prev pivot e).isUnitRep
                  && Nat.blt ke lim with
              | true => (fillBelow prev r0 lim ke ps).1
                  ++ (ke, scaleEntry prev pivot e)
                    :: mergeRow prev pivot r0 lim ((kt, t) :: pr) es
              | false => (fillBelow prev r0 lim ke ps).1
                  ++ mergeRow prev pivot r0 lim ((kt, t) :: pr) es)
        = cofactorAt (pivot * ground.keyAt Nat.beq BPair.unit a ((ke, e) :: es)
            + (r0 * ground.keyAt Nat.beq BPair.unit a (fillBelow prev r0 lim ke ps).2).swap)
          prev
      cases hb : (fillBelow prev r0 lim ke ps).2 with
      | nil =>
        rw [keyAt_merge_high prev r0 lim ke ps _ a hak,
          show ground.keyAt Nat.beq BPair.unit a ([] : List (Nat × BPair)) = BPair.unit from rfl,
          stepRead_noFill prev pivot r0 (ground.keyAt Nat.beq BPair.unit a ((ke, e) :: es))]
        exact keyAt_keepTail (scaleEntry prev pivot) lim
          (scaleEntry_unit prev pivot) ((ke, e) :: es) lo hes a ha
      | cons hd pr =>
        cases hd with
        | mk kt t =>
          rw [hb] at hsnd
          have hhd : ke ≤ kt ∧ keysAsc (kt + 1) pr := hsnd
          show ground.keyAt Nat.beq BPair.unit a (match Nat.beq kt ke with
              | true =>
                match !(jointEntry prev pivot t r0 e).isUnitRep
                    && Nat.blt ke lim with
                | true => (fillBelow prev r0 lim ke ps).1
                    ++ (ke, jointEntry prev pivot t r0 e)
                      :: mergeRow prev pivot r0 lim pr es
                | false => (fillBelow prev r0 lim ke ps).1
                    ++ mergeRow prev pivot r0 lim pr es
              | false =>
                match !(scaleEntry prev pivot e).isUnitRep
                    && Nat.blt ke lim with
                | true => (fillBelow prev r0 lim ke ps).1
                    ++ (ke, scaleEntry prev pivot e)
                      :: mergeRow prev pivot r0 lim ((kt, t) :: pr) es
                | false => (fillBelow prev r0 lim ke ps).1
                    ++ mergeRow prev pivot r0 lim ((kt, t) :: pr) es)
            = cofactorAt (pivot * ground.keyAt Nat.beq BPair.unit a ((ke, e) :: es)
                + (r0 * ground.keyAt Nat.beq BPair.unit a ((kt, t) :: pr)).swap) prev
          cases hbe : Nat.beq kt ke with
          | true =>
            have hkt : kt = ke := ground.beqEq kt ke hbe
            have hpr : keysAsc (ke + 1) pr := by
              rw [← hkt]; exact hhd.2
            cases hbke : Nat.beq ke a with
            | true =>
              have hka : ke = a := ground.beqEq ke a hbke
              have hbta : Nat.beq kt a = true := by
                rw [hkt]; exact hbke
              rw [keyAt_hit hbke e es, keyAt_hit hbta t pr]
              cases hg : !(jointEntry prev pivot t r0 e).isUnitRep
                  && Nat.blt ke lim with
              | true =>
                rw [keyAt_merge_high prev r0 lim ke ps _ a hak]
                exact keyAt_hit hbke (jointEntry prev pivot t r0 e)
                  (mergeRow prev pivot r0 lim pr es)
              | false =>
                rw [keyAt_merge_high prev r0 lim ke ps _ a hak]
                have hkl : Nat.blt ke lim = true := by
                  rw [hka]; exact ltBlt ha
                have hje : jointEntry prev pivot t r0 e = BPair.unit :=
                  BPair.unit_of_isUnitRep (repOfGuardFalse hkl hg)
                rw [keyAt_mergeRow prev pivot r0 lim es pr (ke + 1)
                    hpr hh.2 a ha,
                  keyAt_lo es hh.2 a
                    (Nat.lt_succ_of_le (Nat.le_of_eq hka.symm)),
                  keyAt_lo pr hpr a
                    (Nat.lt_succ_of_le (Nat.le_of_eq hka.symm)),
                  stepRead_null prev pivot r0]
                exact hje.symm
            | false =>
              rw [keyAt_miss hbke e es,
                keyAt_miss
                  (beqFalse (fun he => beqNe hbke (hkt.symm.trans he)))
                  t pr]
              cases hg : !(jointEntry prev pivot t r0 e).isUnitRep
                  && Nat.blt ke lim with
              | true =>
                rw [keyAt_merge_high prev r0 lim ke ps _ a hak,
                  keyAt_miss hbke (jointEntry prev pivot t r0 e)
                    (mergeRow prev pivot r0 lim pr es)]
                exact keyAt_mergeRow prev pivot r0 lim es pr (ke + 1)
                  hpr hh.2 a ha
              | false =>
                rw [keyAt_merge_high prev r0 lim ke ps _ a hak]
                exact keyAt_mergeRow prev pivot r0 lim es pr (ke + 1)
                  hpr hh.2 a ha
          | false =>
            have hkt : ke < kt :=
              Nat.lt_of_le_of_ne hhd.1 (fun he => beqNe hbe he.symm)
            have hprA : keysAsc (ke + 1) ((kt, t) :: pr) :=
              ⟨hkt, hhd.2⟩
            cases hbke : Nat.beq ke a with
            | true =>
              have hka : ke = a := ground.beqEq ke a hbke
              have hpra : ground.keyAt Nat.beq BPair.unit a ((kt, t) :: pr) = BPair.unit :=
                keyAt_lo ((kt, t) :: pr) hprA a
                  (Nat.lt_succ_of_le (Nat.le_of_eq hka.symm))
              rw [keyAt_hit hbke e es, hpra,
                stepRead_noFill prev pivot r0 e]
              cases hg : !(scaleEntry prev pivot e).isUnitRep
                  && Nat.blt ke lim with
              | true =>
                rw [keyAt_merge_high prev r0 lim ke ps _ a hak]
                exact keyAt_hit hbke (scaleEntry prev pivot e)
                  (mergeRow prev pivot r0 lim ((kt, t) :: pr) es)
              | false =>
                rw [keyAt_merge_high prev r0 lim ke ps _ a hak]
                have hkl : Nat.blt ke lim = true := by
                  rw [hka]; exact ltBlt ha
                have hse : scaleEntry prev pivot e = BPair.unit :=
                  BPair.unit_of_isUnitRep (repOfGuardFalse hkl hg)
                rw [keyAt_mergeRow prev pivot r0 lim es
                    ((kt, t) :: pr) (ke + 1) hprA hh.2 a ha,
                  keyAt_lo es hh.2 a
                    (Nat.lt_succ_of_le (Nat.le_of_eq hka.symm)),
                  hpra, stepRead_null prev pivot r0]
                exact hse.symm
            | false =>
              rw [keyAt_miss hbke e es]
              cases hg : !(scaleEntry prev pivot e).isUnitRep
                  && Nat.blt ke lim with
              | true =>
                rw [keyAt_merge_high prev r0 lim ke ps _ a hak,
                  keyAt_miss hbke (scaleEntry prev pivot e)
                    (mergeRow prev pivot r0 lim ((kt, t) :: pr) es)]
                exact keyAt_mergeRow prev pivot r0 lim es
                  ((kt, t) :: pr) (ke + 1) hprA hh.2 a ha
              | false =>
                rw [keyAt_merge_high prev r0 lim ke ps _ a hak]
                exact keyAt_mergeRow prev pivot r0 lim es
                  ((kt, t) :: pr) (ke + 1) hprA hh.2 a ha

/-- One row's update keeps the ascending keys at either arm. -/
private theorem keysAsc_stepSRow (prev pivot r0 : BPair)
    (lim : Nat) (ps es : List (Nat × BPair)) (hps : keysAsc 0 ps)
    (hes : keysAsc 0 es) :
    keysAsc 0 (stepSRow prev pivot r0 lim ps es) := by
  show keysAsc 0 (match r0.isUnitRep with
      | true => scaleTail prev pivot lim es
      | false => mergeRow prev pivot r0 lim ps es)
  cases r0.isUnitRep with
  | true =>
    exact keysAsc_keepTail (scaleEntry prev pivot) lim es 0 hes
  | false =>
    exact keysAsc_mergeRow prev pivot r0 lim es ps 0 hps hes

/-- One row's update stores no value at the unit class: every kept
value passed the guard and is an exact cofactor's own output. -/
private theorem entsOk_stepSRow (prev pivot r0 : BPair)
    (lim : Nat) (ps es : List (Nat × BPair)) :
    entsOk (stepSRow prev pivot r0 lim ps es) := by
  show entsOk (match r0.isUnitRep with
      | true => scaleTail prev pivot lim es
      | false => mergeRow prev pivot r0 lim ps es)
  cases r0.isUnitRep with
  | true =>
    exact entsOk_keepTail (scaleEntry prev pivot)
      (fun _ h => offRep_scaleEntry h) lim es
  | false => exact entsOk_mergeRow prev pivot r0 lim es ps

/-- The stepped row's entry at every kept key is the Sylvester
formula's own cofactor at the two rows' reads: at a pivot column on
the unit class the fill summand is equal-membered and withdraws,
leaving the row's own scaling, and off it the merge answers whole. -/
private theorem keyAt_stepSRow (prev pivot r0 : BPair) (lim : Nat)
    (ps es : List (Nat × BPair)) (hps : keysAsc 0 ps)
    (hes : keysAsc 0 es) : ∀ a, a < lim →
      ground.keyAt Nat.beq BPair.unit a (stepSRow prev pivot r0 lim ps es)
        = cofactorAt (pivot * ground.keyAt Nat.beq BPair.unit a es
            + (r0 * ground.keyAt Nat.beq BPair.unit a ps).swap) prev := by
  intro a ha
  show ground.keyAt Nat.beq BPair.unit a (match r0.isUnitRep with
      | true => scaleTail prev pivot lim es
      | false => mergeRow prev pivot r0 lim ps es)
    = cofactorAt (pivot * ground.keyAt Nat.beq BPair.unit a es + (r0 * ground.keyAt Nat.beq BPair.unit a ps).swap) prev
  cases hr : r0.isUnitRep with
  | true =>
    show ground.keyAt Nat.beq BPair.unit a (keepTail (scaleEntry prev pivot) lim es)
      = cofactorAt (pivot * ground.keyAt Nat.beq BPair.unit a es
          + (r0 * ground.keyAt Nat.beq BPair.unit a ps).swap) prev
    rw [BPair.unit_of_isUnitRep hr,
      stepRead_unitCol prev pivot (ground.keyAt Nat.beq BPair.unit a es) (ground.keyAt Nat.beq BPair.unit a ps)]
    exact keyAt_keepTail (scaleEntry prev pivot) lim
      (scaleEntry_unit prev pivot) es 0 hes a ha
  | false =>
    exact keyAt_mergeRow prev pivot r0 lim es ps 0 hps hes a ha

/-- The honest row's sparse walk stores ascending keys from its own
starting key: a kept key is that key and the walk continues one
higher, a skipped key handing the floor down. -/
private theorem keysAsc_ofRowFrom : ∀ (r : List BPair) (k : Nat),
    keysAsc k (ofRowFrom k r)
  | [], _ => trivial
  | e :: es, k => by
    show keysAsc k (match (e.norm).isUnitRep with
        | true => ofRowFrom (k + 1) es
        | false => (k, e.norm) :: ofRowFrom (k + 1) es)
    cases (e.norm).isUnitRep with
    | true =>
      exact keysAsc_le (Nat.le_succ k) (ofRowFrom (k + 1) es)
        (keysAsc_ofRowFrom es (k + 1))
    | false => exact ⟨Nat.le_refl k, keysAsc_ofRowFrom es (k + 1)⟩

/-- The honest row's sparse walk stores no value at the unit class:
every kept value is a canonical representative past the guard. -/
private theorem entsOk_ofRowFrom : ∀ (r : List BPair) (k : Nat),
    entsOk (ofRowFrom k r)
  | [], _ => trivial
  | e :: es, k => by
    show entsOk (match (e.norm).isUnitRep with
        | true => ofRowFrom (k + 1) es
        | false => (k, e.norm) :: ofRowFrom (k + 1) es)
    cases hu : (e.norm).isUnitRep with
    | true => exact entsOk_ofRowFrom es (k + 1)
    | false => exact ⟨offRep_norm hu, entsOk_ofRowFrom es (k + 1)⟩

/-- The dense reading sits at the stated width, one entry per
column key. -/
private theorem length_denseRow (w : Nat) (r : SRow) :
    (denseRow w r).length = w :=
  ground.length_mapRange _ w

/-- The dense reading's entry at a column key inside the width is
the sparse row's own read there. -/
private theorem getAt_denseRow (w : Nat) (r : SRow) (c : Nat)
    (hc : c < w) :
    ground.getAt BPair.unit (denseRow w r) c = ground.keyAt Nat.beq BPair.unit c r.2 := by
  show ground.getAt BPair.unit
      ((List.range w).map (fun x => ground.keyAt Nat.beq BPair.unit x r.2)) c = ground.keyAt Nat.beq BPair.unit c r.2
  rw [ground.getAt_map 0 BPair.unit (fun x => ground.keyAt Nat.beq BPair.unit x r.2)
      (List.range w) c (by rw [ground.length_range]; exact hc),
    ground.getAt_range w c hc]

/-- The peeled row's dense reading is the dense reading with the
pivot column struck: the peel's key lift is exactly the erasure's
own entry read. -/
private theorem denseRow_sPeel (w j : Nat) (r : SRow)
    (hr : keysAsc 0 r.2) (hj : j < w) :
    denseRow (w - 1) ((sPeel j r).2) = strike j (denseRow w r) := by
  cases w with
  | zero => exact absurd hj (Nat.not_lt_zero j)
  | succ w' =>
    have hjlen : j < (denseRow (w' + 1) r).length := by
      rw [length_denseRow]; exact hj
    show denseRow w' ((sPeel j r).2) = strike j (denseRow (w' + 1) r)
    refine ground.getAt_ext BPair.unit _ _ ?_ ?_
    · rw [length_denseRow]
      exact (Nat.succ.inj
        ((ground.length_eraseIdx (denseRow (w' + 1) r) j hjlen).trans
          (length_denseRow (w' + 1) r))).symm
    · intro i hi
      rw [length_denseRow] at hi
      rw [getAt_denseRow w' ((sPeel j r).2) i hi]
      show ground.keyAt Nat.beq BPair.unit i (peel j r.2).2
        = ground.getAt BPair.unit
          ((denseRow (w' + 1) r).eraseIdx j) i
      rw [keyAt_peel j r.2 hr i,
        getAt_eraseIdx BPair.unit (denseRow (w' + 1) r) j i]
      by_cases hij : i < j
      · rw [if_pos hij,
          getAt_denseRow (w' + 1) r i (Nat.lt_trans hij hj),
          show liftIx j i = i from by
            show (if i < j then i else i + 1) = i
            rw [if_pos hij]]
      · rw [if_neg hij,
          getAt_denseRow (w' + 1) r (i + 1) (Nat.succ_lt_succ hi),
          liftIx_gt j i hij]

/-- The honest row's sparse walk reads back one value with the row
at every column key: a stored key carries the entry's canonical
representative, and a skipped key carries the sum's unit against an
entry whose representative is the unit. -/
private theorem keyAt_ofRowFrom : ∀ (r : List BPair) (k c : Nat),
    (ground.keyAt Nat.beq BPair.unit (k + c) (ofRowFrom k r)).oneValue
      (ground.getAt BPair.unit r c)
  | [], _, _ => BPair.oneValue_refl BPair.unit
  | e :: es, k, 0 => by
    show (ground.keyAt Nat.beq BPair.unit k (match (e.norm).isUnitRep with
        | true => ofRowFrom (k + 1) es
        | false => (k, e.norm) :: ofRowFrom (k + 1) es)).oneValue e
    cases hu : (e.norm).isUnitRep with
    | true =>
      show (ground.keyAt Nat.beq BPair.unit k (ofRowFrom (k + 1) es)).oneValue e
      rw [keyAt_lo (ofRowFrom (k + 1) es)
          (keysAsc_ofRowFrom es (k + 1)) k
          (Nat.lt_succ_of_le (Nat.le_refl k)),
        ← BPair.unit_of_isUnitRep hu]
      exact BPair.norm_oneValue e
    | false =>
      show (ground.keyAt Nat.beq BPair.unit k ((k, e.norm) :: ofRowFrom (k + 1) es)).oneValue e
      rw [keyAt_hit (ground.beqRefl k) (e.norm)
        (ofRowFrom (k + 1) es)]
      exact BPair.norm_oneValue e
  | e :: es, k, c + 1 => by
    have hih := keyAt_ofRowFrom es (k + 1) c
    rw [Nat.succ_add k c] at hih
    show (ground.keyAt Nat.beq BPair.unit (k + c + 1) (match (e.norm).isUnitRep with
        | true => ofRowFrom (k + 1) es
        | false => (k, e.norm) :: ofRowFrom (k + 1) es)).oneValue
      (ground.getAt BPair.unit es c)
    cases hu : (e.norm).isUnitRep with
    | true =>
      show (ground.keyAt Nat.beq BPair.unit (k + c + 1) (ofRowFrom (k + 1) es)).oneValue
        (ground.getAt BPair.unit es c)
      exact hih
    | false =>
      show (ground.keyAt Nat.beq BPair.unit (k + c + 1)
          ((k, e.norm) :: ofRowFrom (k + 1) es)).oneValue
        (ground.getAt BPair.unit es c)
      rw [keyAt_miss (beqFalse (Nat.ne_of_lt
          (Nat.lt_succ_of_le (Nat.le_add_right k c)))) (e.norm)
        (ofRowFrom (k + 1) es)]
      exact hih

/-- The honest row's sparse reading reads back one value with the
row at its own width. -/
private theorem denseRow_ofRow : ∀ r : List BPair,
    poly.oneValue (denseRow r.length (ofRow r)) r := by
  intro r
  have hmem : ∀ c : Nat,
      (ground.keyAt Nat.beq BPair.unit c (ofRowFrom 0 r)).oneValue
        (ground.getAt BPair.unit r c) := by
    intro c
    have h := keyAt_ofRowFrom r 0 c
    rw [Nat.zero_add] at h
    exact h
  have h := poly.oneValue_map (fun c => ground.keyAt Nat.beq BPair.unit c (ofRowFrom 0 r)) (ground.getAt BPair.unit r) (List.range r.length) (fun x _ => hmem x)
  rw [ground.range_map_getAt BPair.unit r.length r rfl] at h
  exact h

/-! The descent state names the minors: each working entry is one
value with the determinant of its pivot-bordered selection of the
original list — `def:elim`'s naming, the pivot lists in crossing
order — and one round preserves the naming through Sylvester's
identity at the crossed square selection, the computed cofactor
read back exactly at the prior pivot: the update display, each
division exact. -/

/-- The selection at stated row and column key lists: the minor
carrier of the descent's naming, rows and columns in the lists'
own order. -/
private def sel (m : Mat) (rs cs : List Nat) : Mat :=
  rs.map (fun i => keepCols cs (ground.getAt [] m i))

/-- Every row's stored keys ascending with the values off the unit
class: the state the correspondence tier reads at. -/
private def rowsOk : List SRow → Prop
  | [] => True
  | r :: t => (keysAsc 0 r.2 ∧ entsOk r.2) ∧ rowsOk t

/-- The descent state's naming: the accumulator one value with the
leading selection's determinant and off the unit, every stored
entry one value with its own bordered selection's determinant, the
remaining row and column keys the stated index lists, the widths
and the walk order the sparse tier's own. -/
private structure KInv (m : Mat) (rs cs ri cj : List Nat)
    (prev : BPair) (rows : List SRow) : Prop where
  prevRead : prev.oneValue (detL (sel m rs cs))
  prevOff : ¬ prev.oneValue BPair.unit
  lenCs : cs.length = rs.length
  lenRows : rows.length = ri.length
  widths : SInv cj.length rows
  sorted : rowsOk rows
  entries : ∀ a, a < rows.length → ∀ c, c < cj.length →
    (ground.keyAt Nat.beq BPair.unit c (ground.getAt ((0, []) : SRow) rows a).2).oneValue
      (detL (sel m (rs ++ [ground.getAt 0 ri a])
        (cs ++ [ground.getAt 0 cj c])))

/-- Two entries joined one after the other join at once. -/
private theorem appendPair {α : Type} (a b : α)
    (xs : List α) : (xs ++ [a]) ++ [b] = xs ++ [a, b] :=
  ground.append_assoc xs [a] [b]

/-- The selection's row count is its row key list's. -/
private theorem sel_len (m : Mat) (rs cs : List Nat) :
    (sel m rs cs).length = rs.length := by
  show (rs.map (fun i => keepCols cs (ground.getAt [] m i))).length
    = rs.length
  rw [ground.length_map]

/-- The selection's row at a place: the kept columns of the source
row its row key list names there. -/
private theorem getAt_sel (m : Mat) (rs cs : List Nat) (a : Nat)
    (ha : a < rs.length) :
    ground.getAt [] (sel m rs cs) a
      = keepCols cs (ground.getAt [] m (ground.getAt 0 rs a)) := by
  show ground.getAt []
      (rs.map (fun i => keepCols cs (ground.getAt [] m i))) a = _
  rw [ground.getAt_map 0 [] _ rs a ha]

/-- An entry below the first list's width reads that list. -/
private theorem getAt_append_lt {α : Type} (d : α) (xs ys : List α)
    {a : Nat} (ha : a < xs.length) :
    ground.getAt d (xs ++ ys) a = ground.getAt d xs a :=
  (ground.getAt_append d xs ys a).trans (if_pos ha)

/-- The entry at the first list's own width reads the second
list's head. -/
private theorem getAt_append_at {α : Type} (d : α) (xs ys : List α) :
    ground.getAt d (xs ++ ys) xs.length = ground.getAt d ys 0 :=
  (congrArg (ground.getAt d (xs ++ ys))
    (Nat.add_zero xs.length)).symm.trans
    (ground.getAt_append_add d xs ys 0)

/-- The leading keys of a grown column list keep the base list's
own kept columns. -/
private theorem keepCols_lead (cs ys : List Nat) (r : List BPair)
    (K : Nat) (hcs : cs.length = K) :
    keepCols (List.range K) (keepCols (cs ++ ys) r)
      = keepCols cs r := by
  refine ground.getAt_ext BPair.unit _ _ ?_ ?_
  · rw [keepCols_len, keepCols_len, ground.length_range, hcs]
  · intro b hb
    rw [keepCols_len, ground.length_range] at hb
    have hbr : b < (List.range K).length := by
      rw [ground.length_range]
      exact hb
    have hbc : b < (cs ++ ys).length := by
      rw [ground.length_append, hcs]
      exact Nat.lt_of_lt_of_le hb (Nat.le_add_right K ys.length)
    have hbs : b < cs.length := by
      rw [hcs]
      exact hb
    rw [keepCols_entry (List.range K) _ b hbr,
      ground.getAt_range K b hb,
      keepCols_entry (cs ++ ys) r b hbc,
      getAt_append_lt 0 cs ys hbs,
      keepCols_entry cs r b hbs]

/-- The bordered keys of a grown column list keep the base list
grown by the border key's own read. -/
private theorem keepCols_border (cs ys : List Nat) (r : List BPair)
    (K j : Nat) (hcs : cs.length = K)
    (hj : j < cs.length + ys.length) :
    keepCols (List.range K ++ [j]) (keepCols (cs ++ ys) r)
      = keepCols (cs ++ [ground.getAt 0 (cs ++ ys) j]) r := by
  have hjc : j < (cs ++ ys).length := by
    rw [ground.length_append]
    exact hj
  refine ground.getAt_ext BPair.unit _ _ ?_ ?_
  · rw [keepCols_len, keepCols_len, borderKeys_len,
      ground.length_append, hcs]
    rfl
  · intro b hb
    rw [keepCols_len, borderKeys_len] at hb
    have hbk : b < (List.range K ++ [j]).length := by
      rw [borderKeys_len]
      exact hb
    have hbn : b < (cs ++ [ground.getAt 0 (cs ++ ys) j]).length := by
      rw [ground.length_append, hcs]
      exact hb
    rw [keepCols_entry (List.range K ++ [j]) _ b hbk,
      borderKeys K j b hb,
      keepCols_entry (cs ++ [ground.getAt 0 (cs ++ ys) j]) r b hbn]
    by_cases hbK : b < K
    · have hbs : b < cs.length := by
        rw [hcs]
        exact hbK
      have hbj : b < (cs ++ ys).length := by
        rw [ground.length_append, hcs]
        exact Nat.lt_of_lt_of_le hbK
          (Nat.le_add_right K ys.length)
      rw [if_pos hbK, keepCols_entry (cs ++ ys) r b hbj,
        getAt_append_lt 0 cs ys hbs,
        getAt_append_lt 0 cs
          [ground.getAt 0 (cs ++ ys) j] hbs]
    · have hbe : b = cs.length := by
        rw [hcs]
        exact Nat.le_antisymm (Nat.le_of_succ_le_succ hb)
          (Nat.le_of_not_lt hbK)
      rw [if_neg hbK, keepCols_entry (cs ++ ys) r j hjc, hbe,
        getAt_append_at 0 cs
          [ground.getAt 0 (cs ++ ys) j]]
      rfl

/-- The leading selection of a selection reads the base lists: the
range keys pick the stated prefixes. -/
private theorem leadAt_sel (m : Mat) (rs cs xs ys : List Nat)
    (hcs : cs.length = rs.length) :
    leadAt rs.length (sel m (rs ++ xs) (cs ++ ys)) = sel m rs cs := by
  refine ground.getAt_ext ([] : List BPair) _ _ ?_ ?_
  · rw [leadAt_len, sel_len]
  · intro a ha
    rw [leadAt_len] at ha
    have hax : a < (rs ++ xs).length := by
      rw [ground.length_append]
      exact Nat.lt_of_lt_of_le ha (Nat.le_add_right rs.length xs.length)
    show ground.getAt []
        ((List.range rs.length).map (fun b =>
          keepCols (List.range rs.length)
            (ground.getAt [] (sel m (rs ++ xs) (cs ++ ys)) b))) a
      = ground.getAt [] (sel m rs cs) a
    rw [ground.getAt_map 0 [] _ (List.range rs.length) a
        (by rw [ground.length_range]; exact ha),
      ground.getAt_range rs.length a ha,
      getAt_sel m (rs ++ xs) (cs ++ ys) a hax,
      getAt_append_lt 0 rs xs ha,
      keepCols_lead cs ys _ rs.length hcs,
      getAt_sel m rs cs a ha]

/-- The bordered selection of a selection reads the base lists
grown by the border keys' own reads: selection composes. -/
private theorem borderAt_sel (m : Mat) (rs cs xs ys : List Nat)
    (i j : Nat) (hcs : cs.length = rs.length)
    (hi : i < rs.length + xs.length)
    (hj : j < cs.length + ys.length) :
    borderAt rs.length i j (sel m (rs ++ xs) (cs ++ ys))
      = sel m (rs ++ [ground.getAt 0 (rs ++ xs) i])
          (cs ++ [ground.getAt 0 (cs ++ ys) j]) := by
  refine ground.getAt_ext ([] : List BPair) _ _ ?_ ?_
  · rw [borderAt_len, sel_len, ground.length_append]
    rfl
  · intro a ha
    rw [borderAt_len] at ha
    have han : a < (rs ++ [ground.getAt 0 (rs ++ xs) i]).length := by
      rw [ground.length_append]
      exact ha
    have hax : (if a < rs.length then a else i)
        < (rs ++ xs).length := by
      rw [ground.length_append]
      by_cases hak : a < rs.length
      · rw [if_pos hak]
        exact Nat.lt_of_lt_of_le hak
          (Nat.le_add_right rs.length xs.length)
      · rw [if_neg hak]
        exact hi
    have hkey : ground.getAt 0 (rs ++ xs)
          (if a < rs.length then a else i)
        = ground.getAt 0 (rs ++ [ground.getAt 0 (rs ++ xs) i])
          a := by
      by_cases hak : a < rs.length
      · rw [if_pos hak,
          getAt_append_lt 0 rs xs hak,
          getAt_append_lt 0 rs
            [ground.getAt 0 (rs ++ xs) i] hak]
      · have hae : a = rs.length :=
          Nat.le_antisymm (Nat.le_of_succ_le_succ ha)
            (Nat.le_of_not_lt hak)
        rw [if_neg hak, hae,
          getAt_append_at 0 rs
            [ground.getAt 0 (rs ++ xs) i]]
        rfl
    rw [borderAt_row rs.length i j (sel m (rs ++ xs) (cs ++ ys)) a ha,
      getAt_sel m (rs ++ xs) (cs ++ ys) _ hax,
      keepCols_border cs ys _ rs.length j hcs hj, hkey,
      getAt_sel m (rs ++ [ground.getAt 0 (rs ++ xs) i])
        (cs ++ [ground.getAt 0 (cs ++ ys) j]) a han]

/-- A selection grown by one border key is its own bordered
selection at the base row count. -/
private theorem borderAt_full (m : Mat) (rs cs : List Nat)
    (x y : Nat) (hcs : cs.length = rs.length) :
    borderAt rs.length rs.length rs.length
        (sel m (rs ++ [x]) (cs ++ [y]))
      = sel m (rs ++ [x]) (cs ++ [y]) := by
  have hrow : ground.getAt 0 (rs ++ [x]) rs.length = x :=
    ground.getAt_append_add 0 rs [x] 0
  have hcol : ground.getAt 0 (cs ++ [y]) rs.length = y := by
    rw [← hcs]
    exact ground.getAt_append_add 0 cs [y] 0
  rw [borderAt_sel m rs cs [x] [y] rs.length rs.length hcs
      (Nat.lt_succ_self rs.length)
      (by rw [hcs]; exact Nat.lt_succ_self rs.length),
    hrow, hcol]

/-- A selection at a border-grown pair of lists is square at its
own row count. -/
private theorem sel_sq (m : Mat) (rs cs : List Nat)
    (hcs : cs.length = rs.length) :
    rowsLen (sel m rs cs).length (sel m rs cs) := by
  rw [sel_len]
  exact rowsLen_map (fun i => keepCols cs (ground.getAt [] m i)) rs.length rs (fun x _ => (fun _ => by rw [keepCols_len, hcs]) x)

/-- The found pivot sits stored at the found row's head key: the
walk answers at the first occupied row's first entry. -/
private theorem sFind_at : ∀ (rows : List SRow) (i j : Nat),
    sFind rows = some (i, j) →
    ∃ v es, (ground.getAt ((0, []) : SRow) rows i).2 = (j, v) :: es
  | [], _, _, h => nomatch h
  | (c, []) :: rest, i, j, h => by
    revert h
    show (match sFind rest with
        | none => none
        | some (a, b) => some (a + 1, b)) = some (i, j) →
      ∃ v es, (ground.getAt ((0, []) : SRow)
        ((c, []) :: rest) i).2 = (j, v) :: es
    cases hfr : sFind rest with
    | none =>
      intro h
      exact nomatch h
    | some ij =>
      intro h
      have hi : ij.1 + 1 = i := congrArg Prod.fst (Option.some.inj h)
      have hj : ij.2 = j := congrArg Prod.snd (Option.some.inj h)
      rw [← hi, ← hj]
      exact sFind_at rest ij.1 ij.2 hfr
  | (_, (k, v) :: es) :: _, i, j, h => by
    have h' : ((0, k) : Nat × Nat) = (i, j) := Option.some.inj h
    have hi : (0 : Nat) = i := congrArg Prod.fst h'
    have hj : k = j := congrArg Prod.snd h'
    rw [← hi, ← hj]
    exact ⟨v, es, rfl⟩

/-- The empty selection's determinant is the product's one. -/
private theorem detL_nil : (detL ([] : Mat)).oneValue
    (BPair.ofPos .one) :=
  detO_nil (R := ground.bpairRead) bpairLaws

/-- A one-by-one selection's determinant is its own entry. -/
private theorem detL_single (x : BPair) :
    (detL [[x]]).oneValue x := detO_single (R := ground.bpairRead) bpairLaws x

/-- A framed matrix's sparse reading sits at the sortedness: every
row's walk stores ascending keys off the unit class. -/
private theorem rowsOk_ofRow : ∀ m : Mat, rowsOk (m.map ofRow)
  | [] => trivial
  | r :: t =>
    ⟨⟨keysAsc_ofRowFrom r 0, entsOk_ofRowFrom r 0⟩,
      rowsOk_ofRow t⟩

/-- The sortedness reads at every row inside the list. -/
private theorem rowsOk_getAt : ∀ (rows : List SRow) (a : Nat),
    rowsOk rows → a < rows.length →
      keysAsc 0 (ground.getAt ((0, []) : SRow) rows a).2
      ∧ entsOk (ground.getAt ((0, []) : SRow) rows a).2
  | [], _, _, ha => absurd ha (Nat.not_lt_zero _)
  | r :: t, 0, h, _ => by
    have hh : (keysAsc 0 r.2 ∧ entsOk r.2) ∧ rowsOk t := h
    exact hh.1
  | r :: t, a + 1, h, ha => by
    have hh : (keysAsc 0 r.2 ∧ entsOk r.2) ∧ rowsOk t := h
    exact rowsOk_getAt t a hh.2 (Nat.lt_of_succ_lt_succ ha)

/-- The sortedness survives a struck row. -/
private theorem rowsOk_eraseIdx : ∀ (rows : List SRow) (i : Nat),
    rowsOk rows → rowsOk (rows.eraseIdx i)
  | [], _, _ => trivial
  | r :: t, 0, h => by
    have hh : (keysAsc 0 r.2 ∧ entsOk r.2) ∧ rowsOk t := h
    exact hh.2
  | r :: t, i + 1, h => by
    have hh : (keysAsc 0 r.2 ∧ entsOk r.2) ∧ rowsOk t := h
    exact ⟨hh.1, rowsOk_eraseIdx t i hh.2⟩

/-- One round's stepped rows stay sorted: the update's kept keys
ascend off the peeled inputs' own and store no unit value. -/
private theorem rowsOk_stepRows (prev : BPair) (p : BPair × SRow)
    (j : Nat) (hp : keysAsc 0 p.2.2) : ∀ rows : List SRow,
    rowsOk rows → rowsOk (stepRows prev p j rows)
  | [], _ => trivial
  | r :: t, h => by
    have hh : (keysAsc 0 r.2 ∧ entsOk r.2) ∧ rowsOk t := h
    show ((keysAsc 0 (stepSRow prev p.1 (sPeel j r).1
          (ground.natMin p.2.1 (sPeel j r).2.1) p.2.2 (sPeel j r).2.2)
        ∧ entsOk (stepSRow prev p.1 (sPeel j r).1
          (ground.natMin p.2.1 (sPeel j r).2.1) p.2.2 (sPeel j r).2.2))
      ∧ rowsOk (stepRows prev p j t))
    exact ⟨⟨keysAsc_stepSRow prev p.1 (sPeel j r).1
        (ground.natMin p.2.1 (sPeel j r).2.1) p.2.2 (sPeel j r).2.2 hp
        (keysAsc_peel j r.2 0 hh.1.1 (Nat.zero_le j)),
      entsOk_stepSRow prev p.1 (sPeel j r).1
        (ground.natMin p.2.1 (sPeel j r).2.1) p.2.2 (sPeel j r).2.2⟩,
      rowsOk_stepRows prev p j hp t hh.2⟩

/-- One round's stepped rows keep the row count. -/
private theorem length_stepRows (prev : BPair) (p : BPair × SRow)
    (j : Nat) (rows : List SRow) :
    (stepRows prev p j rows).length = rows.length :=
  ground.length_map _ rows

/-- The naming at the start: the whole lists, the unit
accumulator, every entry its own one-by-one selection. -/
private theorem kinv_init (cols : Nat) (m : Mat)
    (hm : rowsLen cols m) :
    KInv m [] [] (List.range m.length) (List.range cols)
      (BPair.ofPos .one) (m.map ofRow) := by
  refine ⟨BPair.oneValue_symm detL_nil, BPair.ofNat_one_off, rfl,
    ?_, ?_, rowsOk_ofRow m, ?_⟩
  · rw [ground.length_map, ground.length_range]
  · rw [ground.length_range]
    exact sInv_ofRow cols m hm
  · intro a ha c hc
    rw [ground.length_map] at ha
    rw [ground.length_range] at hc
    rw [ground.getAt_map ([] : List BPair) ((0, []) : SRow) ofRow
        m a ha,
      ground.getAt_range m.length a ha,
      ground.getAt_range cols c hc]
    refine BPair.oneValue_trans ?_
      (BPair.oneValue_symm
        (detL_single (ground.getAt BPair.unit
          (ground.getAt [] m a) c)))
    have h := keyAt_ofRowFrom (ground.getAt [] m a) 0 c
    rw [Nat.zero_add] at h
    exact h

/-- The stepped row's entry at a kept key, read at the two rows'
own sparse reads: each peel lifts the key over the struck column
and the peeled heads are the rows' reads at the pivot column. -/
private theorem keyAt_stepRows (prev : BPair) (pr0 : SRow) (j : Nat)
    (rows : List SRow) (hpr : keysAsc 0 pr0.2) (hrows : rowsOk rows)
    (a : Nat) (ha : a < rows.length) (c : Nat)
    (hc : c < ground.natMin (sPeel j pr0).2.1
      (sPeel j (ground.getAt ((0, []) : SRow) rows a)).2.1) :
    ground.keyAt Nat.beq BPair.unit c (ground.getAt ((0, []) : SRow)
        (stepRows prev (sPeel j pr0) j rows) a).2
      = cofactorAt ((sPeel j pr0).1
          * ground.keyAt Nat.beq BPair.unit (liftIx j c)
            (ground.getAt ((0, []) : SRow) rows a).2
          + (ground.keyAt Nat.beq BPair.unit j (ground.getAt ((0, []) : SRow) rows a).2
              * ground.keyAt Nat.beq BPair.unit (liftIx j c) pr0.2).swap) prev := by
  have hasc := (rowsOk_getAt rows a hrows ha).1
  have hstep : (ground.getAt ((0, []) : SRow)
        (stepRows prev (sPeel j pr0) j rows) a).2
      = stepSRow prev (peel j pr0.2).1
          (peel j (ground.getAt ((0, []) : SRow) rows a).2).1
          (ground.natMin (sPeel j pr0).2.1
            (sPeel j (ground.getAt ((0, []) : SRow) rows a)).2.1)
          (peel j pr0.2).2
          (peel j (ground.getAt ((0, []) : SRow) rows a).2).2 :=
    congrArg Prod.snd
      (ground.getAt_map ((0, []) : SRow) ((0, []) : SRow)
        (fun r =>
          let q := sPeel j r
          let lim := ground.natMin (sPeel j pr0).2.1 q.2.1
          (lim, stepSRow prev (sPeel j pr0).1 q.1 lim
            (sPeel j pr0).2.2 q.2.2))
        rows a ha)
  rw [hstep,
    keyAt_stepSRow prev (peel j pr0.2).1
      (peel j (ground.getAt ((0, []) : SRow) rows a).2).1
      (ground.natMin (sPeel j pr0).2.1
        (sPeel j (ground.getAt ((0, []) : SRow) rows a)).2.1)
      (peel j pr0.2).2
      (peel j (ground.getAt ((0, []) : SRow) rows a).2).2
      (keysAsc_peel j pr0.2 0 hpr (Nat.zero_le j))
      (keysAsc_peel j (ground.getAt ((0, []) : SRow) rows a).2 0
        hasc (Nat.zero_le j))
      c hc,
    keyAt_peel j (ground.getAt ((0, []) : SRow) rows a).2 hasc c,
    keyAt_peel j pr0.2 hpr c,
    keyAt_peel_head j (ground.getAt ((0, []) : SRow) rows a).2 hasc]
  rfl

/-- One round's entry read at the crossed square selection: the
computed cofactor's argument is the stepped entry's own, and the
prior accumulator's multiple of the crossed selection's
determinant reads that argument — Sylvester's identity moved
across the sum at the state's four minors. -/
private theorem kinv_read (m : Mat) (rs cs ri cj : List Nat)
    (prev : BPair) (rows : List SRow)
    (inv : KInv m rs cs ri cj prev rows) (i j : Nat)
    (hf : sFind rows = some (i, j))
    (a : Nat) (ha : a < (rows.eraseIdx i).length)
    (c : Nat) (hc : c + 1 < cj.length) :
    ground.keyAt Nat.beq BPair.unit c (ground.getAt ((0, []) : SRow)
        (stepRows prev
          (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
          (rows.eraseIdx i)) a).2
      = cofactorAt
          ((sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
              * ground.keyAt Nat.beq BPair.unit (liftIx j c)
                (ground.getAt ((0, []) : SRow)
                  (rows.eraseIdx i) a).2
            + (ground.keyAt Nat.beq BPair.unit j (ground.getAt ((0, []) : SRow)
                  (rows.eraseIdx i) a).2
                * ground.keyAt Nat.beq BPair.unit (liftIx j c)
                  (ground.getAt ((0, []) : SRow) rows i).2).swap)
          prev
    ∧ (prev * detL (sel m
          ((rs ++ [ground.getAt 0 ri i])
            ++ [ground.getAt 0 (ri.eraseIdx i) a])
          ((cs ++ [ground.getAt 0 cj j])
            ++ [ground.getAt 0 (cj.eraseIdx j) c]))).oneValue
        ((sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
            * ground.keyAt Nat.beq BPair.unit (liftIx j c)
              (ground.getAt ((0, []) : SRow)
                (rows.eraseIdx i) a).2
          + (ground.keyAt Nat.beq BPair.unit j (ground.getAt ((0, []) : SRow)
                (rows.eraseIdx i) a).2
              * ground.keyAt Nat.beq BPair.unit (liftIx j c)
                (ground.getAt ((0, []) : SRow) rows i).2).swap) := by
  have hi : i < rows.length := sFind_lt rows i j hf
  have hj : j < cj.length :=
    sFind_key cj.length rows i j inv.widths hf
  have hwi := sInv_getAt cj.length rows i inv.widths hi
  have hsi := rowsOk_getAt rows i inv.sorted hi
  have hser : rowsOk (rows.eraseIdx i) :=
    rowsOk_eraseIdx rows i inv.sorted
  have hwer : SInv cj.length (rows.eraseIdx i) :=
    sInv_eraseIdx cj.length rows i inv.widths
  have hwa := sInv_getAt cj.length (rows.eraseIdx i) a hwer ha
  have herow : (rows.eraseIdx i).length + 1 = rows.length :=
    ground.length_eraseIdx rows i hi
  have hecj : (cj.eraseIdx j).length + 1 = cj.length :=
    ground.length_eraseIdx cj j hj
  have hcn : c < (cj.eraseIdx j).length := by
    have hsucc : c + 1 < (cj.eraseIdx j).length + 1 := by
      rw [hecj]
      exact hc
    exact Nat.lt_of_succ_lt_succ hsucc
  have hclim : c < cj.length - 1 := by
    rw [← hecj]
    exact hcn
  have hlim : ground.natMin
      (sPeel j (ground.getAt ((0, []) : SRow) rows i)).2.1
      (sPeel j (ground.getAt ((0, []) : SRow)
        (rows.eraseIdx i) a)).2.1 = cj.length - 1 := by
    rw [sPeel_count _ hj hwi.1, sPeel_count _ hj hwa.1]
    exact natMin_self (cj.length - 1)
  have hread := keyAt_stepRows prev
    (ground.getAt ((0, []) : SRow) rows i) j (rows.eraseIdx i)
    hsi.1 hser a ha c (by rw [hlim]; exact hclim)
  refine ⟨hread, ?_⟩
  have hii : i < ri.length := by
    rw [← inv.lenRows]
    exact hi
  have hlia : liftIx i a < rows.length := by
    by_cases hai : a < i
    · have hl : liftIx i a = a := by
        show (if a < i then a else a + 1) = a
        rw [if_pos hai]
      rw [hl, ← herow]
      exact Nat.lt_succ_of_lt ha
    · rw [liftIx_gt i a hai, ← herow]
      exact Nat.succ_lt_succ ha
  have hljc : liftIx j c < cj.length := by
    by_cases hcj : c < j
    · have hl : liftIx j c = c := by
        show (if c < j then c else c + 1) = c
        rw [if_pos hcj]
      rw [hl]
      exact Nat.lt_trans (Nat.lt_succ_self c) hc
    · rw [liftIx_gt j c hcj]
      exact hc
  have hrowa : ground.getAt ((0, []) : SRow) (rows.eraseIdx i) a
      = ground.getAt ((0, []) : SRow) rows (liftIx i a) := by
    rw [getAt_eraseIdx ((0, []) : SRow) rows i a]
    by_cases hai : a < i
    · have hl : liftIx i a = a := by
        show (if a < i then a else a + 1) = a
        rw [if_pos hai]
      rw [if_pos hai, hl]
    · rw [if_neg hai, liftIx_gt i a hai]
  have hra : ground.getAt 0 (ri.eraseIdx i) a
      = ground.getAt 0 ri (liftIx i a) := by
    rw [getAt_eraseIdx 0 ri i a]
    by_cases hai : a < i
    · have hl : liftIx i a = a := by
        show (if a < i then a else a + 1) = a
        rw [if_pos hai]
      rw [if_pos hai, hl]
    · rw [if_neg hai, liftIx_gt i a hai]
  have hcc : ground.getAt 0 (cj.eraseIdx j) c
      = ground.getAt 0 cj (liftIx j c) := by
    rw [getAt_eraseIdx 0 cj j c]
    by_cases hcj : c < j
    · have hl : liftIx j c = c := by
        show (if c < j then c else c + 1) = c
        rw [if_pos hcj]
      rw [if_pos hcj, hl]
    · rw [if_neg hcj, liftIx_gt j c hcj]
  have hp1eq : (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
      = ground.keyAt Nat.beq BPair.unit j (ground.getAt ((0, []) : SRow) rows i).2 :=
    keyAt_peel_head j
      (ground.getAt ((0, []) : SRow) rows i).2 hsi.1
  have hD := inv.entries i hi j hj
  have hA := inv.entries (liftIx i a) hlia (liftIx j c) hljc
  have hB := inv.entries i hi (liftIx j c) hljc
  have hC := inv.entries (liftIx i a) hlia j hj
  rw [← hp1eq] at hD
  rw [← hrowa, ← hra, ← hcc] at hA
  rw [← hcc] at hB
  rw [← hrowa, ← hra] at hC
  have hcs2 : (cs ++ [ground.getAt 0 cj j,
        ground.getAt 0 (cj.eraseIdx j) c]).length
      = (rs ++ [ground.getAt 0 ri i,
        ground.getAt 0 (ri.eraseIdx i) a]).length := by
    rw [ground.length_append, ground.length_append, inv.lenCs]
    rfl
  have hMMlen : (sel m
        (rs ++ [ground.getAt 0 ri i,
          ground.getAt 0 (ri.eraseIdx i) a])
        (cs ++ [ground.getAt 0 cj j,
          ground.getAt 0 (cj.eraseIdx j) c])).length
      = rs.length + 2 := by
    rw [sel_len, ground.length_append]
    rfl
  have hlt0 : rs.length < rs.length + 2 :=
    Nat.lt_succ_of_lt (Nat.lt_succ_self rs.length)
  have hlt1 : rs.length + 1 < rs.length + 2 :=
    Nat.lt_succ_self (rs.length + 1)
  have hlt0c : rs.length < cs.length + 2 := by
    rw [inv.lenCs]
    exact hlt0
  have hlt1c : rs.length + 1 < cs.length + 2 := by
    rw [inv.lenCs]
    exact hlt1
  have hrowP : ground.getAt 0
      (rs ++ [ground.getAt 0 ri i,
        ground.getAt 0 (ri.eraseIdx i) a]) rs.length
      = ground.getAt 0 ri i :=
    ground.getAt_append_add 0 rs _ 0
  have hrowR : ground.getAt 0
      (rs ++ [ground.getAt 0 ri i,
        ground.getAt 0 (ri.eraseIdx i) a]) (rs.length + 1)
      = ground.getAt 0 (ri.eraseIdx i) a :=
    ground.getAt_append_add 0 rs _ 1
  have hcolP : ground.getAt 0
      (cs ++ [ground.getAt 0 cj j,
        ground.getAt 0 (cj.eraseIdx j) c]) rs.length
      = ground.getAt 0 cj j := by
    rw [← inv.lenCs]
    exact ground.getAt_append_add 0 cs _ 0
  have hcolC : ground.getAt 0
      (cs ++ [ground.getAt 0 cj j,
        ground.getAt 0 (cj.eraseIdx j) c]) (rs.length + 1)
      = ground.getAt 0 (cj.eraseIdx j) c := by
    rw [← inv.lenCs]
    exact ground.getAt_append_add 0 cs _ 1
  have hcsP : (cs ++ [ground.getAt 0 cj j]).length
      = (rs ++ [ground.getAt 0 ri i]).length := by
    rw [ground.length_append, ground.length_append, inv.lenCs]
    rfl
  have hlenP : (rs ++ [ground.getAt 0 ri i]).length
      = rs.length + 1 := ground.length_append rs _
  have hfull := borderAt_full m (rs ++ [ground.getAt 0 ri i])
    (cs ++ [ground.getAt 0 cj j])
    (ground.getAt 0 (ri.eraseIdx i) a)
    (ground.getAt 0 (cj.eraseIdx j) c) hcsP
  rw [hlenP, appendPair, appendPair] at hfull
  have hsyl := sylvester
    (sel m
      (rs ++ [ground.getAt 0 ri i,
        ground.getAt 0 (ri.eraseIdx i) a])
      (cs ++ [ground.getAt 0 cj j,
        ground.getAt 0 (cj.eraseIdx j) c]))
    (sel_sq m _ _ hcs2) rs.length (rs.length + 1) (rs.length + 1)
    (Nat.lt_succ_self rs.length)
    (by rw [hMMlen]; exact hlt1)
    (Nat.lt_succ_self rs.length)
    (by rw [hMMlen]; exact hlt1)
  rw [hfull,
    leadAt_sel m rs cs
      [ground.getAt 0 ri i, ground.getAt 0 (ri.eraseIdx i) a]
      [ground.getAt 0 cj j, ground.getAt 0 (cj.eraseIdx j) c]
      inv.lenCs,
    borderAt_sel m rs cs
      [ground.getAt 0 ri i, ground.getAt 0 (ri.eraseIdx i) a]
      [ground.getAt 0 cj j, ground.getAt 0 (cj.eraseIdx j) c]
      rs.length rs.length inv.lenCs hlt0 hlt0c,
    borderAt_sel m rs cs
      [ground.getAt 0 ri i, ground.getAt 0 (ri.eraseIdx i) a]
      [ground.getAt 0 cj j, ground.getAt 0 (cj.eraseIdx j) c]
      (rs.length + 1) rs.length inv.lenCs hlt1 hlt0c,
    borderAt_sel m rs cs
      [ground.getAt 0 ri i, ground.getAt 0 (ri.eraseIdx i) a]
      [ground.getAt 0 cj j, ground.getAt 0 (cj.eraseIdx j) c]
      rs.length (rs.length + 1) inv.lenCs hlt0 hlt1c,
    borderAt_sel m rs cs
      [ground.getAt 0 ri i, ground.getAt 0 (ri.eraseIdx i) a]
      [ground.getAt 0 cj j, ground.getAt 0 (cj.eraseIdx j) c]
      (rs.length + 1) (rs.length + 1) inv.lenCs hlt1 hlt1c,
    hrowP, hrowR, hcolP, hcolC] at hsyl
  rw [appendPair, appendPair]
  exact BPair.oneValue_trans
    (BPair.mul_congr inv.prevRead (BPair.oneValue_refl _))
    (BPair.oneValue_trans
      (BPair.oneValue_symm
        (swapMove
          (Y := (BPair.mul
            (detL (sel m (rs ++ [ground.getAt 0 (ri.eraseIdx i) a])
              (cs ++ [ground.getAt 0 cj j])))
            (detL (sel m (rs ++ [ground.getAt 0 ri i])
              (cs ++ [ground.getAt 0 (cj.eraseIdx j) c])))).swap)
          hsyl))
      (BPair.add_congr
        (BPair.mul_congr (BPair.oneValue_symm hD)
          (BPair.oneValue_symm hA))
        (ground.swap_congr
          (BPair.mul_congr (BPair.oneValue_symm hC)
            (BPair.oneValue_symm hB)))))

/-- One round keeps the naming: the pivot lists grow by the crossed
keys, the remaining lists erase them, the accumulator becomes the
stored pivot, and every stepped entry is one value with its own
bordered selection's determinant — Sylvester's identity at the
crossed square selection with the cofactor read back exactly. -/
private theorem kinv_step (m : Mat) (rs cs ri cj : List Nat)
    (prev : BPair) (rows : List SRow)
    (inv : KInv m rs cs ri cj prev rows) (i j : Nat)
    (hf : sFind rows = some (i, j)) :
    KInv m (rs ++ [ground.getAt 0 ri i])
      (cs ++ [ground.getAt 0 cj j])
      (ri.eraseIdx i) (cj.eraseIdx j)
      (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
      (stepRows prev
        (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
        (rows.eraseIdx i)) := by
  have hi : i < rows.length := sFind_lt rows i j hf
  have hj : j < cj.length :=
    sFind_key cj.length rows i j inv.widths hf
  have hwi := sInv_getAt cj.length rows i inv.widths hi
  have hsi := rowsOk_getAt rows i inv.sorted hi
  have hp1eq : (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
      = ground.keyAt Nat.beq BPair.unit j (ground.getAt ((0, []) : SRow) rows i).2 :=
    keyAt_peel_head j
      (ground.getAt ((0, []) : SRow) rows i).2 hsi.1
  have hecj : (cj.eraseIdx j).length + 1 = cj.length :=
    ground.length_eraseIdx cj j hj
  have herow : (rows.eraseIdx i).length + 1 = rows.length :=
    ground.length_eraseIdx rows i hi
  have hii : i < ri.length := by
    rw [← inv.lenRows]
    exact hi
  have heri : (ri.eraseIdx i).length + 1 = ri.length :=
    ground.length_eraseIdx ri i hii
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [hp1eq]
    exact inv.entries i hi j hj
  · obtain ⟨v, es, hrow⟩ := sFind_at rows i j hf
    rw [hp1eq, hrow, keyAt_hit (ground.beqRefl j) v es]
    have hent : entsOk ((j, v) :: es) := by
      rw [← hrow]
      exact hsi.2
    exact (show (¬ v.oneValue BPair.unit) ∧ entsOk es from hent).1
  · rw [ground.length_append, ground.length_append, inv.lenCs]
    rfl
  · rw [length_stepRows]
    exact Nat.succ.inj (herow.trans (inv.lenRows.trans heri.symm))
  · rw [show (cj.eraseIdx j).length = cj.length - 1 from by
      rw [← hecj]
      rfl]
    exact sInv_step cj.length prev
      (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
      (sPeel_count _ hj hwi.1) (rows.eraseIdx i)
      (sInv_eraseIdx cj.length rows i inv.widths) hj
  · exact rowsOk_stepRows prev
      (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
      (keysAsc_peel j (ground.getAt ((0, []) : SRow) rows i).2 0
        hsi.1 (Nat.zero_le j))
      (rows.eraseIdx i) (rowsOk_eraseIdx rows i inv.sorted)
  · intro a ha c hc
    rw [length_stepRows] at ha
    have hc' : c + 1 < cj.length := by
      rw [← hecj]
      exact Nat.succ_lt_succ hc
    have h := kinv_read m rs cs ri cj prev rows inv i j hf a ha c hc'
    rw [h.1]
    exact ground.mulCancel inv.prevOff
      (BPair.oneValue_trans (cofactorAt_sound inv.prevOff h.2)
        (BPair.oneValue_symm h.2))

/-- The update display at the cleared pivots: the prior
accumulator's multiple of every stepped entry is the pivot's
multiple of the entry row's read against the entry's border
multiple of the pivot row's — each division exact, `def:elim`'s
sentence at the state. -/
private theorem kinv_exact (m : Mat) (rs cs ri cj : List Nat)
    (prev : BPair) (rows : List SRow)
    (inv : KInv m rs cs ri cj prev rows) (i j : Nat)
    (hf : sFind rows = some (i, j)) :
    ∀ a, a < (rows.eraseIdx i).length → ∀ c, c + 1 < cj.length →
      (prev * ground.keyAt Nat.beq BPair.unit c (ground.getAt ((0, []) : SRow)
          (stepRows prev
            (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
            (rows.eraseIdx i)) a).2).oneValue
        ((sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
            * ground.keyAt Nat.beq BPair.unit (liftIx j c)
              (ground.getAt ((0, []) : SRow)
                (rows.eraseIdx i) a).2
          + (ground.keyAt Nat.beq BPair.unit j (ground.getAt ((0, []) : SRow)
                (rows.eraseIdx i) a).2
              * ground.keyAt Nat.beq BPair.unit (liftIx j c)
                (ground.getAt ((0, []) : SRow) rows i).2).swap) := by
  intro a ha c hc
  have h := kinv_read m rs cs ri cj prev rows inv i j hf a ha c hc
  rw [h.1]
  exact cofactorAt_sound inv.prevOff h.2

/-! The kernel list's three reads at the descent's own naming: the
split kit at an inserted and at a struck coordinate, the back
solve's members against every state row, the pivot-free
coordinates witnessing independence, and every kernel member's
cleared combination — `def:elim`'s kernel sentence at the landed
action. -/

/-- The dense reading names only the row's stored entries, so two
rows storing one entry list read one family. -/
private theorem denseRow_snd (w : Nat) (r r' : SRow)
    (h : r.2 = r'.2) : denseRow w r = denseRow w r' := by
  show (List.range w).map (fun c => ground.keyAt Nat.beq BPair.unit c r.2)
    = (List.range w).map (fun c => ground.keyAt Nat.beq BPair.unit c r'.2)
  rw [h]

/-- The peeled row's stored entries are the peel's own, the count
the only datum the row wrapper adds. -/
private theorem sPeel_snd (j : Nat) (r : SRow) :
    (sPeel j r).2.2 = (peel j r.2).2 := rfl

/-- The insertion at the front place, the growth's own head. -/
private theorem insertAt_zero {α : Type} (x : α) :
    ∀ l : List α, insertAt x l 0 = x :: l
  | [] => rfl
  | _ :: _ => rfl

/-- The entry read through an insertion: below the place its own,
at the place the inserted entry, past it the predecessor's. -/
private theorem getAt_insertAt {α : Type} (d : α) (x : α) :
    ∀ (l : List α) (n c : Nat), n ≤ l.length →
      ground.getAt d (insertAt x l n) c
        = if c < n then ground.getAt d l c
          else if c = n then x
          else ground.getAt d l (c - 1)
  | l, 0, 0, _ => by
    rw [insertAt_zero x l, if_neg (Nat.lt_irrefl 0), if_pos rfl]
    rfl
  | l, 0, c + 1, _ => by
    rw [insertAt_zero x l, if_neg (Nat.not_lt_zero (c + 1)),
      if_neg (show ¬ c + 1 = 0 from fun he => Nat.noConfusion he)]
    rfl
  | [], n + 1, _, hn => absurd hn (Nat.not_succ_le_zero n)
  | a :: t, n + 1, 0, _ => by
    show ground.getAt d (a :: insertAt x t n) 0
      = if (0 : Nat) < n + 1 then ground.getAt d (a :: t) 0
        else if (0 : Nat) = n + 1 then x
        else ground.getAt d (a :: t) (0 - 1)
    rw [if_pos (Nat.succ_pos n)]
    rfl
  | a :: t, n + 1, c + 1, hn => by
    show ground.getAt d (insertAt x t n) c
      = if c + 1 < n + 1 then ground.getAt d (a :: t) (c + 1)
        else if c + 1 = n + 1 then x
        else ground.getAt d (a :: t) (c + 1 - 1)
    rw [getAt_insertAt d x t n c (Nat.le_of_succ_le_succ hn)]
    by_cases h1 : c < n
    · rw [if_pos h1, if_pos (Nat.succ_lt_succ h1)]
      rfl
    · rw [if_neg h1,
        if_neg (fun hs => h1 (Nat.lt_of_succ_lt_succ hs))]
      by_cases h2 : c = n
      · rw [if_pos h2, if_pos (congrArg (fun z => z + 1) h2)]
      · rw [if_neg h2, if_neg (fun hs => h2 (Nat.succ.inj hs))]
        cases c with
        | zero =>
          cases n with
          | zero => exact absurd rfl h2
          | succ n' => exact absurd (Nat.succ_pos n') h1
        | succ c' => rfl

/-- The pairing at an inserted coordinate, the place's own descent
against the two lists' heads. -/
private theorem dotP_insertAt : ∀ (r s : List BPair) (x : BPair)
    (j : Nat), r.length = s.length + 1 → j ≤ s.length →
    (dotP r (insertAt x s j)).oneValue
      (ground.getAt BPair.unit r j * x + dotP (strike j r) s)
  | [], s, _, _, hr, _ => nomatch (show 0 = s.length + 1 from hr)
  | a :: r, s, x, 0, _, _ => by
    rw [insertAt_zero x s]
    show (a * x + dotP r s).oneValue (a * x + dotP r s)
    exact BPair.oneValue_refl _
  | _ :: _, [], _, j + 1, _, hj => absurd hj (Nat.not_succ_le_zero j)
  | a :: r, b :: s, x, j + 1, hr, hj => by
    have ih := dotP_insertAt r s x j (Nat.succ.inj hr)
      (Nat.le_of_succ_le_succ hj)
    show (a * b + dotP r (insertAt x s j)).oneValue
      (ground.getAt BPair.unit r j * x
        + (a * b + dotP (strike j r) s))
    exact BPair.oneValue_trans
      (BPair.add_congr (BPair.oneValue_refl (a * b)) ih)
      (BPair.oneValue_of_eq (BPair.add_left_comm (a * b) _ _))

/-- The pairing at a struck coordinate, the place's own descent
against the two lists' heads. -/
private theorem dotP_strike : ∀ (r s : List BPair) (j : Nat),
    r.length = s.length → j < s.length →
    (dotP r s).oneValue
      (ground.getAt BPair.unit r j * ground.getAt BPair.unit s j
        + dotP (strike j r) (strike j s))
  | [], [], _, _, hj => absurd hj (Nat.not_lt_zero _)
  | [], _ :: _, _, hr, _ => nomatch hr
  | _ :: _, [], _, hr, _ => nomatch hr
  | a :: r, b :: s, 0, _, _ => by
    show (a * b + dotP r s).oneValue (a * b + dotP r s)
    exact BPair.oneValue_refl _
  | a :: r, b :: s, j + 1, hr, hj => by
    have ih := dotP_strike r s j (Nat.succ.inj hr)
      (Nat.lt_of_succ_lt_succ hj)
    show (a * b + dotP r s).oneValue
      (ground.getAt BPair.unit r j * ground.getAt BPair.unit s j
        + (a * b + dotP (strike j r) (strike j s)))
    exact BPair.oneValue_trans
      (BPair.add_congr (BPair.oneValue_refl (a * b)) ih)
      (BPair.oneValue_of_eq (BPair.add_left_comm (a * b) _ _))

/-- An answered-nothing search names every row entryless. -/
private theorem sFind_none : ∀ (rows : List SRow) (a : Nat),
    sFind rows = none → a < rows.length →
      (ground.getAt ((0, []) : SRow) rows a).2 = []
  | [], _, _, ha => absurd ha (Nat.not_lt_zero _)
  | (_, []) :: _, 0, _, _ => rfl
  | (_, []) :: rest, a + 1, h, ha => by
    revert h
    show (match sFind rest with
        | none => none
        | some (i, j) => some (i + 1, j)) = none →
      (ground.getAt ((0, []) : SRow) rest a).2 = []
    cases hfr : sFind rest with
    | none =>
      intro _
      exact sFind_none rest a hfr (Nat.lt_of_succ_lt_succ ha)
    | some ij =>
      intro hb
      exact nomatch hb
  | (_, (_, _) :: _) :: _, _, h, _ => nomatch h

/-- An entryless row's dense reading is a unit tail at every key
list: every read off the vacant entries is the sum's unit. -/
private theorem unitTail_denseNil : ∀ l : List Nat,
    poly.unitTail
      (l.map (fun c => ground.keyAt Nat.beq BPair.unit c ([] : List (Nat × BPair))))
  | [] => trivial
  | _ :: t => ⟨BPair.oneValue_refl BPair.unit, unitTail_denseNil t⟩

/-- An entryless row's dense reading pairs everything at the sum's
unit. -/
private theorem dotP_unitRow (w : Nat) : ∀ u : List BPair,
    (dotP (denseRow w ((w, []) : SRow)) u).oneValue BPair.unit :=
  fun u =>
    dotP_null_tail_left (denseRow w ((w, []) : SRow)) u
      (unitTail_denseNil (List.range w))

/-- The back solve at an answered-nothing search: the terminal seed
stands whole. -/
private theorem kernelGo_none (fuel w : Nat) (prev : BPair)
    (rows : List SRow) (hf : sFind rows = none) :
    kernelGo (fuel + 1) w prev rows = idList w :=
  descGo_none _ _ fuel w prev rows hf

/-- The back solve at a found pivot: the round below's members
extended at the pivot's clearing. -/
private theorem kernelGo_some (fuel w : Nat) (prev : BPair)
    (rows : List SRow) (i j : Nat) (hf : sFind rows = some (i, j)) :
    kernelGo (fuel + 1) w prev rows
      = (kernelGo fuel (w - 1)
          (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
          (stepRows prev
            (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
            (rows.eraseIdx i))).map
        (fun v => insertAt
          ((dotN (denseRow (w - 1)
              (sPeel j (ground.getAt ((0, []) : SRow) rows i)).2)
            v).swap)
          (vecScale
            (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1 v)
          j) :=
  descGo_some _ _ fuel w prev rows i j hf

/-- A vanishing sum reads its second summand as the first's
balance partner. -/
private theorem swapOfAddNull {A B : BPair}
    (h : (A + B).oneValue BPair.unit) : B.oneValue A.swap := by
  show B.fst + A.fst = A.snd + B.snd
  rw [ground.add_comm B.fst A.fst]
  exact ground.add_cancel_ones h

/-- A row off the struck place sits inside the struck list at its
own place: below the struck key its own, past it one lower. -/
private theorem eraseIdx_index {α : Type} (d : α) (l : List α)
    (i a : Nat) (hi : i < l.length) (ha : a < l.length)
    (hne : ¬ a = i) :
    ∃ b, b < (l.eraseIdx i).length
      ∧ ground.getAt d (l.eraseIdx i) b = ground.getAt d l a := by
  have hlen : (l.eraseIdx i).length + 1 = l.length :=
    ground.length_eraseIdx l i hi
  have hi' : i < (l.eraseIdx i).length + 1 := by
    rw [hlen]
    exact hi
  match Nat.lt_or_ge a i with
  | Or.inl hai =>
    refine ⟨a, Nat.lt_of_lt_of_le hai (Nat.le_of_lt_succ hi'), ?_⟩
    rw [getAt_eraseIdx d l i a, if_pos hai]
  | Or.inr hge =>
    have hlt : i < a :=
      Nat.lt_of_le_of_ne hge (fun he => hne he.symm)
    match a, ha, hlt with
    | b + 1, ha, hlt =>
      have hb : b < (l.eraseIdx i).length := by
        have h1 : b + 1 < (l.eraseIdx i).length + 1 := by
          rw [hlen]
          exact ha
        exact Nat.lt_of_succ_lt_succ h1
      refine ⟨b, hb, ?_⟩
      rw [getAt_eraseIdx d l i b,
        if_neg (Nat.not_lt_of_ge (Nat.le_of_lt_succ hlt))]

/-- The update display densified: the prior accumulator's scaling
of a stepped row's dense reading is the pivot's multiple of the
entry row's peeled reading joined to the entry's border multiple of
the pivot row's, entry for entry — `kinv_exact` read across the
whole column key list. -/
private theorem display_dense (m : Mat) (rs cs ri cj : List Nat)
    (prev : BPair) (rows : List SRow)
    (inv : KInv m rs cs ri cj prev rows) (i j : Nat)
    (hf : sFind rows = some (i, j))
    (a : Nat) (ha : a < (rows.eraseIdx i).length) :
    poly.oneValue
      (vecScale prev (denseRow (cj.eraseIdx j).length
        (ground.getAt ((0, []) : SRow)
          (stepRows prev
            (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
            (rows.eraseIdx i)) a)))
      (vecAdd
        (vecScale (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
          (denseRow (cj.eraseIdx j).length
            (sPeel j (ground.getAt ((0, []) : SRow)
              (rows.eraseIdx i) a)).2))
        ((vecScale
            (ground.keyAt Nat.beq BPair.unit j (ground.getAt ((0, []) : SRow)
              (rows.eraseIdx i) a).2)
            (denseRow (cj.eraseIdx j).length
              (sPeel j
                (ground.getAt ((0, []) : SRow) rows i)).2)).map
          BPair.swap)) := by
  have hi : i < rows.length := sFind_lt rows i j hf
  have hj : j < cj.length :=
    sFind_key cj.length rows i j inv.widths hf
  have hecj : (cj.eraseIdx j).length + 1 = cj.length :=
    ground.length_eraseIdx cj j hj
  have hsi := rowsOk_getAt rows i inv.sorted hi
  have hsa := rowsOk_getAt (rows.eraseIdx i) a
    (rowsOk_eraseIdx rows i inv.sorted) ha
  refine poly.oneValue_of_entries _ _ ?_ ?_
  · rw [length_vecScale, length_denseRow,
      length_vecAdd _ _ (cj.eraseIdx j).length
        (by rw [length_vecScale, length_denseRow])
        (by rw [ground.length_map, length_vecScale,
          length_denseRow])]
  · intro c hc
    rw [length_vecScale, length_denseRow] at hc
    have hc1 : c + 1 < cj.length := by
      rw [← hecj]
      exact Nat.succ_lt_succ hc
    have hexact := kinv_exact m rs cs ri cj prev rows inv i j hf
      a ha c hc1
    rw [getAt_vecScale prev _ c
        (by rw [length_denseRow]; exact hc),
      getAt_denseRow (cj.eraseIdx j).length _ c hc,
      getAt_vecAdd _ _ c
        (by rw [length_vecScale, length_denseRow]; exact hc)
        (by rw [ground.length_map, length_vecScale, length_denseRow]
            exact hc),
      getAt_vecScale _ _ c (by rw [length_denseRow]; exact hc),
      ground.getAt_map BPair.unit BPair.unit BPair.swap _ c
        (by rw [length_vecScale, length_denseRow]; exact hc),
      getAt_vecScale _ _ c (by rw [length_denseRow]; exact hc),
      getAt_denseRow (cj.eraseIdx j).length _ c hc,
      getAt_denseRow (cj.eraseIdx j).length _ c hc,
      sPeel_snd j (ground.getAt ((0, []) : SRow) (rows.eraseIdx i) a),
      sPeel_snd j (ground.getAt ((0, []) : SRow) rows i),
      keyAt_peel j (ground.getAt ((0, []) : SRow)
        (rows.eraseIdx i) a).2 hsa.1 c,
      keyAt_peel j (ground.getAt ((0, []) : SRow) rows i).2 hsi.1 c]
    exact hexact

/-- Every back-solve member pairs every state row at the sum's
unit: the pivot row's pairing collects to the pivot's multiple of
the stepped read against its partner, and an entry row's is the
update display's sum reordered, the stepped member's own pairing
beneath it. -/
private theorem kernelGo_members (m : Mat) :
    ∀ (fuel : Nat) (rs cs ri cj : List Nat) (prev : BPair)
      (rows : List SRow), KInv m rs cs ri cj prev rows →
      rows.length ≤ fuel →
      ∀ k, k < (kernelGo fuel cj.length prev rows).length →
      ∀ a, a < rows.length →
        (dotP (denseRow cj.length
            (ground.getAt ((0, []) : SRow) rows a))
          (ground.getAt [] (kernelGo fuel cj.length prev rows)
            k)).oneValue BPair.unit
  | 0, _, _, _, _, _, _, _, hfuel, _, _, a, ha =>
    absurd (Nat.lt_of_lt_of_le ha hfuel) (Nat.not_lt_zero a)
  | fuel + 1, rs, cs, ri, cj, prev, rows, inv, hfuel, k, hk, a,
      ha => by
    cases hf : sFind rows with
    | none =>
      rw [kernelGo_none fuel cj.length prev rows hf,
        denseRow_snd cj.length _ ((cj.length, []) : SRow)
          (sFind_none rows a hf ha)]
      exact dotP_unitRow cj.length _
    | some ij =>
      obtain ⟨i, j⟩ := ij
      have hi : i < rows.length := sFind_lt rows i j hf
      have hj : j < cj.length :=
        sFind_key cj.length rows i j inv.widths hf
      have hecj : (cj.eraseIdx j).length + 1 = cj.length :=
        ground.length_eraseIdx cj j hj
      have herow : (rows.eraseIdx i).length + 1 = rows.length :=
        ground.length_eraseIdx rows i hi
      have hW : cj.length - 1 = (cj.eraseIdx j).length := by
        rw [← hecj]
        rfl
      have hsi := rowsOk_getAt rows i inv.sorted hi
      have hp1 : (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
          = ground.keyAt Nat.beq BPair.unit j (ground.getAt ((0, []) : SRow) rows i).2 :=
        keyAt_peel_head j
          (ground.getAt ((0, []) : SRow) rows i).2 hsi.1
      have hjs : j < (cj.eraseIdx j).length + 1 := by
        rw [hecj]
        exact hj
      rw [kernelGo_some fuel cj.length prev rows i j hf, hW] at hk ⊢
      have hkK : k < (kernelGo fuel (cj.eraseIdx j).length
          (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
          (stepRows prev
            (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
            (rows.eraseIdx i))).length := by
        rw [ground.length_map] at hk
        exact hk
      rw [ground.getAt_map ([] : List BPair) ([] : List BPair) _ _ k
        hkK]
      have hvk : (ground.getAt ([] : List BPair)
          (kernelGo fuel (cj.eraseIdx j).length
            (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
            (stepRows prev
              (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
              (rows.eraseIdx i))) k).length
          = (cj.eraseIdx j).length :=
        rowsLen_getAt _ k (kernelGo_rowsLen fuel _ _ _) hkK
      have hrlen : (denseRow cj.length
            (ground.getAt ((0, []) : SRow) rows a)).length
          = (vecScale
              (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
              (ground.getAt ([] : List BPair)
                (kernelGo fuel (cj.eraseIdx j).length
                  (sPeel j
                    (ground.getAt ((0, []) : SRow) rows i)).1
                  (stepRows prev
                    (sPeel j
                      (ground.getAt ((0, []) : SRow) rows i)) j
                    (rows.eraseIdx i))) k)).length + 1 := by
        rw [length_denseRow, length_vecScale, hvk, hecj]
      have hjle : j ≤ (vecScale
          (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
          (ground.getAt ([] : List BPair)
            (kernelGo fuel (cj.eraseIdx j).length
              (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
              (stepRows prev
                (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
                (rows.eraseIdx i))) k)).length := by
        rw [length_vecScale, hvk]
        exact Nat.le_of_lt_succ hjs
      refine BPair.oneValue_trans
        (dotP_insertAt _ _ _ j hrlen hjle) ?_
      rw [getAt_denseRow cj.length
          (ground.getAt ((0, []) : SRow) rows a) j hj,
        ← denseRow_sPeel cj.length j
          (ground.getAt ((0, []) : SRow) rows a)
          (rowsOk_getAt rows a inv.sorted ha).1 hj,
        hW]
      by_cases hai : a = i
      · rw [hai, ← hp1]
        refine BPair.oneValue_trans
          (BPair.add_congr
            (BPair.mul_congr (BPair.oneValue_refl _)
              (ground.swap_congr (dotN_read _ _)))
            (dotP_vecScale_right _ _ _)) ?_
        rw [← BPair.left_distrib]
        exact oneValue_mul_unit _ _
          (BPair.swap_add_null (BPair.oneValue_refl _))
      · obtain ⟨b, hb, hbeq⟩ := eraseIdx_index ((0, []) : SRow)
          rows i a hi ha hai
        have hstep : (stepRows prev
            (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
            (rows.eraseIdx i)).length
            = (rows.eraseIdx i).length := length_stepRows _ _ _ _
        have hfuel' : (stepRows prev
            (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
            (rows.eraseIdx i)).length ≤ fuel := by
          rw [hstep]
          have h1 : (rows.eraseIdx i).length + 1 ≤ fuel + 1 := by
            rw [herow]
            exact hfuel
          exact Nat.le_of_succ_le_succ h1
        have hbs : b < (stepRows prev
            (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
            (rows.eraseIdx i)).length := by
          rw [hstep]
          exact hb
        have hih := kernelGo_members m fuel
          (rs ++ [ground.getAt 0 ri i])
          (cs ++ [ground.getAt 0 cj j])
          (ri.eraseIdx i) (cj.eraseIdx j)
          (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
          (stepRows prev
            (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
            (rows.eraseIdx i))
          (kinv_step m rs cs ri cj prev rows inv i j hf) hfuel'
          k hkK b hbs
        have hdisp := display_dense m rs cs ri cj prev rows inv i j
          hf b hb
        rw [hbeq] at hdisp
        have hDunit : (dotP
            (vecAdd
              (vecScale
                (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
                (denseRow (cj.eraseIdx j).length
                  (sPeel j
                    (ground.getAt ((0, []) : SRow) rows a)).2))
              ((vecScale
                  (ground.keyAt Nat.beq BPair.unit j (ground.getAt ((0, []) : SRow) rows a).2)
                  (denseRow (cj.eraseIdx j).length
                    (sPeel j
                      (ground.getAt ((0, []) : SRow) rows i)).2)).map
                BPair.swap))
            (ground.getAt ([] : List BPair)
              (kernelGo fuel (cj.eraseIdx j).length
                (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
                (stepRows prev
                  (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
                  (rows.eraseIdx i))) k)).oneValue BPair.unit := by
          refine BPair.oneValue_trans
            (BPair.oneValue_symm (dotP_oneValue_left _ _ _ hdisp)) ?_
          refine BPair.oneValue_trans
            (BPair.oneValue_of_eq (dotP_comm _ _)) ?_
          refine BPair.oneValue_trans
            (dotP_vecScale_right _ _ prev) ?_
          exact oneValue_mul_unit prev _
            (BPair.oneValue_trans
              (BPair.oneValue_of_eq (dotP_comm _ _)) hih)
        have hlen1 : (ground.getAt ([] : List BPair)
            (kernelGo fuel (cj.eraseIdx j).length
              (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
              (stepRows prev
                (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
                (rows.eraseIdx i))) k).length
            ≤ (vecScale
                (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
                (denseRow (cj.eraseIdx j).length
                  (sPeel j
                    (ground.getAt ((0, []) : SRow) rows a)).2)).length
            := by
          rw [hvk, length_vecScale, length_denseRow]
          exact Nat.le_refl _
        have hlen2 : (ground.getAt ([] : List BPair)
            (kernelGo fuel (cj.eraseIdx j).length
              (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
              (stepRows prev
                (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
                (rows.eraseIdx i))) k).length
            ≤ ((vecScale
                (ground.keyAt Nat.beq BPair.unit j (ground.getAt ((0, []) : SRow) rows a).2)
                (denseRow (cj.eraseIdx j).length
                  (sPeel j
                    (ground.getAt ((0, []) : SRow) rows i)).2)).map
              BPair.swap).length := by
          rw [hvk, ground.length_map, length_vecScale,
            length_denseRow]
          exact Nat.le_refl _
        have hA : (dotP
            (vecScale
              (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
              (denseRow (cj.eraseIdx j).length
                (sPeel j (ground.getAt ((0, []) : SRow) rows a)).2))
            (ground.getAt ([] : List BPair)
              (kernelGo fuel (cj.eraseIdx j).length
                (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
                (stepRows prev
                  (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
                  (rows.eraseIdx i))) k)).oneValue
            ((sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
              * dotP
                (denseRow (cj.eraseIdx j).length
                  (sPeel j
                    (ground.getAt ((0, []) : SRow) rows a)).2)
                (ground.getAt ([] : List BPair)
                  (kernelGo fuel (cj.eraseIdx j).length
                    (sPeel j
                      (ground.getAt ((0, []) : SRow) rows i)).1
                    (stepRows prev
                      (sPeel j
                        (ground.getAt ((0, []) : SRow) rows i)) j
                      (rows.eraseIdx i))) k)) :=
          BPair.oneValue_trans
            (BPair.oneValue_of_eq (dotP_comm _ _))
            (BPair.oneValue_trans (dotP_vecScale_right _ _ _)
              (BPair.mul_congr (BPair.oneValue_refl _)
                (BPair.oneValue_of_eq (dotP_comm _ _))))
        have hB : (dotP
            ((vecScale
                (ground.keyAt Nat.beq BPair.unit j (ground.getAt ((0, []) : SRow) rows a).2)
                (denseRow (cj.eraseIdx j).length
                  (sPeel j
                    (ground.getAt ((0, []) : SRow) rows i)).2)).map
              BPair.swap)
            (ground.getAt ([] : List BPair)
              (kernelGo fuel (cj.eraseIdx j).length
                (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
                (stepRows prev
                  (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
                  (rows.eraseIdx i))) k)).oneValue
            (ground.keyAt Nat.beq BPair.unit j (ground.getAt ((0, []) : SRow) rows a).2
              * (dotP
                  (denseRow (cj.eraseIdx j).length
                    (sPeel j
                      (ground.getAt ((0, []) : SRow) rows i)).2)
                  (ground.getAt ([] : List BPair)
                    (kernelGo fuel (cj.eraseIdx j).length
                      (sPeel j
                        (ground.getAt ((0, []) : SRow) rows i)).1
                      (stepRows prev
                        (sPeel j
                          (ground.getAt ((0, []) : SRow) rows i)) j
                        (rows.eraseIdx i))) k)).swap) := by
          rw [dotP_comm, dotP_swapMap, BPair.mul_swap]
          exact ground.swap_congr
            (BPair.oneValue_trans (dotP_vecScale_right _ _ _)
              (BPair.mul_congr (BPair.oneValue_refl _)
                (BPair.oneValue_of_eq (dotP_comm _ _))))
        have hSum := BPair.oneValue_trans
          (BPair.oneValue_symm (BPair.add_congr hA hB))
          (BPair.oneValue_trans
            (BPair.oneValue_symm
              (dotP_vecAdd_left _ _ _ hlen1 hlen2))
            hDunit)
        refine BPair.oneValue_trans
          (BPair.add_congr
            (BPair.mul_congr (BPair.oneValue_refl _)
              (ground.swap_congr (dotN_read _ _)))
            (dotP_vecScale_right _ _ _)) ?_
        rw [BPair.add_comm]
        exact hSum

/-- The framed matrix's sparse reading pairs a vector exactly as
the row itself does, at the stated width. -/
private theorem dotP_denseRow_row (cols : Nat) (m : Mat)
    (hm : rowsLen cols m) (v : List BPair) (a : Nat)
    (ha : a < m.length) :
    (dotP (denseRow cols
        (ground.getAt ((0, []) : SRow) (m.map ofRow) a)) v).oneValue
      (dotP (ground.getAt [] m a) v) := by
  have hrow : (ground.getAt [] m a).length = cols :=
    rowsLen_getAt m a hm ha
  rw [ground.getAt_map ([] : List BPair) ((0, []) : SRow) ofRow m a
      ha,
    ← hrow]
  exact dotP_oneValue_left _ _ v
    (denseRow_ofRow (ground.getAt [] m a))

/-- The action's unit tail off the rows' own pairings: the fold's
map spelling read at every row. -/
private theorem unitTail_matVec (m : Mat) (v : List BPair)
    (h : ∀ a, a < m.length →
      (dotP (ground.getAt [] m a) v).oneValue BPair.unit) :
    poly.unitTail (matVec m v) := by
  refine unitTail_of_getAt (matVec m v) ?_
  intro p hp
  rw [matVec_length] at hp
  show (ground.getAt BPair.unit
    (m.map (fun r => dotN r v)) p).oneValue BPair.unit
  rw [ground.getAt_map ([] : List BPair) BPair.unit
    (fun r => dotN r v) m p hp]
  exact BPair.oneValue_trans (dotN_read _ v) (h p hp)

/-- The action's unit tail read back at every row, the walker's
other direction. -/
private theorem matVec_row_null (m : Mat) (v : List BPair)
    (h : poly.unitTail (matVec m v)) :
    ∀ a, a < m.length →
      (dotP (ground.getAt [] m a) v).oneValue BPair.unit := by
  intro a ha
  have hp : a < (matVec m v).length := by
    rw [matVec_length]
    exact ha
  have hg : (ground.getAt BPair.unit
      (m.map (fun r => dotN r v)) a).oneValue BPair.unit :=
    poly.getAt_unitTail h a
  rw [ground.getAt_map ([] : List BPair) BPair.unit
    (fun r => dotN r v) m a ha] at hg
  exact BPair.oneValue_trans
    (BPair.oneValue_symm (dotN_read _ v)) hg

/-- The kernel list's members pair every row at the sum's unit:
the solves' reads, `def:elim`'s sentence at the landed action. -/
theorem kernelList_members (cols : Nat) (m : Mat)
    (hm : rowsLen cols m) :
    ∀ k : Nat, k < (kernelList cols m).length →
      poly.unitTail (matVec m
        (ground.getAt [] (kernelList cols m) k)) := by
  intro k hk
  refine unitTail_matVec m _ ?_
  intro a ha
  have hlr : (List.range cols).length = cols :=
    ground.length_range cols
  have hrows : (m.map ofRow).length = m.length :=
    ground.length_map _ m
  have ha' : a < (m.map ofRow).length := by
    rw [hrows]
    exact ha
  have hfuel : (m.map ofRow).length ≤ m.length := by
    rw [hrows]
    exact Nat.le_refl _
  have hk' : k < (kernelGo m.length (List.range cols).length
      (BPair.ofPos .one) (m.map ofRow)).length := by
    rw [hlr]
    exact hk
  have hmem := kernelGo_members m m.length [] []
    (List.range m.length) (List.range cols) (BPair.ofPos .one)
    (m.map ofRow) (kinv_init cols m hm) hfuel k hk' a ha'
  rw [hlr] at hmem
  exact BPair.oneValue_trans
    (BPair.oneValue_symm (dotP_denseRow_row cols m hm _ a ha)) hmem

/-! The independence tier: the pivot-free columns mirroring the
back solve round for round, each member off the sum's unit at its
own column and at the unit at every other's. -/

/-- The terminal seed's member count is the stated width. -/
theorem length_idList (w : Nat) : (idList w).length = w :=
  ground.length_mapRange _ w

/-- The back solve at the exhausted fuel is the terminal seed. -/
private theorem kernelGo_zero (w : Nat) (prev : BPair)
    (rows : List SRow) : kernelGo 0 w prev rows = idList w :=
  descGo_zero _ _ w prev rows

/-- The letter lift below the pivot's place is the place itself. -/
private theorem liftIx_lo (j q : Nat) (hq : q < j) :
    liftIx j q = q := by
  show (if q < j then q else q + 1) = q
  rw [if_pos hq]

/-- The entry read through an insertion at a lifted coordinate is
the base list's own read there: the lift skips the inserted place
on both sides of it. -/
private theorem getAt_insertAt_lift {α : Type} (d : α) (x : α)
    (l : List α) (j q : Nat) (hj : j ≤ l.length) :
    ground.getAt d (insertAt x l j) (liftIx j q)
      = ground.getAt d l q := by
  rw [getAt_insertAt d x l j (liftIx j q) hj,
    if_neg (liftIx_ne j q)]
  match Nat.lt_or_ge q j with
  | Or.inl hq => rw [liftIx_lo j q hq, if_pos hq]
  | Or.inr hq =>
    rw [liftIx_gt j q (Nat.not_lt_of_ge hq),
      if_neg (Nat.not_lt_of_ge (Nat.le_succ_of_le hq)), Nat.succ_sub_one]

/-- The terminal seed's member at a column key: the unit family
with the product's one at that key. -/
theorem idList_getAt (w k : Nat) (hk : k < w) :
    ground.getAt ([] : List BPair) (idList w) k
      = List.set (List.replicate w BPair.unit) k
        (BPair.ofPos .one) := by
  show ground.getAt ([] : List BPair)
      ((List.range w).map (fun c =>
        List.set (List.replicate w BPair.unit) c
          (BPair.ofPos .one))) k
    = List.set (List.replicate w BPair.unit) k (BPair.ofPos .one)
  rw [ground.getAt_map 0 ([] : List BPair) _ (List.range w) k
      (by rw [ground.length_range]; exact hk),
    ground.getAt_range w k hk]

/-- The terminal seed's own coordinates: the unit family reads one
at its own column key, the crossed pivots' product at the terminal
step, and the unit at every other. -/
private theorem idList_coords (w k : Nat) (hk : k < w) :
    ((ground.getAt BPair.unit (ground.getAt [] (idList w) k)
      (ground.getAt 0 (List.range w) k)).oneValue
        (BPair.ofPos .one))
      ∧ ∀ k', k' < w → ¬ k' = k →
        (ground.getAt BPair.unit (ground.getAt [] (idList w) k)
          (ground.getAt 0 (List.range w) k')).oneValue
          BPair.unit := by
  refine ⟨?_, ?_⟩
  · rw [idList_getAt w k hk, ground.getAt_range w k hk,
      ground.getAt_set_self BPair.unit (BPair.ofPos .one)
        (List.replicate w BPair.unit) k
        (by rw [ground.length_replicate]; exact hk)]
    exact BPair.oneValue_refl _
  · intro k' hk' hne
    rw [idList_getAt w k hk, ground.getAt_range w k' hk',
      ground.getAt_set_ne BPair.unit (List.replicate w BPair.unit) k k'
        (BPair.ofPos .one) hne,
      ground.getAt_replicate_self BPair.unit w k']
    exact BPair.oneValue_refl _

/-- The pivot-free columns, mirroring the back solve round for
round: the terminal columns whole, a round's columns the stepped
ones read through the pivot's place.  The recursion steps the rows
with the same state the back solve does, so the two walks stay
aligned place for place. -/
private def freeGo (fuel w : Nat) (prev : BPair)
    (rows : List SRow) : List Nat :=
  descGo List.range (fun _ j _ F => F.map (liftIx j))
    fuel w prev rows

/-- The pivot-free columns at the exhausted fuel are the stated
column keys whole. -/
private theorem freeGo_zero (w : Nat) (prev : BPair)
    (rows : List SRow) : freeGo 0 w prev rows = List.range w :=
  descGo_zero _ _ w prev rows

/-- The pivot-free columns at an answered-nothing search: the
stated column keys whole. -/
private theorem freeGo_none (fuel w : Nat) (prev : BPair)
    (rows : List SRow) (hf : sFind rows = none) :
    freeGo (fuel + 1) w prev rows = List.range w :=
  descGo_none _ _ fuel w prev rows hf

/-- The pivot-free columns at a found pivot: the round below's
columns lifted over the pivot's place. -/
private theorem freeGo_some (fuel w : Nat) (prev : BPair)
    (rows : List SRow) (i j : Nat) (hf : sFind rows = some (i, j)) :
    freeGo (fuel + 1) w prev rows
      = (freeGo fuel (w - 1)
          (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
          (stepRows prev
            (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
            (rows.eraseIdx i))).map (liftIx j) :=
  descGo_some _ _ fuel w prev rows i j hf

/-- The pivot-free columns count the back solve's members, the two
walks answering at one search. -/
private theorem length_freeGo : ∀ (fuel w : Nat) (prev : BPair)
    (rows : List SRow),
    (freeGo fuel w prev rows).length
      = (kernelGo fuel w prev rows).length
  | 0, w, prev, rows => by
    rw [freeGo_zero w prev rows, kernelGo_zero w prev rows,
      ground.length_range, length_idList]
  | fuel + 1, w, prev, rows => by
    cases hf : sFind rows with
    | none =>
      rw [freeGo_none fuel w prev rows hf,
        kernelGo_none fuel w prev rows hf, ground.length_range,
        length_idList]
    | some ij =>
      obtain ⟨i, j⟩ := ij
      rw [freeGo_some fuel w prev rows i j hf,
        kernelGo_some fuel w prev rows i j hf, ground.length_map,
        ground.length_map]
      exact length_freeGo fuel (w - 1) _ _

/-- The crossed pivots' product: the descent's pivots folded from
the stated state down, the product's unit at the terminal step. -/
private def pivGo (fuel : Nat) (prev : BPair)
    (rows : List SRow) : BPair :=
  descGo (fun _ => BPair.ofPos .one) (fun _ _ p b => p.1 * b)
    fuel 0 prev rows

/-- The product at spent fuel: the terminal read. -/
private theorem pivGo_zero (prev : BPair) (rows : List SRow) :
    pivGo 0 prev rows = BPair.ofPos .one := rfl

/-- The product at an answered-nothing search: the terminal
read. -/
private theorem pivGo_none (fuel : Nat) (prev : BPair)
    (rows : List SRow) (hf : sFind rows = none) :
    pivGo (fuel + 1) prev rows = BPair.ofPos .one :=
  descGo_none _ _ fuel 0 prev rows hf

/-- The product at a found pivot: the pivot against the stepped
state's own product. -/
private theorem pivGo_some (fuel : Nat) (prev : BPair)
    (rows : List SRow) (i j : Nat)
    (hf : sFind rows = some (i, j)) :
    pivGo (fuel + 1) prev rows
      = (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
        * pivGo fuel
          (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
          (stepRows prev
            (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
            (rows.eraseIdx i)) :=
  descGo_some _ _ fuel 0 prev rows i j hf

/-- Every pivot-free column sits below the stated width: the
terminal columns are the keys themselves and a round's lift keeps
the round below's bound. -/
private theorem freeGo_lt : ∀ (fuel w : Nat) (prev : BPair)
    (rows : List SRow) (k : Nat),
    k < (freeGo fuel w prev rows).length →
      ground.getAt 0 (freeGo fuel w prev rows) k < w
  | 0, w, prev, rows, k, hk => by
    rw [freeGo_zero w prev rows] at hk ⊢
    rw [ground.length_range] at hk
    rw [ground.getAt_range w k hk]
    exact hk
  | fuel + 1, w, prev, rows, k, hk => by
    cases hf : sFind rows with
    | none =>
      rw [freeGo_none fuel w prev rows hf] at hk ⊢
      rw [ground.length_range] at hk
      rw [ground.getAt_range w k hk]
      exact hk
    | some ij =>
      obtain ⟨i, j⟩ := ij
      rw [freeGo_some fuel w prev rows i j hf] at hk ⊢
      rw [ground.length_map] at hk
      rw [ground.getAt_map 0 0 (liftIx j) _ k hk]
      have hih := freeGo_lt fuel (w - 1)
        (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
        (stepRows prev
          (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
          (rows.eraseIdx i)) k hk
      cases w with
      | zero => exact absurd hih (Nat.not_lt_zero _)
      | succ w' => exact liftIx_lt hih

/-- The crossed pivots' product sits off the sum's unit at the
sortedness alone: the terminal read is the product's own one, a
found pivot is a stored value and stored values sit off the unit
class, the round below reads the stepped rows' own sortedness, and
the product keeps the read at the product's injectivity. -/
private theorem pivGo_off : ∀ (fuel : Nat) (prev : BPair)
    (rows : List SRow), rowsOk rows →
      ¬ (pivGo fuel prev rows).oneValue BPair.unit
  | 0, prev, rows, _ => by
    rw [pivGo_zero prev rows]
    exact BPair.ofNat_one_off
  | fuel + 1, prev, rows, hro => by
    cases hf : sFind rows with
    | none =>
      rw [pivGo_none fuel prev rows hf]
      exact BPair.ofNat_one_off
    | some ij =>
      obtain ⟨i, j⟩ := ij
      have hi : i < rows.length := sFind_lt rows i j hf
      have hsi := rowsOk_getAt rows i hro hi
      have hp1eq : (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
          = ground.keyAt Nat.beq BPair.unit j
            (ground.getAt ((0, []) : SRow) rows i).2 :=
        keyAt_peel_head j
          (ground.getAt ((0, []) : SRow) rows i).2 hsi.1
      have hoff : ¬ (sPeel j
          (ground.getAt ((0, []) : SRow) rows i)).1.oneValue
          BPair.unit := by
        obtain ⟨v, es, hrow⟩ := sFind_at rows i j hf
        rw [hp1eq, hrow, keyAt_hit (ground.beqRefl j) v es]
        have hent : entsOk ((j, v) :: es) := by
          rw [← hrow]
          exact hsi.2
        exact (show (¬ v.oneValue BPair.unit) ∧ entsOk es from hent).1
      rw [pivGo_some fuel prev rows i j hf]
      intro hcon
      exact pivGo_off fuel _ _
        (rowsOk_stepRows prev
          (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
          (keysAsc_peel j (ground.getAt ((0, []) : SRow) rows i).2 0
            hsi.1 (Nat.zero_le j))
          (rows.eraseIdx i) (rowsOk_eraseIdx rows i hro))
        (mul_cancel_unit hoff hcon)

/-- Each member reads the crossed pivots' product at its own
pivot-free coordinate — the terminal seed's one scaled by every
round's pivot on the way back up — and the unit at every further
pivot-free coordinate. -/
private theorem freeGo_coords (m : Mat) :
    ∀ (fuel : Nat) (rs cs ri cj : List Nat) (prev : BPair)
      (rows : List SRow), KInv m rs cs ri cj prev rows →
      rows.length ≤ fuel →
      ∀ k, k < (kernelGo fuel cj.length prev rows).length →
        ((ground.getAt BPair.unit
            (ground.getAt [] (kernelGo fuel cj.length prev rows) k)
            (ground.getAt 0
              (freeGo fuel cj.length prev rows) k)).oneValue
          (pivGo fuel prev rows))
        ∧ ∀ k', k' < (kernelGo fuel cj.length prev rows).length →
          ¬ k' = k →
          (ground.getAt BPair.unit
            (ground.getAt [] (kernelGo fuel cj.length prev rows) k)
            (ground.getAt 0
              (freeGo fuel cj.length prev rows) k')).oneValue
            BPair.unit
  | 0, _, _, _, cj, prev, rows, _, _, k, hk => by
    rw [kernelGo_zero cj.length prev rows] at hk ⊢
    rw [freeGo_zero cj.length prev rows, length_idList]
    rw [length_idList] at hk
    exact idList_coords cj.length k hk
  | fuel + 1, rs, cs, ri, cj, prev, rows, inv, hfuel, k, hk => by
    cases hf : sFind rows with
    | none =>
      rw [kernelGo_none fuel cj.length prev rows hf] at hk ⊢
      rw [freeGo_none fuel cj.length prev rows hf,
        pivGo_none fuel prev rows hf, length_idList]
      rw [length_idList] at hk
      exact idList_coords cj.length k hk
    | some ij =>
      obtain ⟨i, j⟩ := ij
      have hi : i < rows.length := sFind_lt rows i j hf
      have hj : j < cj.length :=
        sFind_key cj.length rows i j inv.widths hf
      have hecj : (cj.eraseIdx j).length + 1 = cj.length :=
        ground.length_eraseIdx cj j hj
      have herow : (rows.eraseIdx i).length + 1 = rows.length :=
        ground.length_eraseIdx rows i hi
      have hW : cj.length - 1 = (cj.eraseIdx j).length := by
        rw [← hecj]
        rfl
      have hjs : j < (cj.eraseIdx j).length + 1 := by
        rw [hecj]
        exact hj
      have inv' := kinv_step m rs cs ri cj prev rows inv i j hf
      have hstep : (stepRows prev
          (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
          (rows.eraseIdx i)).length
          = (rows.eraseIdx i).length := length_stepRows _ _ _ _
      have hfuel' : (stepRows prev
          (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
          (rows.eraseIdx i)).length ≤ fuel := by
        rw [hstep]
        have h1 : (rows.eraseIdx i).length + 1 ≤ fuel + 1 := by
          rw [herow]
          exact hfuel
        exact Nat.le_of_succ_le_succ h1
      rw [kernelGo_some fuel cj.length prev rows i j hf, hW] at hk
      rw [kernelGo_some fuel cj.length prev rows i j hf,
        freeGo_some fuel cj.length prev rows i j hf, hW]
      have hkK : k < (kernelGo fuel (cj.eraseIdx j).length
          (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
          (stepRows prev
            (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
            (rows.eraseIdx i))).length := by
        rw [ground.length_map] at hk
        exact hk
      have hkF : k < (freeGo fuel (cj.eraseIdx j).length
          (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
          (stepRows prev
            (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
            (rows.eraseIdx i))).length := by
        rw [length_freeGo]
        exact hkK
      have hvk : (ground.getAt ([] : List BPair)
          (kernelGo fuel (cj.eraseIdx j).length
            (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
            (stepRows prev
              (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
              (rows.eraseIdx i))) k).length
          = (cj.eraseIdx j).length :=
        rowsLen_getAt _ k (kernelGo_rowsLen fuel _ _ _) hkK
      have hjle : j ≤ (vecScale
          (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
          (ground.getAt ([] : List BPair)
            (kernelGo fuel (cj.eraseIdx j).length
              (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
              (stepRows prev
                (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
                (rows.eraseIdx i))) k)).length := by
        rw [length_vecScale, hvk]
        exact Nat.le_of_lt_succ hjs
      have hih := freeGo_coords m fuel (rs ++ [ground.getAt 0 ri i])
        (cs ++ [ground.getAt 0 cj j]) (ri.eraseIdx i)
        (cj.eraseIdx j)
        (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
        (stepRows prev
          (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
          (rows.eraseIdx i)) inv' hfuel' k hkK
      have hread : ∀ k'', k'' < (freeGo fuel (cj.eraseIdx j).length
          (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
          (stepRows prev
            (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
            (rows.eraseIdx i))).length →
          ground.getAt BPair.unit
            (ground.getAt []
              ((kernelGo fuel (cj.eraseIdx j).length
                (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
                (stepRows prev
                  (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
                  (rows.eraseIdx i))).map
                (fun v => insertAt
                  ((dotN (denseRow (cj.eraseIdx j).length
                    (sPeel j
                      (ground.getAt ((0, []) : SRow) rows i)).2)
                    v).swap)
                  (vecScale
                    (sPeel j
                      (ground.getAt ((0, []) : SRow) rows i)).1 v)
                  j)) k)
            (ground.getAt 0
              ((freeGo fuel (cj.eraseIdx j).length
                (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
                (stepRows prev
                  (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
                  (rows.eraseIdx i))).map (liftIx j)) k'')
          = (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
            * ground.getAt BPair.unit
              (ground.getAt []
                (kernelGo fuel (cj.eraseIdx j).length
                  (sPeel j
                    (ground.getAt ((0, []) : SRow) rows i)).1
                  (stepRows prev
                    (sPeel j
                      (ground.getAt ((0, []) : SRow) rows i)) j
                    (rows.eraseIdx i))) k)
              (ground.getAt 0
                (freeGo fuel (cj.eraseIdx j).length
                  (sPeel j
                    (ground.getAt ((0, []) : SRow) rows i)).1
                  (stepRows prev
                    (sPeel j
                      (ground.getAt ((0, []) : SRow) rows i)) j
                    (rows.eraseIdx i))) k'') := by
        intro k'' hk''
        have hqW := freeGo_lt fuel (cj.eraseIdx j).length
          (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
          (stepRows prev
            (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
            (rows.eraseIdx i)) k'' hk''
        rw [ground.getAt_map ([] : List BPair) ([] : List BPair) _ _
            k hkK,
          ground.getAt_map 0 0 (liftIx j) _ k'' hk'',
          getAt_insertAt_lift BPair.unit _ _ j _ hjle,
          getAt_vecScale _ _ _ (by rw [hvk]; exact hqW)]
      refine ⟨?_, ?_⟩
      · rw [hread k hkF, pivGo_some fuel prev rows i j hf]
        exact BPair.mul_congr (BPair.oneValue_refl _) hih.1
      · intro k' hk' hne
        have hk'K : k' < (kernelGo fuel (cj.eraseIdx j).length
            (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
            (stepRows prev
              (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
              (rows.eraseIdx i))).length := by
          rw [ground.length_map] at hk'
          exact hk'
        have hk'F : k' < (freeGo fuel (cj.eraseIdx j).length
            (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
            (stepRows prev
              (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
              (rows.eraseIdx i))).length := by
          rw [length_freeGo]
          exact hk'K
        rw [hread k' hk'F]
        exact oneValue_mul_unit _ _ (hih.2 k' hk'K hne)

/-- A combination reading the sum's unit at a coordinate where one
member sits off it and every other at it clears that member's
coefficient: the coordinate's fold is the one-index pairing and the
off-unit read cancels. -/
private theorem combo_pick (n : Nat) (L : Mat) (hL : rowsLen n L)
    (cs : List BPair) (hcs : cs.length = L.length)
    (hcombo : poly.unitTail (combo n cs L)) (k q : Nat)
    (hk : k < L.length) (hq : q < n)
    (hdiag : ¬ (ground.getAt BPair.unit
      (ground.getAt [] L k) q).oneValue BPair.unit)
    (hoff : ∀ k', k' < L.length → ¬ k' = k →
      (ground.getAt BPair.unit
        (ground.getAt [] L k') q).oneValue BPair.unit) :
    (ground.getAt BPair.unit cs k).oneValue BPair.unit := by
  have hM : (L.map (fun r => ground.getAt BPair.unit r q)).length
      = L.length := ground.length_map _ L
  have hoff' : ∀ k', k' < (L.map
        (fun r => ground.getAt BPair.unit r q)).length →
      ¬ k' = k →
      (ground.getAt BPair.unit
        (L.map (fun r => ground.getAt BPair.unit r q)) k').oneValue
        BPair.unit := by
    intro k' hk' hne
    rw [hM] at hk'
    rw [ground.getAt_map ([] : List BPair) BPair.unit _ L k' hk']
    exact hoff k' hk' hne
  have hpick := dotP_oneIndex cs
    (L.map (fun r => ground.getAt BPair.unit r q)) k
    (hcs.trans hM.symm) (by rw [hM]; exact hk) hoff'
  have hcoord := poly.getAt_unitTail hcombo q
  have hsum : (dotP cs (L.map
      (fun r => ground.getAt BPair.unit r q))).oneValue
      BPair.unit :=
    BPair.oneValue_trans
      (BPair.oneValue_symm (combo_getAt n cs L q hL hq)) hcoord
  have hprod := BPair.oneValue_trans
    (BPair.oneValue_symm hpick) hsum
  rw [ground.getAt_map ([] : List BPair) BPair.unit _ L k hk,
    BPair.mul_comm] at hprod
  exact mul_cancel_unit hdiag hprod

/-- The pivot-free columns at the stated width: the back solve's
own column list, one key per member (`def:elim` — "the kernel list
enters per pivot-free column"). -/
def freeCols (cols : Nat) (m : Mat) : List Nat :=
  freeGo m.length cols (BPair.ofPos .one) (m.map ofRow)

/-- The crossed pivots' product: the descent's pivots folded
whole, the terminal step's one scaled by every round's pivot. -/
def pivotProd (m : Mat) : BPair :=
  pivGo m.length (BPair.ofPos .one) (m.map ofRow)

/-- The crossed pivots' product sits off the sum's unit at every
matrix: the sparse reading stores no unit value, so every crossed
pivot sits off the unit class and the product does too. -/
theorem pivotProd_off (m : Mat) : ¬ (pivotProd m).oneValue BPair.unit :=
  pivGo_off m.length (BPair.ofPos .one) (m.map ofRow) (rowsOk_ofRow m)

/-- One pivot-free column per kernel member. -/
theorem freeCols_length (cols : Nat) (m : Mat) :
    (freeCols cols m).length = (kernelList cols m).length :=
  length_freeGo m.length cols (BPair.ofPos .one) (m.map ofRow)

/-- Each kernel member reads the crossed pivots' product at its
own pivot-free coordinate and the unit at every further one: the
independence's stated read, `def:elim`'s sentence at the descent's
own data. -/
theorem kernelList_coords (cols : Nat) (m : Mat)
    (hm : rowsLen cols m) :
    ∀ k : Nat, k < (kernelList cols m).length →
      ((ground.getAt BPair.unit
          (ground.getAt [] (kernelList cols m) k)
          (ground.getAt 0 (freeCols cols m) k)).oneValue
        (pivotProd m))
      ∧ ∀ k' : Nat, k' < (kernelList cols m).length → ¬ k' = k →
        (ground.getAt BPair.unit
          (ground.getAt [] (kernelList cols m) k)
          (ground.getAt 0 (freeCols cols m) k')).oneValue
          BPair.unit := by
  intro k hk
  have hlr : (List.range cols).length = cols :=
    ground.length_range cols
  have hrows : (m.map ofRow).length = m.length :=
    ground.length_map _ m
  have hfuel : (m.map ofRow).length ≤ m.length := by
    rw [hrows]
    exact Nat.le_refl _
  have hk' : k < (kernelGo m.length (List.range cols).length
      (BPair.ofPos .one) (m.map ofRow)).length := by
    rw [hlr]
    exact hk
  have h := freeGo_coords m m.length [] [] (List.range m.length)
    (List.range cols) (BPair.ofPos .one) (m.map ofRow)
    (kinv_init cols m hm) hfuel k hk'
  rw [hlr] at h
  exact h

/-- The kernel list is independent at the stated width: each
member off the unit at its own pivot-free coordinate, the crossed
pivots' product, and at the unit at the further ones. -/
theorem kernelList_indep (cols : Nat) (m : Mat)
    (hm : rowsLen cols m) :
    indepRows cols (kernelList cols m) := by
  have hlr : (List.range cols).length = cols :=
    ground.length_range cols
  have hrows : (m.map ofRow).length = m.length :=
    ground.length_map _ m
  have hfuel : (m.map ofRow).length ≤ m.length := by
    rw [hrows]
    exact Nat.le_refl _
  refine indep_intro cols (kernelList cols m)
    (kernelList_rowsLen cols m) ?_
  have hcoords := kernelList_coords cols m hm
  intro csf hcsf hcombo
  refine unitTail_of_getAt csf ?_
  intro k hk
  rw [hcsf] at hk
  have hkF : k < (freeGo m.length cols (BPair.ofPos .one)
      (m.map ofRow)).length := by
    rw [length_freeGo]
    exact hk
  exact combo_pick cols (kernelList cols m)
    (kernelList_rowsLen cols m) csf hcsf hcombo k
    (ground.getAt 0
      (freeGo m.length cols (BPair.ofPos .one) (m.map ofRow)) k) hk
    (freeGo_lt m.length cols (BPair.ofPos .one) (m.map ofRow) k hkF)
    (fun hcon => pivGo_off m.length (BPair.ofPos .one)
      (m.map ofRow) (rowsOk_ofRow m)
      (BPair.oneValue_trans
        (BPair.oneValue_symm (hcoords k hk).1) hcon))
    (fun k' hk' hne => (hcoords k' hk').2 k hk
      (fun he => hne he.symm))

/-! The span tier: every kernel member joins the back solve's own
span at a cleared multiple, the pivot coordinates read off the
struck vector's two row pairings. -/

/-- A coordinate off an inserted place names the base place it
reads, the lift carrying it back. -/
private theorem insertIx_lift (j w c : Nat) (hj : j ≤ w)
    (hc : c < w + 1) (hne : ¬ c = j) :
    ∃ d, d < w ∧ liftIx j d = c := by
  match Nat.lt_or_ge c j with
  | Or.inl hlt =>
    exact ⟨c, Nat.lt_of_lt_of_le hlt hj, liftIx_lo j c hlt⟩
  | Or.inr hge =>
    have hjc : j < c :=
      Nat.lt_of_le_of_ne hge (fun he => hne he.symm)
    cases c with
    | zero => exact absurd hjc (Nat.not_lt_zero j)
    | succ e =>
      exact ⟨e, Nat.lt_of_succ_lt_succ hc,
        liftIx_gt j e (Nat.not_lt_of_ge (Nat.le_of_lt_succ hjc))⟩

/-- The struck vector's entry at a place is the vector's own at
the lifted place. -/
private theorem getAt_strike (v : List BPair) (j d : Nat) :
    ground.getAt BPair.unit (strike j v) d
      = ground.getAt BPair.unit v (liftIx j d) := by
  show ground.getAt BPair.unit (v.eraseIdx j) d
    = ground.getAt BPair.unit v (liftIx j d)
  rw [getAt_eraseIdx BPair.unit v j d]
  show (if d < j then ground.getAt BPair.unit v d
      else ground.getAt BPair.unit v (d + 1))
    = ground.getAt BPair.unit v (if d < j then d else d + 1)
  by_cases h : d < j
  · rw [if_pos h, if_pos h]
  · rw [if_neg h, if_neg h]

/-- Two maps of one framed family agreeing at every member of the
stated width read one value. -/
private theorem oneValue_map_rowsLen (w : Nat)
    (f g : List BPair → BPair)
    (h : ∀ u : List BPair, u.length = w → (f u).oneValue (g u))
    (K : Mat) (hK : rowsLen w K) :
    poly.oneValue (K.map f) (K.map g) :=
  poly.oneValue_map f g K (fun u hu =>
    match ground.getAt_of_mem ([] : List BPair) hu with
    | ⟨k, hk, hke⟩ => h u (hke ▸ rowsLen_getAt K k hK hk))

/-- The terminal seed sits at the stated width. -/
theorem rowsLen_idList (w : Nat) : rowsLen w (idList w) :=
  rowsLen_map (fun c => List.set (List.replicate w BPair.unit) c
      (BPair.ofPos .one)) w (List.range w) (fun x _ => (fun _ => by rw [ground.length_set, ground.length_replicate]) x)

/-- The terminal seed spans everything at the product's one: each
unit family picks its own coefficient out of the combination. -/
private theorem combo_idList (w : Nat) (u : List BPair)
    (hu : u.length = w) :
    poly.oneValue (vecScale (BPair.ofPos .one) u)
      (combo w u (idList w)) := by
  refine poly.oneValue_of_entries _ _ ?_ ?_
  · rw [length_vecScale, hu,
      length_combo w u (idList w) (rowsLen_idList w)]
  · intro q hq
    rw [length_vecScale, hu] at hq
    have hM : ((idList w).map
        (fun r => ground.getAt BPair.unit r q)).length = w := by
      rw [ground.length_map, length_idList]
    have hoff : ∀ kk, kk < ((idList w).map
          (fun r => ground.getAt BPair.unit r q)).length →
        ¬ kk = q →
        (ground.getAt BPair.unit ((idList w).map
          (fun r => ground.getAt BPair.unit r q)) kk).oneValue
          BPair.unit := by
      intro kk hkk hne
      rw [hM] at hkk
      rw [ground.getAt_map ([] : List BPair) BPair.unit _ (idList w)
          kk (by rw [length_idList]; exact hkk),
        idList_getAt w kk hkk,
        ground.getAt_set_ne BPair.unit (List.replicate w BPair.unit) kk
          q (BPair.ofPos .one) (fun he => hne he.symm),
        ground.getAt_replicate_self BPair.unit w q]
      exact BPair.oneValue_refl _
    have hdiag : ground.getAt BPair.unit ((idList w).map
        (fun r => ground.getAt BPair.unit r q)) q
        = BPair.ofPos .one := by
      rw [ground.getAt_map ([] : List BPair) BPair.unit _ (idList w)
          q (by rw [length_idList]; exact hq),
        idList_getAt w q hq,
        ground.getAt_set_self BPair.unit (BPair.ofPos .one)
          (List.replicate w BPair.unit) q
          (by rw [ground.length_replicate]; exact hq)]
    have hpick := dotP_oneIndex u ((idList w).map
        (fun r => ground.getAt BPair.unit r q)) q
      (by rw [hM, hu]) (by rw [hM]; exact hq) hoff
    rw [hdiag] at hpick
    rw [getAt_vecScale _ _ q (by rw [hu]; exact hq)]
    refine BPair.oneValue_trans ?_
      (BPair.oneValue_symm
        (combo_getAt w u (idList w) q (rowsLen_idList w) hq))
    refine BPair.oneValue_trans
      (BPair.oneValue_of_eq
        (BPair.mul_comm (BPair.ofPos .one)
          (ground.getAt BPair.unit u q))) ?_
    exact BPair.oneValue_trans
      (BPair.mul_one_read (ground.getAt BPair.unit u q))
      (BPair.oneValue_symm
        (BPair.oneValue_trans hpick
          (BPair.mul_one_read (ground.getAt BPair.unit u q))))

/-- The extension's combination off the inserted place: the
coefficients' fold at a base coordinate is the pivot's multiple of
the combination's own read there. -/
private theorem combo_mapExt_off (w : Nat) (P0 : BPair)
    (f : List BPair → BPair) (d : Nat) (hd : d < w)
    (cs : List BPair) (K : Mat) (hK : rowsLen w K)
    (hf : ∀ u : List BPair, u.length = w →
      (f u).oneValue (P0 * ground.getAt BPair.unit u d)) :
    (dotP cs (K.map f)).oneValue
      (P0 * ground.getAt BPair.unit (combo w cs K) d) := by
  have hmm : vecScale P0
      (K.map (fun u => ground.getAt BPair.unit u d))
      = K.map (fun u => P0 * ground.getAt BPair.unit u d) :=
    ground.map_map (fun u => ground.getAt BPair.unit u d)
      (fun x => P0 * x) K
  refine BPair.oneValue_trans
    (dotP_oneValue_right cs _ _
      (show poly.oneValue (K.map f)
          (vecScale P0
            (K.map (fun u => ground.getAt BPair.unit u d)))
        from by
          rw [hmm]
          exact oneValue_map_rowsLen w f _ hf K hK)) ?_
  refine BPair.oneValue_trans (dotP_vecScale_right cs _ P0) ?_
  exact BPair.mul_congr (BPair.oneValue_refl P0)
    (BPair.oneValue_symm (combo_getAt w cs K d hK hd))

/-- The extension's combination whole: the round's insertion
commutes with the combination, the inserted place reading the pivot
row's pairing against the combination and every other the pivot's
multiple of it — read entry by entry, never by commuting the fold
structurally. -/
private theorem combo_mapExt (w : Nat) (t : List BPair)
    (P0 : BPair) (j : Nat) (hj : j ≤ w)
    (cs : List BPair) (K : Mat) (hK : rowsLen w K) :
    poly.oneValue
      (combo (w + 1) cs (K.map (fun u =>
        insertAt ((dotN t u).swap) (vecScale P0 u) j)))
      (insertAt ((dotP t (combo w cs K)).swap)
        (vecScale P0 (combo w cs K)) j) := by
  have hC : (combo w cs K).length = w := length_combo w cs K hK
  have hext : rowsLen (w + 1) (K.map (fun u =>
      insertAt ((dotN t u).swap) (vecScale P0 u) j)) :=
    rowsLen_extend w j P0 t K hK
  refine poly.oneValue_of_entries _ _ ?_ ?_
  · rw [length_combo (w + 1) cs _ hext, length_insertAt,
      length_vecScale, hC]
  · intro c hc
    rw [length_combo (w + 1) cs _ hext] at hc
    refine BPair.oneValue_trans
      (combo_getAt (w + 1) cs _ c hext hc) ?_
    rw [ground.map_map]
    by_cases hcj : c = j
    · rw [hcj, getAt_insertAt BPair.unit _ _ j j
          (by rw [length_vecScale, hC]; exact hj),
        if_neg (Nat.lt_irrefl j), if_pos rfl]
      refine BPair.oneValue_trans
        (dotP_oneValue_right cs _
          ((K.map (fun u => dotP t u)).map BPair.swap)
          (by
            rw [ground.map_map]
            refine oneValue_map_rowsLen w _ _ ?_ K hK
            intro u hu
            rw [getAt_insertAt BPair.unit _ _ j j
                (by rw [length_vecScale, hu]; exact hj),
              if_neg (Nat.lt_irrefl j), if_pos rfl]
            exact ground.swap_congr (dotN_read t u))) ?_
      rw [dotP_swapMap]
      exact ground.swap_congr
        (BPair.oneValue_symm (dotP_combo cs K t w hK))
    · obtain ⟨d, hd, hlift⟩ := insertIx_lift j w c hj hc hcj
      rw [← hlift,
        getAt_insertAt_lift BPair.unit _ _ j d
          (by rw [length_vecScale, hC]; exact hj),
        getAt_vecScale P0 _ d (by rw [hC]; exact hd)]
      refine combo_mapExt_off w P0 _ d hd cs K hK ?_
      intro u hu
      rw [getAt_insertAt_lift BPair.unit _ _ j d
          (by rw [length_vecScale, hu]; exact hj),
        getAt_vecScale P0 u d (by rw [hu]; exact hd)]
      exact BPair.oneValue_refl _

/-- A row off the struck place names a source row: the struck list
reads the source below the struck key and one place higher past
it. -/
private theorem eraseIdx_source {α : Type} (d : α) (l : List α)
    (i b : Nat) (hi : i < l.length)
    (hb : b < (l.eraseIdx i).length) :
    ∃ a, a < l.length
      ∧ ground.getAt d l a = ground.getAt d (l.eraseIdx i) b := by
  have hlen : (l.eraseIdx i).length + 1 = l.length :=
    ground.length_eraseIdx l i hi
  match Nat.lt_or_ge b i with
  | Or.inl hbi =>
    refine ⟨b, Nat.lt_trans hbi hi, ?_⟩
    rw [getAt_eraseIdx d l i b, if_pos hbi]
  | Or.inr hge =>
    refine ⟨b + 1, ?_, ?_⟩
    · rw [← hlen]
      exact Nat.succ_lt_succ hb
    · rw [getAt_eraseIdx d l i b, if_neg (Nat.not_lt_of_ge hge)]

/-- The update display's pairing against a vector: the pivot's
multiple of the entry row's peeled pairing joined to the entry's
border multiple of the pivot row's, the swap the subtraction. -/
private theorem dotP_display (w : Nat) (P0 r0 : BPair)
    (E T u : List BPair) (hE : E.length = w) (hT : T.length = w)
    (hu : u.length = w) :
    (dotP (vecAdd (vecScale P0 E) ((vecScale r0 T).map BPair.swap))
      u).oneValue (P0 * dotP E u + (r0 * dotP T u).swap) := by
  refine BPair.oneValue_trans
    (dotP_vecAdd_left _ _ u
      (by rw [hu, length_vecScale, hE]; exact Nat.le_refl _)
      (by rw [hu, ground.length_map, length_vecScale, hT]
          exact Nat.le_refl _)) ?_
  refine BPair.add_congr ?_ ?_
  · exact BPair.oneValue_trans
      (BPair.oneValue_of_eq (dotP_comm (vecScale P0 E) u))
      (BPair.oneValue_trans (dotP_vecScale_right u E P0)
        (BPair.mul_congr (BPair.oneValue_refl P0)
          (BPair.oneValue_of_eq (dotP_comm u E))))
  · rw [dotP_comm, dotP_swapMap]
    exact ground.swap_congr
      (BPair.oneValue_trans (dotP_vecScale_right u T r0)
        (BPair.mul_congr (BPair.oneValue_refl r0)
          (BPair.oneValue_of_eq (dotP_comm u T))))

/-- A state row's pairing against the struck vector is the balance
partner of its pivot entry against the vector's pivot coordinate:
the row's pairing splits at the pivot column and the whole pairing
sits at the sum's unit. -/
private theorem strike_row_read (w : Nat) (r : SRow)
    (hr : keysAsc 0 r.2) (v : List BPair) (hv : v.length = w + 1)
    (j : Nat) (hj : j < w + 1)
    (hnull : (dotP (denseRow (w + 1) r) v).oneValue BPair.unit) :
    (dotP (denseRow w (sPeel j r).2) (strike j v)).oneValue
      ((ground.keyAt Nat.beq BPair.unit j r.2 * ground.getAt BPair.unit v j).swap) := by
  have hlen : (denseRow (w + 1) r).length = v.length := by
    rw [length_denseRow, hv]
  have hjv : j < v.length := by
    rw [hv]
    exact hj
  have hsplit := dotP_strike (denseRow (w + 1) r) v j hlen hjv
  rw [getAt_denseRow (w + 1) r j hj,
    ← denseRow_sPeel (w + 1) j r hr hj] at hsplit
  exact swapOfAddNull
    (BPair.oneValue_trans (BPair.oneValue_symm hsplit) hnull)

/-- Every kernel member joins the back solve's span at a cleared
multiple: the pivot coordinates one value at the off-unit pivots
by the product's injectivity, the cleared combination at the
pivot-free coordinates reading the member whole. -/
private theorem kernelGo_span (m : Mat) :
    ∀ (fuel : Nat) (rs cs ri cj : List Nat) (prev : BPair)
      (rows : List SRow), KInv m rs cs ri cj prev rows →
      rows.length ≤ fuel →
      ∀ v : List BPair, v.length = cj.length →
      (∀ a, a < rows.length →
        (dotP (denseRow cj.length
            (ground.getAt ((0, []) : SRow) rows a)) v).oneValue
          BPair.unit) →
      ∃ c₀ cs', (¬ c₀.oneValue BPair.unit)
        ∧ cs'.length = (kernelGo fuel cj.length prev rows).length
        ∧ poly.oneValue (vecScale c₀ v)
            (combo cj.length cs'
              (kernelGo fuel cj.length prev rows))
  | 0, _, _, _, cj, prev, rows, _, _, v, hv, _ => by
    rw [kernelGo_zero cj.length prev rows]
    exact ⟨BPair.ofPos .one, v, BPair.ofNat_one_off,
      by rw [length_idList]; exact hv,
      combo_idList cj.length v hv⟩
  | fuel + 1, rs, cs, ri, cj, prev, rows, inv, hfuel, v, hv,
      hnull => by
    cases hf : sFind rows with
    | none =>
      rw [kernelGo_none fuel cj.length prev rows hf]
      exact ⟨BPair.ofPos .one, v, BPair.ofNat_one_off,
        by rw [length_idList]; exact hv,
        combo_idList cj.length v hv⟩
    | some ij =>
      obtain ⟨i, j⟩ := ij
      have hi : i < rows.length := sFind_lt rows i j hf
      have hj : j < cj.length :=
        sFind_key cj.length rows i j inv.widths hf
      have hecj : (cj.eraseIdx j).length + 1 = cj.length :=
        ground.length_eraseIdx cj j hj
      have herow : (rows.eraseIdx i).length + 1 = rows.length :=
        ground.length_eraseIdx rows i hi
      have hW : cj.length - 1 = (cj.eraseIdx j).length := by
        rw [← hecj]
        rfl
      have hsi := rowsOk_getAt rows i inv.sorted hi
      have hp1 : (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
          = ground.keyAt Nat.beq BPair.unit j (ground.getAt ((0, []) : SRow) rows i).2 :=
        keyAt_peel_head j
          (ground.getAt ((0, []) : SRow) rows i).2 hsi.1
      have hjs : j < (cj.eraseIdx j).length + 1 := by
        rw [hecj]
        exact hj
      have hvW : v.length = (cj.eraseIdx j).length + 1 := by
        rw [hecj]
        exact hv
      have inv' := kinv_step m rs cs ri cj prev rows inv i j hf
      have hstep : (stepRows prev
          (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
          (rows.eraseIdx i)).length
          = (rows.eraseIdx i).length := length_stepRows _ _ _ _
      have hfuel' : (stepRows prev
          (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
          (rows.eraseIdx i)).length ≤ fuel := by
        rw [hstep]
        have h1 : (rows.eraseIdx i).length + 1 ≤ fuel + 1 := by
          rw [herow]
          exact hfuel
        exact Nat.le_of_succ_le_succ h1
      have hvs : (strike j v).length = (cj.eraseIdx j).length := by
        have h1 : (strike j v).length + 1 = cj.length := by
          show (v.eraseIdx j).length + 1 = cj.length
          rw [ground.length_eraseIdx v j (by rw [hv]; exact hj), hv]
        refine Nat.succ.inj ?_
        show (strike j v).length + 1 = (cj.eraseIdx j).length + 1
        rw [h1, hecj]
      -- the pivot row's own struck pairing
      have hpiv : (dotP (denseRow (cj.eraseIdx j).length
          (sPeel j (ground.getAt ((0, []) : SRow) rows i)).2)
          (strike j v)).oneValue
          (((sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
            * ground.getAt BPair.unit v j).swap) := by
        rw [hp1]
        exact strike_row_read (cj.eraseIdx j).length
          (ground.getAt ((0, []) : SRow) rows i) hsi.1 v hvW j hjs
          (by rw [hecj]; exact hnull i hi)
      -- the stepped rows' null reads at the struck vector
      have hnull' : ∀ b, b < (stepRows prev
          (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
          (rows.eraseIdx i)).length →
          (dotP (denseRow (cj.eraseIdx j).length
            (ground.getAt ((0, []) : SRow)
              (stepRows prev
                (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
                (rows.eraseIdx i)) b)) (strike j v)).oneValue
            BPair.unit := by
        intro b hbs
        rw [hstep] at hbs
        obtain ⟨a, hasrc, haeq⟩ := eraseIdx_source ((0, []) : SRow)
          rows i b hi hbs
        have hsb := rowsOk_getAt (rows.eraseIdx i) b
          (rowsOk_eraseIdx rows i inv.sorted) hbs
        have hrow : (dotP (denseRow (cj.eraseIdx j).length
            (sPeel j (ground.getAt ((0, []) : SRow)
              (rows.eraseIdx i) b)).2) (strike j v)).oneValue
            ((ground.keyAt Nat.beq BPair.unit j (ground.getAt ((0, []) : SRow)
                (rows.eraseIdx i) b).2
              * ground.getAt BPair.unit v j).swap) := by
          refine strike_row_read (cj.eraseIdx j).length
            (ground.getAt ((0, []) : SRow) (rows.eraseIdx i) b)
            hsb.1 v hvW j hjs ?_
          rw [hecj, ← haeq]
          exact hnull a hasrc
        have hdisp := display_dense m rs cs ri cj prev rows inv i j
          hf b hbs
        refine mul_cancel_unit inv.prevOff ?_
        refine BPair.oneValue_trans
          (BPair.oneValue_symm
            (BPair.oneValue_trans
              (BPair.oneValue_of_eq (dotP_comm _ (strike j v)))
              (BPair.oneValue_trans
                (dotP_vecScale_right (strike j v) _ prev)
                (BPair.mul_congr (BPair.oneValue_refl prev)
                  (BPair.oneValue_of_eq
                    (dotP_comm (strike j v) _)))))) ?_
        refine BPair.oneValue_trans
          (dotP_oneValue_left _ _ (strike j v) hdisp) ?_
        refine BPair.oneValue_trans
          (dotP_display (cj.eraseIdx j).length
            (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
            (ground.keyAt Nat.beq BPair.unit j (ground.getAt ((0, []) : SRow)
              (rows.eraseIdx i) b).2)
            _ _ (strike j v) (length_denseRow _ _)
            (length_denseRow _ _) hvs) ?_
        refine BPair.oneValue_trans
          (BPair.add_congr
            (BPair.mul_congr (BPair.oneValue_refl _) hrow)
            (ground.swap_congr
              (BPair.mul_congr (BPair.oneValue_refl _) hpiv))) ?_
        exact BPair.swap_add_null (BPair.oneValue_of_eq
          (BPair.mul_left_comm
            (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
            (ground.keyAt Nat.beq BPair.unit j (ground.getAt ((0, []) : SRow)
              (rows.eraseIdx i) b).2)
            (ground.getAt BPair.unit v j)))
      obtain ⟨c0, cs0, hc0off, hc0len, hc0poly⟩ :=
        kernelGo_span m fuel (rs ++ [ground.getAt 0 ri i])
          (cs ++ [ground.getAt 0 cj j]) (ri.eraseIdx i)
          (cj.eraseIdx j)
          (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
          (stepRows prev
            (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
            (rows.eraseIdx i)) inv' hfuel' (strike j v) hvs hnull'
      rw [kernelGo_some fuel cj.length prev rows i j hf, hW,
        ← hecj]
      refine ⟨(sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
          * c0, cs0, ?_, ?_, ?_⟩
      · intro hcon
        exact hc0off (mul_cancel_unit inv'.prevOff hcon)
      · rw [ground.length_map]
        exact hc0len
      · refine poly.oneValue_trans ?_
          (poly.oneValue_symm
            (combo_mapExt (cj.eraseIdx j).length
              (denseRow (cj.eraseIdx j).length
                (sPeel j
                  (ground.getAt ((0, []) : SRow) rows i)).2)
              (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1 j
              (Nat.le_of_lt_succ hjs) cs0
              (kernelGo fuel (cj.eraseIdx j).length
                (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
                (stepRows prev
                  (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
                  (rows.eraseIdx i)))
              (kernelGo_rowsLen fuel _ _ _)))
        have hCK : (combo (cj.eraseIdx j).length cs0
            (kernelGo fuel (cj.eraseIdx j).length
              (sPeel j (ground.getAt ((0, []) : SRow) rows i)).1
              (stepRows prev
                (sPeel j (ground.getAt ((0, []) : SRow) rows i)) j
                (rows.eraseIdx i)))).length
            = (cj.eraseIdx j).length :=
          length_combo _ cs0 _ (kernelGo_rowsLen fuel _ _ _)
        refine poly.oneValue_of_entries _ _ ?_ ?_
        · rw [length_vecScale, hvW, length_insertAt,
            length_vecScale, hCK]
        · intro c hc
          rw [length_vecScale, hvW] at hc
          rw [getAt_vecScale _ _ c (by rw [hvW]; exact hc)]
          by_cases hcj : c = j
          · rw [hcj, getAt_insertAt BPair.unit _ _ j j
                (by rw [length_vecScale, hCK]
                    exact Nat.le_of_lt_succ hjs),
              if_neg (Nat.lt_irrefl j), if_pos rfl]
            refine BPair.oneValue_trans ?_
              (BPair.oneValue_symm (ground.swap_congr
                (BPair.oneValue_trans
                  (dotP_oneValue_right _ _ _
                    (poly.oneValue_symm hc0poly))
                  (BPair.oneValue_trans
                    (dotP_vecScale_right _ (strike j v) c0)
                    (BPair.mul_congr (BPair.oneValue_refl c0)
                      hpiv)))))
            exact BPair.oneValue_of_eq
              ((BPair.mul_assoc
                  (sPeel j
                    (ground.getAt ((0, []) : SRow) rows i)).1 c0
                  (ground.getAt BPair.unit v j)).trans
                (BPair.mul_left_comm
                  (sPeel j
                    (ground.getAt ((0, []) : SRow) rows i)).1 c0
                  (ground.getAt BPair.unit v j)))
          · obtain ⟨d, hd, hlift⟩ := insertIx_lift j
              (cj.eraseIdx j).length c
              (Nat.le_of_lt_succ hjs) hc hcj
            rw [← hlift,
              getAt_insertAt_lift BPair.unit _ _ j d
                (by rw [length_vecScale, hCK]
                    exact Nat.le_of_lt_succ hjs),
              getAt_vecScale _ _ d (by rw [hCK]; exact hd),
              ← getAt_strike v j d]
            refine BPair.oneValue_trans ?_
              (BPair.mul_congr (BPair.oneValue_refl _)
                (BPair.oneValue_symm
                  (BPair.oneValue_trans
                    (poly.oneValue_getAt d
                      (poly.oneValue_symm hc0poly))
                    (BPair.oneValue_of_eq
                      (getAt_vecScale c0 (strike j v) d
                        (by rw [hvs]; exact hd))))))
            exact BPair.oneValue_of_eq
              (BPair.mul_assoc _ _ _)

/-- Every kernel member joins the kernel list's span. -/
theorem kernelList_span (cols : Nat) (m : Mat)
    (hm : rowsLen cols m) (v : List BPair) (hv : v.length = cols)
    (hker : poly.unitTail (matVec m v)) :
    spanRel cols (kernelList cols m) v := by
  have hlr : (List.range cols).length = cols :=
    ground.length_range cols
  have hrows : (m.map ofRow).length = m.length :=
    ground.length_map _ m
  have hfuel : (m.map ofRow).length ≤ m.length := by
    rw [hrows]
    exact Nat.le_refl _
  have hnull : ∀ a, a < (m.map ofRow).length →
      (dotP (denseRow (List.range cols).length
        (ground.getAt ((0, []) : SRow) (m.map ofRow) a)) v).oneValue
        BPair.unit := by
    intro a ha
    rw [hrows] at ha
    rw [hlr]
    exact BPair.oneValue_trans
      (dotP_denseRow_row cols m hm v a ha)
      (matVec_row_null m v hker a ha)
  obtain ⟨c0, cs0, hc0off, hc0len, hc0poly⟩ :=
    kernelGo_span m m.length [] [] (List.range m.length)
      (List.range cols) (BPair.ofPos .one) (m.map ofRow)
      (kinv_init cols m hm) hfuel v (by rw [hlr]; exact hv) hnull
  rw [hlr] at hc0len hc0poly
  exact span_intro cols (kernelList cols m) v
    (kernelList_rowsLen cols m) hv ⟨c0, cs0, hc0off, hc0len,
      hc0poly⟩

/-- A joined span reads at either order: every row of the one join
sits in the other's span, the transitivity closing the read. -/
theorem spanRel_append_comm (n : Nat) (L M : Mat) (v : List BPair)
    (hL : rowsLen n L) (hM : rowsLen n M)
    (h : spanRel n (L ++ M) v) : spanRel n (M ++ L) v := by
  refine spanRel_trans n (L ++ M) (M ++ L) v
    (rowsLen_append n hL hM) (rowsLen_append n hM hL) ?_ h
  intro k hk
  rw [ground.getAt_append [] L M k]
  by_cases hkL : k < L.length
  · rw [if_pos hkL]
    exact spanRel_mono_left n M L _ hM hL
      (spanRel_getAt n L k hkL hL)
  · rw [if_neg hkL]
    obtain ⟨g, hg⟩ := Nat.le.dest (Nat.le_of_not_lt hkL)
    have hsub : k - L.length = g := by
      rw [← hg]
      exact ground.addSubSelfL L.length g
    have hgM : g < M.length := by
      have hk' : L.length + g < L.length + M.length := by
        rw [hg]
        have hlen : (L ++ M).length = L.length + M.length :=
          ground.length_append L M
        rw [← hlen]
        exact hk
      exact Nat.lt_of_add_lt_add_left hk'
    rw [hsub]
    exact spanRel_mono n M L _ hM hL
      (spanRel_getAt n M g hgM hM)

/-- The perpendicular parts of a unit-tail sum read the unit tail
each: a part's self-pairing walks through the sum at the crossed
pairing's unit, and the positive pairing withdraws it. -/
theorem vecAdd_perp_null (x y : List BPair)
    (hl : y.length = x.length)
    (hs : poly.unitTail (vecAdd x y))
    (hp : (dotP x y).oneValue BPair.unit) :
    poly.unitTail x ∧ poly.unitTail y := by
  have hxs : (dotP x x + dotP x y).oneValue BPair.unit :=
    BPair.oneValue_trans
      (BPair.oneValue_symm (dotP_vecAdd x x y rfl hl))
      (dotP_null_tail_right x (vecAdd x y) hs)
  have hx : (dotP x x).oneValue BPair.unit :=
    BPair.oneValue_trans
      (BPair.oneValue_symm
        (BPair.oneValue_trans
          (BPair.add_congr (BPair.oneValue_refl (dotP x x)) hp)
          (BPair.add_unit _)))
      hxs
  have hyx : (dotP y x).oneValue BPair.unit := by
    rw [dotP_comm y x]
    exact hp
  have hys : (dotP y x + dotP y y).oneValue BPair.unit :=
    BPair.oneValue_trans
      (BPair.oneValue_symm
        (dotP_vecAdd y x y hl.symm rfl))
      (dotP_null_tail_right y (vecAdd x y) hs)
  have hy : (dotP y y).oneValue BPair.unit :=
    BPair.oneValue_trans
      (BPair.oneValue_symm
        (BPair.oneValue_trans
          (BPair.add_congr hyx (BPair.oneValue_refl (dotP y y)))
          (BPair.unit_add _)))
      hys
  exact ⟨dotP_self_null x hx, dotP_self_null y hy⟩

/-- The span splits at a perpendicular tail: a member of the joined
span perpendicular to the tail's rows, the head's rows
perpendicular to them as well, sits in the head's span alone — the
tail's part of the combination pairs against every tail row at the
sum's unit, its self-pairing reads that unit, and the positive
pairing withdraws it (`lem:lowerspan`'s membership calculus at the
orthogonal split). -/
theorem span_perp_split (n : Nat) (A B : Mat) (v : List BPair)
    (hA : rowsLen n A) (hB : rowsLen n B)
    (hperpv : ∀ k, k < B.length →
      (dotP v (ground.getAt [] B k)).oneValue BPair.unit)
    (hperpA : ∀ j, j < A.length → ∀ k, k < B.length →
      (dotP (ground.getAt [] A j)
        (ground.getAt [] B k)).oneValue BPair.unit)
    (h : spanRel n (A ++ B) v) : spanRel n A v := by
  obtain ⟨c₀, cs, hc₀, hcl, hone⟩ := span_elim h
  have hAle : A.length ≤ cs.length := by
    rw [hcl, ground.length_append]
    exact Nat.le_add_right A.length B.length
  obtain ⟨csA, csB, hsplit, hlA⟩ := ground.listSplit cs A.length hAle
  have hcomboA : (combo n csA A).length = n := length_combo n csA A hA
  have hcomboB : (combo n csB B).length = n := length_combo n csB B hB
  have hchain : poly.oneValue (vecScale c₀ v)
      (vecAdd (combo n csA A) (combo n csB B)) := by
    refine poly.oneValue_trans ?_
      (combo_append n csA A csB B hlA hA hB)
    rw [← hsplit]
    exact hone
  have hperpAB : ∀ k, k < B.length → ∀ j, j < A.length →
      (dotP (ground.getAt [] B k)
        (ground.getAt [] A j)).oneValue BPair.unit := by
    intro k hk j hj
    rw [dotP_comm]
    exact hperpA j hj k hk
  have hstep : ∀ k, k < B.length →
      (dotP (ground.getAt [] B k) (combo n csB B)).oneValue
        BPair.unit := by
    intro k hk
    have hy : (ground.getAt ([] : List BPair) B k).length = n :=
      rowsLen_getAt B k hB hk
    have h1 : (dotP (ground.getAt [] B k)
        (vecScale c₀ v)).oneValue BPair.unit := by
      refine BPair.oneValue_trans
        (dotP_vecScale_right (ground.getAt [] B k) v c₀) ?_
      refine oneValue_mul_unit c₀ (dotP (ground.getAt [] B k) v) ?_
      rw [dotP_comm]
      exact hperpv k hk
    have h2 : (dotP (ground.getAt [] B k)
        (vecScale c₀ v)).oneValue
        (dotP (ground.getAt [] B k) (combo n csA A)
          + dotP (ground.getAt [] B k) (combo n csB B)) :=
      BPair.oneValue_trans
        (dotP_oneValue_right (ground.getAt [] B k) (vecScale c₀ v)
          (vecAdd (combo n csA A) (combo n csB B)) hchain)
        (dotP_vecAdd (ground.getAt [] B k) (combo n csA A)
          (combo n csB B) (by rw [hcomboA, hy])
          (by rw [hcomboB, hy]))
    have h3 : (dotP (ground.getAt [] B k)
        (combo n csA A)).oneValue BPair.unit :=
      dotP_comboNull n (ground.getAt [] B k) hy csA A hA
        (fun j hj => hperpAB k hk j hj)
    refine BPair.oneValue_trans
      (BPair.oneValue_symm
        (BPair.unit_add (dotP (ground.getAt [] B k)
          (combo n csB B)))) ?_
    exact BPair.oneValue_trans
      (BPair.add_congr (BPair.oneValue_symm h3)
        (BPair.oneValue_refl _))
      (BPair.oneValue_trans (BPair.oneValue_symm h2) h1)
  have hunitB : poly.unitTail (combo n csB B) :=
    dotP_self_null (combo n csB B)
      (dotP_comboNull n (combo n csB B) hcomboB csB B hB
        (fun k hk => by
          rw [dotP_comm]
          exact hstep k hk))
  refine span_intro n A v hA h.2.1 ⟨c₀, csA, hc₀, hlA, ?_⟩
  exact poly.oneValue_trans hchain
    (vecAdd_null_right (combo n csA A) (combo n csB B)
      (by rw [hcomboA, hcomboB]) hunitB)

/-! The vector-valued index fold, `def:ground`'s index fold at the
memberwise sum: a vector family added along the index order from
the width's unit seed.  Its reads are `bsum`'s own at the balance
carrier — the head split (`vsum_cons`, the seed dropping at the
first member), the pointwise congruence (`vsum_congr`) and the
pointwise split (`vsum_vecAdd`), the pairing and the action against
the fold (`dotP_vsum` to `bsum`, the instance at the unit seed of
the running sum's own read `dotP_foldRow`, which carries any seed
and any family occupied on the keys walked; `matVec_vsum` to the
mapped family's fold), the double range's exchange (`vsum_swap`)
and the delta pick at a guarded family (`vsum_pick`).  The width is
carried, not derived: a family off the stated width would truncate
at the memberwise sum, so every read binds it. -/

/-- The vector-valued index fold at a stated width: the family's
vectors added along the index order from the unit seed. -/
def vsum (n : Nat) (g : Nat → List BPair) (l : List Nat) :
    List BPair :=
  l.foldl (fun acc k => vecAdd acc (g k))
    (List.replicate n BPair.unit)

private theorem vsumGo_length (n : Nat) (g : Nat → List BPair) :
    ∀ (l : List Nat) (acc : List BPair), acc.length = n →
      (∀ k, 0 < ground.countOf k l → (g k).length = n) →
      (l.foldl (fun a k => vecAdd a (g k)) acc).length = n
  | [], _, ha, _ => ha
  | k :: t, acc, ha, hg =>
    vsumGo_length n g t (vecAdd acc (g k))
      (length_vecAdd acc (g k) n ha
        (hg k (by rw [ground.countOf_head]; exact Nat.succ_pos _)))
      (fun k' hk' =>
        hg k' (Nat.lt_of_lt_of_le hk' (Nat.le_add_left _ _)))

/-- The fold's width is the family's own. -/
theorem length_vsum (n : Nat) (g : Nat → List BPair) (l : List Nat)
    (hg : ∀ k, 0 < ground.countOf k l → (g k).length = n) :
    (vsum n g l).length = n :=
  vsumGo_length n g l (List.replicate n BPair.unit)
    (ground.length_replicate BPair.unit n) hg

private theorem lenVsum (n : Nat) (g : Nat → List BPair)
    (hg : ∀ k, (g k).length = n) (l : List Nat) :
    (vsum n g l).length = n :=
  length_vsum n g l (fun k _ => hg k)

private theorem foldAcc (n : Nat) (g : Nat → List BPair)
    (hg : ∀ k, (g k).length = n) :
    ∀ (l : List Nat) (a b : List BPair), b.length = n →
      (l.foldl (fun c k => vecAdd c (g k)) (vecAdd a b))
        = vecAdd a (l.foldl (fun c k => vecAdd c (g k)) b)
  | [], _, _, _ => rfl
  | k :: t, a, b, hb => by
    show (t.foldl (fun c k' => vecAdd c (g k'))
        (vecAdd (vecAdd a b) (g k)))
      = vecAdd a (t.foldl (fun c k' => vecAdd c (g k'))
        (vecAdd b (g k)))
    rw [vecAdd_assoc a b (g k)]
    exact foldAcc n g hg t a (vecAdd b (g k))
      (length_vecAdd b (g k) n hb (hg k))

/-- The fold's head splits off, the unit seed dropping. -/
theorem vsum_cons (n : Nat) (g : Nat → List BPair)
    (hg : ∀ k, (g k).length = n) (k : Nat) (t : List Nat) :
    poly.oneValue (vsum n g (k :: t)) (vecAdd (g k) (vsum n g t)) := by
  show poly.oneValue (t.foldl (fun c k' => vecAdd c (g k'))
      (vecAdd (List.replicate n BPair.unit) (g k)))
    (vecAdd (g k) (vsum n g t))
  rw [vecAdd_comm (List.replicate n BPair.unit) (g k),
    foldAcc n g hg t (g k) (List.replicate n BPair.unit)
      (ground.length_replicate BPair.unit n)]
  exact polyOne_refl _

/-- A family of unit tails folds to the unit tail. -/
theorem vsum_null (n : Nat) (g : Nat → List BPair)
    (hg : ∀ k, (g k).length = n) :
    ∀ l : List Nat,
      (∀ k, 0 < ground.countOf k l → poly.unitTail (g k)) →
      poly.unitTail (vsum n g l)
  | [], _ => poly.unitTail_replicate n
  | k :: t, hu =>
    poly.oneValue_unitTail (vsum_cons n g hg k t)
      (unitTail_vecAdd_of
        (hu k (by rw [ground.countOf_head]; exact Nat.succ_pos _))
        (vsum_null n g hg t (fun k' hk' =>
          hu k' (Nat.lt_of_lt_of_le hk' (Nat.le_add_left _ _)))))

/-- Two families reading one value member by member read one value
at the fold. -/
theorem vsum_congr (n : Nat) (g g' : Nat → List BPair)
    (hg : ∀ k, (g k).length = n) (hg' : ∀ k, (g' k).length = n)
    (h : ∀ k, poly.oneValue (g k) (g' k)) :
    ∀ l : List Nat, poly.oneValue (vsum n g l) (vsum n g' l)
  | [] => polyOne_refl _
  | k :: t =>
    poly.oneValue_trans (vsum_cons n g hg k t)
      (poly.oneValue_trans
        (polyOne_vecAdd (g k) (g' k) (vsum n g t) (vsum n g' t)
          (h k) (vsum_congr n g g' hg hg' h t)
          ((hg k).trans (hg' k).symm)
          ((lenVsum n g hg t).trans (lenVsum n g' hg' t).symm))
        (poly.oneValue_symm (vsum_cons n g' hg' k t)))

/-- The fold splits over a memberwise pointwise sum. -/
theorem vsum_vecAdd (n : Nat) (g h : Nat → List BPair)
    (hg : ∀ k, (g k).length = n) (hh : ∀ k, (h k).length = n) :
    ∀ l : List Nat,
      poly.oneValue (vsum n (fun k => vecAdd (g k) (h k)) l)
        (vecAdd (vsum n g l) (vsum n h l))
  | [] =>
    poly.unitTail_oneValue (poly.unitTail_replicate n)
      (unitTail_vecAdd_of (poly.unitTail_replicate n)
        (poly.unitTail_replicate n))
  | k :: t => by
    have hgh : ∀ k', (vecAdd (g k') (h k')).length = n :=
      fun k' => length_vecAdd (g k') (h k') n (hg k') (hh k')
    refine poly.oneValue_trans
      (vsum_cons n (fun k' => vecAdd (g k') (h k')) hgh k t) ?_
    refine poly.oneValue_trans
      (polyOne_vecAdd _ _ _ _ (polyOne_refl _)
        (vsum_vecAdd n g h hg hh t) rfl
        ((lenVsum n _ hgh t).trans
          (length_vecAdd _ _ n (lenVsum n g hg t)
            (lenVsum n h hh t)).symm)) ?_
    rw [vecAdd_add_comm (g k) (h k) (vsum n g t) (vsum n h t)]
    refine poly.oneValue_symm
      (polyOne_vecAdd _ _ _ _ (vsum_cons n g hg k t)
        (vsum_cons n h hh k t) ?_ ?_)
    · rw [lenVsum n g hg (k :: t),
        length_vecAdd _ _ n (hg k) (lenVsum n g hg t)]
    · rw [lenVsum n h hh (k :: t),
        length_vecAdd _ _ n (hh k) (lenVsum n h hh t)]

/-- The pairing against a rows' running sum reads the seed's own
read in front of the pairings' fold, at every seed and every family
occupied on the keys walked. -/
theorem dotP_foldRow (n : Nat) (y : List BPair)
    (hy : y.length = n) (g : Nat → List BPair) :
    ∀ (l : List Nat) (a : List BPair), a.length = n →
      (∀ k, 0 < ground.countOf k l → (g k).length = n) →
      (dotP y (l.foldl (fun s k => vecAdd s (g k)) a)).oneValue
        (dotP y a + ground.bsum (fun k => dotP y (g k)) l)
  | [], a, _, _ => BPair.oneValue_symm (BPair.add_unit (dotP y a))
  | k :: t, a, ha, hg => by
    have hgk : (g k).length = n :=
      hg k (by rw [ground.countOf_head]; exact Nat.succ_pos _)
    refine BPair.oneValue_trans
      (dotP_foldRow n y hy g t (vecAdd a (g k))
        (length_vecAdd a (g k) n ha hgk)
        (fun k' hk' => hg k'
          (Nat.lt_of_lt_of_le hk' (Nat.le_add_left _ _)))) ?_
    refine BPair.oneValue_trans
      (BPair.add_congr
        (dotP_vecAdd y a (g k) (ha.trans hy.symm) (hgk.trans hy.symm))
        (BPair.oneValue_refl
          (ground.bsum (fun k' => dotP y (g k')) t))) ?_
    show ((dotP y a + dotP y (g k))
        + ground.bsum (fun k' => dotP y (g k')) t).oneValue
      (dotP y a + (dotP y (g k)
        + ground.bsum (fun k' => dotP y (g k')) t))
    rw [BPair.add_assoc]
    exact BPair.oneValue_refl _

/-- The pairing against the fold reads the balance carrier's own
fold of the pairings — the running sum's read at the width's unit
seed, that seed's own pairing the sum's unit. -/
theorem dotP_vsum (n : Nat) (g : Nat → List BPair)
    (hg : ∀ k, (g k).length = n) (r : List BPair)
    (hr : r.length = n) (l : List Nat) :
    (dotP r (vsum n g l)).oneValue
      (ground.bsum (fun k => dotP r (g k)) l) :=
  BPair.oneValue_trans
    (dotP_foldRow n r hr g l (List.replicate n BPair.unit)
      (ground.length_replicate BPair.unit n) (fun k _ => hg k))
    (BPair.oneValue_trans
      (BPair.add_congr (dotP_repl_unit r n)
        (BPair.oneValue_refl
          (ground.bsum (fun k => dotP r (g k)) l)))
      (BPair.unit_add _))

/-- The action against the fold reads the mapped family's own
fold. -/
theorem matVec_vsum (n : Nat) (T : Mat)
    (g : Nat → List BPair) (hg : ∀ k, (g k).length = n) :
    ∀ l : List Nat,
      poly.oneValue (matVec T (vsum n g l))
        (vsum T.length (fun k => matVec T (g k)) l)
  | [] =>
    poly.unitTail_oneValue
      (matVec_null T _ (poly.unitTail_replicate n))
      (poly.unitTail_replicate T.length)
  | k :: t => by
    have hTg : ∀ k', (matVec T (g k')).length = T.length :=
      fun k' => matVec_length T (g k')
    refine poly.oneValue_trans
      (matVec_congr_go T _ _
        ((lenVsum n g hg (k :: t)).trans
          (length_vecAdd _ _ n (hg k) (lenVsum n g hg t)).symm)
        (vsum_cons n g hg k t)) ?_
    refine poly.oneValue_trans
      (matVec_vecAdd_free T (g k) (vsum n g t)
        ((hg k).trans (lenVsum n g hg t).symm)) ?_
    refine poly.oneValue_trans
      (polyOne_vecAdd _ _ _ _ (polyOne_refl _)
        (matVec_vsum n T g hg t) rfl
        ((matVec_length T (vsum n g t)).trans
          (lenVsum T.length _ hTg t).symm)) ?_
    exact poly.oneValue_symm
      (vsum_cons T.length (fun k' => matVec T (g k')) hTg k t)

/-- The nested folds exchange their index families. -/
theorem vsum_swap (n : Nat) (F : Nat → Nat → List BPair)
    (hF : ∀ a b, (F a b).length = n) (m : List Nat) :
    ∀ l : List Nat,
      poly.oneValue (vsum n (fun a => vsum n (fun b => F a b) m) l)
        (vsum n (fun b => vsum n (fun a => F a b) l) m)
  | [] =>
    poly.unitTail_oneValue (poly.unitTail_replicate n)
      (vsum_null n _ (fun b => lenVsum n (fun a => F a b)
        (fun a => hF a b) []) m
        (fun _ _ => poly.unitTail_replicate n))
  | a :: l => by
    refine poly.oneValue_trans
      (vsum_cons n (fun a' => vsum n (fun b => F a' b) m)
        (fun a' => lenVsum n _ (fun b => hF a' b) m) a l) ?_
    refine poly.oneValue_trans
      (polyOne_vecAdd _ _ _ _ (polyOne_refl _)
        (vsum_swap n F hF m l) rfl
        ((lenVsum n _
            (fun a' => lenVsum n _ (fun b => hF a' b) m) l).trans
          (lenVsum n _
            (fun b => lenVsum n _ (fun a' => hF a' b) l) m).symm)) ?_
    refine poly.oneValue_trans
      (poly.oneValue_symm
        (vsum_vecAdd n (fun b => F a b)
          (fun b => vsum n (fun a' => F a' b) l)
          (fun b => hF a b)
          (fun b => lenVsum n _ (fun a' => hF a' b) l) m)) ?_
    exact vsum_congr n _ _
      (fun b => length_vecAdd _ _ n (hF a b)
        (lenVsum n _ (fun a' => hF a' b) l))
      (fun b => lenVsum n _ (fun a' => hF a' b) (a :: l))
      (fun b => poly.oneValue_symm
        (vsum_cons n (fun a' => F a' b) (fun a' => hF a' b) a l)) m

/-- The guarded family's fold picks its own key. -/
theorem vsum_pick (n : Nat) (g : Nat → List BPair)
    (hg : ∀ k, (g k).length = n) :
    ∀ (l : List Nat) (i : Nat), ground.countOf i l = 1 →
      poly.oneValue (vsum n (fun k =>
        if i = k then g k else List.replicate n BPair.unit) l)
        (g i)
  | [], _, h => Nat.noConfusion h
  | a :: t, i, h => by
    have hlen : ∀ k, (if i = k then g k
        else List.replicate n BPair.unit).length = n := by
      intro k
      by_cases hik : i = k
      · rw [if_pos hik]
        exact hg k
      · rw [if_neg hik]
        exact ground.length_replicate BPair.unit n
    have hh : (if i = a then 1 else 0) + ground.countOf i t = 1 :=
      (ground.countOf_cons i a t).symm.trans h
    refine poly.oneValue_trans (vsum_cons n _ hlen a t) ?_
    by_cases hia : i = a
    · rw [if_pos hia] at hh
      have h1 : ground.countOf i t = 0 :=
        ground.addCancelL 1 (by rw [Nat.add_zero]; exact hh)
      have htail : poly.unitTail (vsum n (fun k =>
          if i = k then g k else List.replicate n BPair.unit) t) :=
        vsum_null n _ hlen t (fun k hk => by
          rw [if_neg (fun he => by
            rw [he] at h1
            rw [h1] at hk
            exact absurd hk (Nat.lt_irrefl 0))]
          exact poly.unitTail_replicate n)
      rw [if_pos hia, ← hia]
      exact vecAdd_null_right _ _
        ((hg i).trans (lenVsum n _ hlen t).symm) htail
    · rw [if_neg hia] at hh
      rw [Nat.zero_add] at hh
      rw [if_neg hia]
      refine poly.oneValue_trans
        (vecAdd_null_left _ _
          ((ground.length_replicate BPair.unit n).trans
            (lenVsum n _ hlen t).symm)
          (poly.unitTail_replicate n)) ?_
      exact vsum_pick n g hg t i hh

/-- Two clearings at one value scale every vector alike. -/
theorem vecScale_congr {c d : BPair}
    (hcd : c.oneValue d) : ∀ u : List BPair,
      poly.oneValue (vecScale c u) (vecScale d u)
  | [] => trivial
  | a :: t =>
    ⟨BPair.mul_congr hcd (BPair.oneValue_refl a),
     vecScale_congr hcd t⟩

private theorem subEq {a p q : Nat} (hap : a ≤ p) (haq : a ≤ q)
    (h : p - a = q - a) : p = q := by
  rw [← ground.natAddSubCancel hap, ← ground.natAddSubCancel haq,
    h]

/-- The pairwise-perpendicular family: distinct rows pair at the
sum's unit. -/
def perpAll (M : Mat) : Prop :=
  ∀ p < M.length, ∀ q < M.length, p ≠ q →
    (dotP (ground.getAt ([] : List BPair) M p)
      (ground.getAt ([] : List BPair) M q)).oneValue BPair.unit

instance (M : Mat) : Decidable (perpAll M) :=
  inferInstanceAs (Decidable (∀ p < M.length, ∀ q < M.length,
    p ≠ q →
      (dotP (ground.getAt ([] : List BPair) M p)
        (ground.getAt ([] : List BPair) M q)).oneValue BPair.unit))

/-- Two perpendicular families perpendicular across join to one. -/
theorem perpAll_append (A B : Mat) (hA : perpAll A)
    (hB : perpAll B)
    (hAB : ∀ p q, p < A.length → q < B.length →
      (dotP (ground.getAt [] A p)
        (ground.getAt [] B q)).oneValue BPair.unit) :
    perpAll (A ++ B) := by
  intro p hp q hq hpq
  rw [ground.length_append] at hp hq
  rw [ground.getAt_append ([] : List BPair) A B p,
    ground.getAt_append ([] : List BPair) A B q]
  by_cases hpA : p < A.length
  · rw [if_pos hpA]
    by_cases hqA : q < A.length
    · rw [if_pos hqA]
      exact hA p hpA q hqA hpq
    · rw [if_neg hqA]
      exact hAB p (q - A.length) hpA
        (ground.subLt (match Nat.lt_or_ge q A.length with
          | .inl hlt => absurd hlt hqA
          | .inr hge => hge) hq)
  · rw [if_neg hpA]
    have hpge : A.length ≤ p :=
      match Nat.lt_or_ge p A.length with
      | .inl hlt => absurd hlt hpA
      | .inr hge => hge
    by_cases hqA : q < A.length
    · rw [if_pos hqA, dotP_comm]
      exact hAB q (p - A.length) hqA (ground.subLt hpge hp)
    · rw [if_neg hqA]
      have hqge : A.length ≤ q :=
        match Nat.lt_or_ge q A.length with
        | .inl hlt => absurd hlt hqA
        | .inr hge => hge
      exact hB (p - A.length) (ground.subLt hpge hp) (q - A.length)
        (ground.subLt hqge hq)
        (fun he => hpq (subEq hpge hqge he))

/-- A family of at most one row is perpendicular. -/
theorem perpAll_le1 (M : Mat) (h : M.length ≤ 1) : perpAll M := by
  intro p hp q hq hpq
  have hp1 : p < 1 := Nat.lt_of_lt_of_le hp h
  have hq1 : q < 1 := Nat.lt_of_lt_of_le hq h
  match p, hp1 with
  | 0, _ =>
    match q, hq1 with
    | 0, _ => exact absurd rfl hpq
    | q' + 1, hq2 =>
      exact absurd (Nat.le_of_succ_le_succ hq2)
        (Nat.not_succ_le_zero q')
  | p' + 1, hp2 =>
    exact absurd (Nat.le_of_succ_le_succ hp2)
      (Nat.not_succ_le_zero p')

/-- A family inside a span extended by one span member stays
inside the span, row by row. -/
theorem span_rows_append (n : Nat) (A : Mat)
    (v : List BPair) (B : Mat)
    (hA : ∀ p, p < A.length → spanRel n B (ground.getAt [] A p))
    (hv : spanRel n B v) :
    ∀ p, p < (A ++ [v]).length →
      spanRel n B (ground.getAt [] (A ++ [v]) p) :=
  rows_append_gen A v hA hv


/-! The diagonal-Gram residual (`lem:lowerspan`'s product-scaled
residual): at a pairwise-perpendicular family the Gram sits at its
diagonal up to the unit class, so the determinant reads the
self-pairings' product (`detL_perp`) — every assignment off the
identity carries an off-diagonal factor — and the projection fold's
coefficients read that product with the row's own factor withheld,
one pass carrying it (`residGo`).  The membership residual is then
`residD` entry for entry (`residD_residV`), two pairings per row
where `residV` prices an L-by-L determinant. -/

/-- The three-factor product exchanges its outer factors. -/
private theorem mulRot (a b c : BPair) : a * b * c = c * b * a := by
  rw [BPair.mul_assoc a b c, BPair.mul_comm b c,
    BPair.mul_comm a (c * b)]

/-- The doubled key's parity is even, so its grading reads the
datum itself.  The grading's other read `sgnP_unit` carries a
datum at the sum's unit through the sign; here the diagonal
cofactor's own value is what the product consumes, so the parity
is decided outright. -/
private theorem sgnP_double (k : Nat) (x : BPair) :
    sgnP (k + k) x = x := sgnPO_even bpairOps k x

/-- The self-pairings' product reads the joined row's factor at the
end. -/
private theorem selfProd_snoc : ∀ (L : Mat) (y : List BPair),
    (selfProd (L ++ [y])).oneValue (selfProd L * dotP y y)
  | [], y => by
    show ((dotP y y * BPair.ofPos .one).norm).oneValue
      (BPair.ofPos .one * dotP y y)
    rw [BPair.mul_comm (dotP y y) (BPair.ofPos .one)]
    exact BPair.norm_oneValue _
  | r :: t, y => by
    show ((dotP r r * selfProd (t ++ [y])).norm).oneValue
      ((dotP r r * selfProd t).norm * dotP y y)
    refine BPair.oneValue_trans (BPair.norm_oneValue _) ?_
    refine BPair.oneValue_trans
      (BPair.mul_congr (BPair.oneValue_refl (dotP r r))
        (selfProd_snoc t y)) ?_
    rw [← BPair.mul_assoc (dotP r r) (selfProd t) (dotP y y)]
    exact BPair.mul_congr_left
      (BPair.oneValue_symm (BPair.norm_oneValue _))

/-- The pass's product component is the self-pairings' product:
the recursion is `selfProd`'s own, a row's self-pairing against the
rows below it. -/
private theorem residGo_snd : ∀ (L : Mat) (v : List BPair),
    (residGo L v).2 = selfProd L
  | [], _ => rfl
  | r :: t, v => by
    show (dotP r r * (residGo t v).2).norm
      = (dotP r r * selfProd t).norm
    rw [residGo_snd t v]

/-- The pass's running sum reads the family's own width. -/
private theorem length_residGo (n : Nat) (v : List BPair)
    (hv : v.length = n) :
    ∀ L : Mat, rowsLen n L → (residGo L v).1.length = n
  | [], _ => by
    show (vecScale BPair.unit v).length = n
    rw [length_vecScale]
    exact hv
  | r :: t, hLn => by
    show (vecAdd (vecScale ((dotP r v * (residGo t v).2).norm) r)
      (vecScale (dotP r r) (residGo t v).1)).length = n
    refine length_vecAdd _ _ n ?_ ?_
    · rw [length_vecScale]
      exact hLn.1
    · rw [length_vecScale]
      exact length_residGo n v hv t hLn.2

/-- The diagonal residual reads the family's own width. -/
theorem length_residD (n : Nat) (L : Mat) (v : List BPair)
    (hLn : rowsLen n L) (hv : v.length = n) :
    (residD L v).length = n := by
  show (vecAdd (vecScale (residGo L v).2 v)
    ((residGo L v).1.map BPair.swap)).length = n
  refine length_vecAdd _ _ n ?_ ?_
  · rw [length_vecScale]
    exact hv
  · rw [ground.length_map]
    exact length_residGo n v hv L hLn

/-- A pairwise-perpendicular family stays so at its rows below the
head. -/
private theorem perpAll_tail (r : List BPair) (t : Mat)
    (h : perpAll (r :: t)) : perpAll t := by
  intro p hp q hq hpq
  exact h (p + 1) (Nat.succ_lt_succ hp) (q + 1) (Nat.succ_lt_succ hq)
    (fun he => hpq (Nat.succ.inj he))

/-- A vector perpendicular to every row pairs the pass's running
sum at the sum's unit: each row's term carries that row's own
pairing and the seed is a unit tail. -/
private theorem dotP_residGo_null (n : Nat) (v D : List BPair)
    (hv : v.length = n) (hD : D.length = n) :
    ∀ L : Mat, rowsLen n L →
      (∀ k, k < L.length →
        (dotP D (ground.getAt [] L k)).oneValue BPair.unit) →
      (dotP D (residGo L v).1).oneValue BPair.unit
  | [], _, _ => by
    show (dotP D (vecScale BPair.unit v)).oneValue BPair.unit
    exact dotP_null_tail_right D _
      (unitTail_vecScale_unit (BPair.oneValue_refl BPair.unit) v)
  | r :: t, hLn, hrow => by
    show (dotP D (vecAdd
      (vecScale ((dotP r v * (residGo t v).2).norm) r)
      (vecScale (dotP r r) (residGo t v).1))).oneValue BPair.unit
    refine BPair.oneValue_trans
      (dotP_vecAdd D _ _
        (by rw [length_vecScale, hLn.1, hD])
        (by rw [length_vecScale, length_residGo n v hv t hLn.2,
          hD])) ?_
    refine BPair.oneValue_trans (BPair.add_congr ?_ ?_)
      (BPair.unit_add BPair.unit)
    · refine BPair.oneValue_trans (dotP_vecScale_right D r _) ?_
      exact oneValue_mul_unit _ _ (hrow 0 (Nat.succ_pos _))
    · refine BPair.oneValue_trans (dotP_vecScale_right D _ _) ?_
      exact oneValue_mul_unit _ _
        (dotP_residGo_null n v D hv hD t hLn.2
          (fun k hk => hrow (k + 1) (Nat.succ_lt_succ hk)))

/-- A row pairs the pass's running sum at the family's whole
product against that row's own pairing with the vector: its own
term carries the product with its factor restored, and the further
rows drop at the perpendicularity. -/
private theorem dotP_residGo_row (n : Nat) (v : List BPair)
    (hv : v.length = n) :
    ∀ L : Mat, rowsLen n L → perpAll L → ∀ i, i < L.length →
      (dotP (ground.getAt [] L i) (residGo L v).1).oneValue
        (selfProd L * dotP (ground.getAt [] L i) v)
  | [], _, _, _, hi => absurd hi (Nat.not_lt_zero _)
  | r :: t, hLn, hperp, 0, _ => by
    have ht : (dotP r (residGo t v).1).oneValue BPair.unit :=
      dotP_residGo_null n v r hv hLn.1 t hLn.2
        (fun k hk => hperp 0 (Nat.succ_pos _) (k + 1)
          (Nat.succ_lt_succ hk) (fun he => nomatch he))
    show (dotP r (vecAdd
      (vecScale ((dotP r v * (residGo t v).2).norm) r)
      (vecScale (dotP r r) (residGo t v).1))).oneValue
      ((dotP r r * selfProd t).norm * dotP r v)
    refine BPair.oneValue_trans
      (dotP_vecAdd r _ _
        (by rw [length_vecScale])
        (by rw [length_vecScale, length_residGo n v hv t hLn.2]
            exact hLn.1.symm)) ?_
    refine BPair.oneValue_trans
      (BPair.add_congr (dotP_vecScale_right r r _)
        (BPair.oneValue_trans (dotP_vecScale_right r _ _)
          (oneValue_mul_unit _ _ ht))) ?_
    refine BPair.oneValue_trans (BPair.add_unit _) ?_
    rw [residGo_snd t v]
    refine BPair.oneValue_trans
      (BPair.mul_congr_left (BPair.norm_oneValue _)) ?_
    rw [mulRot (dotP r v) (selfProd t) (dotP r r)]
    exact BPair.oneValue_symm
      (BPair.mul_congr_left (BPair.norm_oneValue _))
  | r :: t, hLn, hperp, i + 1, hi => by
    have hit : i < t.length := Nat.lt_of_succ_lt_succ hi
    have hti : (ground.getAt ([] : List BPair) t i).length = n :=
      rowsLen_getAt t i hLn.2 hit
    have hri : (dotP (ground.getAt [] t i) r).oneValue BPair.unit :=
      hperp (i + 1) hi 0 (Nat.succ_pos _) (fun he => nomatch he)
    have hih := dotP_residGo_row n v hv t hLn.2
      (perpAll_tail r t hperp) i hit
    show (dotP (ground.getAt [] t i) (vecAdd
      (vecScale ((dotP r v * (residGo t v).2).norm) r)
      (vecScale (dotP r r) (residGo t v).1))).oneValue
      ((dotP r r * selfProd t).norm * dotP (ground.getAt [] t i) v)
    refine BPair.oneValue_trans
      (dotP_vecAdd (ground.getAt [] t i) _ _
        (by rw [length_vecScale, hLn.1, hti])
        (by rw [length_vecScale, length_residGo n v hv t hLn.2,
          hti])) ?_
    refine BPair.oneValue_trans
      (BPair.add_congr
        (BPair.oneValue_trans (dotP_vecScale_right _ r _)
          (oneValue_mul_unit _ _ hri))
        (BPair.oneValue_trans (dotP_vecScale_right _ _ _)
          (BPair.mul_congr (BPair.oneValue_refl (dotP r r)) hih))) ?_
    refine BPair.oneValue_trans (BPair.unit_add _) ?_
    rw [← BPair.mul_assoc (dotP r r) (selfProd t)
      (dotP (ground.getAt [] t i) v)]
    exact BPair.oneValue_symm
      (BPair.mul_congr_left (BPair.norm_oneValue _))

/-- A pairwise-perpendicular family stays so at its front rows. -/
private theorem perpAll_dropLast (L : Mat) (v : List BPair)
    (h : perpAll (L ++ [v])) : perpAll L := by
  intro p hp q hq hpq
  have hp' : p < (L ++ [v]).length := by
    rw [ground.length_append]
    exact Nat.lt_of_lt_of_le hp (Nat.le_add_right _ _)
  have hq' : q < (L ++ [v]).length := by
    rw [ground.length_append]
    exact Nat.lt_of_lt_of_le hq (Nat.le_add_right _ _)
  have hpq' := h p hp' q hq' hpq
  rw [ground.getAt_append ([] : List BPair) L [v] p, if_pos hp,
    ground.getAt_append ([] : List BPair) L [v] q, if_pos hq] at hpq'
  exact hpq'

/-- The pairing against a mapped key range, the parametrized fold's
own read at the pair carrier through the bridge. -/
theorem dotP_map_range (g : Nat → BPair) (n : Nat)
    (x : List BPair) (h : x.length = n) :
    dotP x ((List.range n).map g)
      = ground.famFold BPair.add BPair.unit
        (fun j => (ground.getAt BPair.unit x j) * g j) (List.range n) :=
  dotO_map_range bpairOps g n x h

/-! The determinant's combination and scaling reads at the entry
carrier, `lem:inertia`'s determinant split beneath them: a row
replaced by a combination of a stated family, and every row scaled
at once. -/

/-- A row replaced by a combination of a stated family reads the
row's own coefficient against the whole: the combination expands
over the family, a member off the row entering at a vanishing
coefficient or as the list's own row, the latter an equal-rows
read. -/
private theorem detO_comboRow {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (M N : List (List γ)) (k : Nat) (hk : k < N.length)
    (hM : rowsLen N.length M) (hMl : M.length = N.length)
    (y : List γ) (hy : y.length = N.length)
    (hoff : ∀ t, t < N.length → ¬ t = k →
      R.rel (ground.getAt ops.unit y t) ops.unit
        ∨ ground.getAt [] M t = ground.getAt [] N t)
    (hself : ground.getAt [] M k = ground.getAt [] N k) :
    R.rel (detO ops (List.set N k (comboO ops N.length y M)))
      (ops.mul (ground.getAt ops.unit y k) (detO ops N)) := by
  refine L.ovTrans (detO_List.set_combo L N k hk y M hM) ?_
  show R.rel (dotO ops y (M.map (fun row => detO ops (List.set N k row)))) _
  have hMr : M = (List.range N.length).map (ground.getAt [] M) :=
    (ground.range_map_getAt [] N.length M hMl).symm
  have hmap : M.map (fun row => detO ops (List.set N k row))
      = (List.range N.length).map
          (fun t => detO ops (List.set N k (ground.getAt [] M t))) := by
    conv => lhs; rw [hMr]
    exact ground.map_map _ _ _
  rw [hmap, dotO_map_range ops _ N.length y hy]
  refine ground.famFold_pick_ov (foldLawsOf L) _ k _ (List.range N.length)
    (ground.countOf_range_one hk) ?_ ?_
  · rw [hself, ground.set_self [] N k hk]
    exact L.ovRefl _
  · intro t ht htk
    have htn : t < N.length := ground.ltOfMem ht
    match hoff t htn htk with
    | .inl hyt =>
      exact L.ovTrans (L.mulCongr hyt (L.ovRefl _)) (mulUnitLeftO L _)
    | .inr hMt =>
      rw [hMt]
      refine L.ovTrans (L.mulCongr (L.ovRefl _) ?_) (L.mulUnit _)
      have hlen : (List.set N k (ground.getAt [] N t)).length = N.length :=
        ground.length_set _ N k
      cases Nat.lt_or_ge t k with
      | inl hlt =>
        exact detO_rows_equal L hlt (by rw [hlen]; exact hk)
          (by rw [ground.getAt_set_ne [] N k t _ htk,
            ground.getAt_set_self [] _ N k hk])
      | inr hge =>
        have hkt : k < t := by
          match Nat.lt_or_ge k t with
          | .inl h => exact h
          | .inr h =>
            exact absurd (Nat.le_antisymm hge h) (fun he => htk he.symm)
        exact detO_rows_equal L hkt (by rw [hlen]; exact htn)
          (by rw [ground.getAt_set_self [] _ N k hk,
            ground.getAt_set_ne [] N k t _ htk])

/-- A scaled row's entry reads the scaled entry at every key, the
keys beyond the row at the product's own vacancy. -/
private theorem getAt_vecScaleO_ov {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) (c : γ)
    (r : List γ) (j : Nat) :
    R.rel (ground.getAt ops.unit (vecScaleO ops c r) j)
      (ops.mul c (ground.getAt ops.unit r j)) := by
  cases Nat.lt_or_ge j r.length with
  | inl hlt => exact ovOfEq L.toDCore (getAt_vecScaleO ops c r j hlt)
  | inr hge =>
    rw [ground.getAt_over ops.unit (vecScaleO ops c r) j
        (by rw [length_vecScaleO ops c r]; exact hge),
      ground.getAt_over ops.unit r j hge]
    exact L.ovSymm (L.mulUnit c)

/-- The struck key commutes with the rows' scaling. -/
private theorem map_eraseIdx_vecScaleO {γ : Type} (ops : DOps γ)
    (c : γ) (j : Nat) :
    ∀ rest : List (List γ),
      (rest.map (vecScaleO ops c)).map (fun r => r.eraseIdx j)
        = (rest.map (fun r => r.eraseIdx j)).map (vecScaleO ops c)
  | [] => rfl
  | r :: rest => by
    show (vecScaleO ops c r).eraseIdx j
        :: (rest.map (vecScaleO ops c)).map (fun r => r.eraseIdx j)
      = vecScaleO ops c (r.eraseIdx j)
        :: (rest.map (fun r => r.eraseIdx j)).map (vecScaleO ops c)
    rw [map_eraseIdx_vecScaleO ops c j rest]
    show (r.map (fun x => ops.mul c x)).eraseIdx j :: _
      = (r.eraseIdx j).map (fun x => ops.mul c x) :: _
    rw [eraseIdx_map (fun x => ops.mul c x) r j]

/-- Every row scaled scales the determinant by the scale's power
at the row count: the head-row expansion's entries and struck
cofactors each carry the scale. -/
private theorem detO_scaleAll {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) (c : γ) :
    ∀ (n : Nat) (M : List (List γ)), M.length = n →
      R.rel (detO ops (M.map (vecScaleO ops c)))
        (ops.mul (poly.powO ops c n) (detO ops M))
  | 0, [], _ => L.ovSymm (L.oneMul (detO ops []))
  | 0, _ :: _, h => Nat.noConfusion h
  | _ + 1, [], h => Nat.noConfusion h
  | n + 1, r :: rest, h => by
    have hn : rest.length = n := Nat.succ.inj h
    show R.rel (detO ops
      (vecScaleO ops c r :: rest.map (vecScaleO ops c))) _
    refine L.ovTrans (detO_cons L _ _) ?_
    refine L.ovTrans ?_
      (L.mulCongr (L.ovRefl _) (L.ovSymm (detO_cons L r rest)))
    rw [ground.length_map]
    refine L.ovTrans ?_
      (foldO_mul_left L (poly.powO ops c (n + 1))
        (fun j => sgnPO ops j
          (ops.mul (ground.getAt ops.unit r j) (cof0O ops rest j)))
        (List.range (rest.length + 1)))
    refine foldO_congr_members L.toDCore _ _
      (List.range (rest.length + 1)) ?_
    intro j hj
    have hjle : j ≤ rest.length := Nat.le_of_lt_succ (ground.ltOfMem hj)
    have hstrike : R.rel (cof0O ops (rest.map (vecScaleO ops c)) j)
        (ops.mul (poly.powO ops c n) (cof0O ops rest j)) := by
      refine L.ovTrans
        (cof0O_strike L.toDCore _ j
          (by rw [ground.length_map]; exact hjle)) ?_
      rw [map_eraseIdx_vecScaleO ops c j rest]
      refine L.ovTrans
        (detO_scaleAll L c n _ (by rw [ground.length_map]; exact hn)) ?_
      exact L.mulCongr (L.ovRefl _)
        (L.ovSymm (cof0O_strike L.toDCore rest j hjle))
    refine L.ovTrans
      (sgnPO_congr L.toDCore
        (L.mulCongr (getAt_vecScaleO_ov L c r j) hstrike)) ?_
    refine L.ovTrans
      (sgnPO_congr L.toDCore
        (mulShuffleO L.toDCore c (ground.getAt ops.unit r j)
          (poly.powO ops c n) (cof0O ops rest j))) ?_
    exact sgnPO_mul L.toDCore j _ _

/-- Every row scaled scales the determinant by the scale's power
at the row count: the head-row expansion's entries and struck
cofactors each carry the scale. -/
theorem detL_scaleAll (c : BPair) : ∀ (n : Nat) (M : Mat), M.length = n →
    (detL (M.map (vecScale c))).oneValue (ground.bpow c n * detL M) :=
  fun n M h =>
    BPair.oneValue_trans
      (detO_scaleAll (R := ground.bpairRead) bpairLaws c n M h)
      (BPair.mul_congr (powO_bpow c n) (BPair.oneValue_refl (detL M)))

/-- The scale passes out of the pairing's left operand. -/
theorem dotP_scaleL (c : BPair) (v x : List BPair) :
    (dotP (vecScale c v) x).oneValue (c * dotP v x) := by
  rw [dotP_comm (vecScale c v) x, dotP_comm v x]
  exact dotP_vecScale_right x v c

/-- The pairing against the unit family sits at the sum's unit,
read on the left. -/
theorem dotP_replL (n : Nat) (x : List BPair) :
    (dotP (List.replicate n BPair.unit) x).oneValue BPair.unit := by
  rw [dotP_comm]
  exact dotP_repl_unit x n

/-- The pairing splits over a joined left operand at summands of
one order.  The split's two spellings are independent: this one
binds the left summands' orders alone, so the subset-fold reads
take no shape binder on their right argument, while
`dotP_vecAdd_left` binds the right argument's order against both
summands and leaves the summands' own orders free. -/
theorem dotP_addE : ∀ (u w x : List BPair),
    u.length = w.length →
    (dotP (vecAdd u w) x).oneValue
      (dotP u x + dotP w x)
  | u, w, [], _ => by
    rw [dotP_nil_right (vecAdd u w), dotP_nil_right u,
      dotP_nil_right w]
    exact BPair.oneValue_symm (BPair.add_unit BPair.unit)
  | [], [], _ :: _, _ =>
    BPair.oneValue_symm (BPair.add_unit BPair.unit)
  | [], _ :: _, _ :: _, hl => Nat.noConfusion hl
  | _ :: _, [], _ :: _, hl => Nat.noConfusion hl
  | a :: u, b :: w, c :: x, hl => by
    show ((a + b) * c + dotP (vecAdd u w) x).oneValue
      (a * c + dotP u x + (b * c + dotP w x))
    rw [BPair.right_distrib,
      ← BPair.add_add_comm (a * c) (b * c) (dotP u x)
        (dotP w x)]
    exact BPair.add_congr (BPair.oneValue_refl _)
      (dotP_addE u w x (Nat.succ.inj hl))

/-- The pairing at a keyed row against a key of the row's order is
the keys' fold. -/
theorem dotP_rowRange (g : Nat → BPair) (n : Nat)
    (y : List BPair) (h : y.length = n) :
    (dotP ((List.range n).map g) y).oneValue
      (ground.famFold BPair.add BPair.unit
        (fun k => g k * ground.getAt BPair.unit y k)
        (List.range n)) :=
  BPair.oneValue_of_eq (by
    rw [dotP_fold n _ y
      (ground.length_mapRange _ n) h]
    refine ground.famFold_congr_members BPair.add BPair.unit _ _ _
      (fun i hi => ?_)
    rw [ground.getAt_map 0 BPair.unit g (List.range n) i
        (by rw [ground.length_range]; exact ground.ltOfMem hi),
      ground.getAt_range n i (ground.ltOfMem hi)])

/-- The pairing splits over a zipped fold's sum, the keyed reads
collected member by member (the halved products' fold over the
member's own natural fold). -/
theorem dotP_zipSum (n : Nat) (x : List BPair)
    (hx : x.length = n) : ∀ (f : List Nat)
      (rows : List (List BPair)),
    (dotP ((List.range n).map (fun j =>
        BPair.sum (List.zipWith (fun c row =>
          BPair.ofNat c * getAt BPair.unit row j)
          f rows))) x).oneValue
      (BPair.sum (List.zipWith (fun c row =>
        BPair.ofNat c * dotP row x) f rows))
  | [], _ => by
    show (dotP ((List.range n).map
        (fun _ => BPair.unit)) x).oneValue BPair.unit
    rw [ground.map_const BPair.unit (List.range n)]
    exact dotP_replL (List.range n).length x
  | _ :: _, [] => by
    show (dotP ((List.range n).map
        (fun _ => BPair.unit)) x).oneValue BPair.unit
    rw [ground.map_const BPair.unit (List.range n)]
    exact dotP_replL (List.range n).length x
  | c :: f, row :: rows => by
    refine BPair.oneValue_trans
      (dotP_congr_left _ ((List.range n).map (fun j =>
          BPair.ofNat c * getAt BPair.unit row j
            + BPair.sum (List.zipWith (fun c' row' =>
                BPair.ofNat c' * getAt BPair.unit row' j)
                f rows)))
        x (fun j hj => ?_)) ?_
    · rw [ground.getAt_map 0 BPair.unit _ (List.range n) j
          (by rw [ground.length_range, ← hx]; exact hj),
        ground.getAt_map 0 BPair.unit _ (List.range n) j
          (by rw [ground.length_range, ← hx]; exact hj)]
      exact BPair.sum_cons _ _
    · rw [← mapAdd]
      refine BPair.oneValue_trans
        (dotP_addE _ _ x (by
          rw [ground.length_map, ground.length_map])) ?_
      refine BPair.oneValue_trans (BPair.add_congr ?_
        (dotP_zipSum n x hx f rows))
        (BPair.oneValue_symm (BPair.sum_cons _ _))
      rw [show (List.range n).map (fun j =>
            BPair.ofNat c * getAt BPair.unit row j)
          = ((List.range n).map (getAt BPair.unit row)).map
              (fun z => BPair.ofNat c * z) from
          (ground.map_map (getAt BPair.unit row)
            (fun z => BPair.ofNat c * z) (List.range n)).symm]
      refine BPair.oneValue_trans
        (dotP_scaleL (BPair.ofNat c)
          ((List.range n).map (getAt BPair.unit row)) x) ?_
      refine BPair.mul_congr (BPair.oneValue_refl _) ?_
      refine dotP_congr_left _ row x (fun j hj => ?_)
      rw [ground.getAt_map 0 BPair.unit (getAt BPair.unit row)
          (List.range n) j
          (by rw [ground.length_range, ← hx]; exact hj)]
      rw [ground.getAt_range n j (by rw [← hx]; exact hj)]
      exact BPair.oneValue_refl _

private theorem detL_perp_go : ∀ (fuel : Nat) (L : Mat),
    L.length ≤ fuel → perpAll L →
    (detL (gramM L)).oneValue (selfProd L)
  | _, [], _, _ => by decide +kernel
  | 0, _ :: _, hf, _ => nomatch hf
  | fuel + 1, r :: L, hf, hperp => by
    match splitLast (r :: L) with
    | Or.inl he => exact nomatch he
    | Or.inr ⟨L', v, he⟩ =>
      rw [he] at hperp ⊢
      have hf' : L'.length ≤ fuel := by
        have h1 : (L' ++ [v]).length ≤ fuel + 1 := by
          rw [← he]
          exact hf
        rw [ground.length_append] at h1
        exact Nat.le_of_succ_le_succ h1
      have ih := detL_perp_go fuel L' hf'
        (perpAll_dropLast L' v hperp)
      have hlen : (L' ++ [v]).length = L'.length + 1 := by
        rw [ground.length_append]
        rfl
      have hGl : (gramM (L' ++ [v])).length = L'.length + 1 := by
        rw [length_gramM]
        exact hlen
      have hk : L'.length < (gramM (L' ++ [v])).length := by
        rw [hGl]
        exact Nat.lt_succ_self _
      have hkA : L'.length < (L' ++ [v]).length := by
        rw [hlen]
        exact Nat.lt_succ_self _
      have hrow : (ground.getAt []
          (gramM (L' ++ [v])) L'.length).length
          = (gramM (L' ++ [v])).length := by
        rw [sqAt_row_len (gram_sqAt (L' ++ [v])) L'.length hk,
          length_gramM]
      have hvrow : ground.getAt ([] : List BPair)
          (L' ++ [v]) L'.length = v := by
        rw [ground.getAt_append ([] : List BPair) L' [v] L'.length,
          if_neg (Nat.lt_irrefl _), Nat.sub_self]
        rfl
      have hentry : ∀ j, j < (gramM (L' ++ [v])).length →
          ground.getAt BPair.unit
            (ground.getAt [] (gramM (L' ++ [v])) L'.length) j
          = dotP v (ground.getAt [] (L' ++ [v]) j) := by
        intro j hj
        rw [length_gramM] at hj
        rw [gramM_entry (L' ++ [v]) L'.length j hkA hj, hvrow]
      refine BPair.oneValue_trans
        (BPair.oneValue_symm
          (cofVec_diag (gramM (L' ++ [v])) L'.length hk hrow)) ?_
      rw [show cofVec (gramM (L' ++ [v])) L'.length
          = (List.range (gramM (L' ++ [v])).length).map (fun j =>
            sgnP (L'.length + j)
              (cof0 ((gramM (L' ++ [v])).eraseIdx L'.length) j))
        from rfl,
        dotP_map_range _ (gramM (L' ++ [v])).length
          (ground.getAt [] (gramM (L' ++ [v])) L'.length) hrow]
      refine BPair.oneValue_trans
        (foldB_congr_members _
          (fun j => if L'.length = j then
              ground.getAt BPair.unit
                (ground.getAt [] (gramM (L' ++ [v])) L'.length) j
                * sgnP (L'.length + j)
                  (cof0 ((gramM (L' ++ [v])).eraseIdx L'.length) j)
            else BPair.unit)
          (List.range (gramM (L' ++ [v])).length) (fun j hj => ?_)) ?_
      · by_cases hij : L'.length = j
        · rw [if_pos hij]
          exact BPair.oneValue_refl _
        · rw [if_neg hij]
          refine oneValue_unit_mul ?_
          have hpq := hperp L'.length hkA j
            (by rw [← length_gramM]; exact ground.ltOfMem hj)
            hij
          rw [hvrow] at hpq
          rw [hentry j (ground.ltOfMem hj)]
          exact hpq
      refine BPair.oneValue_trans
        (bsum_pick (fun j =>
          ground.getAt BPair.unit
            (ground.getAt [] (gramM (L' ++ [v])) L'.length) j
            * sgnP (L'.length + j)
              (cof0 ((gramM (L' ++ [v])).eraseIdx L'.length) j))
          (List.range (gramM (L' ++ [v])).length) L'.length
          (by rw [ground.countOf_range_one hk])) ?_
      rw [hentry L'.length hk, hvrow, sgnP_double L'.length,
        cof_last_bridge L' v]
      refine BPair.oneValue_trans
        (BPair.mul_congr (BPair.oneValue_refl (dotP v v)) ih) ?_
      rw [BPair.mul_comm (dotP v v) (selfProd L')]
      exact BPair.oneValue_symm (selfProd_snoc L' v)

/-- The pairwise-perpendicular family's Gram determinant reads the
self-pairings' product: off the diagonal the Gram sits at the unit
class, so every assignment off the identity carries such a factor
and the identity's own term is the diagonal product.  The
perpendicularity binder is load-bearing — the check module commits
the refusal at a family pairing off the unit — and no shape read
enters: the Gram is square at the family's row count whatever the
rows' widths. -/
theorem detL_perp (L : Mat) (hperp : perpAll L) :
    (detL (gramM L)).oneValue (selfProd L) :=
  detL_perp_go L.length L (Nat.le_refl _) hperp

/-- The diagonal residual sits against every row at the sum's unit:
the pass's running sum reads the family's whole product against
that row's pairing with the vector, which is the scaled vector's
own read at the joined swap.  Both shape binders are load-bearing
— the check module commits a refusal at each, a vector off the
stated width and a ragged family — as is the perpendicularity. -/
theorem residD_perp (n : Nat) (L : Mat) (v : List BPair)
    (hLn : rowsLen n L) (hv : v.length = n) (hperp : perpAll L)
    (i : Nat) (hi : i < L.length) :
    (dotP (ground.getAt [] L i) (residD L v)).oneValue BPair.unit := by
  have hy : (ground.getAt ([] : List BPair) L i).length = n :=
    rowsLen_getAt L i hLn hi
  show (dotP (ground.getAt [] L i)
    (vecAdd (vecScale (residGo L v).2 v)
      ((residGo L v).1.map BPair.swap))).oneValue BPair.unit
  refine BPair.oneValue_trans
    (dotP_vecAdd (ground.getAt [] L i) _ _
      (by rw [length_vecScale, hv, hy])
      (by rw [ground.length_map, length_residGo n v hv L hLn, hy])) ?_
  rw [dotP_swapMap]
  refine BPair.oneValue_trans
    (BPair.add_congr
      (dotP_vecScale_right (ground.getAt [] L i) v (residGo L v).2)
      (swap_congr (dotP_residGo_row n v hv L hLn hperp i hi))) ?_
  rw [residGo_snd L v, BPair.add_comm]
  exact BPair.swap_add_null (BPair.oneValue_refl _)

/-- A vector perpendicular to every row pairs at the sum's unit
against the two residual spellings' memberwise gap: both spellings
read the determinant against the vector's own pairing, the
perpendicular parts dropping. -/
private theorem gap_self_null (n : Nat) (L : Mat) (v : List BPair)
    (D : List BPair) (hLn : rowsLen n L) (hv : v.length = n)
    (hDl : D.length = n) (hperp : perpAll L)
    (hrow : ∀ k, k < L.length →
      (dotP D (ground.getAt [] L k)).oneValue BPair.unit) :
    (dotP D (vecAdd (residV n L v)
      ((residD L v).map BPair.swap))).oneValue BPair.unit := by
  have hVl : (residV n L v).length = n := length_residV n L v hLn hv
  have hDDl : (residD L v).length = n := length_residD n L v hLn hv
  have hV : (dotP D (residV n L v)).oneValue
      (detL (gramM L) * dotP D v) := by
    refine BPair.oneValue_trans
      (dotP_vecAdd D (vecScale (detL (gramM L)) v)
        ((combo n (adjP (gramM L) (L.map (fun r => dotP r v))) L).map
          BPair.swap)
        (by rw [length_vecScale, hv, hDl])
        (by rw [ground.length_map, length_combo n _ L hLn, hDl])) ?_
    rw [dotP_swapMap]
    refine BPair.oneValue_trans
      (BPair.add_congr (dotP_vecScale_right D v (detL (gramM L)))
        (swap_congr
          (dotP_comboNull n D hDl _ L hLn hrow))) ?_
    exact BPair.add_unit _
  have hD : (dotP D (residD L v)).oneValue
      (detL (gramM L) * dotP D v) := by
    show (dotP D (vecAdd (vecScale (residGo L v).2 v)
      ((residGo L v).1.map BPair.swap))).oneValue
      (detL (gramM L) * dotP D v)
    refine BPair.oneValue_trans
      (dotP_vecAdd D _ _
        (by rw [length_vecScale, hv, hDl])
        (by rw [ground.length_map, length_residGo n v hv L hLn,
          hDl])) ?_
    rw [dotP_swapMap]
    refine BPair.oneValue_trans
      (BPair.add_congr (dotP_vecScale_right D v (residGo L v).2)
        (swap_congr
          (dotP_residGo_null n v D hv hDl L hLn hrow))) ?_
    refine BPair.oneValue_trans (BPair.add_unit _) ?_
    rw [residGo_snd L v]
    exact BPair.mul_congr_left
      (BPair.oneValue_symm (detL_perp L hperp))
  refine BPair.oneValue_trans
    (dotP_vecAdd D (residV n L v) ((residD L v).map BPair.swap)
      (by rw [hVl, hDl])
      (by rw [ground.length_map, hDDl, hDl])) ?_
  rw [dotP_swapMap]
  refine BPair.oneValue_trans
    (BPair.add_congr hV (swap_congr hD)) ?_
  rw [BPair.add_comm]
  exact BPair.swap_add_null (BPair.oneValue_refl _)

/-- The two residual spellings read one value entry for entry at a
pairwise-perpendicular family (`lem:lowerspan`'s two-residuals
identity): their memberwise gap is perpendicular to every row, each
residual pairs that gap at the determinant against the vector's own
read, so the gap's self-pairing sits at the sum's unit and the
positive pairing reads the gap there entry by entry.  The
perpendicularity and the vector's width are load-bearing here, each
with its committed refusal in the check module; the rows' width
read is the frame — a family ragged below it truncates both
spellings to one value. -/
theorem residD_residV (n : Nat) (L : Mat) (v : List BPair)
    (hLn : rowsLen n L) (hv : v.length = n) (hperp : perpAll L) :
    poly.oneValue (residV n L v) (residD L v) := by
  have hVl : (residV n L v).length = n := length_residV n L v hLn hv
  have hDl : (residD L v).length = n := length_residD n L v hLn hv
  have hgap : (vecAdd (residV n L v)
      ((residD L v).map BPair.swap)).length = n :=
    length_vecAdd _ _ n hVl (by rw [ground.length_map]; exact hDl)
  have hrow : ∀ k, k < L.length →
      (dotP (vecAdd (residV n L v) ((residD L v).map BPair.swap))
        (ground.getAt [] L k)).oneValue BPair.unit := by
    intro k hk
    rw [dotP_comm]
    refine BPair.oneValue_trans
      (dotP_vecAdd (ground.getAt [] L k) (residV n L v)
        ((residD L v).map BPair.swap)
        (by rw [hVl, rowsLen_getAt L k hLn hk])
        (by rw [ground.length_map, hDl, rowsLen_getAt L k hLn hk])) ?_
    rw [dotP_swapMap]
    refine BPair.oneValue_trans
      (BPair.add_congr (resid_perp n L v hLn hv k hk)
        (swap_congr (residD_perp n L v hLn hv hperp k hk))) ?_
    exact BPair.unit_add BPair.unit
  refine oneValue_of_null_swap (residV n L v) (residD L v)
    (by rw [hVl, hDl]) ?_
  exact dotP_self_null _
    (gap_self_null n L v _ hLn hv hgap hperp hrow)


/-! The entrywise sum's algebra at the one-value class: the sum
commutes and associates, its four-term exchange is the AC move the
chord tier's expansions run on, the memberwise swap splits over it
and is an involution, and a swapped datum against two of its own
copies reads the datum.  `def:elim`'s sum is `def:ground`'s
componentwise, so every read here is the balance pairs' own, one
key at a time; the sum truncates at the shorter key list, which is
why the reads carry no shape hypothesis. -/


/-- The entrywise matrix sum commutes. -/
theorem matAdd_comm : ∀ A B : Mat, matAdd A B = matAdd B A
  | [], [] => rfl
  | [], _ :: _ => rfl
  | _ :: _, [] => rfl
  | r :: A, s :: B => by
    show vecAdd r s :: matAdd A B = vecAdd s r :: matAdd B A
    rw [vecAdd_comm r s, matAdd_comm A B]

/-- The entrywise matrix sum associates. -/
theorem matAdd_assoc : ∀ A B C : Mat,
    matAdd (matAdd A B) C = matAdd A (matAdd B C)
  | [], _, _ => rfl
  | _ :: _, [], _ => rfl
  | _ :: _, _ :: _, [] => rfl
  | r :: A, s :: B, t :: C => by
    show vecAdd (vecAdd r s) t :: matAdd (matAdd A B) C
      = vecAdd r (vecAdd s t) :: matAdd A (matAdd B C)
    rw [vecAdd_assoc r s t, matAdd_assoc A B C]

/-- The entrywise matrix sum's trailing exchange. -/
theorem matAdd_right_comm (A B C : Mat) :
    matAdd (matAdd A B) C = matAdd (matAdd A C) B := by
  rw [matAdd_assoc A B C, matAdd_comm B C, matAdd_assoc A C B]

/-- The entrywise matrix sum's four-term exchange. -/
theorem matAdd_shuffle : ∀ A B C D : Mat,
    matAdd (matAdd A B) (matAdd C D) = matAdd (matAdd A C) (matAdd B D)
  | [], _, _, _ => rfl
  | _ :: _, [], [], _ => rfl
  | _ :: _, [], _ :: _, _ => rfl
  | _ :: _, _ :: _, [], _ => rfl
  | _ :: _, _ :: _, _ :: _, [] => rfl
  | a :: A, b :: B, c :: C, d :: D => by
    show vecAdd (vecAdd a b) (vecAdd c d) :: matAdd (matAdd A B) (matAdd C D)
      = vecAdd (vecAdd a c) (vecAdd b d) :: matAdd (matAdd A C) (matAdd B D)
    rw [vecAdd_add_comm a b c d, matAdd_shuffle A B C D]

/-- The memberwise swap of a sum splits. -/
theorem vecAdd_swapMap : ∀ u v : List BPair,
    (vecAdd u v).map BPair.swap
      = vecAdd (u.map BPair.swap) (v.map BPair.swap)
  | [], _ => rfl
  | _ :: _, [] => rfl
  | a :: u, b :: v => by
    show (a + b).swap :: (vecAdd u v).map BPair.swap
      = (a.swap + b.swap) :: vecAdd (u.map BPair.swap) (v.map BPair.swap)
    rw [BPair.swap_add, vecAdd_swapMap u v]

/-- The entrywise swap of a matrix sum splits. -/
theorem matSwap_matAdd : ∀ A B : Mat,
    matSwap (matAdd A B) = matAdd (matSwap A) (matSwap B)
  | [], _ => rfl
  | _ :: _, [] => rfl
  | r :: A, s :: B => by
    show (vecAdd r s).map BPair.swap :: matSwap (matAdd A B)
      = vecAdd (r.map BPair.swap) (s.map BPair.swap)
        :: matAdd (matSwap A) (matSwap B)
    rw [vecAdd_swapMap r s, matSwap_matAdd A B]

/-- The entrywise swap is an involution, `poly.neg_neg` row by
row. -/
theorem matSwap_matSwap : ∀ A : Mat, matSwap (matSwap A) = A
  | [] => rfl
  | r :: A => by
    show (r.map BPair.swap).map BPair.swap :: matSwap (matSwap A) = r :: A
    rw [show (r.map BPair.swap).map BPair.swap = r from poly.neg_neg r,
      matSwap_matSwap A]

/-- The entrywise swap's congruence. -/
theorem matSwap_congr : ∀ {A B : Mat}, matOneValue A B →
    matOneValue (matSwap A) (matSwap B)
  | [], [], _ => trivial
  | [], _ :: _, h => h.elim
  | _ :: _, [], h => h.elim
  | _ :: _, _ :: _, h => ⟨poly.swapMap_oneValue h.1, matSwap_congr h.2⟩

/-- The product against a memberwise-swapped left factor is the
product's swap. -/
theorem matMul_swapL (a b : Mat) :
    matMul (matSwap a) b = matSwap (matMul a b) := by
  show (a.map (fun r => r.map BPair.swap)).map
      (fun r => (transposeM b).map (fun c => dotN r c))
    = (a.map (fun r => (transposeM b).map (fun c => dotN r c))).map
      (fun r => r.map BPair.swap)
  rw [ground.map_map, ground.map_map]
  refine ground.map_congr_all _ _ (fun r => ?_) a
  rw [ground.map_map]
  refine ground.map_congr_all _ _ (fun c => ?_) (transposeM b)
  exact dotN_swapLeft r c


private theorem vecSwap_double : ∀ r : List BPair,
    poly.oneValue (vecAdd (r.map BPair.swap) (vecAdd r r)) r
  | [] => trivial
  | x :: r =>
    ⟨by
      show (x.swap + (x + x)).oneValue x
      rw [← BPair.add_assoc]
      exact BPair.oneValue_trans
        (BPair.add_congr (BPair.swap_add_null (BPair.oneValue_refl x))
          (BPair.oneValue_refl x))
        (BPair.unit_add x),
     vecSwap_double r⟩

/-- A matrix's entrywise swap against two of its own copies reads
the matrix, the balance carrier's doubling entry by entry. -/
theorem matSwap_double : ∀ P : Mat,
    matOneValue (matAdd (matSwap P) (matAdd P P)) P
  | [] => trivial
  | r :: t => ⟨vecSwap_double r, matSwap_double t⟩

/-- The matrix one-value read is reflexive. -/
theorem matOne_refl : ∀ M : Mat, matOneValue M M :=
  ground.matched_refl (fun r => poly.oneValue_refl r)

/-- The entrywise sum's row congruence at the truncation boundary:
matched widths on the second member and on the two sums, the first
member's excess read off by the zip's own truncation. -/
theorem polyOne_vecAddT : ∀ (u u' w w' : List BPair),
    poly.oneValue u u' → poly.oneValue w w' →
    w.length = w'.length →
    (List.zipWith (fun a b : BPair => a + b) u w).length
      = (List.zipWith (fun a b : BPair => a + b) u' w').length →
    poly.oneValue (List.zipWith (fun a b : BPair => a + b) u w)
      (List.zipWith (fun a b : BPair => a + b) u' w')
  | [], [], _, _, _, _, _, _ => trivial
  | [], _ :: _, [], [], _, _, _, _ => trivial
  | [], _ :: _, [], _ :: _, _, _, hw, _ => Nat.noConfusion hw
  | [], _ :: _, _ :: _, [], _, _, hw, _ => Nat.noConfusion hw
  | [], _ :: _, _ :: _, _ :: _, _, _, _, hz => Nat.noConfusion hz
  | _ :: _, [], [], [], _, _, _, _ => trivial
  | _ :: _, [], [], _ :: _, _, _, hw, _ => Nat.noConfusion hw
  | _ :: _, [], _ :: _, [], _, _, hw, _ => Nat.noConfusion hw
  | _ :: _, [], _ :: _, _ :: _, _, _, _, hz => Nat.noConfusion hz
  | _ :: _, _ :: _, [], [], _, _, _, _ => trivial
  | _ :: _, _ :: _, [], _ :: _, _, _, hw, _ => Nat.noConfusion hw
  | _ :: _, _ :: _, _ :: _, [], _, _, hw, _ => Nat.noConfusion hw
  | _ :: u, _ :: u', _ :: w, _ :: w', h1, h2, hw, hz =>
    ⟨BPair.add_congr h1.1 h2.1,
     polyOne_vecAddT u u' w w' h1.2 h2.2 (Nat.succ.inj hw)
       (Nat.succ.inj hz)⟩

/-- The entrywise sum's congruence in both members at a stated order
on the second member and on the two sums, the first member's excess
read off by the truncation — the sum congruence's weakest-binder
form, `matAdd_cong2` its four-frame instance. -/
theorem matAdd_congT (n : Nat) : ∀ (A A' B B' : Mat),
    matOneValue A A' → matOneValue B B' →
    rowsLen n B → rowsLen n B' →
    rowsLen n (matAdd A B) → rowsLen n (matAdd A' B') →
    matOneValue (matAdd A B) (matAdd A' B')
  | [], [], _, _, _, _, _, _, _, _ => trivial
  | [], _ :: _, _, _, h, _, _, _, _, _ => h.elim
  | _ :: _, [], _, _, h, _, _, _, _, _ => h.elim
  | _ :: _, _ :: _, [], [], _, _, _, _, _, _ => trivial
  | _ :: _, _ :: _, [], _ :: _, _, h, _, _, _, _ => h.elim
  | _ :: _, _ :: _, _ :: _, [], _, h, _, _, _, _ => h.elim
  | _ :: A, _ :: A', _ :: B, _ :: B', h1, h2, hB, hB', hR, hR' =>
    ⟨polyOne_vecAddT _ _ _ _ h1.1 h2.1 (hB.1.trans hB'.1.symm)
      (hR.1.trans hR'.1.symm),
     matAdd_congT n A A' B B' h1.2 h2.2 hB.2 hB'.2 hR.2 hR'.2⟩

/-! The product's shape algebra: the fold's symmetry, the key-list
exchange as an involution and its two splittings, and the product's
association.  `def:elim`'s matrix is total over stated finite key
lists, so every read below binds the shapes it needs — the exchange
is an involution only at an occupied rectangle, and the product's
association reads the inner factors' exchange reversed.  The
consumers are the chord tier's operator identities
(`lem:fiberdec`'s word and annihilation, its doubling's band read)
and `thm:trigpencil`'s symbol. -/


/-- The row-against-column fold is symmetric at the one-value
read. -/
theorem dotN_comm (u v : List BPair) :
    (dotN u v).oneValue (dotN v u) :=
  BPair.oneValue_trans (dotN_read u v)
    (BPair.oneValue_trans
      (BPair.oneValue_of_eq (dotP_comm u v))
      (BPair.oneValue_symm (dotN_read v u)))

/-- The entrywise sum's row count at matched operands. -/
theorem length_matAdd : ∀ a b : Mat,
    a.length = b.length → (matAdd a b).length = a.length
  | [], _, _ => rfl
  | _ :: _, [], h => Nat.noConfusion h
  | _ :: a, _ :: b, h =>
    congrArg Nat.succ (length_matAdd a b (Nat.succ.inj h))

/-- The entrywise sum's rows at matched operands. -/
theorem rowsLen_matAdd (n : Nat) : ∀ a b : Mat,
    rowsLen n a → rowsLen n b → rowsLen n (matAdd a b)
  | [], _, _, _ => trivial
  | _ :: _, [], _, _ => trivial
  | r :: a, s :: b, ha, hb =>
    ⟨length_vecAdd r s n ha.1 hb.1, rowsLen_matAdd n a b ha.2 hb.2⟩

/-- The entrywise matrix sum's congruence in both members at the
four row frames, `matAdd_congT`'s instance at the sums' derived
widths. -/
theorem matAdd_cong2 (n : Nat) (A B A' B' : Mat)
    (hA : rowsLen n A) (hB : rowsLen n B) (hA' : rowsLen n A')
    (hB' : rowsLen n B') (h1 : matOneValue A A')
    (h2 : matOneValue B B') :
    matOneValue (matAdd A B) (matAdd A' B') :=
  matAdd_congT n A A' B B' h1 h2 hB hB'
    (rowsLen_matAdd n A B hA hB) (rowsLen_matAdd n A' B' hA' hB')

/-- Two order reads join at the sum. -/
theorem sqAt_matAdd (o : Nat) (A B : Mat)
    (hA : sqAt A o) (hB : sqAt B o) : sqAt (matAdd A B) o :=
  sqAt_of
    ((length_matAdd A B ((sqAt_len hA).trans (sqAt_len hB).symm)).trans
      (sqAt_len hA))
    (rowsLen_matAdd o A B (rowsLen_of_sqAt hA) (rowsLen_of_sqAt hB))

/-- The memberwise swap keeps the stated order. -/
theorem sqAt_matSwap (o : Nat) (M : Mat) (h : sqAt M o) :
    sqAt (matSwap M) o :=
  sqAt_of ((length_matSwap M).trans (sqAt_len h))
    (rowsLen_mapRows BPair.swap M o (rowsLen_of_sqAt h))

/-- The entrywise sum's row at a key: the two operands' rows at
that key, summed. -/
theorem getAt_matAdd : ∀ (a b : Mat) (p : Nat),
    p < a.length → p < b.length →
    ground.getAt ([] : List BPair) (matAdd a b) p
      = vecAdd (ground.getAt [] a p) (ground.getAt [] b p)
  | [], _, p, hp, _ => absurd hp (Nat.not_lt_zero p)
  | _ :: _, [], p, _, hp => absurd hp (Nat.not_lt_zero p)
  | _ :: _, _ :: _, 0, _, _ => rfl
  | _ :: a, _ :: b, p + 1, hp, hq =>
    getAt_matAdd a b p (Nat.lt_of_succ_lt_succ hp)
      (Nat.lt_of_succ_lt_succ hq)

/-- The key-list exchange is an involution at a stated shape. -/
theorem transposeM_transposeM {n : Nat} (M : Mat) (hM : rowsLen n M)
    (hn : 0 < n) (h0 : 0 < M.length) :
    transposeM (transposeM M) = M := by
  have h1 : (transposeM M).length = n := length_transposeM M hM h0
  have h2 : rowsLen M.length (transposeM M) := rowsLen_transposeM M
  have h3 : (transposeM (transposeM M)).length = M.length :=
    length_transposeM (transposeM M) h2 (by rw [h1]; exact hn)
  refine ground.getAt_ext [] _ _ (by rw [h3]) ?_
  intro p hp
  rw [h3] at hp
  have hrp : (ground.getAt ([] : List BPair)
      (transposeM (transposeM M)) p).length = n := by
    rw [rowsLen_getAt (transposeM (transposeM M)) p
      (rowsLen_cast h1 (rowsLen_transposeM (transposeM M)))
      (by rw [h3]; exact hp)]
  refine ground.getAt_ext BPair.unit _ _
    (by rw [hrp, rowsLen_getAt M p hM hp]) ?_
  intro q hq
  rw [hrp] at hq
  rw [getAt_transposeM BPair.unit (transposeM M) h2 p q hp (by rw [h1]; exact hq),
    getAt_transposeM BPair.unit M hM q p hq hp]

/-- The key-list exchange of a sum splits. -/
theorem transposeM_matAdd {n : Nat} (A B : Mat) (hA : rowsLen n A)
    (hB : rowsLen n B) (hl : A.length = B.length)
    (h0 : 0 < A.length) :
    transposeM (matAdd A B)
      = matAdd (transposeM A) (transposeM B) := by
  have hAB : rowsLen n (matAdd A B) := rowsLen_matAdd n A B hA hB
  have hlAB : (matAdd A B).length = A.length := length_matAdd A B hl
  have h1 : (transposeM (matAdd A B)).length = n :=
    length_transposeM (matAdd A B) hAB (by rw [hlAB]; exact h0)
  have h2 : (transposeM A).length = n := length_transposeM A hA h0
  have h3 : (transposeM B).length = n :=
    length_transposeM B hB (by rw [← hl]; exact h0)
  refine ground.getAt_ext [] _ _
    (by rw [h1, length_matAdd (transposeM A) (transposeM B) (h2.trans h3.symm), h2]) ?_
  intro p hp
  rw [h1] at hp
  have hrA : rowsLen A.length (transposeM A) := rowsLen_transposeM A
  have hrB : rowsLen B.length (transposeM B) := rowsLen_transposeM B
  rw [getAt_matAdd (transposeM A) (transposeM B) p (by rw [h2]; exact hp)
    (by rw [h3]; exact hp)]
  refine ground.getAt_ext BPair.unit _ _ ?_ ?_
  · rw [rowsLen_getAt (transposeM (matAdd A B)) p
      (rowsLen_cast hlAB (rowsLen_transposeM (matAdd A B)))
      (by rw [h1]; exact hp),
      length_vecAdd (ground.getAt [] (transposeM A) p)
        (ground.getAt [] (transposeM B) p) A.length
        (rowsLen_getAt (transposeM A) p hrA (by rw [h2]; exact hp))
        (by rw [rowsLen_getAt (transposeM B) p hrB (by rw [h3]; exact hp)]
            exact hl.symm)]
  · intro q hq
    rw [rowsLen_getAt (transposeM (matAdd A B)) p
      (rowsLen_cast hlAB (rowsLen_transposeM (matAdd A B)))
      (by rw [h1]; exact hp)] at hq
    rw [getAt_transposeM BPair.unit (matAdd A B) hAB p q hp
        (by rw [hlAB]; exact hq),
      getAt_vecAdd _ _ q
        (by rw [rowsLen_getAt (transposeM A) p hrA (by rw [h2]; exact hp)]
            exact hq)
        (by rw [rowsLen_getAt (transposeM B) p hrB (by rw [h3]; exact hp)]
            rw [← hl]; exact hq),
      getAt_transposeM BPair.unit A hA p q hp hq,
      getAt_transposeM BPair.unit B hB p q hp (by rw [← hl]; exact hq),
      getAt_matAdd A B q hq (by rw [← hl]; exact hq),
      getAt_vecAdd _ _ p
        (by rw [rowsLen_getAt A q hA hq]; exact hp)
        (by rw [rowsLen_getAt B q hB (by rw [← hl]; exact hq)]; exact hp)]


/-- The product's rows: the row-against-column folds against the
right factor's key-list exchange. -/
theorem getAt_matMul (a b : Mat) (p : Nat) (hp : p < a.length) :
    ground.getAt ([] : List BPair) (matMul a b) p
      = (transposeM b).map (fun c => dotN (ground.getAt [] a p) c) :=
  ground.getAt_map ([] : List BPair) ([] : List BPair)
    (fun r => (transposeM b).map (fun c => dotN r c)) a p hp

/-- The product's key-list exchange reverses the factors. -/
theorem transposeM_matMul {r n k : Nat} (B C : Mat)
    (hB : rowsLen n B) (hC : rowsLen k C)
    (hBl : B.length = r) (hCl : C.length = n)
    (hr : 0 < r) (hn : 0 < n) :
    matOneValue (transposeM (matMul B C))
      (matMul (transposeM C) (transposeM B)) := by
  have hCt : (transposeM C).length = k :=
    length_transposeM C hC (by rw [hCl]; exact hn)
  have hBt : (transposeM B).length = n :=
    length_transposeM B hB (by rw [hBl]; exact hr)
  have hBtr : rowsLen r (transposeM B) :=
    rowsLen_cast hBl (rowsLen_transposeM B)
  have hCtr : rowsLen n (transposeM C) :=
    rowsLen_cast hCl (rowsLen_transposeM C)
  have hBB : transposeM (transposeM B) = B :=
    transposeM_transposeM B hB hn (by rw [hBl]; exact hr)
  have hMl : (matMul B C).length = r :=
    (ground.length_map _ B).trans hBl
  have hMr : rowsLen k (matMul B C) :=
    rowsLen_cast hCt (rowsLen_matMul B C)
  have hTl : (transposeM (matMul B C)).length = k :=
    length_transposeM (matMul B C) hMr (by rw [hMl]; exact hr)
  have hRl : (matMul (transposeM C) (transposeM B)).length = k :=
    (ground.length_map _ (transposeM C)).trans hCt
  refine matOne_getAt _ _ (by rw [hTl, hRl]) ?_
  intro p hp
  rw [hTl] at hp
  have hrowL : (ground.getAt ([] : List BPair)
      (transposeM (matMul B C)) p).length = r :=
    rowsLen_getAt (transposeM (matMul B C)) p
      (rowsLen_cast hMl (rowsLen_transposeM (matMul B C)))
      (by rw [hTl]; exact hp)
  have hrowR : (ground.getAt ([] : List BPair)
      (matMul (transposeM C) (transposeM B)) p).length = r := by
    rw [getAt_matMul (transposeM C) (transposeM B) p (by rw [hCt]; exact hp),
      ground.length_map, hBB, hBl]
  refine poly.oneValue_of_entries _ _ (by rw [hrowL, hrowR]) ?_
  intro q hq
  rw [hrowL] at hq
  rw [getAt_transposeM BPair.unit (matMul B C) hMr p q hp
      (by rw [hMl]; exact hq),
    getAt_matMul B C q (by rw [hBl]; exact hq),
    ground.getAt_map ([] : List BPair) BPair.unit
      (fun c => dotN (ground.getAt [] B q) c) (transposeM C) p
      (by rw [hCt]; exact hp),
    getAt_matMul (transposeM C) (transposeM B) p (by rw [hCt]; exact hp),
    ground.getAt_map ([] : List BPair) BPair.unit
      (fun c => dotN (ground.getAt [] (transposeM C) p) c)
      (transposeM (transposeM B)) q (by rw [hBB, hBl]; exact hq), hBB]
  exact dotN_comm _ _

/-- The matrix product associates at the shape reads: the row's two
composed actions read the composite's, the key-list exchange
reversing the inner factors. -/
theorem matMul_assoc {n k s : Nat} (A B C : Mat)
    (hA : rowsLen n A) (hB : rowsLen k B) (hC : rowsLen s C)
    (hBl : B.length = n) (hCl : C.length = k)
    (hn : 0 < n) (hk : 0 < k) :
    matOneValue (matMul (matMul A B) C) (matMul A (matMul B C)) := by
  have hBt : (transposeM B).length = k :=
    length_transposeM B hB (by rw [hBl]; exact hn)
  have hBtr : rowsLen n (transposeM B) :=
    rowsLen_cast hBl (rowsLen_transposeM B)
  have hCtr : rowsLen k (transposeM C) :=
    rowsLen_cast hCl (rowsLen_transposeM C)
  have hT : matOneValue (matMul (transposeM C) (transposeM B))
      (transposeM (matMul B C)) :=
    matOne_symm (transposeM_matMul B C hB hC hBl hCl hn hk)
  have key : ∀ x : List BPair, x.length = n →
      poly.oneValue
        ((transposeM C).map (fun c =>
          dotN ((transposeM B).map (fun c' => dotN x c')) c))
        ((transposeM (matMul B C)).map (fun c => dotN x c)) := by
    intro x hx
    refine poly.oneValue_trans
      (dotN_map_comm (transposeM C)
        ((transposeM B).map (fun c' => dotN x c'))) ?_
    refine poly.oneValue_trans
      (matVec_congr_go (transposeM C) _ (matVec (transposeM B) x)
        ((matVec_length (transposeM B) x).symm ▸
          (ground.length_map (fun c' => dotN x c') (transposeM B)))
        (dotN_map_comm (transposeM B) x)) ?_
    refine poly.oneValue_trans
      (matVec_comp (transposeM C) (transposeM B) x n hBtr hx
        (rowsLen_cast hBt.symm hCtr)) ?_
    exact poly.oneValue_trans (matVec_matOne _ _ x hT)
      (poly.oneValue_symm (dotN_map_comm (transposeM (matMul B C)) x))
  show matOneValue
    ((A.map (fun x => (transposeM B).map (fun c => dotN x c))).map
      (fun y => (transposeM C).map (fun c => dotN y c)))
    (A.map (fun x => (transposeM (matMul B C)).map (fun c => dotN x c)))
  rw [ground.map_map]
  clear hT
  induction A with
  | nil => trivial
  | cons row t ih =>
    exact ⟨key row hA.1, ih hA.2⟩

/-- The pairing against a memberwise row sum on its right. -/
theorem dotN_addRow_right (r p q : List BPair)
    (hp : p.length = r.length) (hq : q.length = r.length) :
    (dotN r (vecAdd p q)).oneValue (dotN r p + dotN r q) :=
  BPair.oneValue_trans (dotN_comm r (vecAdd p q))
    (BPair.oneValue_trans (dotN_addRow p q r hp hq)
      (BPair.add_congr (dotN_comm p r) (dotN_comm q r)))

/-- The fold list against an entrywise matrix sum splits. -/
private theorem map_dotN_matAdd (r : List BPair) : ∀ P Q : Mat,
    rowsLen r.length P → rowsLen r.length Q →
    poly.oneValue ((matAdd P Q).map (fun c => dotN r c))
      (vecAdd (P.map (fun c => dotN r c)) (Q.map (fun c => dotN r c)))
  | [], _, _, _ => trivial
  | _ :: _, [], _, _ => trivial
  | p :: P, q :: Q, hP, hQ =>
    ⟨dotN_addRow_right r p q hP.1 hQ.1,
     map_dotN_matAdd r P Q hP.2 hQ.2⟩

/-- The fold list at a summed row splits over a stated family. -/
private theorem dotN_addRow_map (ra rb : List BPair) (n : Nat)
    (ha : ra.length = n) (hb : rb.length = n) :
    ∀ C : Mat, rowsLen n C →
    poly.oneValue (C.map (fun c => dotN (vecAdd ra rb) c))
      (vecAdd (C.map (fun c => dotN ra c)) (C.map (fun c => dotN rb c)))
  | [], _ => trivial
  | c :: t, h =>
    ⟨dotN_addRow ra rb c (ha.trans h.1.symm) (hb.trans h.1.symm),
     dotN_addRow_map ra rb n ha hb t h.2⟩

/-- The product distributes over the left factor's entrywise sum. -/
theorem matMul_addL (n : Nat) (X : Mat)
    (hX : rowsLen n (transposeM X)) : ∀ A B : Mat,
    rowsLen n A → rowsLen n B →
    matOneValue (matMul (matAdd A B) X)
      (matAdd (matMul A X) (matMul B X))
  | [], _, _, _ => trivial
  | _ :: _, [], _, _ => trivial
  | ra :: A, rb :: B, hA, hB =>
    ⟨dotN_addRow_map ra rb n hA.1 hB.1 (transposeM X) hX,
     matMul_addL n X hX A B hA.2 hB.2⟩

/-- The product distributes over the right factor's entrywise
sum, the key-list exchange of the sum its route. -/
theorem matMul_addR {n : Nat} (A B : Mat) (hA : rowsLen n A)
    (hB : rowsLen n B) (hl : A.length = B.length)
    (h0 : 0 < A.length) : ∀ X : Mat, rowsLen A.length X →
    matOneValue (matMul X (matAdd A B))
      (matAdd (matMul X A) (matMul X B))
  | [], _ => trivial
  | r :: t, hXr => by
    refine ⟨?_, matMul_addR A B hA hB hl h0 t hXr.2⟩
    rw [transposeM_matAdd A B hA hB hl h0]
    exact map_dotN_matAdd r (transposeM A) (transposeM B)
      (rowsLen_cast hXr.1.symm (rowsLen_transposeM A))
      (rowsLen_cast (hl ▸ hXr.1.symm) (rowsLen_transposeM B))

/-- The key-list exchange's congruence at a stated rectangle: the
exchanged entry is the entry exchanged, so the class read passes
through key by key. -/
private theorem transposeM_congr {n : Nat} (A B : Mat) (hA : rowsLen n A)
    (hB : rowsLen n B) (hl : A.length = B.length) (h0 : 0 < A.length)
    (h : matOneValue A B) :
    matOneValue (transposeM A) (transposeM B) := by
  have h1 : (transposeM A).length = n := length_transposeM A hA h0
  have h2 : (transposeM B).length = n :=
    length_transposeM B hB (by rw [← hl]; exact h0)
  refine matOne_getAt _ _ (by rw [h1, h2]) ?_
  intro p hp
  rw [h1] at hp
  have hrA : (ground.getAt ([] : List BPair) (transposeM A) p).length
      = A.length :=
    rowsLen_getAt (transposeM A) p (rowsLen_transposeM A)
      (by rw [h1]; exact hp)
  have hrB : (ground.getAt ([] : List BPair) (transposeM B) p).length
      = B.length :=
    rowsLen_getAt (transposeM B) p (rowsLen_transposeM B)
      (by rw [h2]; exact hp)
  refine poly.oneValue_of_entries _ _ (by rw [hrA, hrB, hl]) ?_
  intro q hq
  rw [hrA] at hq
  rw [getAt_transposeM BPair.unit A hA p q hp hq,
    getAt_transposeM BPair.unit B hB p q hp (by rw [← hl]; exact hq)]
  exact poly.oneValue_getAt p (matOne_entries A B h q hq)

/-- The key-list exchange passes an entrywise one-value read at a
stated width, the vacant width its own read. -/
theorem transposeM_congrM (n : Nat) : ∀ (A B : Mat),
    rowsLen n A → rowsLen n B → A.length = B.length →
    matOneValue A B → matOneValue (transposeM A) (transposeM B)
  | [], [], _, _, _, _ => trivial
  | [], _ :: _, _, _, _, h => h.elim
  | _ :: _, [], _, _, _, h => h.elim
  | r :: t, s :: u, hA, hB, hlen, h =>
    transposeM_congr (r :: t) (s :: u) hA hB hlen
      (Nat.succ_pos _) h

/-- The product's congruence in its right factor off the exchanged
factors' own class read: the key-list exchange is what the row folds
consume, so the exchange's read is the primitive and no shape binder
enters. -/
theorem matMul_congrR_of (A B B' : Mat)
    (h : matOneValue (transposeM B) (transposeM B')) :
    matOneValue (matMul A B) (matMul A B') := by
  show matOneValue (A.map (fun r => (transposeM B).map (fun c => dotN r c)))
    (A.map (fun r => (transposeM B').map (fun c => dotN r c)))
  refine matOne_map _ _ (fun r => ?_) A
  exact poly.oneValue_trans (dotN_map_comm (transposeM B) r)
    (poly.oneValue_trans (matVec_matOne _ _ r h)
      (poly.oneValue_symm (dotN_map_comm (transposeM B') r)))

/-- The product's congruence in its right factor at a stated
rectangle, the untransposed read derived at `transposeM_congr`'s own
shape binders. -/
theorem matMul_congrR {n k : Nat} (A B B' : Mat) (hB : rowsLen k B)
    (hB' : rowsLen k B') (hBl : B.length = n) (hB'l : B'.length = n)
    (hn : 0 < n) (h : matOneValue B B') :
    matOneValue (matMul A B) (matMul A B') :=
  matMul_congrR_of A B B'
    (transposeM_congr B B' hB hB' (hBl.trans hB'l.symm)
      (by rw [hBl]; exact hn) h)

/-! The pivot's places (`lem:inertia`'s addition clause at stated
places): the selection at row and column key lists, the places'
permutation matrix at an index list, and the conjugation's read —
the block selected at the places' pair, the entry fold against the
place indicators picking the stated row and column out. -/

/-- The selected block at stated row and column key lists, one
entry read per key pair. -/
def selM (I J : List Nat) (S : Mat) : Mat :=
  selMO BPair.unit I J S

/-- The permutation matrix at an index list, one place indicator
per member. -/
def permM (n : Nat) (idx : List Nat) : Mat := idx.map (idRow n)

/-- The selection at a joined key list is the assembled block datum:
the four selected blocks at the join's split. -/
theorem selM_append (I J : List Nat) (S : Mat) :
    selM (I ++ J) (I ++ J) S
      = List.zipWith (· ++ ·) (selM I I S) (selM I J S)
        ++ List.zipWith (· ++ ·) (selM J I S) (selM J J S) := by
  show (I ++ J).map (fun i => (I ++ J).map (fun j =>
      ground.getAt BPair.unit (ground.getAt [] S i) j))
    = List.zipWith (fun u v : List BPair => u ++ v)
        (I.map (fun i => I.map (fun j =>
          ground.getAt BPair.unit (ground.getAt [] S i) j)))
        (I.map (fun i => J.map (fun j =>
          ground.getAt BPair.unit (ground.getAt [] S i) j)))
      ++ List.zipWith (fun u v : List BPair => u ++ v)
        (J.map (fun i => I.map (fun j =>
          ground.getAt BPair.unit (ground.getAt [] S i) j)))
        (J.map (fun i => J.map (fun j =>
          ground.getAt BPair.unit (ground.getAt [] S i) j)))
  rw [ground.zipWith_map_map (fun u v : List BPair => u ++ v)
      (fun i => I.map (fun j =>
        ground.getAt BPair.unit (ground.getAt [] S i) j))
      (fun i => J.map (fun j =>
        ground.getAt BPair.unit (ground.getAt [] S i) j)) I,
    ground.zipWith_map_map (fun u v : List BPair => u ++ v)
      (fun i => I.map (fun j =>
        ground.getAt BPair.unit (ground.getAt [] S i) j))
      (fun i => J.map (fun j =>
        ground.getAt BPair.unit (ground.getAt [] S i) j)) J,
    ground.map_congr_all
      (fun i => (I ++ J).map (fun j =>
        ground.getAt BPair.unit (ground.getAt [] S i) j))
      (fun i => I.map (fun j =>
        ground.getAt BPair.unit (ground.getAt [] S i) j)
        ++ J.map (fun j =>
          ground.getAt BPair.unit (ground.getAt [] S i) j))
      (fun i => ground.map_append
        (fun j => ground.getAt BPair.unit (ground.getAt [] S i) j) I J)
      (I ++ J),
    ground.map_append _ I J]

/-- The permutation matrix's row count is its index list's. -/
private theorem length_permM (n : Nat) (idx : List Nat) :
    (permM n idx).length = idx.length := ground.length_map _ idx

/-- The permutation matrix's rows sit at the stated width. -/
theorem rowsLen_permM (n : Nat) : ∀ idx : List Nat,
    rowsLen n (permM n idx)
  | [] => trivial
  | k :: t => ⟨length_idRow n k, rowsLen_permM n t⟩

/-- The permutation matrix's row at a key is its place's
indicator. -/
private theorem getAt_permM (n : Nat) (idx : List Nat) (p : Nat)
    (hp : p < idx.length) :
    ground.getAt ([] : List BPair) (permM n idx) p
      = idRow n (ground.getAt 0 idx p) :=
  ground.getAt_map (0 : Nat) ([] : List BPair) (idRow n) idx p hp

/-- The column selection's rows sit at the key list's count. -/
private theorem rowsLen_mapSel (J : List Nat) : ∀ S : Mat,
    rowsLen J.length (S.map (fun r => J.map (fun j =>
      ground.getAt BPair.unit r j)))
  | [] => trivial
  | _ :: t => ⟨ground.length_map _ J, rowsLen_mapSel J t⟩

/-- The row selection off the column selection is the selected
block, at row keys within the datum's order. -/
private theorem selM_rowSel (n : Nat) (J : List Nat) (S : Mat)
    (hSl : S.length = n) : ∀ I : List Nat,
    (I.all (fun i => Nat.blt i n)) = true →
    I.map (fun i => ground.getAt ([] : List BPair)
        (S.map (fun r => J.map (fun j =>
          ground.getAt BPair.unit r j))) i)
      = selM I J S
  | [], _ => rfl
  | k :: t, h => by
    have hs := ground.andSplitB
      (show (Nat.blt k n && t.all (fun i => Nat.blt i n)) = true from h)
    show ground.getAt ([] : List BPair)
        (S.map (fun r => J.map (fun j =>
          ground.getAt BPair.unit r j))) k
        :: t.map (fun i => ground.getAt ([] : List BPair)
          (S.map (fun r => J.map (fun j =>
            ground.getAt BPair.unit r j))) i)
      = J.map (fun j =>
          ground.getAt BPair.unit (ground.getAt [] S k) j)
        :: selM t J S
    rw [selM_rowSel n J S hSl t hs.2,
      ground.getAt_map ([] : List BPair) ([] : List BPair)
        (fun r => J.map (fun j => ground.getAt BPair.unit r j)) S k
        (by rw [hSl]; exact ground.bltLt hs.1)]

/-- The product against the places' transpose selects the stated
columns, one entry read per place. -/
private theorem matMul_permT (n : Nat) (S : Mat) (hS : rowsLen n S)
    (hn : 0 < n) : ∀ idx : List Nat,
    (idx.all (fun i => Nat.blt i n)) = true →
    matOneValue (matMul S (transposeM (permM n idx)))
      (S.map (fun r => idx.map (fun j => ground.getAt BPair.unit r j)))
  | [], _ => matOne_refl _
  | k :: t, hidx => by
    have hPl : (permM n (k :: t)).length = (k :: t).length :=
      length_permM n (k :: t)
    have hPr : rowsLen n (permM n (k :: t)) := rowsLen_permM n (k :: t)
    have hPpos : 0 < (permM n (k :: t)).length := by
      rw [hPl]; exact Nat.succ_pos _
    have hTT : transposeM (transposeM (permM n (k :: t)))
        = permM n (k :: t) :=
      transposeM_transposeM (permM n (k :: t)) hPr hn hPpos
    have hMl : (matMul S (transposeM (permM n (k :: t)))).length
        = S.length := length_matMul _ _
    refine matOne_getAt _ _ (by rw [hMl, ground.length_map]) ?_
    intro i hi
    rw [hMl] at hi
    rw [getAt_matMul S (transposeM (permM n (k :: t))) i hi, hTT,
      ground.getAt_map ([] : List BPair) ([] : List BPair)
        (fun r => (k :: t).map (fun j =>
          ground.getAt BPair.unit r j)) S i hi]
    have hrl : (ground.getAt ([] : List BPair) S i).length = n :=
      rowsLen_getAt S i hS hi
    refine poly.oneValue_of_entries _ _
      (by rw [ground.length_map, ground.length_map, hPl]) ?_
    intro q hq
    rw [ground.length_map, hPl] at hq
    rw [ground.getAt_map ([] : List BPair) BPair.unit
        (fun c => dotN (ground.getAt [] S i) c) (permM n (k :: t)) q
        (by rw [hPl]; exact hq),
      ground.getAt_map (0 : Nat) BPair.unit
        (fun j => ground.getAt BPair.unit
          (ground.getAt [] S i) j) (k :: t) q hq,
      getAt_permM n (k :: t) q hq]
    exact BPair.oneValue_trans
      (dotN_read (ground.getAt [] S i) _)
      (dotP_idRow (ground.getAt [] S i) n
        (ground.getAt 0 (k :: t) q) hrl
        (ground.bltLt (ground.all_getAt (0 : Nat) (k :: t) hidx q hq)))

/-- The places' matrix against a datum selects the stated rows, one
row read per place. -/
private theorem permM_matMul (n w : Nat) (X : Mat) (hX : rowsLen w X)
    (hXl : X.length = n) (hn : 0 < n) : ∀ idx : List Nat,
    (idx.all (fun i => Nat.blt i n)) = true →
    matOneValue (matMul (permM n idx) X)
      (idx.map (fun i => ground.getAt ([] : List BPair) X i)) := by
  intro idx hidx
  have hXpos : 0 < X.length := by rw [hXl]; exact hn
  have hTl : (transposeM X).length = w := length_transposeM X hX hXpos
  have hMl : (matMul (permM n idx) X).length = idx.length :=
    (length_matMul _ _).trans (length_permM n idx)
  refine matOne_getAt _ _ (by rw [hMl, ground.length_map]) ?_
  intro p hp
  rw [hMl] at hp
  have hip : ground.getAt (0 : Nat) idx p < n :=
    ground.bltLt (ground.all_getAt (0 : Nat) idx hidx p hp)
  have hipX : ground.getAt (0 : Nat) idx p < X.length := by
    rw [hXl]; exact hip
  rw [getAt_matMul (permM n idx) X p (by rw [length_permM]; exact hp),
    getAt_permM n idx p hp,
    ground.getAt_map (0 : Nat) ([] : List BPair)
      (fun i => ground.getAt ([] : List BPair) X i) idx p hp]
  refine poly.oneValue_of_entries _ _
    (by rw [ground.length_map, hTl,
      rowsLen_getAt X (ground.getAt (0 : Nat) idx p) hX hipX]) ?_
  intro q hq
  rw [ground.length_map, hTl] at hq
  have hcol : (ground.getAt ([] : List BPair) (transposeM X) q).length
      = n := by
    rw [rowsLen_getAt (transposeM X) q (rowsLen_transposeM X)
      (by rw [hTl]; exact hq), hXl]
  rw [ground.getAt_map ([] : List BPair) BPair.unit
      (fun c => dotN (idRow n (ground.getAt 0 idx p)) c)
      (transposeM X) q (by rw [hTl]; exact hq),
    ← getAt_transposeM BPair.unit X hX q
      (ground.getAt (0 : Nat) idx p) hq hipX]
  exact BPair.oneValue_trans (dotN_comm _ _)
    (BPair.oneValue_trans
      (dotN_read (ground.getAt [] (transposeM X) q) _)
      (dotP_idRow (ground.getAt [] (transposeM X) q) n
        (ground.getAt 0 idx p) hcol hip))

/-- The conjugation at the places' permutation matrix reads the
selected block: `Π S Πᵀ` at the entry `S` at the places' pair. -/
theorem permM_conj (n : Nat) (idx : List Nat) (S : Mat)
    (hS : sqAt S n)
    (hidx : (idx.all (fun i => Nat.blt i n)) = true) :
    matOneValue
      (matMul (permM n idx) (matMul S (transposeM (permM n idx))))
      (selM idx idx S) := by
  cases idx with
  | nil => trivial
  | cons k t =>
    have hn : 0 < n :=
      Nat.lt_of_le_of_lt (Nat.zero_le k)
        (ground.bltLt (ground.all_getAt (0 : Nat) (k :: t) hidx 0
          (Nat.succ_pos _)))
    have hSr : rowsLen n S := rowsLen_of_sqAt hS
    have hSl : S.length = n := sqAt_len hS
    have hTT : transposeM (transposeM (permM n (k :: t)))
        = permM n (k :: t) :=
      transposeM_transposeM (permM n (k :: t)) (rowsLen_permM n (k :: t))
        hn (by rw [length_permM]; exact Nat.succ_pos _)
    have hCl : (S.map (fun r => (k :: t).map (fun j =>
        ground.getAt BPair.unit r j))).length = n :=
      (ground.length_map _ S).trans hSl
    have hCr : rowsLen (k :: t).length (S.map (fun r =>
        (k :: t).map (fun j => ground.getAt BPair.unit r j))) :=
      rowsLen_mapSel (k :: t) S
    have hYr : rowsLen (k :: t).length
        (matMul S (transposeM (permM n (k :: t)))) :=
      rowsLen_cast (by rw [hTT, length_permM])
        (rowsLen_matMul S (transposeM (permM n (k :: t))))
    have hYl : (matMul S (transposeM (permM n (k :: t)))).length = n :=
      (length_matMul _ _).trans hSl
    have step2 := permM_matMul n (k :: t).length
      (S.map (fun r => (k :: t).map (fun j =>
        ground.getAt BPair.unit r j))) hCr hCl hn (k :: t) hidx
    rw [selM_rowSel n (k :: t) S hSl (k :: t) hidx] at step2
    exact matOne_trans
      (matMul_congrR (n := n) (k := (k :: t).length)
        (permM n (k :: t)) _ _ hYr hCr hYl hCl hn
        (matMul_permT n S hSr hn (k :: t) hidx))
      step2

/-- The selected block's row count is the row key list's. -/
theorem length_selM (I J : List Nat) (S : Mat) :
    (selM I J S).length = I.length :=
  length_selMO BPair.unit I J S

/-- The selected block's rows sit at the column key list's
count. -/
theorem rowsLen_selM (J : List Nat) (S : Mat) (I : List Nat) :
    rowsLen J.length (selM I J S) :=
  rowsLen_selMO BPair.unit J S I

/-- A symmetric datum's entry at an exchanged key pair reads the
pair's own, both keys within the order. -/
private theorem symEntry (n : Nat) (S : Mat) (hSr : rowsLen n S)
    (hSl : S.length = n) (hsym : matOneValue (transposeM S) S)
    (a b : Nat) (ha : a < n) (hb : b < n) :
    (ground.getAt BPair.unit (ground.getAt [] S b) a).oneValue
      (ground.getAt BPair.unit (ground.getAt [] S a) b) := by
  have hTl : (transposeM S).length = n :=
    length_transposeM S hSr
      (by rw [hSl]; exact Nat.lt_of_le_of_lt (Nat.zero_le a) ha)
  have hrow := matOne_entries (transposeM S) S hsym a
    (by rw [hTl]; exact ha)
  have hent := poly.oneValue_getAt b hrow
  rw [getAt_transposeM BPair.unit S hSr a b ha
    (by rw [hSl]; exact hb)] at hent
  exact hent

/-- The selection's exchange at a symmetric datum: the transposed
coupling block is the exchanged lists' own, the row key list
occupied so the transpose reads the column count. -/
theorem transposeM_selM (I J : List Nat) (S : Mat) (n : Nat)
    (hS : sqAt S n) (hsym : matOneValue (transposeM S) S)
    (hI0 : 0 < I.length)
    (hI : (I.all (fun i => Nat.blt i n)) = true)
    (hJ : (J.all (fun j => Nat.blt j n)) = true) :
    matOneValue (transposeM (selM I J S)) (selM J I S) := by
  have hSr : rowsLen n S := rowsLen_of_sqAt hS
  have hSl : S.length = n := sqAt_len hS
  have hMl : (selM I J S).length = I.length := ground.length_map _ I
  have hMr : rowsLen J.length (selM I J S) := rowsLen_selM J S I
  have hTl : (transposeM (selM I J S)).length = J.length :=
    length_transposeM (selM I J S) hMr (by rw [hMl]; exact hI0)
  have hM2 : (selM J I S).length = J.length := ground.length_map _ J
  refine matOne_getAt _ _ (by rw [hTl, hM2]) ?_
  intro p hp
  rw [hTl] at hp
  have hrowL : (ground.getAt ([] : List BPair)
      (transposeM (selM I J S)) p).length = I.length := by
    rw [rowsLen_getAt (transposeM (selM I J S)) p
      (rowsLen_cast hMl (rowsLen_transposeM (selM I J S)))
      (by rw [hTl]; exact hp)]
  have hjp : ground.getAt (0 : Nat) J p < n :=
    ground.bltLt (ground.all_getAt (0 : Nat) J hJ p hp)
  have hrowR : (ground.getAt ([] : List BPair) (selM J I S) p).length
      = I.length := by
    rw [show selM J I S = J.map (fun j => I.map (fun i =>
        ground.getAt BPair.unit (ground.getAt [] S j) i)) from rfl,
      ground.getAt_map (0 : Nat) ([] : List BPair)
        (fun j => I.map (fun i =>
          ground.getAt BPair.unit (ground.getAt [] S j) i)) J p hp,
      ground.length_map]
  refine poly.oneValue_of_entries _ _ (by rw [hrowL, hrowR]) ?_
  intro q hq
  rw [hrowL] at hq
  have hiq : ground.getAt (0 : Nat) I q < n :=
    ground.bltLt (ground.all_getAt (0 : Nat) I hI q hq)
  rw [getAt_transposeM BPair.unit (selM I J S) hMr p q hp
      (by rw [hMl]; exact hq),
    show selM I J S = I.map (fun i => J.map (fun j =>
        ground.getAt BPair.unit (ground.getAt [] S i) j)) from rfl,
    ground.getAt_map (0 : Nat) ([] : List BPair)
      (fun i => J.map (fun j =>
        ground.getAt BPair.unit (ground.getAt [] S i) j)) I q hq,
    ground.getAt_map (0 : Nat) BPair.unit
      (fun j => ground.getAt BPair.unit
        (ground.getAt [] S (ground.getAt 0 I q)) j) J p hp,
    show selM J I S = J.map (fun j => I.map (fun i =>
        ground.getAt BPair.unit (ground.getAt [] S j) i)) from rfl,
    ground.getAt_map (0 : Nat) ([] : List BPair)
      (fun j => I.map (fun i =>
        ground.getAt BPair.unit (ground.getAt [] S j) i)) J p hp,
    ground.getAt_map (0 : Nat) BPair.unit
      (fun i => ground.getAt BPair.unit
        (ground.getAt [] S (ground.getAt 0 J p)) i) I q hq]
  exact symEntry n S hSr hSl hsym (ground.getAt 0 J p)
    (ground.getAt 0 I q) hjp hiq


/-! The matrix-valued index fold, `def:ground`'s index fold at the
entrywise matrix sum: a matrix family added along the index order
from the null seed at a stated order.  Its reads are `vsum`'s own
at the matrix carrier — the head split (`msum_cons`, the seed
dropping at the first member), the tail split at a snoc
(`msum_append`), the shift and wrap reads (`msum_shift`,
`msum_wrap`) and the product against the fold (`matMul_msum`). -/

/-- The null matrix at a stated key pair: the unit family at every
key, the fold's own seed and the off-diagonal slab's block. -/
def nullMat (k m : Nat) : Mat :=
  List.replicate k (List.replicate m BPair.unit)

/-- The null matrix's row count is its first key. -/
theorem length_nullMat (k m : Nat) : (nullMat k m).length = k :=
  ground.length_replicate (List.replicate m BPair.unit) k

/-- The null matrix's rows sit at its second key. -/
theorem rowsLen_nullMat (k m : Nat) : rowsLen m (nullMat k m) :=
  rowsLen_replicate m k

/-- A null matrix absorbs into the entrywise sum at matched
shapes. -/
theorem matAdd_nullL {n : Nat} : ∀ (Z X : Mat), matNull Z →
    Z.length = X.length → rowsLen n Z → rowsLen n X →
    matOneValue (matAdd Z X) X
  | [], [], _, _, _, _ => trivial
  | [], _ :: _, _, h, _, _ => Nat.noConfusion h
  | _ :: _, [], _, h, _, _ => Nat.noConfusion h
  | z :: Z, x :: X, hn, h, hZ, hX =>
    ⟨vecAdd_null_left z x (hZ.1.trans hX.1.symm) hn.1,
     matAdd_nullL Z X hn.2 (Nat.succ.inj h) hZ.2 hX.2⟩

/-- A datum against its own memberwise swap is the balanced copy,
every entry at the sum's unit. -/
theorem matNull_add_swap (M : Mat) : matNull (matAdd M (matSwap M)) := by
  rw [matAdd_comm M (matSwap M)]
  exact matNull_swap_add (matOne_refl M)

/-- Two null matrices sum to a null matrix, row by row. -/
theorem matNull_matAdd : ∀ {X Y : Mat}, matNull X → matNull Y →
    matNull (matAdd X Y)
  | [], _, _, _ => trivial
  | _ :: _, [], _, _ => trivial
  | _ :: _, _ :: _, hX, hY =>
    ⟨unitTail_vecAdd_of hX.1 hY.1, matNull_matAdd hX.2 hY.2⟩

/-- A null matrix's rows read the unit tail, row by row. -/
theorem matNull_rowAt : ∀ (M : Mat), matNull M → ∀ i : Nat,
    poly.unitTail (ground.getAt ([] : List BPair) M i)
  | [], _, _ => trivial
  | _ :: _, h, 0 => h.1
  | _ :: t, h, i + 1 => matNull_rowAt t h.2 i

/-- A null matrix's entry reads the sum's unit at every key, the
row read's entry. -/
theorem matNull_getAt (S : Mat) (h : matNull S) (i j : Nat) :
    BPair.oneValue
      (ground.getAt BPair.unit (ground.getAt ([] : List BPair) S i) j)
      BPair.unit :=
  poly.getAt_unitTail (matNull_rowAt S h i) j

/-- A null matrix absorbs into the entrywise sum on the right, the
shapes read square at one order. -/
theorem matAdd_nullR {o : Nat} (X Z : Mat) (hX : sqAt X o)
    (hZ : sqAt Z o) (hn : matNull Z) : matOneValue (matAdd X Z) X := by
  rw [matAdd_comm X Z]
  exact matAdd_nullL Z X hn
    ((sqAt_len hZ).trans (sqAt_len hX).symm)
    (rowsLen_of_sqAt hZ) (rowsLen_of_sqAt hX)

/-- Every entry of the null matrix sits at the sum's unit. -/
theorem matNull_nullMat (m : Nat) : ∀ k : Nat, matNull (nullMat k m)
  | 0 => trivial
  | k + 1 => ⟨poly.unitTail_replicate m, matNull_nullMat m k⟩

/-- A matrix of equal-membered entries acts at the unit tail on
every vector. -/
theorem matVec_matNull : ∀ (M : Mat) (v : List BPair),
    matNull M → poly.unitTail (matVec M v)
  | [], _, _ => trivial
  | r :: t, v, h =>
    ⟨BPair.oneValue_trans (dotN_read r v)
       (dotP_null_tail_left r v h.1), matVec_matNull t v h.2⟩

/-- The null matrix's action sits at the unit tail. -/
theorem matVec_nullMat (k m : Nat) (v : List BPair) :
    poly.unitTail (matVec (nullMat k m) v) :=
  matVec_matNull _ v (matNull_nullMat m k)

/-- The matrix-valued index fold at a stated order: the family's
matrices added along the index order from the null seed. -/
def msum (n : Nat) (g : Nat → Mat) (l : List Nat) : Mat :=
  l.foldl (fun acc k => matAdd acc (g k)) (nullMat n n)

private theorem msumGo_shape (n : Nat) (g : Nat → Mat)
    (hg : ∀ k, rowsLen n (g k) ∧ (g k).length = n) :
    ∀ (l : List Nat) (acc : Mat), rowsLen n acc → acc.length = n →
      rowsLen n (l.foldl (fun a k => matAdd a (g k)) acc)
      ∧ (l.foldl (fun a k => matAdd a (g k)) acc).length = n
  | [], _, hr, hl => ⟨hr, hl⟩
  | k :: t, acc, hr, hl =>
    msumGo_shape n g hg t (matAdd acc (g k))
      (rowsLen_matAdd n acc (g k) hr (hg k).1)
      ((length_matAdd acc (g k) (hl.trans (hg k).2.symm)).trans hl)

/-- The fold's shape is the family's own. -/
theorem msum_shape (n : Nat) (g : Nat → Mat)
    (hg : ∀ k, rowsLen n (g k) ∧ (g k).length = n) (l : List Nat) :
    rowsLen n (msum n g l) ∧ (msum n g l).length = n :=
  msumGo_shape n g hg l (nullMat n n) (rowsLen_nullMat n n) (length_nullMat n n)

private theorem msumAcc (n : Nat) (g : Nat → Mat) :
    ∀ (l : List Nat) (a b : Mat),
      (l.foldl (fun c k => matAdd c (g k)) (matAdd a b))
        = matAdd a (l.foldl (fun c k => matAdd c (g k)) b)
  | [], _, _ => rfl
  | k :: t, a, b => by
    show (t.foldl (fun c k' => matAdd c (g k')) (matAdd (matAdd a b) (g k)))
      = matAdd a (t.foldl (fun c k' => matAdd c (g k')) (matAdd b (g k)))
    rw [matAdd_assoc a b (g k)]
    exact msumAcc n g t a (matAdd b (g k))

/-- The fold's head splits off, the null seed dropping. -/
theorem msum_cons (n : Nat) (g : Nat → Mat) (k : Nat) (t : List Nat) :
    msum n g (k :: t) = matAdd (g k) (msum n g t) := by
  show (t.foldl (fun c k' => matAdd c (g k')) (matAdd (nullMat n n) (g k)))
    = matAdd (g k) (msum n g t)
  rw [matAdd_comm (nullMat n n) (g k), msumAcc n g t (g k) (nullMat n n)]
  rfl

/-- The index fold's congruence: pointwise one-value families fold
to one value. -/
theorem msum_congr (n : Nat) (f g : Nat → Mat)
    (hf : ∀ k, rowsLen n (f k) ∧ (f k).length = n)
    (hg : ∀ k, rowsLen n (g k) ∧ (g k).length = n)
    (h : ∀ k, matOneValue (f k) (g k)) :
    ∀ l : List Nat, matOneValue (msum n f l) (msum n g l)
  | [] => matOne_refl _
  | k :: t => by
    rw [msum_cons n f k t, msum_cons n g k t]
    exact matAdd_cong2 n _ _ (g k) (msum n g t)
      (hf k).1 (msum_shape n f hf t).1 (hg k).1
      (msum_shape n g hg t).1 (h k)
      (msum_congr n f g hf hg h t)

/-- The fold's tail splits off at a snoc. -/
theorem msum_append (n : Nat) (g : Nat → Mat) (l : List Nat) (k : Nat) :
    msum n g (l ++ [k]) = matAdd (msum n g l) (g k) :=
  ground.foldl_append (fun c k' => matAdd c (g k')) l [k] (nullMat n n)

/-- A shared summand cancels on the right of an entrywise matrix
sum. -/
theorem matAdd_cancelR (n : Nat) : ∀ A B S : Mat,
    rowsLen n A → rowsLen n B → rowsLen n S →
    A.length = B.length → A.length = S.length →
    matOneValue (matAdd A S) (matAdd B S) → matOneValue A B
  | [], [], _, _, _, _, _, _, _ => trivial
  | [], _ :: _, _, _, _, _, hl, _, _ => Nat.noConfusion hl
  | _ :: _, [], _, _, _, _, hl, _, _ => Nat.noConfusion hl
  | _ :: _, _ :: _, [], _, _, _, _, hs, _ => Nat.noConfusion hs
  | a :: A, b :: B, s :: S, hA, hB, hS, hl, hs, h =>
    ⟨vecAdd_cancel_right a b s (hA.1.trans hB.1.symm)
      (hA.1.trans hS.1.symm) h.1,
     matAdd_cancelR n A B S hA.2 hB.2 hS.2 (Nat.succ.inj hl)
       (Nat.succ.inj hs) h.2⟩

/-- The pairing reads one value in its left member at the skipping
fold. -/
theorem dotN_congrL (r s c : List BPair) (h : poly.oneValue r s) :
    (dotN r c).oneValue (dotN s c) :=
  BPair.oneValue_trans (dotN_read r c)
    (BPair.oneValue_trans (dotP_oneValue_left r s c h)
      (BPair.oneValue_symm (dotN_read s c)))

/-- The dot's normal read passes a class read of its right
factor. -/
theorem dotN_congrR (c r s : List BPair) (h : poly.oneValue r s) :
    (dotN c r).oneValue (dotN c s) :=
  BPair.oneValue_trans (dotN_read c r)
    (BPair.oneValue_trans (dotP_oneValue_right c r s h)
      (BPair.oneValue_symm (dotN_read c s)))

/-- The coupling's exchange at a pairing: the transpose's action
against one vector is the datum's action against the other. -/
theorem dotN_transpose_flip (A : Mat) (n : Nat) (hAr : rowsLen n A)
    (u w : List BPair) (hu : u.length = n) (hw : w.length = A.length) :
    (dotN u (matVec (transposeM A) w)).oneValue (dotN w (matVec A u)) := by
  refine BPair.oneValue_trans (dotN_read _ _) ?_
  refine BPair.oneValue_trans
    (BPair.oneValue_symm (dotP_matVec_transpose n A u w hAr hu hw)) ?_
  rw [dotP_comm (matVec A u) w]
  exact BPair.oneValue_symm (dotN_read w (matVec A u))

/-- A symmetric datum exchanges the two vectors of its pairing. -/
theorem dotN_sym_flip (A : Mat) (n : Nat) (hAr : rowsLen n A)
    (hAl : A.length = n) (hsym : matOneValue (transposeM A) A)
    (u w : List BPair) (hu : u.length = n) (hw : w.length = n) :
    (dotN w (matVec A u)).oneValue (dotN u (matVec A w)) :=
  BPair.oneValue_trans
    (BPair.oneValue_symm
      (dotN_transpose_flip A n hAr u w hu (hw.trans hAl.symm)))
    (dotN_congrR u _ _ (matVec_matOne (transposeM A) A w hsym))


/-- The action's entry is the row's fold. -/
theorem getAt_matVec (T : Mat) (v : List BPair)
    (t : Nat) (ht : t < T.length) :
    ground.getAt BPair.unit (matVec T v) t
      = dotN (ground.getAt [] T t) v := by
  rw [show matVec T v = T.map (fun r => dotN r v) from rfl,
    ground.getAt_map ([] : List BPair) BPair.unit
      (fun r => dotN r v) T t ht]

/-- Two coordinate lists reading stated counts over one index
family pair to the counts' product fold, the bilinear read at the
occupancy scalars. -/
theorem dotP_ofNat_fold (F G : List Nat → Nat) :
    ∀ (l : List (List Nat)) (r c : List BPair),
      r.length = l.length → c.length = l.length →
      (∀ t, t < l.length →
        (ground.getAt BPair.unit r t).oneValue
          (BPair.ofNat (F (ground.getAt [] l t)))) →
      (∀ t, t < l.length →
        (ground.getAt BPair.unit c t).oneValue
          (BPair.ofNat (G (ground.getAt [] l t)))) →
      (dotP r c).oneValue
        (BPair.ofNat (ground.famFold Nat.add 0
          (fun m => F m * G m) l))
  | [], [], [], _, _, _, _ => BPair.oneValue_refl _
  | [], [], _ :: _, _, hc, _, _ => Nat.noConfusion hc
  | [], _ :: _, _, hr, _, _, _ => Nat.noConfusion hr
  | _ :: _, [], _, hr, _, _, _ => Nat.noConfusion hr
  | _ :: _, _ :: _, [], _, hc, _, _ => Nat.noConfusion hc
  | m :: ms, _ :: r', _ :: c', hr, hc, hF, hG =>
    BPair.oneValue_trans
      (BPair.add_congr
        (BPair.oneValue_trans
          (BPair.mul_congr (hF 0 (Nat.succ_pos _))
            (hG 0 (Nat.succ_pos _)))
          (BPair.oneValue_symm (BPair.ofNat_mul (F m) (G m))))
        (dotP_ofNat_fold F G ms r' c' (Nat.succ.inj hr)
          (Nat.succ.inj hc)
          (fun t ht => hF (t + 1) (Nat.succ_lt_succ ht))
          (fun t ht => hG (t + 1) (Nat.succ_lt_succ ht))))
      (BPair.oneValue_symm (BPair.ofNat_add (F m * G m)
        (ground.famFold Nat.add 0 (fun m => F m * G m) ms)))

/-- Two matrices of one entrywise value act as one value at every
argument, the rows' congruence. -/
theorem matVec_rows_congr (n : Nat) (A B : Mat)
    (hlen : A.length = B.length) (hA : rowsLen n A)
    (hB : rowsLen n B)
    (hent : ∀ p, p < A.length → ∀ q, q < n →
      (ground.getAt BPair.unit
        (ground.getAt [] A p) q).oneValue
        (ground.getAt BPair.unit (ground.getAt [] B p) q))
    (x : List BPair) :
    poly.oneValue (matVec A x) (matVec B x) := by
  refine poly.oneValue_of_entries _ _ ?_ ?_
  · rw [matVec_length, matVec_length, hlen]
  · intro p hp
    rw [matVec_length] at hp
    have hpB : p < B.length := by rw [← hlen]; exact hp
    rw [getAt_matVec A x p hp, getAt_matVec B x p hpB]
    refine BPair.oneValue_trans (dotN_read _ x) ?_
    refine BPair.oneValue_trans ?_
      (BPair.oneValue_symm (dotN_read _ x))
    rw [dotP_comm (ground.getAt [] A p) x,
      dotP_comm (ground.getAt [] B p) x]
    refine dotP_oneValue_right x _ _ ?_
    refine poly.oneValue_of_entries _ _ ?_ ?_
    · rw [rowsLen_getAt A p hA hp,
        rowsLen_getAt B p hB hpB]
    · intro q hq
      rw [rowsLen_getAt A p hA hp] at hq
      exact hent p hp q hq

/-- The action's congruence in its vector at every shape. -/
theorem matVec_congr : ∀ (T : Mat) (u u' : List BPair),
    poly.oneValue u u' → poly.oneValue (matVec T u) (matVec T u')
  | [], _, _, _ => trivial
  | r :: t, u, u', h => ⟨dotN_congrR r u u' h, matVec_congr t u u' h⟩

/-- The product's congruence in its left factor: the rows enter the
fold lists one at a time, so the class read passes row by row and
no shape binder enters. -/
theorem matMul_congrL : ∀ (A A' B : Mat), matOneValue A A' →
    matOneValue (matMul A B) (matMul A' B)
  | [], [], _, _ => trivial
  | [], _ :: _, _, h => h.elim
  | _ :: _, [], _, h => h.elim
  | r :: A, s :: A', B, h =>
    ⟨poly.oneValue_map _ _ (transposeM B) (fun x _ => (fun c => dotN_congrL r s c h.1) x),
     matMul_congrL A A' B h.2⟩

/-- The places' permutation matrix against its transpose reads the
identity: at a distinct full key list the product's entry is the
place pair's own comparison, `con:places`' transpose identity at
the matrix carrier. -/
theorem permM_orthL (o : Nat) (l : List Nat)
    (hlen : l.length = o) (hd : ground.distinctList l)
    (hb : (l.all (fun i => Nat.blt i o)) = true) :
    matOneValue
      (matMul (permM o l) (transposeM (permM o l)))
      (permM o (List.range o)) := by
  match l, hlen, hd, hb with
  | [], hlen, _, _ =>
    match o, hlen with
    | _, rfl => trivial
  | k :: t, hlen, hd, hb =>
    have hn : 0 < o := by
      rw [← hlen]; exact Nat.succ_pos _
    have step1 := matMul_permT o (permM o (k :: t))
      (rowsLen_permM o (k :: t)) hn (k :: t) hb
    refine matOne_trans step1 (matOne_getAt _ _ ?_ ?_)
    · rw [ground.length_map, length_permM, hlen, length_permM,
        ground.length_range]
    · intro p hp
      rw [ground.length_map, length_permM] at hp
      have hpo : p < o := by rw [← hlen]; exact hp
      have hlp : ground.getAt 0 (k :: t) p < o :=
        ground.bltLt (ground.all_getAt 0 (k :: t) hb p hp)
      rw [ground.getAt_map ([] : List BPair) ([] : List BPair)
          (fun r => (k :: t).map (fun j =>
            ground.getAt BPair.unit r j)) (permM o (k :: t)) p
          (by rw [length_permM]; exact hp),
        show permM o (k :: t) = (k :: t).map (idRow o) from rfl,
        ground.getAt_map 0 ([] : List BPair) (idRow o) (k :: t) p hp,
        show permM o (List.range o) = (List.range o).map (idRow o)
          from rfl,
        ground.getAt_map 0 ([] : List BPair) (idRow o) (List.range o)
          p (by rw [ground.length_range]; exact hpo),
        ground.getAt_range o p hpo]
      refine poly.oneValue_of_entries _ _ (by rw [ground.length_map,
        length_idRow, hlen]) ?_
      intro q hq
      rw [ground.length_map] at hq
      have hqo : q < o := by rw [← hlen]; exact hq
      have hlq : ground.getAt 0 (k :: t) q < o :=
        ground.bltLt (ground.all_getAt 0 (k :: t) hb q hq)
      rw [ground.getAt_map (0 : Nat) BPair.unit
          (fun j => ground.getAt BPair.unit (idRow o
            (ground.getAt 0 (k :: t) p)) j) (k :: t) q hq,
        getAt_idRow o (ground.getAt 0 (k :: t) p)
          (ground.getAt 0 (k :: t) q) hlq,
        getAt_idRow o p q hqo]
      match Nat.decEq q p with
      | isTrue he =>
        rw [if_pos he, if_pos (by rw [he])]
        exact BPair.oneValue_refl _
      | isFalse hne =>
        have hvne : ¬ ground.getAt 0 (k :: t) q
            = ground.getAt 0 (k :: t) p := by
          match Nat.lt_or_ge q p with
          | Or.inl hlt =>
            exact ground.getAt_ne_of_distinct
              (fun x => ground.distinctList_all hd x) hlt hp
          | Or.inr hge =>
            have hlt : p < q :=
              Nat.lt_of_le_of_ne hge (fun e => hne e.symm)
            exact fun e => ground.getAt_ne_of_distinct
              (fun x => ground.distinctList_all hd x) hlt hq e.symm
        rw [if_neg hvne, if_neg hne]
        exact BPair.oneValue_refl _

/-- The transposed order: the transpose against the permutation
matrix reads the identity at a distinct covering key list, the
inverse permutation's own read. -/
theorem permM_orthR (o : Nat) (l : List Nat)
    (hlen : l.length = o) (hd : ground.distinctList l)
    (hb : (l.all (fun i => Nat.blt i o)) = true)
    (hcov : ∀ j, j < o → 0 < ground.countOf j l) :
    matOneValue
      (matMul (transposeM (permM o l)) (permM o l))
      (permM o (List.range o)) := by
  match l, hlen, hd, hb, hcov with
  | [], hlen, _, _, _ =>
    match o, hlen with
    | _, rfl => trivial
  | k :: t, hlen, hd, hb, hcov =>
    have hn : 0 < o := by
      rw [← hlen]; exact Nat.succ_pos _
    have hdist : ∀ z, ground.countOf z (k :: t) ≤ 1 :=
      fun z => ground.distinctList_all hd z
    have hPl : (permM o (k :: t)).length = o := by
      rw [length_permM]; exact hlen
    have hPr : rowsLen o (permM o (k :: t)) := rowsLen_permM o (k :: t)
    have hTl : (transposeM (permM o (k :: t))).length = o :=
      length_transposeM (permM o (k :: t)) hPr
        (by rw [hPl]; exact hn)
    have hTr : rowsLen (permM o (k :: t)).length
        (transposeM (permM o (k :: t))) :=
      rowsLen_transposeM (permM o (k :: t))
    -- the inverse permutation's key list
    have hinvb : (((List.range o).map
        (fun j => places.posOf j (k :: t))).all
          (fun i => Nat.blt i o)) = true := by
      rw [ground.all_map (fun j => places.posOf j (k :: t))
        (fun i => Nat.blt i o) (List.range o)]
      refine ground.all_range_intro o ?_
      intro j hj
      refine ground.ltBlt ?_
      rw [← hlen]
      exact places.posOf_lt j (k :: t) (hcov j hj)
    have hstep : matOneValue (transposeM (permM o (k :: t)))
        (permM o ((List.range o).map
          (fun j => places.posOf j (k :: t)))) := by
      refine matOne_getAt _ _ ?_ ?_
      · rw [hTl, length_permM, ground.length_map,
          ground.length_range]
      · intro p hp
        rw [hTl] at hp
        have hposp : places.posOf p (k :: t) < (k :: t).length :=
          places.posOf_lt p (k :: t) (hcov p hp)
        refine poly.oneValue_of_entries _ _ ?_ ?_
        · rw [rowsLen_getAt _ p (rowsLen_cast hPl hTr)
            (by rw [hTl]; exact hp),
            show permM o ((List.range o).map
                (fun j => places.posOf j (k :: t)))
              = ((List.range o).map
                (fun j => places.posOf j (k :: t))).map (idRow o)
              from rfl,
            ground.getAt_map 0 ([] : List BPair) (idRow o)
              ((List.range o).map (fun j => places.posOf j (k :: t)))
              p (by rw [ground.length_map, ground.length_range]
                    exact hp),
            length_idRow]
        · intro q hq
          rw [rowsLen_getAt _ p (rowsLen_cast hPl hTr)
            (by rw [hTl]; exact hp)] at hq
          have hql : q < (k :: t).length := by
            rw [hlen]; exact hq
          rw [getAt_transposeM BPair.unit (permM o (k :: t)) hPr p q
              hp (by rw [hPl]; exact hq),
            show permM o (k :: t) = (k :: t).map (idRow o) from rfl,
            ground.getAt_map 0 ([] : List BPair) (idRow o)
              (k :: t) q hql,
            getAt_idRow o (ground.getAt 0 (k :: t) q) p hp,
            show permM o ((List.range o).map
                (fun j => places.posOf j (k :: t)))
              = ((List.range o).map
                (fun j => places.posOf j (k :: t))).map (idRow o)
              from rfl,
            ground.map_map (fun j => places.posOf j (k :: t))
              (idRow o) (List.range o),
            ground.getAt_map 0 ([] : List BPair)
              (fun j => idRow o (places.posOf j (k :: t)))
              (List.range o) p
              (by rw [ground.length_range]; exact hp),
            ground.getAt_range o p hp,
            getAt_idRow o (places.posOf p (k :: t)) q
              (by rw [← hlen]; exact hql)]
          match Nat.decEq p (ground.getAt 0 (k :: t) q) with
          | isTrue he =>
            have hqpos : q = places.posOf p (k :: t) := by
              rw [he, places.posOf_getAt hdist q hql]
            rw [if_pos he, if_pos hqpos]
            exact BPair.oneValue_refl _
          | isFalse hne =>
            have hqpos : ¬ q = places.posOf p (k :: t) := by
              intro he
              refine hne ?_
              rw [he, places.getAt_posOf p (k :: t) (hcov p hp)]
            rw [if_neg hne, if_neg hqpos]
            exact BPair.oneValue_refl _
    refine matOne_trans
      (matMul_congrL _ _ (permM o (k :: t)) hstep) ?_
    have hstep2 := permM_matMul o o (permM o (k :: t)) hPr hPl hn
      ((List.range o).map (fun j => places.posOf j (k :: t))) hinvb
    refine matOne_trans hstep2 (matOne_getAt _ _ ?_ ?_)
    · rw [ground.length_map, ground.length_map, ground.length_range,
        length_permM, ground.length_range]
    · intro p hp
      rw [ground.length_map, ground.length_map,
        ground.length_range] at hp
      have hposp : places.posOf p (k :: t) < (k :: t).length :=
        places.posOf_lt p (k :: t) (hcov p hp)
      rw [ground.getAt_map 0 ([] : List BPair)
          (fun i => ground.getAt ([] : List BPair)
            (permM o (k :: t)) i)
          ((List.range o).map (fun j => places.posOf j (k :: t))) p
          (by rw [ground.length_map, ground.length_range]; exact hp),
        ground.getAt_map 0 0 (fun j => places.posOf j (k :: t))
          (List.range o) p
          (by rw [ground.length_range]; exact hp),
        ground.getAt_range o p hp,
        show permM o (k :: t) = (k :: t).map (idRow o) from rfl,
        ground.getAt_map 0 ([] : List BPair) (idRow o) (k :: t)
          (places.posOf p (k :: t)) hposp,
        places.getAt_posOf p (k :: t) (hcov p hp),
        show permM o (List.range o) = (List.range o).map (idRow o)
          from rfl,
        ground.getAt_map 0 ([] : List BPair) (idRow o) (List.range o)
          p (by rw [ground.length_range]; exact hp),
        ground.getAt_range o p hp]
      exact poly.oneValue_refl _

private theorem map_dotN_null : ∀ (M : Mat), matNull M →
    ∀ r : List BPair, poly.unitTail (M.map (fun c => dotN r c))
  | [], _, _ => trivial
  | c :: t, h, r =>
    ⟨BPair.oneValue_trans (dotN_read r c)
      (dotP_null_tail_right r c h.1),
     map_dotN_null t h.2 r⟩

/-- The null matrix swallows the product on its right. -/
theorem matMul_nullMat (n : Nat) (X : Mat) (hXl : X.length = n) :
    matOneValue (matMul X (nullMat n n)) (nullMat n n) := by
  have hMl : (matMul X (nullMat n n)).length = n :=
    (length_matMul X (nullMat n n)).trans hXl
  refine matOne_getAt _ _ (by rw [hMl, length_nullMat]) ?_
  intro i hi
  rw [hMl] at hi
  rw [getAt_matMul X (nullMat n n) i (by rw [hXl]; exact hi),
    show nullMat n n = List.replicate n (List.replicate n BPair.unit) from rfl,
    ground.getAt_replicate ([] : List BPair) (List.replicate n BPair.unit)
      n i hi]
  exact poly.unitTail_oneValue
    (map_dotN_null (transposeM (nullMat n n))
      (matNull_transposeM (nullMat n n) (matNull_nullMat n n)) _)
    (poly.unitTail_replicate n)

/-- The product enters the fold family by family: the left factor
distributes over the index fold at its stated order. -/
theorem matMul_msum (n : Nat) (X : Mat) (hX : rowsLen n X)
    (hXl : X.length = n) (hn : 0 < n) (g : Nat → Mat)
    (hg : ∀ k, rowsLen n (g k) ∧ (g k).length = n) :
    ∀ l : List Nat,
      matOneValue (matMul X (msum n g l))
        (msum n (fun k => matMul X (g k)) l)
  | [] => matMul_nullMat n X hXl
  | k :: t => by
    have hg' : ∀ k, rowsLen n (matMul X (g k))
        ∧ (matMul X (g k)).length = n := fun k =>
      ⟨rowsLen_cast
        (length_transposeM (g k) (hg k).1 (by rw [(hg k).2]; exact hn))
        (rowsLen_matMul X (g k)),
       (length_matMul X (g k)).trans hXl⟩
    rw [msum_cons n g k t, msum_cons n (fun k => matMul X (g k)) k t]
    refine matOne_trans
      (matMul_addR (n := n) (g k) (msum n g t) (hg k).1
        (msum_shape n g hg t).1
        ((hg k).2.trans (msum_shape n g hg t).2.symm)
        (by rw [(hg k).2]; exact hn) X
        (rowsLen_cast (hg k).2.symm hX)) ?_
    exact matAdd_cong2 n (matMul X (g k)) (matMul X (msum n g t))
      (matMul X (g k)) (msum n (fun k => matMul X (g k)) t)
      (hg' k).1
      (rowsLen_cast
        (length_transposeM (msum n g t) (msum_shape n g hg t).1
          (by rw [(msum_shape n g hg t).2]; exact hn))
        (rowsLen_matMul X (msum n g t)))
      (hg' k).1 (msum_shape n (fun k => matMul X (g k)) hg' t).1
      (matOne_refl _) (matMul_msum n X hX hXl hn g hg t)

/-- The fold's shift: the shifted family's fold joins the head to
the fold's own snoc read, the two joins the head key and the tail
key. -/
theorem msum_shift (n : Nat) (f : Nat → Mat) : ∀ L : Nat,
    matAdd (f 0) (msum n (fun b => f (b + 1)) (List.range L))
      = matAdd (msum n f (List.range L)) (f L)
  | 0 => matAdd_comm (f 0) (nullMat n n)
  | L + 1 => by
    rw [ground.range_succ L,
      msum_append n (fun b => f (b + 1)) (List.range L) L,
      msum_append n f (List.range L) L,
      ← matAdd_assoc (f 0) (msum n (fun b => f (b + 1)) (List.range L))
        (f (L + 1)), msum_shift n f L]

/-- The fold at a wrapped family: when the family's key at the
range's own length reads its head, the shifted family's fold reads
the family's, the wrapped key clearing against the head. -/
theorem msum_wrap (n : Nat) (f : Nat → Mat)
    (hf : ∀ k, rowsLen n (f k) ∧ (f k).length = n) (L : Nat)
    (hw : matOneValue (f L) (f 0)) :
    matOneValue (msum n (fun b => f (b + 1)) (List.range L))
      (msum n f (List.range L)) := by
  have hf' : ∀ k, rowsLen n (f (k + 1)) ∧ (f (k + 1)).length = n :=
    fun k => hf (k + 1)
  have hA := msum_shape n (fun b => f (b + 1)) hf' (List.range L)
  have hB := msum_shape n f hf (List.range L)
  have hs := msum_shift n f L
  rw [matAdd_comm (f 0) (msum n (fun b => f (b + 1)) (List.range L))] at hs
  refine matAdd_cancelR n _ _ (f 0) hA.1 hB.1 (hf 0).1
    (hA.2.trans hB.2.symm) (hA.2.trans (hf 0).2.symm) ?_
  rw [hs]
  exact matAdd_cong2 n (msum n f (List.range L)) (f L)
    (msum n f (List.range L)) (f 0) hB.1 (hf L).1 hB.1 (hf 0).1
    (matOne_refl _) hw

/-- The successor's place moves across the sum, the `+ 1`
spelling the descent's key reads take (`Nat.succ_add` states its
own at the successor constructor). -/
private theorem addShift (k i : Nat) : k + 1 + i = k + (i + 1) :=
  Nat.succ_add k i

/-- The tail read at the dropped head: the entry one place up. -/
theorem getAt_drop1 {α : Type} (d : α) (l : List α) (c : Nat) :
    ground.getAt d (l.drop 1) c = ground.getAt d l (c + 1) := by
  cases l with
  | nil => rfl
  | cons _ _ => rfl

/-- The dropped head's own width. -/
private theorem length_drop1 {α : Type} : ∀ l : List α,
    0 < l.length → (l.drop 1).length + 1 = l.length
  | [], h => absurd h (Nat.lt_irrefl 0)
  | _ :: _, _ => rfl

/-- The block's pivot row moved to the step's place, one adjacent
exchange per crossing. -/
private def moveRow {α : Type} : Nat → Nat → List α → List α
  | 0, _, m => m
  | i + 1, k, m => ground.adjSwap k (moveRow i (k + 1) m)

/-- The move keeps the row count. -/
private theorem length_moveRow {α : Type} : ∀ (i k : Nat) (m : List α),
    (moveRow i k m).length = m.length
  | 0, _, _ => rfl
  | i + 1, k, m => by
    show (ground.adjSwap k (moveRow i (k + 1) m)).length = m.length
    rw [ground.length_adjSwap, length_moveRow i (k + 1) m]

/-- The move keeps the stated row width. -/
private theorem rowsLen_moveRow {γ : Type} {n : Nat} :
    ∀ (i k : Nat) (m : List (List γ)),
    rowsLen n m → rowsLen n (moveRow i k m)
  | 0, _, _, h => h
  | i + 1, k, m, h =>
    rowsLen_adjSwap k _ (rowsLen_moveRow i (k + 1) m h)

/-- Below the step's place the move reads the rows back. -/
private theorem getAt_moveRow_lt {α : Type} (d : α) :
    ∀ (i k : Nat) (m : List α) (a : Nat),
    a < k → k + i < m.length →
    ground.getAt d (moveRow i k m) a = ground.getAt d m a
  | 0, _, _, _, _, _ => rfl
  | i + 1, k, m, a, hak, hki => by
    have hki' : k + 1 + i < m.length := by
      rw [addShift]
      exact hki
    have hk1 : k + 1 < (moveRow i (k + 1) m).length := by
      rw [length_moveRow i (k + 1) m]
      exact Nat.lt_of_le_of_lt (Nat.le_add_right (k + 1) i) hki'
    show ground.getAt d (ground.adjSwap k (moveRow i (k + 1) m)) a = _
    rw [getAt_adjSwap d k (moveRow i (k + 1) m) hk1 a,
      ground.swapIx_off (Nat.ne_of_lt hak)
        (Nat.ne_of_lt (Nat.lt_trans hak (Nat.lt_succ_self k))),
      getAt_moveRow_lt d i (k + 1) m a
        (Nat.lt_trans hak (Nat.lt_succ_self k)) hki']

/-- At the step's place the move reads the pivot row. -/
private theorem getAt_moveRow_self {α : Type} (d : α) :
    ∀ (i k : Nat) (m : List α),
    k + i < m.length →
    ground.getAt d (moveRow i k m) k = ground.getAt d m (k + i)
  | 0, _, _, _ => rfl
  | i + 1, k, m, hki => by
    have hki' : k + 1 + i < m.length := by
      rw [addShift]
      exact hki
    have hk1 : k + 1 < (moveRow i (k + 1) m).length := by
      rw [length_moveRow i (k + 1) m]
      exact Nat.lt_of_le_of_lt (Nat.le_add_right (k + 1) i) hki'
    show ground.getAt d (ground.adjSwap k (moveRow i (k + 1) m)) k = _
    rw [ground.getAt_adjSwap_fst d k (moveRow i (k + 1) m) hk1,
      getAt_moveRow_self d i (k + 1) m hki', addShift]

/-- Beyond the step's place the move reads the block's further
rows, the pivot's key lifted away. -/
private theorem getAt_moveRow_tail {α : Type} (d : α) :
    ∀ (i k : Nat) (m : List α) (b : Nat),
    k + i < m.length → k + 1 + b < m.length →
    ground.getAt d (moveRow i k m) (k + 1 + b)
      = ground.getAt d m (k + liftIx i b)
  | 0, k, m, b, _, _ => by
    show ground.getAt d m (k + 1 + b)
      = ground.getAt d m (k + if b < 0 then b else b + 1)
    rw [if_neg (Nat.not_lt_zero b), addShift]
  | i + 1, k, m, b, hki, hkb => by
    have hki' : k + 1 + i < m.length := by
      rw [addShift]
      exact hki
    have hk1 : k + 1 < (moveRow i (k + 1) m).length := by
      rw [length_moveRow i (k + 1) m]
      exact Nat.lt_of_le_of_lt (Nat.le_add_right (k + 1) i) hki'
    match b with
    | 0 =>
      show ground.getAt d (ground.adjSwap k (moveRow i (k + 1) m))
        (k + 1) = ground.getAt d m (k + liftIx (i + 1) 0)
      rw [getAt_adjSwap d k (moveRow i (k + 1) m) hk1 (k + 1),
        ground.swapIx_snd (Nat.ne_of_gt (Nat.lt_succ_self k)),
        getAt_moveRow_lt d i (k + 1) m k (Nat.lt_succ_self k) hki',
        show liftIx (i + 1) 0 = 0 from by
          show (if 0 < i + 1 then 0 else 1) = 0
          rw [if_pos (Nat.succ_pos i)]]
      rfl
    | c + 1 =>
      have hstep : k + 1 + (c + 1) = k + 1 + 1 + c :=
        Nat.add_right_comm (k + 1) c 1
      have hgt1 : k + 1 < k + 1 + 1 + c :=
        Nat.lt_of_lt_of_le (Nat.lt_succ_self (k + 1))
          (Nat.le_add_right (k + 1 + 1) c)
      have hgt0 : k < k + 1 + 1 + c :=
        Nat.lt_trans (Nat.lt_succ_self k) hgt1
      show ground.getAt d (ground.adjSwap k (moveRow i (k + 1) m))
          (k + 1 + (c + 1))
        = ground.getAt d m (k + liftIx (i + 1) (c + 1))
      rw [hstep,
        getAt_adjSwap d k (moveRow i (k + 1) m) hk1
          (k + 1 + 1 + c),
        ground.swapIx_off (Nat.ne_of_gt hgt0) (Nat.ne_of_gt hgt1),
        getAt_moveRow_tail d i (k + 1) m c hki'
          (by rw [← hstep]; exact hkb),
        liftIx_succ i c, addShift k (liftIx i c)]

/-! The descent's walk at a general entry carrier: the division
data with the unit test, the exchange grading, the pivot search,
the step's row through the exact cofactor, and the walk —
`def:elim`'s fraction-free pivot descent stated once at the
operations bundle, the balance-pair instance beside it. -/

set_option genInjectivity false in
/-- The descent's division data at a carrier: the exact cofactor
with the unit test, and the laws the walk consumes — the test's
two reads, the cofactor's soundness at a stated factorization,
the product's cancellation at an off-unit factor, and the one's
own off-unit read, the walk's seed. -/
private structure DCof (γ : Type) (ops : DOps γ)
    (ov : γ → γ → Prop) where
  cof : γ → γ → γ
  unitB : γ → Bool
  unitB_true : ∀ {x}, unitB x = true → ov x ops.unit
  unitB_false : ∀ {x}, unitB x = false → ¬ ov x ops.unit
  cofSound : ∀ {P X E}, ¬ ov P ops.unit → ov (ops.mul P X) E →
    ov (ops.mul P (cof E P)) E
  mulCancel : ∀ {P a b}, ¬ ov P ops.unit →
    ov (ops.mul P a) (ops.mul P b) → ov a b
  oneOff : ¬ ov ops.one ops.unit
  nrm : γ → γ
  nrmOv : ∀ x, ov (nrm x) x

/-- The balance-pair instance of the division data. -/
private def bpairCof : DCof BPair bpairOps BPair.oneValue :=
  { cof := cofactorAt
    unitB := fun x => x.norm.isUnitRep
    unitB_true := fun {x} h => by
      have hn := BPair.norm_oneValue x
      rw [BPair.unit_of_isUnitRep h] at hn
      exact BPair.oneValue_symm hn
    unitB_false := fun {x} h hu => by
      rw [BPair.norm_congr hu] at h
      nomatch (show true = false from h)
    cofSound := fun hP hE => cofactorAt_sound hP hE
    mulCancel := fun hP h => ground.mulCancel hP h
    oneOff := by decide +kernel
    nrm := BPair.norm
    nrmOv := fun x => BPair.norm_oneValue x }

/-- The exchange grading at a stated parity, at the bundle's
balance partner. -/
private def signAtO {γ : Type} (ops : DOps γ) (s : Bool) (x : γ) :
    γ :=
  match s with
  | false => x
  | true => ops.swap x

/-- The grading's congruence at one value. -/
private theorem signAtO_congr {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) (s : Bool) {x y : γ}
    (h : R.rel x y) : R.rel (signAtO ops s x) (signAtO ops s y) := by
  cases s with
  | false => exact h
  | true => exact C.swapCongr h

/-- Two gradings at one parity read the datum back. -/
private theorem signAtO_signAtO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) (s : Bool) (x : γ) :
    R.rel (signAtO ops s (signAtO ops s x)) x := by
  cases s with
  | false => exact C.ovRefl x
  | true => exact C.swapSwap x

/-- The grading fixes the sum's unit. -/
private theorem signAtO_unit {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) (s : Bool) :
    R.rel (signAtO ops s ops.unit) ops.unit := by
  cases s with
  | false => exact C.ovRefl _
  | true => exact C.swapUnit

/-- A grading of a grading is the joined parity's own. -/
private theorem signAtO_comp {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) (a b : Bool) (x : γ) :
    R.rel (signAtO ops a (signAtO ops b x))
      (signAtO ops (Bool.xor b a) x) := by
  cases a with
  | false => cases b with
    | false => exact C.ovRefl _
    | true => exact C.ovRefl _
  | true => cases b with
    | false => exact C.ovRefl _
    | true => exact C.swapSwap x

/-- The move's grading at the fold: the crossings' adjacent
exchanges, one balance partner per crossing. -/
private theorem detO_moveRow {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) :
    ∀ (i k : Nat) (m : List (List γ)), k + i < m.length →
    R.rel (detO ops (moveRow i k m))
      (signAtO ops (places.parityOf i) (detO ops m))
  | 0, _, _, _ => C.ovRefl _
  | i + 1, k, m, hki => by
    have hki' : k + 1 + i < m.length := by
      rw [addShift]
      exact hki
    have hk1 : k + 1 < (moveRow i (k + 1) m).length := by
      rw [length_moveRow i (k + 1) m]
      exact Nat.lt_of_le_of_lt (Nat.le_add_right (k + 1) i) hki'
    show R.rel (detO ops (ground.adjSwap k (moveRow i (k + 1) m))) _
    refine C.ovTrans (detO_swapAdj C k (moveRow i (k + 1) m) hk1) ?_
    refine C.ovTrans
      (C.swapCongr (detO_moveRow C i (k + 1) m hki')) ?_
    show R.rel (ops.swap (signAtO ops (places.parityOf i) (detO ops m)))
      (signAtO ops (!(places.parityOf i)) (detO ops m))
    cases places.parityOf i with
    | false => exact C.ovRefl _
    | true => exact C.swapSwap _

/-- The first row whose leading entry fails the unit test, the
step's pivot row. -/
private def findPivO {γ : Type} (ops : DOps γ) (u : γ → Bool) :
    List (List γ) → Option Nat
  | [] => none
  | r :: rows =>
    match u (ground.getAt ops.unit r 0) with
    | false => some 0
    | true =>
      match findPivO ops u rows with
      | some i => some (i + 1)
      | none => none

/-- The pivot search's read: the key sits inside the block and the
row it names has its leading entry failing the test. -/
private theorem findPivO_read {γ : Type} (ops : DOps γ)
    (u : γ → Bool) : ∀ (m : List (List γ)) (i : Nat),
    findPivO ops u m = some i →
    i < m.length ∧ u (ground.getAt ops.unit
      (ground.getAt [] m i) 0) = false
  | [], i, h => by
    nomatch (show (none : Option Nat) = some i from h)
  | r :: rows, i, h => by
    revert h
    show (match u (ground.getAt ops.unit r 0) with
        | false => some 0
        | true =>
          match findPivO ops u rows with
          | some j => some (j + 1)
          | none => none) = some i →
      i < (r :: rows).length ∧ u (ground.getAt ops.unit
        (ground.getAt [] (r :: rows) i) 0) = false
    cases hu : u (ground.getAt ops.unit r 0) with
    | false =>
      intro h
      rw [← Option.some.inj h]
      exact ⟨Nat.succ_pos _, hu⟩
    | true =>
      cases hf : findPivO ops u rows with
      | none =>
        intro h
        nomatch (show (none : Option Nat) = some i from h)
      | some j =>
        intro h
        rw [← Option.some.inj h]
        exact ⟨Nat.succ_lt_succ (findPivO_read ops u rows j hf).1,
          (findPivO_read ops u rows j hf).2⟩

/-- A pivot-free column: every row's leading entry passes the unit
test. -/
private theorem findPivO_none {γ : Type} (ops : DOps γ)
    (u : γ → Bool) : ∀ (m : List (List γ)),
    findPivO ops u m = none →
    ∀ a, a < m.length →
      u (ground.getAt ops.unit (ground.getAt [] m a) 0) = true
  | [], _, a, ha => absurd ha (Nat.not_lt_zero a)
  | r :: rows, h, a, ha => by
    revert h
    show (match u (ground.getAt ops.unit r 0) with
        | false => some 0
        | true =>
          match findPivO ops u rows with
          | some j => some (j + 1)
          | none => none) = none →
      u (ground.getAt ops.unit
        (ground.getAt [] (r :: rows) a) 0) = true
    cases hu : u (ground.getAt ops.unit r 0) with
    | false =>
      intro h
      nomatch (show some 0 = (none : Option Nat) from h)
    | true =>
      cases hf : findPivO ops u rows with
      | some j =>
        intro h
        nomatch (show some (j + 1) = (none : Option Nat) from h)
      | none =>
        intro _
        match a with
        | 0 => exact hu
        | c + 1 =>
          exact findPivO_none ops u rows hf c
            (Nat.lt_of_succ_lt_succ ha)

/-- A key of both rows: the step's arithmetic read whole, the
exact cofactor at Sylvester's numerator. -/
private def jointEntryO {γ : Type} {ops : DOps γ}
    {ov : γ → γ → Prop} (Cf : DCof γ ops ov)
    (prev pivot t r0 e : γ) : γ :=
  Cf.cof (ops.add (ops.mul pivot e) (ops.swap (ops.mul r0 t))) prev

/-- The step's row: Sylvester's numerator against the prior
pivot's cofactor, one entry per key of the two tails. -/
private def browO {γ : Type} {ops : DOps γ} {ov : γ → γ → Prop}
    (Cf : DCof γ ops ov) (prev piv h : γ) :
    List γ → List γ → List γ
  | a :: ta, b :: tb =>
    jointEntryO Cf prev piv b h a :: browO Cf prev piv h ta tb
  | [], _ => []
  | _ :: _, [] => []

/-- The step's row reads the two tails' own count. -/
private theorem browO_len {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (Cf : DCof γ ops R.rel) :
    ∀ (prev piv h : γ) (ta tb : List γ), ta.length = tb.length →
    (browO Cf prev piv h ta tb).length = ta.length
  | _, _, _, [], _, _ => rfl
  | _, _, _, _ :: _, [], hl => Nat.noConfusion hl
  | prev, piv, h, _ :: ta, _ :: tb, hl => by
    show (browO Cf prev piv h ta tb).length + 1 = ta.length + 1
    rw [browO_len Cf prev piv h ta tb (Nat.succ.inj hl)]

/-- The step's row at a key: Sylvester's numerator against the
prior pivot's cofactor. -/
private theorem browO_entry {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (Cf : DCof γ ops R.rel) :
    ∀ (prev piv h : γ) (ta tb : List γ) (c : Nat), c < ta.length →
    ta.length = tb.length →
    ground.getAt ops.unit (browO Cf prev piv h ta tb) c
      = jointEntryO Cf prev piv (ground.getAt ops.unit tb c) h
          (ground.getAt ops.unit ta c)
  | _, _, _, [], _, _, hc, _ => absurd hc (Nat.not_lt_zero _)
  | _, _, _, _ :: _, [], _, _, hl => Nat.noConfusion hl
  | _, _, _, _ :: _, _ :: _, 0, _, _ => rfl
  | prev, piv, h, _ :: ta, _ :: tb, c + 1, hc, hl => by
    show ground.getAt ops.unit (browO Cf prev piv h ta tb) c = _
    rw [browO_entry Cf prev piv h ta tb c
      (Nat.lt_of_succ_lt_succ hc) (Nat.succ.inj hl)]
    rfl

/-- The descent's walk at a fuel, the accumulated exchange parity,
the prior pivot and the current block: the vacant block reads the
graded one, a lone row its own leading entry graded, and a wider
block pivots at its first test-failing leading entry, the pivot
row moved to the front and every further row stepped through the
exact cofactor, with a pivot-free leading column reading the sum's
unit outright. -/
private def detDGoO {γ : Type} {ops : DOps γ} {ov : γ → γ → Prop}
    (Cf : DCof γ ops ov) : Nat → Bool → γ → List (List γ) → γ
  | _, _, _, [] => ops.one
  | _ + 1, s, _, [r] => signAtO ops s (ground.getAt ops.unit r 0)
  | fuel + 1, s, prev, r :: r' :: rest =>
    match findPivO ops Cf.unitB (r :: r' :: rest) with
    | none => ops.unit
    | some i =>
      let rows := r :: r' :: rest
      let r0 := ground.getAt [] rows i
      let piv := ground.getAt ops.unit r0 0
      let r0t := r0.drop 1
      detDGoO Cf fuel (Bool.xor s (places.parityOf i)) piv
        ((rows.eraseIdx i).map (fun ri =>
          browO Cf prev piv (ground.getAt ops.unit ri 0)
            (ri.drop 1) r0t))
  | 0, _, _, _ :: _ => ops.unit

/-- The descent's determinant at the bundle: the walk at the row
count, seeded at the vacant leading minor's own value. -/
private def detDO {γ : Type} {ops : DOps γ} {ov : γ → γ → Prop}
    (Cf : DCof γ ops ov) (m : List (List γ)) : γ :=
  detDGoO Cf m.length false ops.one m

/-! The walk's kit at the bundle: the pointwise assembly, the
vector reads, the null pairings, the cancellation at an off-unit
factor, and the graded coefficient reads. -/

/-- Two lists of one length reading one value at every place read
one value whole. -/
private theorem lovOfBoundedO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) :
    ∀ (u v : List γ), u.length = v.length →
    (∀ i, i < u.length →
      R.rel (ground.getAt ops.unit u i) (ground.getAt ops.unit v i)) →
    poly.listOV ops R u v
  | [], [], _, _ => trivial
  | [], _ :: _, hl, _ => nomatch hl
  | _ :: _, [], hl, _ => nomatch hl
  | _ :: u, _ :: v, hl, h =>
    ⟨h 0 (Nat.succ_pos _),
     lovOfBoundedO C u v (Nat.succ.inj hl)
       (fun i hi => h (i + 1) (Nat.succ_lt_succ hi))⟩

/-- A unit tail at bounded per-key unit reads. -/
private theorem utOfBoundedO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) :
    ∀ u : List γ,
    (∀ i, i < u.length →
      R.rel (ground.getAt ops.unit u i) ops.unit) →
    poly.unitTailO ops R u
  | [], _ => trivial
  | _ :: u, h =>
    ⟨h 0 (Nat.succ_pos _),
     utOfBoundedO C u (fun i hi => h (i + 1) (Nat.succ_lt_succ hi))⟩

/-- A unit tail crosses one value memberwise. -/
private theorem utTransferO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) {q r : List γ}
    (h : poly.listOV ops R q r) (hq : poly.unitTailO ops R q) :
    poly.unitTailO ops R r :=
  utOfGetAt (fun k =>
    C.ovTrans (C.ovSymm (lovGetAt C h k)) (utGetAt C hq k))


/-- An off-unit factor's product at the sum's unit puts the other
factor there. -/
private theorem mulCancelUnitO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (Cf : DCof γ ops R.rel) {x y : γ} (hx : ¬ R.rel x ops.unit)
    (h : R.rel (ops.mul x y) ops.unit) : R.rel y ops.unit :=
  Cf.mulCancel hx (L.ovTrans h (L.ovSymm (L.mulUnit x)))

/-- A memberwise sum at the unit tail reads the second summand as
the first's balance partner. -/
private theorem swapOfNullAddO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ∀ (a b : List γ), a.length = b.length →
    poly.unitTailO ops R (vecAddO ops a b) →
    poly.listOV ops R b (a.map ops.swap)
  | [], [], _, _ => trivial
  | [], _ :: _, hl, _ => nomatch hl
  | _ :: _, [], hl, _ => nomatch hl
  | x :: a, _ :: b, hl, h =>
    ⟨L.addCancel
        (L.ovTrans h.1 (L.ovSymm (annihDerived L x)))
        (L.ovRefl x),
     swapOfNullAddO L a b (Nat.succ.inj hl) h.2⟩


/-- The joined coefficient's combination splits at the joined
row's clearing. -/
private theorem comboO_append_one {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) (n : Nat) :
    ∀ (cs : List γ) (c : γ) (M : List (List γ)) (v : List γ),
    cs.length = M.length → rowsLen n M → v.length = n →
    poly.listOV ops R (comboO ops n (cs ++ [c]) (M ++ [v]))
      (vecAddO ops (comboO ops n cs M) (vecScaleO ops c v))
  | [], c, [], v, _, _, hv => by
    show poly.listOV ops R
      (vecAddO ops (vecScaleO ops c v) (List.replicate n ops.unit))
      (vecAddO ops (List.replicate n ops.unit) (vecScaleO ops c v))
    refine lovOfBoundedO L.toDCore _ _ ?_ ?_
    · rw [length_vecAddO ops _ _ n
          (by rw [length_vecScaleO, hv])
          (ground.length_replicate ops.unit n),
        length_vecAddO ops _ _ n
          (ground.length_replicate ops.unit n)
          (by rw [length_vecScaleO, hv])]
    · intro i hi
      rw [length_vecAddO ops _ _ n
          (by rw [length_vecScaleO, hv])
          (ground.length_replicate ops.unit n)] at hi
      rw [getAt_vecAddO ops _ _ i
          (by rw [length_vecScaleO, hv]; exact hi)
          (by rw [ground.length_replicate ops.unit n]; exact hi),
        getAt_vecAddO ops _ _ i
          (by rw [ground.length_replicate ops.unit n]; exact hi)
          (by rw [length_vecScaleO, hv]; exact hi)]
      exact L.addComm _ _
  | [], _, _ :: _, _, hcl, _, _ => nomatch hcl
  | _ :: _, _, [], _, hcl, _, _ => nomatch hcl
  | c' :: cs, c, r :: M, v, hcl, hM, hv => by
    have hIH := comboO_append_one L n cs c M v
      (Nat.succ.inj hcl) hM.2 hv
    have hMv : rowsLen n (M ++ [v]) := by
      refine rowsLen_intro (M ++ [v]) (fun p hp => ?_)
      rw [ground.length_append] at hp
      rw [ground.getAt_append ([] : List γ) M [v] p]
      match Nat.lt_or_ge p M.length with
      | .inl hpM =>
        rw [if_pos hpM]
        exact rowsLen_getAt M p hM.2 hpM
      | .inr hge =>
        rw [if_neg (fun hlt =>
            Nat.lt_irrefl p (Nat.lt_of_lt_of_le hlt hge)),
          show p = M.length from
            Nat.le_antisymm (Nat.le_of_lt_succ hp) hge,
          Nat.sub_self]
        exact hv
    have hl1 : (comboO ops n (cs ++ [c]) (M ++ [v])).length = n :=
      length_comboO ops n _ _ hMv
    show poly.listOV ops R
      (vecAddO ops (vecScaleO ops c' r)
        (comboO ops n (cs ++ [c]) (M ++ [v])))
      (vecAddO ops
        (vecAddO ops (vecScaleO ops c' r) (comboO ops n cs M))
        (vecScaleO ops c v))
    refine lovOfBoundedO L.toDCore _ _ ?_ ?_
    · rw [length_vecAddO ops _ _ n
          (by rw [length_vecScaleO, hM.1]) hl1,
        length_vecAddO ops _ _ n
          (length_vecAddO ops _ _ n
            (by rw [length_vecScaleO, hM.1])
            (length_comboO ops n cs M hM.2))
          (by rw [length_vecScaleO, hv])]
    · intro i hi
      rw [length_vecAddO ops _ _ n
          (by rw [length_vecScaleO, hM.1]) hl1] at hi
      have h1 : i < (vecScaleO ops c' r).length := by
        rw [length_vecScaleO, hM.1]; exact hi
      have h2 : i < (comboO ops n cs M).length := by
        rw [length_comboO ops n cs M hM.2]; exact hi
      have h3 : i < (vecScaleO ops c v).length := by
        rw [length_vecScaleO, hv]; exact hi
      have h4 : i < (comboO ops n (cs ++ [c]) (M ++ [v])).length := by
        rw [hl1]; exact hi
      rw [getAt_vecAddO ops _ _ i h1 h4,
        getAt_vecAddO ops _ _ i
          (by
            rw [length_vecAddO ops _ _ n
              (by rw [length_vecScaleO, hM.1])
              (length_comboO ops n cs M hM.2)]
            exact hi)
          h3,
        getAt_vecAddO ops _ _ i h1 h2]
      refine L.ovTrans
        (L.addCongr (L.ovRefl _) (lovGetAt L.toDCore hIH i)) ?_
      rw [getAt_vecAddO ops _ _ i h2 h3]
      exact L.ovSymm (L.addAssoc _ _ _)

/-- The width's unit family reads its balance partners
memberwise. -/
private theorem replUnitSwapO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) :
    ∀ n : Nat, poly.listOV ops R (List.replicate n ops.unit)
      ((List.replicate n ops.unit).map ops.swap)
  | 0 => trivial
  | n + 1 =>
    ⟨C.ovSymm C.swapUnit, replUnitSwapO C n⟩

/-- A swapped scalar's clearing reads the clearing's balance
partner memberwise. -/
private theorem vecScaleO_swapMap {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) (c : γ) :
    ∀ r : List γ, poly.listOV ops R (vecScaleO ops (ops.swap c) r)
      ((vecScaleO ops c r).map ops.swap)
  | [] => trivial
  | x :: r => ⟨mulSwapLeft C c x, vecScaleO_swapMap C c r⟩

/-- The memberwise sum of two balance partners is the sum's own
partner. -/
private theorem vecAddO_swapMap {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) :
    ∀ (a b : List γ),
    poly.listOV ops R (vecAddO ops (a.map ops.swap) (b.map ops.swap))
      ((vecAddO ops a b).map ops.swap)
  | [], _ => trivial
  | _ :: _, [] => trivial
  | x :: a, y :: b =>
    ⟨C.ovSymm (C.swapAdd x y), vecAddO_swapMap C a b⟩

/-- The memberwise sum's width at width-matched slot pairs. -/
private theorem length_vecAddO_congr {γ : Type} (ops : DOps γ) :
    ∀ (u u' w w' : List γ), u.length = u'.length →
    w.length = w'.length →
    (vecAddO ops u w).length = (vecAddO ops u' w').length
  | [], [], _, _, _, _ => rfl
  | [], _ :: _, _, _, hu, _ => nomatch hu
  | _ :: _, [], _, _, hu, _ => nomatch hu
  | _ :: _, _ :: _, [], [], _, _ => rfl
  | _ :: _, _ :: _, [], _ :: _, _, hw => nomatch hw
  | _ :: _, _ :: _, _ :: _, [], _, hw => nomatch hw
  | _ :: u, _ :: u', _ :: w, _ :: w', hu, hw => by
    show (vecAddO ops u w).length + 1
      = (vecAddO ops u' w').length + 1
    rw [length_vecAddO_congr ops u u' w w' (Nat.succ.inj hu)
      (Nat.succ.inj hw)]

/-- The memberwise sum's congruence at width-matched slot
pairs. -/
private theorem vecAddO_lovCongr {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) :
    ∀ {u u' w w' : List γ}, u.length = u'.length →
    w.length = w'.length → poly.listOV ops R u u' →
    poly.listOV ops R w w' →
    poly.listOV ops R (vecAddO ops u w) (vecAddO ops u' w')
  | [], [], _, _, _, _, _, _ => trivial
  | [], _ :: _, _, _, hu, _, _, _ => nomatch hu
  | _ :: _, [], _, _, hu, _, _, _ => nomatch hu
  | _ :: _, _ :: _, [], [], _, _, _, _ => trivial
  | _ :: _, _ :: _, [], _ :: _, _, hw, _, _ => nomatch hw
  | _ :: _, _ :: _, _ :: _, [], _, hw, _, _ => nomatch hw
  | _ :: _, _ :: _, _ :: _, _ :: _, hu, hw, hlu, hlw =>
    ⟨C.addCongr hlu.1 hlw.1,
     vecAddO_lovCongr C (Nat.succ.inj hu) (Nat.succ.inj hw)
       hlu.2 hlw.2⟩

/-- The combination's width is blind to a memberwise map of the
coefficients. -/
private theorem length_comboO_mapCoef {γ : Type} (ops : DOps γ)
    (n : Nat) (f : γ → γ) :
    ∀ (cs : List γ) (M : List (List γ)),
    (comboO ops n (cs.map f) M).length
      = (comboO ops n cs M).length
  | [], _ => rfl
  | _ :: _, [] => rfl
  | c :: cs, r :: M => by
    show (vecAddO ops (vecScaleO ops (f c) r)
        (comboO ops n (cs.map f) M)).length
      = (vecAddO ops (vecScaleO ops c r)
        (comboO ops n cs M)).length
    exact length_vecAddO_congr ops _ _ _ _
      (by rw [length_vecScaleO, length_vecScaleO])
      (length_comboO_mapCoef ops n f cs M)

/-- The swapped coefficients' combination reads the combination's
balance partner memberwise. -/
private theorem comboO_swapMap {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) (n : Nat) :
    ∀ (cs : List γ) (M : List (List γ)),
    poly.listOV ops R (comboO ops n (cs.map ops.swap) M)
      ((comboO ops n cs M).map ops.swap)
  | [], _ => replUnitSwapO C n
  | _ :: _, [] => replUnitSwapO C n
  | c :: cs, r :: M => by
    show poly.listOV ops R
      (vecAddO ops (vecScaleO ops (ops.swap c) r)
        (comboO ops n (cs.map ops.swap) M))
      ((vecAddO ops (vecScaleO ops c r) (comboO ops n cs M)).map
        ops.swap)
    refine lovTrans C
      (vecAddO_lovCongr C
        (by rw [length_vecScaleO, ground.length_map,
          length_vecScaleO])
        (by
          rw [length_comboO_mapCoef ops n ops.swap cs M,
            ground.length_map])
        (vecScaleO_swapMap C c r) (comboO_swapMap C n cs M)) ?_
    exact vecAddO_swapMap C (vecScaleO ops c r) (comboO ops n cs M)


/-! The bordered sublists at an exchanged list, at the bundle:
the congruences at agreeing rows, the pivot's own bordered sublist
as the next leading one, the full key range's read, and the stall
clause's shared cofactor family over the leading columns. -/

/-- The bordered sublist at agreeing rows: the leading rows read
back and the border rows matched, the two sublists one list. -/
private theorem borderAtO_congr {γ : Type} (ops : DOps γ)
    (k x y j : Nat) (m1 m2 : List (List γ))
    (hlead : ∀ a, a < k →
      ground.getAt [] m1 a = ground.getAt [] m2 a)
    (hb : ground.getAt [] m1 x = ground.getAt [] m2 y) :
    borderAtO ops k x j m1 = borderAtO ops k y j m2 := by
  refine ground.getAt_ext [] _ _
    (by rw [borderAtO_len, borderAtO_len]) ?_
  intro a ha
  rw [borderAtO_len] at ha
  rw [borderAtO_row ops k x j m1 a ha,
    borderAtO_row ops k y j m2 a ha]
  by_cases hak : a < k
  · rw [if_pos hak, if_pos hak, hlead a hak]
  · rw [if_neg hak, if_neg hak, hb]

/-- The leading sublist at agreeing rows is one list. -/
private theorem leadAtO_congr {γ : Type} (ops : DOps γ) (k : Nat)
    (m1 m2 : List (List γ))
    (hlead : ∀ a, a < k →
      ground.getAt [] m1 a = ground.getAt [] m2 a) :
    leadAtO ops k m1 = leadAtO ops k m2 := by
  show (List.range k).map (fun a =>
      keepColsO ops (List.range k) (ground.getAt [] m1 a))
    = (List.range k).map (fun a =>
      keepColsO ops (List.range k) (ground.getAt [] m2 a))
  exact ground.map_congr_members _ _ (List.range k)
    (fun a ha => by rw [hlead a (ground.ltOfMem ha)])

/-- The pivot's own bordered sublist is the next leading one. -/
private theorem borderAtO_diag {γ : Type} (ops : DOps γ) (k : Nat)
    (m : List (List γ)) :
    borderAtO ops k k k m = leadAtO ops (k + 1) m := by
  show ((List.range k) ++ [k]).map (fun a =>
      keepColsO ops ((List.range k) ++ [k]) (ground.getAt [] m a))
    = (List.range (k + 1)).map (fun a =>
      keepColsO ops (List.range (k + 1)) (ground.getAt [] m a))
  rw [ground.range_succ k]

/-- The kept columns at the full key range read the row back. -/
private theorem keepColsO_range {γ : Type} (ops : DOps γ) (n : Nat)
    (r : List γ) (hr : r.length = n) :
    keepColsO ops (List.range n) r = r := by
  refine ground.getAt_ext ops.unit _ _
    (by rw [keepColsO_len, ground.length_range, hr]) ?_
  intro i hi
  rw [keepColsO_len, ground.length_range] at hi
  rw [keepColsO_entry ops _ _ i
      (by rw [ground.length_range]; exact hi),
    ground.getAt_range n i hi]

/-- The leading sublist at the full key count reads the list. -/
private theorem leadAtO_full {γ : Type} (ops : DOps γ)
    (m : List (List γ)) (hsq : rowsLen m.length m) :
    leadAtO ops m.length m = m := by
  refine ground.getAt_ext [] _ _ (by rw [leadAtO_len]) ?_
  intro a ha
  rw [leadAtO_len] at ha
  show ground.getAt [] ((List.range m.length).map (fun a =>
    keepColsO ops (List.range m.length) (ground.getAt [] m a))) a = _
  rw [ground.getAt_map 0 [] _ (List.range m.length) a
      (by rw [ground.length_range]; exact ha),
    ground.getAt_range m.length a ha,
    keepColsO_range ops m.length (ground.getAt [] m a)
      (rowsLen_getAt m a hsq ha)]

/-- The kept columns at a joined key list strike the joined key. -/
private theorem keepColsO_eraseIdx {γ : Type} (ops : DOps γ)
    (ks : List Nat) (x : Nat) (r : List γ) (k : Nat)
    (hk : ks.length = k) :
    (keepColsO ops (ks ++ [x]) r).eraseIdx k = keepColsO ops ks r := by
  show ((ks ++ [x]).map
      (fun j => ground.getAt ops.unit r j)).eraseIdx k = _
  rw [ground.map_append]
  exact eraseIdx_append_len _ _ k (by rw [ground.length_map, hk])

/-- The stall clause's leading rows: the leading keys' rows at the
pivot column's own key list. -/
private def leadBordO {γ : Type} (ops : DOps γ) (k : Nat)
    (m : List (List γ)) : List (List γ) :=
  (List.range k).map (fun a =>
    keepColsO ops (List.range k ++ [k]) (ground.getAt [] m a))

/-- The leading rows' count. -/
private theorem leadBordO_len {γ : Type} (ops : DOps γ) (k : Nat)
    (m : List (List γ)) : (leadBordO ops k m).length = k :=
  ground.length_mapRange _ k

/-- The bordered sublist's leading rows are the shared ones. -/
private theorem borderAtO_erase {γ : Type} (ops : DOps γ)
    (k i : Nat) (m : List (List γ)) :
    (borderAtO ops k i k m).eraseIdx k = leadBordO ops k m := by
  show (((List.range k) ++ [i]).map (fun a =>
    keepColsO ops ((List.range k) ++ [k])
      (ground.getAt [] m a))).eraseIdx k = _
  rw [ground.map_append]
  exact eraseIdx_append_len _ _ k
    (ground.length_mapRange _ _)

/-- The leading rows struck at the border key are the leading
sublist. -/
private theorem leadBordO_strike {γ : Type} (ops : DOps γ)
    (k : Nat) (m : List (List γ)) :
    (leadBordO ops k m).map (fun r => r.eraseIdx k)
      = leadAtO ops k m := by
  show ((List.range k).map (fun a =>
    keepColsO ops (List.range k ++ [k]) (ground.getAt [] m a))).map
      (fun r => r.eraseIdx k) = _
  rw [ground.map_map]
  show (List.range k).map (fun a =>
      (keepColsO ops (List.range k ++ [k])
        (ground.getAt [] m a)).eraseIdx k)
    = (List.range k).map (fun a =>
      keepColsO ops (List.range k) (ground.getAt [] m a))
  exact ground.map_congr_all _ _
    (fun a => keepColsO_eraseIdx ops (List.range k) k
      (ground.getAt [] m a) k (ground.length_range k)) (List.range k)

/-- The shared cofactor family over the leading columns. -/
private def bordFamO {γ : Type} (ops : DOps γ) (k : Nat)
    (m : List (List γ)) : List γ :=
  (List.range k).map (fun j =>
    sgnPO ops (k + j) (cof0O ops (leadBordO ops k m) j))

/-- The border row's cofactor family: the leading columns' shared
one with the border key's own coefficient at the end. -/
private def bordVecO {γ : Type} (ops : DOps γ) (k : Nat)
    (m : List (List γ)) : List γ :=
  bordFamO ops k m
    ++ [sgnPO ops (k + k) (cof0O ops (leadBordO ops k m) k)]

/-- The cofactor family's count. -/
private theorem bordFamO_len {γ : Type} (ops : DOps γ) (k : Nat)
    (m : List (List γ)) : (bordFamO ops k m).length = k :=
  ground.length_mapRange _ k

/-- The cofactor family at the key range's own map. -/
private theorem bordVecO_range {γ : Type} (ops : DOps γ) (k : Nat)
    (m : List (List γ)) :
    bordVecO ops k m = (List.range (k + 1)).map
      (fun j => sgnPO ops (k + j) (cof0O ops (leadBordO ops k m) j)) := by
  rw [ground.range_succ k, ground.map_append]
  rfl

/-- The bordered sublist's cofactor vector is the shared family. -/
private theorem cofVecO_bord {γ : Type} (ops : DOps γ)
    (m : List (List γ)) (k i : Nat) :
    cofVecO ops (borderAtO ops k i k m) k = bordVecO ops k m := by
  show (List.range (borderAtO ops k i k m).length).map (fun j =>
      sgnPO ops (k + j)
        (cof0O ops ((borderAtO ops k i k m).eraseIdx k) j))
    = bordVecO ops k m
  rw [borderAtO_len, borderAtO_erase, bordVecO_range]

/-- The border row's expansion: the bordered minor reads its border
row against the shared cofactor family. -/
private theorem bordO_expand {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (m : List (List γ)) (k i : Nat) :
    R.rel (detO ops (borderAtO ops k i k m))
      (dotO ops
        (keepColsO ops (List.range k ++ [k]) (ground.getAt [] m i))
        (bordVecO ops k m)) := by
  have hkB : k < (borderAtO ops k i k m).length := by
    rw [borderAtO_len]
    exact Nat.lt_succ_self k
  have hrow : ground.getAt [] (borderAtO ops k i k m) k
      = keepColsO ops (List.range k ++ [k])
        (ground.getAt [] m i) := by
    rw [borderAtO_row ops k i k m k (Nat.lt_succ_self k),
      if_neg (Nat.lt_irrefl k)]
  have hb : (ground.getAt [] (borderAtO ops k i k m) k).length
      = (borderAtO ops k i k m).length := by
    rw [hrow, keepColsO_len, borderKeys_len, borderAtO_len]
  have h1 := detO_List.set_dot L (borderAtO ops k i k m) k hkB
    (ground.getAt [] (borderAtO ops k i k m) k) hb
  rw [ground.set_self ([] : List γ) (borderAtO ops k i k m) k hkB,
    cofVecO_bord ops m k i, hrow] at h1
  exact h1

/-- The border key's coefficient sits off the sum's unit where the
leading minor does. -/
private theorem bordVecO_last_off {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel)
    (m : List (List γ)) (k : Nat)
    (hP : ¬ R.rel (detO ops (leadAtO ops k m)) ops.unit) :
    ¬ R.rel (ground.getAt ops.unit (bordVecO ops k m) k)
      ops.unit := by
  have hlast := cof0O_last C (leadBordO ops k m)
  rw [leadBordO_len, leadBordO_strike] at hlast
  have hget : ground.getAt ops.unit (bordVecO ops k m) k
      = sgnPO ops (k + k) (cof0O ops (leadBordO ops k m) k) := by
    show ground.getAt ops.unit
      (bordFamO ops k m
        ++ [sgnPO ops (k + k) (cof0O ops (leadBordO ops k m) k)]) k
      = _
    rw [ground.getAt_append ops.unit (bordFamO ops k m) _ k,
      bordFamO_len, if_neg (Nat.lt_irrefl k),
      show k - k = 0 from Nat.sub_self k]
    rfl
  rw [hget]
  intro hu
  exact hP (C.ovTrans (C.ovSymm hlast) (sgnPO_unit C hu))

/-- The pivot column's leading columns, read as the transposed
list's leading rows. -/
private def colRowsO {γ : Type} (ops : DOps γ) (k : Nat)
    (m : List (List γ)) : List (List γ) :=
  (List.range k).map (fun j => ground.getAt [] (transposeO ops m) j)

/-- The leading columns' count. -/
private theorem colRowsO_len {γ : Type} (ops : DOps γ) (k : Nat)
    (m : List (List γ)) : (colRowsO ops k m).length = k :=
  ground.length_mapRange _ k

/-- The leading columns' entry read. -/
private theorem colRowsO_getAt {γ : Type} (ops : DOps γ) (k : Nat)
    (m : List (List γ)) (i : Nat) (hi : i < k) :
    ground.getAt [] (colRowsO ops k m) i
      = ground.getAt [] (transposeO ops m) i := by
  show ground.getAt [] ((List.range k).map
    (fun j => ground.getAt [] (transposeO ops m) j)) i = _
  rw [ground.getAt_map 0 [] _ (List.range k) i
      (by rw [ground.length_range]; exact hi),
    ground.getAt_range k i hi]

/-- The leading columns grow at the pivot's own key. -/
private theorem colRowsO_succ {γ : Type} (ops : DOps γ) (k : Nat)
    (m : List (List γ)) :
    colRowsO ops (k + 1) m
      = colRowsO ops k m ++ [ground.getAt [] (transposeO ops m) k] := by
  show (List.range (k + 1)).map
    (fun j => ground.getAt [] (transposeO ops m) j) = _
  rw [ground.range_succ k, ground.map_append]
  rfl

/-- The leading columns' width, the transposed list's own. -/
private theorem colRowsO_rows {γ : Type} (ops : DOps γ) (k : Nat)
    (m : List (List γ)) (hsq : rowsLen m.length m)
    (hkm : k ≤ m.length) :
    rowsLen m.length (colRowsO ops k m) := by
  refine rowsLen_intro (colRowsO ops k m) (fun i hi => ?_)
  rw [colRowsO_len] at hi
  rw [colRowsO_getAt ops k m i hi]
  exact rowsLen_getAt (transposeO ops m) i (rowsLen_transposeO ops m)
    (by
      rw [length_transposeO ops m hsq
        (Nat.lt_of_le_of_lt (Nat.zero_le i)
          (Nat.lt_of_lt_of_le hi hkm))]
      exact Nat.lt_of_lt_of_le hi hkm)

/-- The stall clause (`def:elim`) at the bundle: at a pivot column
whose every bordered minor reads the sum's unit the determinant
reads it too, the leading minor off the unit — the bordered
minors' shared cofactor family clearing the pivot column against
the leading ones, and every summand of the cleared expansion a
repeated column key. -/
private theorem stall_unitO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (Cf : DCof γ ops R.rel)
    (m : List (List γ)) (hsq : rowsLen m.length m)
    (k : Nat) (hk : k < m.length)
    (hP : ¬ R.rel (detO ops (leadAtO ops k m)) ops.unit)
    (hB : ∀ i, k ≤ i → i < m.length →
      R.rel (detO ops (borderAtO ops k i k m)) ops.unit) :
    R.rel (detO ops m) ops.unit := by
  have hall : ∀ i, i < m.length →
      R.rel (detO ops (borderAtO ops k i k m)) ops.unit := by
    intro i hi
    match Nat.lt_or_ge i k with
    | .inr hik => exact hB i hik hi
    | .inl hik =>
      refine detO_rows_equal L (m := borderAtO ops k i k m) hik
        (by rw [borderAtO_len]; exact Nat.lt_succ_self k) ?_
      rw [borderAtO_row ops k i k m i
          (Nat.lt_trans hik (Nat.lt_succ_self k)),
        borderAtO_row ops k i k m k (Nat.lt_succ_self k),
        if_pos hik, if_neg (Nat.lt_irrefl k)]
  have hpos : 0 < m.length := Nat.lt_of_le_of_lt (Nat.zero_le k) hk
  have hMl : (transposeO ops m).length = m.length :=
    length_transposeO ops m hsq hpos
  have hMrow : ∀ j, j < m.length →
      (ground.getAt [] (transposeO ops m) j).length = m.length :=
    fun j hj => rowsLen_getAt (transposeO ops m) j
      (rowsLen_transposeO ops m) (by rw [hMl]; exact hj)
  have hkM : k < (transposeO ops m).length := by
    rw [hMl]
    exact hk
  have hcr1 : rowsLen m.length (colRowsO ops (k + 1) m) :=
    colRowsO_rows ops (k + 1) m hsq hk
  have hcr0 : rowsLen m.length (colRowsO ops k m) :=
    colRowsO_rows ops k m hsq (Nat.le_of_lt hk)
  have hnull : ∀ i, i < m.length →
      R.rel (ground.getAt ops.unit
        (comboO ops m.length (bordVecO ops k m)
          (colRowsO ops (k + 1) m)) i) ops.unit := by
    intro i hi
    have hmap : (colRowsO ops (k + 1) m).map
        (fun r => ground.getAt ops.unit r i)
      = keepColsO ops (List.range k ++ [k])
          (ground.getAt [] m i) := by
      show ((List.range (k + 1)).map
          (fun j => ground.getAt [] (transposeO ops m) j)).map
          (fun r => ground.getAt ops.unit r i)
        = (List.range k ++ [k]).map
          (fun j => ground.getAt ops.unit (ground.getAt [] m i) j)
      rw [ground.map_map, ← ground.range_succ k]
      refine ground.map_congr_members _ _ (List.range (k + 1))
        (fun j hj => ?_)
      have hjk : j < k + 1 := ground.ltOfMem hj
      exact getAt_transposeO ops ops.unit m hsq j i
        (Nat.lt_of_le_of_lt (Nat.le_of_lt_succ hjk) hk) hi
    refine L.ovTrans
      (comboO_getAt L m.length (bordVecO ops k m)
        (colRowsO ops (k + 1) m) i hcr1 hi) ?_
    rw [hmap]
    refine L.ovTrans (dotO_comm L.toDCore _ _) ?_
    exact L.ovTrans (L.ovSymm (bordO_expand L m k i)) (hall i hi)
  have hwl : (ground.getAt [] (transposeO ops m) k).length
      = m.length := hMrow k hk
  have hsplit := comboO_append_one L m.length (bordFamO ops k m)
    (sgnPO ops (k + k) (cof0O ops (leadBordO ops k m) k))
    (colRowsO ops k m)
    (ground.getAt [] (transposeO ops m) k)
    (by rw [bordFamO_len, colRowsO_len]) hcr0 hwl
  rw [← colRowsO_succ ops k m] at hsplit
  have hutX : poly.unitTailO ops R
      (comboO ops m.length (bordVecO ops k m)
        (colRowsO ops (k + 1) m)) :=
    utOfBoundedO L.toDCore _ (fun p hp => by
      rw [length_comboO ops m.length _ _ hcr1] at hp
      exact hnull p hp)
  have hut : poly.unitTailO ops R
      (vecAddO ops (comboO ops m.length (bordFamO ops k m)
          (colRowsO ops k m))
        (vecScaleO ops
          (sgnPO ops (k + k) (cof0O ops (leadBordO ops k m) k))
          (ground.getAt [] (transposeO ops m) k))) :=
    utTransferO L.toDCore hsplit hutX
  have hcl := swapOfNullAddO L
    (comboO ops m.length (bordFamO ops k m) (colRowsO ops k m))
    (vecScaleO ops
      (sgnPO ops (k + k) (cof0O ops (leadBordO ops k m) k))
      (ground.getAt [] (transposeO ops m) k))
    (by
      rw [length_comboO ops m.length _ _ hcr0, length_vecScaleO,
        hwl])
    hut
  have hcl2 := lovTrans L.toDCore hcl
    (lovSymm L.toDCore
      (comboO_swapMap L.toDCore m.length (bordFamO ops k m)
        (colRowsO ops k m)))
  have hclen : (vecScaleO ops
      (sgnPO ops (k + k) (cof0O ops (leadBordO ops k m) k))
      (ground.getAt [] (transposeO ops m) k)).length
      = (transposeO ops m).length := by
    rw [length_vecScaleO, hwl, hMl]
  have hcomlen : (comboO ops m.length
      ((bordFamO ops k m).map ops.swap)
      (colRowsO ops k m)).length = (transposeO ops m).length := by
    rw [length_comboO ops m.length _ _ hcr0, hMl]
  have hd1 : R.rel (detO ops (List.set (transposeO ops m) k
      (vecScaleO ops
        (sgnPO ops (k + k) (cof0O ops (leadBordO ops k m) k))
        (ground.getAt [] (transposeO ops m) k))))
      (ops.mul (sgnPO ops (k + k) (cof0O ops (leadBordO ops k m) k))
        (detO ops (transposeO ops m))) := by
    refine L.ovTrans
      (detO_List.set_dot L (transposeO ops m) k hkM _ hclen) ?_
    refine L.ovTrans (dotO_vecScale_left L _ _ _) ?_
    exact L.mulCongr (L.ovRefl _)
      (cofVecO_diag L (transposeO ops m) k hkM
        (by rw [hMl]; exact hwl))
  have hd2 : R.rel (detO ops (List.set (transposeO ops m) k
      (vecScaleO ops
        (sgnPO ops (k + k) (cof0O ops (leadBordO ops k m) k))
        (ground.getAt [] (transposeO ops m) k))))
      (detO ops (List.set (transposeO ops m) k
        (comboO ops m.length ((bordFamO ops k m).map ops.swap)
          (colRowsO ops k m)))) := by
    refine L.ovTrans
      (detO_List.set_dot L (transposeO ops m) k hkM _ hclen) ?_
    refine L.ovTrans (dotO_comm L.toDCore _ _) ?_
    refine L.ovTrans
      (dotO_congr_right L (cofVecO ops (transposeO ops m) k) _ _
        (by rw [hclen, hcomlen])
        (fun p _ => lovGetAt L.toDCore hcl2 p)) ?_
    refine L.ovTrans (dotO_comm L.toDCore _ _) ?_
    exact L.ovSymm
      (detO_List.set_dot L (transposeO ops m) k hkM _ hcomlen)
  have hd3 : R.rel (detO ops (List.set (transposeO ops m) k
      (comboO ops m.length ((bordFamO ops k m).map ops.swap)
        (colRowsO ops k m)))) ops.unit := by
    have hcomb := detO_List.set_combo L (transposeO ops m) k hkM
      ((bordFamO ops k m).map ops.swap) (colRowsO ops k m)
      (by rw [hMl]; exact hcr0)
    rw [hMl] at hcomb
    refine L.ovTrans hcomb ?_
    refine dotO_null_right L _ _ (fun p hp => ?_)
    rw [ground.length_map, colRowsO_len] at hp
    rw [ground.getAt_map ([] : List γ) ops.unit
      (fun row => detO ops (List.set (transposeO ops m) k row))
      (colRowsO ops k m) p (by rw [colRowsO_len]; exact hp),
      colRowsO_getAt ops k m p hp]
    refine detO_rows_equal L
      (m := List.set (transposeO ops m) k
        (ground.getAt [] (transposeO ops m) p)) hp
      (by rw [ground.length_set]; exact hkM) ?_
    rw [ground.getAt_set_ne [] (transposeO ops m) k p _
        (Nat.ne_of_lt hp),
      ground.getAt_set_self [] (ground.getAt [] (transposeO ops m) p)
        (transposeO ops m) k hkM]
  have hfin : R.rel (ops.mul
      (sgnPO ops (k + k) (cof0O ops (leadBordO ops k m) k))
      (detO ops (transposeO ops m))) ops.unit :=
    L.ovTrans (L.ovSymm hd1) (L.ovTrans hd2 hd3)
  have hoff : ¬ R.rel (sgnPO ops (k + k)
      (cof0O ops (leadBordO ops k m) k)) ops.unit := by
    have h := bordVecO_last_off L.toDCore m k hP
    have hget : ground.getAt ops.unit (bordVecO ops k m) k
        = sgnPO ops (k + k) (cof0O ops (leadBordO ops k m) k) := by
      show ground.getAt ops.unit
        (bordFamO ops k m
          ++ [sgnPO ops (k + k)
            (cof0O ops (leadBordO ops k m) k)]) k = _
      rw [ground.getAt_append ops.unit (bordFamO ops k m) _ k,
        bordFamO_len, if_neg (Nat.lt_irrefl k),
        show k - k = 0 from Nat.sub_self k]
      rfl
    rw [hget] at h
    exact h
  have hMdet : R.rel (detO ops (transposeO ops m)) ops.unit :=
    mulCancelUnitO L Cf hoff hfin
  exact L.ovTrans
    (L.ovSymm (detO_transpose L.toDCore m hsq)) hMdet

/-- The descent's walk reads the assignment fold at the bundle:
the block's entries the bordered minors of an exchanged list, the
prior pivot its leading minor off the sum's unit, and the
accumulated parity carrying the exchanges — each step Sylvester's
identity divided at the prior pivot, a pivot-free column the stall
clause. -/
private theorem detDGo_eqO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (Cf : DCof γ ops R.rel) :
    ∀ (fuel : Nat) (s : Bool) (prev : γ)
      (block : List (List γ))
      (k : Nat) (m m' : List (List γ)),
      rowsLen m'.length m' →
      m'.length = m.length →
      R.rel (detO ops m') (signAtO ops s (detO ops m)) →
      k + block.length = m.length →
      fuel = block.length →
      rowsLen block.length block →
      R.rel prev (detO ops (leadAtO ops k m')) →
      ¬ R.rel prev ops.unit →
      (∀ a b, a < block.length → b < block.length →
        R.rel (ground.getAt ops.unit
          (ground.getAt [] block a) b)
          (detO ops (borderAtO ops k (k + a) (k + b) m'))) →
      (block = [] → R.rel ops.one (detO ops m)) →
      R.rel (detDGoO Cf fuel s prev block) (detO ops m)
  | 0, _, _, [], _, _, _, _, _, _, _, _, _, _, _, _, hnil =>
    hnil rfl
  | _ + 1, _, _, [], _, _, _, _, _, _, _, _, _, _, _, _, hnil =>
    hnil rfl
  | 0, _, _, _ :: _, _, _, _, _, _, _, _, hfuel, _, _, _, _, _ =>
    Nat.noConfusion hfuel
  | _ + 1, s, prev, [r], k, m, m', hsq', hlen, hdet, hkn, _, _,
      _, _, hentry, _ => by
    have h1 : R.rel (ground.getAt ops.unit r 0)
        (detO ops (borderAtO ops k k k m')) :=
      hentry 0 0 (Nat.succ_pos 0) (Nat.succ_pos 0)
    have hk1 : k + 1 = m'.length := by
      rw [hlen]
      exact hkn
    rw [borderAtO_diag ops k m', hk1, leadAtO_full ops m' hsq']
      at h1
    show R.rel (signAtO ops s (ground.getAt ops.unit r 0))
      (detO ops m)
    refine L.ovTrans
      (signAtO_congr L.toDCore s (L.ovTrans h1 hdet)) ?_
    exact signAtO_signAtO L.toDCore s (detO ops m)
  | fuel + 1, s, prev, r :: r' :: rest, k, m, m', hsq', hlen,
      hdet, hkn, hfuel, hrows, hprev, hpoff, hentry, _ => by
    have hklt : k < m.length := by
      rw [← hkn]
      exact Nat.add_lt_add_left (Nat.succ_pos (rest.length + 1)) k
    have hklt' : k < m'.length := by
      rw [hlen]
      exact hklt
    show R.rel (match findPivO ops Cf.unitB (r :: r' :: rest) with
        | none => ops.unit
        | some i =>
          detDGoO Cf fuel (Bool.xor s (places.parityOf i))
            (ground.getAt ops.unit
              (ground.getAt [] (r :: r' :: rest) i) 0)
            (((r :: r' :: rest).eraseIdx i).map (fun ri =>
              browO Cf prev
                (ground.getAt ops.unit
                  (ground.getAt [] (r :: r' :: rest) i) 0)
                (ground.getAt ops.unit ri 0)
                (ri.drop 1)
                ((ground.getAt [] (r :: r' :: rest) i).drop 1))))
      (detO ops m)
    cases hfp : findPivO ops Cf.unitB (r :: r' :: rest) with
    | none =>
      have hstall : ∀ x, k ≤ x → x < m'.length →
          R.rel (detO ops (borderAtO ops k x k m')) ops.unit := by
        intro x hkx hxm
        match Nat.le.dest hkx with
        | ⟨a, hka⟩ =>
          have hab : a < (r :: r' :: rest).length :=
            Nat.lt_of_add_lt_add_left
              (show k + a < k + (r :: r' :: rest).length from by
                rw [hkn, ← hlen, hka]
                exact hxm)
          have hxu : R.rel (ground.getAt ops.unit
              (ground.getAt [] (r :: r' :: rest) a) 0)
              ops.unit :=
            Cf.unitB_true
              (findPivO_none ops Cf.unitB (r :: r' :: rest) hfp
                a hab)
          have h3 : R.rel (detO ops (borderAtO ops k (k + a) k m'))
              ops.unit :=
            L.ovTrans
              (L.ovSymm (hentry a 0 hab (Nat.succ_pos _))) hxu
          rw [hka] at h3
          exact h3
      have hPoff : ¬ R.rel (detO ops (leadAtO ops k m')) ops.unit :=
        fun hu => hpoff (L.ovTrans hprev hu)
      have hfinal := stall_unitO L Cf m' hsq' k hklt' hPoff hstall
      have h4 := signAtO_congr L.toDCore s
        (L.ovTrans (L.ovSymm hfinal) hdet)
      exact L.ovTrans (L.ovSymm (signAtO_unit L.toDCore s))
        (L.ovTrans h4 (signAtO_signAtO L.toDCore s _))
    | some i =>
      have hi := findPivO_read ops Cf.unitB (r :: r' :: rest) i hfp
      have hilt : i < (r :: r' :: rest).length := hi.1
      have hki : k + i < m'.length := by
        rw [hlen, ← hkn]
        exact Nat.add_lt_add_left hilt k
      have hml : (moveRow i k m').length = m'.length :=
        length_moveRow i k m'
      have hmsq : rowsLen (moveRow i k m').length
          (moveRow i k m') := by
        rw [hml]
        exact rowsLen_moveRow i k m' hsq'
      have hmlen : (moveRow i k m').length = m.length := by
        rw [hml, hlen]
      have hlead : ∀ a, a < k →
          ground.getAt [] (moveRow i k m') a
            = ground.getAt [] m' a :=
        fun a ha => getAt_moveRow_lt ([] : List γ) i k m' a ha hki
      have hpivrow : ground.getAt [] (moveRow i k m') k
          = ground.getAt [] m' (k + i) :=
        getAt_moveRow_self ([] : List γ) i k m' hki
      have hleadeq : leadAtO ops k (moveRow i k m')
          = leadAtO ops k m' :=
        leadAtO_congr ops k (moveRow i k m') m' hlead
      have hb0 : borderAtO ops k k k (moveRow i k m')
          = borderAtO ops k (k + i) k m' :=
        borderAtO_congr ops k k (k + i) k (moveRow i k m') m'
          hlead hpivrow
      have hpiv : R.rel (ground.getAt ops.unit
            (ground.getAt [] (r :: r' :: rest) i) 0)
          (detO ops (leadAtO ops (k + 1) (moveRow i k m'))) := by
        have h1 : R.rel (ground.getAt ops.unit
              (ground.getAt [] (r :: r' :: rest) i) 0)
            (detO ops (borderAtO ops k (k + i) k m')) :=
          hentry i 0 hilt (Nat.succ_pos _)
        rw [← hb0, borderAtO_diag] at h1
        exact h1
      have hpivoff : ¬ R.rel (ground.getAt ops.unit
            (ground.getAt [] (r :: r' :: rest) i) 0) ops.unit :=
        Cf.unitB_false hi.2
      have hdet2 : R.rel (detO ops (moveRow i k m'))
          (signAtO ops (Bool.xor s (places.parityOf i))
            (detO ops m)) :=
        L.ovTrans (detO_moveRow L.toDCore i k m' hki)
          (L.ovTrans
            (signAtO_congr L.toDCore (places.parityOf i) hdet)
            (signAtO_comp L.toDCore (places.parityOf i) s
              (detO ops m)))
      have herl : ((r :: r' :: rest).eraseIdx i).length
          = rest.length + 1 :=
        Nat.succ.inj (ground.length_eraseIdx (r :: r' :: rest) i
          hilt)
      have hblen : (((r :: r' :: rest).eraseIdx i).map (fun ri =>
          browO Cf prev (ground.getAt ops.unit
              (ground.getAt [] (r :: r' :: rest) i) 0)
            (ground.getAt ops.unit ri 0) (ri.drop 1)
            ((ground.getAt [] (r :: r' :: rest) i).drop 1))).length
          = rest.length + 1 := by
        rw [ground.length_map, herl]
      have hrowlen : ∀ x, x < (r :: r' :: rest).length →
          (ground.getAt [] (r :: r' :: rest) x).length
            = rest.length + 2 :=
        fun x hx => rowsLen_getAt (r :: r' :: rest) x hrows hx
      have hdrop : ∀ x, x < (r :: r' :: rest).length →
          ((ground.getAt [] (r :: r' :: rest) x).drop 1).length
            = rest.length + 1 := by
        intro x hx
        have h1 := length_drop1 (ground.getAt [] (r :: r' :: rest) x)
          (by rw [hrowlen x hx]; exact Nat.succ_pos _)
        rw [hrowlen x hx] at h1
        exact Nat.succ.inj h1
      have hrowl : ∀ p, p < rest.length + 1 →
          ground.getAt []
            (((r :: r' :: rest).eraseIdx i).map (fun ri =>
              browO Cf prev (ground.getAt ops.unit
                  (ground.getAt [] (r :: r' :: rest) i) 0)
                (ground.getAt ops.unit ri 0) (ri.drop 1)
                ((ground.getAt []
                  (r :: r' :: rest) i).drop 1))) p
            = browO Cf prev (ground.getAt ops.unit
                (ground.getAt [] (r :: r' :: rest) i) 0)
              (ground.getAt ops.unit
                (ground.getAt [] (r :: r' :: rest) (liftIx i p)) 0)
              ((ground.getAt [] (r :: r' :: rest)
                (liftIx i p)).drop 1)
              ((ground.getAt [] (r :: r' :: rest) i).drop 1) := by
        intro p hp
        rw [ground.getAt_map ([] : List γ) ([] : List γ)
            (fun ri => browO Cf prev (ground.getAt ops.unit
              (ground.getAt [] (r :: r' :: rest) i) 0)
              (ground.getAt ops.unit ri 0) (ri.drop 1)
              ((ground.getAt [] (r :: r' :: rest) i).drop 1))
            ((r :: r' :: rest).eraseIdx i) p
            (by rw [herl]; exact hp),
          getAt_eraseIdx_lift]
      refine detDGo_eqO L Cf fuel (Bool.xor s (places.parityOf i))
        (ground.getAt ops.unit
          (ground.getAt [] (r :: r' :: rest) i) 0)
        (((r :: r' :: rest).eraseIdx i).map (fun ri =>
          browO Cf prev (ground.getAt ops.unit
              (ground.getAt [] (r :: r' :: rest) i) 0)
            (ground.getAt ops.unit ri 0) (ri.drop 1)
            ((ground.getAt [] (r :: r' :: rest) i).drop 1)))
        (k + 1) m (moveRow i k m') hmsq hmlen hdet2 ?_ ?_ ?_
        hpiv hpivoff ?_ ?_
      · rw [hblen, addShift]
        exact hkn
      · rw [hblen]
        exact Nat.succ.inj hfuel
      · refine rowsLen_intro
          (((r :: r' :: rest).eraseIdx i).map (fun ri =>
            browO Cf prev (ground.getAt ops.unit
                (ground.getAt [] (r :: r' :: rest) i) 0)
              (ground.getAt ops.unit ri 0) (ri.drop 1)
              ((ground.getAt [] (r :: r' :: rest) i).drop 1)))
          (fun p hp => ?_)
        rw [hblen] at hp
        rw [hrowl p hp, hblen,
          browO_len Cf prev (ground.getAt ops.unit
              (ground.getAt [] (r :: r' :: rest) i) 0)
            (ground.getAt ops.unit
              (ground.getAt [] (r :: r' :: rest) (liftIx i p)) 0)
            ((ground.getAt [] (r :: r' :: rest)
              (liftIx i p)).drop 1)
            ((ground.getAt [] (r :: r' :: rest) i).drop 1)
            (by rw [hdrop _ (liftIx_lt hp), hdrop _ hilt]),
          hdrop _ (liftIx_lt hp)]
      · intro a b ha hb
        rw [hblen] at ha hb
        have hIm : k + 1 + a < m'.length := by
          rw [hlen, ← hkn, addShift]
          exact Nat.add_lt_add_left (Nat.succ_lt_succ ha) k
        have hJm : k + 1 + b < m'.length := by
          rw [hlen, ← hkn, addShift]
          exact Nat.add_lt_add_left (Nat.succ_lt_succ hb) k
        have hlifta : liftIx i a < (r :: r' :: rest).length :=
          liftIx_lt ha
        have hcol : k + 1 + b = k + (b + 1) := addShift k b
        have hrowmove : ground.getAt [] (moveRow i k m') (k + 1 + a)
            = ground.getAt [] m' (k + liftIx i a) :=
          getAt_moveRow_tail ([] : List γ) i k m' a hki hIm
        have hbA : borderAtO ops k (k + 1 + a) (k + 1 + b)
            (moveRow i k m')
            = borderAtO ops k (k + liftIx i a) (k + (b + 1)) m' := by
          rw [hcol]
          exact borderAtO_congr ops k (k + 1 + a) (k + liftIx i a)
            (k + (b + 1)) (moveRow i k m') m' hlead hrowmove
        have hbB : borderAtO ops k (k + 1 + a) k (moveRow i k m')
            = borderAtO ops k (k + liftIx i a) k m' :=
          borderAtO_congr ops k (k + 1 + a) (k + liftIx i a) k
            (moveRow i k m') m' hlead hrowmove
        have hbC : borderAtO ops k k (k + 1 + b) (moveRow i k m')
            = borderAtO ops k (k + i) (k + (b + 1)) m' := by
          rw [hcol]
          exact borderAtO_congr ops k k (k + i) (k + (b + 1))
            (moveRow i k m') m' hlead hpivrow
        have eA : R.rel (ground.getAt ops.unit
              (ground.getAt [] (r :: r' :: rest) (liftIx i a))
              (b + 1))
            (detO ops (borderAtO ops k (k + 1 + a) (k + 1 + b)
              (moveRow i k m'))) := by
          rw [hbA]
          exact hentry (liftIx i a) (b + 1) hlifta
            (Nat.succ_lt_succ hb)
        have eH : R.rel (ground.getAt ops.unit
              (ground.getAt [] (r :: r' :: rest) (liftIx i a)) 0)
            (detO ops (borderAtO ops k (k + 1 + a) k
              (moveRow i k m'))) := by
          rw [hbB]
          exact hentry (liftIx i a) 0 hlifta (Nat.succ_pos _)
        have eB : R.rel (ground.getAt ops.unit
              (ground.getAt [] (r :: r' :: rest) i) (b + 1))
            (detO ops (borderAtO ops k k (k + 1 + b)
              (moveRow i k m'))) := by
          rw [hbC]
          exact hentry i (b + 1) hilt (Nat.succ_lt_succ hb)
        have eP : R.rel (ground.getAt ops.unit
              (ground.getAt [] (r :: r' :: rest) i) 0)
            (detO ops (borderAtO ops k k k (moveRow i k m'))) := by
          rw [hb0]
          exact hentry i 0 hilt (Nat.succ_pos _)
        have hsyl := sylvesterO L (moveRow i k m') k (k + 1 + a)
          (k + 1 + b)
        have hsyl2 : R.rel (ops.add
            (ops.mul (detO ops (leadAtO ops k (moveRow i k m')))
              (detO ops (borderAtO ops (k + 1) (k + 1 + a)
                (k + 1 + b) (moveRow i k m'))))
            (ops.swap (ops.swap
              (ops.mul (detO ops (borderAtO ops k (k + 1 + a) k
                  (moveRow i k m')))
                (detO ops (borderAtO ops k k (k + 1 + b)
                  (moveRow i k m')))))))
            (ops.mul (detO ops (borderAtO ops k k k
                (moveRow i k m')))
              (detO ops (borderAtO ops k (k + 1 + a) (k + 1 + b)
                (moveRow i k m')))) :=
          L.ovTrans
            (L.addCongr (L.ovRefl _)
              (L.toDCore.swapSwap _)) hsyl
        have hprod := L.ovSymm (swapMoveO L hsyl2)
        have hprev' : R.rel prev
            (detO ops (leadAtO ops k (moveRow i k m'))) := by
          rw [hleadeq]
          exact hprev
        have hEN : R.rel (ops.add
            (ops.mul (ground.getAt ops.unit
                (ground.getAt [] (r :: r' :: rest) i) 0)
              (ground.getAt ops.unit
                (ground.getAt [] (r :: r' :: rest) (liftIx i a))
                (b + 1)))
            (ops.swap (ops.mul
              (ground.getAt ops.unit
                (ground.getAt [] (r :: r' :: rest) (liftIx i a)) 0)
              (ground.getAt ops.unit
                (ground.getAt [] (r :: r' :: rest) i) (b + 1)))))
            (ops.add
              (ops.mul (detO ops (borderAtO ops k k k
                  (moveRow i k m')))
                (detO ops (borderAtO ops k (k + 1 + a) (k + 1 + b)
                  (moveRow i k m'))))
              (ops.swap (ops.mul
                (detO ops (borderAtO ops k (k + 1 + a) k
                  (moveRow i k m')))
                (detO ops (borderAtO ops k k (k + 1 + b)
                  (moveRow i k m')))))) :=
          L.addCongr (L.mulCongr eP eA)
            (L.toDCore.swapCongr (L.mulCongr eH eB))
        have hE := L.ovTrans
          (L.mulCongr hprev'
            (L.ovRefl
              (detO ops (borderAtO ops (k + 1) (k + 1 + a)
                (k + 1 + b) (moveRow i k m')))))
          (L.ovTrans hprod (L.ovSymm hEN))
        have hsound := Cf.cofSound hpoff hE
        have hcancel := Cf.mulCancel hpoff
          (L.ovTrans hsound (L.ovSymm hE))
        rw [hrowl a ha, browO_entry Cf prev
            (ground.getAt ops.unit
              (ground.getAt [] (r :: r' :: rest) i) 0)
            (ground.getAt ops.unit
              (ground.getAt [] (r :: r' :: rest) (liftIx i a)) 0)
            ((ground.getAt [] (r :: r' :: rest)
              (liftIx i a)).drop 1)
            ((ground.getAt [] (r :: r' :: rest) i).drop 1) b
            (by rw [hdrop _ hlifta]; exact hb)
            (by rw [hdrop _ hlifta, hdrop _ hilt]),
          getAt_drop1, getAt_drop1]
        exact hcancel
      · intro hnl
        rw [hnl] at hblen
        exact Nat.noConfusion hblen

/-- The descent reads the assignment fold at every square list at
the bundle: `def:elim`'s pivot walk against the signed permutation
sum. -/
private theorem detDO_eq {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (Cf : DCof γ ops R.rel) (m : List (List γ))
    (hsq : rowsLen m.length m) :
    R.rel (detDO Cf m) (detO ops m) := by
  refine detDGo_eqO L Cf m.length false ops.one m 0 m m hsq
    rfl (L.ovRefl _) (Nat.zero_add m.length) rfl hsq ?_ Cf.oneOff
    ?_ ?_
  · show R.rel ops.one (ops.add ops.one ops.unit)
    exact L.ovSymm (L.addUnit ops.one)
  · intro a b ha hb
    rw [Nat.zero_add, Nat.zero_add,
      show borderAtO ops 0 a b m
        = [[ground.getAt ops.unit
            (ground.getAt [] m a) b]] from rfl]
    exact L.ovSymm (detO_single L _)
  · intro hm
    rw [hm]
    show R.rel ops.one (ops.add ops.one ops.unit)
    exact L.ovSymm (L.addUnit ops.one)

/-! The division data at the polynomial carrier: the unit test's
scan, the convolution's top reads, the descending exact division
with its soundness, and the cancellation — `def:poly`'s exact
division at a divisor of occupied top with the product's top and
injectivity reads, stated once through the polynomial functor
with the entry carrier's own division data beneath it, the reads
`def:elim`'s division at the prior pivot consumes. -/

/-- The whole-list unit test at an entry test. -/
private def unitBL {γ : Type} (u : γ → Bool) : List γ → Bool
  | [] => true
  | c :: p => u c && unitBL u p

/-- The scan for the last entry failing the test. -/
private def lastOffIdx {γ : Type} (u : γ → Bool) :
    List γ → Option Nat
  | [] => none
  | c :: p =>
    match lastOffIdx u p with
    | some t => some (t + 1)
    | none =>
      match u c with
      | false => some 0
      | true => none

/-- A passing whole-list test reads every entry passing. -/
private theorem unitBL_index {γ : Type} (u : γ → Bool) (d : γ) :
    ∀ p : List γ, unitBL u p = true →
    ∀ k, k < p.length → u (ground.getAt d p k) = true
  | [], _, k, hk => absurd hk (Nat.not_lt_zero k)
  | c :: p, h, k, hk => by
    have hs := ground.andSplitB (show (u c && unitBL u p) = true from h)
    match k with
    | 0 => exact hs.1
    | k + 1 =>
      exact unitBL_index u d p hs.2 k (Nat.lt_of_succ_lt_succ hk)

/-- A passing whole-list test reads the unit tail. -/
private theorem unitBL_ut {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (Cf : DCof γ ops R.rel) :
    ∀ p : List γ, unitBL Cf.unitB p = true →
    poly.unitTailO ops R p
  | [], _ => trivial
  | c :: p, h => by
    have hs := ground.andSplitB
      (show (Cf.unitB c && unitBL Cf.unitB p) = true from h)
    exact ⟨Cf.unitB_true hs.1, unitBL_ut Cf p hs.2⟩

/-- The unit tail reads the whole-list test passing. -/
private theorem utReadB {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (Cf : DCof γ ops R.rel) :
    ∀ p : List γ, poly.unitTailO ops R p →
    unitBL Cf.unitB p = true
  | [], _ => rfl
  | c :: p, h => by
    show (Cf.unitB c && unitBL Cf.unitB p) = true
    cases hc : Cf.unitB c with
    | false => exact absurd h.1 (Cf.unitB_false hc)
    | true =>
      rw [utReadB Cf p h.2]
      rfl

/-- The scan's vacant read: every entry passes the test. -/
private theorem lastOffIdx_none {γ : Type} (u : γ → Bool) :
    ∀ p : List γ, lastOffIdx u p = none →
    unitBL u p = true
  | [], _ => rfl
  | c :: p, h => by
    revert h
    show (match lastOffIdx u p with
        | some t => some (t + 1)
        | none =>
          match u c with
          | false => some 0
          | true => none) = none →
      (u c && unitBL u p) = true
    cases hp : lastOffIdx u p with
    | some t =>
      intro h
      nomatch (show some (t + 1) = (none : Option Nat) from h)
    | none =>
      cases hc : u c with
      | false =>
        intro h
        nomatch (show some 0 = (none : Option Nat) from h)
      | true =>
        intro _
        rw [lastOffIdx_none u p hp]
        rfl

/-- The scan's read: the found key sits inside the list, fails the
test, and every later key passes. -/
private theorem lastOffIdx_read {γ : Type} (u : γ → Bool) (d : γ) :
    ∀ (p : List γ) (t : Nat), lastOffIdx u p = some t →
    t < p.length ∧ u (ground.getAt d p t) = false ∧
      ∀ k, t < k → u (ground.getAt d p k) = true ∨ p.length ≤ k
  | [], t, h => by
    nomatch (show (none : Option Nat) = some t from h)
  | c :: p, t, h => by
    revert h
    show (match lastOffIdx u p with
        | some t' => some (t' + 1)
        | none =>
          match u c with
          | false => some 0
          | true => none) = some t →
      t < (c :: p).length ∧
        u (ground.getAt d (c :: p) t) = false ∧
        ∀ k, t < k →
          u (ground.getAt d (c :: p) k) = true ∨ (c :: p).length ≤ k
    cases hp : lastOffIdx u p with
    | some t' =>
      intro h
      have ht := Option.some.inj h
      have hr := lastOffIdx_read u d p t' hp
      rw [← ht]
      refine ⟨Nat.succ_lt_succ hr.1, hr.2.1, fun k hk => ?_⟩
      match k, hk with
      | k + 1, hk =>
        match hr.2.2 k (Nat.lt_of_succ_lt_succ hk) with
        | .inl ht2 => exact .inl ht2
        | .inr hlen => exact .inr (Nat.succ_le_succ hlen)
    | none =>
      cases hc : u c with
      | false =>
        intro h
        have ht := Option.some.inj h
        rw [← ht]
        refine ⟨Nat.succ_pos _, hc, fun k hk => ?_⟩
        match k, hk with
        | k + 1, _ =>
          match Nat.lt_or_ge k p.length with
          | .inl hkp =>
            exact .inl (unitBL_index u d p
              (lastOffIdx_none u p hp) k hkp)
          | .inr hge => exact .inr (Nat.succ_le_succ hge)
      | true =>
        intro h
        nomatch (show (none : Option Nat) = some t from h)

/-- All-unit tails multiply to the unit tail on the left slot. -/
private theorem utMulLeftO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) {p : List γ}
    (h : poly.unitTailO ops R p) (q : List γ) :
    poly.unitTailO ops R (poly.mulLO ops p q) := by
  have h1 := mulCongrLeftO L (poly.lovNilO _ _ h) q
  exact poly.utOfNilO _ _
    (show poly.listOV ops R (poly.mulLO ops p q) [] from h1)

/-- Beyond both tops the convolution reads the sum's unit. -/
private theorem mulBeyondTopO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ∀ (P : List γ) (tP : Nat) (d : List γ) (tD : Nat),
    (∀ k, tP < k → R.rel (ground.getAt ops.unit P k) ops.unit) →
    (∀ k, tD < k → R.rel (ground.getAt ops.unit d k) ops.unit) →
    ∀ j, tP + tD < j →
    R.rel (ground.getAt ops.unit (poly.mulLO ops P d) j) ops.unit
  | [], _, _, _, _, _, j, _ => by
    show R.rel (ground.getAt ops.unit ([] : List γ) j) ops.unit
    rw [ground.getAt_over ops.unit ([] : List γ) j (Nat.zero_le j)]
    exact L.ovRefl _
  | c :: P', tP, d, tD, hP, hD, j, hj => by
    show R.rel (ground.getAt ops.unit
        (poly.addLO ops (d.map (ops.mul c))
          (ops.unit :: poly.mulLO ops P' d)) j) ops.unit
    refine L.ovTrans (getAtAddO L _ _ j) ?_
    have hfirst : R.rel (ground.getAt ops.unit (d.map (ops.mul c)) j)
        ops.unit := by
      match Nat.lt_or_ge j d.length with
      | .inl hjd =>
        rw [ground.getAt_map ops.unit ops.unit (fun y => ops.mul c y)
          d j hjd]
        refine L.ovTrans
          (L.mulCongr (L.ovRefl c)
            (hD j (Nat.lt_of_le_of_lt (Nat.le_add_left tD tP) hj)))
          (L.mulUnit c)
      | .inr hge =>
        rw [ground.getAt_over ops.unit (d.map (ops.mul c)) j
          (by rw [ground.length_map]; exact hge)]
        exact L.ovRefl _
    match tP, j, hj with
    | 0, j + 1, _ =>
      have hut : poly.unitTailO ops R P' :=
        utOfGetAt (fun k =>
          hP (k + 1) (Nat.succ_pos k))
      have hsec : R.rel (ground.getAt ops.unit
          (ops.unit :: poly.mulLO ops P' d) (j + 1)) ops.unit := by
        show R.rel (ground.getAt ops.unit (poly.mulLO ops P' d) j)
          ops.unit
        exact utGetAt L.toDCore (utMulLeftO L hut d) j
      exact L.ovTrans (L.addCongr hfirst hsec) (L.unitAdd ops.unit)
    | tP + 1, j + 1, hj =>
      have hsec : R.rel (ground.getAt ops.unit
          (ops.unit :: poly.mulLO ops P' d) (j + 1)) ops.unit := by
        show R.rel (ground.getAt ops.unit (poly.mulLO ops P' d) j)
          ops.unit
        exact mulBeyondTopO L P' tP d tD
          (fun k hk => hP (k + 1) (Nat.succ_lt_succ hk)) hD j
          (by
            have h1 : tP + 1 + tD < j + 1 := hj
            rw [Nat.add_right_comm tP 1 tD] at h1
            exact Nat.lt_of_succ_lt_succ h1)
      exact L.ovTrans (L.addCongr hfirst hsec) (L.unitAdd ops.unit)

/-- At the two tops the convolution reads the tops' product. -/
private theorem mulTopCoeffO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ∀ (P : List γ) (tP : Nat) (d : List γ) (tD : Nat),
    (∀ k, tP < k → R.rel (ground.getAt ops.unit P k) ops.unit) →
    (∀ k, tD < k → R.rel (ground.getAt ops.unit d k) ops.unit) →
    R.rel (ground.getAt ops.unit (poly.mulLO ops P d) (tP + tD))
      (ops.mul (ground.getAt ops.unit P tP)
        (ground.getAt ops.unit d tD))
  | [], tP, d, tD, _, _ => by
    show R.rel (ground.getAt ops.unit ([] : List γ) (tP + tD))
      (ops.mul (ground.getAt ops.unit ([] : List γ) tP)
        (ground.getAt ops.unit d tD))
    rw [ground.getAt_over ops.unit ([] : List γ) (tP + tD)
        (Nat.zero_le _),
      ground.getAt_over ops.unit ([] : List γ) tP (Nat.zero_le _)]
    exact L.toDCore.ovSymm (mulUnitLeftO L _)
  | c :: P', 0, d, tD, hP, hD => by
    show R.rel (ground.getAt ops.unit
        (poly.addLO ops (d.map (ops.mul c))
          (ops.unit :: poly.mulLO ops P' d)) (0 + tD))
      (ops.mul c (ground.getAt ops.unit d tD))
    rw [Nat.zero_add]
    refine L.ovTrans (getAtAddO L _ _ tD) ?_
    have hfirst : R.rel (ground.getAt ops.unit (d.map (ops.mul c)) tD)
        (ops.mul c (ground.getAt ops.unit d tD)) := by
      match Nat.lt_or_ge tD d.length with
      | .inl hjd =>
        rw [ground.getAt_map ops.unit ops.unit (fun y => ops.mul c y)
          d tD hjd]
        exact L.ovRefl _
      | .inr hge =>
        rw [ground.getAt_over ops.unit (d.map (ops.mul c)) tD
            (by rw [ground.length_map]; exact hge),
          ground.getAt_over ops.unit d tD hge]
        exact L.toDCore.ovSymm (L.mulUnit c)
    have hut : poly.unitTailO ops R P' :=
      utOfGetAt (fun k => hP (k + 1) (Nat.succ_pos k))
    have hsec : R.rel (ground.getAt ops.unit
        (ops.unit :: poly.mulLO ops P' d) tD) ops.unit := by
      match tD with
      | 0 => exact L.ovRefl _
      | t + 1 =>
        show R.rel (ground.getAt ops.unit (poly.mulLO ops P' d) t)
          ops.unit
        exact utGetAt L.toDCore (utMulLeftO L hut d) t
    exact L.ovTrans (L.addCongr hfirst hsec) (L.addUnit _)
  | c :: P', tP + 1, d, tD, hP, hD => by
    show R.rel (ground.getAt ops.unit
        (poly.addLO ops (d.map (ops.mul c))
          (ops.unit :: poly.mulLO ops P' d)) (tP + 1 + tD))
      (ops.mul (ground.getAt ops.unit P' tP)
        (ground.getAt ops.unit d tD))
    refine L.ovTrans (getAtAddO L _ _ (tP + 1 + tD)) ?_
    have hstep : tP + 1 + tD = (tP + tD) + 1 :=
      Nat.add_right_comm tP 1 tD
    have hfirst : R.rel (ground.getAt ops.unit (d.map (ops.mul c))
        (tP + 1 + tD)) ops.unit := by
      match Nat.lt_or_ge (tP + 1 + tD) d.length with
      | .inl hjd =>
        rw [ground.getAt_map ops.unit ops.unit (fun y => ops.mul c y)
          d _ hjd]
        refine L.ovTrans
          (L.mulCongr (L.ovRefl c) (hD _ (by
            rw [hstep]
            exact Nat.lt_of_le_of_lt (Nat.le_add_left tD tP)
              (Nat.lt_succ_self (tP + tD))))) ?_
        exact L.mulUnit c
      | .inr hge =>
        rw [ground.getAt_over ops.unit (d.map (ops.mul c)) _
          (by rw [ground.length_map]; exact hge)]
        exact L.ovRefl _
    have hsec : R.rel (ground.getAt ops.unit
        (ops.unit :: poly.mulLO ops P' d) (tP + 1 + tD))
        (ops.mul (ground.getAt ops.unit P' tP)
          (ground.getAt ops.unit d tD)) := by
      rw [hstep]
      show R.rel (ground.getAt ops.unit (poly.mulLO ops P' d) (tP + tD))
        _
      exact mulTopCoeffO L P' tP d tD
        (fun k hk => hP (k + 1) (Nat.succ_lt_succ hk)) hD
    exact L.ovTrans (L.addCongr hfirst hsec) (L.unitAdd _)

/-- The descent's step at the divisor's stated data: the divisor's
top key and top coefficient enter once at the shell below, the
recursion descending the dividend alone with the step's cleared
monomial one shared datum of the quotient and the withdrawal. -/
private def cofGo {γ : Type} {ops : DOps γ} {ov : γ → γ → Prop}
    (Cf : DCof γ ops ov) (tP : Nat) (cP : γ) (P : List γ) :
    Nat → List γ → List γ
  | 0, _ => []
  | fuel + 1, E =>
    match lastOffIdx Cf.unitB E with
    | none => []
    | some tE =>
      match Nat.ble tP tE with
      | false => []
      | true =>
        let m := shiftUpO ops (tE - tP)
          [Cf.cof (ground.getAt ops.unit E tE) cP]
        poly.addLO ops m
          (cofGo Cf tP cP P fuel
            ((poly.addLO ops E
              ((poly.mulLO ops P m).map ops.swap)).map Cf.nrm))

/-- The descending exact division at the entry carrier's division
data: the divisor's top key and top coefficient read once at the
entry, the quotient collecting one cleared monomial per step at
the two tops' exact cofactor with the dividend descending at the
step's withdrawal. -/
private def cofLO {γ : Type} {ops : DOps γ} {ov : γ → γ → Prop}
    (Cf : DCof γ ops ov) (fuel : Nat) (E P : List γ) : List γ :=
  match lastOffIdx Cf.unitB P with
  | none => []
  | some tP =>
    (cofGo Cf tP (ground.getAt ops.unit P tP) P fuel E).map Cf.nrm

/-- Two off-unit tops refuse the product's unit tail. -/
private theorem zeroDivL {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (Cf : DCof γ ops R.rel) {P d : List γ}
    (hPB : unitBL Cf.unitB P = false)
    (hdB : unitBL Cf.unitB d = false)
    (hut : poly.unitTailO ops R (poly.mulLO ops P d)) : False := by
  cases hsP : lastOffIdx Cf.unitB P with
  | none => rw [lastOffIdx_none Cf.unitB P hsP] at hPB; nomatch hPB
  | some tP =>
  cases hsD : lastOffIdx Cf.unitB d with
  | none => rw [lastOffIdx_none Cf.unitB d hsD] at hdB; nomatch hdB
  | some tD =>
    have hPr := lastOffIdx_read Cf.unitB ops.unit P tP hsP
    have hDr := lastOffIdx_read Cf.unitB ops.unit d tD hsD
    have hPbey : ∀ k, tP < k →
        R.rel (ground.getAt ops.unit P k) ops.unit := fun k hk => by
      match hPr.2.2 k hk with
      | .inl hb => exact Cf.unitB_true hb
      | .inr hlen =>
        rw [ground.getAt_over ops.unit P k hlen]
        exact L.ovRefl _
    have hDbey : ∀ k, tD < k →
        R.rel (ground.getAt ops.unit d k) ops.unit := fun k hk => by
      match hDr.2.2 k hk with
      | .inl hb => exact Cf.unitB_true hb
      | .inr hlen =>
        rw [ground.getAt_over ops.unit d k hlen]
        exact L.ovRefl _
    have htop := mulTopCoeffO L P tP d tD hPbey hDbey
    have hcoeff := utGetAt L.toDCore hut (tP + tD)
    have hmul : R.rel (ops.mul (ground.getAt ops.unit P tP)
        (ground.getAt ops.unit d tD)) ops.unit :=
      L.ovTrans (L.ovSymm htop) hcoeff
    exact absurd
      (mulCancelUnitO L Cf (Cf.unitB_false hPr.2.1) hmul)
      (Cf.unitB_false hDr.2.1)

/-- The product's cancellation at an off-null factor: the
difference's product reads the unit tail, the two off-unit tops
refuse it, so the difference is the unit tail and the factors read
one value. -/
private theorem mulCancelL {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (Cf : DCof γ ops R.rel) {P a b : List γ}
    (hP : ¬ poly.listOV ops R P [])
    (h : poly.listOV ops R (poly.mulLO ops P a) (poly.mulLO ops P b)) :
    poly.listOV ops R a b := by
  have hPB : unitBL Cf.unitB P = false := by
    cases hb : unitBL Cf.unitB P with
    | true => exact absurd (poly.lovNilO _ _ (unitBL_ut Cf P hb)) hP
    | false => rfl
  have hut : poly.unitTailO ops R
      (poly.addLO ops (poly.mulLO ops P a)
        ((poly.mulLO ops P b).map ops.swap)) := diffUtO L h
  have hchain : poly.listOV ops R
      (poly.mulLO ops P (poly.addLO ops a (b.map ops.swap)))
      (poly.addLO ops (poly.mulLO ops P a)
        ((poly.mulLO ops P b).map ops.swap)) :=
    lovTrans L.toDCore (mulSumO L P a (b.map ops.swap))
      (addCongrO L (lovRefl L.toDCore _) (mulSwapRightO L P b))
  have hutd : poly.unitTailO ops R
      (poly.mulLO ops P (poly.addLO ops a (b.map ops.swap))) :=
    utTransferO L.toDCore (lovSymm L.toDCore hchain) hut
  cases hd : unitBL Cf.unitB (poly.addLO ops a (b.map ops.swap)) with
  | true => exact ovOfDiffO L (unitBL_ut Cf _ hd)
  | false => exact (zeroDivL L Cf hPB hd hutd).elim

/-- The descending division is sound at divisible data: at a
stated factorization the divisor against the collected quotient
reads the dividend back, the induction descending at the
dividend's top with the divisor's top data fixed across it. -/
private theorem cofGo_sound {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (Cf : DCof γ ops R.rel) {P : List γ} {tP : Nat}
    (hPbey : ∀ k, tP < k → R.rel (ground.getAt ops.unit P k) ops.unit)
    (hPoff : ¬ R.rel (ground.getAt ops.unit P tP) ops.unit) :
    ∀ (fuel : Nat) (E X : List γ),
    (∀ k, fuel ≤ k → R.rel (ground.getAt ops.unit E k) ops.unit) →
    poly.listOV ops R (poly.mulLO ops P X) E →
    poly.listOV ops R
      (poly.mulLO ops P
        (cofGo Cf tP (ground.getAt ops.unit P tP) P fuel E)) E
  | 0, E, _, hfE, _ =>
    utOv L.toDCore (mulNilO L.toDCore P)
      (utOfGetAt (fun k => hfE k (Nat.zero_le k)))
  | fuel + 1, E, X, hfE, hE => by
    show poly.listOV ops R (poly.mulLO ops P
      (match lastOffIdx Cf.unitB E with
       | none => []
       | some tE =>
         match Nat.ble tP tE with
         | false => []
         | true =>
           let m := shiftUpO ops (tE - tP)
             [Cf.cof (ground.getAt ops.unit E tE)
               (ground.getAt ops.unit P tP)]
           poly.addLO ops m
             (cofGo Cf tP (ground.getAt ops.unit P tP) P fuel
               ((poly.addLO ops E
                 ((poly.mulLO ops P m).map ops.swap)).map
                 Cf.nrm)))) E
    cases hsE : lastOffIdx Cf.unitB E with
    | none =>
      show poly.listOV ops R (poly.mulLO ops P []) E
      exact utOv L.toDCore (mulNilO L.toDCore P)
        (unitBL_ut Cf E (lastOffIdx_none Cf.unitB E hsE))
    | some tE =>
    show poly.listOV ops R (poly.mulLO ops P
      (match Nat.ble tP tE with
       | false => []
       | true =>
         let m := shiftUpO ops (tE - tP)
           [Cf.cof (ground.getAt ops.unit E tE)
             (ground.getAt ops.unit P tP)]
         poly.addLO ops m
           (cofGo Cf tP (ground.getAt ops.unit P tP) P fuel
             ((poly.addLO ops E
               ((poly.mulLO ops P m).map ops.swap)).map
               Cf.nrm)))) E
    have hEr := lastOffIdx_read Cf.unitB ops.unit E tE hsE
    have hEbey : ∀ k, tE < k →
        R.rel (ground.getAt ops.unit E k) ops.unit := fun k hk => by
      match hEr.2.2 k hk with
      | .inl hb => exact Cf.unitB_true hb
      | .inr hlen =>
        rw [ground.getAt_over ops.unit E k hlen]
        exact L.ovRefl _
    have hEoff : ¬ R.rel (ground.getAt ops.unit E tE) ops.unit :=
      Cf.unitB_false hEr.2.1
    cases hXB : unitBL Cf.unitB X with
    | true =>
      have hutPX : poly.unitTailO ops R (poly.mulLO ops P X) :=
        utTransferO L.toDCore
          (lovSymm L.toDCore
            (mulCongrO L P (poly.lovNilO _ _ (unitBL_ut Cf X hXB))))
          (mulNilO L.toDCore P)
      have hutE : poly.unitTailO ops R E :=
        utTransferO L.toDCore hE hutPX
      exact absurd (utGetAt L.toDCore hutE tE) hEoff
    | false =>
    cases hsX : lastOffIdx Cf.unitB X with
    | none =>
      rw [lastOffIdx_none Cf.unitB X hsX] at hXB
      nomatch hXB
    | some tX =>
      have hXr := lastOffIdx_read Cf.unitB ops.unit X tX hsX
      have hXbey : ∀ k, tX < k →
          R.rel (ground.getAt ops.unit X k) ops.unit :=
        fun k hk => by
        match hXr.2.2 k hk with
        | .inl hb => exact Cf.unitB_true hb
        | .inr hlen =>
          rw [ground.getAt_over ops.unit X k hlen]
          exact L.ovRefl _
      have hXoff : ¬ R.rel (ground.getAt ops.unit X tX) ops.unit :=
        Cf.unitB_false hXr.2.1
      have htopX := mulTopCoeffO L P tP X tX hPbey hXbey
      have hcoeffE : R.rel (ops.mul (ground.getAt ops.unit P tP)
          (ground.getAt ops.unit X tX))
          (ground.getAt ops.unit E (tP + tX)) :=
        L.ovTrans (L.ovSymm htopX)
          (lovGetAt L.toDCore hE (tP + tX))
      have hEc_off : ¬ R.rel (ground.getAt ops.unit E (tP + tX))
          ops.unit := fun hu =>
        absurd
          (mulCancelUnitO L Cf hPoff (L.ovTrans hcoeffE hu))
          hXoff
      have hbeyPX : ∀ k, tP + tX < k →
          R.rel (ground.getAt ops.unit E k) ops.unit := fun k hk =>
        L.ovTrans
          (L.ovSymm (lovGetAt L.toDCore hE k))
          (mulBeyondTopO L P tP X tX hPbey hXbey k hk)
      have htE_le : tE ≤ tP + tX := by
        match Nat.lt_or_ge (tP + tX) tE with
        | .inl h => exact absurd (hbeyPX tE h) hEoff
        | .inr h => exact h
      have htE_ge : tP + tX ≤ tE := by
        match Nat.lt_or_ge tE (tP + tX) with
        | .inl h =>
          refine absurd ?_ hEc_off
          match hEr.2.2 (tP + tX) h with
          | .inl hb => exact Cf.unitB_true hb
          | .inr hlen =>
            rw [ground.getAt_over ops.unit E (tP + tX) hlen]
            exact L.ovRefl _
        | .inr h => exact h
      have htE_eq : tE = tP + tX := Nat.le_antisymm htE_le htE_ge
      cases hble : Nat.ble tP tE with
      | false =>
        have hge : tP ≤ tE := by
          rw [htE_eq]
          exact Nat.le_add_right tP tX
        have hbt : Nat.ble tP tE = true := Nat.ble_eq_true_of_le hge
        rw [hble] at hbt
        nomatch hbt
      | true =>
        show poly.listOV ops R (poly.mulLO ops P
          (poly.addLO ops
            (shiftUpO ops (tE - tP)
              [Cf.cof (ground.getAt ops.unit E tE)
                (ground.getAt ops.unit P tP)])
            (cofGo Cf tP (ground.getAt ops.unit P tP) P fuel
              ((poly.addLO ops E
                ((poly.mulLO ops P
                  (shiftUpO ops (tE - tP)
                    [Cf.cof (ground.getAt ops.unit E tE)
                      (ground.getAt ops.unit P tP)])).map
                  ops.swap)).map Cf.nrm)))) E
        have hgs : tE - tP = tX := by
          rw [htE_eq, ground.addSubSelfL]
        rw [hgs]
        have hs_bey : ∀ k, tX < k →
            R.rel (ground.getAt ops.unit
              (shiftUpO ops tX
                [Cf.cof (ground.getAt ops.unit E tE)
                  (ground.getAt ops.unit P tP)]) k)
              ops.unit := by
          intro k hk
          rw [ground.getAt_over ops.unit _ k
            (by rw [lenShiftO ops tX]; exact hk)]
          exact L.ovRefl _
        have hcoeffE' : R.rel (ops.mul (ground.getAt ops.unit P tP)
            (ground.getAt ops.unit X tX))
            (ground.getAt ops.unit E tE) := by
          rw [htE_eq]
          exact hcoeffE
        have hc : R.rel (ops.mul (ground.getAt ops.unit P tP)
            (Cf.cof (ground.getAt ops.unit E tE)
              (ground.getAt ops.unit P tP)))
            (ground.getAt ops.unit E tE) :=
          Cf.cofSound hPoff hcoeffE'
        have hs_top := mulTopCoeffO L P tP
          (shiftUpO ops tX
            [Cf.cof (ground.getAt ops.unit E tE)
              (ground.getAt ops.unit P tP)]) tX hPbey hs_bey
        have hs_at : ground.getAt ops.unit
            (shiftUpO ops tX
              [Cf.cof (ground.getAt ops.unit E tE)
                (ground.getAt ops.unit P tP)]) tX
            = Cf.cof (ground.getAt ops.unit E tE)
                (ground.getAt ops.unit P tP) :=
          getAtShiftAddO ops tX
            [Cf.cof (ground.getAt ops.unit E tE)
              (ground.getAt ops.unit P tP)] 0
        have hPs_top : R.rel (ground.getAt ops.unit
            (poly.mulLO ops P
              (shiftUpO ops tX
                [Cf.cof (ground.getAt ops.unit E tE)
                  (ground.getAt ops.unit P tP)])) (tP + tX))
            (ground.getAt ops.unit E tE) := by
          rw [hs_at] at hs_top
          exact L.ovTrans hs_top hc
        have hPs_topE := hPs_top
        rw [← htE_eq] at hPs_topE
        have hPs_bey : ∀ k, tE < k →
            R.rel (ground.getAt ops.unit
              (poly.mulLO ops P
                (shiftUpO ops tX
                  [Cf.cof (ground.getAt ops.unit E tE)
                    (ground.getAt ops.unit P tP)])) k)
              ops.unit := by
          intro k hk
          refine mulBeyondTopO L P tP _ tX hPbey hs_bey k ?_
          rw [← htE_eq]
          exact hk
        have hE'bey0 : ∀ k, fuel ≤ k →
            R.rel (ground.getAt ops.unit
              (poly.addLO ops E
                ((poly.mulLO ops P
                  (shiftUpO ops tX
                    [Cf.cof (ground.getAt ops.unit E tE)
                      (ground.getAt ops.unit P tP)])).map
                  ops.swap)) k) ops.unit := by
          intro k hk
          have htEf : tE ≤ fuel := by
            match Nat.lt_or_ge fuel tE with
            | .inl h => exact absurd (hfE tE h) hEoff
            | .inr h => exact h
          have htEk : tE ≤ k := Nat.le_trans htEf hk
          refine L.ovTrans (getAtAddO L _ _ k) ?_
          refine L.ovTrans
            (L.addCongr (L.ovRefl _)
              (getAtNegO L.toDCore _ k)) ?_
          match Nat.lt_or_ge tE k with
          | .inl hlt =>
            refine L.ovTrans
              (L.addCongr (hEbey k hlt)
                (L.toDCore.swapCongr (hPs_bey k hlt))) ?_
            exact L.ovTrans
              (L.addCongr (L.ovRefl _) L.toDCore.swapUnit)
              (L.addUnit _)
          | .inr hge =>
            have hkE : k = tE := Nat.le_antisymm hge htEk
            rw [hkE]
            refine L.ovTrans
              (L.addCongr (L.ovRefl _)
                (L.toDCore.swapCongr hPs_topE)) ?_
            exact annihDerived L _
        have hE'bey : ∀ k, fuel ≤ k →
            R.rel (ground.getAt ops.unit
              ((poly.addLO ops E
                ((poly.mulLO ops P
                  (shiftUpO ops tX
                    [Cf.cof (ground.getAt ops.unit E tE)
                      (ground.getAt ops.unit P tP)])).map
                  ops.swap)).map Cf.nrm) k) ops.unit := by
          intro k hk
          match Nat.lt_or_ge k (poly.addLO ops E
              ((poly.mulLO ops P
                (shiftUpO ops tX
                  [Cf.cof (ground.getAt ops.unit E tE)
                    (ground.getAt ops.unit P tP)])).map
                ops.swap)).length with
          | .inl hlt =>
            rw [ground.getAt_map ops.unit ops.unit Cf.nrm _ k hlt]
            exact L.ovTrans (Cf.nrmOv _) (hE'bey0 k hk)
          | .inr hge =>
            rw [ground.getAt_over ops.unit _ k
              (by rw [ground.length_map]; exact hge)]
            exact L.ovRefl _
        have hX' : poly.listOV ops R
            (poly.mulLO ops P
              (poly.addLO ops X
                ((shiftUpO ops tX
                  [Cf.cof (ground.getAt ops.unit E tE)
                    (ground.getAt ops.unit P tP)]).map ops.swap)))
            ((poly.addLO ops E
              ((poly.mulLO ops P
                (shiftUpO ops tX
                  [Cf.cof (ground.getAt ops.unit E tE)
                    (ground.getAt ops.unit P tP)])).map
                ops.swap)).map Cf.nrm) :=
          lovTrans L.toDCore
            (lovTrans L.toDCore
              (mulSumO L P X _)
              (addCongrO L hE (mulSwapRightO L P _)))
            (lovSymm L.toDCore
              (mapSelfLov Cf.nrm Cf.nrmOv _))
        have hIH := cofGo_sound L Cf hPbey hPoff fuel
          ((poly.addLO ops E
            ((poly.mulLO ops P
              (shiftUpO ops tX
                [Cf.cof (ground.getAt ops.unit E tE)
                  (ground.getAt ops.unit P tP)])).map ops.swap)).map
            Cf.nrm)
          (poly.addLO ops X
            ((shiftUpO ops tX
              [Cf.cof (ground.getAt ops.unit E tE)
                (ground.getAt ops.unit P tP)]).map ops.swap))
          hE'bey hX'
        refine lovTrans L.toDCore (mulSumO L P _ _) ?_
        refine lovTrans L.toDCore
          (addCongrO L (lovRefl L.toDCore _) hIH) ?_
        refine lovTrans L.toDCore
          (addCongrO L (lovRefl L.toDCore _)
            (mapSelfLov Cf.nrm Cf.nrmOv _)) ?_
        refine lovTrans L.toDCore
          (addCommO L _ _) ?_
        refine lovTrans L.toDCore
          (addAssocO L _ _ _) ?_
        refine lovTrans L.toDCore (addCommO L _ _) ?_
        refine utAddLovO L ?_ E
        exact utTransferO L.toDCore
          (addCommO L _ _)
          (diffUtO L (lovRefl L.toDCore
            (poly.mulLO ops P
              (shiftUpO ops tX
                [Cf.cof (ground.getAt ops.unit E tE)
                  (ground.getAt ops.unit P tP)]))))

/-- The division data lift through the polynomial functor: the
list carrier's exact cofactor at the descending division, the
whole-list unit test, and the laws off the entry carrier's own —
one lift per level of the carrier tower, `polyLawsO`'s companion. -/
private def polyCofO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (Cf : DCof γ ops R.rel) :
    DCof (List γ) (poly.polyO ops) (poly.listOV ops R) :=
  { cof := fun E P => cofLO Cf E.length E P
    unitB := unitBL Cf.unitB
    unitB_true := fun {x} h => poly.lovNilO _ _ (unitBL_ut Cf x h)
    unitB_false := fun {x} h hx => by
      rw [utReadB Cf x (poly.utOfNilO _ _ hx)] at h
      nomatch h
    cofSound := fun {P X E} hP hE => by
      show poly.listOV ops R
        (poly.mulLO ops P
          (match lastOffIdx Cf.unitB P with
           | none => []
           | some tP =>
             (cofGo Cf tP (ground.getAt ops.unit P tP) P
               E.length E).map Cf.nrm)) E
      cases hsP : lastOffIdx Cf.unitB P with
      | none =>
        exact absurd
          (poly.lovNilO _ _
            (unitBL_ut Cf P (lastOffIdx_none Cf.unitB P hsP)))
          hP
      | some tP =>
        show poly.listOV ops R (poly.mulLO ops P
          ((cofGo Cf tP (ground.getAt ops.unit P tP) P
            E.length E).map Cf.nrm)) E
        have hPr := lastOffIdx_read Cf.unitB ops.unit P tP hsP
        have hPbey : ∀ k, tP < k →
            R.rel (ground.getAt ops.unit P k) ops.unit :=
          fun k hk => by
          match hPr.2.2 k hk with
          | .inl hb => exact Cf.unitB_true hb
          | .inr hlen =>
            rw [ground.getAt_over ops.unit P k hlen]
            exact L.ovRefl _
        refine lovTrans L.toDCore
          (mulCongrO L P (mapSelfLov Cf.nrm Cf.nrmOv _)) ?_
        exact cofGo_sound L Cf hPbey (Cf.unitB_false hPr.2.1)
          E.length E X
          (fun k hk => by
            rw [ground.getAt_over ops.unit E k hk]
            exact L.ovRefl _)
          hE
    mulCancel := fun {P a b} hP h => mulCancelL L Cf hP h
    oneOff := fun h => Cf.oneOff h.1
    nrm := fun p => p.map Cf.nrm
    nrmOv := fun p => mapSelfLov Cf.nrm Cf.nrmOv p }

/-! The polynomial instances: the committed carriers' reads are
the one generic read's own instances definitionally, the walk and
the fold at the tower's division data, and the descent's
determinant at polynomial entries against the first-row fold. -/

/-- The descent's determinant at polynomial entries: the walk at
the lifted division data. -/
def pdetD (m : List (List poly.Poly)) : poly.Poly :=
  detDO (polyCofO (R := ground.bpairRead) bpairLaws bpairCof) m

/-- The descent reads the first-row fold at polynomial entries:
`def:elim`'s pivot walk against the fold at the representative
map, every square list. -/
theorem pdetD_eq : ∀ (m : List (List poly.Poly)),
    rowsLen m.length m →
    poly.oneValue (pdetD m)
      (minorO poly.polyOps poly.pnorm id m) :=
  fun m hsq =>
  lovTrans (R := ground.bpairRead) bpairCore
    (detDO_eq (R := poly.polyRead)
      (polyLawsO (R := ground.bpairRead) bpairLaws)
      (polyCofO (R := ground.bpairRead) bpairLaws bpairCof) m hsq)
    (lovSymm (R := ground.bpairRead) bpairCore
      (minorO_detO (R := poly.polyRead)
        (polyLawsO (R := ground.bpairRead) bpairLaws)
        poly.pnorm id
        (fun x => poly.pnorm_oneValue x)
        (fun x => lovRefl (R := ground.bpairRead) bpairCore x)
        m hsq))

/-- The descent's determinant at the iterated carrier's entries:
the walk at the twice-lifted division data. -/
def ppdetD (m : List (List poly.PPoly)) : poly.PPoly :=
  detDO (polyCofO (R := poly.polyRead)
    (polyLawsO (R := ground.bpairRead) bpairLaws)
    (polyCofO (R := ground.bpairRead) bpairLaws bpairCof)) m

/-- The descent reads the first-row fold at the iterated
carrier's entries. -/
theorem ppdetD_eq : ∀ (m : List (List poly.PPoly)),
    rowsLen m.length m →
    poly.ppOneValue (ppdetD m)
      (minorO (poly.polyO poly.polyOps) poly.pnormP id m) :=
  fun m hsq =>
  lovTrans (R := poly.polyRead)
    (polyLawsO (R := ground.bpairRead) bpairLaws).toDCore
    (detDO_eq (R := poly.listRead poly.polyOps poly.polyRead)
      (polyLawsO (R := poly.polyRead)
        (polyLawsO (R := ground.bpairRead) bpairLaws))
      (polyCofO (R := poly.polyRead)
        (polyLawsO (R := ground.bpairRead) bpairLaws)
        (polyCofO (R := ground.bpairRead) bpairLaws bpairCof)) m hsq)
    (lovSymm (R := poly.polyRead)
      (polyLawsO (R := ground.bpairRead) bpairLaws).toDCore
      (minorO_detO (R := poly.listRead poly.polyOps poly.polyRead)
        (polyLawsO (R := poly.polyRead)
          (polyLawsO (R := ground.bpairRead) bpairLaws))
        poly.pnormP id
        (fun x => poly.pnormP_ppOneValue x)
        (fun x => lovRefl (R := poly.polyRead)
          (polyLawsO (R := ground.bpairRead) bpairLaws).toDCore x)
        m hsq))

/-! The balance-pair instance of the descent: the walk and its
assignment-fold read at the pair division data (`bpairCof`), the
independence read's instance deciding through `detD_eq`. -/

/-- The descent's determinant: the walk at the row count, seeded
at the vacant leading minor's own value. -/
def detD (m : Mat) : BPair := detDO bpairCof m

/-- The descent reads the assignment fold at every square list:
`def:elim`'s pivot walk against the signed permutation sum. -/
theorem detD_eq : ∀ (m : Mat), rowsLen m.length m →
    (detD m).oneValue (detL m) :=
  fun m hsq => detDO_eq (R := ground.bpairRead) bpairLaws bpairCof m hsq

/-- The Gram's rows read its own count, the descent's square
frame at every listed family. -/
theorem gramM_sq : ∀ L : Mat, rowsLen (gramM L).length (gramM L) := by
  intro L
  rw [sqAt_len (gram_sqAt L)]
  exact rowsLen_of_sqAt (gram_sqAt L)

/-- The independence read's decision: the shape at its own read
and the Gram determinant's off-unit conjunct decided at the pivot
descent, transported across the descent's value (`detD_eq` at the
Gram's square frame `gramM_sq`). -/
instance (n : Nat) (L : Mat) : Decidable (indepRows n L) :=
  @instDecidableAnd (rowsLen n L)
    (¬ (detL (gramM L)).oneValue BPair.unit) (decRowsLen n L)
    (match hd : decide ((detD (gramM L)).oneValue BPair.unit) with
      | true => isFalse (fun hn => hn
          (BPair.oneValue_trans
            (BPair.oneValue_symm (detD_eq _ (gramM_sq L)))
            (of_decide_eq_true hd)))
      | false => isTrue (fun hL =>
          Bool.noConfusion (hd.symm.trans (decide_eq_true
            (BPair.oneValue_trans (detD_eq _ (gramM_sq L)) hL)))))

/-! The Bezout cofactor row at the descent: each entry the erased
shift frame's pivot walk, the fold row read back at one value on a
square frame — `thm:windowsep`'s width read the consumer, deciding
the row at the walk. -/

/-- The withdrawn leading column is the rows' first key struck. -/
private theorem dropCol_eraseIdx {γ : Type} :
    ∀ m : List (List γ), dropCol m = m.map (fun r => r.eraseIdx 0)
  | [] => rfl
  | r :: t => by
    show r.drop 1 :: dropCol t
      = r.eraseIdx 0 :: t.map (fun s => s.eraseIdx 0)
    rw [dropCol_eraseIdx t]
    cases r with
    | nil => rfl
    | cons _ _ => rfl

/-- The first column's cofactor at the descent, the side the count
of rows before: the cofactor at the walk determinant. -/
private def cofacD (m : Mat) (r : Nat) : BPair :=
  cofO detD BPair.swap m r 0

/-- The adjugate row's coefficients against `q` at the descent,
entry by entry the erased frame's walk. -/
def bezoutBD (p q : poly.Poly) : poly.Poly :=
  (List.range (p.length - 1)).map (fun a => cofacD (shiftMat p q) a)

/-- The walk row reads the fold row at a square shift frame, one
value at every key. -/
theorem bezoutBD_eq (p q : poly.Poly)
    (hsq : rowsLen (shiftMat p q).length (shiftMat p q)) :
    poly.oneValue (bezoutBD p q) (bezoutB p q) := by
  refine poly.ov_of_getAt (fun k => ?_)
  cases Nat.lt_or_ge k (p.length - 1) with
  | inr hk =>
    have hlen : (List.range (p.length - 1)).length = p.length - 1 :=
      ground.length_range _
    have h1 : ground.getAt BPair.unit (bezoutBD p q) k = BPair.unit := by
      unfold bezoutBD
      exact ground.getAt_over _ _ _
        (by rw [ground.length_map, hlen]; exact hk)
    have h2 : ground.getAt BPair.unit (bezoutB p q) k = BPair.unit := by
      unfold bezoutB
      exact ground.getAt_over _ _ _
        (by rw [ground.length_map, hlen]; exact hk)
    rw [h1, h2]
    exact BPair.oneValue_refl _
  | inl hk =>
    have hlen : (List.range (p.length - 1)).length = p.length - 1 :=
      ground.length_range _
    have hkr : k < (List.range (p.length - 1)).length := by
      rw [hlen]; exact hk
    have h1 : ground.getAt BPair.unit (bezoutBD p q) k
        = cofacD (shiftMat p q) k := by
      unfold bezoutBD
      rw [ground.getAt_map 0 BPair.unit _ _ k hkr,
        ground.getAt_range _ k hk]
    have h2 : ground.getAt BPair.unit (bezoutB p q) k
        = cofacCol0 (shiftMat p q) k := by
      unfold bezoutB
      rw [ground.getAt_map 0 BPair.unit _ _ k hkr,
        ground.getAt_range _ k hk]
    rw [h1, h2]
    have hkN : k < (shiftMat p q).length := by
      have hle : p.length - 1 ≤ (shiftMat p q).length := by
        show p.length - 1 ≤ ((List.range (p.length - 1)).map _
          ++ (List.range (q.length - 1)).map _).length
        rw [ground.length_append, ground.length_map, hlen]
        exact Nat.le_add_right _ _
      exact Nat.lt_of_lt_of_le hk hle
    have hE : rowsLen
        (dropCol ((shiftMat p q).eraseIdx k)).length
        (dropCol ((shiftMat p q).eraseIdx k)) := by
      have he1 : ((shiftMat p q).eraseIdx k).length + 1
          = (shiftMat p q).length :=
        ground.length_eraseIdx _ k hkN
      have hr1 : rowsLen (((shiftMat p q).eraseIdx k).length + 1)
          ((shiftMat p q).eraseIdx k) := by
        rw [he1]
        exact rowsLen_eraseIdx _ _ k hsq
      have hd := rowsLen_dropCol _ _ hr1
      rw [length_dropCol]
      exact hd
    have hDM : (detD (dropCol ((shiftMat p q).eraseIdx k))).oneValue
        (minor (dropCol ((shiftMat p q).eraseIdx k))) :=
      BPair.oneValue_trans (detD_eq _ hE)
        (BPair.oneValue_symm (minor_detL _ hE))
    rw [dropCol_eraseIdx] at hDM
    show (cofO detD BPair.swap (shiftMat p q) k 0).oneValue
      (cofO minor BPair.swap (shiftMat p q) k 0)
    unfold cofO
    cases places.parityOf (k + 0) with
    | true => exact ground.swap_congr hDM
    | false => exact hDM

/-! The pair carrier's division data: `def:ground`'s pair at the
positive second datum, the polynomial reading — the occupied
second member, the site the cancellation reads hold at
(`genericlift`'s site read `pairOcc`) — with the descent's walk at
the pair carrier and its fold read, the pair-entried consumers'
route (`lem:genericlift`(ii), `def:algebra`'s determination). -/

set_option genInjectivity false in
/-- The pair at the occupied second member, the shape a field. -/
private structure POcc where
  val : poly.PPair
  occ : decide (poly.unitTail val.2) = false

/-- The occupancy's read: the second member off the unit tail. -/
private theorem POcc.den_off (x : POcc) : ¬ poly.unitTail x.val.2 :=
  fun h => Bool.noConfusion ((decide_eq_true h).symm.trans x.occ)

/-- The pair's one-value read at the occupied carrier, the
cross-multiplied identity on the members. -/
private def ovP (x y : POcc) : Prop :=
  poly.oneValue (poly.mul x.val.1 y.val.2) (poly.mul y.val.1 x.val.2)

private def povRead : ground.DRead POcc :=
  ⟨ovP, fun _ _ => poly.decOneValue _ _⟩

/-- Occupancy denies the whole-list unit test, the Bool bridge. -/
private theorem denOffB {p : poly.Poly} (h : ¬ poly.unitTail p) :
    unitBL bpairCof.unitB p = false := by
  cases hB : unitBL bpairCof.unitB p with
  | true => exact absurd (unitBL_ut bpairCof p hB) h
  | false => rfl

/-- Two occupied polynomials' product is occupied, the entry
carrier's product injectivity. -/
private theorem mulDenOff {a b : poly.Poly}
    (ha : ¬ poly.unitTail a) (hb : ¬ poly.unitTail b) :
    ¬ poly.unitTail (poly.mul a b) :=
  fun hut => zeroDivL bpairLaws bpairCof (denOffB ha) (denOffB hb) hut

/-- The pair carrier's operations at the occupied carrier, the
displayed reads with the closure riding the occupancy. -/
private def opsP : DOps POcc where
  add := fun x y => ⟨poly.pAdd x.val y.val,
    decide_eq_false (mulDenOff x.den_off y.den_off)⟩
  mul := fun x y => ⟨poly.pMul x.val y.val,
    decide_eq_false (mulDenOff x.den_off y.den_off)⟩
  unit := ⟨poly.pZero, by decide +kernel⟩
  one := ⟨poly.pOne, by decide +kernel⟩
  swap := fun x => ⟨poly.pSwap x.val, x.occ⟩

/-- The representative map at the occupied carrier, memberwise. -/
private def pnrmP (x : POcc) : POcc :=
  ⟨poly.pnormPair x.val,
   decide_eq_false (fun h => x.den_off
     (poly.unitTail_oneValue_right h (poly.pnorm_oneValue x.val.2)))⟩

/-! The occupancy fold over a pair matrix, with the lifted matrix
and the fold's projection back to the raw carrier. -/

/-- The occupancy fold over a pair row: every entry's second member
occupied, `def:ground`'s positive second datum read entry by
entry — the whole-list fold at the entry test. -/
def rowOcc : List poly.PPair → Bool :=
  unitBL (fun x => !decide (poly.unitTail x.2))

/-- The occupancy fold over a pair matrix, row by row — the
whole-list fold at the row read. -/
def matOcc : List (List poly.PPair) → Bool := unitBL rowOcc

private theorem unitBL_eraseIdx {γ : Type} (u : γ → Bool) :
    ∀ (l : List γ) (j : Nat), unitBL u l = true →
    unitBL u (l.eraseIdx j) = true
  | [], _, _ => rfl
  | _ :: _, 0, h => (ground.andSplitB h).2
  | c :: l, j + 1, h => by
    have hs := ground.andSplitB
      (show (u c && unitBL u l) = true from h)
    show (u c && unitBL u (l.eraseIdx j)) = true
    rw [hs.1, unitBL_eraseIdx u l j hs.2]
    rfl

private theorem unitBL_map {γ δ : Type} (u : γ → Bool) (v : δ → Bool)
    (f : γ → δ) (h : ∀ x, u x = true → v (f x) = true) :
    ∀ l : List γ, unitBL u l = true → unitBL v (l.map f) = true
  | [], _ => rfl
  | c :: l, hl => by
    have hs := ground.andSplitB
      (show (u c && unitBL u l) = true from hl)
    show (v (f c) && unitBL v (l.map f)) = true
    rw [h c hs.1, unitBL_map u v f h l hs.2]
    rfl

private theorem unitBL_intro {γ : Type} (u : γ → Bool) (d : γ) :
    ∀ l : List γ,
    (∀ k, k < l.length → u (ground.getAt d l k) = true) →
    unitBL u l = true
  | [], _ => rfl
  | c :: l, h => by
    show (u (ground.getAt d (c :: l) 0) && unitBL u l) = true
    rw [h 0 (Nat.succ_pos _),
      unitBL_intro u d l (fun k hk => h (k + 1) (Nat.succ_lt_succ hk))]
    rfl

/-- The row occupancy's key read at every key, the sum's unit
entry's own beyond the count. -/
theorem rowOcc_read (r : List poly.PPair) (h : rowOcc r = true) :
    ∀ k, ¬ poly.unitTail (ground.getAt poly.pZero r k).2 := by
  intro k
  cases Nat.lt_or_ge k r.length with
  | inl hk =>
    have hu := unitBL_index _ poly.pZero r h k hk
    intro hut
    cases hd : decide
        (poly.unitTail (ground.getAt poly.pZero r k).2) with
    | true =>
      rw [hd] at hu
      exact Bool.noConfusion hu
    | false =>
      exact Bool.noConfusion ((decide_eq_true hut).symm.trans hd)
  | inr hk =>
    rw [ground.getAt_over poly.pZero r k hk]
    decide +kernel

/-- The matrix occupancy's row read at every key. -/
theorem matOcc_read (m : List (List poly.PPair))
    (h : matOcc m = true) :
    ∀ i, rowOcc (ground.getAt [] m i) = true := by
  intro i
  cases Nat.lt_or_ge i m.length with
  | inl hi => exact unitBL_index rowOcc [] m h i hi
  | inr hi =>
    rw [ground.getAt_over [] m i hi]
    rfl

/-- The row occupancy assembled at the keys below the count. -/
theorem rowOcc_intro (r : List poly.PPair)
    (h : ∀ k, k < r.length →
      ¬ poly.unitTail (ground.getAt poly.pZero r k).2) :
    rowOcc r = true :=
  unitBL_intro _ poly.pZero r (fun k hk => by
    rw [decide_eq_false (h k hk)]
    rfl)

/-- The matrix occupancy assembled at the rows below the count. -/
theorem matOcc_intro (m : List (List poly.PPair))
    (h : ∀ i, i < m.length →
      rowOcc (ground.getAt [] m i) = true) :
    matOcc m = true :=
  unitBL_intro rowOcc [] m h

/-- Occupancy survives the struck row and column. -/
theorem matOcc_erase (m : List (List poly.PPair)) (i j : Nat)
    (h : matOcc m = true) :
    matOcc ((m.eraseIdx i).map (fun r => r.eraseIdx j)) = true :=
  unitBL_map rowOcc rowOcc _
    (fun r hr => unitBL_eraseIdx _ r j hr)
    (m.eraseIdx i) (unitBL_eraseIdx rowOcc m i h)

/-- The replicated row's occupancy at an occupied entry. -/
theorem rowOcc_replicate (x : poly.PPair)
    (hx : ¬ poly.unitTail x.2) :
    ∀ n : Nat, rowOcc (List.replicate n x) = true
  | 0 => rfl
  | n + 1 => by
    show ((!decide (poly.unitTail x.2))
      && rowOcc (List.replicate n x)) = true
    rw [decide_eq_false hx, rowOcc_replicate x hx n]
    rfl

/-- The matrix occupancy's entry read at every key pair. -/
theorem matOcc_entry_den (m : List (List poly.PPair))
    (h : matOcc m = true) :
    ∀ k j, ¬ poly.unitTail
      (ground.getAt poly.pZero (ground.getAt [] m k) j).2 :=
  fun k j => rowOcc_read _ (matOcc_read m h k) j

private theorem denFoldO (r : List poly.PPair)
    (b : List (List poly.PPair))
    (hr : ∀ k, ¬ poly.unitTail (ground.getAt poly.pZero r k).2)
    (hb : ∀ k j, ¬ poly.unitTail
      (ground.getAt poly.pZero (ground.getAt [] b k) j).2)
    (j : Nat) :
    ∀ (ks : List Nat) {acc : poly.PPair}, ¬ poly.unitTail acc.2 →
    ¬ poly.unitTail
      ((ks.foldl (fun acc k => poly.pAdd acc
        (poly.pMul (ground.getAt poly.pZero r k)
          (ground.getAt poly.pZero (ground.getAt [] b k) j)))
        acc).2)
  | [], _, hacc => hacc
  | k :: ks, _, hacc =>
    denFoldO r b hr hb j ks
      (mulDenOff hacc (mulDenOff (hr k) (hb k j)))

/-- The entry fold's product keeps the occupancy. -/
theorem matOcc_matMulO (a b : List (List poly.PPair))
    (ha : matOcc a = true) (hb : matOcc b = true) :
    matOcc (matMulO poly.ppairOps a b) = true :=
  unitBL_map rowOcc rowOcc _
    (fun r hr => rowOcc_intro _ (fun k hk => by
      have hkr : k < (List.range (b.headD []).length).length := by
        rw [ground.length_map] at hk
        exact hk
      rw [ground.getAt_map 0 poly.pZero _
        (List.range (b.headD []).length) k hkr]
      exact denFoldO r b (rowOcc_read r hr)
        (matOcc_entry_den b hb) _ (List.range r.length) (by decide +kernel)))
    a ha

/-- The diagonal at occupied entries keeps the occupancy. -/
theorem matOcc_diagO (ds : List poly.PPair)
    (h : rowOcc ds = true) :
    matOcc (diagO poly.ppairOps ds) = true :=
  matOcc_intro _ (fun i hi => by
    rw [show (diagO poly.ppairOps ds).length = ds.length from
      ground.matOf_length ds.length ds.length _] at hi
    show rowOcc (ground.getAt []
      (ground.matOf ds.length ds.length (fun i j =>
        if j = i
        then ground.getAt poly.ppairOps.unit ds i
        else poly.ppairOps.unit)) i) = true
    rw [ground.matOf_row ([] : List poly.PPair) ds.length ds.length
      (fun i j => if j = i
        then ground.getAt poly.ppairOps.unit ds i
        else poly.ppairOps.unit) i hi]
    refine rowOcc_intro _ (fun k hk => ?_)
    have hkr : k < (List.range ds.length).length := by
      rw [ground.length_map] at hk
      exact hk
    rw [ground.getAt_map 0 poly.pZero _ (List.range ds.length) k hkr]
    by_cases hik : ground.getAt 0 (List.range ds.length) k = i
    · rw [if_pos hik]
      show ¬ poly.unitTail (ground.getAt poly.pZero ds i).2
      exact rowOcc_read ds h _
    · rw [if_neg hik]
      exact (show ¬ poly.unitTail poly.ppairOps.unit.2 by decide +kernel))

private theorem rowOcc_cons {x : poly.PPair} {t : List poly.PPair}
    (h : rowOcc (x :: t) = true) :
    decide (poly.unitTail x.2) = false ∧ rowOcc t = true := by
  have hh := ground.andSplitB
    (show ((!decide (poly.unitTail x.2))
      && unitBL (fun x => !decide (poly.unitTail x.2)) t) = true from h)
  refine ⟨?_, hh.2⟩
  cases hd : decide (poly.unitTail x.2) with
  | true =>
    have h1 := hh.1
    rw [hd] at h1
    nomatch h1
  | false => rfl

private theorem matOcc_cons {r : List poly.PPair}
    {t : List (List poly.PPair)} (h : matOcc (r :: t) = true) :
    rowOcc r = true ∧ matOcc t = true :=
  ground.andSplitB
    (show (rowOcc r && unitBL rowOcc t) = true from h)

private def liftT (x : poly.PPair) : POcc :=
  if h : poly.unitTail x.2 then
    ⟨(x.1, poly.one),
     (by decide +kernel : decide (poly.unitTail poly.one) = false)⟩
  else ⟨x, decide_eq_false h⟩

private def liftMat (m : List (List poly.PPair)) : List (List POcc) :=
  m.map (List.map liftT)

private theorem liftT_val {x : poly.PPair}
    (hx : ¬ poly.unitTail x.2) : (liftT x).val = x := by
  unfold liftT
  rw [dif_neg hx]

private theorem liftRow_val : ∀ (r : List poly.PPair),
    rowOcc r = true → (r.map liftT).map POcc.val = r
  | [], _ => rfl
  | x :: t, h => by
    show (liftT x).val :: (t.map liftT).map POcc.val = x :: t
    rw [liftT_val (fun hu => Bool.noConfusion
        ((decide_eq_true hu).symm.trans (rowOcc_cons h).1)),
      liftRow_val t (rowOcc_cons h).2]

private theorem liftMat_val : ∀ (m : List (List poly.PPair)),
    matOcc m = true → (liftMat m).map (List.map POcc.val) = m
  | [], _ => rfl
  | r :: t, h => by
    show (r.map liftT).map POcc.val
      :: (liftMat t).map (List.map POcc.val) = r :: t
    rw [liftRow_val r (matOcc_cons h).1, liftMat_val t (matOcc_cons h).2]

/-! The lifted matrix's shape reads, and the fold's projection back
to the raw pair carrier: the occupied ops project to the displayed
reads value by value, so the fold at the occupied carrier is the
raw fold at the values. -/

private theorem liftMat_rowsLen (n : Nat) :
    ∀ m : List (List poly.PPair),
    rowsLen n m → rowsLen n (liftMat m)
  | [], _ => trivial
  | r :: t, hL =>
    ⟨(ground.length_map liftT r).trans hL.1,
     liftMat_rowsLen n t hL.2⟩

private theorem valMat_erase : ∀ (rest : List (List POcc)) (j : Nat),
    (rest.map (fun l => l.eraseIdx j)).map (List.map POcc.val)
      = (rest.map (List.map POcc.val)).map (fun l => l.eraseIdx j)
  | [], _ => rfl
  | l :: t, j => by
    show (l.eraseIdx j).map POcc.val
      :: (t.map (fun l => l.eraseIdx j)).map (List.map POcc.val)
      = (l.map POcc.val).eraseIdx j
      :: (t.map (List.map POcc.val)).map (fun l => l.eraseIdx j)
    rw [eraseIdx_map POcc.val l j, valMat_erase t j]

private theorem projRow (fP : List (List POcc) → POcc)
    (fraw : List (List poly.PPair) → poly.PPair)
    (hf : ∀ N, (fP N).val = fraw (N.map (List.map POcc.val))) :
    ∀ (odd : Bool) (j : Nat) (r : List POcc)
      (rest : List (List POcc)),
    (minorRowO opsP pnrmP id fP odd j r rest).val
      = minorRowO poly.ppairOps poly.pnormPair id fraw odd j
        (r.map POcc.val) (rest.map (List.map POcc.val))
  | odd, j, [], _ => by cases odd <;> rfl
  | odd, j, a :: r', rest => by
    cases odd with
    | false =>
      show poly.pAdd
        (poly.pnormPair (poly.pMul a.val
          (fP (rest.map (fun l => l.eraseIdx j))).val))
        ((minorRowO opsP pnrmP id fP true (j + 1) r' rest).val)
        = poly.pAdd
          (poly.pnormPair (poly.pMul a.val
            (fraw ((rest.map (List.map POcc.val)).map
              (fun l => l.eraseIdx j)))))
          (minorRowO poly.ppairOps poly.pnormPair id fraw true
            (j + 1) (r'.map POcc.val)
            (rest.map (List.map POcc.val)))
      rw [hf (rest.map (fun l => l.eraseIdx j)), valMat_erase rest j,
        projRow fP fraw hf true (j + 1) r' rest]
    | true =>
      show poly.pAdd
        (poly.pSwap (poly.pnormPair (poly.pMul a.val
          (fP (rest.map (fun l => l.eraseIdx j))).val)))
        ((minorRowO opsP pnrmP id fP false (j + 1) r' rest).val)
        = poly.pAdd
          (poly.pSwap (poly.pnormPair (poly.pMul a.val
            (fraw ((rest.map (List.map POcc.val)).map
              (fun l => l.eraseIdx j))))))
          (minorRowO poly.ppairOps poly.pnormPair id fraw false
            (j + 1) (r'.map POcc.val)
            (rest.map (List.map POcc.val)))
      rw [hf (rest.map (fun l => l.eraseIdx j)), valMat_erase rest j,
        projRow fP fraw hf false (j + 1) r' rest]

private theorem projF : ∀ (fuel : Nat) (M : List (List POcc)),
    (minorFO opsP pnrmP id fuel M).val
      = minorFO poly.ppairOps poly.pnormPair id fuel
        (M.map (List.map POcc.val))
  | 0, _ => rfl
  | _ + 1, [] => rfl
  | _ + 1, r :: [] => by
    show (r.headD opsP.unit).val = (r.map POcc.val).headD poly.pZero
    cases r with
    | nil => rfl
    | cons _ _ => rfl
  | fuel + 1, r :: r2 :: rest =>
    projRow _ _ (fun N => projF fuel N) false 0 r (r2 :: rest)

/-- The fold at the occupied carrier projects to the raw fold at
the values. -/
private theorem minorO_val (M : List (List POcc)) :
    (minorO opsP pnrmP id M).val
      = minorO poly.ppairOps poly.pnormPair id
        (M.map (List.map POcc.val)) := by
  show (minorFO opsP pnrmP id M.length M).val
    = minorFO poly.ppairOps poly.pnormPair id
      (M.map (List.map POcc.val)).length (M.map (List.map POcc.val))
  rw [ground.length_map]
  exact projF M.length M

/-! The pair carrier's law bundle: the laws and the division data
at the occupied pairs, every field read at the cross-multiplied
one-value relation `ovP`.  The shuffle kit below is the fields'
shared algebra at the polynomial members. -/

/-- The one-monomial unit clears on the right. -/
private theorem mulOneOv (p : poly.Poly) :
    poly.oneValue (poly.mul p poly.one) p :=
  poly.oneValue_trans (poly.mul_comm p poly.one) (poly.one_mul p)

/-- The unit tail names the vacant list's read, the balance-pair
polynomials' spelling. -/
private theorem ovNilOfUt {p : poly.Poly} (h : poly.unitTail p) :
    poly.oneValue p [] :=
  show poly.listOV ground.bpairOps ground.bpairRead p [] from
    poly.lovNilO _ _ h

/-- The vacant list's read names the unit tail, the converse. -/
private theorem utOfOvNil {p : poly.Poly} (h : poly.oneValue p []) :
    poly.unitTail p :=
  poly.utOfNilO _ _
    (show poly.listOV ground.bpairOps ground.bpairRead p [] from h)

/-- The vacant right factor's product reads the vacant list. -/
private theorem mulNilOv (p : poly.Poly) :
    poly.oneValue (poly.mul p []) [] := ovNilOfUt (poly.mul_nil p)

/-- The right factor exchanges with the inner second factor. -/
private theorem mulShuffle (p q r : poly.Poly) :
    poly.oneValue (poly.mul (poly.mul p q) r)
      (poly.mul (poly.mul p r) q) :=
  poly.oneValue_trans (poly.mul_assoc p q r)
    (poly.oneValue_trans (poly.mul_congr p (poly.mul_comm q r))
      (poly.oneValue_symm (poly.mul_assoc p r q)))

/-- Four factors exchange across the outer pair. -/
private theorem mulMulComm24 (p q r s : poly.Poly) :
    poly.oneValue (poly.mul (poly.mul p q) (poly.mul r s))
      (poly.mul (poly.mul p s) (poly.mul r q)) :=
  poly.oneValue_trans
    (poly.mul_congr (poly.mul p q) (poly.mul_comm r s))
    (poly.oneValue_trans (poly.mul_exchange4 p q s r)
      (poly.mul_congr (poly.mul p s) (poly.mul_comm q r)))

/-- Two memberwise reads cross to the pair relation's shape. -/
private theorem crossOf {p p' q q' : poly.Poly}
    (hN : poly.oneValue p p') (hD : poly.oneValue q q') :
    poly.oneValue (poly.mul p q') (poly.mul p' q) :=
  poly.oneValue_trans (poly.mul_congr_left hN q')
    (poly.mul_congr p' (poly.oneValue_symm hD))

/-- The cross read composes at an occupied middle second member,
the cancellation through the occupied factor. -/
theorem cross_trans {x y z : poly.PPair} (hy : ¬ poly.unitTail y.2)
    (h1 : poly.oneValue (poly.mul x.1 y.2) (poly.mul y.1 x.2))
    (h2 : poly.oneValue (poly.mul y.1 z.2) (poly.mul z.1 y.2)) :
    poly.oneValue (poly.mul x.1 z.2) (poly.mul z.1 x.2) :=
  poly.pmul_cancel y.2 _ _ hy
    (poly.oneValue_trans
      (poly.oneValue_trans
        (poly.mul_left_comm y.2 x.1 z.2)
        (poly.oneValue_symm (poly.mul_assoc x.1 y.2 z.2)))
      (poly.oneValue_trans (poly.mul_congr_left h1 z.2)
        (poly.oneValue_trans (mulShuffle y.1 x.2 z.2)
          (poly.oneValue_trans (poly.mul_congr_left h2 x.2)
            (poly.oneValue_trans (mulShuffle z.1 y.2 x.2)
              (poly.mul_comm (poly.mul z.1 x.2) y.2))))))

/-- A unit-tail first member reads the pair at the sum's unit. -/
private theorem povUnit {x : POcc} (h : poly.unitTail x.val.1) :
    ovP x opsP.unit :=
  poly.mul_congr_left (ovNilOfUt h) poly.one

/-- An off-unit pair's first member is occupied. -/
private theorem numOff {x : POcc} (h : ¬ ovP x opsP.unit) :
    ¬ poly.unitTail x.val.1 := fun hu => h (povUnit hu)

/-- The pair carrier's laws at the cross-multiplied read: every
field of the tier's bundle holds at the occupied pairs, the
member-level shuffle kit closing each display. -/
private theorem pairLawsP : DLaws POcc opsP ovP :=
  { ovRefl := fun x => poly.oneValue_refl _
    ovSymm := fun h => poly.oneValue_symm h
    ovTrans := fun {x y z} h1 h2 => cross_trans y.den_off h1 h2
    addCongr := fun h1 h2 => poly.pAdd_cross h1 h2
    mulCongr := fun h1 h2 => poly.pMul_cross h1 h2
    swapCongr := fun h => poly.pSwap_cross h
    addComm := fun x y =>
      crossOf
        (poly.add_comm (poly.mul x.val.1 y.val.2)
          (poly.mul y.val.1 x.val.2))
        (poly.mul_comm x.val.2 y.val.2)
    addAssoc := fun x y z =>
      crossOf
        (poly.oneValue_trans
          (poly.add_congr
            (poly.sum_mul (poly.mul x.val.1 y.val.2)
              (poly.mul y.val.1 x.val.2) z.val.2)
            (poly.oneValue_refl
              (poly.mul z.val.1 (poly.mul x.val.2 y.val.2))))
          (poly.oneValue_trans
            ((polyCoreO (R := ground.bpairRead) bpairLaws).addAssoc (poly.mul (poly.mul x.val.1 y.val.2) z.val.2)
              (poly.mul (poly.mul y.val.1 x.val.2) z.val.2)
              (poly.mul z.val.1 (poly.mul x.val.2 y.val.2)))
            (poly.oneValue_trans
              (poly.add_congr
                (poly.mul_assoc x.val.1 y.val.2 z.val.2)
                (poly.add_congr
                  (mulShuffle y.val.1 x.val.2 z.val.2)
                  (poly.oneValue_trans
                    (poly.oneValue_symm
                      (poly.mul_assoc z.val.1 x.val.2 y.val.2))
                    (mulShuffle z.val.1 x.val.2 y.val.2))))
              (poly.add_congr
                (poly.oneValue_refl
                  (poly.mul x.val.1 (poly.mul y.val.2 z.val.2)))
                (poly.oneValue_symm
                  (poly.sum_mul (poly.mul y.val.1 z.val.2)
                    (poly.mul z.val.1 y.val.2) x.val.2))))))
        (poly.mul_assoc x.val.2 y.val.2 z.val.2)
    mulComm := fun x y =>
      crossOf (poly.mul_comm x.val.1 y.val.1)
        (poly.mul_comm x.val.2 y.val.2)
    mulAssoc := fun x y z =>
      crossOf (poly.mul_assoc x.val.1 y.val.1 z.val.1)
        (poly.mul_assoc x.val.2 y.val.2 z.val.2)
    leftDistrib := fun x y z =>
      poly.oneValue_trans
        (poly.mul_congr_left
          (poly.mul_sum x.val.1 (poly.mul y.val.1 z.val.2)
            (poly.mul z.val.1 y.val.2))
          (poly.mul (poly.mul x.val.2 y.val.2)
            (poly.mul x.val.2 z.val.2)))
        (poly.oneValue_trans
          (poly.sum_mul (poly.mul x.val.1 (poly.mul y.val.1 z.val.2))
            (poly.mul x.val.1 (poly.mul z.val.1 y.val.2))
            (poly.mul (poly.mul x.val.2 y.val.2)
              (poly.mul x.val.2 z.val.2)))
          (poly.oneValue_trans
            (poly.add_congr
              (poly.oneValue_trans
                (poly.mul_congr_left
                  (poly.oneValue_symm
                    (poly.mul_assoc x.val.1 y.val.1 z.val.2))
                  (poly.mul (poly.mul x.val.2 y.val.2)
                    (poly.mul x.val.2 z.val.2)))
                (poly.oneValue_trans
                  (mulMulComm24 (poly.mul x.val.1 y.val.1) z.val.2
                    (poly.mul x.val.2 y.val.2)
                    (poly.mul x.val.2 z.val.2))
                  (poly.mul_congr
                    (poly.mul (poly.mul x.val.1 y.val.1)
                      (poly.mul x.val.2 z.val.2))
                    (poly.mul_assoc x.val.2 y.val.2 z.val.2))))
              (poly.oneValue_trans
                (poly.mul_congr_left
                  (poly.oneValue_symm
                    (poly.mul_assoc x.val.1 z.val.1 y.val.2))
                  (poly.mul (poly.mul x.val.2 y.val.2)
                    (poly.mul x.val.2 z.val.2)))
                (poly.oneValue_trans
                  (poly.mul_exchange4 (poly.mul x.val.1 z.val.1) y.val.2
                    (poly.mul x.val.2 y.val.2)
                    (poly.mul x.val.2 z.val.2))
                  (poly.mul_congr
                    (poly.mul (poly.mul x.val.1 z.val.1)
                      (poly.mul x.val.2 y.val.2))
                    (poly.mul_left_comm y.val.2 x.val.2 z.val.2)))))
            (poly.oneValue_symm
              (poly.sum_mul
                (poly.mul (poly.mul x.val.1 y.val.1)
                  (poly.mul x.val.2 z.val.2))
                (poly.mul (poly.mul x.val.1 z.val.1)
                  (poly.mul x.val.2 y.val.2))
                (poly.mul x.val.2 (poly.mul y.val.2 z.val.2))))))
    swapAdd := fun x y =>
      crossOf
        (poly.oneValue_trans
          (ovOfEq (R := poly.polyRead) (polyCoreO (R := ground.bpairRead) bpairLaws) (poly.neg_sum (poly.mul x.val.1 y.val.2)
            (poly.mul y.val.1 x.val.2)))
          (poly.add_congr
            (poly.oneValue_symm (poly.neg_prod_left x.val.1 y.val.2))
            (poly.oneValue_symm (poly.neg_prod_left y.val.1 x.val.2))))
        (poly.oneValue_refl (poly.mul x.val.2 y.val.2))
    swapSwap := fun x =>
      crossOf (ovOfEq (R := poly.polyRead) (polyCoreO (R := ground.bpairRead) bpairLaws) (poly.neg_neg x.val.1))
        (poly.oneValue_refl x.val.2)
    swapUnit := poly.oneValue_refl []
    mulSwapRight := fun x y =>
      crossOf (ovOfEq (R := poly.polyRead) (polyCoreO (R := ground.bpairRead) bpairLaws) (poly.neg_prod x.val.1 y.val.1).symm)
        (poly.oneValue_refl (poly.mul x.val.2 y.val.2))
    unitAdd := fun x =>
      crossOf (mulOneOv x.val.1) (poly.one_mul x.val.2)
    addUnit := fun x =>
      crossOf
        (poly.oneValue_trans
          (ovOfEq (R := poly.polyRead) (polyCoreO (R := ground.bpairRead) bpairLaws) (poly.add_nil (poly.mul x.val.1 poly.one)))
          (mulOneOv x.val.1))
        (mulOneOv x.val.2)
    mulUnit := fun x =>
      poly.mul_congr_left (mulNilOv x.val.1) poly.one
    swapFix := fun x h => by
      have hbB : unitBL bpairCof.unitB x.val.2 = false :=
        denOffB x.den_off
      have hut : poly.unitTail (poly.mul x.val.1 x.val.2) :=
        poly.unitTail_of_negRead
          (poly.oneValue_trans h (poly.neg_prod_left x.val.1 x.val.2))
      have hA : poly.unitTail x.val.1 := by
        cases hB : unitBL bpairCof.unitB x.val.1 with
        | true => exact unitBL_ut bpairCof x.val.1 hB
        | false =>
          exact (zeroDivL bpairLaws bpairCof hB hbB hut).elim
      exact povUnit hA
    oneMul := fun x =>
      crossOf (poly.one_mul x.val.1) (poly.one_mul x.val.2)
    addCancel := fun {x y x' y'} H Hx =>
      poly.pmul_cancel _ _ _ (mulDenOff x.den_off x'.den_off)
        (poly.oneValue_trans
          (poly.oneValue_symm
            (poly.oneValue_trans
              (poly.mul_congr_left (poly.mul_comm y.val.1 x.val.2)
                (poly.mul x'.val.2 y'.val.2))
              (poly.mul_exchange4 x.val.2 y.val.1 x'.val.2 y'.val.2)))
          (poly.oneValue_trans
            (poly.add_cancel
              (poly.oneValue_trans
                (poly.oneValue_symm
                  (poly.sum_mul (poly.mul x.val.1 y.val.2)
                    (poly.mul y.val.1 x.val.2)
                    (poly.mul x'.val.2 y'.val.2)))
                (poly.oneValue_trans H
                  (poly.sum_mul (poly.mul x'.val.1 y'.val.2)
                    (poly.mul y'.val.1 x'.val.2)
                    (poly.mul x.val.2 y.val.2))))
              (poly.cross_scale Hx))
            (poly.oneValue_trans
              (poly.mul_congr_left (poly.mul_comm y'.val.1 x'.val.2)
                (poly.mul x.val.2 y.val.2))
              (poly.oneValue_trans
                (poly.mul_exchange4 x'.val.2 y'.val.1 x.val.2 y.val.2)
                (poly.mul_congr_left (poly.mul_comm x'.val.2 x.val.2)
                  (poly.mul y'.val.1 y.val.2)))))) }

/-- The pair carrier's division data: the exact cofactor at the
cross products behind the first member's unit test, the test's two
reads, the cancellation through the occupied product, and the
memberwise representative map. -/
private def pairCof : DCof POcc opsP ovP :=
  { cof := fun E P =>
      match hP : decide (poly.unitTail P.val.1) with
      | true => opsP.one
      | false =>
        ⟨(poly.mul E.val.1 P.val.2, poly.mul E.val.2 P.val.1),
         decide_eq_false (mulDenOff E.den_off
           (fun h => Bool.noConfusion
             ((decide_eq_true h).symm.trans hP)))⟩
    unitB := fun x => decide (poly.unitTail x.val.1)
    unitB_true := fun {x} h => povUnit (of_decide_eq_true h)
    unitB_false := fun {x} h hov =>
      Bool.noConfusion
        ((decide_eq_true (utOfOvNil
          (poly.oneValue_trans
            (poly.oneValue_symm (mulOneOv x.val.1))
            hov))).symm.trans h)
    cofSound := fun {P X E} hP _ => by
      split
      next hPa => exact absurd (povUnit (of_decide_eq_true hPa)) hP
      next =>
        exact poly.oneValue_trans
          (poly.mul_congr_left
            (poly.mul_left_comm P.val.1 E.val.1 P.val.2) E.val.2)
          (poly.oneValue_trans
            (poly.mul_assoc E.val.1 (poly.mul P.val.1 P.val.2)
              E.val.2)
            (poly.mul_congr E.val.1
              (poly.oneValue_trans
                (poly.mul_congr_left
                  (poly.mul_comm P.val.1 P.val.2) E.val.2)
                (poly.oneValue_trans
                  (mulShuffle P.val.2 P.val.1 E.val.2)
                  (poly.mul_assoc P.val.2 E.val.2 P.val.1)))))
    mulCancel := fun {P u v} hP h =>
      poly.pmul_cancel _ _ _ (mulDenOff (numOff hP) P.den_off)
        (poly.oneValue_trans
          (poly.oneValue_symm
            (poly.mul_exchange4 P.val.1 u.val.1 P.val.2 v.val.2))
          (poly.oneValue_trans h
            (poly.mul_exchange4 P.val.1 v.val.1 P.val.2 u.val.2)))
    oneOff := fun hov => absurd (utOfOvNil hov) (by decide +kernel)
    nrm := pnrmP
    nrmOv := fun x =>
      crossOf (poly.pnorm_oneValue x.val.1)
        (poly.pnorm_oneValue x.val.2) }

/-- The descent's determinant at the pair carrier: the walk at the
occupied site over the lifted matrix, the first-row fold at its
complement. -/
def pairDetD (m : List (List poly.PPair)) : poly.PPair :=
  match matOcc m with
  | true => (detDO pairCof (liftMat m)).val
  | false => minorO poly.ppairOps poly.pnormPair id m

/-- The walk reads the fold at the square frame, the
cross-multiplied one-value identity on the two pairs — the walk at
the occupied site, the fold's own value at the further frames. -/
theorem pairDetD_eq (m : List (List poly.PPair))
    (hsq : rowsLen m.length m) :
    poly.oneValue
      (poly.mul (pairDetD m).1
        (minorO poly.ppairOps poly.pnormPair id m).2)
      (poly.mul (minorO poly.ppairOps poly.pnormPair id m).1
        (pairDetD m).2) := by
  cases hocc : matOcc m with
  | false =>
    show poly.oneValue
      (poly.mul (match matOcc m with
        | true => (detDO pairCof (liftMat m)).val
        | false => minorO poly.ppairOps poly.pnormPair id m).1
        (minorO poly.ppairOps poly.pnormPair id m).2)
      (poly.mul (minorO poly.ppairOps poly.pnormPair id m).1
        (match matOcc m with
          | true => (detDO pairCof (liftMat m)).val
          | false => minorO poly.ppairOps poly.pnormPair id m).2)
    rw [hocc]
    exact poly.oneValue_refl _
  | true =>
  have hsq' : rowsLen (liftMat m).length (liftMat m) := by
    rw [show (liftMat m).length = m.length from
      ground.length_map (List.map liftT) m]
    exact liftMat_rowsLen m.length m hsq
  have h1 : ovP (detDO pairCof (liftMat m))
      (detO opsP (liftMat m)) :=
    detDO_eq (R := povRead) pairLawsP pairCof (liftMat m) hsq'
  have h2 : ovP (minorO opsP pnrmP id (liftMat m))
      (detO opsP (liftMat m)) :=
    minorO_detO (R := povRead) pairLawsP pnrmP id
      (fun x => pairCof.nrmOv x)
      (fun x => pairLawsP.toDCore.ovRefl x) (liftMat m) hsq'
  have hM : ovP (detDO pairCof (liftMat m))
      (minorO opsP pnrmP id (liftMat m)) :=
    pairLawsP.toDCore.ovTrans h1 (pairLawsP.toDCore.ovSymm h2)
  have hval : (minorO opsP pnrmP id (liftMat m)).val
      = minorO poly.ppairOps poly.pnormPair id m := by
    rw [minorO_val (liftMat m), liftMat_val m hocc]
  have hM' : poly.oneValue
      (poly.mul (detDO pairCof (liftMat m)).val.1
        (minorO poly.ppairOps poly.pnormPair id m).2)
      (poly.mul (minorO poly.ppairOps poly.pnormPair id m).1
        (detDO pairCof (liftMat m)).val.2) := by
    rw [← hval]
    exact hM
  show poly.oneValue
    (poly.mul (match matOcc m with
      | true => (detDO pairCof (liftMat m)).val
      | false => minorO poly.ppairOps poly.pnormPair id m).1
      (minorO poly.ppairOps poly.pnormPair id m).2)
    (poly.mul (minorO poly.ppairOps poly.pnormPair id m).1
      (match matOcc m with
        | true => (detDO pairCof (liftMat m)).val
        | false => minorO poly.ppairOps poly.pnormPair id m).2)
  rw [hocc]
  exact hM'

/-- The walk value's second member is occupied at the occupied
site, the carrier's own datum. -/
theorem pairDetD_den (m : List (List poly.PPair))
    (hocc : matOcc m = true) : ¬ poly.unitTail (pairDetD m).2 := by
  show ¬ poly.unitTail (match matOcc m with
    | true => (detDO pairCof (liftMat m)).val
    | false => minorO poly.ppairOps poly.pnormPair id m).2
  rw [hocc]
  exact (detDO pairCof (liftMat m)).den_off

/-- The fold value's second member is occupied at the occupied
site, the lifted fold's own datum at the values. -/
theorem pairMinor_den (m : List (List poly.PPair))
    (hocc : matOcc m = true) :
    ¬ poly.unitTail (minorO poly.ppairOps poly.pnormPair id m).2 := by
  have hval : (minorO opsP pnrmP id (liftMat m)).val
      = minorO poly.ppairOps poly.pnormPair id m := by
    rw [minorO_val (liftMat m), liftMat_val m hocc]
  rw [← hval]
  exact (minorO opsP pnrmP id (liftMat m)).den_off

/-! The kernel-join tier, `lem:blockcount`(ii)'s arriving sum
datum: the pairing and the memberwise sum read at a matched seam,
the sum's elimination datum `rowJoin` with its width and its
action, and the joined kernel list `kernelJoin` with its width,
its members and its independence. -/

/-- The pairing splits at a matched seam: the joined lists' fold is
the two folds' sum, the seam at the first parts' shared length. -/
theorem dotP_append : ∀ (p v q w : List BPair), p.length = v.length →
    (dotP (p ++ q) (v ++ w)).oneValue (dotP p v + dotP q w)
  | [], [], q, w, _ => BPair.oneValue_symm (BPair.unit_add (dotP q w))
  | [], _ :: _, _, _, hl => nomatch hl
  | _ :: _, [], _, _, hl => nomatch hl
  | a :: p, b :: v, q, w, hl => by
    show (a * b + dotP (p ++ q) (v ++ w)).oneValue
      (a * b + dotP p v + dotP q w)
    exact BPair.oneValue_trans
      (BPair.add_congr (BPair.oneValue_refl (a * b))
        (dotP_append p v q w (Nat.succ.inj hl)))
      (BPair.oneValue_of_eq
        (BPair.add_assoc (a * b) (dotP p v) (dotP q w)).symm)

/-- The componentwise sum splits at a matched seam. -/
theorem vecAdd_app : ∀ (a b c d : List BPair),
    a.length = c.length →
    vecAdd (a ++ b) (c ++ d) = vecAdd a c ++ vecAdd b d
  | [], _, [], _, _ => rfl
  | [], _, _ :: _, _, hl => nomatch hl
  | _ :: _, _, [], _, hl => nomatch hl
  | x :: a, b, y :: c, d, hl => by
    show (x + y) :: vecAdd (a ++ b) (c ++ d)
      = (x + y) :: (vecAdd a c ++ vecAdd b d)
    rw [vecAdd_app a b c d (Nat.succ.inj hl)]

/-- The memberwise sum splits over a join at a matched seam, the
class read the equality's own. -/
theorem vecAdd_append (x y x' y' : List BPair)
    (hl : x.length = x'.length) :
    poly.oneValue (vecAdd (x ++ y) (x' ++ y'))
      (vecAdd x x' ++ vecAdd y y') :=
  poly.oneValue_of_eq (vecAdd_app x y x' y' hl)
/-- The action at the unit family reads the unit tail. -/
theorem matVec_units : ∀ (m : Mat) (k : Nat),
    poly.unitTail (matVec m (List.replicate k BPair.unit)) :=
  fun m k => unitTail_matVec m _ (fun _ _ =>
    dotP_null_tail_right _ _ (poly.unitTail_replicate k))

/-- The sum's elimination datum: the two sides' rows appended
pairwise (`lem:blockcount`(ii)'s summed carrier at `def:elim`'s
matrices). -/
def rowJoin (a b : Mat) : Mat := List.zipWith (· ++ ·) a b

/-- The joined rows at the summed width, at every entry carrier. -/
private theorem rowsLen_zipJoinO {γ : Type} :
    ∀ (na nb : Nat) {P Q : List (List γ)}, rowsLen na P →
      rowsLen nb Q → rowsLen (na + nb) (List.zipWith (· ++ ·) P Q)
  | _, _, [], _, _, _ => trivial
  | _, _, _ :: _, [], _, _ => trivial
  | na, nb, r :: P, s :: Q, hP, hQ => by
    show (r ++ s).length = na + nb
      ∧ rowsLen (na + nb) (List.zipWith (· ++ ·) P Q)
    refine ⟨?_, rowsLen_zipJoinO na nb hP.2 hQ.2⟩
    rw [ground.length_append r s, hP.1, hQ.1]

/-- The joined rows at the summed width. -/
theorem rowsLen_rowJoin : ∀ (na nb : Nat) {P Q : Mat}, rowsLen na P →
    rowsLen nb Q → rowsLen (na + nb) (rowJoin P Q) := by
  intro na nb P Q hP hQ
  exact rowsLen_zipJoinO na nb hP hQ

/-- The class read passes the rowwise join at a shared leading
width. -/
theorem matOne_rowJoin {a : Nat} : ∀ (T T' U U' : Mat),
    rowsLen a T → rowsLen a T' →
    matOneValue T T' → matOneValue U U' →
    matOneValue (rowJoin T U) (rowJoin T' U')
  | [], [], _, _, _, _, _, _ => trivial
  | [], _ :: _, _, _, _, _, hT, _ => hT.elim
  | _ :: _, [], _, _, _, _, hT, _ => hT.elim
  | _ :: _, _ :: _, [], [], _, _, _, _ => trivial
  | _ :: _, _ :: _, [], _ :: _, _, _, _, hU => hU.elim
  | _ :: _, _ :: _, _ :: _, [], _, _, _, hU => hU.elim
  | t :: T, t' :: T', u :: U, u' :: U', hTr, hTr', hT, hU =>
    ⟨poly.oneValue_append t t' u u' (hTr.1.trans hTr'.1.symm)
        hT.1 hU.1,
     matOne_rowJoin T T' U U' hTr.2 hTr'.2 hT.2 hU.2⟩

/-- The summed datum's action splits at the seam: the joined
vector's image is the two sides' images' componentwise sum. -/
theorem matVec_rowJoin : ∀ (na : Nat) (P Q : Mat)
    (v w : List BPair),
    rowsLen na P → v.length = na →
    poly.oneValue (matVec (rowJoin P Q) (v ++ w))
      (vecAdd (matVec P v) (matVec Q w))
  | _, [], _, _, _, _, _ => trivial
  | _, _ :: _, [], _, _, _, _ => trivial
  | na, r :: P, s :: Q, v, w, hP, hv => by
    show (dotN (r ++ s) (v ++ w)).oneValue (dotN r v + dotN s w)
      ∧ poly.oneValue (matVec (rowJoin P Q) (v ++ w))
        (vecAdd (matVec P v) (matVec Q w))
    refine ⟨?_, matVec_rowJoin na P Q v w hP.2 hv⟩
    exact BPair.oneValue_trans
      (BPair.oneValue_trans (dotN_read (r ++ s) (v ++ w))
        (dotP_append r v s w (hP.1.trans hv.symm)))
      (BPair.add_congr (BPair.oneValue_symm (dotN_read r v))
        (BPair.oneValue_symm (dotN_read s w)))


/-! The block-triangular determinant: the expansion at the vacant
slab's head row, the crossing keys reading the sum's unit and the
trailing block's own expansion collecting the diagonal blocks'
product. -/

/-- An erased key past a join's seam erases inside the second
side. -/
private theorem eraseIdx_append_off {α : Type} :
    ∀ (u v : List α) (j : Nat),
      (u ++ v).eraseIdx (u.length + j) = u ++ v.eraseIdx j
  | [], v, j => by
    show v.eraseIdx (0 + j) = v.eraseIdx j
    rw [Nat.zero_add]
  | a :: u, v, j => by
    show (a :: (u ++ v)).eraseIdx (u.length + 1 + j)
      = a :: (u ++ v.eraseIdx j)
    rw [Nat.add_right_comm u.length 1 j]
    show a :: ((u ++ v).eraseIdx (u.length + j))
      = a :: (u ++ v.eraseIdx j)
    rw [eraseIdx_append_off u v j]

/-- A key struck past the pivot's width strikes the coupling slab
alone, row by row. -/
private theorem map_eraseIdx_rowJoin {γ : Type} (k j : Nat) :
    ∀ P B : List (List γ), rowsLen k P →
      (List.zipWith (· ++ ·) P B).map (fun r => r.eraseIdx (k + j))
        = List.zipWith (· ++ ·) P (B.map (fun r => r.eraseIdx j))
  | [], _, _ => rfl
  | _ :: _, [], _ => rfl
  | p :: P, b :: B, h => by
    show (p ++ b).eraseIdx (k + j)
        :: (List.zipWith (· ++ ·) P B).map
          (fun r => r.eraseIdx (k + j))
      = (p ++ b.eraseIdx j)
        :: List.zipWith (· ++ ·) P (B.map (fun r => r.eraseIdx j))
    rw [show (p ++ b).eraseIdx (k + j) = p ++ b.eraseIdx j from by
        rw [← h.1]
        exact eraseIdx_append_off p b j,
      map_eraseIdx_rowJoin k j P B h.2]

/-- A coupling slab of vacant rows leaves the pivot slab alone. -/
private theorem rowJoin_nilRows {γ : Type} :
    ∀ P B : List (List γ), P.length = B.length →
      rowsLen 0 B → List.zipWith (· ++ ·) P B = P
  | [], [], _, _ => rfl
  | [], _ :: _, h, _ => Nat.noConfusion h
  | _ :: _, [], h, _ => Nat.noConfusion h
  | p :: P, b :: B, h, hb => by
    have hbn : b = [] := by
      cases b with
      | nil => rfl
      | cons _ t => exact Nat.noConfusion hb.1
    show (p ++ b) :: List.zipWith (· ++ ·) P B = p :: P
    rw [hbn, ground.append_nil p,
      rowJoin_nilRows P B (Nat.succ.inj h) hb.2]

/-- The expansion at a stated row of a join: the row's entries
against the remaining rows' head cofactors, the signs the row's
own crossing parities. -/
private theorem detO_rowSplit {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (top rest : List (List γ)) (z : List γ)
    (k n : Nat) (htop : top.length = k)
    (hn : (top ++ rest).length = n) :
    R.rel (detO ops (top ++ z :: rest))
      (ground.famFold ops.add ops.unit
        (fun j => sgnPO ops (k + j)
          (ops.mul (ground.getAt ops.unit z j)
            (cof0O ops (top ++ rest) j)))
        (List.range (n + 1))) := by
  have hlen : (top ++ z :: rest).length = k + (z :: rest).length := by
    rw [ground.length_append, htop]
  have hk : k < (top ++ z :: rest).length := by
    rw [hlen]
    exact Nat.succ_le_succ (Nat.le_add_right k rest.length)
  have hget : ground.getAt ([] : List γ) (top ++ z :: rest) k = z := by
    rw [← htop]
    exact ground.getAt_append_add [] top (z :: rest) 0
  have herase : (top ++ z :: rest).eraseIdx k = top ++ rest := by
    rw [← htop]
    exact eraseIdx_append_off top (z :: rest) 0
  have hexp := detO_replace L (top ++ z :: rest) k hk
    (ground.getAt [] (top ++ z :: rest) k)
  rw [ground.set_self [] (top ++ z :: rest) k hk, hget, herase, hn] at hexp
  exact hexp

/-- A fold over a shifted range drops its vacant head: the keys
below the shift read the sum's unit and the further keys are the
shifted family's own. -/
private theorem foldRange_shift {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (f : Nat → γ) (k n N : Nat) (hN : N = k + n)
    (hnull : ∀ j, j < k → R.rel (f j) ops.unit) :
    R.rel (ground.famFold ops.add ops.unit f (List.range N))
      (ground.famFold ops.add ops.unit (fun j => f (k + j))
        (List.range n)) := by
  rw [hN, ground.range_split k n]
  refine L.ovTrans
    (ground.famFold_append_ov (foldLawsOf L) f (List.range k)
      ((List.range n).map (fun c => k + c))) ?_
  rw [ground.famFold_map ops.add ops.unit f (fun c => k + c)
    (List.range n)]
  refine L.ovTrans
    (L.addCongr
      (ground.famFold_null_ov (foldLawsOf L) f (List.range k)
        (fun x hx => hnull x (by
          cases Nat.lt_or_ge x k with
          | inl h => exact h
          | inr h =>
            rw [ground.countOf_range x k,
              if_neg (fun hlt : x < k =>
                Nat.lt_irrefl x (Nat.lt_of_lt_of_le hlt h))] at hx
            exact absurd hx (Nat.lt_irrefl 0))))
      (L.ovRefl _)) ?_
  exact L.unitAdd _

/-- The block-triangular list's determinant at a stated trailing
order: the diagonal blocks' product, the walk along the vacant
slab's rows. -/
private theorem detO_blockTriGo {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (P : List (List γ)) (k : Nat)
    (hPl : P.length = k) (hPr : rowsLen k P) :
    ∀ (m : Nat) (B Rm : List (List γ)), B.length = k → rowsLen m B →
      Rm.length = m → rowsLen m Rm →
      R.rel (detO ops (List.zipWith (· ++ ·) P B
        ++ List.zipWith (· ++ ·)
          (List.replicate m (List.replicate k ops.unit)) Rm))
        (ops.mul (detO ops P) (detO ops Rm))
  | 0, B, Rm, hBl, hBr, hRl, _ => by
    match Rm, hRl with
    | [], _ =>
      show R.rel (detO ops (List.zipWith (· ++ ·) P B ++ []))
        (ops.mul (detO ops P) (detO ops []))
      rw [ground.append_nil (List.zipWith (· ++ ·) P B),
        rowJoin_nilRows P B (hPl.trans hBl.symm) hBr]
      exact L.ovSymm
        (L.ovTrans (L.mulCongr (L.ovRefl (detO ops P)) (detO_nil L))
          (L.ovTrans (L.mulComm (detO ops P) ops.one)
            (L.oneMul (detO ops P))))
    | _ :: _, h => exact Nat.noConfusion h
  | m + 1, B, Rm, hBl, hBr, hRl, hRr => by
    match Rm, hRl, hRr with
    | [], h, _ => exact Nat.noConfusion h
    | r0 :: R', hRl, hRr =>
      have hR'l : R'.length = m := Nat.succ.inj hRl
      have hZ : (List.replicate k ops.unit).length = k :=
        ground.length_replicate ops.unit k
      have htop : (List.zipWith (· ++ ·) P B).length = k :=
        ground.length_zipWith (· ++ ·) P B k hPl hBl
      have hrest : (List.zipWith (· ++ ·)
          (List.replicate m (List.replicate k ops.unit))
          R').length = m :=
        ground.length_zipWith (· ++ ·) _ R' m
          (ground.length_replicate (List.replicate k ops.unit) m) hR'l
      have hsgnU : ∀ s : Nat, R.rel (sgnPO ops s ops.unit) ops.unit := by
        intro s
        show R.rel (if places.parityOf s then ops.swap ops.unit
            else ops.unit) ops.unit
        cases places.parityOf s with
        | true => exact L.swapUnit
        | false => exact L.ovRefl _
      have hsign : ∀ (i : Nat) (Y : γ),
          R.rel (sgnPO ops (k + (k + i)) Y) (sgnPO ops i Y) := by
        intro i Y
        rw [show k + (k + i) = k + k + i from (Nat.add_assoc k k i).symm]
        exact L.ovTrans
          (L.ovSymm (sgnPO_add L.toDCore (k + k) i Y))
          (ovOfEq L.toDCore (sgnPO_even ops k (sgnPO ops i Y)))
      show R.rel (detO ops (List.zipWith (· ++ ·) P B
          ++ (List.replicate k ops.unit ++ r0)
            :: List.zipWith (· ++ ·)
              (List.replicate m (List.replicate k ops.unit))
              R')) (ops.mul (detO ops P) (detO ops (r0 :: R')))
      refine L.ovTrans
        (detO_rowSplit L (List.zipWith (· ++ ·) P B)
          (List.zipWith (· ++ ·)
            (List.replicate m (List.replicate k ops.unit)) R')
          (List.replicate k ops.unit ++ r0) k (k + m) htop
          (by rw [ground.length_append, htop, hrest])) ?_
      refine L.ovTrans
        (foldRange_shift L _ k (m + 1) (k + m + 1)
          (Nat.add_assoc k m 1) (fun j hj => ?_)) ?_
      · refine L.ovTrans
          (sgnPO_congr L.toDCore
            (L.ovTrans
              (L.mulCongr
                (ovOfEq L.toDCore (by
                  rw [ground.getAt_append ops.unit
                      (List.replicate k ops.unit) r0 j,
                    if_pos (show j
                        < (List.replicate k ops.unit).length from by
                      rw [hZ]
                      exact hj),
                    ground.getAt_replicate ops.unit ops.unit k j hj]))
                (L.ovRefl _))
              (mulUnitLeftO L _)))
          (hsgnU (k + j))
      refine L.ovTrans
        (foldO_congr_members L.toDCore _
          (fun j => ops.mul (detO ops P) (sgnPO ops j
            (ops.mul (ground.getAt ops.unit r0 j) (cof0O ops R' j))))
          (List.range (m + 1)) (fun j hj => ?_)) ?_
      · have hjm : j < m + 1 := by
          cases Nat.lt_or_ge j (m + 1) with
          | inl h => exact h
          | inr h =>
            rw [ground.countOf_range j (m + 1),
              if_neg (fun hlt : j < m + 1 =>
                Nat.lt_irrefl j (Nat.lt_of_lt_of_le hlt h))] at hj
            exact absurd hj (Nat.lt_irrefl 0)
        have hent : ground.getAt ops.unit
            (List.replicate k ops.unit ++ r0) (k + j)
            = ground.getAt ops.unit r0 j := by
          have h := ground.getAt_append_add ops.unit
            (List.replicate k ops.unit) r0 j
          rw [hZ] at h
          exact h
        have hstruck : ((List.zipWith (· ++ ·) P B
              ++ List.zipWith (· ++ ·)
                (List.replicate m (List.replicate k ops.unit))
                R').map (fun r => r.eraseIdx (k + j)))
            = List.zipWith (· ++ ·) P (B.map (fun r => r.eraseIdx j))
              ++ List.zipWith (· ++ ·)
                (List.replicate m (List.replicate k ops.unit))
                (R'.map (fun r => r.eraseIdx j)) := by
          rw [ground.map_append, map_eraseIdx_rowJoin k j P B hPr,
            map_eraseIdx_rowJoin k j
              (List.replicate m (List.replicate k ops.unit)) R'
              (rowsLen_replicateO ops.unit k m)]
        have hcof : R.rel (cof0O ops (List.zipWith (· ++ ·) P B
              ++ List.zipWith (· ++ ·)
                (List.replicate m (List.replicate k ops.unit)) R')
            (k + j)) (ops.mul (detO ops P) (cof0O ops R' j)) := by
          refine L.ovTrans
            (cof0O_strike L.toDCore _ (k + j)
              (by
                rw [ground.length_append, htop, hrest]
                exact Nat.add_le_add_left
                  (Nat.le_of_succ_le_succ hjm) k)) ?_
          rw [hstruck]
          have hih := detO_blockTriGo L P k hPl hPr m
            (B.map (fun r => r.eraseIdx j))
            (R'.map (fun r => r.eraseIdx j))
            ((ground.length_map (fun r => List.eraseIdx r j) B).trans hBl)
            (rowsLen_eraseCol m j hjm B hBr)
            ((ground.length_map (fun r => List.eraseIdx r j) R').trans hR'l)
            (rowsLen_eraseCol m j hjm R' hRr.2)
          refine L.ovTrans hih ?_
          exact L.mulCongr (L.ovRefl (detO ops P))
            (L.ovSymm
              (cof0O_strike L.toDCore R' j
                (by
                  rw [hR'l]
                  exact Nat.le_of_succ_le_succ hjm)))
        refine L.ovTrans (hsign j _) ?_
        refine L.ovTrans
          (sgnPO_congr L.toDCore
            (L.ovTrans
              (L.mulCongr (ovOfEq L.toDCore hent) hcof)
              (mulSwapLeftO L.toDCore _ _ _))) ?_
        exact sgnPO_mul L.toDCore j _ _
      refine L.ovTrans (foldO_mul_left L (detO ops P) _ _) ?_
      refine L.mulCongr (L.ovRefl (detO ops P)) (L.ovSymm ?_)
      have hcons := detO_cons L r0 R'
      rw [hR'l] at hcons
      exact hcons

/-- A block-triangular list's determinant is the diagonal blocks'
product: every assignment crossing the vacant block reads an entry
at the sum's unit. -/
private theorem detO_blockTri {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (P B Rm : List (List γ)) (k m : Nat)
    (hPl : P.length = k) (hPr : rowsLen k P)
    (hBl : B.length = k) (hBr : rowsLen m B)
    (hRl : Rm.length = m) (hRr : rowsLen m Rm) :
    R.rel (detO ops (List.zipWith (· ++ ·) P B
      ++ List.zipWith (· ++ ·)
        (List.replicate m (List.replicate k ops.unit)) Rm))
      (ops.mul (detO ops P) (detO ops Rm)) :=
  detO_blockTriGo L P k hPl hPr m B Rm hBl hBr hRl hRr

/-- A block-triangular list's determinant is the diagonal blocks'
product: every assignment crossing the vacant block reads an entry
at the sum's unit. -/
theorem detL_blockTri (P B R : Mat) (k m : Nat) (hP : sqAt P k)
    (hBl : B.length = k) (hBr : rowsLen m B) (hR : sqAt R m) :
    (detL (rowJoin P B
      ++ rowJoin (List.replicate m (List.replicate k BPair.unit)) R)).oneValue
      (detL P * detL R) :=
  detO_blockTri (R := ground.bpairRead) bpairLaws P B R k m
    (sqAt_len hP) (rowsLen_of_sqAt hP) hBl hBr (sqAt_len hR)
    (rowsLen_of_sqAt hR)

/-! The trailing slab's reduction against the leading one: each
trailing row replaced by its own multiple at a scale joined to the
leading rows' combination at a stated coefficient column, the
determinant reading the scale's power at the slab's order —
`lem:inertia`'s unit-triangular congruence at the determinant. -/

/-- A swapped list's row is the row swapped memberwise. -/
theorem getAt_matSwap (A : Mat) (i : Nat) (hi : i < A.length) :
    ground.getAt [] (matSwap A) i = (ground.getAt [] A i).map BPair.swap :=
  ground.getAt_map ([] : List BPair) [] (fun r => r.map BPair.swap) A i hi

/-- A joined row reads the two sides' rows appended. -/
theorem getAt_rowJoin (A B : Mat) (i : Nat) (hA : i < A.length)
    (hB : i < B.length) :
    ground.getAt [] (rowJoin A B) i
      = ground.getAt [] A i ++ ground.getAt [] B i :=
  ground.getAt_zipWith [] [] [] (· ++ ·) A B i hA hB

/-- The matrix one-value read at an entry. -/
theorem matOne_entry {A B : Mat} (h : matOneValue A B) (i j : Nat)
    (hi : i < A.length) :
    (ground.getAt BPair.unit (ground.getAt [] A i) j).oneValue
      (ground.getAt BPair.unit (ground.getAt [] B i) j) :=
  poly.oneValue_getAt j (ground.matched_entry [] h i hi)

/-- The entrywise sum's entry at two rows of one width. -/
theorem entry_matAdd (A B : Mat) (n : Nat) (hA : rowsLen n A)
    (hB : rowsLen n B) (i j : Nat) (hiA : i < A.length) (hiB : i < B.length)
    (hj : j < n) :
    ground.getAt BPair.unit (ground.getAt [] (matAdd A B) i) j
      = ground.getAt BPair.unit (ground.getAt [] A i) j
        + ground.getAt BPair.unit (ground.getAt [] B i) j := by
  rw [getAt_matAdd A B i hiA hiB]
  exact getAt_vecAdd _ _ j (by rw [rowsLen_getAt A i hA hiA]; exact hj)
    (by rw [rowsLen_getAt B i hB hiB]; exact hj)

/-- The memberwise swap's entry. -/
theorem entry_matSwap (A : Mat) (n : Nat) (hA : rowsLen n A)
    (i j : Nat) (hi : i < A.length) (hj : j < n) :
    ground.getAt BPair.unit (ground.getAt [] (matSwap A) i) j
      = (ground.getAt BPair.unit (ground.getAt [] A i) j).swap := by
  rw [getAt_matSwap A i hi]
  exact ground.getAt_map BPair.unit BPair.unit BPair.swap _ j
    (by rw [rowsLen_getAt A i hA hi]; exact hj)

/-- The row-scaled matrix's entry. -/
theorem entry_mapScale (c : BPair) (A : Mat) (n : Nat)
    (hA : rowsLen n A) (i j : Nat) (hi : i < A.length) (hj : j < n) :
    ground.getAt BPair.unit (ground.getAt [] (A.map (vecScale c)) i) j
      = c * ground.getAt BPair.unit (ground.getAt [] A i) j := by
  rw [ground.getAt_map [] [] (vecScale c) A i hi]
  exact getAt_vecScale c _ j (by rw [rowsLen_getAt A i hA hi]; exact hj)

/-- The reduction coefficients at a trailing row: the leading rows
at the coefficient column's balance partners, the row itself at the
scale, every further row vacant. -/
private def redCoefO {γ : Type} (ops : DOps γ) (n k : Nat) (d : γ)
    (c : Nat → Nat → γ) (i : Nat) : List γ :=
  (List.range n).map (fun s =>
    if s < k then ops.swap (c s i)
    else if s = k + i then d else ops.unit)

private theorem length_redCoefO {γ : Type} (ops : DOps γ) (n k : Nat)
    (d : γ) (c : Nat → Nat → γ) (i : Nat) :
    (redCoefO ops n k d c i).length = n :=
  ground.length_mapRange _ n

private theorem getAt_redCoefO {γ : Type} (ops : DOps γ) (n k : Nat)
    (d : γ) (c : Nat → Nat → γ) (i s : Nat) (hs : s < n) :
    ground.getAt ops.unit (redCoefO ops n k d c i) s
      = (if s < k then ops.swap (c s i)
          else if s = k + i then d else ops.unit) := by
  show ground.getAt ops.unit ((List.range n).map _) s = _
  rw [ground.getAt_map_range ops.unit _ n s, if_pos hs]

/-- The trailing rows replaced in turn by their combinations against
the original list. -/
private def redGoO {γ : Type} (ops : DOps γ) (M : List (List γ))
    (k : Nat) (y : Nat → List γ) : Nat → List (List γ)
  | 0 => M
  | i + 1 => List.set (redGoO ops M k y i) (k + i)
      (comboO ops M.length (y i) M)

private theorem length_redGoO {γ : Type} (ops : DOps γ)
    (M : List (List γ)) (k : Nat) (y : Nat → List γ) :
    ∀ i, (redGoO ops M k y i).length = M.length
  | 0 => rfl
  | i + 1 => by
    show (List.set (redGoO ops M k y i) (k + i) _).length = M.length
    rw [ground.length_set, length_redGoO ops M k y i]

private theorem getAt_redGoO_lt {γ : Type} (ops : DOps γ)
    (M : List (List γ)) (k : Nat) (y : Nat → List γ)
    (t : Nat) (ht : t < k) :
    ∀ i, ground.getAt [] (redGoO ops M k y i) t = ground.getAt [] M t
  | 0 => rfl
  | i + 1 => by
    show ground.getAt [] (List.set (redGoO ops M k y i) (k + i) _) t = _
    rw [ground.getAt_set_ne [] _ (k + i) t _ (fun he => by
        rw [he] at ht
        exact Nat.lt_irrefl k
          (Nat.lt_of_le_of_lt (Nat.le_add_right k i) ht)),
      getAt_redGoO_lt ops M k y t ht i]

private theorem getAt_redGoO_ge {γ : Type} (ops : DOps γ)
    (M : List (List γ)) (k : Nat) (y : Nat → List γ) (t : Nat) :
    ∀ i, k + i ≤ t →
      ground.getAt [] (redGoO ops M k y i) t = ground.getAt [] M t
  | 0, _ => rfl
  | i + 1, ht => by
    show ground.getAt [] (List.set (redGoO ops M k y i) (k + i) _) t = _
    rw [ground.getAt_set_ne [] _ (k + i) t _ (fun he => by
        rw [he] at ht
        exact Nat.lt_irrefl _
          (Nat.lt_of_lt_of_le (Nat.lt_succ_self (k + i)) ht)),
      getAt_redGoO_ge ops M k y t i (Nat.le_trans (Nat.le_succ (k + i)) ht)]

private theorem getAt_redGoO_mid {γ : Type} (ops : DOps γ)
    (M : List (List γ)) (k : Nat) (y : Nat → List γ) (i' : Nat) :
    ∀ i, i' < i → k + i ≤ M.length →
      ground.getAt [] (redGoO ops M k y i) (k + i')
        = comboO ops M.length (y i') M
  | 0, h, _ => absurd h (Nat.not_lt_zero i')
  | i + 1, h, hle => by
    show ground.getAt [] (List.set (redGoO ops M k y i) (k + i)
      (comboO ops M.length (y i) M)) (k + i') = _
    by_cases he : i' = i
    · rw [he]
      exact ground.getAt_set_self [] _ _ (k + i)
        (by rw [length_redGoO]; exact Nat.lt_of_succ_le hle)
    · rw [ground.getAt_set_ne [] _ (k + i) (k + i') _
        (fun h2 => he (ground.addCancelL k h2))]
      exact getAt_redGoO_mid ops M k y i' i
        (by
          match Nat.lt_or_ge i' i with
          | .inl hh => exact hh
          | .inr hh =>
            exact absurd (Nat.le_antisymm (Nat.le_of_lt_succ h) hh) he)
        (Nat.le_trans (Nat.le_succ (k + i)) hle)

/-- The reduction's determinant: each replaced row scales the
determinant once, the power at the replaced count. -/
private theorem detO_redGo {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (M : List (List γ)) (k m : Nat) (d : γ) (c : Nat → Nat → γ)
    (hn : M.length = k + m) (hM : rowsLen M.length M) :
    ∀ i, i ≤ m →
      R.rel (detO ops (redGoO ops M k (redCoefO ops M.length k d c) i))
        (ops.mul (poly.powO ops d i) (detO ops M))
  | 0, _ => L.ovSymm (L.oneMul (detO ops M))
  | i + 1, hi => by
    have hki : k + i < M.length := by
      rw [hn]
      exact Nat.add_lt_add_left (Nat.lt_of_succ_le hi) k
    have hlen : (redGoO ops M k (redCoefO ops M.length k d c) i).length
        = M.length := length_redGoO ops M k _ i
    show R.rel (detO ops (List.set
      (redGoO ops M k (redCoefO ops M.length k d c) i) (k + i)
      (comboO ops M.length (redCoefO ops M.length k d c i) M))) _
    have hcomb := detO_comboRow L M
      (redGoO ops M k (redCoefO ops M.length k d c) i)
      (k + i) (by rw [hlen]; exact hki) (by rw [hlen]; exact hM) hlen.symm
      (redCoefO ops M.length k d c i)
      (by rw [hlen]; exact length_redCoefO ops _ _ _ _ _)
      (fun t ht htk => by
        have htn : t < M.length := by
          rw [← hlen]
          exact ht
        by_cases htk' : t < k
        · exact Or.inr (getAt_redGoO_lt ops M k _ t htk' i).symm
        · cases Nat.lt_or_ge t (k + i) with
          | inl _ =>
            refine Or.inl ?_
            rw [getAt_redCoefO ops M.length k d c i t htn,
              if_neg htk', if_neg htk]
            exact L.ovRefl _
          | inr hge =>
            exact Or.inr (getAt_redGoO_ge ops M k _ t i hge).symm)
      (getAt_redGoO_ge ops M k _ (k + i) i (Nat.le_refl _)).symm
    rw [hlen, getAt_redCoefO ops M.length k d c i (k + i) hki,
      if_neg (fun h => Nat.lt_irrefl k
        (Nat.lt_of_le_of_lt (Nat.le_add_right k i) h)),
      if_pos rfl] at hcomb
    refine L.ovTrans hcomb ?_
    refine L.ovTrans
      (L.mulCongr (L.ovRefl d)
        (detO_redGo L M k m d c hn hM i
          (Nat.le_of_lt (Nat.lt_of_succ_le hi)))) ?_
    exact L.ovSymm (L.mulAssoc d (poly.powO ops d i) (detO ops M))

/-- The reduction coefficients' pairing against a column family:
the leading rows' fold at the balance partners joined to the scale
at the row's own key. -/
private theorem redCoefO_dot {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (k m : Nat) (d : γ) (c : Nat → Nat → γ) (i : Nat) (hi : i < m)
    (g : Nat → γ) :
    R.rel (dotO ops (redCoefO ops (k + m) k d c i)
        ((List.range (k + m)).map g))
      (ops.add
        (ground.famFold ops.add ops.unit
          (fun s => ops.mul (ops.swap (c s i)) (g s)) (List.range k))
        (ops.mul d (g (k + i)))) := by
  rw [dotO_map_range ops g (k + m) _ (length_redCoefO ops _ _ _ _ _),
    ground.range_split k m]
  refine L.ovTrans
    (ground.famFold_append_ov (foldLawsOf L) _ (List.range k)
      ((List.range m).map (fun e => k + e))) ?_
  rw [ground.famFold_map ops.add ops.unit _ (fun e => k + e)
    (List.range m)]
  refine L.addCongr ?_ ?_
  · refine foldO_congr_members L.toDCore _ _ (List.range k) ?_
    intro s hs
    have hsk : s < k := ground.ltOfMem hs
    rw [getAt_redCoefO ops (k + m) k d c i s
        (Nat.lt_of_lt_of_le hsk (Nat.le_add_right k m)), if_pos hsk]
    exact L.ovRefl _
  · refine ground.famFold_pick_ov (foldLawsOf L) _ i _ (List.range m)
      (ground.countOf_range_one hi) ?_ ?_
    · rw [getAt_redCoefO ops (k + m) k d c i (k + i)
          (Nat.add_lt_add_left hi k),
        if_neg (fun h => Nat.lt_irrefl k
          (Nat.lt_of_le_of_lt (Nat.le_add_right k i) h)),
        if_pos rfl]
      exact L.ovRefl _
    · intro j hj hji
      rw [getAt_redCoefO ops (k + m) k d c i (k + j)
          (Nat.add_lt_add_left (ground.ltOfMem hj) k),
        if_neg (fun h => Nat.lt_irrefl k
          (Nat.lt_of_le_of_lt (Nat.le_add_right k j) h)),
        if_neg (fun h => hji (ground.addCancelL k h))]
      exact mulUnitLeftO L _

/-- The trailing slab reduced against the leading one: each trailing
row replaced by its own multiple at a scale joined to the leading
rows' combination at a stated coefficient column, the determinant
reading the scale's power at the slab's order against the reduced
list's own.  The reduced slabs enter abstractly, their entries read
by the two stated hypotheses. -/
private theorem detO_slabReduce {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (P B X Y Lr Rr : List (List γ)) (k m : Nat) (d : γ)
    (c : Nat → Nat → γ)
    (hPl : P.length = k) (hPr : rowsLen k P)
    (hBl : B.length = k) (hBr : rowsLen m B)
    (hX : X.length = m) (hXr : rowsLen k X)
    (hYl : Y.length = m) (hYr : rowsLen m Y)
    (hLl : Lr.length = m) (hLr : rowsLen k Lr)
    (hRl : Rr.length = m)
    (hL : ∀ i b, i < m → b < k →
      R.rel (ground.getAt ops.unit (ground.getAt [] Lr i) b)
        (ops.add (ops.mul d (ground.getAt ops.unit (ground.getAt [] X i) b))
          (ops.swap (ground.famFold ops.add ops.unit
            (fun s => ops.mul (c s i)
              (ground.getAt ops.unit (ground.getAt [] P s) b))
            (List.range k)))))
    (hR : ∀ i v, i < m → v < m →
      R.rel (ground.getAt ops.unit (ground.getAt [] Rr i) v)
        (ops.add (ops.mul d (ground.getAt ops.unit (ground.getAt [] Y i) v))
          (ops.swap (ground.famFold ops.add ops.unit
            (fun s => ops.mul (c s i)
              (ground.getAt ops.unit (ground.getAt [] B s) v))
            (List.range k))))) :
    R.rel (ops.mul (poly.powO ops d m)
        (detO ops (List.zipWith (· ++ ·) P B
          ++ List.zipWith (· ++ ·) X Y)))
      (detO ops (List.zipWith (· ++ ·) P B
        ++ List.zipWith (· ++ ·) Lr Rr)) := by
  have hPBl : (List.zipWith (· ++ ·) P B).length = k :=
    ground.length_zipWith (· ++ ·) P B k hPl hBl
  have hXYl : (List.zipWith (· ++ ·) X Y).length = m :=
    ground.length_zipWith (· ++ ·) X Y m hX hYl
  have hMl : (List.zipWith (· ++ ·) P B
      ++ List.zipWith (· ++ ·) X Y).length = k + m := by
    rw [ground.length_append, hPBl, hXYl]
  have hMr : rowsLen (k + m) (List.zipWith (· ++ ·) P B
      ++ List.zipWith (· ++ ·) X Y) :=
    rowsLen_appendO (k + m) (rowsLen_zipJoinO k m hPr hBr)
      (rowsLen_zipJoinO k m hXr hYr)
  have hMr' : rowsLen (List.zipWith (· ++ ·) P B
      ++ List.zipWith (· ++ ·) X Y).length
      (List.zipWith (· ++ ·) P B ++ List.zipWith (· ++ ·) X Y) := by
    rw [hMl]
    exact hMr
  have hLRl : (List.zipWith (· ++ ·) Lr Rr).length = m :=
    ground.length_zipWith (· ++ ·) Lr Rr m hLl hRl
  have hTl : (List.zipWith (· ++ ·) P B
      ++ List.zipWith (· ++ ·) Lr Rr).length = k + m := by
    rw [ground.length_append, hPBl, hLRl]
  refine L.ovTrans
    (L.ovSymm (detO_redGo L (List.zipWith (· ++ ·) P B
      ++ List.zipWith (· ++ ·) X Y) k m d c hMl hMr' m (Nat.le_refl m))) ?_
  refine detO_congr_letters L.toDCore _ _
    (by rw [length_redGoO, hMl, hTl]) ?_
  intro a ha b hb
  rw [length_redGoO, hMl] at ha hb
  by_cases hak : a < k
  · rw [getAt_redGoO_lt ops _ k _ a hak m,
      ground.getAt_append ([] : List γ) (List.zipWith (· ++ ·) P B)
        (List.zipWith (· ++ ·) X Y) a,
      ground.getAt_append ([] : List γ) (List.zipWith (· ++ ·) P B)
        (List.zipWith (· ++ ·) Lr Rr) a,
      hPBl, if_pos hak, if_pos hak]
    exact L.ovRefl _
  · obtain ⟨i, hi⟩ := Nat.le.dest (Nat.le_of_not_lt hak)
    rw [← hi] at ha ⊢
    have him : i < m := by
      match Nat.lt_or_ge i m with
      | .inl h => exact h
      | .inr h =>
        exact absurd ha (Nat.not_lt_of_le (Nat.add_le_add_left h k))
    rw [getAt_redGoO_mid ops _ k _ i m him
      (by rw [hMl]; exact Nat.le_refl _)]
    rw [show ground.getAt ([] : List γ) (List.zipWith (· ++ ·) P B
          ++ List.zipWith (· ++ ·) Lr Rr) (k + i)
        = ground.getAt ([] : List γ) Lr i
          ++ ground.getAt ([] : List γ) Rr i from by
      rw [← hPBl, ground.getAt_append_add ([] : List γ) _ _ i,
        ground.getAt_zipWith [] [] [] (· ++ ·) Lr Rr i
          (by rw [hLl]; exact him) (by rw [hRl]; exact him)]]
    rw [hMl]
    refine L.ovTrans (comboO_getAt L (k + m) _ _ b hMr hb) ?_
    have hcol : (List.zipWith (· ++ ·) P B
          ++ List.zipWith (· ++ ·) X Y).map
          (fun r => ground.getAt ops.unit r b)
        = (List.range (k + m)).map (fun s =>
          ground.getAt ops.unit
            (ground.getAt [] (List.zipWith (· ++ ·) P B
              ++ List.zipWith (· ++ ·) X Y) s) b) := by
      conv => lhs; rw [← ground.range_map_getAt [] (k + m)
        (List.zipWith (· ++ ·) P B ++ List.zipWith (· ++ ·) X Y) hMl]
      exact ground.map_map _ _ _
    rw [hcol]
    refine L.ovTrans (redCoefO_dot L k m d c i him _) ?_
    have hXi : (ground.getAt ([] : List γ) X i).length = k :=
      rowsLen_getAt X i hXr (by rw [hX]; exact him)
    have hLi : (ground.getAt ([] : List γ) Lr i).length = k :=
      rowsLen_getAt Lr i hLr (by rw [hLl]; exact him)
    have hrowki : ground.getAt ([] : List γ)
        (List.zipWith (· ++ ·) P B ++ List.zipWith (· ++ ·) X Y) (k + i)
        = ground.getAt [] X i ++ ground.getAt [] Y i := by
      rw [← hPBl, ground.getAt_append_add ([] : List γ) _ _ i,
        ground.getAt_zipWith [] [] [] (· ++ ·) X Y i
          (by rw [hX]; exact him) (by rw [hYl]; exact him)]
    rw [hrowki, ground.getAt_append ops.unit
      (ground.getAt [] Lr i) (ground.getAt [] Rr i) b, hLi]
    by_cases hbk : b < k
    · rw [if_pos hbk, ground.getAt_append ops.unit
        (ground.getAt [] X i) (ground.getAt [] Y i) b, hXi, if_pos hbk]
      refine L.ovTrans ?_ (L.ovSymm (hL i b him hbk))
      refine L.ovTrans (L.addComm _ _) ?_
      refine L.addCongr (L.ovRefl _) ?_
      refine L.ovTrans ?_ (foldO_swap L.toDCore _ (List.range k))
      refine foldO_congr_members L.toDCore _ _ (List.range k) ?_
      intro s hs
      have hsk : s < k := ground.ltOfMem hs
      rw [ground.getAt_append ([] : List γ) (List.zipWith (· ++ ·) P B)
          (List.zipWith (· ++ ·) X Y) s, hPBl, if_pos hsk,
        ground.getAt_zipWith [] [] [] (· ++ ·) P B s
          (by rw [hPl]; exact hsk) (by rw [hBl]; exact hsk),
        ground.getAt_append ops.unit (ground.getAt [] P s)
          (ground.getAt [] B s) b,
        rowsLen_getAt P s hPr (by rw [hPl]; exact hsk), if_pos hbk]
      exact mulSwapLeft L.toDCore _ _
    · obtain ⟨v, hv⟩ := Nat.le.dest (Nat.le_of_not_lt hbk)
      have hvm : v < m := by
        match Nat.lt_or_ge v m with
        | .inl h => exact h
        | .inr h =>
          rw [← hv] at hb
          exact absurd hb (Nat.not_lt_of_le (Nat.add_le_add_left h k))
      rw [if_neg hbk, ← hv, ground.addSubSelfL k v,
        ground.getAt_append ops.unit (ground.getAt [] X i)
          (ground.getAt [] Y i) (k + v), hXi,
        if_neg (fun h => Nat.lt_irrefl k
          (Nat.lt_of_le_of_lt (Nat.le_add_right k v) h)),
        ground.addSubSelfL k v]
      refine L.ovTrans ?_ (L.ovSymm (hR i v him hvm))
      refine L.ovTrans (L.addComm _ _) ?_
      refine L.addCongr (L.ovRefl _) ?_
      refine L.ovTrans ?_ (foldO_swap L.toDCore _ (List.range k))
      refine foldO_congr_members L.toDCore _ _ (List.range k) ?_
      intro s hs
      have hsk : s < k := ground.ltOfMem hs
      rw [ground.getAt_append ([] : List γ) (List.zipWith (· ++ ·) P B)
          (List.zipWith (· ++ ·) X Y) s, hPBl, if_pos hsk,
        ground.getAt_zipWith [] [] [] (· ++ ·) P B s
          (by rw [hPl]; exact hsk) (by rw [hBl]; exact hsk),
        ground.getAt_append ops.unit (ground.getAt [] P s)
          (ground.getAt [] B s) (k + v),
        rowsLen_getAt P s hPr (by rw [hPl]; exact hsk),
        if_neg (fun h => Nat.lt_irrefl k
          (Nat.lt_of_le_of_lt (Nat.le_add_right k v) h)),
        ground.addSubSelfL k v]
      exact mulSwapLeft L.toDCore _ _

/-- A transposed factor's product entry: the coefficient column
against the second factor's column, one fold over the leading
keys. -/
private theorem transMul_entry (C Z : Mat) (k m w : Nat) (hk : 0 < k)
    (hCl : C.length = k) (hCr : rowsLen m C) (hZl : Z.length = k)
    (hZr : rowsLen w Z) (i b : Nat) (hi : i < m) (hb : b < w) :
    (ground.getAt BPair.unit
      (ground.getAt [] (matMul (transposeM C) Z) i) b).oneValue
      (ground.famFold BPair.add BPair.unit
        (fun s => ground.getAt BPair.unit (ground.getAt [] C s) i
          * ground.getAt BPair.unit (ground.getAt [] Z s) b)
        (List.range k)) := by
  have hCt : (transposeM C).length = m :=
    length_transposeM C hCr (by rw [hCl]; exact hk)
  have hCtr : rowsLen k (transposeM C) :=
    rowsLen_cast hCl (rowsLen_transposeM C)
  have hZt : (transposeM Z).length = w :=
    length_transposeM Z hZr (by rw [hZl]; exact hk)
  have hZtr : rowsLen k (transposeM Z) :=
    rowsLen_cast hZl (rowsLen_transposeM Z)
  rw [getAt_matMul (transposeM C) Z i (by rw [hCt]; exact hi),
    ground.getAt_map ([] : List BPair) BPair.unit _ (transposeM Z) b
      (by rw [hZt]; exact hb)]
  refine BPair.oneValue_trans (dotN_read _ _) ?_
  have hrC : (ground.getAt [] (transposeM C) i).length = k :=
    rowsLen_getAt _ i hCtr (by rw [hCt]; exact hi)
  have hrZ : (ground.getAt [] (transposeM Z) b).length = k :=
    rowsLen_getAt _ b hZtr (by rw [hZt]; exact hb)
  rw [← ground.range_map_getAt BPair.unit k _ hrC,
    ← ground.range_map_getAt BPair.unit k _ hrZ, dotP_map_pair]
  refine ground.foldB_congr_members _ _ (List.range k) ?_
  intro s hs
  have hsk : s < k := ground.ltOfMem hs
  rw [getAt_transposeM BPair.unit C hCr i s hi (by rw [hCl]; exact hsk),
    getAt_transposeM BPair.unit Z hZr b s hb (by rw [hZl]; exact hsk)]
  exact BPair.oneValue_refl _

/-- The trailing slab reduced against the leading one: each trailing
row replaced by its own multiple at a scale joined to the leading
rows' combination at a stated coefficient column, the determinant
reading the scale's power at the slab's order against the reduced
list's own. -/
theorem detL_slabReduce (P B X Y C : Mat) (k m : Nat) (d : BPair)
    (hk : 0 < k) (hP : sqAt P k) (hBl : B.length = k) (hBr : rowsLen m B)
    (hX : X.length = m) (hXr : rowsLen k X) (hY : sqAt Y m)
    (hCl : C.length = k) (hCr : rowsLen m C) :
    (ground.bpow d m * detL (rowJoin P B ++ rowJoin X Y)).oneValue
      (detL (rowJoin P B
        ++ rowJoin
          (matAdd (X.map (vecScale d)) (matSwap (matMul (transposeM C) P)))
          (matAdd (Y.map (vecScale d)) (matSwap (matMul (transposeM C) B))))) := by
  have hPl : P.length = k := sqAt_len hP
  have hPr : rowsLen k P := rowsLen_of_sqAt hP
  have hYl : Y.length = m := sqAt_len hY
  have hYr : rowsLen m Y := rowsLen_of_sqAt hY
  have hCt : (transposeM C).length = m :=
    length_transposeM C hCr (by rw [hCl]; exact hk)
  have hPt : (transposeM P).length = k :=
    length_transposeM P hPr (by rw [hPl]; exact hk)
  have hBt : (transposeM B).length = m :=
    length_transposeM B hBr (by rw [hBl]; exact hk)
  have hCPl : (matMul (transposeM C) P).length = m := by
    rw [length_matMul, hCt]
  have hCPr : rowsLen k (matMul (transposeM C) P) :=
    rowsLen_cast hPt (rowsLen_matMul _ _)
  have hCBl : (matMul (transposeM C) B).length = m := by
    rw [length_matMul, hCt]
  have hCBr : rowsLen m (matMul (transposeM C) B) :=
    rowsLen_cast hBt (rowsLen_matMul _ _)
  have hXsl : (X.map (vecScale d)).length = m := by
    rw [ground.length_map, hX]
  have hXsr : rowsLen k (X.map (vecScale d)) := rowsLen_mapRows _ X k hXr
  have hYsl : (Y.map (vecScale d)).length = m := by
    rw [ground.length_map, hYl]
  have hYsr : rowsLen m (Y.map (vecScale d)) := rowsLen_mapRows _ Y m hYr
  have hSPl : (matSwap (matMul (transposeM C) P)).length = m := by
    rw [length_matSwap, hCPl]
  have hSPr : rowsLen k (matSwap (matMul (transposeM C) P)) :=
    rowsLen_mapRows _ _ k hCPr
  have hSBl : (matSwap (matMul (transposeM C) B)).length = m := by
    rw [length_matSwap, hCBl]
  have hSBr : rowsLen m (matSwap (matMul (transposeM C) B)) :=
    rowsLen_mapRows _ _ m hCBr
  have hLl : (matAdd (X.map (vecScale d))
      (matSwap (matMul (transposeM C) P))).length = m := by
    rw [length_matAdd _ _ (hXsl.trans hSPl.symm), hXsl]
  have hLr : rowsLen k (matAdd (X.map (vecScale d))
      (matSwap (matMul (transposeM C) P))) :=
    rowsLen_matAdd k _ _ hXsr hSPr
  have hRl : (matAdd (Y.map (vecScale d))
      (matSwap (matMul (transposeM C) B))).length = m := by
    rw [length_matAdd _ _ (hYsl.trans hSBl.symm), hYsl]
  refine BPair.oneValue_trans
    (BPair.mul_congr (BPair.oneValue_symm (powO_bpow d m))
      (BPair.oneValue_refl _)) ?_
  refine detO_slabReduce (R := ground.bpairRead) bpairLaws P B X Y
    (matAdd (X.map (vecScale d)) (matSwap (matMul (transposeM C) P)))
    (matAdd (Y.map (vecScale d)) (matSwap (matMul (transposeM C) B)))
    k m d (fun s i => ground.getAt BPair.unit (ground.getAt [] C s) i)
    hPl hPr hBl hBr hX hXr hYl hYr hLl hLr hRl ?_ ?_
  · intro i b him hbk
    show (ground.getAt BPair.unit (ground.getAt []
          (matAdd (X.map (vecScale d))
            (matSwap (matMul (transposeM C) P))) i) b).oneValue
        (d * ground.getAt BPair.unit (ground.getAt [] X i) b
          + (ground.famFold BPair.add BPair.unit
              (fun s => ground.getAt BPair.unit (ground.getAt [] C s) i
                * ground.getAt BPair.unit (ground.getAt [] P s) b)
              (List.range k)).swap)
    rw [getAt_matAdd _ _ i (by rw [hXsl]; exact him)
        (by rw [hSPl]; exact him),
      getAt_vecAdd _ _ b
        (by rw [rowsLen_getAt _ i hXsr (by rw [hXsl]; exact him)]; exact hbk)
        (by rw [rowsLen_getAt _ i hSPr (by rw [hSPl]; exact him)]; exact hbk),
      ground.getAt_map ([] : List BPair) [] (vecScale d) X i
        (by rw [hX]; exact him),
      getAt_vecScale d _ b
        (by rw [rowsLen_getAt X i hXr (by rw [hX]; exact him)]; exact hbk),
      getAt_matSwap _ i (by rw [hCPl]; exact him),
      ground.getAt_map BPair.unit BPair.unit BPair.swap _ b
        (by rw [rowsLen_getAt _ i hCPr (by rw [hCPl]; exact him)]; exact hbk)]
    exact BPair.add_congr (BPair.oneValue_refl _)
      (bpairCore.swapCongr
        (transMul_entry C P k m k hk hCl hCr hPl hPr i b him hbk))
  · intro i v him hvm
    show (ground.getAt BPair.unit (ground.getAt []
          (matAdd (Y.map (vecScale d))
            (matSwap (matMul (transposeM C) B))) i) v).oneValue
        (d * ground.getAt BPair.unit (ground.getAt [] Y i) v
          + (ground.famFold BPair.add BPair.unit
              (fun s => ground.getAt BPair.unit (ground.getAt [] C s) i
                * ground.getAt BPair.unit (ground.getAt [] B s) v)
              (List.range k)).swap)
    rw [getAt_matAdd _ _ i (by rw [hYsl]; exact him)
        (by rw [hSBl]; exact him),
      getAt_vecAdd _ _ v
        (by rw [rowsLen_getAt _ i hYsr (by rw [hYsl]; exact him)]; exact hvm)
        (by rw [rowsLen_getAt _ i hSBr (by rw [hSBl]; exact him)]; exact hvm),
      ground.getAt_map ([] : List BPair) [] (vecScale d) Y i
        (by rw [hYl]; exact him),
      getAt_vecScale d _ v
        (by rw [rowsLen_getAt Y i hYr (by rw [hYl]; exact him)]; exact hvm),
      getAt_matSwap _ i (by rw [hCBl]; exact him),
      ground.getAt_map BPair.unit BPair.unit BPair.swap _ v
        (by rw [rowsLen_getAt _ i hCBr (by rw [hCBl]; exact him)]; exact hvm)]
    exact BPair.add_congr (BPair.oneValue_refl _)
      (bpairCore.swapCongr
        (transMul_entry C B k m m hk hCl hCr hBl hBr i v him hvm))


/-! The determinant's product read at the generic bundle: the
diagonal's own running product, the lower block-triangular split
read through the transpose, the two slabs' rotation at the
crossings' parity, and `lem:inertia`'s two square lists' product
reading its determinant at the factors' own. -/

/-- The diagonal's row count is the stated family's. -/
theorem diagO_len {γ : Type} (ops : DOps γ) (ds : List γ) :
    (diagO ops ds).length = ds.length :=
  ground.matOf_length ds.length ds.length _

/-- The diagonal's rows read the stated family's count. -/
theorem diagO_rows {γ : Type} (ops : DOps γ) (ds : List γ) :
    rowsLen ds.length (diagO ops ds) :=
  rowsLen_matOf ds.length ds.length _

/-- The diagonal's entry: the family's member at the diagonal key,
the sum's unit off it. -/
theorem diagO_entry {γ : Type} (ops : DOps γ) (ds : List γ)
    (i j : Nat) (hi : i < ds.length) (hj : j < ds.length) :
    ground.getAt ops.unit (ground.getAt [] (diagO ops ds) i) j
      = if j = i then ground.getAt ops.unit ds i else ops.unit :=
  ground.matOf_entry [] ops.unit ds.length ds.length _ i j hi hj

/-- The diagonal's row against a vector reads the diagonal member
against the vector's own, the further keys at the sum's unit. -/
theorem diagO_row (ds w : List BPair) (t : Nat)
    (ht : t < ds.length) (hw : w.length = ds.length) :
    (dotN (ground.getAt ([] : List BPair)
        (diagO ground.bpairOps ds) t) w).oneValue
      (ground.getAt BPair.unit ds t * ground.getAt BPair.unit w t) := by
  have hrl : (ground.getAt ([] : List BPair)
      (diagO ground.bpairOps ds) t).length = ds.length :=
    rowsLen_getAt (diagO ground.bpairOps ds) t
      (diagO_rows ground.bpairOps ds)
      (by rw [diagO_len]; exact ht)
  refine BPair.oneValue_trans (dotN_read _ w) ?_
  rw [dotP_comm _ w]
  refine BPair.oneValue_trans
    (dotP_oneIndex w _ t (by rw [hw, hrl]) (by rw [hrl]; exact ht) ?_) ?_
  · intro q hq hne
    rw [hrl] at hq
    rw [show ground.getAt BPair.unit
          (ground.getAt ([] : List BPair) (diagO ground.bpairOps ds) t) q
        = if q = t then ground.getAt BPair.unit ds t else BPair.unit from
        diagO_entry ground.bpairOps ds t q ht hq, if_neg hne]
    exact BPair.oneValue_refl _
  · rw [show ground.getAt BPair.unit
          (ground.getAt ([] : List BPair) (diagO ground.bpairOps ds) t) t
        = if t = t then ground.getAt BPair.unit ds t else BPair.unit from
        diagO_entry ground.bpairOps ds t t ht ht, if_pos rfl]
    exact BPair.oneValue_of_eq (BPair.mul_comm _ _)

/-- A seeded factor leaves the running product. -/
private theorem foldMulO_pull {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) (a : γ) :
    ∀ (ds : List γ) (b : γ),
      R.rel (ds.foldl (fun x e => ops.mul x e) (ops.mul a b))
        (ops.mul a (ds.foldl (fun x e => ops.mul x e) b))
  | [], _ => C.ovRefl _
  | e :: t, b =>
    C.ovTrans (ground.foldl_congr_seed R.rel (fun x e => ops.mul x e)
      (fun e h => C.mulCongr h (C.ovRefl e)) t (C.mulAssoc a b e))
      (foldMulO_pull C a t (ops.mul b e))

/-- The diagonal's determinant is the stated family's own running
product. -/
private theorem detO_diagO {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ∀ ds : List γ,
      R.rel (detO ops (diagO ops ds))
        (ds.foldl (fun a e => ops.mul a e) ops.one)
  | [] => detO_nil L
  | d :: ds => by
    have hsplit : R.rel (detO ops
        (List.zipWith (· ++ ·) [[d]] [List.replicate ds.length ops.unit]
          ++ List.zipWith (· ++ ·)
            (List.replicate ds.length (List.replicate 1 ops.unit))
            (diagO ops ds)))
        (ops.mul (detO ops [[d]]) (detO ops (diagO ops ds))) :=
      detO_blockTri L [[d]] [List.replicate ds.length ops.unit]
        (diagO ops ds) 1 ds.length rfl ⟨rfl, trivial⟩ rfl
        ⟨ground.length_replicate ops.unit ds.length, trivial⟩
        (diagO_len ops ds) (diagO_rows ops ds)
    have hent : R.rel (detO ops (diagO ops (d :: ds)))
        (detO ops
          (List.zipWith (· ++ ·) [[d]] [List.replicate ds.length ops.unit]
            ++ List.zipWith (· ++ ·)
              (List.replicate ds.length (List.replicate 1 ops.unit))
              (diagO ops ds))) := by
      refine detO_congr_letters L.toDCore _ _ ?_ ?_
      · rw [diagO_len, ground.length_append,
          ground.length_zipWith (· ++ ·) [[d]]
            [List.replicate ds.length ops.unit] 1 rfl rfl,
          ground.length_zipWith (· ++ ·)
            (List.replicate ds.length (List.replicate 1 ops.unit))
            (diagO ops ds) ds.length
            (ground.length_replicate _ ds.length) (diagO_len ops ds)]
        show ds.length + 1 = 1 + ds.length
        exact Nat.add_comm ds.length 1
      · intro a ha b hb
        rw [diagO_len] at ha hb
        have haa : a < ds.length + 1 := ha
        have hbb : b < ds.length + 1 := hb
        rw [diagO_entry ops (d :: ds) a b haa hbb]
        cases a with
        | zero =>
          show R.rel (if b = 0 then d else ops.unit)
            (ground.getAt ops.unit
              (d :: List.replicate ds.length ops.unit) b)
          cases b with
          | zero => exact L.ovRefl _
          | succ b' =>
            rw [if_neg (fun he => Nat.noConfusion he)]
            show R.rel ops.unit
              (ground.getAt ops.unit
                (List.replicate ds.length ops.unit) b')
            rw [ground.getAt_replicate ops.unit ops.unit ds.length b'
              (Nat.lt_of_succ_lt_succ hbb)]
            exact L.ovRefl _
        | succ a' =>
          have ha' : a' < ds.length := Nat.lt_of_succ_lt_succ haa
          have hrow : ground.getAt ([] : List γ)
              (List.zipWith (· ++ ·)
                (List.replicate ds.length (List.replicate 1 ops.unit))
                (diagO ops ds)) a'
              = ops.unit :: ground.getAt [] (diagO ops ds) a' := by
            rw [ground.getAt_zipWith [] [] [] (· ++ ·)
                (List.replicate ds.length (List.replicate 1 ops.unit))
                (diagO ops ds) a'
                (by rw [ground.length_replicate]; exact ha')
                (by rw [diagO_len]; exact ha'),
              ground.getAt_replicate ([] : List γ)
                (List.replicate 1 ops.unit) ds.length a' ha']
            rfl
          show R.rel
            (if b = a' + 1 then ground.getAt ops.unit ds a' else ops.unit)
            (ground.getAt ops.unit
              (ground.getAt []
                (List.zipWith (· ++ ·)
                  (List.replicate ds.length (List.replicate 1 ops.unit))
                  (diagO ops ds)) a') b)
          rw [hrow]
          cases b with
          | zero =>
            rw [if_neg (fun he => Nat.noConfusion he)]
            exact L.ovRefl _
          | succ b' =>
            have hb' : b' < ds.length := Nat.lt_of_succ_lt_succ hbb
            show R.rel
              (if b' + 1 = a' + 1 then ground.getAt ops.unit ds a'
                else ops.unit)
              (ground.getAt ops.unit (ground.getAt [] (diagO ops ds) a') b')
            rw [diagO_entry ops ds a' b' ha' hb']
            by_cases he : b' = a'
            · rw [if_pos he, if_pos (congrArg (fun x => x + 1) he)]
              exact L.ovRefl _
            · rw [if_neg he,
                if_neg (fun h2 => he (Nat.succ.inj h2))]
              exact L.ovRefl _
    refine L.ovTrans hent (L.ovTrans hsplit ?_)
    refine L.ovTrans
      (L.mulCongr (detO_single L d) (detO_diagO L ds)) ?_
    show R.rel (ops.mul d (ds.foldl (fun a e => ops.mul a e) ops.one))
      (ds.foldl (fun a e => ops.mul a e) (ops.mul ops.one d))
    exact L.ovSymm
      (L.ovTrans
        (ground.foldl_congr_seed R.rel (fun x e => ops.mul x e)
          (fun e h => L.mulCongr h (L.ovRefl e)) ds
          (L.mulComm ops.one d))
        (foldMulO_pull L.toDCore d ds ops.one))

/-- The diagonal's determinant is the stated family's own running
product. -/
theorem detL_diag (ds : List BPair) :
    (detL (diagO bpairOps ds)).oneValue
      (ds.foldl (fun a d => a * d) (BPair.ofNat 1)) :=
  detO_diagO (R := ground.bpairRead) bpairLaws ds

/-- The polynomial minor collects to the assignment fold at every
square list. -/
theorem minorP_detP (X : List (List poly.Poly))
    (hX : rowsLen X.length X) :
    poly.oneValue (minorO poly.polyOps poly.pnorm id X)
      (detO poly.polyOps X) :=
  minorO_detO (R := poly.polyRead)
    (polyLawsO (R := ground.bpairRead) bpairLaws) poly.pnorm id
    (fun x => poly.pnorm_oneValue x)
    (fun x => lovRefl (R := ground.bpairRead) bpairCore x) X hX

/-- The polynomial diagonal's minor is the stated factors' own
product fold. -/
theorem pminor_diag (ds : List poly.Poly) :
    poly.oneValue
      (minorO poly.polyOps poly.pnorm id (diagO poly.polyOps ds))
      (poly.prodFold ds) :=
  (polyCoreO (R := ground.bpairRead) bpairLaws).ovTrans
    (minorP_detP (diagO poly.polyOps ds)
      (by rw [diagO_len]; exact diagO_rows poly.polyOps ds))
    (detO_diagO (R := poly.polyRead)
      (polyLawsO (R := ground.bpairRead) bpairLaws) ds)


/-- The iterated product at the product's own unit sits there. -/
private theorem powO_one {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ∀ i : Nat, R.rel (poly.powO ops ops.one i) ops.one
  | 0 => L.ovRefl _
  | i + 1 =>
    L.ovTrans (L.oneMul (poly.powO ops ops.one i)) (powO_one L i)

/-- The lower block-triangular list's determinant is the diagonal
blocks' product: the vacant block above the diagonal, the split
read at the exchanged key lists. -/
private theorem detO_blockTriLow {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (P X Rm : List (List γ)) (k m : Nat)
    (hPl : P.length = k) (hPr : rowsLen k P)
    (hXl : X.length = m) (hXr : rowsLen k X)
    (hRl : Rm.length = m) (hRr : rowsLen m Rm) :
    R.rel (detO ops (List.zipWith (· ++ ·) P
        (List.replicate k (List.replicate m ops.unit))
      ++ List.zipWith (· ++ ·) X Rm))
      (ops.mul (detO ops P) (detO ops Rm)) := by
  have hTopl : (List.zipWith (· ++ ·) P
      (List.replicate k (List.replicate m ops.unit))).length = k :=
    ground.length_zipWith (· ++ ·) P _ k hPl
      (ground.length_replicate _ k)
  have hBotl : (List.zipWith (· ++ ·) X Rm).length = m :=
    ground.length_zipWith (· ++ ·) X Rm m hXl hRl
  have hMl : (List.zipWith (· ++ ·) P
      (List.replicate k (List.replicate m ops.unit))
      ++ List.zipWith (· ++ ·) X Rm).length = k + m := by
    rw [ground.length_append, hTopl, hBotl]
  have hMr : rowsLen (k + m) (List.zipWith (· ++ ·) P
      (List.replicate k (List.replicate m ops.unit))
      ++ List.zipWith (· ++ ·) X Rm) :=
    rowsLen_appendO (k + m)
      (rowsLen_zipJoinO k m hPr (rowsLen_replicateO ops.unit m k))
      (rowsLen_zipJoinO k m hXr hRr)
  have hrowP : ∀ t, t < k → ground.getAt ([] : List γ)
      (List.zipWith (· ++ ·) P
        (List.replicate k (List.replicate m ops.unit))
        ++ List.zipWith (· ++ ·) X Rm) t
      = ground.getAt [] P t ++ List.replicate m ops.unit := by
    intro t ht
    rw [ground.getAt_append ([] : List γ) _ _ t, hTopl, if_pos ht,
      ground.getAt_zipWith [] [] [] (· ++ ·) P _ t
        (by rw [hPl]; exact ht)
        (by rw [ground.length_replicate]; exact ht),
      ground.getAt_replicate ([] : List γ)
        (List.replicate m ops.unit) k t ht]
  have hrowX : ∀ t, t < m → ground.getAt ([] : List γ)
      (List.zipWith (· ++ ·) P
        (List.replicate k (List.replicate m ops.unit))
        ++ List.zipWith (· ++ ·) X Rm) (k + t)
      = ground.getAt [] X t ++ ground.getAt [] Rm t := by
    intro t ht
    have h := ground.getAt_append_add ([] : List γ)
      (List.zipWith (· ++ ·) P
        (List.replicate k (List.replicate m ops.unit)))
      (List.zipWith (· ++ ·) X Rm) t
    rw [hTopl] at h
    rw [h, ground.getAt_zipWith [] [] [] (· ++ ·) X Rm t
      (by rw [hXl]; exact ht) (by rw [hRl]; exact ht)]
  have hUtopl : (List.zipWith (· ++ ·) (transM ops k P)
      (ground.matOf k m (fun a b =>
        ground.getAt ops.unit (ground.getAt [] X b) a))).length = k :=
    ground.length_zipWith (· ++ ·) (transM ops k P) _ k
      (transM_len ops k P) (ground.matOf_length k m _)
  have hUl : (List.zipWith (· ++ ·) (transM ops k P)
      (ground.matOf k m (fun a b =>
        ground.getAt ops.unit (ground.getAt [] X b) a))
      ++ List.zipWith (· ++ ·)
        (List.replicate m (List.replicate k ops.unit))
        (transM ops m Rm)).length = k + m := by
    rw [ground.length_append, hUtopl,
      ground.length_zipWith (· ++ ·) _ (transM ops m Rm) m
        (ground.length_replicate _ m) (transM_len ops m Rm)]
  refine L.ovTrans
    (L.ovSymm (transM_det L.toDCore (k + m) _ hMl hMr)) ?_
  refine L.ovTrans
    (detO_congr_letters L.toDCore _
      (List.zipWith (· ++ ·) (transM ops k P)
        (ground.matOf k m (fun a b =>
          ground.getAt ops.unit (ground.getAt [] X b) a))
        ++ List.zipWith (· ++ ·)
          (List.replicate m (List.replicate k ops.unit))
          (transM ops m Rm))
      (by rw [transM_len, hUl]) ?_) ?_
  · intro a ha b hb
    rw [transM_len] at ha hb
    refine ovOfEq L.toDCore ?_
    rw [transM_entry ops (k + m) _ a b ha hb]
    match Nat.lt_or_ge a k with
    | .inl hak =>
      have hUa : ground.getAt ([] : List γ)
          (List.zipWith (· ++ ·) (transM ops k P)
            (ground.matOf k m (fun a b =>
              ground.getAt ops.unit (ground.getAt [] X b) a))
            ++ List.zipWith (· ++ ·)
              (List.replicate m (List.replicate k ops.unit))
              (transM ops m Rm)) a
          = ground.getAt [] (transM ops k P) a
            ++ ground.getAt [] (ground.matOf k m (fun a b =>
              ground.getAt ops.unit (ground.getAt [] X b) a)) a := by
        rw [ground.getAt_append ([] : List γ) _ _ a, hUtopl, if_pos hak,
          ground.getAt_zipWith [] [] [] (· ++ ·) (transM ops k P) _ a
            (by rw [transM_len]; exact hak)
            (by rw [ground.matOf_length]; exact hak)]
      have hPta : (ground.getAt ([] : List γ) (transM ops k P) a).length
          = k :=
        rowsLen_getAt _ a (transM_rows ops k P)
          (by rw [transM_len]; exact hak)
      match Nat.lt_or_ge b k with
      | .inl hbk =>
        rw [hrowP b hbk, hUa,
          ground.getAt_append ops.unit (ground.getAt [] P b) _ a,
          rowsLen_getAt P b hPr (by rw [hPl]; exact hbk), if_pos hak,
          ground.getAt_append ops.unit
            (ground.getAt [] (transM ops k P) a) _ b,
          hPta, if_pos hbk, transM_entry ops k P a b hak hbk]
      | .inr hbk =>
        obtain ⟨b', hb'⟩ := Nat.le.dest hbk
        have hb'm : b' < m := by
          match Nat.lt_or_ge b' m with
          | .inl h => exact h
          | .inr h =>
            rw [← hb'] at hb
            exact absurd hb (Nat.not_lt_of_le (Nat.add_le_add_left h k))
        have h2 := ground.getAt_append_add ops.unit
          (ground.getAt ([] : List γ) (transM ops k P) a)
          (ground.getAt ([] : List γ) (ground.matOf k m (fun a b =>
            ground.getAt ops.unit (ground.getAt [] X b) a)) a) b'
        rw [hPta] at h2
        rw [← hb', hrowX b' hb'm, hUa, h2,
          ground.getAt_append ops.unit (ground.getAt [] X b') _ a,
          rowsLen_getAt X b' hXr (by rw [hXl]; exact hb'm), if_pos hak,
          ground.matOf_entry [] ops.unit k m _ a b' hak hb'm]
    | .inr hak =>
      obtain ⟨a', ha'⟩ := Nat.le.dest hak
      have ha'm : a' < m := by
        match Nat.lt_or_ge a' m with
        | .inl h => exact h
        | .inr h =>
          rw [← ha'] at ha
          exact absurd ha (Nat.not_lt_of_le (Nat.add_le_add_left h k))
      have hUa : ground.getAt ([] : List γ)
          (List.zipWith (· ++ ·) (transM ops k P)
            (ground.matOf k m (fun a b =>
              ground.getAt ops.unit (ground.getAt [] X b) a))
            ++ List.zipWith (· ++ ·)
              (List.replicate m (List.replicate k ops.unit))
              (transM ops m Rm)) (k + a')
          = List.replicate k ops.unit
            ++ ground.getAt [] (transM ops m Rm) a' := by
        have h := ground.getAt_append_add ([] : List γ)
          (List.zipWith (· ++ ·) (transM ops k P)
            (ground.matOf k m (fun a b =>
              ground.getAt ops.unit (ground.getAt [] X b) a)))
          (List.zipWith (· ++ ·)
            (List.replicate m (List.replicate k ops.unit))
            (transM ops m Rm)) a'
        rw [hUtopl] at h
        rw [h, ground.getAt_zipWith [] [] [] (· ++ ·) _
            (transM ops m Rm) a'
            (by rw [ground.length_replicate]; exact ha'm)
            (by rw [transM_len]; exact ha'm),
          ground.getAt_replicate ([] : List γ)
            (List.replicate k ops.unit) m a' ha'm]
      match Nat.lt_or_ge b k with
      | .inl hbk =>
        have h3 := ground.getAt_append_add ops.unit
          (ground.getAt ([] : List γ) P b)
          (List.replicate m ops.unit) a'
        rw [rowsLen_getAt P b hPr (by rw [hPl]; exact hbk)] at h3
        rw [← ha', hrowP b hbk, h3, hUa,
          ground.getAt_replicate ops.unit ops.unit m a' ha'm,
          ground.getAt_append ops.unit (List.replicate k ops.unit) _ b,
          ground.length_replicate, if_pos hbk,
          ground.getAt_replicate ops.unit ops.unit k b hbk]
      | .inr hbk =>
        obtain ⟨b', hb'⟩ := Nat.le.dest hbk
        have hb'm : b' < m := by
          match Nat.lt_or_ge b' m with
          | .inl h => exact h
          | .inr h =>
            rw [← hb'] at hb
            exact absurd hb (Nat.not_lt_of_le (Nat.add_le_add_left h k))
        have h3 := ground.getAt_append_add ops.unit
          (ground.getAt ([] : List γ) X b')
          (ground.getAt ([] : List γ) Rm b') a'
        rw [rowsLen_getAt X b' hXr (by rw [hXl]; exact hb'm)] at h3
        have h4 := ground.getAt_append_add ops.unit
          (List.replicate k ops.unit)
          (ground.getAt ([] : List γ) (transM ops m Rm) a') b'
        rw [ground.length_replicate] at h4
        rw [← ha', ← hb', hrowX b' hb'm, h3, hUa, h4,
          transM_entry ops m Rm a' b' ha'm hb'm]
  · refine L.ovTrans
      (detO_blockTri L (transM ops k P)
        (ground.matOf k m (fun a b =>
          ground.getAt ops.unit (ground.getAt [] X b) a))
        (transM ops m Rm) k m
        (transM_len ops k P) (transM_rows ops k P)
        (ground.matOf_length k m _) (rowsLen_matOf k m _)
        (transM_len ops m Rm) (transM_rows ops m Rm)) ?_
    exact L.mulCongr (transM_det L.toDCore k P hPl hPr)
      (transM_det L.toDCore m Rm hRl hRr)


/-- The adjacent exchange past a stated prefix swaps the two
members that follow it. -/
private theorem adjSwap_append {α : Type} :
    ∀ (W : List α) (x y : α) (t : List α),
      ground.adjSwap W.length (W ++ x :: y :: t) = W ++ y :: x :: t
  | [], _, _, _ => rfl
  | w :: W, x, y, t => by
    show w :: ground.adjSwap W.length (W ++ x :: y :: t)
      = w :: (W ++ y :: x :: t)
    rw [adjSwap_append W x y t]

/-- A single member joined on the right shifts into the head of
the trailing family. -/
private theorem append_single_shift {α : Type} (W : List α) (v : α)
    (T : List α) : (W ++ [v]) ++ T = W ++ v :: T := by
  rw [ground.append_assoc]
  rfl

/-- The front move past a stated prefix: the member after the
moved slab arrives at the slab's own place. -/
private theorem moveRow_append {α : Type} :
    ∀ (U W : List α) (v : α) (V : List α),
      moveRow U.length W.length (W ++ U ++ v :: V) = W ++ v :: (U ++ V)
  | [], W, v, V => by
    show W ++ [] ++ v :: V = W ++ v :: ([] ++ V)
    rw [ground.append_nil]
    rfl
  | u :: U, W, v, V => by
    have hassoc : W ++ (u :: U) = (W ++ [u]) ++ U :=
      (append_single_shift W u U).symm
    have hlen : (W ++ [u]).length = W.length + 1 := by
      rw [ground.length_append]
      rfl
    show ground.adjSwap W.length
        (moveRow U.length (W.length + 1) (W ++ (u :: U) ++ v :: V))
      = W ++ v :: ((u :: U) ++ V)
    rw [hassoc, ← hlen, moveRow_append U (W ++ [u]) v V,
      append_single_shift W u (v :: (U ++ V))]
    exact adjSwap_append W u v (U ++ V)

/-- The trailing slab rotates past a stated prefix, one
transposition per crossing row pair. -/
private theorem detO_rotGo {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel)
    (U : List (List γ)) :
    ∀ (V W : List (List γ)),
      R.rel (detO ops (W ++ U ++ V))
        (signAtO ops (places.parityOf (U.length * V.length))
          (detO ops (W ++ V ++ U)))
  | [], W => by
    show R.rel (detO ops (W ++ U ++ []))
      (signAtO ops (places.parityOf (U.length * 0))
        (detO ops (W ++ [] ++ U)))
    rw [ground.append_nil (W ++ U), ground.append_nil W]
    exact C.ovRefl _
  | v :: V, W => by
    have hmv := detO_moveRow C U.length W.length (W ++ U ++ (v :: V))
      (by
        rw [ground.length_append, ground.length_append]
        exact Nat.add_lt_add_left (Nat.succ_pos V.length)
          (W.length + U.length))
    rw [moveRow_append U W v V] at hmv
    have hih := detO_rotGo C U V (W ++ [v])
    rw [ground.append_assoc (W ++ [v]) U V,
      append_single_shift W v (U ++ V),
      ground.append_assoc (W ++ [v]) V U,
      append_single_shift W v (V ++ U)] at hih
    have hpar := places.parityOf_add (U.length * V.length) U.length
    show R.rel (detO ops (W ++ U ++ (v :: V)))
      (signAtO ops
        (places.parityOf (U.length * V.length + U.length))
        (detO ops (W ++ (v :: V) ++ U)))
    rw [hpar, ground.append_assoc W (v :: V) U]
    refine C.ovTrans
      (C.ovSymm (C.ovTrans
        (signAtO_congr C (places.parityOf U.length) hmv)
        (signAtO_signAtO C (places.parityOf U.length)
          (detO ops (W ++ U ++ (v :: V)))))) ?_
    refine C.ovTrans
      (signAtO_congr C (places.parityOf U.length) hih) ?_
    exact signAtO_comp C (places.parityOf U.length)
      (places.parityOf (U.length * V.length))
      (detO ops (W ++ v :: (V ++ U)))

/-- The two slabs exchange, one transposition per crossing row
pair: the joined list's determinant is the exchanged join's at the
crossings' parity. -/
private theorem detO_slabRotate {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel)
    (U V : List (List γ)) :
    R.rel (detO ops (U ++ V))
      (signAtO ops (places.parityOf (U.length * V.length))
        (detO ops (V ++ U))) :=
  detO_rotGo C U V []


/-- The seeded running sum is the seed joined to the family's own
fold. -/
private theorem foldlAddO_famFold {γ α : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) (f : α → γ) :
    ∀ (l : List α) (acc : γ),
      R.rel (l.foldl (fun a x => ops.add a (f x)) acc)
        (ops.add acc (ground.famFold ops.add ops.unit f l))
  | [], acc => L.ovSymm (L.addUnit acc)
  | x :: t, acc =>
    L.ovTrans (foldlAddO_famFold L f t (ops.add acc (f x)))
      (L.addAssoc acc (f x) (ground.famFold ops.add ops.unit f t))

/-- The product's entry: the left row against the right column,
one fold over the shared keys. -/
private theorem matMulO_entry {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (A B : List (List γ)) (n w : Nat) (hAr : rowsLen n A)
    (hw : (B.headD []).length = w) (i j : Nat)
    (hi : i < A.length) (hj : j < w) :
    R.rel (ground.getAt ops.unit
        (ground.getAt [] (matMulO ops A B) i) j)
      (ground.famFold ops.add ops.unit
        (fun s => ops.mul
          (ground.getAt ops.unit (ground.getAt [] A i) s)
          (ground.getAt ops.unit (ground.getAt [] B s) j))
        (List.range n)) := by
  have hrow : ground.getAt ([] : List γ) (matMulO ops A B) i
      = (List.range (B.headD ([] : List γ)).length).map (fun q =>
        (List.range (ground.getAt ([] : List γ) A i).length).foldl
          (fun acc t => ops.add acc
            (ops.mul (ground.getAt ops.unit (ground.getAt [] A i) t)
              (ground.getAt ops.unit (ground.getAt [] B t) q)))
          ops.unit) :=
    ground.getAt_map ([] : List γ) ([] : List γ) _ A i hi
  rw [hrow, ground.getAt_map_range ops.unit _ _ j, hw, if_pos hj,
    rowsLen_getAt A i hAr hi]
  refine L.ovTrans (foldlAddO_famFold L _ (List.range n) ops.unit) ?_
  exact L.unitAdd _

/-- The polynomial product's entry: the left row against the right
column, one sum fold over the shared keys, the laws discharged at
the lifted carrier. -/
theorem matMulP_entry (A B : List (List poly.Poly)) (n w : Nat)
    (hAr : rowsLen n A) (hw : (B.headD []).length = w) (i j : Nat)
    (hi : i < A.length) (hj : j < w) :
    poly.oneValue
      (ground.getAt ([] : poly.Poly)
        (ground.getAt ([] : List poly.Poly)
          (matMulO poly.polyOps A B) i) j)
      (ground.famFold poly.add []
        (fun s => poly.mul
          (ground.getAt ([] : poly.Poly)
            (ground.getAt ([] : List poly.Poly) A i) s)
          (ground.getAt ([] : poly.Poly)
            (ground.getAt ([] : List poly.Poly) B s) j))
        (List.range n)) :=
  matMulO_entry (R := poly.polyRead)
    (polyLawsO (R := ground.bpairRead) bpairLaws) A B n w hAr hw i j hi hj

/-- A square's head row carries the stated width, the vacant
order's head the vacant row. -/
theorem headD_len_of {γ : Type} :
    ∀ (B : List (List γ)) (n : Nat), B.length = n → rowsLen n B →
      (B.headD []).length = n
  | [], _, hl, _ => hl
  | _ :: _, _, _, hr => hr.1

/-- The product's rows carry the right factor's head width at
every left factor. -/
theorem rowsLen_matMulO {γ : Type} (ops : DOps γ)
    (A B : List (List γ)) (w : Nat)
    (hw : (B.headD []).length = w) :
    rowsLen w (matMulO ops A B) :=
  rowsLen_map _ w A (fun _ _ => by
    rw [ground.length_mapRange]
    exact hw)

/-- The square count joined to its own count is even: the
crossings of two slabs of one order with the order's own
diagonal. -/
private theorem parityOf_sqAdd : ∀ n : Nat,
    places.parityOf (n * n + n) = false
  | 0 => rfl
  | n + 1 => by
    have harith : (n + 1) * (n + 1) + (n + 1)
        = n * n + n + 2 * (n + 1) := by
      rw [Nat.left_distrib (n + 1) n 1, Nat.mul_one (n + 1),
        Nat.mul_comm (n + 1) n, Nat.mul_succ n n,
        Nat.two_mul (n + 1)]
      exact Nat.add_assoc (n * n + n) (n + 1) (n + 1)
    rw [harith, places.parityOf_add_two_mul (n * n + n) (n + 1)]
    exact parityOf_sqAdd n

/-- The memberwise swap of the product's unit, repeated, folds to
the count's own grading. -/
private theorem foldMulO_negOne {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel) :
    ∀ (n : Nat) (a : γ),
      R.rel ((List.replicate n (ops.swap ops.one)).foldl
          (fun x e => ops.mul x e) a)
        (signAtO ops (places.parityOf n) a)
  | 0, a => L.ovRefl a
  | n + 1, a => by
    show R.rel ((List.replicate n (ops.swap ops.one)).foldl
        (fun x e => ops.mul x e) (ops.mul a (ops.swap ops.one)))
      (signAtO ops (places.parityOf (n + 1)) a)
    refine L.ovTrans
      (foldMulO_negOne L n (ops.mul a (ops.swap ops.one))) ?_
    refine L.ovTrans (signAtO_congr L.toDCore (places.parityOf n)
      (show R.rel (ops.mul a (ops.swap ops.one)) (ops.swap a) from
        L.ovTrans (L.mulSwapRight a ops.one)
          (L.swapCongr (L.ovTrans (L.mulComm a ops.one)
            (L.oneMul a))))) ?_
    refine L.ovTrans
      (signAtO_comp L.toDCore (places.parityOf n) true a) ?_
    show R.rel (signAtO ops (Bool.xor true (places.parityOf n)) a)
      (signAtO ops (!(places.parityOf n)) a)
    cases places.parityOf n with
    | false => exact L.ovRefl _
    | true => exact L.ovRefl _

/-- The grading crosses the product's left slot. -/
private theorem signAtO_mulLeft {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel) (s : Bool) (x y : γ) :
    R.rel (ops.mul (signAtO ops s x) y)
      (signAtO ops s (ops.mul x y)) := by
  cases s with
  | false => exact C.ovRefl _
  | true => exact mulSwapLeft C x y

/-- Two square lists' product reads its determinant at the
factors' own (`lem:inertia`'s product read, the one joined list's
two block-triangular reads at the slab reduction and the slabs'
exchange). -/
private theorem detO_mul {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (A B : List (List γ)) (n : Nat)
    (hAl : A.length = n) (hAr : rowsLen n A)
    (hBl : B.length = n) (hBr : rowsLen n B) :
    R.rel (detO ops (matMulO ops A B))
      (ops.mul (detO ops A) (detO ops B)) := by
  have hNl : (diagO ops (List.replicate n (ops.swap ops.one))).length
      = n := by
    rw [diagO_len, ground.length_replicate]
  have hNr : rowsLen n (diagO ops (List.replicate n (ops.swap ops.one))) := by
    have h := diagO_rows ops (List.replicate n (ops.swap ops.one))
    rw [ground.length_replicate] at h
    exact h
  have hNe : ∀ i j, i < n → j < n →
      ground.getAt ops.unit (ground.getAt []
          (diagO ops (List.replicate n (ops.swap ops.one))) i) j
        = if j = i then ops.swap ops.one else ops.unit := by
    intro i j hi hj
    rw [diagO_entry ops (List.replicate n (ops.swap ops.one)) i j
        (by rw [ground.length_replicate]; exact hi)
        (by rw [ground.length_replicate]; exact hj),
      ground.getAt_replicate ops.unit (ops.swap ops.one) n i hi]
  have hvacl : (List.replicate n (List.replicate n ops.unit)).length = n :=
    ground.length_replicate _ n
  have hvacr : rowsLen n (List.replicate n (List.replicate n ops.unit)) :=
    rowsLen_replicateO ops.unit n n
  have hvace : ∀ i j, i < n → j < n →
      ground.getAt ops.unit (ground.getAt []
        (List.replicate n (List.replicate n ops.unit)) i) j
        = ops.unit := by
    intro i j hi hj
    rw [ground.getAt_replicate ([] : List γ)
        (List.replicate n ops.unit) n i hi,
      ground.getAt_replicate ops.unit ops.unit n j hj]
  have hABl : (matMulO ops A B).length = n :=
    (ground.length_map _ A).trans hAl
  have hABr : rowsLen n (matMulO ops A B) :=
    rowsLen_matMulO ops A B n (headD_len_of B n hBl hBr)
  have hBh : (B.headD []).length = n := headD_len_of B n hBl hBr
  have hstep1 : R.rel (ops.mul (poly.powO ops ops.one n)
      (detO ops (List.zipWith (· ++ ·)
          (diagO ops (List.replicate n (ops.swap ops.one))) B
        ++ List.zipWith (· ++ ·) A
          (List.replicate n (List.replicate n ops.unit)))))
      (detO ops (List.zipWith (· ++ ·)
          (diagO ops (List.replicate n (ops.swap ops.one))) B
        ++ List.zipWith (· ++ ·)
          (List.replicate n (List.replicate n ops.unit))
          (matMulO ops A B))) := by
    refine detO_slabReduce L
      (diagO ops (List.replicate n (ops.swap ops.one))) B A
      (List.replicate n (List.replicate n ops.unit))
      (List.replicate n (List.replicate n ops.unit))
      (matMulO ops A B) n n ops.one
      (fun s i => ops.swap
        (ground.getAt ops.unit (ground.getAt [] A i) s))
      hNl hNr hBl hBr hAl hAr hvacl hvacr hvacl hvacr hABl ?_ ?_
    · intro i b him hbk
      rw [hvace i b him hbk]
      have hfold : R.rel (ground.famFold ops.add ops.unit
          (fun s => ops.mul (ops.swap
              (ground.getAt ops.unit (ground.getAt [] A i) s))
            (ground.getAt ops.unit (ground.getAt []
              (diagO ops (List.replicate n (ops.swap ops.one))) s) b))
          (List.range n))
          (ground.getAt ops.unit (ground.getAt [] A i) b) := by
        refine L.ovTrans (foldO_congr_members L.toDCore _
          (fun s => if b = s
            then ops.mul (ops.swap
              (ground.getAt ops.unit (ground.getAt [] A i) s))
              (ops.swap ops.one)
            else ops.unit) (List.range n) (fun s hs => ?_)) ?_
        · rw [hNe s b (ground.ltOfMem hs) hbk]
          by_cases he : b = s
          · rw [if_pos he, if_pos he]
            exact L.ovRefl _
          · rw [if_neg he, if_neg he]
            exact L.mulUnit _
        · refine L.ovTrans (foldO_pick L _ (List.range n) b
            (ground.countOf_range_one hbk)) ?_
          refine L.ovTrans (L.mulSwapRight _ ops.one) ?_
          refine L.ovTrans (L.swapCongr (L.ovTrans
            (L.mulComm _ ops.one) (L.oneMul _))) ?_
          exact L.swapSwap _
      refine L.ovSymm ?_
      refine L.ovTrans
        (L.addCongr (L.oneMul _) (L.swapCongr hfold)) ?_
      exact annihDerived L
        (ground.getAt ops.unit (ground.getAt [] A i) b)
    · intro i v him hvm
      rw [hvace i v him hvm]
      refine L.ovTrans (matMulO_entry L A B n n hAr hBh i v
        (by rw [hAl]; exact him) hvm) ?_
      refine L.ovSymm ?_
      refine L.ovTrans (L.addCongr (L.mulUnit ops.one) (L.ovRefl _)) ?_
      refine L.ovTrans (L.unitAdd _) ?_
      refine L.ovTrans (L.swapCongr ?_) (L.swapSwap _)
      refine L.ovTrans (foldO_congr_members L.toDCore _
        (fun s => ops.swap (ops.mul
          (ground.getAt ops.unit (ground.getAt [] A i) s)
          (ground.getAt ops.unit (ground.getAt [] B s) v)))
        (List.range n) (fun _ _ => mulSwapLeft L.toDCore _ _)) ?_
      exact foldO_swap L.toDCore _ (List.range n)
  have hM01 : R.rel
      (detO ops (List.zipWith (· ++ ·)
          (diagO ops (List.replicate n (ops.swap ops.one))) B
        ++ List.zipWith (· ++ ·) A
          (List.replicate n (List.replicate n ops.unit))))
      (detO ops (List.zipWith (· ++ ·)
          (diagO ops (List.replicate n (ops.swap ops.one))) B
        ++ List.zipWith (· ++ ·)
          (List.replicate n (List.replicate n ops.unit))
          (matMulO ops A B))) :=
    L.ovTrans (L.ovSymm (L.ovTrans
      (L.mulCongr (powO_one L n) (L.ovRefl _)) (L.oneMul _))) hstep1
  have hstep2 := detO_blockTri L
    (diagO ops (List.replicate n (ops.swap ops.one))) B
    (matMulO ops A B) n n hNl hNr hBl hBr hABl hABr
  have hstep3 := detO_blockTriLow L A
    (diagO ops (List.replicate n (ops.swap ops.one))) B n n
    hAl hAr hNl hNr hBl hBr
  have hstep4 : R.rel
      (detO ops (List.zipWith (· ++ ·)
          (diagO ops (List.replicate n (ops.swap ops.one))) B
        ++ List.zipWith (· ++ ·) A
          (List.replicate n (List.replicate n ops.unit))))
      (signAtO ops (places.parityOf (n * n))
        (detO ops (List.zipWith (· ++ ·) A
            (List.replicate n (List.replicate n ops.unit))
          ++ List.zipWith (· ++ ·)
            (diagO ops (List.replicate n (ops.swap ops.one))) B))) := by
    have h := detO_slabRotate L.toDCore
      (List.zipWith (· ++ ·)
        (diagO ops (List.replicate n (ops.swap ops.one))) B)
      (List.zipWith (· ++ ·) A
        (List.replicate n (List.replicate n ops.unit)))
    rw [ground.length_zipWith (· ++ ·)
        (diagO ops (List.replicate n (ops.swap ops.one))) B n hNl hBl,
      ground.length_zipWith (· ++ ·) A
        (List.replicate n (List.replicate n ops.unit)) n hAl hvacl] at h
    exact h
  have hstep5 : R.rel
      (detO ops (diagO ops (List.replicate n (ops.swap ops.one))))
      (signAtO ops (places.parityOf n) ops.one) :=
    L.ovTrans (detO_diagO L (List.replicate n (ops.swap ops.one)))
      (foldMulO_negOne L n ops.one)
  have h1 : R.rel
      (ops.mul (detO ops (diagO ops (List.replicate n (ops.swap ops.one))))
        (detO ops (matMulO ops A B)))
      (signAtO ops (places.parityOf n) (detO ops (matMulO ops A B))) :=
    L.ovTrans (L.mulCongr hstep5 (L.ovRefl _))
      (L.ovTrans (signAtO_mulLeft L.toDCore (places.parityOf n)
        ops.one (detO ops (matMulO ops A B)))
        (signAtO_congr L.toDCore (places.parityOf n)
          (L.oneMul (detO ops (matMulO ops A B)))))
  have hcomb : R.rel
      (signAtO ops (places.parityOf n) (detO ops (matMulO ops A B)))
      (signAtO ops (places.parityOf (n * n))
        (ops.mul (detO ops A) (detO ops B))) :=
    L.ovTrans (L.ovSymm h1)
      (L.ovTrans (L.ovSymm (L.ovTrans hM01 hstep2))
        (L.ovTrans hstep4
          (signAtO_congr L.toDCore (places.parityOf (n * n)) hstep3)))
  have hfalse : Bool.xor (places.parityOf (n * n)) (places.parityOf n)
      = false := by
    rw [← places.parityOf_add (n * n) n]
    exact parityOf_sqAdd n
  refine L.ovTrans (L.ovSymm (signAtO_signAtO L.toDCore
    (places.parityOf n) (detO ops (matMulO ops A B)))) ?_
  refine L.ovTrans
    (signAtO_congr L.toDCore (places.parityOf n) hcomb) ?_
  refine L.ovTrans (signAtO_comp L.toDCore (places.parityOf n)
    (places.parityOf (n * n))
    (ops.mul (detO ops A) (detO ops B))) ?_
  rw [hfalse]
  exact L.ovRefl _



/-- The pair carrier's product and the bundle's read one entry:
the row against the exchanged key list's column, and the fold over
the shared keys. -/
private theorem matMul_matMulO (A B : Mat) (n : Nat) (h0 : 0 < n)
    (hAl : A.length = n) (hAr : rowsLen n A)
    (hBl : B.length = n) (hBr : rowsLen n B) (i j : Nat)
    (hi : i < n) (hj : j < n) :
    (ground.getAt BPair.unit
        (ground.getAt [] (matMul A B) i) j).oneValue
      (ground.getAt BPair.unit
        (ground.getAt [] (matMulO bpairOps A B) i) j) := by
  have hBt : (transposeM B).length = n :=
    length_transposeM B hBr (by rw [hBl]; exact h0)
  have hBtr : rowsLen n (transposeM B) :=
    rowsLen_cast hBl (rowsLen_transposeM B)
  rw [getAt_matMul A B i (by rw [hAl]; exact hi),
    ground.getAt_map ([] : List BPair) BPair.unit _ (transposeM B) j
      (by rw [hBt]; exact hj)]
  refine BPair.oneValue_trans (dotN_read _ _) ?_
  have hrA : (ground.getAt ([] : List BPair) A i).length = n :=
    rowsLen_getAt A i hAr (by rw [hAl]; exact hi)
  have hrB : (ground.getAt ([] : List BPair) (transposeM B) j).length
      = n := rowsLen_getAt _ j hBtr (by rw [hBt]; exact hj)
  rw [← ground.range_map_getAt BPair.unit n _ hrA,
    ← ground.range_map_getAt BPair.unit n _ hrB, dotP_map_pair]
  refine BPair.oneValue_symm ?_
  refine BPair.oneValue_trans
    (matMulO_entry (R := ground.bpairRead) bpairLaws A B n n hAr
      (headD_len_of B n hBl hBr) i j
      (by rw [hAl]; exact hi) hj) ?_
  refine ground.foldB_congr_members _ _ (List.range n) ?_
  intro s hs
  rw [getAt_transposeM BPair.unit B hBr j s hj
    (by rw [hBl]; exact ground.ltOfMem hs)]
  exact BPair.oneValue_refl _

/-- Two square lists' product reads its determinant at the
factors' own (`lem:inertia`'s two square lists' product
sentence). -/
theorem detL_mul (A B : Mat) (n : Nat) (hA : sqAt A n) (hB : sqAt B n) :
    (detL (matMul A B)).oneValue (detL A * detL B) := by
  have hAl : A.length = n := sqAt_len hA
  have hAr : rowsLen n A := rowsLen_of_sqAt hA
  have hBl : B.length = n := sqAt_len hB
  have hBr : rowsLen n B := rowsLen_of_sqAt hB
  refine BPair.oneValue_trans
    (detL_congr_letters (matMul A B) (matMulO bpairOps A B)
      ((length_matMul A B).trans (ground.length_map _ A).symm) ?_) ?_
  · intro a ha b hb
    rw [length_matMul, hAl] at ha hb
    exact matMul_matMulO A B n
      (Nat.lt_of_le_of_lt (Nat.zero_le a) ha) hAl hAr hBl hBr a b ha hb
  · exact detO_mul (R := ground.bpairRead) bpairLaws A B n
      hAl hAr hBl hBr

/-- The polynomial minor's entrywise congruence: two square
families agreeing at every key inside the square read one
value. -/
theorem minorP_congr (M N : List (List poly.Poly)) (n : Nat)
    (hMl : M.length = n) (hNl : N.length = n)
    (hMr : rowsLen n M) (hNr : rowsLen n N)
    (hent : ∀ a, a < n → ∀ b, b < n → poly.oneValue
      (ground.getAt ([] : poly.Poly) (ground.getAt [] M a) b)
      (ground.getAt ([] : poly.Poly) (ground.getAt [] N a) b)) :
    poly.oneValue (minorO poly.polyOps poly.pnorm id M)
      (minorO poly.polyOps poly.pnorm id N) := by
  have C : DCore poly.Poly poly.polyOps poly.polyRead.rel :=
    polyCoreO (R := ground.bpairRead) bpairLaws
  refine C.ovTrans (minorP_detP M (by rw [hMl]; exact hMr))
    (C.ovTrans ?_
      (C.ovSymm (minorP_detP N (by rw [hNl]; exact hNr))))
  refine detO_congr_letters C M N (hMl.trans hNl.symm)
    (fun a ha b hb => ?_)
  rw [hMl] at ha hb
  exact hent a ha b hb

/-- Two square polynomial lists' product reads its minor at the
factors' own. -/
theorem pminor_mul (A B : List (List poly.Poly)) (n : Nat)
    (hAl : A.length = n) (hAr : rowsLen n A)
    (hBl : B.length = n) (hBr : rowsLen n B) :
    poly.oneValue
      (minorO poly.polyOps poly.pnorm id (matMulO poly.polyOps A B))
      (poly.mul (minorO poly.polyOps poly.pnorm id A)
        (minorO poly.polyOps poly.pnorm id B)) := by
  have C : DCore poly.Poly poly.polyOps poly.polyRead.rel :=
    polyCoreO (R := ground.bpairRead) bpairLaws
  have hABl : (matMulO poly.polyOps A B).length = n :=
    (ground.length_map _ A).trans hAl
  refine C.ovTrans (minorP_detP (matMulO poly.polyOps A B)
    (by
      rw [hABl]
      exact rowsLen_matMulO poly.polyOps A B n
        (headD_len_of B n hBl hBr))) ?_
  refine C.ovTrans (detO_mul (R := poly.polyRead)
    (polyLawsO (R := ground.bpairRead) bpairLaws) A B n
    hAl hAr hBl hBr) ?_
  exact C.mulCongr (C.ovSymm (minorP_detP A (by rw [hAl]; exact hAr)))
    (C.ovSymm (minorP_detP B (by rw [hBl]; exact hBr)))

/-- The scalar list at constant-polynomial entries: every entry
the one-coefficient polynomial at its own scalar. -/
def embedP (M : Mat) : List (List poly.Poly) :=
  M.map (fun r => r.map (fun b => ([b] : poly.Poly)))

/-- The embedded scalar list's minor is the list's own determinant
read as a constant polynomial. -/
theorem pminor_embed (M : Mat) (n : Nat) (hM : sqAt M n) :
    poly.oneValue (minorO poly.polyOps poly.pnorm id (embedP M))
      [detL M] := by
  have hMl : M.length = n := sqAt_len hM
  have hMr : rowsLen n M := rowsLen_of_sqAt hM
  have hEl : (embedP M).length = n := (ground.length_map _ M).trans hMl
  have hEr : rowsLen n (embedP M) := rowsLen_mapRowsO _ M n hMr
  have C : DCore poly.Poly poly.polyOps poly.polyRead.rel :=
    polyCoreO (R := ground.bpairRead) bpairLaws
  refine C.ovTrans (minorP_detP (embedP M) (by rw [hEl]; exact hEr)) ?_
  exact C.ovSymm
    (detO_hom (Rδ := poly.polyRead) bpairOps poly.polyOps C
      (fun b => ([b] : poly.Poly))
      (fun x y => lovRefl (R := ground.bpairRead) bpairCore
        [bpairOps.add x y])
      (fun x y => ⟨BPair.oneValue_symm
        (BPair.add_unit (bpairOps.mul x y)), trivial⟩)
      (fun x => lovRefl (R := ground.bpairRead) bpairCore
        [bpairOps.swap x])
      ⟨BPair.oneValue_refl BPair.unit, trivial⟩
      (lovRefl (R := ground.bpairRead) bpairCore [bpairOps.one]) M)

/-- The two sides' kernel lists joined at the sum's coordinates,
each member extended by the unit family at the other side's
columns (`lem:blockcount`(ii): "the two sides' lists joining"). -/
def kernelJoin (na nb : Nat) (P Q : Mat) : List (List BPair) :=
  (kernelList na P).map (fun c => c ++ List.replicate nb BPair.unit)
  ++ (kernelList nb Q).map (fun c => List.replicate na BPair.unit ++ c)

/-- A family extended on the right by the unit family reads the
summed width. -/
private theorem rowsLen_padR (na nb : Nat) : ∀ L : Mat,
    rowsLen na L →
    rowsLen (na + nb)
      (L.map (fun c => c ++ List.replicate nb BPair.unit))
  | [], _ => trivial
  | r :: L, h => by
    refine ⟨?_, rowsLen_padR na nb L h.2⟩
    show (r ++ List.replicate nb BPair.unit).length = na + nb
    rw [ground.length_append r (List.replicate nb BPair.unit),
      ground.length_replicate BPair.unit nb, h.1]

/-- A family extended on the left by the unit family reads the
summed width. -/
theorem rowsLen_padL (na nb : Nat) : ∀ L : Mat,
    rowsLen nb L →
    rowsLen (na + nb)
      (L.map (fun c => List.replicate na BPair.unit ++ c))
  | [], _ => trivial
  | r :: L, h => by
    refine ⟨?_, rowsLen_padL na nb L h.2⟩
    show (List.replicate na BPair.unit ++ r).length = na + nb
    rw [ground.length_append (List.replicate na BPair.unit) r,
      ground.length_replicate BPair.unit na, h.1]

/-- The joined list's rows at the summed width. -/
theorem kernelJoin_rowsLen : ∀ (na nb : Nat) (P Q : Mat),
    rowsLen (na + nb) (kernelJoin na nb P Q) :=
  fun na nb P Q =>
    rowsLen_append (na + nb)
      (rowsLen_padR na nb (kernelList na P)
        (kernelList_rowsLen na P))
      (rowsLen_padL na nb (kernelList nb Q)
        (kernelList_rowsLen nb Q))

/-- Every joined member is a kernel member of the sum: the side's
solve reads its own datum at the unit and the padded columns read
the other side's at the unit family. -/
theorem kernelJoin_members : ∀ (na nb : Nat) (P Q : Mat),
    rowsLen na P → rowsLen nb Q →
    ∀ k, k < (kernelJoin na nb P Q).length →
      poly.unitTail (matVec (rowJoin P Q)
        (ground.getAt [] (kernelJoin na nb P Q) k)) := by
  intro na nb P Q hP hQ k hk
  have hAl : ((kernelList na P).map
      (fun c => c ++ List.replicate nb BPair.unit)).length
      = (kernelList na P).length := ground.length_map _ _
  have hBl : ((kernelList nb Q).map
      (fun c => List.replicate na BPair.unit ++ c)).length
      = (kernelList nb Q).length := ground.length_map _ _
  have hk' : k < ((kernelList na P).map
        (fun c => c ++ List.replicate nb BPair.unit)).length
      + ((kernelList nb Q).map
        (fun c => List.replicate na BPair.unit ++ c)).length := by
    rw [← ground.length_append]
    exact hk
  show poly.unitTail (matVec (rowJoin P Q)
    (ground.getAt []
      ((kernelList na P).map
          (fun c => c ++ List.replicate nb BPair.unit)
        ++ (kernelList nb Q).map
          (fun c => List.replicate na BPair.unit ++ c)) k))
  rw [ground.getAt_append ([] : List BPair) _ _ k]
  by_cases hkA : k < ((kernelList na P).map
      (fun c => c ++ List.replicate nb BPair.unit)).length
  · rw [if_pos hkA]
    have hkA' : k < (kernelList na P).length := by
      rw [← hAl]; exact hkA
    rw [ground.getAt_map ([] : List BPair) ([] : List BPair)
      (fun c => c ++ List.replicate nb BPair.unit)
      (kernelList na P) k hkA']
    refine poly.oneValue_unitTail
      (matVec_rowJoin na P Q _ (List.replicate nb BPair.unit)
        hP
        (rowsLen_getAt (kernelList na P) k
          (kernelList_rowsLen na P) hkA')) ?_
    exact unitTail_vecAdd_of (kernelList_members na P hP k hkA')
      (matVec_units Q nb)
  · rw [if_neg hkA]
    have hkB : k - ((kernelList na P).map
        (fun c => c ++ List.replicate nb BPair.unit)).length
        < ((kernelList nb Q).map
          (fun c => List.replicate na BPair.unit ++ c)).length :=
      ground.subLt (Nat.le_of_not_lt hkA) hk'
    have hkB' : k - ((kernelList na P).map
        (fun c => c ++ List.replicate nb BPair.unit)).length
        < (kernelList nb Q).length := by
      rw [← hBl]; exact hkB
    rw [ground.getAt_map ([] : List BPair) ([] : List BPair)
      (fun c => List.replicate na BPair.unit ++ c)
      (kernelList nb Q) _ hkB']
    refine poly.oneValue_unitTail
      (matVec_rowJoin na P Q (List.replicate na BPair.unit) _
        hP (ground.length_replicate BPair.unit na)) ?_
    exact unitTail_vecAdd_of (matVec_units P na)
      (kernelList_members nb Q hQ _ hkB')

private theorem combo_padR : ∀ (na nb : Nat) (cs : List BPair)
    (X : Mat), rowsLen na X →
    poly.oneValue
      (combo (na + nb) cs
        (X.map (fun r => r ++ List.replicate nb BPair.unit)))
      (combo na cs X ++ List.replicate nb BPair.unit)
  | na, nb, [], _, _ => by
    show poly.oneValue (List.replicate (na + nb) BPair.unit)
      (List.replicate na BPair.unit ++ List.replicate nb BPair.unit)
    exact poly.unitTail_oneValue (poly.unitTail_replicate (na + nb))
      (unitTail_append (poly.unitTail_replicate na)
        (poly.unitTail_replicate nb))
  | na, nb, _ :: _, [], _ => by
    show poly.oneValue (List.replicate (na + nb) BPair.unit)
      (List.replicate na BPair.unit ++ List.replicate nb BPair.unit)
    exact poly.unitTail_oneValue (poly.unitTail_replicate (na + nb))
      (unitTail_append (poly.unitTail_replicate na)
        (poly.unitTail_replicate nb))
  | na, nb, c :: cs, x :: X, hX => by
    have hsc : vecScale c (x ++ List.replicate nb BPair.unit)
        = vecScale c x ++ vecScale c (List.replicate nb BPair.unit) :=
      ground.map_append (fun t => c * t) x
        (List.replicate nb BPair.unit)
    have h1 : poly.oneValue
        (vecScale c (x ++ List.replicate nb BPair.unit))
        (vecScale c x ++ List.replicate nb BPair.unit) := by
      rw [hsc]
      exact poly.oneValue_append (vecScale c x) (vecScale c x)
        (vecScale c (List.replicate nb BPair.unit))
        (List.replicate nb BPair.unit)
        rfl (poly.oneValue_refl _)
        (poly.unitTail_oneValue
          (unitTail_vecScale c _ (poly.unitTail_replicate nb))
          (poly.unitTail_replicate nb))
    have hL1 : (vecScale c (x ++ List.replicate nb BPair.unit)).length
        = na + nb := by
      rw [length_vecScale, ground.length_append,
        ground.length_replicate, hX.1]
    have hR1 : (vecScale c x ++ List.replicate nb BPair.unit).length
        = na + nb := by
      rw [ground.length_append, length_vecScale,
        ground.length_replicate, hX.1]
    have hL2 : (combo (na + nb) cs
        (X.map (fun r => r ++ List.replicate nb BPair.unit))).length
        = na + nb :=
      length_combo (na + nb) cs _ (rowsLen_padR na nb X hX.2)
    have hR2 : (combo na cs X ++ List.replicate nb BPair.unit).length
        = na + nb := by
      rw [ground.length_append, length_combo na cs X hX.2,
        ground.length_replicate]
    have h3 := polyOne_vecAdd
      (vecScale c (x ++ List.replicate nb BPair.unit))
      (vecScale c x ++ List.replicate nb BPair.unit)
      (combo (na + nb) cs
        (X.map (fun r => r ++ List.replicate nb BPair.unit)))
      (combo na cs X ++ List.replicate nb BPair.unit)
      h1 (combo_padR na nb cs X hX.2)
      (hL1.trans hR1.symm) (hL2.trans hR2.symm)
    have h4 := vecAdd_append (vecScale c x)
      (List.replicate nb BPair.unit) (combo na cs X)
      (List.replicate nb BPair.unit)
      (by rw [length_vecScale, hX.1, length_combo na cs X hX.2])
    have h5 := poly.oneValue_append
      (vecAdd (vecScale c x) (combo na cs X))
      (vecAdd (vecScale c x) (combo na cs X))
      (vecAdd (List.replicate nb BPair.unit)
        (List.replicate nb BPair.unit))
      (List.replicate nb BPair.unit)
      rfl (poly.oneValue_refl _)
      (poly.unitTail_oneValue
        (unitTail_vecAdd_of (poly.unitTail_replicate nb)
          (poly.unitTail_replicate nb))
        (poly.unitTail_replicate nb))
    exact poly.oneValue_trans h3 (poly.oneValue_trans h4 h5)

private theorem combo_padL : ∀ (na nb : Nat) (cs : List BPair)
    (X : Mat), rowsLen nb X →
    poly.oneValue
      (combo (na + nb) cs
        (X.map (fun r => List.replicate na BPair.unit ++ r)))
      (List.replicate na BPair.unit ++ combo nb cs X)
  | na, nb, [], _, _ => by
    show poly.oneValue (List.replicate (na + nb) BPair.unit)
      (List.replicate na BPair.unit ++ List.replicate nb BPair.unit)
    exact poly.unitTail_oneValue (poly.unitTail_replicate (na + nb))
      (unitTail_append (poly.unitTail_replicate na)
        (poly.unitTail_replicate nb))
  | na, nb, _ :: _, [], _ => by
    show poly.oneValue (List.replicate (na + nb) BPair.unit)
      (List.replicate na BPair.unit ++ List.replicate nb BPair.unit)
    exact poly.unitTail_oneValue (poly.unitTail_replicate (na + nb))
      (unitTail_append (poly.unitTail_replicate na)
        (poly.unitTail_replicate nb))
  | na, nb, c :: cs, x :: X, hX => by
    have hsc : vecScale c (List.replicate na BPair.unit ++ x)
        = vecScale c (List.replicate na BPair.unit) ++ vecScale c x :=
      ground.map_append (fun t => c * t)
        (List.replicate na BPair.unit) x
    have h1 : poly.oneValue
        (vecScale c (List.replicate na BPair.unit ++ x))
        (List.replicate na BPair.unit ++ vecScale c x) := by
      rw [hsc]
      exact poly.oneValue_append
        (vecScale c (List.replicate na BPair.unit))
        (List.replicate na BPair.unit)
        (vecScale c x) (vecScale c x)
        (length_vecScale c (List.replicate na BPair.unit))
        (poly.unitTail_oneValue
          (unitTail_vecScale c _ (poly.unitTail_replicate na))
          (poly.unitTail_replicate na))
        (poly.oneValue_refl _)
    have hL1 : (vecScale c (List.replicate na BPair.unit ++ x)).length
        = na + nb := by
      rw [length_vecScale, ground.length_append,
        ground.length_replicate, hX.1]
    have hR1 : (List.replicate na BPair.unit ++ vecScale c x).length
        = na + nb := by
      rw [ground.length_append, ground.length_replicate,
        length_vecScale, hX.1]
    have hL2 : (combo (na + nb) cs
        (X.map (fun r => List.replicate na BPair.unit ++ r))).length
        = na + nb :=
      length_combo (na + nb) cs _ (rowsLen_padL na nb X hX.2)
    have hR2 : (List.replicate na BPair.unit ++ combo nb cs X).length
        = na + nb := by
      rw [ground.length_append, ground.length_replicate,
        length_combo nb cs X hX.2]
    have h3 := polyOne_vecAdd
      (vecScale c (List.replicate na BPair.unit ++ x))
      (List.replicate na BPair.unit ++ vecScale c x)
      (combo (na + nb) cs
        (X.map (fun r => List.replicate na BPair.unit ++ r)))
      (List.replicate na BPair.unit ++ combo nb cs X)
      h1 (combo_padL na nb cs X hX.2)
      (hL1.trans hR1.symm) (hL2.trans hR2.symm)
    have h4 := vecAdd_append (List.replicate na BPair.unit)
      (vecScale c x) (List.replicate na BPair.unit)
      (combo nb cs X) rfl
    have h5 := poly.oneValue_append
      (vecAdd (List.replicate na BPair.unit)
        (List.replicate na BPair.unit))
      (List.replicate na BPair.unit)
      (vecAdd (vecScale c x) (combo nb cs X))
      (vecAdd (vecScale c x) (combo nb cs X))
      (by rw [length_vecAdd (List.replicate na BPair.unit)
          (List.replicate na BPair.unit) na
          (ground.length_replicate BPair.unit na)
          (ground.length_replicate BPair.unit na),
        ground.length_replicate])
      (poly.unitTail_oneValue
        (unitTail_vecAdd_of (poly.unitTail_replicate na)
          (poly.unitTail_replicate na))
        (poly.unitTail_replicate na))
      (poly.oneValue_refl _)
    exact poly.oneValue_trans h3 (poly.oneValue_trans h4 h5)

private theorem append_vecAdd_units : ∀ (na : Nat)
    (v w : List BPair), v.length = na →
    poly.oneValue
      (vecAdd (v ++ List.replicate w.length BPair.unit)
        (List.replicate na BPair.unit ++ w))
      (v ++ w) := by
  intro na v w hv
  have h1 := vecAdd_append v (List.replicate w.length BPair.unit)
    (List.replicate na BPair.unit) w
    (by rw [ground.length_replicate]; exact hv)
  have h2 : poly.oneValue
      (vecAdd v (List.replicate na BPair.unit)) v :=
    vecAdd_null_right v (List.replicate na BPair.unit)
      (by rw [ground.length_replicate]; exact hv)
      (poly.unitTail_replicate na)
  have h3 : poly.oneValue
      (vecAdd (List.replicate w.length BPair.unit) w) w :=
    vecAdd_null_left (List.replicate w.length BPair.unit) w
      (ground.length_replicate BPair.unit w.length)
      (poly.unitTail_replicate w.length)
  have h4 := poly.oneValue_append
    (vecAdd v (List.replicate na BPair.unit)) v
    (vecAdd (List.replicate w.length BPair.unit) w) w
    (by rw [length_vecAdd v (List.replicate na BPair.unit) na hv
        (ground.length_replicate BPair.unit na)]; exact hv.symm)
    h2
    h3
  exact poly.oneValue_trans h1 h4

/-- The joined list is independent: a null combination splits at
the seam into the two sides' null combinations, each side's
independence reading its coefficients at the unit. -/
theorem kernelJoin_indep : ∀ (na nb : Nat) (P Q : Mat),
    rowsLen na P → rowsLen nb Q →
    indepRows (na + nb) (kernelJoin na nb P Q) := by
  intro na nb P Q hP hQ
  refine indep_intro (na + nb) (kernelJoin na nb P Q)
    (kernelJoin_rowsLen na nb P Q) ?_
  intro cs hcs hnull
  have hAr := rowsLen_padR na nb (kernelList na P)
    (kernelList_rowsLen na P)
  have hBr := rowsLen_padL na nb (kernelList nb Q)
    (kernelList_rowsLen nb Q)
  have hcsAB : cs.length = ((kernelList na P).map
        (fun c => c ++ List.replicate nb BPair.unit)).length
      + ((kernelList nb Q).map
        (fun c => List.replicate na BPair.unit ++ c)).length := by
    rw [← ground.length_append]
    exact hcs
  obtain ⟨a, b, hab, hal⟩ := ground.listSplit cs
    ((kernelList na P).map
      (fun c => c ++ List.replicate nb BPair.unit)).length
    (by rw [hcsAB]; exact Nat.le_add_right _ _)
  have hbl : b.length = ((kernelList nb Q).map
      (fun c => List.replicate na BPair.unit ++ c)).length := by
    have h1 : a.length + b.length = ((kernelList na P).map
          (fun c => c ++ List.replicate nb BPair.unit)).length
        + ((kernelList nb Q).map
          (fun c => List.replicate na BPair.unit ++ c)).length := by
      rw [← ground.length_append a b, ← hab]
      exact hcsAB
    rw [hal] at h1
    exact ground.addCancelL _ h1
  have haK : a.length = (kernelList na P).length :=
    hal.trans (ground.length_map _ _)
  have hbK : b.length = (kernelList nb Q).length :=
    hbl.trans (ground.length_map _ _)
  rw [hab] at hnull
  have hn2 : poly.unitTail
      (vecAdd
        (combo (na + nb) a ((kernelList na P).map
          (fun c => c ++ List.replicate nb BPair.unit)))
        (combo (na + nb) b ((kernelList nb Q).map
          (fun c => List.replicate na BPair.unit ++ c)))) :=
    poly.unitTail_oneValue_right hnull
      (combo_append (na + nb) a
        ((kernelList na P).map
          (fun c => c ++ List.replicate nb BPair.unit))
        b
        ((kernelList nb Q).map
          (fun c => List.replicate na BPair.unit ++ c))
        hal hAr hBr)
  have hXl : (combo na a (kernelList na P)).length = na :=
    length_combo na a (kernelList na P) (kernelList_rowsLen na P)
  have hYl : (combo nb b (kernelList nb Q)).length = nb :=
    length_combo nb b (kernelList nb Q) (kernelList_rowsLen nb Q)
  have hn3 : poly.unitTail
      (vecAdd
        (combo na a (kernelList na P)
          ++ List.replicate nb BPair.unit)
        (List.replicate na BPair.unit
          ++ combo nb b (kernelList nb Q))) :=
    poly.unitTail_oneValue_right hn2
      (polyOne_vecAdd
        (combo (na + nb) a ((kernelList na P).map
          (fun c => c ++ List.replicate nb BPair.unit)))
        (combo na a (kernelList na P)
          ++ List.replicate nb BPair.unit)
        (combo (na + nb) b ((kernelList nb Q).map
          (fun c => List.replicate na BPair.unit ++ c)))
        (List.replicate na BPair.unit
          ++ combo nb b (kernelList nb Q))
        (combo_padR na nb a (kernelList na P)
          (kernelList_rowsLen na P))
        (combo_padL na nb b (kernelList nb Q)
          (kernelList_rowsLen nb Q))
        (by
          rw [length_combo (na + nb) a _ hAr, ground.length_append,
            hXl, ground.length_replicate])
        (by
          rw [length_combo (na + nb) b _ hBr, ground.length_append,
            ground.length_replicate, hYl]))
  have hau := append_vecAdd_units na (combo na a (kernelList na P))
    (combo nb b (kernelList nb Q)) hXl
  have hrep : List.replicate (combo nb b (kernelList nb Q)).length
      BPair.unit = List.replicate nb BPair.unit :=
    congrArg (fun t => List.replicate t BPair.unit) hYl
  rw [hrep] at hau
  obtain ⟨hXu, hYu⟩ := unitTail_append_split
    (combo na a (kernelList na P)) (combo nb b (kernelList nb Q))
    (poly.unitTail_oneValue_right hn3 hau)
  rw [hab]
  exact unitTail_append
    (indep_elim (kernelList_indep na P hP) a haK hXu)
    (indep_elim (kernelList_indep nb Q hQ) b hbK hYu)

/-- A member of a framed list reads the stated width. -/
theorem rowsLen_of_mem {n : Nat} {L : Mat}
    (h : rowsLen n L) {r : List BPair} (hr : r ∈ L) :
    r.length = n := by
  match ground.getAt_of_mem ([] : List BPair) hr with
  | ⟨p, hp, hpe⟩ =>
    rw [← hpe]
    exact rowsLen_getAt _ p h hp

/-- The scale distributes over a join, the map's own split. -/
theorem vecScale_append (c : BPair) (u v : List BPair) :
    vecScale c (u ++ v) = vecScale c u ++ vecScale c v :=
  ground.map_append (fun t => c * t) u v

/-- A matrix's flattened rows, the blocks' own coordinates. -/
def flatCat (M : Mat) : List BPair :=
  M.flatMap (fun q => q)

/-- The flatten's one-step read, the definition's own. -/
theorem flatCat_cons (r : List BPair) (M : Mat) :
    flatCat (r :: M) = r ++ flatCat M := rfl

/-- A flattened matrix's width: one entry per row pair at the
stated row width. -/
theorem length_flatCat (w : Nat) :
    ∀ M : Mat, rowsLen w M → (flatCat M).length = M.length * w
  | [], _ => (Nat.zero_mul w).symm
  | a :: M, h => by
    show (a ++ flatCat M).length = (M.length + 1) * w
    rw [ground.length_append a (flatCat M), h.1,
      length_flatCat w M h.2, Nat.mul_comm (M.length + 1) w,
      Nat.mul_comm M.length w]
    exact Nat.add_comm w (w * M.length)

/-- A span read pads on the right: the padded member sits in the
padded list's span, the further columns the unit family's. -/
theorem spanRel_padR : ∀ (na nb : Nat) (X : Mat)
    (v : List BPair), spanRel na X v →
    spanRel (na + nb)
      (X.map (fun r => r ++ List.replicate nb BPair.unit))
      (v ++ List.replicate nb BPair.unit) := by
  intro na nb X v h
  obtain ⟨c₀, cs, hc₀, hcl, hone⟩ := span_elim h
  refine span_intro (na + nb)
    (X.map (fun r => r ++ List.replicate nb BPair.unit))
    (v ++ List.replicate nb BPair.unit)
    (rowsLen_padR na nb X h.1)
    (by rw [ground.length_append, ground.length_replicate, h.2.1])
    ⟨c₀, cs, hc₀, hcl.trans (ground.length_map _ X).symm, ?_⟩
  have hsc : vecScale c₀ (v ++ List.replicate nb BPair.unit)
      = vecScale c₀ v ++ vecScale c₀ (List.replicate nb BPair.unit) :=
    ground.map_append (fun t => c₀ * t) v
      (List.replicate nb BPair.unit)
  have h1 : poly.oneValue
      (vecScale c₀ (v ++ List.replicate nb BPair.unit))
      (combo na cs X ++ List.replicate nb BPair.unit) := by
    rw [hsc]
    exact poly.oneValue_append (vecScale c₀ v) (combo na cs X)
      (vecScale c₀ (List.replicate nb BPair.unit))
      (List.replicate nb BPair.unit)
      ((length_vecScale c₀ v).trans
        (h.2.1.trans (length_combo na cs X h.1).symm))
      hone
      (poly.unitTail_oneValue
        (unitTail_vecScale c₀ _ (poly.unitTail_replicate nb))
        (poly.unitTail_replicate nb))
  exact poly.oneValue_trans h1
    (poly.oneValue_symm (combo_padR na nb cs X h.1))

/-- A span read pads on the left: the padded member sits in the
padded list's span, the leading columns the unit family's. -/
theorem spanRel_padL : ∀ (na nb : Nat) (X : Mat)
    (v : List BPair), spanRel nb X v →
    spanRel (na + nb)
      (X.map (fun r => List.replicate na BPair.unit ++ r))
      (List.replicate na BPair.unit ++ v) := by
  intro na nb X v h
  obtain ⟨c₀, cs, hc₀, hcl, hone⟩ := span_elim h
  refine span_intro (na + nb)
    (X.map (fun r => List.replicate na BPair.unit ++ r))
    (List.replicate na BPair.unit ++ v)
    (rowsLen_padL na nb X h.1)
    (by rw [ground.length_append, ground.length_replicate, h.2.1])
    ⟨c₀, cs, hc₀, hcl.trans (ground.length_map _ X).symm, ?_⟩
  have hsc : vecScale c₀ (List.replicate na BPair.unit ++ v)
      = vecScale c₀ (List.replicate na BPair.unit) ++ vecScale c₀ v :=
    ground.map_append (fun t => c₀ * t)
      (List.replicate na BPair.unit) v
  have h1 : poly.oneValue
      (vecScale c₀ (List.replicate na BPair.unit ++ v))
      (List.replicate na BPair.unit ++ combo nb cs X) := by
    rw [hsc]
    exact poly.oneValue_append
      (vecScale c₀ (List.replicate na BPair.unit))
      (List.replicate na BPair.unit)
      (vecScale c₀ v) (combo nb cs X)
      (length_vecScale c₀ (List.replicate na BPair.unit))
      (poly.unitTail_oneValue
        (unitTail_vecScale c₀ _ (poly.unitTail_replicate na))
        (poly.unitTail_replicate na))
      hone
  exact poly.oneValue_trans h1
    (poly.oneValue_symm (combo_padL na nb cs X h.1))

/-- Every kernel member of the sum sits in the joined list's span:
the member's two coordinate parts are each kernel members of their
own side (`lem:blockcount`(ii)'s split, the stated hypothesis at
the first side with the second's read the sum's cancellation), each
side's kernel list spans its part, and the padded spans join. -/
theorem kernelJoin_span : ∀ (na nb : Nat) (P Q : Mat),
    rowsLen na P → rowsLen nb Q → P.length = Q.length →
    (∀ v w : List BPair, v.length = na → w.length = nb →
      poly.unitTail (matVec (rowJoin P Q) (v ++ w)) →
      poly.unitTail (matVec P v)) →
    ∀ u : List BPair, u.length = na + nb →
      poly.unitTail (matVec (rowJoin P Q) u) →
      spanRel (na + nb) (kernelJoin na nb P Q) u := by
  intro na nb P Q hP hQ hl hyp u hu hker
  obtain ⟨a, b, hab, hal⟩ := ground.listSplit u na
    (by rw [hu]; exact Nat.le_add_right na nb)
  have hbl : b.length = nb := by
    have h1 : a.length + b.length = na + nb := by
      rw [← ground.length_append a b, ← hab]
      exact hu
    rw [hal] at h1
    exact ground.addCancelL na h1
  rw [hab] at hker
  have hA : poly.unitTail (matVec P a) := hyp a b hal hbl hker
  have hsum : poly.unitTail (vecAdd (matVec P a) (matVec Q b)) :=
    poly.unitTail_oneValue_right hker
      (matVec_rowJoin na P Q a b hP hal)
  have hlen : (matVec Q b).length = (matVec P a).length := by
    rw [matVec_length, matVec_length]
    exact hl.symm
  have hsum' : poly.unitTail (vecAdd (matVec Q b) (matVec P a)) := by
    rw [vecAdd_comm (matVec Q b) (matVec P a)]
    exact hsum
  have hB : poly.unitTail (matVec Q b) :=
    unitTail_split_left hlen hsum' hA
  have hAr := rowsLen_padR na nb (kernelList na P)
    (kernelList_rowsLen na P)
  have hBr := rowsLen_padL na nb (kernelList nb Q)
    (kernelList_rowsLen nb Q)
  have h1 : spanRel (na + nb) (kernelJoin na nb P Q)
      (a ++ List.replicate nb BPair.unit) :=
    spanRel_mono (na + nb) _ _ _ hAr hBr
      (spanRel_padR na nb (kernelList na P) a
        (kernelList_span na P hP a hal hA))
  have h2 : spanRel (na + nb) (kernelJoin na nb P Q)
      (List.replicate na BPair.unit ++ b) :=
    spanRel_mono_left (na + nb) _ _ _ hAr hBr
      (spanRel_padL na nb (kernelList nb Q) b
        (kernelList_span nb Q hQ b hbl hB))
  have h3 := spanRel_add (na + nb) (kernelJoin na nb P Q)
    (a ++ List.replicate nb BPair.unit)
    (List.replicate na BPair.unit ++ b)
    (kernelJoin_rowsLen na nb P Q)
    (by rw [ground.length_append, ground.length_replicate, hal])
    (by rw [ground.length_append, ground.length_replicate, hbl])
    h1 h2
  have hau := append_vecAdd_units na a b hal
  have hrep : List.replicate b.length BPair.unit
      = List.replicate nb BPair.unit :=
    congrArg (fun t => List.replicate t BPair.unit) hbl
  rw [hrep] at hau
  rw [hab]
  exact spanRel_congr (na + nb) (kernelJoin na nb P Q) _ (a ++ b)
    hau h3 (by rw [ground.length_append, hal, hbl])

/-- The kernel dimensions add at the kernel lists: the joined list
and the sum's own kernel list are two independent lists inside one
span, one count (`lem:lowerspan`'s two-list clause), and the joined
list's length is the sides' dimensions' sum. -/
theorem kernelDim_rowJoin : ∀ (na nb : Nat) (P Q : Mat),
    rowsLen na P → rowsLen nb Q → P.length = Q.length →
    (∀ v w : List BPair, v.length = na → w.length = nb →
      poly.unitTail (matVec (rowJoin P Q) (v ++ w)) →
      poly.unitTail (matVec P v)) →
    kernelDim na P + kernelDim nb Q
      = kernelDim (na + nb) (rowJoin P Q) := by
  intro na nb P Q hP hQ hl hyp
  have hR : rowsLen (na + nb) (rowJoin P Q) :=
    rowsLen_rowJoin na nb hP hQ
  have hcount := span_count_eq (na + nb) (kernelJoin na nb P Q)
    (kernelList (na + nb) (rowJoin P Q))
    (kernelJoin_rowsLen na nb P Q)
    (kernelList_rowsLen (na + nb) (rowJoin P Q))
    (kernelJoin_indep na nb P Q hP hQ)
    (kernelList_indep (na + nb) (rowJoin P Q) hR)
    (fun k hk => kernelList_span (na + nb) (rowJoin P Q) hR _
      (rowsLen_getAt (kernelJoin na nb P Q) k
        (kernelJoin_rowsLen na nb P Q) hk)
      (kernelJoin_members na nb P Q hP hQ k hk))
    (fun k hk => kernelJoin_span na nb P Q hP hQ hl hyp _
      (rowsLen_getAt (kernelList (na + nb) (rowJoin P Q)) k
        (kernelList_rowsLen (na + nb) (rowJoin P Q)) hk)
      (kernelList_members (na + nb) (rowJoin P Q) hR k hk))
  have hjl : (kernelJoin na nb P Q).length
      = kernelDim na P + kernelDim nb Q := by
    show (((kernelList na P).map
        (fun c => c ++ List.replicate nb BPair.unit))
      ++ ((kernelList nb Q).map
        (fun c => List.replicate na BPair.unit ++ c))).length
      = kernelDim na P + kernelDim nb Q
    rw [ground.length_append, ground.length_map, ground.length_map,
      kernelList_dim, kernelList_dim]
  rw [← hjl, hcount, kernelList_dim]

/-! The cross datum at a stated basis, `def:blockcount`'s
elimination shape: the stacked family read entry by entry against
the basis, its width and its action, the datum at a joined basis,
and the counts' basis freedom — two stated bases of one span read
one kernel dimension.  `gramM` shares the map-of-map shape at the
plain fold where `crossM` reads the skipping one, one value by
`dotN_read` at every entry; the two stand at their own carriers,
a parametrized general the move if a third instance arrives. -/

/-- A stacked family read against a stated basis, entry by entry at
the skipping fold: the block count's elimination-datum shape
(`def:blockcount` at `def:elim`'s kernel dimension). -/
def crossM (R L : Mat) : Mat :=
  R.map (fun r => L.map (fun x => dotN r x))

/-- One row per stacked member. -/
theorem length_crossM : ∀ (R L : Mat),
    (crossM R L).length = R.length :=
  fun R _ => ground.length_map _ R

/-- The rows at the basis's count. -/
theorem rowsLen_crossM : ∀ (R L : Mat),
    rowsLen L.length (crossM R L) :=
  fun R L => rowsLen_map _ L.length R (fun x _ => (fun _ => ground.length_map _ L) x)

/-- The skipping fold's entries read the plain fold's, member by
member. -/
private theorem polyOne_map_dotN (r : List BPair) : ∀ L : Mat,
    poly.oneValue (L.map (fun x => dotN r x))
      (L.map (fun x => dotP r x))
  | [] => trivial
  | x :: L => ⟨dotN_read r x, polyOne_map_dotN r L⟩

/-- The cross datum's action is the stacked family's at the
combination: a coefficient vector's read against the cross rows is
the stacked rows' read of its combination.  The width binders are
`def:elim`'s stated-key-list frame, the matrices total over stated
finite lists. -/
theorem matVec_crossM : ∀ (n : Nat) (R L : Mat) (c : List BPair),
    rowsLen n R → rowsLen n L →
    poly.oneValue (matVec (crossM R L) c)
      (matVec R (combo n c L))
  | _, [], _, _, _, _ => trivial
  | n, r :: R, L, c, hR, hL => by
    show (dotN (L.map (fun x => dotN r x)) c).oneValue
        (dotN r (combo n c L))
      ∧ poly.oneValue (matVec (crossM R L) c)
        (matVec R (combo n c L))
    refine ⟨?_, matVec_crossM n R L c hR.2 hL⟩
    exact BPair.oneValue_trans
      (dotN_read (L.map (fun x => dotN r x)) c)
      (BPair.oneValue_trans
        (BPair.oneValue_of_eq
          (dotP_comm (L.map (fun x => dotN r x)) c))
        (BPair.oneValue_trans
          (dotP_oneValue_right c (L.map (fun x => dotN r x))
            (L.map (fun x => dotP r x)) (polyOne_map_dotN r L))
          (BPair.oneValue_symm
            (BPair.oneValue_trans (dotN_read r (combo n c L))
              (dotP_combo c L r n hL)))))

/-- The cross datum at a joined basis is the sides' data joined
row for row. -/
theorem crossM_append : ∀ (R LA LB : Mat),
    crossM R (LA ++ LB) = rowJoin (crossM R LA) (crossM R LB)
  | [], _, _ => rfl
  | r :: R, LA, LB => by
    show (LA ++ LB).map (fun x => dotN r x) :: crossM R (LA ++ LB)
      = (LA.map (fun x => dotN r x) ++ LB.map (fun x => dotN r x))
        :: rowJoin (crossM R LA) (crossM R LB)
    rw [ground.map_append (fun x => dotN r x) LA LB,
      crossM_append R LA LB]

/-- Two independent lists at perpendicular sides join independent:
a null combination's two parts are perpendicular span members
summing to the unit, the positive pairing withdrawing both, and
each side's independence reads its coefficients at the unit. -/
theorem indep_append_perp : ∀ (n : Nat) (LA LB : Mat),
    rowsLen n LA → rowsLen n LB →
    indepRows n LA → indepRows n LB →
    (∀ k, k < LA.length → ∀ l, l < LB.length →
      (dotP (ground.getAt [] LA k)
        (ground.getAt [] LB l)).oneValue BPair.unit) →
    indepRows n (LA ++ LB) := by
  intro n LA LB hA hB hiA hiB hperp
  refine indep_intro n (LA ++ LB) (rowsLen_append n hA hB) ?_
  intro cs hcs hnull
  obtain ⟨a, b, hab, hal⟩ := ground.listSplit cs LA.length
    (by rw [hcs, ground.length_append]; exact Nat.le_add_right _ _)
  have hbl : b.length = LB.length := by
    have h1 : a.length + b.length = LA.length + LB.length := by
      rw [← ground.length_append a b, ← hab, hcs,
        ground.length_append]
    rw [hal] at h1
    exact ground.addCancelL LA.length h1
  rw [hab] at hnull
  have hsplit : poly.unitTail
      (vecAdd (combo n a LA) (combo n b LB)) :=
    poly.unitTail_oneValue_right hnull
      (combo_append n a LA b LB hal hA hB)
  have hxs : spanRel n LA (combo n a LA) :=
    spanRel_combo n LA hA LA a hA
      (fun k hk => spanRel_getAt n LA k hk hA)
  have hys : spanRel n LB (combo n b LB) :=
    spanRel_combo n LB hB LB b hB
      (fun k hk => spanRel_getAt n LB k hk hB)
  have hrow : ∀ k, k < LA.length →
      (dotP (combo n b LB) (ground.getAt [] LA k)).oneValue
        BPair.unit := by
    intro k hk
    have h1 : (dotP (ground.getAt [] LA k) (combo n b LB)).oneValue
        BPair.unit :=
      perp_span n LB (ground.getAt [] LA k) (combo n b LB) hB
        (rowsLen_getAt LA k hA hk) (hperp k hk) hys
    rw [dotP_comm (combo n b LB) (ground.getAt [] LA k)]
    exact h1
  have hpair : (dotP (combo n a LA) (combo n b LB)).oneValue
      BPair.unit := by
    rw [dotP_comm (combo n a LA) (combo n b LB)]
    exact perp_span n LA (combo n b LB) (combo n a LA) hA
      (length_combo n b LB hB) hrow hxs
  obtain ⟨hxu, hyu⟩ := vecAdd_perp_null (combo n a LA) (combo n b LB)
    ((length_combo n b LB hB).trans (length_combo n a LA hA).symm)
    hsplit hpair
  rw [hab]
  exact unitTail_append (indep_elim hiA a hal hxu)
    (indep_elim hiB b hbl hyu)

private theorem combo_combo : ∀ (n : Nat) (ds : List BPair)
    (C : List (List BPair)) (L : Mat),
    rowsLen L.length C → rowsLen n L →
    poly.oneValue (combo n (combo L.length ds C) L)
      (combo n ds (C.map (fun c => combo n c L)))
  | n, [], _, L, _, _ =>
    poly.unitTail_oneValue (combo_unitsT n L L.length)
      (poly.unitTail_replicate n)
  | n, _ :: _, [], L, _, _ =>
    poly.unitTail_oneValue (combo_unitsT n L L.length)
      (poly.unitTail_replicate n)
  | n, d :: ds, c :: C, L, hC, hL => by
    have hfr : rowsLen n (C.map (fun c => combo n c L)) :=
      rowsLen_map _ n C (fun x _ => (fun a => length_combo n a L hL) x)
    show poly.oneValue
        (combo n (vecAdd (vecScale d c) (combo L.length ds C)) L)
        (vecAdd (vecScale d (combo n c L))
          (combo n ds (C.map (fun c => combo n c L))))
    refine poly.oneValue_trans
      (combo_vecAdd n (vecScale d c) (combo L.length ds C) L
        (((length_vecScale d c).trans hC.1).trans
          (length_combo L.length ds C hC.2).symm)) ?_
    exact polyOne_vecAdd _ _ _ _
      (poly.oneValue_symm (vecScale_combo d n c L))
      (combo_combo n ds C L hC.2 hL)
      ((length_combo n (vecScale d c) L hL).trans
        ((length_vecScale d (combo n c L)).trans
          (length_combo n c L hL)).symm)
      ((length_combo n (combo L.length ds C) L hL).trans
        (length_combo n ds (C.map (fun c => combo n c L)) hfr).symm)

/-- The combination reads one value in its coefficients, the
transpose's action carrying the congruence at matched counts. -/
private theorem combo_congrC (n : Nat) (L : Mat) (hL : rowsLen n L)
    (u u' : List BPair) (hu : u.length = L.length)
    (hu' : u'.length = L.length) (h : poly.oneValue u u') :
    poly.oneValue (combo n u L) (combo n u' L) :=
  poly.oneValue_trans
    (poly.oneValue_symm (matVec_transpose_combo n L u hL hu))
    (poly.oneValue_trans
      (matVec_congr (transposeM L) u u' h)
      (matVec_transpose_combo n L u' hL hu'))

/-- The kernel coefficients' images are independent: a null
combination of them is a combination of the basis at the inner
coefficients, independent there, and the stacked family's own
kernel list is independent at its coefficients. -/
private theorem crossKer_indep (n : Nat) (R L : Mat)
    (hL : rowsLen n L) (hiL : indepRows n L) :
    indepRows n ((kernelList L.length (crossM R L)).map
      (fun c => combo n c L)) := by
  refine indep_intro n
    ((kernelList L.length (crossM R L)).map (fun c => combo n c L))
    (rowsLen_map _ n _ (fun x _ => (fun a => length_combo n a L hL) x)) ?_
  intro ds hds hnull
  have hK : rowsLen L.length (kernelList L.length (crossM R L)) :=
    kernelList_rowsLen L.length (crossM R L)
  have h1 : poly.unitTail (combo n
      (combo L.length ds (kernelList L.length (crossM R L))) L) :=
    poly.oneValue_unitTail
      (combo_combo n ds (kernelList L.length (crossM R L)) L hK hL)
      hnull
  exact indep_elim
    (kernelList_indep L.length (crossM R L) (rowsLen_crossM R L))
    ds (hds.trans (ground.length_map _ _))
    (indep_elim hiL
      (combo L.length ds (kernelList L.length (crossM R L)))
      (length_combo L.length ds _ hK) h1)

/-- Each basis's kernel coefficients map into the other's span: the
image sits in the first basis's span, hence the second's, its
stacked read is the kernel member's at the unit, and the second
basis's own kernel list spans the coefficients the span witness
supplies, the two clearing scalars multiplied. -/
private theorem crossKer_span (n : Nat) (R L L' : Mat)
    (hR : rowsLen n R) (hL : rowsLen n L) (hL' : rowsLen n L')
    (hmut : ∀ k, k < L.length → spanRel n L' (ground.getAt [] L k)) :
    ∀ k, k < ((kernelList L.length (crossM R L)).map
        (fun c => combo n c L)).length →
      spanRel n ((kernelList L'.length (crossM R L')).map
          (fun c => combo n c L'))
        (ground.getAt []
          ((kernelList L.length (crossM R L)).map
            (fun c => combo n c L)) k) := by
  intro k hk
  have hkK : k < (kernelList L.length (crossM R L)).length := by
    rw [← ground.length_map (fun c => combo n c L)
      (kernelList L.length (crossM R L))]
    exact hk
  rw [ground.getAt_map ([] : List BPair) ([] : List BPair)
    (fun c => combo n c L) (kernelList L.length (crossM R L)) k hkK]
  have hv : (combo n (ground.getAt []
      (kernelList L.length (crossM R L)) k) L).length = n :=
    length_combo n _ L hL
  have hsp' : spanRel n L' (combo n (ground.getAt []
      (kernelList L.length (crossM R L)) k) L) :=
    spanRel_trans n L L' _ hL hL' hmut
      (spanRel_combo n L hL L _ hL
        (fun j hj => spanRel_getAt n L j hj hL))
  have hker : poly.unitTail (matVec R (combo n (ground.getAt []
      (kernelList L.length (crossM R L)) k) L)) :=
    poly.unitTail_oneValue_right
      (kernelList_members L.length (crossM R L)
        (rowsLen_crossM R L) k hkK)
      (matVec_crossM n R L _ hR hL)
  obtain ⟨c₀, cs, hc₀, hcsl, hone⟩ := span_elim hsp'
  have hcsker : poly.unitTail (matVec (crossM R L') cs) :=
    poly.oneValue_unitTail
      (poly.oneValue_trans (matVec_crossM n R L' cs hR hL')
        (poly.oneValue_trans
          (matVec_congr R (combo n cs L')
            (vecScale c₀ (combo n (ground.getAt []
              (kernelList L.length (crossM R L)) k) L))
            (poly.oneValue_symm hone))
          (matVec_vecScale_free R c₀ _)))
      (unitTail_vecScale c₀ _ hker)
  obtain ⟨d₀, ds, hd₀, hdsl, hdone⟩ := span_elim
    (kernelList_span L'.length (crossM R L') (rowsLen_crossM R L')
      cs hcsl hcsker)
  have hK' : rowsLen L'.length
      (kernelList L'.length (crossM R L')) :=
    kernelList_rowsLen L'.length (crossM R L')
  have hfin : poly.oneValue
      (vecScale (d₀ * c₀) (combo n (ground.getAt []
        (kernelList L.length (crossM R L)) k) L))
      (combo n ds ((kernelList L'.length (crossM R L')).map
        (fun c => combo n c L'))) := by
    rw [← vecScale_vecScale d₀ c₀]
    refine poly.oneValue_trans
      (vecScale_oneValue d₀ _ (combo n cs L') hone) ?_
    refine poly.oneValue_trans (vecScale_combo d₀ n cs L') ?_
    refine poly.oneValue_trans
      (combo_congrC n L' hL' (vecScale d₀ cs)
        (combo L'.length ds (kernelList L'.length (crossM R L')))
        ((length_vecScale d₀ cs).trans hcsl)
        (length_combo L'.length ds _ hK') hdone) ?_
    exact combo_combo n ds (kernelList L'.length (crossM R L')) L'
      hK' hL'
  exact span_intro n
    ((kernelList L'.length (crossM R L')).map
      (fun c => combo n c L')) _
    (rowsLen_map _ n _ (fun x _ => (fun a => length_combo n a L' hL') x)) hv
    ⟨d₀ * c₀, ds, (fun hcon => hc₀ (mul_cancel_unit hd₀ hcon)),
      hdsl.trans (ground.length_map _ _).symm, hfin⟩

/-- Two stated bases of one span read one kernel dimension at a
stacked family: the kernel coefficients map by the combination to
ambient independent spanning lists of the family's kernel inside
the span, and two independent lists inside one span read one count
(`lem:lowerspan`; the counts the graded dimensions' read). -/
theorem kernelDim_congr : ∀ (n : Nat) (R L L' : Mat),
    rowsLen n R → rowsLen n L → rowsLen n L' →
    indepRows n L → indepRows n L' →
    (∀ k, k < L.length → spanRel n L' (ground.getAt [] L k)) →
    (∀ k, k < L'.length → spanRel n L (ground.getAt [] L' k)) →
    kernelDim L.length (crossM R L)
      = kernelDim L'.length (crossM R L') := by
  intro n R L L' hR hL hL' hiL hiL' hmut hmut'
  have hcount := span_count_eq n
    ((kernelList L.length (crossM R L)).map (fun c => combo n c L))
    ((kernelList L'.length (crossM R L')).map
      (fun c => combo n c L'))
    (rowsLen_map _ n _ (fun x _ => (fun a => length_combo n a L hL) x))
    (rowsLen_map _ n _ (fun x _ => (fun a => length_combo n a L' hL') x))
    (crossKer_indep n R L hL hiL) (crossKer_indep n R L' hL' hiL')
    (crossKer_span n R L L' hR hL hL' hmut)
    (crossKer_span n R L' L hR hL' hL hmut')
  rw [← kernelList_dim L.length (crossM R L),
    ← kernelList_dim L'.length (crossM R L'),
    ← ground.length_map (fun c => combo n c L)
      (kernelList L.length (crossM R L)),
    ← ground.length_map (fun c => combo n c L')
      (kernelList L'.length (crossM R L')),
    hcount]

/-- Two cross data whose kernel reads agree pointwise at one
coefficient count read one kernel dimension: each list's members
annihilate their own datum, the stated equivalence carries each
across, so each sits in the other's kernel list's span, two
independent lists inside one span read one count
(`lem:lowerspan`'s exchange clause), and a kernel list's length is
the dimension outright.  The coefficient count `hlen` is
load-bearing with its committed refusal; the two bases' width
reads are the cross datum's own rows at the basis's count
(`rowsLen_crossM`), derived and not carried. -/
theorem kernelDim_kerIff (R L R' L' : Mat)
    (hlen : L.length = L'.length)
    (hiff : ∀ x : List BPair, x.length = L.length →
      (poly.unitTail (matVec (crossM R L) x)
        ↔ poly.unitTail (matVec (crossM R' L') x))) :
    kernelDim L.length (crossM R L)
      = kernelDim L'.length (crossM R' L') := by
  have hKA : rowsLen L.length (kernelList L.length (crossM R L)) :=
    kernelList_rowsLen L.length (crossM R L)
  have hKB : rowsLen L'.length
      (kernelList L'.length (crossM R' L')) :=
    kernelList_rowsLen L'.length (crossM R' L')
  have hconv : ∀ v : List BPair,
      spanRel L'.length (kernelList L'.length (crossM R' L')) v →
      spanRel L.length (kernelList L'.length (crossM R' L')) v := by
    rw [hlen]
    exact fun _ h => h
  have hKB' : rowsLen L.length
      (kernelList L'.length (crossM R' L')) := by
    rw [hlen]
    exact hKB
  have hIB : indepRows L.length
      (kernelList L'.length (crossM R' L')) := by
    rw [hlen]
    exact kernelList_indep L'.length (crossM R' L')
      (rowsLen_crossM R' L')
  have hAB : ∀ k, k < (kernelList L.length (crossM R L)).length →
      spanRel L.length (kernelList L'.length (crossM R' L'))
        (ground.getAt [] (kernelList L.length (crossM R L)) k) := by
    intro k hk
    have hx : (ground.getAt []
        (kernelList L.length (crossM R L)) k).length = L.length :=
      rowsLen_getAt _ k hKA hk
    exact hconv _ (kernelList_span L'.length (crossM R' L')
      (rowsLen_crossM R' L') _ (hx.trans hlen)
      ((hiff _ hx).mp (kernelList_members L.length (crossM R L)
        (rowsLen_crossM R L) k hk)))
  have hBA : ∀ k, k < (kernelList L'.length (crossM R' L')).length →
      spanRel L.length (kernelList L.length (crossM R L))
        (ground.getAt []
          (kernelList L'.length (crossM R' L')) k) := by
    intro k hk
    have hx : (ground.getAt []
        (kernelList L'.length (crossM R' L')) k).length
        = L.length := (rowsLen_getAt _ k hKB hk).trans hlen.symm
    exact kernelList_span L.length (crossM R L)
      (rowsLen_crossM R L) _ hx
      ((hiff _ hx).mpr (kernelList_members L'.length (crossM R' L')
        (rowsLen_crossM R' L') k hk))
  rw [← kernelList_dim L.length (crossM R L),
    ← kernelList_dim L'.length (crossM R' L')]
  exact span_count_eq L.length (kernelList L.length (crossM R L))
    (kernelList L'.length (crossM R' L')) hKA hKB'
    (kernelList_indep L.length (crossM R L) (rowsLen_crossM R L))
    hIB hAB hBA

/-- A fold's scaled read transports across two families whose
entries agree at the cross-multiplied scales: the scale passes
through each product to the entry, and the fold collects the two
sides at one value. -/
theorem dotP_scaleTransport (s s' : BPair) :
    ∀ (cs g g' : List BPair), g'.length = g.length →
    (∀ k, k < g.length →
      (s' * ground.getAt BPair.unit g' k).oneValue
        (s * ground.getAt BPair.unit g k)) →
    (s' * dotP cs g').oneValue (s * dotP cs g)
  | [], _, _, _, _ =>
    BPair.oneValue_trans (BPair.mul_unit s')
      (BPair.oneValue_symm (BPair.mul_unit s))
  | _ :: _, [], [], _, _ =>
    BPair.oneValue_trans (BPair.mul_unit s')
      (BPair.oneValue_symm (BPair.mul_unit s))
  | _ :: _, [], _ :: _, hl, _ => nomatch hl
  | _ :: _, _ :: _, [], hl, _ => nomatch hl
  | c :: cs, a :: g, a' :: g', hl, h => by
    show (s' * (c * a' + dotP cs g')).oneValue
      (s * (c * a + dotP cs g))
    rw [BPair.left_distrib s' (c * a') (dotP cs g'),
      BPair.left_distrib s (c * a) (dotP cs g),
      BPair.mul_left_comm s' c a', BPair.mul_left_comm s c a]
    exact BPair.add_congr
      (BPair.mul_congr (BPair.oneValue_refl c)
        (h 0 (Nat.succ_pos g.length)))
      (dotP_scaleTransport s s' cs g g' (Nat.succ.inj hl)
        (fun k hk => h (k + 1) (Nat.succ_lt_succ hk)))

/-- The combination self-pairings' transport across cross-scaled
Grams: two families whose pairwise folds agree at the
cross-multiplied scales carry that agreement to every
combination's self-pairing — the pairing against a combination is
the coefficients' fold over the family's own pairings
(`dotP_combo`), so the scaled read passes to the Gram entries once
per side (`lem:blockcount`(iii)'s transport read). -/
theorem dotP_comboGram (m : Nat) (s s' : BPair) (P P' : Mat)
    (hP : rowsLen m P) (hP' : rowsLen m P')
    (hlen : P'.length = P.length)
    (hgram : ∀ k, k < P.length → ∀ l, l < P.length →
      (s' * dotP (ground.getAt [] P' k)
          (ground.getAt [] P' l)).oneValue
        (s * dotP (ground.getAt [] P k) (ground.getAt [] P l)))
    (cs : List BPair) :
    (s' * dotP (combo m cs P') (combo m cs P')).oneValue
      (s * dotP (combo m cs P) (combo m cs P)) := by
  have hrow : ∀ k, k < P.length →
      (s' * dotP (ground.getAt [] P' k) (combo m cs P')).oneValue
        (s * dotP (ground.getAt [] P k) (combo m cs P)) := by
    intro k hk
    have hk' : k < P'.length := by rw [hlen]; exact hk
    refine BPair.oneValue_trans
      (BPair.mul_congr (BPair.oneValue_refl s')
        (dotP_combo cs P' (ground.getAt [] P' k) m hP')) ?_
    refine BPair.oneValue_trans ?_
      (BPair.mul_congr (BPair.oneValue_refl s)
        (BPair.oneValue_symm
          (dotP_combo cs P (ground.getAt [] P k) m hP)))
    refine dotP_scaleTransport s s' cs
      (P.map (fun row => dotP (ground.getAt [] P k) row))
      (P'.map (fun row => dotP (ground.getAt [] P' k) row))
      (by rw [ground.length_map, ground.length_map]; exact hlen) ?_
    intro l hl
    rw [ground.length_map] at hl
    have hl' : l < P'.length := by rw [hlen]; exact hl
    rw [ground.getAt_map ([] : List BPair) BPair.unit
        (fun row => dotP (ground.getAt [] P' k) row) P' l hl',
      ground.getAt_map ([] : List BPair) BPair.unit
        (fun row => dotP (ground.getAt [] P k) row) P l hl]
    exact hgram k hk l hl
  refine BPair.oneValue_trans
    (BPair.mul_congr (BPair.oneValue_refl s')
      (dotP_combo cs P' (combo m cs P') m hP')) ?_
  refine BPair.oneValue_trans ?_
    (BPair.mul_congr (BPair.oneValue_refl s)
      (BPair.oneValue_symm
        (dotP_combo cs P (combo m cs P) m hP)))
  refine dotP_scaleTransport s s' cs
    (P.map (fun row => dotP (combo m cs P) row))
    (P'.map (fun row => dotP (combo m cs P') row))
    (by rw [ground.length_map, ground.length_map]; exact hlen) ?_
  intro k hk
  rw [ground.length_map] at hk
  have hk' : k < P'.length := by rw [hlen]; exact hk
  rw [ground.getAt_map ([] : List BPair) BPair.unit
      (fun row => dotP (combo m cs P') row) P' k hk',
    ground.getAt_map ([] : List BPair) BPair.unit
      (fun row => dotP (combo m cs P) row) P k hk,
    dotP_comm (combo m cs P') (ground.getAt [] P' k),
    dotP_comm (combo m cs P) (ground.getAt [] P k)]
  exact hrow k hk

/-- Two matched families whose stacked images' Grams agree at
cross-multiplied off-unit scales read one kernel dimension — a
kernel family reads the sum's unit exactly at its stacked image's
self-pairing (the positive pairing), the self-pairing the
coefficients' double fold over the Gram, one value across the two
families at the scales' clearing (`lem:blockcount`(iii)'s transport
read; `def:elim`'s kernel list). -/
theorem kernelDim_gram (n : Nat) (R L L' : Mat) (s s' : BPair)
    (hs : ¬ s.oneValue BPair.unit) (hs' : ¬ s'.oneValue BPair.unit)
    (hR : rowsLen n R) (hL : rowsLen n L) (hL' : rowsLen n L')
    (hlen : L'.length = L.length)
    (hgram : ∀ k, k < L.length → ∀ l, l < L.length →
      (s' * dotP (matVec R (ground.getAt [] L' k))
          (matVec R (ground.getAt [] L' l))).oneValue
        (s * dotP (matVec R (ground.getAt [] L k))
          (matVec R (ground.getAt [] L l)))) :
    kernelDim L'.length (crossM R L') = kernelDim L.length (crossM R L) := by
  have hP : rowsLen R.length (L.map (matVec R)) :=
    rowsLen_map (matVec R) R.length L
      (fun x _ => (fun y => matVec_length R y) x)
  have hP' : rowsLen R.length (L'.map (matVec R)) :=
    rowsLen_map (matVec R) R.length L'
      (fun x _ => (fun y => matVec_length R y) x)
  have hPlen : (L'.map (matVec R)).length = (L.map (matVec R)).length := by
    rw [ground.length_map, ground.length_map]; exact hlen
  have hgramP : ∀ k, k < (L.map (matVec R)).length →
      ∀ l, l < (L.map (matVec R)).length →
      (s' * dotP (ground.getAt [] (L'.map (matVec R)) k)
          (ground.getAt [] (L'.map (matVec R)) l)).oneValue
        (s * dotP (ground.getAt [] (L.map (matVec R)) k)
          (ground.getAt [] (L.map (matVec R)) l)) := by
    intro k hk l hl
    rw [ground.length_map] at hk
    rw [ground.length_map] at hl
    have hk' : k < L'.length := by rw [hlen]; exact hk
    have hl' : l < L'.length := by rw [hlen]; exact hl
    rw [ground.getAt_map ([] : List BPair) ([] : List BPair)
        (matVec R) L' k hk',
      ground.getAt_map ([] : List BPair) ([] : List BPair)
        (matVec R) L' l hl',
      ground.getAt_map ([] : List BPair) ([] : List BPair)
        (matVec R) L k hk,
      ground.getAt_map ([] : List BPair) ([] : List BPair)
        (matVec R) L l hl]
    exact hgram k hk l hl
  have hchain : ∀ (M : Mat), rowsLen n M → ∀ cs : List BPair,
      poly.oneValue (matVec (crossM R M) cs)
        (combo R.length cs (M.map (matVec R))) :=
    fun M hM cs => poly.oneValue_trans
      (matVec_crossM n R M cs hR hM) (matVec_combo R n cs M hM)
  have hfwd : ∀ cs : List BPair,
      poly.unitTail (matVec (crossM R L) cs) →
      poly.unitTail (matVec (crossM R L') cs) := by
    intro cs h
    refine poly.oneValue_unitTail (hchain L' hL' cs)
      (dotP_self_null _ (ground.mul_cancel_unit hs' ?_))
    exact BPair.oneValue_trans
      (dotP_comboGram R.length s s' (L.map (matVec R))
        (L'.map (matVec R)) hP hP' hPlen hgramP cs)
      (oneValue_mul_unit s _
        (dotP_null_tail_left _ _
          (poly.unitTail_oneValue_right h (hchain L hL cs))))
  have hbwd : ∀ cs : List BPair,
      poly.unitTail (matVec (crossM R L') cs) →
      poly.unitTail (matVec (crossM R L) cs) := by
    intro cs h
    refine poly.oneValue_unitTail (hchain L hL cs)
      (dotP_self_null _ (ground.mul_cancel_unit hs ?_))
    exact BPair.oneValue_trans
      (BPair.oneValue_symm
        (dotP_comboGram R.length s s' (L.map (matVec R))
          (L'.map (matVec R)) hP hP' hPlen hgramP cs))
      (oneValue_mul_unit s' _
        (dotP_null_tail_left _ _
          (poly.unitTail_oneValue_right h (hchain L' hL' cs))))
  have convR : ∀ K : Mat, rowsLen L'.length K → rowsLen L.length K := by
    rw [hlen]
    exact fun _ h => h
  have convI : ∀ K : Mat, indepRows L'.length K →
      indepRows L.length K := by
    rw [hlen]
    exact fun _ h => h
  have convS : ∀ (K : Mat) (v : List BPair),
      spanRel L'.length K v → spanRel L.length K v := by
    rw [hlen]
    exact fun _ _ h => h
  have hA : rowsLen L.length (kernelList L.length (crossM R L)) :=
    kernelList_rowsLen L.length (crossM R L)
  have hB : rowsLen L.length (kernelList L'.length (crossM R L')) :=
    convR _ (kernelList_rowsLen L'.length (crossM R L'))
  have hiA : indepRows L.length (kernelList L.length (crossM R L)) :=
    kernelList_indep L.length (crossM R L) (rowsLen_crossM R L)
  have hiB : indepRows L.length
      (kernelList L'.length (crossM R L')) :=
    convI _ (kernelList_indep L'.length (crossM R L')
      (rowsLen_crossM R L'))
  have hAB : ∀ k, k < (kernelList L.length (crossM R L)).length →
      spanRel L.length (kernelList L'.length (crossM R L'))
        (ground.getAt [] (kernelList L.length (crossM R L)) k) := by
    intro k hk
    have hv : (ground.getAt []
        (kernelList L.length (crossM R L)) k).length = L'.length :=
      (rowsLen_getAt (kernelList L.length (crossM R L)) k hA hk).trans
        hlen.symm
    exact convS _ _ (kernelList_span L'.length (crossM R L')
      (rowsLen_crossM R L') _ hv
      (hfwd _ (kernelList_members L.length (crossM R L)
        (rowsLen_crossM R L) k hk)))
  have hBA : ∀ k, k < (kernelList L'.length (crossM R L')).length →
      spanRel L.length (kernelList L.length (crossM R L))
        (ground.getAt [] (kernelList L'.length (crossM R L')) k) := by
    intro k hk
    have hv : (ground.getAt []
        (kernelList L'.length (crossM R L')) k).length = L.length :=
      rowsLen_getAt (kernelList L'.length (crossM R L')) k hB hk
    exact kernelList_span L.length (crossM R L) (rowsLen_crossM R L)
      _ hv
      (hbwd _ (kernelList_members L'.length (crossM R L')
        (rowsLen_crossM R L') k hk))
  have hcount := span_count_eq L.length
    (kernelList L.length (crossM R L))
    (kernelList L'.length (crossM R L'))
    hA hB hiA hiB hAB hBA
  rw [← kernelList_dim L.length (crossM R L),
    ← kernelList_dim L'.length (crossM R L')]
  exact hcount.symm

/-! The block-count kit, `lem:blockcount`(ii)'s closing sentence:
the rank read at a unit-tailed family. -/

/-- A unit-tailed row stores no sparse entry: every entry is at the
sum's unit, so its canonical representative passes the unit test
and the walk drops it. -/
private theorem ofRowFrom_units : ∀ (r : List BPair) (k : Nat),
    poly.unitTail r → ofRowFrom k r = []
  | [], _, _ => rfl
  | e :: es, k, h => by
    show (match e.norm.isUnitRep with
      | true => ofRowFrom (k + 1) es
      | false => (k, e.norm) :: ofRowFrom (k + 1) es) = []
    rw [ground.BPair.isUnitRep_norm_of_unit h.1]
    exact ofRowFrom_units es (k + 1) h.2

/-- A unit-tailed family's sparse reading is occupied nowhere, so
the pivot search answers nothing. -/
private theorem sFind_ofRow_none : ∀ m : Mat,
    (∀ k, k < m.length → poly.unitTail (ground.getAt [] m k)) →
    sFind (m.map ofRow) = none
  | [], _ => rfl
  | a :: t, h => by
    have ha : ofRow a = (a.length, []) := by
      show (a.length, ofRowFrom 0 a) = (a.length, [])
      rw [ofRowFrom_units a 0 (h 0 (Nat.succ_pos t.length))]
    show sFind (ofRow a :: t.map ofRow) = none
    rw [ha]
    show (match sFind (t.map ofRow) with
      | none => none
      | some (i, j) => some (i + 1, j)) = none
    rw [sFind_ofRow_none t
      (fun k hk => h (k + 1) (Nat.succ_lt_succ hk))]

/-- A search answering nothing seeds the count's floor at any
fuel. -/
private theorem sdescend_of_none : ∀ (fuel : Nat) (prev : BPair)
    (rows : List SRow), sFind rows = none → sdescend fuel prev rows = 0
  | 0, prev, rows, _ =>
    descGo_zero (fun _ => 0) (fun _ _ _ n => 1 + n) 0 prev rows
  | fuel + 1, prev, rows, hf =>
    descGo_none (fun _ => 0) (fun _ _ _ n => 1 + n) fuel 0 prev rows hf

/-- The rank at unit-tailed rows is nought: every stored sparse
entry is dropped at the normed unit test, the pivot search reads
none, and the descent seeds its own floor. -/
theorem rank_null : ∀ m : Mat,
    (∀ k, k < m.length → poly.unitTail (ground.getAt [] m k)) →
    rank m = 0 :=
  fun m h => sdescend_of_none m.length (BPair.ofPos .one)
    (m.map ofRow) (sFind_ofRow_none m h)

/-! The identity datum's reads at `def:elim`'s surface: the action
reading a vector back entry by entry, the square shape at the
stated width, and the collection at a one-member family.

`idList` is one value with the certificate tier's `inertia.idMat`
at every width, two spellings of one datum, and the twin set runs
six deep: `length_idList` with `inertia.idMat_len`,
`rowsLen_idList` with `inertia.idMat_rows`, `idList_getAt` with
`split.idMat_bvec`, `matVec_idList` with `inertia.matVec_idMat`,
`dotP_onehot` with `split.dotP_bvec`, and `inertia.scaleId_act`
the standing general of the action read; `speccut`'s `diagRead`
field takes `sqAt (idMat n) n` as a hypothesis where
`sqAt_idList` now derives it.  One owner is the move at the tiers'
seam — `Inertia` imports `Elim`, so this module's spellings are
the owner and the certificate tier's retire onto them — the
certificate tier's files the other clone's active surface, the
reciprocal pointers landing with the seam. -/

private theorem dotP_onehot (w k : Nat) (u : List BPair)
    (hk : k < w) (hl : u.length = w) :
    (dotP (List.set (List.replicate w BPair.unit) k
        (BPair.ofPos .one)) u).oneValue
      (ground.getAt BPair.unit u k) := by
  have hrl : (List.set (List.replicate w BPair.unit) k
      (BPair.ofPos .one)).length = w := by
    rw [ground.length_set, ground.length_replicate]
  rw [dotP_comm]
  refine BPair.oneValue_trans
    (dotP_oneIndex u _ k (by rw [hrl, hl])
      (by rw [hrl]; exact hk) ?_) ?_
  · intro q hq hqk
    rw [hrl] at hq
    rw [ground.getAt_set_ne BPair.unit (List.replicate w BPair.unit) k
        q (BPair.ofPos .one) hqk,
      ground.getAt_replicate_self BPair.unit w q]
    exact BPair.oneValue_refl _
  · rw [ground.getAt_set_self BPair.unit (BPair.ofPos .one)
      (List.replicate w BPair.unit) k
      (by rw [ground.length_replicate]; exact hk)]
    exact BPair.mul_one_read _

/-- The identity action reads the vector back, entry by entry:
each row's pairing picks the entry at its own key. -/
theorem matVec_idList : ∀ (n : Nat) (u : List BPair),
    u.length = n →
    poly.oneValue (matVec (idList n) u) u := by
  intro n u hu
  refine poly.oneValue_of_entries _ _ ?_ ?_
  · rw [matVec_length, length_idList, hu]
  · intro i hi
    rw [matVec_length, length_idList] at hi
    have hmap : ground.getAt BPair.unit (matVec (idList n) u) i
        = dotN (ground.getAt ([] : List BPair) (idList n) i) u := by
      show ground.getAt BPair.unit
          ((idList n).map (fun r => dotN r u)) i
        = dotN (ground.getAt ([] : List BPair) (idList n) i) u
      exact ground.getAt_map ([] : List BPair) BPair.unit
        (fun r => dotN r u) (idList n) i
        (by rw [length_idList]; exact hi)
    rw [hmap, idList_getAt n i hi]
    exact BPair.oneValue_trans (dotN_read _ u)
      (dotP_onehot n i u hi hu)

/-- The identity datum is square at its width. -/
theorem sqAt_idList : ∀ n : Nat, sqAt (idList n) n :=
  fun n => sqAt_of (length_idList n) (rowsLen_idList n)

/-- The self-pairings' product reads the product's one at a family
every member of which pairs with itself at that one: the fold
carries one such factor per member. -/
private theorem selfProd_one : ∀ L : Mat,
    (∀ k, k < L.length →
      (dotP (ground.getAt [] L k) (ground.getAt [] L k)).oneValue
        (BPair.ofPos Pos.one)) →
    (selfProd L).oneValue (BPair.ofPos Pos.one)
  | [], _ => BPair.oneValue_refl _
  | r :: t, h => by
    show ((dotP r r * selfProd t).norm).oneValue (BPair.ofPos Pos.one)
    refine BPair.oneValue_trans (BPair.norm_oneValue _) ?_
    refine BPair.oneValue_trans
      (BPair.mul_congr (h 0 (Nat.zero_lt_succ _))
        (selfProd_one t
          (fun k hk => h (k + 1) (Nat.succ_lt_succ hk)))) ?_
    decide +kernel

/-- The identity family is pairwise perpendicular: a member's
pairing picks the other member's entry at its own key, where the
unit family stands. -/
private theorem perpAll_idList (n : Nat) : perpAll (idList n) := by
  intro p hp q hq hpq
  rw [length_idList] at hp hq
  rw [idList_getAt n p hp, idList_getAt n q hq]
  refine BPair.oneValue_trans
    (dotP_onehot n p _ hp
      (by rw [ground.length_set, ground.length_replicate])) ?_
  rw [ground.getAt_set_ne BPair.unit (List.replicate n BPair.unit) q p
      (BPair.ofPos Pos.one) hpq,
    ground.getAt_replicate_self BPair.unit n p]
  exact BPair.oneValue_refl _

/-- The identity family is independent: pairwise perpendicular unit
rows at unit self-pairings, the Gram determinant the self-pairings'
product. -/
theorem indepRows_idList (n : Nat) : indepRows n (idList n) := by
  refine ⟨rowsLen_idList n, ?_⟩
  intro hone
  have hsp : (selfProd (idList n)).oneValue (BPair.ofPos Pos.one) := by
    refine selfProd_one (idList n) (fun k hk => ?_)
    rw [length_idList] at hk
    rw [idList_getAt n k hk]
    refine BPair.oneValue_trans
      (dotP_onehot n k _ hk
        (by rw [ground.length_set, ground.length_replicate])) ?_
    rw [ground.getAt_set_self BPair.unit (BPair.ofPos Pos.one)
      (List.replicate n BPair.unit) k
      (by rw [ground.length_replicate]; exact hk)]
    exact BPair.oneValue_refl _
  exact absurd
    (BPair.oneValue_trans (BPair.oneValue_symm hsp)
      (BPair.oneValue_trans
        (BPair.oneValue_symm (detL_perp (idList n) (perpAll_idList n)))
        hone))
    (by decide +kernel)

/-- Two rows whose entries share their representatives read one
sparse row from any key: the sparse reading tests and stores the
representative alone. -/
private theorem ofRowFrom_congr : ∀ (a b : List BPair) (k : Nat),
    a.length = b.length →
    (∀ i, i < a.length →
      (ground.getAt BPair.unit a i).norm
        = (ground.getAt BPair.unit b i).norm) →
    ofRowFrom k a = ofRowFrom k b
  | [], [], _, _, _ => rfl
  | [], _ :: _, _, h, _ => Nat.noConfusion h
  | _ :: _, [], _, h, _ => Nat.noConfusion h
  | a :: s, b :: t, k, h, hg => by
    have h0 : a.norm = b.norm := hg 0 (Nat.zero_lt_succ _)
    show (match (a.norm).isUnitRep with
        | true => ofRowFrom (k + 1) s
        | false => (k, a.norm) :: ofRowFrom (k + 1) s)
      = (match (b.norm).isUnitRep with
        | true => ofRowFrom (k + 1) t
        | false => (k, b.norm) :: ofRowFrom (k + 1) t)
    rw [h0,
      ofRowFrom_congr s t (k + 1) (Nat.succ.inj h)
        (fun i hi => hg (i + 1) (Nat.succ_lt_succ hi))]

/-- A row's skipping fold against the identity family's member at a
key reads that row's own entry there: every other key pairs at the
unit and is skipped. -/
theorem dotN_idList_entry (n : Nat) (r : List BPair)
    (hr : r.length = n) (i : Nat) (hi : i < n) :
    (dotN r (ground.getAt ([] : List BPair) (idList n) i)).oneValue
      (ground.getAt BPair.unit r i) := by
  rw [idList_getAt n i hi]
  refine BPair.oneValue_trans (dotN_read r _) ?_
  rw [dotP_comm]
  exact dotP_onehot n i r hi hr

/-- A row read against the identity family has the row's own sparse
reading: the width is the stated one and the entries meet at their
representatives. -/
private theorem ofRow_dotN_idList (n : Nat) (r : List BPair)
    (hr : r.length = n) :
    ofRow ((idList n).map (fun x => dotN r x)) = ofRow r := by
  have hlen : ((idList n).map (fun x => dotN r x)).length
      = r.length := by
    rw [ground.length_map, length_idList, hr]
  have hg : ∀ i, i < ((idList n).map (fun x => dotN r x)).length →
      (ground.getAt BPair.unit
          ((idList n).map (fun x => dotN r x)) i).norm
        = (ground.getAt BPair.unit r i).norm := by
    intro i hi
    rw [ground.length_map, length_idList] at hi
    rw [ground.getAt_map ([] : List BPair) BPair.unit
      (fun x => dotN r x) (idList n) i
      (by rw [length_idList]; exact hi)]
    exact BPair.norm_congr (dotN_idList_entry n r hr i hi)
  show (((idList n).map (fun x => dotN r x)).length,
      ofRowFrom 0 ((idList n).map (fun x => dotN r x)))
    = (r.length, ofRowFrom 0 r)
  rw [hlen, ofRowFrom_congr ((idList n).map (fun x => dotN r x)) r 0
    hlen hg]

/-- The cross datum at the identity family has the stacked family's
own sparse rows, member by member. -/
private theorem ofRow_crossM_idList (n : Nat) : ∀ R : Mat, rowsLen n R →
    (crossM R (idList n)).map ofRow = R.map ofRow
  | [], _ => rfl
  | r :: t, h => by
    show ofRow ((idList n).map (fun x => dotN r x))
        :: (crossM t (idList n)).map ofRow
      = ofRow r :: t.map ofRow
    rw [ofRow_dotN_idList n r h.1, ofRow_crossM_idList n t h.2]

/-- The coordinate basis reads the kernel dimension back: the cross
datum at the identity family is the stacked family itself, entry by
entry at the norms, so the two kernel dimensions are one count. -/
theorem kernelDim_idList (n : Nat) (R : Mat) (hR : rowsLen n R) :
    kernelDim n (crossM R (idList n)) = kernelDim n R := by
  have hrank : rank (crossM R (idList n)) = rank R := by
    show sdescend (crossM R (idList n)).length (BPair.ofPos Pos.one)
        ((crossM R (idList n)).map ofRow)
      = sdescend R.length (BPair.ofPos Pos.one) (R.map ofRow)
    rw [length_crossM R (idList n), ofRow_crossM_idList n R hR]
  show n - rank (crossM R (idList n)) = n - rank R
  rw [hrank]

/-- The collection at a one-member list of the stated width keeps
the off-unit member: the residual against the vacant collection
reads the one-scaled member, off the unit at the member's own. -/
theorem collect_single : ∀ (n : Nat) (r : List BPair),
    r.length = n → ¬ poly.unitTail r → collectOf n [r] = [r] := by
  intro n r hlen hoff
  have hneg : ¬ poly.unitTail (residV n ([] : Mat) r) := by
    intro hu
    exact hoff (spanRel_nil_unit n r ⟨trivial, hlen, hu⟩)
  show (if poly.unitTail (residV n ([] : Mat) r) then ([] : Mat)
      else [] ++ [r]) = [r]
  rw [if_neg hneg]
  rfl
/-! The adjugate at a square list (`def:elim`'s adjugate): the
cofactor family transposed, its row side the two cofactor reads
entrywise, and its column side at an independent list — the site
datum's columns pairing every row of the list at the sum's unit,
the rows' span closing each column at the pairing's
definiteness. -/

/-- The adjugate of a square list: the cofactor family, the entry
at `(i, j)` the cofactor vector's read at the exchanged keys — the
rows the cofactor vectors, transposed (`def:elim`'s adjugate). -/
def adjM (G : Mat) : Mat :=
  transposeM ((List.range G.length).map (fun k => cofVec G k))

/-- The adjugate's key-list exchange is the cofactor family. -/
private theorem adjM_transpose (G : Mat) (h : 0 < G.length) :
    transposeM (adjM G)
      = (List.range G.length).map (fun k => cofVec G k) :=
  transposeM_transposeM _ (cofRows_rowsLen G) h
    (by rw [cofRows_len G]; exact h)

/-- The adjugate's row count. -/
private theorem adjM_len (G : Mat) (h : 0 < G.length) :
    (adjM G).length = G.length :=
  length_transposeM _ (cofRows_rowsLen G)
    (by rw [cofRows_len G]; exact h)

/-- The adjugate's rows read the list's count. -/
private theorem adjM_rowsLen (G : Mat) : rowsLen G.length (adjM G) :=
  rowsLen_cast (cofRows_len G) (rowsLen_transposeM _)

/-- The row side's entry: a row against the adjugate's column at a
key is that row's fold against the key's own cofactor vector. -/
private theorem adjM_entry (G : Mat) {n : Nat} (hsq : sqAt G n)
    (i j : Nat) (hi : i < n) (hj : j < n) :
    ground.getAt BPair.unit
        (ground.getAt [] (matMul G (adjM G)) i) j
      = dotN (ground.getAt [] G i) (cofVec G j) := by
  have hGl : G.length = n := sqAt_len hsq
  have hn : 0 < G.length := by
    rw [hGl]
    exact Nat.lt_of_le_of_lt (Nat.zero_le i) hi
  rw [getAt_matMul G (adjM G) i (by rw [hGl]; exact hi),
    adjM_transpose G hn,
    ground.getAt_map ([] : List BPair) BPair.unit
      (fun c => dotN (ground.getAt [] G i) c)
      ((List.range G.length).map (fun k => cofVec G k)) j
      (by rw [cofRows_len G, hGl]; exact hj),
    ground.getAt_map 0 ([] : List BPair) (fun k => cofVec G k)
      (List.range G.length) j
      (by rw [ground.length_range, hGl]; exact hj),
    ground.getAt_range G.length j (by rw [hGl]; exact hj)]

/-- The adjugate identity's diagonal: a row's fold against its own
cofactors collects the regrouped assignment fold, the
determinant. -/
theorem adjM_row_diag (G : Mat) {n : Nat} (hsq : sqAt G n) (i : Nat)
    (hi : i < n) :
    (ground.getAt BPair.unit
      (ground.getAt [] (matMul G (adjM G)) i) i).oneValue (detL G) := by
  have hGl : G.length = n := sqAt_len hsq
  have hiG : i < G.length := by rw [hGl]; exact hi
  rw [adjM_entry G hsq i i hi hi]
  exact BPair.oneValue_trans (dotN_read _ _)
    (cofVec_diag G i hiG (by rw [sqAt_row_len hsq i hiG, hGl]))

/-- The adjugate identity off the diagonal: a row's fold against a
further row's cofactors reads equal members, the fold a determinant
at that row repeated. -/
theorem adjM_row_off (G : Mat) {n : Nat} (hsq : sqAt G n) (i j : Nat)
    (hi : i < n) (hj : j < n) (hij : i ≠ j) :
    (ground.getAt BPair.unit
      (ground.getAt [] (matMul G (adjM G)) i) j).oneValue BPair.unit := by
  have hGl : G.length = n := sqAt_len hsq
  have hiG : i < G.length := by rw [hGl]; exact hi
  have hjG : j < G.length := by rw [hGl]; exact hj
  rw [adjM_entry G hsq i j hi hj]
  exact BPair.oneValue_trans (dotN_read _ _)
    (cofVec_off G i j hiG hjG hij
      (by rw [sqAt_row_len hsq i hiG, hGl]))

/-- The key parity's sign keeps a congruence, the memberwise swap
its odd arm. -/
private theorem sgnP_congr (k : Nat) {x y : BPair}
    (h : x.oneValue y) :
    (sgnPO bpairOps k x).oneValue (sgnPO bpairOps k y) := by
  show (if places.parityOf k then bpairOps.swap x else x).oneValue
    (if places.parityOf k then bpairOps.swap y else y)
  cases places.parityOf k with
  | false => exact h
  | true => exact ground.swap_congr h

/-- A rows read at a stated key keeps the rows' width. -/
private theorem rowLen_of_rowsLen {n : Nat} :
    ∀ (M : Mat) (j : Nat), rowsLen n M → j < M.length →
      (ground.getAt [] M j).length = n
  | [], _, _, hj => absurd hj (Nat.not_lt_zero _)
  | _ :: _, 0, h, _ => h.1
  | _ :: t, j + 1, h, hj =>
    rowLen_of_rowsLen t j h.2 (Nat.lt_of_succ_lt_succ hj)

/-- The adjugate's raw entry: the cofactor family at the exchanged
keys. -/
private theorem adjM_read (G : Mat) (i k : Nat) (hi : i < G.length)
    (hk : k < G.length) :
    ground.getAt BPair.unit (ground.getAt [] (adjM G) i) k
      = ground.getAt BPair.unit (cofVec G k) i := by
  rw [show adjM G = transposeM ((List.range G.length).map
        (fun j => cofVec G j)) from rfl,
    getAt_transposeM BPair.unit _ (cofRows_rowsLen G) i k hi
      (by rw [cofRows_len G]; exact hk),
    ground.getAt_map 0 ([] : List BPair) (fun j => cofVec G j)
      (List.range G.length) k (by rw [ground.length_range]; exact hk),
    ground.getAt_range G.length k hk]

/-- The struck square's exchange (`def:elim`'s exchanged row and
column lists): withdrawing row k with column i reads the
transpose's withdrawal at row i with column k, the two struck
determinants one value. -/
private theorem strike_exchange (G : Mat) {w : Nat}
    (hsq : sqAt G (w + 1)) (k i : Nat) (hk : k < w + 1)
    (hi : i < w + 1) :
    (detL (((transposeM G).eraseIdx i).map
        (fun r => r.eraseIdx k))).oneValue
      (detL ((G.eraseIdx k).map (fun r => r.eraseIdx i))) := by
  have hGl : G.length = w + 1 := sqAt_len hsq
  have hGr : rowsLen (w + 1) G := rowsLen_of_sqAt hsq
  have hTr : rowsLen (w + 1) (transposeM G) :=
    rowsLen_cast hGl (rowsLen_transposeM G)
  have hTl : (transposeM G).length = w + 1 := transposeLen G hGr hGl
  have hkG : k < G.length := by rw [hGl]; exact hk
  have hiT : i < (transposeM G).length := by rw [hTl]; exact hi
  have hEG : (G.eraseIdx k).length = w :=
    Nat.succ.inj ((ground.length_eraseIdx G k hkG).trans hGl)
  have hET : ((transposeM G).eraseIdx i).length = w :=
    Nat.succ.inj
      ((ground.length_eraseIdx (transposeM G) i hiT).trans hTl)
  have hYr : rowsLen w ((G.eraseIdx k).map (fun r => r.eraseIdx i)) :=
    rowsLen_eraseCol _ _ hi (G.eraseIdx k)
      (rowsLen_eraseIdx (w + 1) G k hGr)
  have hYl : ((G.eraseIdx k).map (fun r => r.eraseIdx i)).length
      = w := by
    rw [ground.length_map]; exact hEG
  have hXl : (((transposeM G).eraseIdx i).map
      (fun r => r.eraseIdx k)).length = w := by
    rw [ground.length_map]; exact hET
  have hYr' : rowsLen ((G.eraseIdx k).map
      (fun r => r.eraseIdx i)).length
      ((G.eraseIdx k).map (fun r => r.eraseIdx i)) :=
    rowsLen_cast hYl.symm hYr
  have hTYl : (transposeM ((G.eraseIdx k).map
      (fun r => r.eraseIdx i))).length = w :=
    (transposeLen _ hYr hYl)
  refine BPair.oneValue_trans
    (detL_congr_letters _ _ (hXl.trans hTYl.symm) ?_) ?_
  · intro a ha b hb
    rw [hXl] at ha hb
    have haw : a < ((transposeM G).eraseIdx i).length := by
      rw [hET]; exact ha
    have hbw : b < (G.eraseIdx k).length := by
      rw [hEG]; exact hb
    have ha1 : a + 1 < w + 1 := Nat.succ_lt_succ ha
    have hb1 : b + 1 < w + 1 := Nat.succ_lt_succ hb
    have han : a < w + 1 := Nat.lt_of_succ_lt ha1
    have hbn : b < w + 1 := Nat.lt_of_succ_lt hb1
    rw [ground.getAt_map ([] : List BPair) ([] : List BPair)
        (fun r => r.eraseIdx k) ((transposeM G).eraseIdx i) a haw,
      getAt_transposeM BPair.unit _ hYr a b ha
        (by rw [hYl]; exact hb),
      ground.getAt_map ([] : List BPair) ([] : List BPair)
        (fun r => r.eraseIdx i) (G.eraseIdx k) b hbw]
    show (ground.getAt BPair.unit
        ((ground.getAt [] ((transposeM G).eraseIdx i) a).eraseIdx k)
        b).oneValue
      (ground.getAt BPair.unit
        ((ground.getAt [] (G.eraseIdx k) b).eraseIdx i) a)
    rw [getAt_eraseIdx BPair.unit
        (ground.getAt [] ((transposeM G).eraseIdx i) a) k b,
      getAt_eraseIdx BPair.unit
        (ground.getAt [] (G.eraseIdx k) b) i a,
      getAt_eraseIdx ([] : List BPair) (transposeM G) i a,
      getAt_eraseIdx ([] : List BPair) G k b]
    by_cases hai : a < i
    · rw [if_pos hai, if_pos hai]
      by_cases hbk : b < k
      · rw [if_pos hbk, if_pos hbk,
          getAt_transposeM BPair.unit G hGr a b han
            (by rw [hGl]; exact hbn)]
        exact BPair.oneValue_refl _
      · rw [if_neg hbk, if_neg hbk,
          getAt_transposeM BPair.unit G hGr a (b + 1) han
            (by rw [hGl]; exact hb1)]
        exact BPair.oneValue_refl _
    · rw [if_neg hai, if_neg hai]
      by_cases hbk : b < k
      · rw [if_pos hbk, if_pos hbk,
          getAt_transposeM BPair.unit G hGr (a + 1) b ha1
            (by rw [hGl]; exact hbn)]
        exact BPair.oneValue_refl _
      · rw [if_neg hbk, if_neg hbk,
          getAt_transposeM BPair.unit G hGr (a + 1) (b + 1) ha1
            (by rw [hGl]; exact hb1)]
        exact BPair.oneValue_refl _
  · exact BPair.oneValue_of_eq (detL_transpose _ hYr')

/-- The cofactor family at the exchanged keys: the transpose's
cofactor vector reads the original's at the keys exchanged, the
struck squares' exchange under the shared sign. -/
private theorem cofVec_transpose (G : Mat) {n : Nat}
    (hsq : sqAt G n) (i k : Nat) (hi : i < n) (hk : k < n) :
    (ground.getAt BPair.unit (cofVec (transposeM G) i) k).oneValue
      (ground.getAt BPair.unit (cofVec G k) i) := by
  cases n with
  | zero => exact absurd hi (Nat.not_lt_zero i)
  | succ w =>
    have hGl : G.length = w + 1 := sqAt_len hsq
    have hGr : rowsLen (w + 1) G := rowsLen_of_sqAt hsq
    have hTr : rowsLen (w + 1) (transposeM G) :=
      rowsLen_cast hGl (rowsLen_transposeM G)
    have hTl : (transposeM G).length = w + 1 := transposeLen G hGr hGl
    have hkG : k < G.length := by rw [hGl]; exact hk
    have hiG : i < G.length := by rw [hGl]; exact hi
    have hkT : k < (transposeM G).length := by rw [hTl]; exact hk
    have hiT : i < (transposeM G).length := by rw [hTl]; exact hi
    have hET : ((transposeM G).eraseIdx i).length = w :=
      Nat.succ.inj
        ((ground.length_eraseIdx (transposeM G) i hiT).trans hTl)
    have hEG : (G.eraseIdx k).length = w :=
      Nat.succ.inj ((ground.length_eraseIdx G k hkG).trans hGl)
    show (ground.getAt BPair.unit
        ((List.range (transposeM G).length).map (fun j =>
          sgnPO bpairOps (i + j)
            (cof0O bpairOps ((transposeM G).eraseIdx i) j)))
        k).oneValue
      (ground.getAt BPair.unit
        ((List.range G.length).map (fun j =>
          sgnPO bpairOps (k + j)
            (cof0O bpairOps (G.eraseIdx k) j))) i)
    rw [ground.getAt_map 0 BPair.unit _
        (List.range (transposeM G).length) k
        (by rw [ground.length_range]; exact hkT),
      ground.getAt_range (transposeM G).length k hkT,
      ground.getAt_map 0 BPair.unit _ (List.range G.length) i
        (by rw [ground.length_range]; exact hiG),
      ground.getAt_range G.length i hiG,
      cof0O_strike (R := bpairEqRead) bpairEqCore ((transposeM G).eraseIdx i) k
        (Nat.le_of_lt_succ (by rw [hET]; exact hk)),
      cof0O_strike (R := bpairEqRead) bpairEqCore (G.eraseIdx k) i
        (Nat.le_of_lt_succ (by rw [hEG]; exact hi)),
      Nat.add_comm k i]
    exact sgnP_congr (i + k) (strike_exchange G hsq k i hk hi)

/-- A symmetric square is its own transpose: each transposed entry
is the exchanged key pair's, which the symmetry reads back, the
lists equal entry by entry. -/
private theorem transposeM_symm (G : Mat) {n : Nat}
    (hsq : sqAt G n)
    (hsym : ∀ i j, i < n → j < n →
      ground.getAt BPair.unit (ground.getAt [] G i) j
        = ground.getAt BPair.unit (ground.getAt [] G j) i) :
    transposeM G = G := by
  have hGl : G.length = n := sqAt_len hsq
  have hGr : rowsLen n G := rowsLen_of_sqAt hsq
  have hTl : (transposeM G).length = n := transposeLen G hGr hGl
  have hTr : rowsLen G.length (transposeM G) := rowsLen_transposeM G
  refine ground.getAt_ext ([] : List BPair) _ _
    (hTl.trans hGl.symm) ?_
  intro p hp
  rw [hTl] at hp
  have hpG : p < G.length := by rw [hGl]; exact hp
  have hpT : p < (transposeM G).length := by rw [hTl]; exact hp
  refine ground.getAt_ext BPair.unit _ _ ?_ ?_
  · rw [rowsLen_getAt (transposeM G) p hTr hpT,
      rowsLen_getAt G p hGr hpG, hGl]
  · intro q hq
    rw [rowsLen_getAt (transposeM G) p hTr hpT] at hq
    rw [getAt_transposeM BPair.unit G hGr p q hp hq]
    exact hsym q p (by rw [← hGl]; exact hq) hp

/-- The head cofactors read across the exchange at a symmetric
square: the row struck at one key against the column struck at
the other reads the exchanged strike's own — each head cofactor
the struck family's determinant, the exchanged key lists'
determinants joined across the transpose (`strike_exchange`) with
the symmetric square its own transpose. -/
private theorem cof0_strike_symm (G : Mat) {n : Nat}
    (hsq : sqAt G n)
    (hsym : ∀ i j, i < n → j < n →
      ground.getAt BPair.unit (ground.getAt [] G i) j
        = ground.getAt BPair.unit (ground.getAt [] G j) i)
    (k j : Nat) (hk : k < n) (hj : j < n) :
    (cof0 (G.eraseIdx k) j).oneValue (cof0 (G.eraseIdx j) k) := by
  match n, hsq, hsym, hk, hj with
  | 0, _, _, hk0, _ => exact absurd hk0 (Nat.not_lt_zero k)
  | w + 1, hsq, hsym, hk, hj =>
    have hGl : G.length = w + 1 := sqAt_len hsq
    have hEk : (G.eraseIdx k).length = w :=
      Nat.succ.inj ((ground.length_eraseIdx G k
        (by rw [hGl]; exact hk)).trans hGl)
    have hEj : (G.eraseIdx j).length = w :=
      Nat.succ.inj ((ground.length_eraseIdx G j
        (by rw [hGl]; exact hj)).trans hGl)
    have hSk := cof0O_strike (R := ground.bpairRead)
      bpairLaws.toDCore (G.eraseIdx k) j
      (by rw [hEk]; exact Nat.le_of_lt_succ hj)
    have hSj := cof0O_strike (R := ground.bpairRead)
      bpairLaws.toDCore (G.eraseIdx j) k
      (by rw [hEj]; exact Nat.le_of_lt_succ hk)
    have hex := strike_exchange G hsq j k hj hk
    rw [transposeM_symm G hsq hsym] at hex
    exact BPair.oneValue_trans hSk
      (BPair.oneValue_trans hex (BPair.oneValue_symm hSj))

/-- The adjugate solve's entry at a row of a symmetric square,
read as the column fold: a family carrying that row's entries
folds against the cofactor vectors' entries at the stated column
key to the determinant at the row's own key and the sum's unit at
every further key — the determinant-scaled identity datum's
entrywise collection (`lem:dualread`(i)'s Gram-dual
coevaluation). -/
theorem adjP_row_fold (G : Mat) {n : Nat} (hsq : sqAt G n)
    (hsym : ∀ i < n, ∀ j < n,
      ground.getAt BPair.unit (ground.getAt [] G i) j
        = ground.getAt BPair.unit (ground.getAt [] G j) i)
    (b' j : Nat) (hb' : b' < n) (hj : j < n) (B : Nat → BPair)
    (hB : ∀ k, k < n →
      B k = ground.getAt BPair.unit (ground.getAt [] G b') k) :
    (ground.famFold BPair.add BPair.unit
      (fun k => B k * ground.getAt BPair.unit (cofVec G k) j)
      (List.range n)).oneValue
      (if j = b' then detL G else BPair.unit) := by
  have hlen : G.length = n := sqAt_len hsq
  have hrows : rowsLen n G := rowsLen_of_sqAt hsq
  have hjG : j < G.length := by rw [hlen]; exact hj
  have hbG : b' < G.length := by rw [hlen]; exact hb'
  have hrow : (ground.getAt [] G b').length = G.length := by
    rw [rowsLen_getAt G b' hrows hbG, hlen]
  have h3 : dotP (ground.getAt [] G b') (cofVec G j)
      = ground.famFold BPair.add BPair.unit
        (fun k => ground.getAt BPair.unit (ground.getAt [] G b') k
          * sgnP (j + k) (cof0 (G.eraseIdx j) k))
        (List.range G.length) :=
    dotO_map_range bpairOps
      (fun k => sgnP (j + k) (cof0 (G.eraseIdx j) k))
      G.length (ground.getAt [] G b') hrow
  rw [hlen] at h3
  refine BPair.oneValue_trans
    (ground.foldB_congr_members
      (fun k => B k * ground.getAt BPair.unit (cofVec G k) j)
      (fun k => ground.getAt BPair.unit (ground.getAt [] G b') k
        * sgnP (j + k) (cof0 (G.eraseIdx j) k))
      (List.range n) ?_)
    (BPair.oneValue_trans (BPair.oneValue_of_eq h3.symm) ?_)
  · intro t ht
    have htn : t < n := ground.ltOfMem ht
    have htG : t < G.length := by rw [hlen]; exact htn
    have hentry : ground.getAt BPair.unit (cofVec G t) j
        = sgnP (t + j) (cof0 (G.eraseIdx t) j) := by
      show ground.getAt BPair.unit
          ((List.range G.length).map
            (fun i => sgnP (t + i) (cof0 (G.eraseIdx t) i))) j
        = sgnP (t + j) (cof0 (G.eraseIdx t) j)
      rw [ground.getAt_map 0 BPair.unit _ (List.range G.length) j
          (by rw [ground.length_range]; exact hjG),
        ground.getAt_range G.length j hjG]
    show (B t * ground.getAt BPair.unit (cofVec G t) j).oneValue
      (ground.getAt BPair.unit (ground.getAt [] G b') t
        * sgnP (j + t) (cof0 (G.eraseIdx j) t))
    rw [hB t htn, hentry, Nat.add_comm t j]
    exact BPair.mul_congr (BPair.oneValue_refl _)
      (sgnPO_congr (R := ground.bpairRead) bpairLaws.toDCore
        (cof0_strike_symm G hsq
          (fun i j hi hj => hsym i hi j hj) t j htn hj))
  · by_cases hjb : j = b'
    · rw [if_pos hjb, hjb]
      exact cofVec_diag G b' hbG hrow
    · rw [if_neg hjb]
      exact cofVec_off G b' j hbG hjG (fun he => hjb he.symm) hrow

/-- The adjugate's row against the transpose's cofactor vector:
the two lists read one value entry for entry. -/
private theorem adjM_row_cofT (G : Mat) {n : Nat} (hsq : sqAt G n)
    (i : Nat) (hi : i < n) :
    poly.oneValue (ground.getAt [] (adjM G) i)
      (cofVec (transposeM G) i) := by
  have hGl : G.length = n := sqAt_len hsq
  have hGr : rowsLen n G := rowsLen_of_sqAt hsq
  have hnG : 0 < G.length := by
    rw [hGl]; exact Nat.lt_of_le_of_lt (Nat.zero_le i) hi
  have hTl : (transposeM G).length = n := transposeLen G hGr hGl
  have hiA : i < (adjM G).length := by
    rw [adjM_len G hnG, hGl]; exact hi
  have hrowA : (ground.getAt [] (adjM G) i).length = G.length :=
    rowLen_of_rowsLen (adjM G) i (adjM_rowsLen G) hiA
  have hcofT : (cofVec (transposeM G) i).length = G.length := by
    rw [length_cofVec, hTl, hGl]
  refine poly.ov_of_getAt (fun j => ?_)
  by_cases hj : j < G.length
  · rw [adjM_read G i j (by rw [hGl]; exact hi) hj]
    exact BPair.oneValue_symm
      (cofVec_transpose G hsq i j hi (by rw [← hGl]; exact hj))
  · rw [ground.getAt_over BPair.unit _ j
        (by rw [hrowA]; exact Nat.le_of_not_lt hj),
      ground.getAt_over BPair.unit _ j
        (by rw [hcofT]; exact Nat.le_of_not_lt hj)]
    exact BPair.oneValue_refl _

/-- The adjugate's column side at the diagonal: the product against
the list reads the determinant, the row side at the exchanged row
and column lists (`def:elim`'s adjugate identity, both ways). -/
theorem adjM_col_diag (G : Mat) {n : Nat} (hsq : sqAt G n)
    (i : Nat) (hi : i < n) :
    (ground.getAt BPair.unit
      (ground.getAt [] (matMul (adjM G) G) i) i).oneValue (detL G) := by
  have hGl : G.length = n := sqAt_len hsq
  have hGr : rowsLen n G := rowsLen_of_sqAt hsq
  have hnG : 0 < G.length := by
    rw [hGl]; exact Nat.lt_of_le_of_lt (Nat.zero_le i) hi
  have hTr : rowsLen n (transposeM G) :=
    rowsLen_cast hGl (rowsLen_transposeM G)
  have hTl : (transposeM G).length = n := transposeLen G hGr hGl
  have hiA : i < (adjM G).length := by
    rw [adjM_len G hnG, hGl]; exact hi
  rw [getAt_matMul (adjM G) G i hiA,
    ground.getAt_map ([] : List BPair) BPair.unit
      (fun c => dotN (ground.getAt [] (adjM G) i) c) (transposeM G)
      i (by rw [hTl]; exact hi)]
  refine BPair.oneValue_trans (dotN_read _ _) ?_
  refine BPair.oneValue_trans
    (dotP_oneValue_left _ (cofVec (transposeM G) i) _
      (adjM_row_cofT G hsq i hi)) ?_
  rw [dotP_comm]
  refine BPair.oneValue_trans
    (cofVec_diag (transposeM G) i (by rw [hTl]; exact hi)
      (by rw [rowLen_of_rowsLen (transposeM G) i hTr
          (by rw [hTl]; exact hi), hTl])) ?_
  exact BPair.oneValue_of_eq
    (detL_transpose G (rowsLen_cast hGl.symm hGr))

/-- The adjugate's column side off the diagonal: the product
against the list reads equal members, the exchanged read a repeated
row of the transpose. -/
theorem adjM_col_off (G : Mat) {n : Nat} (hsq : sqAt G n)
    (i j : Nat) (hi : i < n) (hj : j < n) (hij : i ≠ j) :
    (ground.getAt BPair.unit
      (ground.getAt [] (matMul (adjM G) G) i) j).oneValue
      BPair.unit := by
  have hGl : G.length = n := sqAt_len hsq
  have hGr : rowsLen n G := rowsLen_of_sqAt hsq
  have hnG : 0 < G.length := by
    rw [hGl]; exact Nat.lt_of_le_of_lt (Nat.zero_le i) hi
  have hTr : rowsLen n (transposeM G) :=
    rowsLen_cast hGl (rowsLen_transposeM G)
  have hTl : (transposeM G).length = n := transposeLen G hGr hGl
  have hiA : i < (adjM G).length := by
    rw [adjM_len G hnG, hGl]; exact hi
  rw [getAt_matMul (adjM G) G i hiA,
    ground.getAt_map ([] : List BPair) BPair.unit
      (fun c => dotN (ground.getAt [] (adjM G) i) c) (transposeM G)
      j (by rw [hTl]; exact hj)]
  refine BPair.oneValue_trans (dotN_read _ _) ?_
  refine BPair.oneValue_trans
    (dotP_oneValue_left _ (cofVec (transposeM G) i) _
      (adjM_row_cofT G hsq i hi)) ?_
  rw [dotP_comm]
  exact cofVec_off (transposeM G) j i (by rw [hTl]; exact hj)
    (by rw [hTl]; exact hi) (fun h => hij h.symm)
    (by rw [rowLen_of_rowsLen (transposeM G) j hTr
        (by rw [hTl]; exact hj), hTl])


/-! The adjugate identity at any entry bundle (`def:elim`'s
adjugate identity: a row's fold against its own cofactors collects
the regrouped assignment fold, the determinant, and against a
further row's cofactors it reads equal members — the reads run
over the ground pairs, over their balance pairs, and over the
polynomials as the entry carrier in turn, each level's cofactor
and injectivity the level below's own).  The row side is the
cofactor vector's two reads; the column side is the same two at
the exchanged strike. -/

/-- The cofactor at a stated determinant read is the head
cofactor's own signed strike. -/
private theorem cofO_read {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel)
    (det : List (List γ) → γ) (sw : γ → γ)
    (hdet : ∀ E : List (List γ), rowsLen E.length E →
      R.rel (det E) (detO ops E))
    (hsw : ∀ x : γ, R.rel (sw x) (ops.swap x))
    (m : List (List γ)) (hsq : rowsLen m.length m)
    (j s : Nat) (hj : j < m.length) (hs : s < m.length) :
    R.rel (cofO det sw m j s)
      (sgnPO ops (j + s) (cof0O ops (m.eraseIdx j) s)) := by
  have hlen : (m.eraseIdx j).length + 1 = m.length :=
    ground.length_eraseIdx m j hj
  have hsl1 : s < (m.eraseIdx j).length + 1 := by
    rw [hlen]
    exact hs
  have hsle : s ≤ (m.eraseIdx j).length := Nat.le_of_lt_succ hsl1
  have hEr : rowsLen (m.eraseIdx j).length
      ((m.eraseIdx j).map (fun r => r.eraseIdx s)) :=
    rowsLen_eraseCol _ s (by rw [hlen]; exact hs) (m.eraseIdx j)
      (by rw [hlen]; exact rowsLen_eraseIdx m.length m j hsq)
  have hEsq : rowsLen ((m.eraseIdx j).map
      (fun r => r.eraseIdx s)).length
      ((m.eraseIdx j).map (fun r => r.eraseIdx s)) := by
    rw [ground.length_map]
    exact hEr
  have hst := cof0O_strike C (m.eraseIdx j) s hsle
  show R.rel (if places.parityOf (j + s)
      then sw (det ((m.eraseIdx j).map (fun r => r.eraseIdx s)))
      else det ((m.eraseIdx j).map (fun r => r.eraseIdx s)))
    (if places.parityOf (j + s)
      then ops.swap (cof0O ops (m.eraseIdx j) s)
      else cof0O ops (m.eraseIdx j) s)
  cases places.parityOf (j + s) with
  | true =>
    exact C.ovTrans (hsw _)
      (C.swapCongr (C.ovTrans (hdet _ hEsq) (C.ovSymm hst)))
  | false => exact C.ovTrans (hdet _ hEsq) (C.ovSymm hst)

/-- The row side's entry: a row against the adjugate's column at a
key is that row's fold against the key's own cofactor vector. -/
private theorem adjO_rowFold {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (det : List (List γ) → γ) (sw : γ → γ)
    (hdet : ∀ E : List (List γ), rowsLen E.length E →
      R.rel (det E) (detO ops E))
    (hsw : ∀ x : γ, R.rel (sw x) (ops.swap x))
    (m : List (List γ)) (hsq : rowsLen m.length m)
    (i j : Nat) (hi : i < m.length) (hj : j < m.length) :
    R.rel (ground.getAt ops.unit
        (ground.getAt [] (matMulO ops m (adjO det sw m)) i) j)
      (dotO ops (ground.getAt [] m i) (cofVecO ops m j)) := by
  have hrow : (ground.getAt [] m i).length = m.length :=
    rowsLen_getAt m i hsq hi
  have hAl : (adjO det sw m).length = m.length :=
    ground.matOf_length m.length m.length _
  have hAr : rowsLen m.length (adjO det sw m) :=
    rowsLen_matOf m.length m.length _
  have hw : ((adjO det sw m).headD []).length = m.length :=
    headD_len_of _ m.length hAl hAr
  have hentry : ∀ s, s < m.length →
      ground.getAt ops.unit
        (ground.getAt [] (adjO det sw m) s) j = cofO det sw m j s :=
    fun s hs => ground.matOf_entry ([] : List γ) ops.unit
      m.length m.length (fun p q => cofO det sw m q p) s j hs hj
  rw [show dotO ops (ground.getAt [] m i) (cofVecO ops m j)
      = ground.famFold ops.add ops.unit
        (fun s => ops.mul
          (ground.getAt ops.unit (ground.getAt [] m i) s)
          (sgnPO ops (j + s) (cof0O ops (m.eraseIdx j) s)))
        (List.range m.length) from
    dotO_map_range ops _ m.length (ground.getAt [] m i) hrow]
  refine L.ovTrans (matMulO_entry L m (adjO det sw m) m.length
    m.length hsq hw i j hi hj) ?_
  refine foldO_congr_members L.toDCore _ _ (List.range m.length)
    (fun s hs => ?_)
  have hsm : s < m.length := ground.ltOfMem hs
  rw [hentry s hsm]
  exact L.mulCongr (L.ovRefl _)
    (cofO_read L.toDCore det sw hdet hsw m hsq j s hj hsm)

/-- The adjugate identity's diagonal at any entry bundle: a row's
fold against its own cofactors collects the regrouped assignment
fold, the determinant. -/
theorem adjO_row_diag {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (det : List (List γ) → γ) (sw : γ → γ)
    (hdet : ∀ E : List (List γ), rowsLen E.length E →
      R.rel (det E) (detO ops E))
    (hsw : ∀ x : γ, R.rel (sw x) (ops.swap x))
    (m : List (List γ)) (hsq : rowsLen m.length m)
    (i : Nat) (hi : i < m.length) :
    R.rel (ground.getAt ops.unit
        (ground.getAt [] (matMulO ops m (adjO det sw m)) i) i)
      (det m) :=
  L.ovTrans (adjO_rowFold L det sw hdet hsw m hsq i i hi hi)
    (L.ovTrans (cofVecO_diag L m i hi (rowsLen_getAt m i hsq hi))
      (L.ovSymm (hdet m hsq)))

/-- The adjugate identity off the diagonal at any entry bundle: a
row's fold against a further row's cofactors reads equal members,
the fold a determinant at that row repeated. -/
theorem adjO_row_off {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (det : List (List γ) → γ) (sw : γ → γ)
    (hdet : ∀ E : List (List γ), rowsLen E.length E →
      R.rel (det E) (detO ops E))
    (hsw : ∀ x : γ, R.rel (sw x) (ops.swap x))
    (m : List (List γ)) (hsq : rowsLen m.length m)
    (i j : Nat) (hi : i < m.length) (hj : j < m.length)
    (hij : i ≠ j) :
    R.rel (ground.getAt ops.unit
        (ground.getAt [] (matMulO ops m (adjO det sw m)) i) j)
      ops.unit :=
  L.ovTrans (adjO_rowFold L det sw hdet hsw m hsq i j hi hj)
    (cofVecO_off L m i j hi hj hij (rowsLen_getAt m i hsq hi))

/-- The struck square's exchange at any entry bundle
(`def:elim`'s exchanged row and column lists): withdrawing row `k`
with column `i` reads the transpose's withdrawal at row `i` with
column `k`, the two struck determinants one value. -/
private theorem strikeO_exchange {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel)
    (m : List (List γ)) (hsq : rowsLen m.length m)
    (k i : Nat) (hk : k < m.length) (hi : i < m.length) :
    R.rel (detO ops (((transposeO ops m).eraseIdx i).map
        (fun r => r.eraseIdx k)))
      (detO ops ((m.eraseIdx k).map (fun r => r.eraseIdx i))) := by
  have hpos : 0 < m.length := Nat.lt_of_le_of_lt (Nat.zero_le k) hk
  have hTl : (transposeO ops m).length = m.length :=
    length_transposeO ops m hsq hpos
  have hTr : rowsLen m.length (transposeO ops m) :=
    rowsLen_transposeO ops m
  have hiT : i < (transposeO ops m).length := by
    rw [hTl]
    exact hi
  have hEm : (m.eraseIdx k).length + 1 = m.length :=
    ground.length_eraseIdx m k hk
  have hET : ((transposeO ops m).eraseIdx i).length
      = (m.eraseIdx k).length :=
    Nat.succ.inj ((ground.length_eraseIdx (transposeO ops m) i
      hiT).trans (hTl.trans hEm.symm))
  have hYr : rowsLen (m.eraseIdx k).length
      ((m.eraseIdx k).map (fun r => r.eraseIdx i)) :=
    rowsLen_eraseCol _ i (by rw [hEm]; exact hi) (m.eraseIdx k)
      (by rw [hEm]; exact rowsLen_eraseIdx m.length m k hsq)
  have hYl : ((m.eraseIdx k).map (fun r => r.eraseIdx i)).length
      = (m.eraseIdx k).length := ground.length_map _ _
  have hYr' : rowsLen ((m.eraseIdx k).map
      (fun r => r.eraseIdx i)).length
      ((m.eraseIdx k).map (fun r => r.eraseIdx i)) := by
    rw [hYl]
    exact hYr
  have hXl : (((transposeO ops m).eraseIdx i).map
      (fun r => r.eraseIdx k)).length = (m.eraseIdx k).length := by
    rw [ground.length_map]
    exact hET
  have hTYl : (transposeO ops ((m.eraseIdx k).map
      (fun r => r.eraseIdx i))).length = (m.eraseIdx k).length := by
    match hnil : (m.eraseIdx k).map (fun r => r.eraseIdx i) with
    | [] =>
      rw [hnil] at hYl
      rw [hnil, ← hYl]
      rfl
    | c :: cs =>
      have hposY : 0 < ((m.eraseIdx k).map
          (fun r => r.eraseIdx i)).length := by
        rw [hnil]
        exact Nat.succ_pos cs.length
      exact length_transposeO ops _ hYr hposY
  refine C.ovTrans (detO_congr_letters C _ _
    (hXl.trans hTYl.symm) (fun a ha b hb => ?_))
    (detO_transpose C _ hYr')
  rw [hXl] at ha hb
  have haT : a < ((transposeO ops m).eraseIdx i).length := by
    rw [hET]
    exact ha
  have ha1 : a + 1 < m.length := by
    rw [← hEm]
    exact Nat.succ_lt_succ ha
  have hb1 : b + 1 < m.length := by
    rw [← hEm]
    exact Nat.succ_lt_succ hb
  have han : a < m.length := Nat.lt_of_succ_lt ha1
  have hbn : b < m.length := Nat.lt_of_succ_lt hb1
  rw [ground.getAt_map ([] : List γ) ([] : List γ)
      (fun r => r.eraseIdx k) ((transposeO ops m).eraseIdx i) a haT,
    getAt_transposeO ops ops.unit _ hYr' a b
      (by rw [hYl]; exact ha) (by rw [hYl]; exact hb),
    ground.getAt_map ([] : List γ) ([] : List γ)
      (fun r => r.eraseIdx i) (m.eraseIdx k) b hb,
    getAt_eraseIdx ops.unit
      (ground.getAt [] ((transposeO ops m).eraseIdx i) a) k b,
    getAt_eraseIdx ops.unit
      (ground.getAt [] (m.eraseIdx k) b) i a,
    getAt_eraseIdx ([] : List γ) (transposeO ops m) i a,
    getAt_eraseIdx ([] : List γ) m k b]
  by_cases hai : a < i
  · rw [if_pos hai, if_pos hai]
    by_cases hbk : b < k
    · rw [if_pos hbk, if_pos hbk,
        getAt_transposeO ops ops.unit m hsq a b han hbn]
      exact C.ovRefl _
    · rw [if_neg hbk, if_neg hbk,
        getAt_transposeO ops ops.unit m hsq a (b + 1) han hb1]
      exact C.ovRefl _
  · rw [if_neg hai, if_neg hai]
    by_cases hbk : b < k
    · rw [if_pos hbk, if_pos hbk,
        getAt_transposeO ops ops.unit m hsq (a + 1) b ha1 hbn]
      exact C.ovRefl _
    · rw [if_neg hbk, if_neg hbk,
        getAt_transposeO ops ops.unit m hsq (a + 1) (b + 1) ha1 hb1]
      exact C.ovRefl _

/-- The head cofactors read across the exchange: the row struck at
one key against the column struck at the other reads the exchanged
strike's own on the transpose. -/
private theorem cof0O_exchange {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (C : DCore γ ops R.rel)
    (m : List (List γ)) (hsq : rowsLen m.length m)
    (s i : Nat) (hs : s < m.length) (hi : i < m.length) :
    R.rel (cof0O ops (m.eraseIdx s) i)
      (cof0O ops ((transposeO ops m).eraseIdx i) s) := by
  have hpos : 0 < m.length := Nat.lt_of_le_of_lt (Nat.zero_le s) hs
  have hTl : (transposeO ops m).length = m.length :=
    length_transposeO ops m hsq hpos
  have hiT : i < (transposeO ops m).length := by
    rw [hTl]
    exact hi
  have hEm : (m.eraseIdx s).length + 1 = m.length :=
    ground.length_eraseIdx m s hs
  have hET : ((transposeO ops m).eraseIdx i).length + 1 = m.length :=
    (ground.length_eraseIdx (transposeO ops m) i hiT).trans hTl
  have hi1 : i < (m.eraseIdx s).length + 1 := by
    rw [hEm]
    exact hi
  have hs1 : s < ((transposeO ops m).eraseIdx i).length + 1 := by
    rw [hET]
    exact hs
  have h1 := cof0O_strike C (m.eraseIdx s) i (Nat.le_of_lt_succ hi1)
  have h2 := cof0O_strike C ((transposeO ops m).eraseIdx i) s
    (Nat.le_of_lt_succ hs1)
  exact C.ovTrans h1
    (C.ovTrans (C.ovSymm (strikeO_exchange C m hsq s i hs hi))
      (C.ovSymm h2))

/-- The column side's entry at any entry bundle: the adjugate's row
against the list's column at a key is the transpose's row fold
against the key's own cofactor vector. -/
private theorem adjO_colFold {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (det : List (List γ) → γ) (sw : γ → γ)
    (hdet : ∀ E : List (List γ), rowsLen E.length E →
      R.rel (det E) (detO ops E))
    (hsw : ∀ x : γ, R.rel (sw x) (ops.swap x))
    (m : List (List γ)) (hsq : rowsLen m.length m)
    (i j : Nat) (hi : i < m.length) (hj : j < m.length) :
    R.rel (ground.getAt ops.unit
        (ground.getAt [] (matMulO ops (adjO det sw m) m) i) j)
      (dotO ops (ground.getAt [] (transposeO ops m) j)
        (cofVecO ops (transposeO ops m) i)) := by
  have hpos : 0 < m.length := Nat.lt_of_le_of_lt (Nat.zero_le i) hi
  have hTl : (transposeO ops m).length = m.length :=
    length_transposeO ops m hsq hpos
  have hTr : rowsLen m.length (transposeO ops m) :=
    rowsLen_transposeO ops m
  have hjT : j < (transposeO ops m).length := by
    rw [hTl]
    exact hj
  have hrowT : (ground.getAt [] (transposeO ops m) j).length
      = (transposeO ops m).length := by
    rw [rowsLen_getAt (transposeO ops m) j hTr hjT, hTl]
  have hAl : (adjO det sw m).length = m.length :=
    ground.matOf_length m.length m.length _
  have hAr : rowsLen m.length (adjO det sw m) :=
    rowsLen_matOf m.length m.length _
  have hw : (m.headD []).length = m.length :=
    headD_len_of m m.length rfl hsq
  have hiA : i < (adjO det sw m).length := by
    rw [hAl]
    exact hi
  have hentry : ∀ s, s < m.length →
      ground.getAt ops.unit
        (ground.getAt [] (adjO det sw m) i) s = cofO det sw m s i :=
    fun s hs => ground.matOf_entry ([] : List γ) ops.unit
      m.length m.length (fun p q => cofO det sw m q p) i s hi hs
  rw [show dotO ops (ground.getAt [] (transposeO ops m) j)
      (cofVecO ops (transposeO ops m) i)
      = ground.famFold ops.add ops.unit
        (fun s => ops.mul (ground.getAt ops.unit
            (ground.getAt [] (transposeO ops m) j) s)
          (sgnPO ops (i + s)
            (cof0O ops ((transposeO ops m).eraseIdx i) s)))
        (List.range (transposeO ops m).length) from
    dotO_map_range ops _ (transposeO ops m).length
      (ground.getAt [] (transposeO ops m) j) hrowT, hTl]
  refine L.ovTrans (matMulO_entry L (adjO det sw m) m m.length
    m.length hAr hw i j hiA hj) ?_
  refine foldO_congr_members L.toDCore _ _ (List.range m.length)
    (fun s hs => ?_)
  have hsm : s < m.length := ground.ltOfMem hs
  rw [hentry s hsm, getAt_transposeO ops ops.unit m hsq j s hj hsm]
  refine L.ovTrans (L.mulComm _ _) ?_
  refine L.mulCongr (L.ovRefl _) ?_
  refine L.ovTrans
    (cofO_read L.toDCore det sw hdet hsw m hsq s i hsm hi) ?_
  rw [Nat.add_comm s i]
  exact sgnPO_congr L.toDCore (cof0O_exchange L.toDCore m hsq s i hsm hi)

/-- The adjugate identity's column side at the diagonal, at any
entry bundle: the product against the list reads the determinant,
the row side at the exchanged row and column lists. -/
theorem adjO_col_diag {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (det : List (List γ) → γ) (sw : γ → γ)
    (hdet : ∀ E : List (List γ), rowsLen E.length E →
      R.rel (det E) (detO ops E))
    (hsw : ∀ x : γ, R.rel (sw x) (ops.swap x))
    (m : List (List γ)) (hsq : rowsLen m.length m)
    (i : Nat) (hi : i < m.length) :
    R.rel (ground.getAt ops.unit
        (ground.getAt [] (matMulO ops (adjO det sw m) m) i) i)
      (det m) := by
  have hpos : 0 < m.length := Nat.lt_of_le_of_lt (Nat.zero_le i) hi
  have hTl : (transposeO ops m).length = m.length :=
    length_transposeO ops m hsq hpos
  have hTr : rowsLen m.length (transposeO ops m) :=
    rowsLen_transposeO ops m
  have hTsq : rowsLen (transposeO ops m).length
      (transposeO ops m) := by
    rw [hTl]
    exact hTr
  have hiT : i < (transposeO ops m).length := by
    rw [hTl]
    exact hi
  refine L.ovTrans (adjO_colFold L det sw hdet hsw m hsq i i hi hi) ?_
  refine L.ovTrans (cofVecO_diag L (transposeO ops m) i hiT
    (rowsLen_getAt (transposeO ops m) i hTsq hiT)) ?_
  exact L.ovTrans (detO_transpose L.toDCore m hsq)
    (L.ovSymm (hdet m hsq))

/-- The adjugate identity's column side off the diagonal, at any
entry bundle: the product against the list reads equal members, the
exchanged read a repeated row of the transpose. -/
theorem adjO_col_off {γ : Type} {ops : DOps γ}
    {R : ground.DRead γ} (L : DLaws γ ops R.rel)
    (det : List (List γ) → γ) (sw : γ → γ)
    (hdet : ∀ E : List (List γ), rowsLen E.length E →
      R.rel (det E) (detO ops E))
    (hsw : ∀ x : γ, R.rel (sw x) (ops.swap x))
    (m : List (List γ)) (hsq : rowsLen m.length m)
    (i j : Nat) (hi : i < m.length) (hj : j < m.length)
    (hij : i ≠ j) :
    R.rel (ground.getAt ops.unit
        (ground.getAt [] (matMulO ops (adjO det sw m) m) i) j)
      ops.unit := by
  have hpos : 0 < m.length := Nat.lt_of_le_of_lt (Nat.zero_le i) hi
  have hTl : (transposeO ops m).length = m.length :=
    length_transposeO ops m hsq hpos
  have hTr : rowsLen m.length (transposeO ops m) :=
    rowsLen_transposeO ops m
  have hTsq : rowsLen (transposeO ops m).length
      (transposeO ops m) := by
    rw [hTl]
    exact hTr
  have hiT : i < (transposeO ops m).length := by
    rw [hTl]
    exact hi
  have hjT : j < (transposeO ops m).length := by
    rw [hTl]
    exact hj
  refine L.ovTrans (adjO_colFold L det sw hdet hsw m hsq i j hi hj) ?_
  exact cofVecO_off L (transposeO ops m) j i hjT hiT
    (fun h => hij h.symm)
    (rowsLen_getAt (transposeO ops m) j hTsq hjT)

/-- The polynomial carrier's laws bundle at the balance-pair
entries, the tower's one lift at the entry bundle's own. -/
theorem polyLaws : DLaws poly.Poly poly.polyOps poly.polyRead.rel :=
  polyLawsO (R := ground.bpairRead) bpairLaws

/-- A signed monomial against the swapped one flips its side. -/
private theorem smono_flip (s : Bool) (n : Nat) :
    poly.oneValue (poly.mul (poly.smono s n) (poly.neg poly.one))
      (poly.smono (!s) n) := by
  refine poly.oneValue_trans (poly.mul_comm _ _) ?_
  refine poly.oneValue_trans (poly.neg_prod_left poly.one _) ?_
  refine poly.oneValue_trans
    (poly.swapMap_oneValue (poly.one_mul (poly.smono s n))) ?_
  cases s with
  | false =>
    show poly.oneValue (poly.neg (poly.mono n)) (poly.smono true n)
    rw [poly.neg_mono n]
    exact poly.oneValue_refl _
  | true =>
    show poly.oneValue (poly.neg (poly.smono true n))
      (poly.smono false n)
    rw [← poly.neg_mono n, poly.neg_neg]
    exact poly.oneValue_refl _

/-- One family member against the pair: the degree raised at the
kept side beside the flipped side's own copy. -/
private theorem smono_tpair (s : Bool) (n g : Nat) :
    poly.oneValue (poly.mul (poly.smono s n) (poly.tpair g))
      (poly.add (poly.smono s (n + g)) (poly.smono (!s) n)) :=
  poly.oneValue_trans
    (poly.mul_sum (poly.smono s n) (poly.mono g) (poly.neg poly.one))
    (poly.add_congr (poly.smono_mul_mono s n g) (smono_flip s n))

/-- The subset expansion at a distinct index list: the pair product
expands over the occupancy families, one signed monomial per family
at the complement-guarded degree fold — `thm:assembly`'s subset
fold at the member product's factors (`cor:weyldim`). -/
theorem tpairFold_subsets {α : Type} [DecidableEq α]
    (g : α → Nat) : ∀ (l : List α),
    (∀ j, ground.countOf j l ≤ 1) →
    poly.oneValue
      (ground.famFold poly.mul poly.one
        (fun j => poly.tpair (g j)) l)
      (ground.famFold poly.add []
        (fun S => poly.smono (places.sideOf S)
          (ground.famFold Nat.add 0
            (fun j => if 0 < ground.countOf j S then 0 else g j)
            l))
        (ground.sublistsOf l))
  | [], _ => by
    show poly.oneValue poly.one (poly.add poly.one [])
    rw [poly.add_nil]
    exact poly.oneValue_refl _
  | a :: l, hd => by
    have hdl : ∀ j, ground.countOf j l ≤ 1 := fun j =>
      Nat.le_trans (ground.countOf_cons_le j a l) (hd j)
    have hal : ground.countOf a l = 0 := by
      have h1 := hd a
      rw [ground.countOf_head] at h1
      exact Nat.eq_zero_of_le_zero (Nat.le_of_succ_le_succ h1)
    have hpt1 : ∀ S, 0 < ground.countOf S (ground.sublistsOf l) →
        poly.smono (places.sideOf S)
          (ground.famFold Nat.add 0
            (fun j => if 0 < ground.countOf j S then 0 else g j)
            (a :: l))
        = poly.smono (places.sideOf S)
            (ground.famFold Nat.add 0
              (fun j => if 0 < ground.countOf j S then 0 else g j) l
              + g a) := by
      intro S hS
      have haS : ground.countOf a S = 0 := by
        cases hc : ground.countOf a S with
        | zero => rfl
        | succ m =>
          have hmem := ground.sublists_entries l S hS a
            (by rw [hc]; exact Nat.succ_pos m)
          rw [hal] at hmem
          exact absurd hmem (Nat.lt_irrefl 0)
      refine congrArg (poly.smono (places.sideOf S)) ?_
      show (if 0 < ground.countOf a S then 0 else g a)
          + ground.famFold Nat.add 0
              (fun j => if 0 < ground.countOf j S then 0 else g j) l
        = ground.famFold Nat.add 0
            (fun j => if 0 < ground.countOf j S then 0 else g j) l
          + g a
      rw [haS, if_neg (Nat.lt_irrefl 0), Nat.add_comm]
    have hpt2 : ∀ S, 0 < ground.countOf S (ground.sublistsOf l) →
        poly.smono (places.sideOf (a :: S))
          (ground.famFold Nat.add 0
            (fun j => if 0 < ground.countOf j (a :: S) then 0 else g j)
            (a :: l))
        = poly.smono (!(places.sideOf S))
            (ground.famFold Nat.add 0
              (fun j => if 0 < ground.countOf j S then 0 else g j) l) := by
      intro S _
      show poly.smono (!(places.sideOf S))
        ((if 0 < ground.countOf a (a :: S) then 0 else g a)
          + ground.famFold Nat.add 0
              (fun j => if 0 < ground.countOf j (a :: S) then 0 else g j)
              l)
        = poly.smono (!(places.sideOf S))
            (ground.famFold Nat.add 0
              (fun j => if 0 < ground.countOf j S then 0 else g j) l)
      refine congrArg (poly.smono (!(places.sideOf S))) ?_
      rw [if_pos (show 0 < ground.countOf a (a :: S) from by
          rw [ground.countOf_head]; exact Nat.succ_pos _),
        Nat.zero_add]
      refine ground.famFold_congr_members Nat.add 0 _ _ l
        (fun j hj => ?_)
      have hja : ¬ j = a := fun he => by
        rw [he, hal] at hj
        exact absurd hj (Nat.lt_irrefl 0)
      have hcnt : ground.countOf j (a :: S) = ground.countOf j S := by
        rw [ground.countOf_cons, if_neg hja, Nat.zero_add]
      rw [hcnt]
    -- the left product joined to the tail's expansion
    refine poly.oneValue_trans
      (poly.mul_congr (poly.tpair (g a))
        (tpairFold_subsets g l hdl)) ?_
    refine poly.oneValue_trans (poly.mul_comm _ _) ?_
    refine poly.oneValue_trans
      (poly.mul_famFold
        (fun S => poly.smono (places.sideOf S)
          (ground.famFold Nat.add 0
            (fun j => if 0 < ground.countOf j S then 0 else g j) l))
        (ground.sublistsOf l) (poly.tpair (g a))) ?_
    refine poly.oneValue_trans
      (poly.foldP_congr_members _ _ (ground.sublistsOf l) (fun S _ =>
        smono_tpair (places.sideOf S)
          (ground.famFold Nat.add 0
            (fun j => if 0 < ground.countOf j S then 0 else g j) l)
          (g a))) ?_
    refine poly.oneValue_trans (poly.foldP_add _ _ (ground.sublistsOf l)) ?_
    refine poly.oneValue_symm ?_
    refine poly.oneValue_trans
      (poly.foldP_append _ (ground.sublistsOf l)
        ((ground.sublistsOf l).map (fun S => a :: S))) ?_
    rw [ground.famFold_map poly.add []
        (fun S => poly.smono (places.sideOf S)
          (ground.famFold Nat.add 0
            (fun j => if 0 < ground.countOf j S then 0 else g j)
            (a :: l)))
        (fun S => a :: S) (ground.sublistsOf l),
      ground.famFold_congr_members poly.add []
        (fun S => poly.smono (places.sideOf S)
          (ground.famFold Nat.add 0
            (fun j => if 0 < ground.countOf j S then 0 else g j)
            (a :: l)))
        (fun S => poly.smono (places.sideOf S)
          (ground.famFold Nat.add 0
            (fun j => if 0 < ground.countOf j S then 0 else g j) l
            + g a))
        (ground.sublistsOf l) hpt1,
      ground.famFold_congr_members poly.add []
        (fun S => poly.smono (places.sideOf (a :: S))
          (ground.famFold Nat.add 0
            (fun j => if 0 < ground.countOf j (a :: S) then 0 else g j)
            (a :: l)))
        (fun S => poly.smono (!(places.sideOf S))
          (ground.famFold Nat.add 0
            (fun j => if 0 < ground.countOf j S then 0 else g j) l))
        (ground.sublistsOf l) hpt2]
    exact poly.oneValue_refl _

/-- The order-two exchange, the pivot step's row exchange as
certificate data (`def:elim`). -/
def exch2 : Mat :=
  [[BPair.unit, ⟨2, 1⟩], [⟨2, 1⟩, BPair.unit]]

/-- The exchange's adjugate, the witness at the determinant's
lower side. -/
def exch2w : Mat :=
  [[BPair.unit, ⟨1, 2⟩], [⟨1, 2⟩, BPair.unit]]

/-! `def:elim`'s evaluation sentence: the minor is a formula in the
displayed operations and the evaluation reads sums to sums and
products to products, so a polynomial minor's evaluation is the
evaluated entries' own minor, and the shift matrix's evaluation is
the evaluated coefficients' own shift matrix, the rows read at
`poly.pevalB`. -/

/-- The Horner read at the balance-pair entries is the bundle's
own evaluation. -/
private theorem eval_evalLO : ∀ (f : poly.Poly) (r : BPair),
    poly.eval f r = evalLO bpairOps f r
  | [], _ => rfl
  | c :: f, r => congrArg (fun x => c + r * x) (eval_evalLO f r)

/-- The polynomial minor's evaluation reads the evaluated entries'
own minor. -/
theorem eval_minorP (M : List (List poly.Poly)) (r : BPair)
    (hsq : rowsLen M.length M) :
    (poly.eval (minorO poly.polyOps poly.pnorm id M) r).oneValue
      (minor (M.map (fun row => poly.pevalB row r))) := by
  show (poly.eval (minorO poly.polyOps poly.pnorm id M) r).oneValue
    (minor (M.map (fun row => row.map (fun f => poly.eval f r))))
  have h1 : poly.oneValue (minorO poly.polyOps poly.pnorm id M)
      (detO poly.polyOps M) :=
    minorO_detO (R := poly.polyRead)
      (polyLawsO (R := ground.bpairRead) bpairLaws)
      poly.pnorm id
      (fun x => poly.pnorm_oneValue x)
      (fun x => lovRefl (R := ground.bpairRead) bpairCore x)
      M hsq
  have h2 : (poly.eval (minorO poly.polyOps poly.pnorm id M) r).oneValue
      (poly.eval (detO poly.polyOps M) r) := poly.eval_congr h1 r
  have h3 : (evalLO bpairOps (detO (poly.polyO bpairOps) M) r).oneValue
      (detO bpairOps (evalMatLO bpairOps M r)) :=
    evalDetLO (R := ground.bpairRead) bpairLaws M r
  have hmap : M.map (fun row => row.map (fun f => poly.eval f r))
      = evalMatLO bpairOps M r :=
    ground.map_congr_all _ _
      (fun row => ground.map_congr_all _ _
        (fun f => eval_evalLO f r) row) M
  have h4 : rowsLen (evalMatLO bpairOps M r).length
      (evalMatLO bpairOps M r) := by
    rw [← hmap, ground.length_map]
    exact rowsLen_mapRowsO (fun f => poly.eval f r) M M.length hsq
  rw [hmap]
  refine BPair.oneValue_trans h2 (BPair.oneValue_trans ?_
    (BPair.oneValue_symm (minor_detL _ h4)))
  rw [eval_evalLO (detO poly.polyOps M) r]
  exact h3

/-- The Horner read at polynomial coefficients collects to the
monomial fold, the coefficient against the outer point's power. -/
private theorem evalLO_foldP : ∀ (P : poly.PPoly) (q : poly.Poly),
    poly.oneValue (evalLO poly.polyOps P q)
      (ground.famFold poly.add []
        (fun k => poly.mul (ground.getAt [] P k) (poly.powOf q k))
        (List.range P.length))
  | [], _ => trivial
  | C :: P, q => by
    rw [show (C :: P).length = P.length + 1 from rfl,
      ground.famFold_range_cons poly.add ([] : poly.Poly)
        (fun k => poly.mul (ground.getAt [] (C :: P) k)
          (poly.powOf q k)) P.length]
    show poly.oneValue
      (poly.add C (poly.mul q (evalLO poly.polyOps P q)))
      (poly.add (poly.mul C (poly.powOf q 0))
        (ground.famFold poly.add []
          (fun j => poly.mul (ground.getAt [] P j)
            (poly.powOf q (j + 1)))
          (List.range P.length)))
    refine poly.add_congr
      (poly.oneValue_symm (poly.oneValue_trans
        (poly.mul_comm C poly.one) (poly.one_mul C))) ?_
    refine poly.oneValue_trans
      (poly.mul_congr q (evalLO_foldP P q)) ?_
    refine poly.oneValue_trans (poly.mul_comm q _) ?_
    refine poly.oneValue_trans
      (poly.mul_famFold _ (List.range P.length) q) ?_
    refine ground.famFold_congr_members_ov poly.oneValue poly.add []
      poly.oneValue_refl (fun h1 h2 => poly.add_congr h1 h2) _ _
      (List.range P.length) (fun j _ => ?_)
    exact poly.oneValue_trans
      (poly.mul_assoc (ground.getAt [] P j) (poly.powOf q j) q)
      (poly.mul_congr (ground.getAt [] P j)
        (poly.mul_comm (poly.powOf q j) q))

/-- The outer evaluation at the unit clearing is the Horner read,
the two collections meeting at the monomial fold. -/
private theorem pevalCOne_evalLO (P : poly.PPoly) (q : poly.Poly) :
    poly.oneValue (poly.pevalC P q ground.Pos.one 1)
      (evalLO poly.polyOps P q) :=
  poly.oneValue_trans (poly.pevalC_fold P q 1)
    (poly.oneValue_symm (evalLO_foldP P q))

/-- The iterated carrier's minor at the outer point: the symbol's
minor evaluated at a stated outer point at the unit clearing is
the evaluated entries' own minor, every square list. -/
theorem evalC_minorPP (M : List (List poly.PPoly)) (q : poly.Poly)
    (hsq : rowsLen M.length M) :
    poly.oneValue
      (poly.pevalC (minorO (poly.polyO poly.polyOps) poly.pnormP id M)
        q ground.Pos.one 1)
      (minorO poly.polyOps poly.pnorm id
        (M.map (fun row => row.map
          (fun P => poly.pevalC P q ground.Pos.one 1)))) := by
  have h1 : poly.ppOneValue
      (minorO (poly.polyO poly.polyOps) poly.pnormP id M)
      (detO (poly.polyO poly.polyOps) M) :=
    minorO_detO (R := poly.listRead poly.polyOps poly.polyRead)
      (polyLawsO (R := poly.polyRead)
        (polyLawsO (R := ground.bpairRead) bpairLaws))
      poly.pnormP id
      (fun x => poly.pnormP_ppOneValue x)
      (fun x => lovRefl (R := poly.polyRead)
        (polyLawsO (R := ground.bpairRead) bpairLaws).toDCore x)
      M hsq
  have h2 : poly.oneValue
      (evalLO poly.polyOps
        (minorO (poly.polyO poly.polyOps) poly.pnormP id M) q)
      (evalLO poly.polyOps (detO (poly.polyO poly.polyOps) M) q) :=
    evalCongrO (polyLawsO (R := ground.bpairRead) bpairLaws) h1 q
  have h3 : poly.oneValue
      (evalLO poly.polyOps (detO (poly.polyO poly.polyOps) M) q)
      (detO poly.polyOps (evalMatLO poly.polyOps M q)) :=
    evalDetLO (R := poly.polyRead)
      (polyLawsO (R := ground.bpairRead) bpairLaws) M q
  have hMr : rowsLen M.length (evalMatLO poly.polyOps M q) :=
    rowsLen_mapRowsO _ M M.length hsq
  have hsq' : rowsLen (evalMatLO poly.polyOps M q).length
      (evalMatLO poly.polyOps M q) := by
    rw [evalMatLO_len]
    exact hMr
  have h4 : poly.oneValue
      (detO poly.polyOps (evalMatLO poly.polyOps M q))
      (minorO poly.polyOps poly.pnorm id
        (evalMatLO poly.polyOps M q)) :=
    poly.oneValue_symm
      (minorO_detO (R := poly.polyRead)
        (polyLawsO (R := ground.bpairRead) bpairLaws)
        poly.pnorm id
        (fun x => poly.pnorm_oneValue x)
        (fun x => lovRefl (R := ground.bpairRead) bpairCore x)
        _ hsq')
  have h5 : poly.oneValue
      (minorO poly.polyOps poly.pnorm id
        (evalMatLO poly.polyOps M q))
      (minorO poly.polyOps poly.pnorm id
        (M.map (fun row => row.map
          (fun P => poly.pevalC P q ground.Pos.one 1)))) := by
    refine minorP_congr _ _ M.length (evalMatLO_len _ _ _)
      (ground.length_map _ M) hMr
      (rowsLen_mapRowsO _ M M.length hsq)
      (fun a ha b hb => ?_)
    have hlen : (ground.getAt [] M a).length = M.length :=
      rowsLen_getAt M a hsq ha
    have hb' : b < (ground.getAt [] M a).length := by
      rw [hlen]
      exact hb
    have e1 : ground.getAt []
        (ground.getAt [] (evalMatLO poly.polyOps M q) a) b
        = evalLO poly.polyOps
          (ground.getAt [] (ground.getAt [] M a) b) q := by
      show ground.getAt [] (ground.getAt [] (M.map (fun row =>
          row.map (fun p => evalLO poly.polyOps p q))) a) b = _
      rw [ground.getAt_map ([] : List poly.PPoly)
          ([] : List poly.Poly) _ M a ha,
        ground.getAt_map ([] : poly.PPoly) ([] : poly.Poly) _
          (ground.getAt [] M a) b hb']
    have e2 : ground.getAt []
        (ground.getAt [] (M.map (fun row => row.map
          (fun P => poly.pevalC P q ground.Pos.one 1))) a) b
        = poly.pevalC
          (ground.getAt [] (ground.getAt [] M a) b) q
          ground.Pos.one 1 := by
      rw [ground.getAt_map ([] : List poly.PPoly)
          ([] : List poly.Poly) _ M a ha,
        ground.getAt_map ([] : poly.PPoly) ([] : poly.Poly) _
          (ground.getAt [] M a) b hb']
    rw [e1, e2]
    exact poly.oneValue_symm (pevalCOne_evalLO _ q)
  exact poly.oneValue_trans (pevalCOne_evalLO _ q)
    (poly.oneValue_trans h2 (poly.oneValue_trans h3
      (poly.oneValue_trans h4 h5)))

/-- The shift matrix's evaluation: the rows' evaluated
coefficients are the evaluated polynomials' own shift rows. -/
theorem shiftMatO_eval (p q : List poly.Poly) (r : BPair) :
    (shiftMatO poly.polyOps p q).map (fun row => poly.pevalB row r)
      = shiftMat (poly.pevalB p r) (poly.pevalB q r) := by
  show (shiftMatO poly.polyOps p q).map
        (fun row => row.map (fun f => poly.eval f r))
      = shiftMat (p.map (fun f => poly.eval f r))
        (q.map (fun f => poly.eval f r))
  have hrow : ∀ (w a : Nat) (g : List poly.Poly),
      (shiftRowO poly.polyOps w a g).map (fun f => poly.eval f r)
        = shiftRowO bpairOps w a (g.map (fun f => poly.eval f r)) := by
    intro w a g
    show ((List.replicate a ([] : poly.Poly) ++ g
        ++ List.replicate (w - a - g.length) ([] : poly.Poly))).map
        (fun f => poly.eval f r)
      = List.replicate a BPair.unit ++ g.map (fun f => poly.eval f r)
        ++ List.replicate
          (w - a - (g.map (fun f => poly.eval f r)).length) BPair.unit
    rw [ground.map_append, ground.map_append,
      ground.map_replicate, ground.map_replicate,
      ground.length_map (fun f => poly.eval f r) g]
    rfl
  have hR : shiftMat (p.map (fun f => poly.eval f r))
        (q.map (fun f => poly.eval f r))
      = (List.range (p.length - 1)).map
          (fun a => shiftRowO bpairOps (p.length - 1 + (q.length - 1)) a
            (q.map (fun f => poly.eval f r)))
        ++ (List.range (q.length - 1)).map
          (fun b => shiftRowO bpairOps (p.length - 1 + (q.length - 1)) b
            (p.map (fun f => poly.eval f r))) := by
    show ((List.range ((p.map (fun f => poly.eval f r)).length - 1)).map
        (fun a => shiftRowO bpairOps
          ((p.map (fun f => poly.eval f r)).length - 1
            + ((q.map (fun f => poly.eval f r)).length - 1)) a
          (q.map (fun f => poly.eval f r)))
      ++ (List.range ((q.map (fun f => poly.eval f r)).length - 1)).map
        (fun b => shiftRowO bpairOps
          ((p.map (fun f => poly.eval f r)).length - 1
            + ((q.map (fun f => poly.eval f r)).length - 1)) b
          (p.map (fun f => poly.eval f r)))) = _
    rw [ground.length_map (fun f => poly.eval f r) p,
      ground.length_map (fun f => poly.eval f r) q]
  rw [hR]
  show ((List.range (p.length - 1)).map
        (fun a => shiftRowO poly.polyOps
          (p.length - 1 + (q.length - 1)) a q)
      ++ (List.range (q.length - 1)).map
        (fun b => shiftRowO poly.polyOps
          (p.length - 1 + (q.length - 1)) b p)).map
      (fun row => row.map (fun f => poly.eval f r)) = _
  rw [ground.map_append, ground.map_map, ground.map_map,
    ground.map_congr_all
      (fun a => (shiftRowO poly.polyOps
          (p.length - 1 + (q.length - 1)) a q).map
        (fun f => poly.eval f r))
      (fun a => shiftRowO bpairOps (p.length - 1 + (q.length - 1)) a
        (q.map (fun f => poly.eval f r)))
      (fun a => hrow (p.length - 1 + (q.length - 1)) a q)
      (List.range (p.length - 1)),
    ground.map_congr_all
      (fun b => (shiftRowO poly.polyOps
          (p.length - 1 + (q.length - 1)) b p).map
        (fun f => poly.eval f r))
      (fun b => shiftRowO bpairOps (p.length - 1 + (q.length - 1)) b
        (p.map (fun f => poly.eval f r)))
      (fun b => hrow (p.length - 1 + (q.length - 1)) b p)
      (List.range (q.length - 1))]

/-! `def:elim`'s Bézout solve: the shift matrix's first-column
adjugate row read as a polynomial identity `A p + B q = Res(p, q)`.
The coefficient at a monomial key is the first column's cofactor
family folded against that key's column — the transpose's own row
against the leading cofactor vector — the determinant at the
leading key and the sum's unit at every further one. -/

/-- The shifted coefficient at a monomial key: the polynomial's own
coefficient at the key's gap above the offset, the sum's unit below
the offset. -/
private def shiftCoef (f : poly.Poly) (j b : Nat) : BPair :=
  if b ≤ j then ground.getAt BPair.unit f (j - b) else BPair.unit

private theorem shiftCoef_head (f : poly.Poly) (j : Nat) :
    shiftCoef f j 0 = ground.getAt BPair.unit f j := by
  show (if 0 ≤ j then ground.getAt BPair.unit f (j - 0) else BPair.unit)
    = ground.getAt BPair.unit f j
  rw [if_pos (Nat.zero_le j)]
  rfl

private theorem shiftCoef_zero (f : poly.Poly) (b : Nat) :
    shiftCoef f 0 (b + 1) = BPair.unit :=
  if_neg (Nat.not_succ_le_zero b)

private theorem shiftCoef_succ (f : poly.Poly) (j b : Nat) :
    shiftCoef f (j + 1) (b + 1) = shiftCoef f j b := by
  show (if b + 1 ≤ j + 1 then
      ground.getAt BPair.unit f (j + 1 - (b + 1)) else BPair.unit)
    = if b ≤ j then ground.getAt BPair.unit f (j - b) else BPair.unit
  rw [Nat.succ_sub_succ j b]
  by_cases h : b ≤ j
  · rw [if_pos h, if_pos (Nat.succ_le_succ h)]
  · rw [if_neg h, if_neg (fun hc => h (Nat.le_of_succ_le_succ hc))]

/-- The shift row's key read: the polynomial's own coefficient at
the gap above the offset, the sum's unit below it. -/
private theorem getAt_shiftRow (w a : Nat) (f : poly.Poly) (j : Nat) :
    ground.getAt BPair.unit (shiftRowO bpairOps w a f) j
      = shiftCoef f j a := by
  show ground.getAt BPair.unit
      (List.replicate a BPair.unit ++ f
        ++ List.replicate (w - a - f.length) BPair.unit) j = _
  rw [ground.append_assoc,
    ground.getAt_replicate_append BPair.unit a
      (f ++ List.replicate (w - a - f.length) BPair.unit) j,
    ground.getAt_append_replicate BPair.unit (w - a - f.length) f (j - a)]
  rfl

/-- The shift row's width at a fitting offset. -/
private theorem length_shiftRow {γ : Type} (ops : DOps γ) (w a : Nat)
    (f : List γ) (h : a + f.length ≤ w) :
    (shiftRowO ops w a f).length = w := by
  show (List.replicate a ops.unit ++ f
      ++ List.replicate (w - a - f.length) ops.unit).length = w
  rw [ground.length_append, ground.length_append,
    ground.length_replicate, ground.length_replicate,
    ground.subSub w a f.length]
  exact ground.natAddSubCancel h

/-- The shift row fits its width: an offset below the further
polynomial's degree leaves room for the whole polynomial. -/
private theorem shiftFit (i n m : Nat) (h : i < m) :
    i + n ≤ m + (n - 1) := by
  refine Nat.le_trans (Nat.add_le_add_left (ground.lePredSucc n) i) ?_
  rw [show i + (n - 1 + 1) = i + 1 + (n - 1) from
    (Nat.succ_add i (n - 1)).symm]
  exact Nat.add_le_add_right h (n - 1)

/-- The shift matrix's row count at any entry carrier: the two
degrees' sum. -/
theorem length_shiftMatO {γ : Type} (ops : DOps γ) (p q : List γ) :
    (shiftMatO ops p q).length = p.length - 1 + (q.length - 1) := by
  show (((List.range (p.length - 1)).map
      (fun a => shiftRowO ops (p.length - 1 + (q.length - 1)) a q))
    ++ ((List.range (q.length - 1)).map
      (fun b => shiftRowO ops
        (p.length - 1 + (q.length - 1)) b p))).length
    = p.length - 1 + (q.length - 1)
  rw [ground.length_append, ground.length_map, ground.length_map,
    ground.length_range, ground.length_range]

/-- The shift matrix is square at any entry carrier: every row
reads the monomial keys below the degrees' sum. -/
theorem rowsLen_shiftMatO {γ : Type} (ops : DOps γ) (p q : List γ) :
    rowsLen (p.length - 1 + (q.length - 1)) (shiftMatO ops p q) := by
  show rowsLen (p.length - 1 + (q.length - 1))
    (((List.range (p.length - 1)).map
      (fun a => shiftRowO ops (p.length - 1 + (q.length - 1)) a q))
    ++ ((List.range (q.length - 1)).map
      (fun b => shiftRowO ops (p.length - 1 + (q.length - 1)) b p)))
  refine rowsLen_appendO _
    (rowsLen_map _ _ (List.range (p.length - 1)) (fun a ha => ?_))
    (rowsLen_map _ _ (List.range (q.length - 1)) (fun b hb => ?_))
  · exact length_shiftRow ops _ a q
      (shiftFit a q.length (p.length - 1)
        (ground.ltOfMemRange ha))
  · refine length_shiftRow ops _ b p ?_
    rw [Nat.add_comm (p.length - 1) (q.length - 1)]
    exact shiftFit b p.length (q.length - 1)
      (ground.ltOfMemRange hb)

/-- The shift matrix's row count: the two degrees' sum. -/
theorem length_shiftMat (p q : poly.Poly) :
    (shiftMat p q).length = p.length - 1 + (q.length - 1) :=
  length_shiftMatO bpairOps p q

/-- The shift matrix is square: every row reads the monomial keys
below the degrees' sum. -/
theorem rowsLen_shiftMat (p q : poly.Poly) :
    rowsLen (p.length - 1 + (q.length - 1)) (shiftMat p q) :=
  rowsLen_shiftMatO bpairOps p q

/-- The resultant, the shift matrix's determinant at the pivot
descent. -/
def resultant (p q : poly.Poly) : BPair := detD (shiftMat p q)

/-- The descent's resultant reads the shift matrix's first-row fold
at the square frame. -/
theorem resultant_read (p q : poly.Poly) :
    (resultant p q).oneValue (minor (shiftMat p q)) :=
  have hsq : rowsLen (shiftMat p q).length (shiftMat p q) :=
    rowsLen_cast (length_shiftMat p q).symm (rowsLen_shiftMat p q)
  BPair.oneValue_trans (detD_eq _ hsq) (BPair.oneValue_symm (minor_detL _ hsq))

/-- The shift matrix's leading rows: the further polynomial at the
row's own offset. -/
private theorem getAt_shiftMat_lo (p q : poly.Poly) (a : Nat)
    (ha : a < p.length - 1) :
    ground.getAt ([] : poly.Poly) (shiftMat p q) a
      = shiftRowO bpairOps (p.length - 1 + (q.length - 1)) a q := by
  show ground.getAt ([] : poly.Poly)
      (((List.range (p.length - 1)).map
        (fun a => shiftRowO bpairOps (p.length - 1 + (q.length - 1)) a q))
      ++ ((List.range (q.length - 1)).map
        (fun b => shiftRowO bpairOps
          (p.length - 1 + (q.length - 1)) b p))) a = _
  rw [ground.getAt_append ([] : poly.Poly) _ _ a,
    ground.length_mapRange, if_pos ha,
    ground.getAt_map 0 ([] : poly.Poly) _ (List.range (p.length - 1)) a
      (by rw [ground.length_range]; exact ha),
    ground.getAt_range (p.length - 1) a ha]

/-- The shift matrix's further rows: the first polynomial at the
row's own offset above the leading block. -/
private theorem getAt_shiftMat_hi (p q : poly.Poly) (b : Nat)
    (hb : b < q.length - 1) :
    ground.getAt ([] : poly.Poly) (shiftMat p q) (p.length - 1 + b)
      = shiftRowO bpairOps (p.length - 1 + (q.length - 1)) b p := by
  have hlen : ((List.range (p.length - 1)).map
      (fun a => shiftRowO bpairOps
        (p.length - 1 + (q.length - 1)) a q)).length = p.length - 1 :=
    ground.length_mapRange _ (p.length - 1)
  have hsplit := ground.getAt_append_add ([] : poly.Poly)
    ((List.range (p.length - 1)).map
      (fun a => shiftRowO bpairOps (p.length - 1 + (q.length - 1)) a q))
    ((List.range (q.length - 1)).map
      (fun b => shiftRowO bpairOps (p.length - 1 + (q.length - 1)) b p)) b
  rw [hlen] at hsplit
  show ground.getAt ([] : poly.Poly)
      (((List.range (p.length - 1)).map
        (fun a => shiftRowO bpairOps (p.length - 1 + (q.length - 1)) a q))
      ++ ((List.range (q.length - 1)).map
        (fun b => shiftRowO bpairOps
          (p.length - 1 + (q.length - 1)) b p))) (p.length - 1 + b) = _
  rw [hsplit,
    ground.getAt_map 0 ([] : poly.Poly) _ (List.range (q.length - 1)) b
      (by rw [ground.length_range]; exact hb),
    ground.getAt_range (q.length - 1) b hb]

/-- The first column's cofactor is the transpose's leading
cofactor vector at the row's own key: the struck squares exchange
across the transpose under the shared grading. -/
private theorem cofacCol0_cofVec (M : Mat) {w : Nat}
    (hsq : sqAt M (w + 1)) (r : Nat) (hr : r < w + 1) :
    (cofacCol0 M r).oneValue
      (ground.getAt BPair.unit (cofVec (transposeM M) 0) r) := by
  have hMl : M.length = w + 1 := sqAt_len hsq
  have hMr : rowsLen (w + 1) M := rowsLen_of_sqAt hsq
  have hrM : r < M.length := by rw [hMl]; exact hr
  have h0M : 0 < M.length := by rw [hMl]; exact Nat.succ_pos w
  have hEl : (M.eraseIdx r).length = w :=
    Nat.succ.inj ((ground.length_eraseIdx M r hrM).trans hMl)
  have hentry : ground.getAt BPair.unit (cofVec M r) 0
      = sgnP (r + 0) (cof0 (M.eraseIdx r) 0) := by
    show ground.getAt BPair.unit
        ((List.range M.length).map (fun t =>
          sgnPO bpairOps (r + t) (cof0O bpairOps (M.eraseIdx r) t))) 0 = _
    rw [ground.getAt_map 0 BPair.unit _ (List.range M.length) 0
        (by rw [ground.length_range]; exact h0M),
      ground.getAt_range M.length 0 h0M]
    rfl
  have hstrike : (cof0 (M.eraseIdx r) 0).oneValue
      (detL ((M.eraseIdx r).map (fun s => s.eraseIdx 0))) :=
    cof0O_strike (R := ground.bpairRead) bpairLaws.toDCore
      (M.eraseIdx r) 0 (Nat.zero_le _)
  have hdrop : rowsLen (dropCol (M.eraseIdx r)).length
      (dropCol (M.eraseIdx r)) := by
    rw [length_dropCol, hEl]
    exact rowsLen_dropCol w (M.eraseIdx r)
      (rowsLen_eraseIdx (w + 1) M r hMr)
  rw [dropCol_eraseIdx] at hdrop
  show (sgnP (r + 0) (minor ((M.eraseIdx r).map
    (fun s => s.eraseIdx 0)))).oneValue _
  refine BPair.oneValue_trans
    (sgnP_congr (r + 0) (minor_detL _ hdrop)) ?_
  refine BPair.oneValue_trans
    (sgnP_congr (r + 0) (BPair.oneValue_symm hstrike)) ?_
  refine BPair.oneValue_trans
    (BPair.oneValue_of_eq (show sgnP r (cof0 (M.eraseIdx r) 0)
      = ground.getAt BPair.unit (cofVec M r) 0 from hentry.symm)) ?_
  exact BPair.oneValue_symm
    (cofVec_transpose M hsq 0 r (Nat.succ_pos w) hr)

/-- The product's key read: one fold over the key pairs at the
monomial, the first factor's coefficient against the second's at
the key's gap. -/
private theorem getAt_mulFold : ∀ (A f : poly.Poly) (n j : Nat),
    A.length ≤ n →
    (ground.getAt BPair.unit (poly.mul A f) j).oneValue
      (ground.famFold BPair.add BPair.unit
        (fun b => ground.getAt BPair.unit A b * shiftCoef f j b)
        (List.range n))
  | [], _, n, _, _ =>
    BPair.oneValue_symm
      (ground.foldB_nullRange _ n (fun _ _ =>
        oneValue_unit_mul (BPair.oneValue_refl BPair.unit)))
  | _ :: _, _, 0, _, h => absurd h (Nat.not_succ_le_zero _)
  | c :: A', f, n + 1, j, h => by
    have hA : A'.length ≤ n := Nat.le_of_succ_le_succ h
    have hR : ground.famFold BPair.add BPair.unit
        (fun b => ground.getAt BPair.unit (c :: A') b * shiftCoef f j b)
        (List.range (n + 1))
      = c * shiftCoef f j 0 + ground.famFold BPair.add BPair.unit
          (fun b => ground.getAt BPair.unit A' b * shiftCoef f j (b + 1))
          (List.range n) := by
      rw [ground.range_cons n]
      show BPair.add (c * shiftCoef f j 0)
          (ground.famFold BPair.add BPair.unit
            (fun b => ground.getAt BPair.unit (c :: A') b * shiftCoef f j b)
            ((List.range n).map (fun t => t + 1))) = _
      rw [ground.famFold_map BPair.add BPair.unit _ (fun t => t + 1)
        (List.range n)]
      rfl
    show (ground.getAt BPair.unit
        (poly.add (f.map (fun d => c * d))
          (BPair.unit :: poly.mul A' f)) j).oneValue _
    rw [hR, shiftCoef_head f j]
    refine BPair.oneValue_trans (poly.getAt_add _ _ j)
      (BPair.add_congr (poly.getAt_scale c f j) ?_)
    match j with
    | 0 =>
      refine BPair.oneValue_symm
        (ground.foldB_nullRange _ n (fun b _ => ?_))
      rw [shiftCoef_zero f b]
      exact oneValue_mul_unit _ _ (BPair.oneValue_refl BPair.unit)
    | j + 1 =>
      show (ground.getAt BPair.unit (poly.mul A' f) j).oneValue _
      refine BPair.oneValue_trans (getAt_mulFold A' f n j hA) ?_
      rw [ground.famFold_congr_all BPair.add BPair.unit
        (fun b => ground.getAt BPair.unit A' b * shiftCoef f j b)
        (fun b => ground.getAt BPair.unit A' b
          * shiftCoef f (j + 1) (b + 1))
        (fun b => by rw [shiftCoef_succ]) (List.range n)]
      exact BPair.oneValue_refl _

/-- The Bézout sum's key read: the first column's cofactors folded
against the shift matrix's own column at that key. -/
private theorem bezout_coef (p q : poly.Poly) (j : Nat) :
    (ground.getAt BPair.unit
        (poly.add (poly.mul (bezoutA p q) p)
          (poly.mul (bezoutB p q) q)) j).oneValue
      (ground.famFold BPair.add BPair.unit
        (fun r => cofacCol0 (shiftMat p q) r
          * ground.getAt BPair.unit
              (ground.getAt ([] : poly.Poly) (shiftMat p q) r) j)
        (List.range (p.length - 1 + (q.length - 1)))) := by
  have hAlen : (bezoutA p q).length ≤ q.length - 1 := by
    show ((List.range (q.length - 1)).map
      (fun b => cofacCol0 (shiftMat p q) (p.length - 1 + b))).length
      ≤ q.length - 1
    rw [ground.length_mapRange]
    exact Nat.le_refl _
  have hBlen : (bezoutB p q).length ≤ p.length - 1 := by
    show ((List.range (p.length - 1)).map
      (fun a => cofacCol0 (shiftMat p q) a)).length ≤ p.length - 1
    rw [ground.length_mapRange]
    exact Nat.le_refl _
  have hAb : ∀ b, b < q.length - 1 →
      ground.getAt BPair.unit (bezoutA p q) b
        = cofacCol0 (shiftMat p q) (p.length - 1 + b) := by
    intro b hb
    show ground.getAt BPair.unit ((List.range (q.length - 1)).map
      (fun b => cofacCol0 (shiftMat p q) (p.length - 1 + b))) b = _
    rw [ground.getAt_map 0 BPair.unit _ (List.range (q.length - 1)) b
        (by rw [ground.length_range]; exact hb),
      ground.getAt_range (q.length - 1) b hb]
  have hBa : ∀ a, a < p.length - 1 →
      ground.getAt BPair.unit (bezoutB p q) a
        = cofacCol0 (shiftMat p q) a := by
    intro a ha
    show ground.getAt BPair.unit ((List.range (p.length - 1)).map
      (fun a => cofacCol0 (shiftMat p q) a)) a = _
    rw [ground.getAt_map 0 BPair.unit _ (List.range (p.length - 1)) a
        (by rw [ground.length_range]; exact ha),
      ground.getAt_range (p.length - 1) a ha]
  have hsplit := ground.famFold_append_ov ground.bpairFoldLaws
    (fun r => cofacCol0 (shiftMat p q) r
      * ground.getAt BPair.unit
          (ground.getAt ([] : poly.Poly) (shiftMat p q) r) j)
    (List.range (p.length - 1))
    ((List.range (q.length - 1)).map (fun t => p.length - 1 + t))
  rw [← ground.range_split (p.length - 1) (q.length - 1),
    ground.famFold_map BPair.add BPair.unit _
      (fun t => p.length - 1 + t) (List.range (q.length - 1))] at hsplit
  have hA2 : (ground.famFold BPair.add BPair.unit
      (fun b => ground.getAt BPair.unit (bezoutA p q) b * shiftCoef p j b)
      (List.range (q.length - 1))).oneValue
      (ground.famFold BPair.add BPair.unit
        (fun t => cofacCol0 (shiftMat p q) (p.length - 1 + t)
          * ground.getAt BPair.unit
              (ground.getAt ([] : poly.Poly) (shiftMat p q)
                (p.length - 1 + t)) j)
        (List.range (q.length - 1))) :=
    ground.foldB_congr_members _ _ (List.range (q.length - 1))
      (fun b hb => by
        rw [hAb b (ground.ltOfMem hb),
          getAt_shiftMat_hi p q b (ground.ltOfMem hb), getAt_shiftRow]
        exact BPair.oneValue_refl _)
  have hB2 : (ground.famFold BPair.add BPair.unit
      (fun a => ground.getAt BPair.unit (bezoutB p q) a * shiftCoef q j a)
      (List.range (p.length - 1))).oneValue
      (ground.famFold BPair.add BPair.unit
        (fun r => cofacCol0 (shiftMat p q) r
          * ground.getAt BPair.unit
              (ground.getAt ([] : poly.Poly) (shiftMat p q) r) j)
        (List.range (p.length - 1))) :=
    ground.foldB_congr_members _ _ (List.range (p.length - 1))
      (fun a ha => by
        rw [hBa a (ground.ltOfMem ha),
          getAt_shiftMat_lo p q a (ground.ltOfMem ha), getAt_shiftRow]
        exact BPair.oneValue_refl _)
  refine BPair.oneValue_trans (poly.getAt_add _ _ j) ?_
  refine BPair.oneValue_trans (BPair.add_congr
    (BPair.oneValue_trans
      (getAt_mulFold (bezoutA p q) p (q.length - 1) j hAlen) hA2)
    (BPair.oneValue_trans
      (getAt_mulFold (bezoutB p q) q (p.length - 1) j hBlen) hB2)) ?_
  exact BPair.oneValue_trans
    (BPair.oneValue_of_eq (BPair.add_comm _ _))
    (BPair.oneValue_symm hsplit)

/-- The cofactor fold at a monomial key: the resultant at the
leading key and the sum's unit at every further one — the
transpose's row against its leading cofactor vector, the adjugate's
diagonal and off-diagonal reads. -/
private theorem colFold_read (p q : poly.Poly)
    (hW : 0 < p.length - 1 + (q.length - 1)) (j : Nat) :
    (ground.famFold BPair.add BPair.unit
      (fun r => cofacCol0 (shiftMat p q) r
        * ground.getAt BPair.unit
            (ground.getAt ([] : poly.Poly) (shiftMat p q) r) j)
      (List.range (p.length - 1 + (q.length - 1)))).oneValue
      (ground.getAt BPair.unit [minor (shiftMat p q)] j) := by
  have hMl : (shiftMat p q).length = p.length - 1 + (q.length - 1) :=
    length_shiftMat p q
  have hMr : rowsLen (p.length - 1 + (q.length - 1)) (shiftMat p q) :=
    rowsLen_shiftMat p q
  have hMr' : rowsLen (shiftMat p q).length (shiftMat p q) :=
    rowsLen_cast hMl.symm hMr
  match hwit : p.length - 1 + (q.length - 1), hW with
  | 0, hz => exact absurd hz (Nat.lt_irrefl 0)
  | w + 1, _ =>
    have hMl1 : (shiftMat p q).length = w + 1 := hMl.trans hwit
    have hMr1 : rowsLen (w + 1) (shiftMat p q) := rowsLen_cast hwit hMr
    have hsq : sqAt (shiftMat p q) (w + 1) := sqAt_of hMl1 hMr1
    have hNr : rowsLen (w + 1) (transposeM (shiftMat p q)) :=
      rowsLen_cast hMl1 (rowsLen_transposeM (shiftMat p q))
    have hNl : (transposeM (shiftMat p q)).length = w + 1 :=
      transposeLen (shiftMat p q) hMr1 hMl1
    have hcv : cofVec (transposeM (shiftMat p q)) 0
        = (List.range (w + 1)).map (fun t =>
            sgnPO bpairOps (0 + t)
              (cof0O bpairOps
                ((transposeM (shiftMat p q)).eraseIdx 0) t)) := by
      show (List.range (transposeM (shiftMat p q)).length).map _ = _
      rw [hNl]
    have hgt : ∀ t, t < w + 1 →
        ground.getAt BPair.unit (cofVec (transposeM (shiftMat p q)) 0) t
          = sgnPO bpairOps (0 + t)
              (cof0O bpairOps
                ((transposeM (shiftMat p q)).eraseIdx 0) t) := by
      intro t ht
      rw [hcv, ground.getAt_map 0 BPair.unit _ (List.range (w + 1)) t
          (by rw [ground.length_range]; exact ht),
        ground.getAt_range (w + 1) t ht]
    match Nat.lt_or_ge j (w + 1) with
    | .inr hge =>
      have hunit : ∀ r, r < w + 1 →
          (cofacCol0 (shiftMat p q) r
            * ground.getAt BPair.unit
                (ground.getAt ([] : poly.Poly) (shiftMat p q) r) j).oneValue
            BPair.unit := by
        intro r hr
        refine oneValue_mul_unit _ _ (BPair.oneValue_of_eq ?_)
        refine ground.getAt_over BPair.unit _ j ?_
        rw [rowsLen_getAt (shiftMat p q) r hMr1 (by rw [hMl1]; exact hr)]
        exact hge
      refine BPair.oneValue_trans
        (ground.foldB_nullRange _ (w + 1)
          (fun r hr => hunit r hr)) ?_
      match j, hge with
      | 0, hz => exact absurd hz (Nat.not_succ_le_zero w)
      | _ + 1, _ => exact BPair.oneValue_refl _
    | .inl hjlt =>
      have hxl : (ground.getAt ([] : poly.Poly)
          (transposeM (shiftMat p q)) j).length = w + 1 :=
        rowsLen_getAt (transposeM (shiftMat p q)) j hNr
          (by rw [hNl]; exact hjlt)
      have hdot : dotP (ground.getAt ([] : poly.Poly)
            (transposeM (shiftMat p q)) j)
          (cofVec (transposeM (shiftMat p q)) 0)
        = ground.famFold BPair.add BPair.unit
            (fun t => ground.getAt BPair.unit
                (ground.getAt ([] : poly.Poly)
                  (transposeM (shiftMat p q)) j) t
              * sgnPO bpairOps (0 + t)
                  (cof0O bpairOps
                    ((transposeM (shiftMat p q)).eraseIdx 0) t))
            (List.range (w + 1)) := by
        rw [hcv]
        exact dotO_map_range bpairOps _ (w + 1)
          (ground.getAt ([] : poly.Poly) (transposeM (shiftMat p q)) j) hxl
      have hfold : (ground.famFold BPair.add BPair.unit
          (fun r => cofacCol0 (shiftMat p q) r
            * ground.getAt BPair.unit
                (ground.getAt ([] : poly.Poly) (shiftMat p q) r) j)
          (List.range (w + 1))).oneValue
          (dotP (ground.getAt ([] : poly.Poly)
              (transposeM (shiftMat p q)) j)
            (cofVec (transposeM (shiftMat p q)) 0)) := by
        rw [hdot]
        refine ground.foldB_congr_members _ _ (List.range (w + 1))
          (fun r hr => ?_)
        have hrw : r < w + 1 := ground.ltOfMem hr
        have he1 : ground.getAt BPair.unit
            (ground.getAt ([] : poly.Poly)
              (transposeM (shiftMat p q)) j) r
          = ground.getAt BPair.unit
              (ground.getAt ([] : poly.Poly) (shiftMat p q) r) j :=
          getAt_transposeM BPair.unit (shiftMat p q) hMr1 j r hjlt
            (by rw [hMl1]; exact hrw)
        rw [he1, ← hgt r hrw]
        exact BPair.oneValue_trans
          (BPair.mul_congr (cofacCol0_cofVec (shiftMat p q) hsq r hrw)
            (BPair.oneValue_refl _))
          (BPair.oneValue_of_eq (BPair.mul_comm _ _))
      refine BPair.oneValue_trans hfold ?_
      match j with
      | 0 =>
        refine BPair.oneValue_trans
          (cofVec_diag (transposeM (shiftMat p q)) 0
            (by rw [hNl]; exact Nat.succ_pos w)
            (by rw [hxl, hNl])) ?_
        rw [detL_transpose (shiftMat p q) hMr']
        exact BPair.oneValue_symm (minor_detL (shiftMat p q) hMr')
      | j + 1 =>
        refine BPair.oneValue_trans
          (cofVec_off (transposeM (shiftMat p q)) (j + 1) 0
            (by rw [hNl]; exact hjlt)
            (by rw [hNl]; exact Nat.succ_pos w)
            (fun he => Nat.noConfusion he)
            (by rw [hxl, hNl])) ?_
        exact BPair.oneValue_refl _

/-- The adjugate row solves `A p + B q = Res(p, q)`, the solved
witness's whole verification at every monomial key: the first
column's cofactor family against the shift matrix's own columns —
the determinant at the leading key by the adjugate's diagonal read
and the sum's unit at every further key by its off-diagonal read.
The identity's site is the occupied shift matrix: at two
polynomials both of vanishing degree the matrix is vacant, its
determinant the product's one against the solve's own unit. -/
theorem bezout_all (p q : poly.Poly)
    (hW : 0 < p.length - 1 + (q.length - 1)) :
    poly.oneValue
      (poly.add (poly.mul (bezoutA p q) p) (poly.mul (bezoutB p q) q))
      [resultant p q] :=
  poly.oneValue_trans
    (poly.ov_of_getAt (fun j =>
      BPair.oneValue_trans (bezout_coef p q j) (colFold_read p q hW j)))
    ⟨BPair.oneValue_symm (resultant_read p q), trivial⟩


/-! The squares' fold at a joined vector and the count's fold of
squares at a matrix sum (`lem:fourpoint`'s tail): the expansion of a
sum's self-pairing, the weighted polarization beneath it, and the
list sum's own square cap at the count's multiple. -/

/-- A joined vector's self-pairing expands into the two self-pairings
and the two cross pairings. -/
theorem dotN_add_expand (a b : List BPair) (h : a.length = b.length) :
    (dotN (vecAdd a b) (vecAdd a b)).oneValue
      (dotN a a + dotN b b + (dotN a b + dotN b a)) := by
  have hl : (vecAdd a b).length = a.length := length_vecAdd a b a.length rfl h.symm
  refine BPair.oneValue_trans
    (dotN_addRow a b (vecAdd a b) hl.symm (h.symm.trans hl.symm)) ?_
  refine BPair.oneValue_trans
    (BPair.add_congr
      (dotN_addRow_right a a b rfl h.symm)
      (dotN_addRow_right b a b h rfl)) ?_
  rw [BPair.add_comm (dotN b a) (dotN b b),
    BPair.add_add_comm (dotN a a) (dotN a b) (dotN b b) (dotN b a)]
  exact BPair.oneValue_refl _

/-- The matrix list's sum at an order, the vacant list the null matrix. -/
def matSumL (n : Nat) : List Mat → Mat
  | [] => nullMat n n
  | A :: t => matAdd A (matSumL n t)

/-- The list sum keeps the stated order at every term's own. -/
private theorem sqAt_matSumL (n : Nat) : ∀ Ms : List Mat,
    (∀ i, i < Ms.length → sqAt (ground.getAt [] Ms i) n) →
    sqAt (matSumL n Ms) n
  | [], _ => sqAt_of (length_nullMat n n) (rowsLen_nullMat n n)
  | A :: t, h =>
    sqAt_matAdd n A (matSumL n t) (h 0 (Nat.succ_pos t.length))
      (sqAt_matSumL n t (fun i hi => h (i + 1) (Nat.succ_lt_succ hi)))

/-- A unit-tailed vector pairs every vector at the sum's unit. -/
theorem dotN_nullL (S T : List BPair)
    (h : poly.unitTail S) : (dotN S T).oneValue BPair.unit :=
  dotN_congrL S [] T (poly.unitTail_oneValue h trivial)

/-- A pairing against a vector at the sum's unit reads that unit,
the mirror read. -/
theorem dotN_nullR (u v : List BPair) (h : poly.unitTail v) :
    (dotN u v).oneValue BPair.unit :=
  BPair.oneValue_trans (dotN_read u v) (dotP_null_tail_right u v h)


/-- The vector list's sum, the unit family at the vacant list. -/
def vecSumL (n : Nat) : List (List BPair) → List BPair
  | [] => List.replicate n BPair.unit
  | v :: t => vecAdd v (vecSumL n t)

private theorem length_vecSumL (n : Nat) : ∀ vs : List (List BPair),
    (∀ i, i < vs.length → (ground.getAt [] vs i).length = n) →
    (vecSumL n vs).length = n
  | [], _ => ground.length_replicate BPair.unit n
  | v :: t, h =>
    length_vecAdd v (vecSumL n t) n (h 0 (Nat.succ_pos _))
      (length_vecSumL n t (fun i hi => h (i + 1) (Nat.succ_lt_succ hi)))

/-- A member's swap image keeps its self-pairing. -/
theorem dotN_swapPair (S : List BPair) :
    dotN (S.map BPair.swap) (S.map BPair.swap) = dotN S S := by
  rw [dotN_swapLeft, dotN_swap]
  exact rfl

/-- One head's pairwise gaps against a tail: the fold of the gap
self-pairings, the head against each member's balance partner. -/
def gapRow (a : List BPair) : List (List BPair) → BPair
  | [] => BPair.unit
  | u :: t =>
    dotN (vecAdd a (u.map BPair.swap)) (vecAdd a (u.map BPair.swap))
      + gapRow a t

/-- The pairwise gaps' fold over the place pairs. -/
def gapFold : List (List BPair) → BPair
  | [] => BPair.unit
  | a :: t => gapRow a t + gapFold t

/-- The self-pairings' fold. -/
def selfSumL : List (List BPair) → BPair
  | [] => BPair.unit
  | v :: t => dotN v v + selfSumL t

/-- A member joined to its count multiple with a second member's own
collects at the successor count. -/
private theorem succCollect (k : Nat) (x y : BPair) :
    ((x + (BPair.ofNat k * x + y)) + BPair.ofNat k * y).oneValue
      (BPair.ofNat (k + 1) * (x + y)) := by
  refine BPair.oneValue_symm ?_
  refine BPair.oneValue_trans
    (BPair.mul_congr_left (BPair.ofNat_succ k)) ?_
  refine BPair.oneValue_trans
    (BPair.oneValue_of_eq
      (BPair.right_distrib (BPair.ofNat k) (BPair.ofNat 1) (x + y))) ?_
  refine BPair.oneValue_trans
    (BPair.add_congr (BPair.oneValue_of_eq
        (BPair.left_distrib (BPair.ofNat k) x y))
      (BPair.ofNat_one_mul (x + y))) ?_
  refine BPair.oneValue_of_eq ?_
  rw [BPair.add_add_comm (BPair.ofNat k * x) (BPair.ofNat k * y) x y,
    BPair.add_comm (BPair.ofNat k * x) x,
    BPair.add_comm (BPair.ofNat k * y) y,
    ← BPair.add_assoc x (BPair.ofNat k * x) y,
    BPair.add_assoc (x + BPair.ofNat k * x) y (BPair.ofNat k * y)]

/-- Eight summands regrouped at the swap pair and the row's two
folds. -/
private theorem gapCollect (A U W R x y z w : BPair) :
    (((A + U) + W) + R) + ((x + y) + (z + w))
      = (A + U) + ((W + (x + z)) + (R + (y + w))) := by
  repeat rw [BPair.add_assoc]
  rw [BPair.add_left_comm R x (y + (z + w)),
    BPair.add_left_comm y z w,
    BPair.add_left_comm R z (y + w),
    BPair.add_left_comm W x (z + (R + (y + w))),
    BPair.add_left_comm W z (R + (y + w))]

/-- Five summands regrouped at the row against the cross pair. -/
private theorem regroup5 (A S2 C R G : BPair) :
    ((A + S2) + C) + (R + G) = (A + (R + C)) + (S2 + G) := by
  repeat rw [BPair.add_assoc]
  rw [BPair.add_left_comm S2 C (R + G),
    BPair.add_left_comm S2 R G,
    BPair.add_left_comm C R (S2 + G)]

/-- One head's gap row joined to its two cross pairings against the
tail's sum reads the tail's count against the head's self-pairing,
the tail's fold beside it. -/
private theorem gapRow_split (n : Nat) (a : List BPair) (ha : a.length = n) :
    ∀ t : List (List BPair),
    (∀ i, i < t.length → (ground.getAt [] t i).length = n) →
    (gapRow a t + (dotN a (vecSumL n t) + dotN (vecSumL n t) a)).oneValue
      (BPair.ofNat t.length * dotN a a + selfSumL t)
  | [], _ => by
    refine BPair.oneValue_trans
      (BPair.add_congr (BPair.oneValue_refl BPair.unit)
        (BPair.add_congr
          (dotN_nullR a (vecSumL n []) (poly.unitTail_replicate n))
          (dotN_nullL (vecSumL n []) a (poly.unitTail_replicate n)))) ?_
    refine BPair.oneValue_trans
      (BPair.add_congr (BPair.oneValue_refl BPair.unit)
        (BPair.unit_add BPair.unit)) ?_
    refine BPair.oneValue_trans (BPair.unit_add BPair.unit) ?_
    refine BPair.oneValue_symm ?_
    exact BPair.oneValue_trans
      (BPair.add_congr (BPair.unit_mul (dotN a a))
        (BPair.oneValue_refl BPair.unit))
      (BPair.unit_add BPair.unit)
  | u :: t, h => by
    have hu : u.length = n := h 0 (Nat.succ_pos _)
    have ht : ∀ i, i < t.length → (ground.getAt [] t i).length = n :=
      fun i hi => h (i + 1) (Nat.succ_lt_succ hi)
    have hS : (vecSumL n t).length = n := length_vecSumL n t ht
    have hu' : (u.map BPair.swap).length = n :=
      (ground.length_map BPair.swap u).trans hu
    refine BPair.oneValue_trans
      (BPair.add_congr
        (BPair.add_congr
          (dotN_add_expand a (u.map BPair.swap) (ha.trans hu'.symm))
          (BPair.oneValue_refl (gapRow a t)))
        (BPair.add_congr
          (dotN_addRow_right a u (vecSumL n t) (hu.trans ha.symm)
            (hS.trans ha.symm))
          (dotN_addRow u (vecSumL n t) a (hu.trans ha.symm)
            (hS.trans ha.symm)))) ?_
    rw [dotN_swapPair u, dotN_swap a u, dotN_swapLeft u a, BPair.swap_add]
    refine BPair.oneValue_trans
      (BPair.oneValue_of_eq
        (gapCollect (dotN a a) (dotN u u) ((dotN a u + dotN u a).swap)
          (gapRow a t) (dotN a u) (dotN a (vecSumL n t)) (dotN u a)
          (dotN (vecSumL n t) a))) ?_
    refine BPair.oneValue_trans
      (BPair.add_congr (BPair.oneValue_refl (dotN a a + dotN u u))
        (BPair.add_congr
          (BPair.swap_add_null
            (BPair.oneValue_refl (dotN a u + dotN u a)))
          (gapRow_split n a ha t ht))) ?_
    refine BPair.oneValue_trans
      (BPair.add_congr (BPair.oneValue_refl _)
        (BPair.unit_add (BPair.ofNat t.length * dotN a a + selfSumL t))) ?_
    refine BPair.oneValue_trans
      (BPair.oneValue_of_eq
        (BPair.add_add_comm (dotN a a) (dotN u u)
          (BPair.ofNat t.length * dotN a a) (selfSumL t))) ?_
    refine BPair.add_congr ?_ (BPair.oneValue_refl (dotN u u + selfSumL t))
    refine BPair.oneValue_symm ?_
    refine BPair.oneValue_trans
      (BPair.mul_congr_left (BPair.ofNat_succ t.length)) ?_
    refine BPair.oneValue_trans
      (BPair.oneValue_of_eq
        (BPair.right_distrib (BPair.ofNat t.length) (BPair.ofNat 1)
          (dotN a a))) ?_
    refine BPair.oneValue_trans
      (BPair.add_congr (BPair.oneValue_refl _)
        (BPair.ofNat_one_mul (dotN a a))) ?_
    exact BPair.oneValue_of_eq
      (BPair.add_comm (BPair.ofNat t.length * dotN a a) (dotN a a))

/-- The count's fold of squares (`lem:fourpoint`'s displayed identity
at the pairing's coordinate folds, `def:ground`'s arithmetic): the
sum's self-pairing joined to the pairwise gaps' fold reads the count
against the self-pairings' fold. -/
theorem dotN_sumL_split (n : Nat) : ∀ vs : List (List BPair),
    (∀ i, i < vs.length → (ground.getAt [] vs i).length = n) →
    (dotN (vecSumL n vs) (vecSumL n vs) + gapFold vs).oneValue
      (BPair.ofNat vs.length * selfSumL vs)
  | [], _ => by
    refine BPair.oneValue_trans
      (BPair.add_congr
        (dotN_nullL (vecSumL n []) (vecSumL n []) (poly.unitTail_replicate n))
        (BPair.oneValue_refl BPair.unit)) ?_
    refine BPair.oneValue_trans (BPair.unit_add BPair.unit) ?_
    exact BPair.oneValue_symm (BPair.unit_mul BPair.unit)
  | a :: t, h => by
    have ha : a.length = n := h 0 (Nat.succ_pos _)
    have ht : ∀ i, i < t.length → (ground.getAt [] t i).length = n :=
      fun i hi => h (i + 1) (Nat.succ_lt_succ hi)
    have hS : (vecSumL n t).length = n := length_vecSumL n t ht
    refine BPair.oneValue_trans
      (BPair.add_congr
        (dotN_add_expand a (vecSumL n t) (ha.trans hS.symm))
        (BPair.oneValue_refl (gapRow a t + gapFold t))) ?_
    refine BPair.oneValue_trans
      (BPair.oneValue_of_eq
        (regroup5 (dotN a a) (dotN (vecSumL n t) (vecSumL n t))
          (dotN a (vecSumL n t) + dotN (vecSumL n t) a) (gapRow a t)
          (gapFold t))) ?_
    refine BPair.oneValue_trans
      (BPair.add_congr
        (BPair.add_congr (BPair.oneValue_refl (dotN a a))
          (gapRow_split n a ha t ht))
        (dotN_sumL_split n t ht)) ?_
    exact succCollect t.length (dotN a a) (selfSumL t)

/-- The gaps' folds sit at or above the sum's unit, each entry a
self-pairing. -/
private theorem gapRow_nn (a : List BPair) : ∀ t : List (List BPair),
    BPair.unit ≤ gapRow a t
  | [] => ground.leB_refl BPair.unit
  | u :: t => by
    refine ground.leB_congr_left (BPair.unit_add BPair.unit) ?_
    exact ground.leB_add
      (ground.leB_of_not_lt (dotN_self_side _)) (gapRow_nn a t)

private theorem gapFold_nn : ∀ vs : List (List BPair),
    BPair.unit ≤ gapFold vs
  | [] => ground.leB_refl BPair.unit
  | a :: t => by
    refine ground.leB_congr_left (BPair.unit_add BPair.unit) ?_
    exact ground.leB_add (gapRow_nn a t) (gapFold_nn t)

/-- The sum's square cap: the identity's read at the gaps' fold on its
upper side. -/
theorem dotN_sumL_sq_le (n : Nat) (vs : List (List BPair))
    (hvs : ∀ i, i < vs.length → (ground.getAt [] vs i).length = n) :
    dotN (vecSumL n vs) (vecSumL n vs)
      ≤ BPair.ofNat vs.length * selfSumL vs := by
  refine ground.leB_congr
    (BPair.add_unit (dotN (vecSumL n vs) (vecSumL n vs)))
    (dotN_sumL_split n vs hvs) ?_
  exact ground.leB_add (ground.leB_refl _) (gapFold_nn vs)

/-- The list sum's action is the actions' sum. -/
theorem matVec_matSumL (n : Nat) : ∀ Ms : List Mat,
    (∀ i, i < Ms.length → sqAt (ground.getAt [] Ms i) n) →
    ∀ x : List BPair, x.length = n →
    poly.oneValue (matVec (matSumL n Ms) x)
      (vecSumL n (Ms.map (fun A => matVec A x)))
  | [], _, x, _ =>
    poly.unitTail_oneValue (matVec_nullMat n n x) (poly.unitTail_replicate n)
  | A :: t, h, x, hx => by
    have hA : sqAt A n := h 0 (Nat.succ_pos _)
    have ht : ∀ i, i < t.length → sqAt (ground.getAt [] t i) n :=
      fun i hi => h (i + 1) (Nat.succ_lt_succ hi)
    have hmap : ∀ i, i < (t.map (fun B => matVec B x)).length →
        (ground.getAt [] (t.map (fun B => matVec B x)) i).length = n := by
      intro i hi
      have hit : i < t.length := by
        rw [← ground.length_map (fun B => matVec B x) t]
        exact hi
      rw [ground.getAt_map ([] : Mat) ([] : List BPair)
        (fun B => matVec B x) t i hit]
      exact (matVec_length _ x).trans (sqAt_len (ht i hit))
    have hlen1 : (matVec (matSumL n t) x).length = n :=
      (matVec_length _ x).trans (sqAt_len (sqAt_matSumL n t ht))
    have hlen2 : (vecSumL n (t.map (fun B => matVec B x))).length = n :=
      length_vecSumL n _ hmap
    refine poly.oneValue_trans
      (matVec_add_free n A (matSumL n t) x (rowsLen_of_sqAt hA)
        (rowsLen_of_sqAt (sqAt_matSumL n t ht))) ?_
    exact vecAdd_congr2 _ _ _ _ rfl (hlen1.trans hlen2.symm)
      (poly.oneValue_refl (matVec A x)) (matVec_matSumL n t ht x hx)

/-- The self-pairings' fold at per-term caps: one cap per term, the
fold at the count's multiple. -/
private theorem selfSumL_cap (c : BPair) : ∀ vs : List (List BPair),
    (∀ i, i < vs.length → dotN (ground.getAt [] vs i) (ground.getAt [] vs i) ≤ c) →
    selfSumL vs ≤ BPair.ofNat vs.length * c
  | [], _ => by
    refine ground.leB_congr_right
      (BPair.oneValue_symm (BPair.unit_mul c)) (ground.leB_refl BPair.unit)
  | v :: t, h => by
    refine ground.leB_congr_right ?_
      (ground.leB_add (h 0 (Nat.succ_pos _))
        (selfSumL_cap c t (fun i hi => h (i + 1) (Nat.succ_lt_succ hi))))
    refine BPair.oneValue_symm ?_
    refine BPair.oneValue_trans
      (BPair.mul_congr_left (BPair.ofNat_succ t.length)) ?_
    refine BPair.oneValue_trans
      (BPair.oneValue_of_eq
        (BPair.right_distrib (BPair.ofNat t.length) (BPair.ofNat 1) c)) ?_
    refine BPair.oneValue_trans
      (BPair.add_congr (BPair.oneValue_refl _) (BPair.ofNat_one_mul c)) ?_
    exact BPair.oneValue_of_eq
      (BPair.add_comm (BPair.ofNat t.length * c) c)

/-- The list sum's square cap at per-term caps (`lem:fourpoint`'s
count's fold of squares at the per-term square cap): the summed
action's self-pairing sits at or below the count's square against the
per-term cap, the displayed identity's read at the gaps' fold on its
upper side. -/
theorem matSumL_sq_cap (n : Nat) (Ms : List Mat)
    (hMs : ∀ i, i < Ms.length → sqAt (ground.getAt [] Ms i) n) (D : Pos)
    (hcap : ∀ i, i < Ms.length → ∀ x : List BPair, x.length = n →
      ¬ (BPair.ofPos (D * D) * dotN x x
        < dotN (matVec (ground.getAt [] Ms i) x) (matVec (ground.getAt [] Ms i) x)))
    (x : List BPair) (hx : x.length = n) :
    ¬ (BPair.ofNat (Ms.length * Ms.length) * (BPair.ofPos (D * D) * dotN x x)
        < dotN (matVec (matSumL n Ms) x) (matVec (matSumL n Ms) x)) := by
  have hmap : ∀ i, i < (Ms.map (fun A => matVec A x)).length →
      (ground.getAt [] (Ms.map (fun A => matVec A x)) i).length = n := by
    intro i hi
    have hit : i < Ms.length := by
      rw [← ground.length_map (fun A => matVec A x) Ms]
      exact hi
    rw [ground.getAt_map ([] : Mat) ([] : List BPair)
      (fun A => matVec A x) Ms i hit]
    exact (matVec_length _ x).trans (sqAt_len (hMs i hit))
  have hterm : ∀ i, i < (Ms.map (fun A => matVec A x)).length →
      dotN (ground.getAt [] (Ms.map (fun A => matVec A x)) i)
          (ground.getAt [] (Ms.map (fun A => matVec A x)) i)
        ≤ BPair.ofPos (D * D) * dotN x x := by
    intro i hi
    have hit : i < Ms.length := by
      rw [← ground.length_map (fun A => matVec A x) Ms]
      exact hi
    rw [ground.getAt_map ([] : Mat) ([] : List BPair)
      (fun A => matVec A x) Ms i hit]
    exact ground.leB_of_not_lt (hcap i hit x hx)
  refine ground.leB_not_lt ?_
  refine ground.leB_congr_left
    (BPair.oneValue_symm
      (BPair.oneValue_trans
        (dotN_congrL _ _ _ (matVec_matSumL n Ms hMs x hx))
        (dotN_congrR _ _ _ (matVec_matSumL n Ms hMs x hx)))) ?_
  refine ground.leB_trans
    (dotN_sumL_sq_le n (Ms.map (fun A => matVec A x)) hmap) ?_
  refine ground.leB_congr_right ?_
    (ground.leB_mulR (ground.unitLeOfNat _)
      (selfSumL_cap (BPair.ofPos (D * D) * dotN x x)
        (Ms.map (fun A => matVec A x)) hterm))
  refine BPair.oneValue_symm ?_
  rw [ground.length_map (fun A => matVec A x) Ms]
  exact BPair.ofNat_mul_mul Ms.length Ms.length
    (BPair.ofPos (D * D) * dotN x x)

/-- The squares' fold at a vector sum: the joined vector's self-pairing
sits at or below twice the two self-pairings' sum, the gap's square
`⟨u − v, u − v⟩` the witness. -/
theorem dotN_vecAdd_sq_le (u v : List BPair) (h : u.length = v.length) :
    dotN (vecAdd u v) (vecAdd u v) ≤ BPair.ofNat 2 * (dotN u u + dotN v v) := by
  have hcross : dotN u v + dotN v u ≤ dotN u u + dotN v v := by
    have hv' : u.length = (v.map BPair.swap).length :=
      h.trans (ground.length_map BPair.swap v).symm
    have hgap : BPair.unit
        ≤ dotN u u + dotN v v + (dotN u v + dotN v u).swap := by
      refine ground.leB_congr_right ?_
        (ground.leB_of_not_lt (dotN_self_side (vecAdd u (v.map BPair.swap))))
      refine BPair.oneValue_trans (dotN_add_expand u (v.map BPair.swap) hv') ?_
      rw [dotN_swapPair v, dotN_swap u v, dotN_swapLeft v u, BPair.swap_add]
      exact BPair.oneValue_refl _
    refine ground.leB_congr_left
      (BPair.oneValue_of_eq (BPair.swap_swap (dotN u v + dotN v u)).symm) ?_
    exact ground.leB_of_unit_add hgap
  refine ground.leB_congr_left
    (BPair.oneValue_symm (dotN_add_expand u v h)) ?_
  refine ground.leB_congr_right
    (BPair.oneValue_symm (BPair.ofNat_two_mul (dotN u u + dotN v v))) ?_
  exact ground.leB_add (ground.leB_refl _) hcross

end elim
