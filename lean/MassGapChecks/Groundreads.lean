private def spAA : Split 1 :=
  mkSplit 1 (siteDatum (matScale 1 (inertia.idMat 1))
    (matScale 1 AobsA))
private def spAA' : Split 1 :=
  mkSplit 1 (matAdd (matScale 1 (inertia.idMat 1))
    (matScale 1 AobsA))

