        * (certD (List.take 1 capsA)
          * certN (List.take 1 (List.drop 1 capsA))))))
      ≤ BPair.scale
        (dotN colA colA
          * (BPair.scale
              ((tailFold (List.take 1 capsA).reverse).1
                * ((dotN colA colA * dotN colA colA)
                  * dotN srcA srcA))
              ((((1 : Pos) * 1) * ((1 : Pos) * 1)) * ((1 * 1)
                * ((denProd (List.drop 1 usA)
                    * denProd (List.drop 1 usA))
                  * ((certN (List.take 1 (List.drop 1 capsA))
                      * certN (List.take 1 (List.drop 1 capsA)))
                    * (denProd (List.take 1 usA)
                      * denProd (List.take 1 usA))))))
            + BPair.scale (dotN colA colA)
