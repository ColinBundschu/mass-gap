/-! Clause (iv)'s sourced pencil at a committed two-window cell: the
electric diagonal `E = diag(0, 4)`, the magnetic member `M = 2·G`,
the word `f` the window's exchange, the cleared floor `ε₀ = −2` and
the gap's weights `δₙ = δ_d = ε = 1`, so the level gap reads
`Ẽ = diag(0, 4)` and the ground `ψ = e₀` sits in its kernel.  The
tie is reflexive at the committed gap, the kernel read and the
commuting read decided, and the display — the gap's action on the
off-line residual of `f ψ` against the commutator's own action
cleared by `⟨ψ,ψ⟩ ε δₙ` — decided beside the theorem route.

The three refusals forge one binder each, the other two standing,
and every one parts the display:

* the kernel read forged at `ψ' = e₁`, off the gap's kernel — the
  tie and the commuting read stand there and the display refuses;
* the commuting read forged at `M' = diag(2, 3)` with the tie's gap
  rebuilt at it — the rebuilt tie and the kernel read stand, the
  word's exchange parts the two orders at the lower window, and the
  display refuses;
* the tie forged at the gap `diag(0, 5)`, its lower diagonal entry
  bent — the kernel read stands there and the commuting read is the
  committed one, while the entrywise read of the tie refuses and the
  display refuses with it.
-/

private def dgS : List Nat := [0, 4]

private def mS : Mat := [[⟨3, 1⟩, u], [u, ⟨3, 1⟩]]

private def cS : Mat := [[u, ⟨2, 1⟩], [⟨2, 1⟩, u]]

private def enS : BPair := ⟨1, 3⟩

private def tieS (Mm : Mat) : Mat := matAdd (matAdd
    (inertia.matScale ((1 : Pos) * 1)
      (diagO ground.bpairOps (dgS.map BPair.ofNat)))
    (matSwap (inertia.matScale ((1 : Pos) * 1) Mm)))
    (matSwap (inertia.matScaleB enS (inertia.idMat 2)))

private def etS : Mat := tieS mS

private def psiS : List BPair := [⟨2, 1⟩, u]

private theorem tieOK : matOneValue etS (tieS mS) := by decide +kernel

private theorem kerOK : poly.unitTail (matVec etS psiS) := by decide +kernel

private theorem commOK : poly.oneValue (matVec mS (matVec cS psiS))
    (matVec cS (matVec mS psiS)) := by decide +kernel

example : poly.oneValue (matVec etS (residD [psiS] (matVec cS psiS)))
    (vecScale (dotN psiS psiS * BPair.ofPos ((1 : Pos) * 1))
      (matVec (momentform.commE dgS cS) psiS)) :=
  sourced_pencil dgS cS mS etS psiS 2 1 1 1 enS rfl
    ⟨rfl, rfl, trivial⟩ rfl ⟨rfl, rfl, trivial⟩ rfl
    ⟨rfl, rfl, trivial⟩ rfl tieOK kerOK commOK

example : poly.oneValue (matVec etS (residD [psiS] (matVec cS psiS)))
