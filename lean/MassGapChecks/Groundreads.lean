/-- The ground column, the residual and the commutator source, each
named once and consumed by term. -/
private def colA : List BPair := matVec tA.val (elim.idRow 4 0)
private def phiA : List BPair :=
  residD [colA] (matVec cA colA)
private def srcA : List BPair :=
