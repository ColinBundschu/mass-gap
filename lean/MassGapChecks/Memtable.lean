import MassGap.Memtable
/-!
The check module for `con:memtable`: the generating tables' triple
displays by kernel `decide` — the letters' table at three letters,
the spinor tables at `B_2`, `B_3` and `D_4` at every simple index,
the defining tables of `B_2`, `C_3` and `D_4` (the `B` table at its
cleared pairing), the joined generating tables at `B_2` and `D_4`,
`G_2`'s fold of `D_4`'s defining table, and the fixed members'
tables at every simple index; the weights' symmetry reads at every
table, one entry joined off the diagonal refused; the weights'
positivity reads at every table at its stated split, `E_8`'s and
`F_4`'s at the block sum of the Cartan's cleared split with the root
keys' identity through the block tier's theorems, the root-key
tables at the scalar split, the diagonal tables outright, with the
refusals at an order off the key count, an indefinite weight and a
split off the weight; the sparse join at the merge one list with
the collected join; the closure reads
at the computed
word stores at `B_2`, `C_3`, `D_4`, `G_2`, `E_7`, `E_6` and `F_4`,
and at `E_8` at the committed word store, the cover one kernel task
and the entries' fold six tasks of twenty folds assembled at the
range's block introduction, the read at `C_3` and `G_2` passing at
a second store keyed at the last occupied key with the two stores
apart at some word; the dual pairs' reads at every member
table, the fixed members' `E_8`, `E_7` and `E_6` assembled from
their three reads with the invariance one task per simple index,
with the reads' refusals (a spinor pair
at one flipped side parting the invariance, a spinor pair at one
entry moved off the unit weight parting the entries' read on its
own, the identity in place of `B`'s dual pair parting the three
reads, the `56`'s pair at one row flipped, the letters' vacant
pair); and the committed refusals
isolating the triple and closure reads' data: the `D` diagonal at
the `B` spinor table (the commutator display parting), the `B`
short move's forged raising at the doubled entry read at one and
the plain identity in place of the cleared pairing (the transpose
display parting), a fold at a list off the orbits (the diagonal
parting), the closure read at the raisings withdrawn to one simple
index, a store at one word doubled (the entry's step read
parting), a store at one key the fold leaves vacant (the step
vacant), and a store at one fold repeated (the cover parting).
-/

namespace memtable

set_option maxRecDepth 100000

open ground

/-! The letters and the spinors. -/

theorem pin1 : tripleRead (lettersT 3) 0 ∧ tripleRead (lettersT 3) 1 := by
  decide +kernel

theorem pin2 : tripleRead (spinorT 2 false) 0 ∧ tripleRead (spinorT 2 false) 1 := by
  decide +kernel
theorem pin3 : tripleRead (spinorT 3 false) 0 ∧ tripleRead (spinorT 3 false) 1
    ∧ tripleRead (spinorT 3 false) 2 := by decide +kernel
theorem pin4 : tripleRead (spinorT 4 true) 0 ∧ tripleRead (spinorT 4 true) 1
    ∧ tripleRead (spinorT 4 true) 2 ∧ tripleRead (spinorT 4 true) 3 := by
  decide +kernel

/-- The `B_2` spinor table at the `D` diagonal, the last move's
coroot read the two bits' join in place of the last bit's
double. -/
private def spinB2atD : Table :=
  { spinorT 2 false with hdiag := (List.range 2).map (spinorH 2 true) }

theorem pin5 : ¬ tripleRead spinB2atD 1 := by decide +kernel

/-! The defining tables and the joins. -/

theorem pin6 : tripleRead (definingB 2) 0 ∧ tripleRead (definingB 2) 1 := by
  decide +kernel
theorem pin7 : tripleRead (definingC 3) 0 ∧ tripleRead (definingC 3) 1
    ∧ tripleRead (definingC 3) 2 := by decide +kernel
theorem pin8 : tripleRead (definingD 4) 0 ∧ tripleRead (definingD 4) 1
