private def spP : Split 3 :=
  ⟨⟨[[⟨2, 1⟩, ⟨1, 3⟩, ⟨5, 1⟩], [u, ⟨6, 1⟩, ⟨1, 11⟩], [u, u, ⟨22, 1⟩]], rfl⟩,
